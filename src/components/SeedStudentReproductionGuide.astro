---
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;

const preflight = String.raw`# 在离线服务器上，从 /srv/seed 执行
chmod +x /srv/seed/code/public/guides/seed-4x3090-preflight.sh
SEED_ROOT=/srv/seed \
EXPECTED_GPU_COUNT=4 \
bash /srv/seed/code/public/guides/seed-4x3090-preflight.sh`;

const offlineEnv = String.raw`# 四卡默认值。以后迁移八卡时只改 4 -> 8。
export EXPECTED_GPU_COUNT="\${EXPECTED_GPU_COUNT:-4}"
export N_GPUS_PER_NODE="\${N_GPUS_PER_NODE:-\$EXPECTED_GPU_COUNT}"
export DATA_PARALLEL_SIZE="\${DATA_PARALLEL_SIZE:-\$EXPECTED_GPU_COUNT}"
export TENSOR_PARALLEL_SIZE="\${TENSOR_PARALLEL_SIZE:-1}"

export CUDA_VISIBLE_DEVICES=0,1,2,3
export WANDB_MODE=offline
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export MODELS_ROOT=/srv/seed/models
export DATA_ROOT=/srv/seed/data`;

const alfworldSmoke = String.raw`# 前提：skill analyzer 在实验室内可访问。
# 如果没有本地 analyzer，就在联网环境完成 Stage 1 数据构造，
# hash 后传入服务器，再从 train_sft.sh 开始。
RUN_MODE=smoke \
DATA_PARALLEL_SIZE=4 \
TENSOR_PARALLEL_SIZE=1 \
MODEL_PATH="$MODELS_ROOT/Qwen2.5-3B-Instruct" \
SKILL_BASE_URL=http://127.0.0.1:<port>/v1 \
SKILL_API_KEY=<local-key-or-empty> \
SKILL_MODEL=<analyzer-model> \
bash scripts/sft/alfworld/prepare_data.sh`;

const webshopSmoke = String.raw`# WebShop 没有 RUN_MODE=smoke；用官方可覆盖参数缩到 1 task x 1 rollout。
NUM_TASKS=1 \
ROLLOUTS_PER_TASK=1 \
MAX_TASKS=1 \
MAX_CANDIDATES=2 \
DATA_PARALLEL_SIZE=4 \
TENSOR_PARALLEL_SIZE=1 \
MODEL_PATH="$MODELS_ROOT/Qwen2.5-3B-Instruct" \
SKILL_BASE_URL=http://127.0.0.1:<port>/v1 \
SKILL_API_KEY=<local-key-or-empty> \
SKILL_MODEL=<analyzer-model> \
bash scripts/sft/webshop/prepare_data.sh`;

const sftCommands = String.raw`# ALFWorld
NPROC_PER_NODE=4 \
bash scripts/sft/alfworld/train_sft.sh

# WebShop 使用独立的 Python <= 3.10 环境
NPROC_PER_NODE=4 \
bash scripts/sft/webshop/train_sft.sh`;

const dryRun = String.raw`N_GPUS_PER_NODE=4 DRY_RUN=true \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh

N_GPUS_PER_NODE=4 DRY_RUN=true \
bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;

const shortRun = String.raw`# 先做工程验证：让四卡真实训练一段，收集显存和 update 时间。
N_GPUS_PER_NODE=4 TOTAL_EPOCHS=10 SAVE_FREQ=5 TEST_FREQ=5 \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh

# 两个环境分开跑，不要同时抢四张卡。
N_GPUS_PER_NODE=4 TOTAL_EPOCHS=10 SAVE_FREQ=5 TEST_FREQ=5 \
bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;

const fullRun = String.raw`# 当短跑稳定以后，回到正式实验配置。
# 不在这里硬编码 TOTAL_EPOCHS：先核对当前公开 wrapper 与论文“150 policy updates”的对应关系。
N_GPUS_PER_NODE=4 \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh

N_GPUS_PER_NODE=4 \
bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;

const migrateEight = String.raw`# 同一份代码迁移到 8 卡节点
export EXPECTED_GPU_COUNT=8
export N_GPUS_PER_NODE=8
export DATA_PARALLEL_SIZE=8
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# 先做同样的 preflight 和 DRY_RUN，再开正式训练。
SEED_ROOT=/srv/seed EXPECTED_GPU_COUNT=8 \
bash /srv/seed/code/public/guides/seed-4x3090-preflight.sh

N_GPUS_PER_NODE=8 DRY_RUN=true \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh`;

const progressCheck = String.raw`python - <<'PY'
import json, pathlib
paths = list(pathlib.Path('outputs').glob('*/progress.json'))
for path in paths:
    p = json.loads(path.read_text())
    print(path)
    for key in ['status', 'completed_rollouts', 'expected_rollouts', 'completed_skills', 'parse_ok_skills', 'sft_records']:
        print(f'  {key}: {p.get(key)}')
PY`;

const mainline = [
  ['00', t('把实验材料准备齐', 'Prepare the complete experiment bundle'), t('代码、模型、ALFWorld、准备好的 WebShop、Python/CUDA 环境、hash。', 'Code, model, ALFWorld, prepared WebShop, Python/CUDA environment, and hashes.')],
  ['01', t('让 4×3090 服务器通过体检', 'Pass the 4×3090 server preflight'), t('先证明四张卡、模型和离线数据都真的可用。', 'Prove the four GPUs, model, and offline data are actually usable.')],
  ['02', t('ALFWorld 最小跑通', 'Run the smallest ALFWorld path'), t('一个最小 rollout + skill 数据链完成。', 'Complete a minimal rollout + skill data path.')],
  ['03', t('WebShop 最小跑通', 'Run the smallest WebShop path'), t('本地搜索环境能启动，再完成 1 task × 1 rollout。', 'Start the local search environment, then complete 1 task × 1 rollout.')],
  ['04', t('完成两套 SFT', 'Finish SFT for both environments'), t('拿到能被 Stage 2 识别和加载的 checkpoint。', 'Produce checkpoints that Stage 2 can recognize and load.')],
  ['05', t('四卡 RL 先短跑', 'Short-run RL on four GPUs'), t('DRY_RUN → 10 epochs 工程跑 → 5 个稳定 update。', 'DRY_RUN → 10-epoch engineering run → five stable updates.')],
  ['06', t('完整训练并评测', 'Run full training and evaluation'), t('ALFWorld、WebShop 都完成，保留 checkpoint、metrics 和日志。', 'Complete both ALFWorld and WebShop, keeping checkpoints, metrics, and logs.')],
  ['07', t('只在需要时迁移 8 卡', 'Move to eight GPUs only if needed'), t('3090 已经答完研究问题就结束；时间/显存卡住再迁移。', 'Stop if 3090 already answers the question; migrate only for time/memory limits.')],
];
---

<section id="seed-student-mainline" class="seed-student" aria-labelledby="seed-student-title">
  <header class="student-head">
    <p class="section-kicker">{t('SEED 复现主线 · ALFWorld + WebShop', 'SEED reproduction mainline · ALFWorld + WebShop')}</p>
    <h2 id="seed-student-title">{t('先用 4×RTX 3090 把两套实验一路跑到底', 'Start by taking both experiments end to end on 4×RTX 3090')}</h2>
    <p class="intro">{t('你的第一目标很具体：在没有公网的四卡服务器上，让 ALFWorld 和 WebShop 都从离线数据、SFT 走到 RL 和评测。每一步先做最小验证，过了再放大。四张 3090 如果能完成计划中的完整训练和评测，我们在这个 3090 上就全部做完了。8×A800 / 8×A100 只保留成后续迁移入口。', 'The first goal is concrete: on the offline four-GPU server, take both ALFWorld and WebShop from offline data through SFT, RL, and evaluation. Validate the smallest version first, then scale up. If the four 3090s complete the planned full runs and evaluations, the reproduction work is done there. Keep 8×A800 / 8×A100 only as a later migration path.')}</p>
    <div class="finish-line">
      <strong>{t('最终一句话标准', 'One-line finish condition')}</strong>
      <span>{t('两套环境都跑完完整训练和评测，结果与配置能追溯到同一个 Git commit：我们在这个 3090 上就全部做完了。', 'Both environments finish full training and evaluation, and every result/config traces back to one Git commit: the 3090 reproduction is complete.')}</span>
    </div>
  </header>

  <nav class="mainline-nav" aria-label={t('SEED 复现主线目录', 'SEED reproduction mainline')}>
    {mainline.map(([index, title, note]) => <a href={`#seed-step-${index}`}><b>{index}</b><span><strong>{title}</strong><small>{note}</small></span></a>)}
  </nav>

  <section class="orientation" aria-labelledby="seed-orientation-title">
    <h3 id="seed-orientation-title">{t('先知道“复现成功”有几层', 'Know what “success” means before running')}</h3>
    <p>{t('你不用等到最后才判断。下面每一层都能单独验收。前一层没过，就先修这一层，不要继续堆更大的训练。', 'You do not need to wait until the end to judge success. Each level below is independently testable. If one level fails, fix it before scaling the run.')}</p>
    <ol class="success-ladder">
      <li><b>1</b><div><strong>{t('机器准备好了', 'Machine ready')}</strong><span>{t('四张 GPU、模型、数据、依赖和版本记录都通过 preflight。', 'Four GPUs, model, data, dependencies, and provenance pass preflight.')}</span></div></li>
      <li><b>2</b><div><strong>{t('环境能玩一局', 'Environment can run an episode')}</strong><span>{t('ALFWorld / WebShop 都能 reset、action、observation，不缺本地资源。', 'ALFWorld / WebShop can reset, act, and observe without missing local assets.')}</span></div></li>
      <li><b>3</b><div><strong>{t('Stage 1 真产出数据', 'Stage 1 produces real data')}</strong><span>{t('progress.json 里 rollout、skill、可解析 skill 和 SFT records 都出现有效结果。', 'progress.json reports completed rollouts, skills, parseable skills, and SFT records.')}</span></div></li>
      <li><b>4</b><div><strong>{t('训练链跑通', 'Training chain works')}</strong><span>{t('SFT checkpoint 能加载；RL 能更新、保存、恢复；loss/reward 没有 NaN/Inf。', 'SFT checkpoint loads; RL updates, saves, and resumes; loss/reward stay finite.')}</span></div></li>
      <li><b>5</b><div><strong>{t('方法复现成立', 'Method reproduction holds')}</strong><span>{t('同样的模型、环境和评测下，SEED 与 GRPO 基线做多次可比较运行，整体趋势支持 SEED 的方法效果。', 'Under the same model, environment, and evaluation, repeated comparable SEED vs GRPO runs support the method effect.')}</span></div></li>
      <li><b>6</b><div><strong>{t('论文可比性', 'Paper comparability')}</strong><span>{t('再对齐论文的 180×8 Stage 1、3-epoch SFT、150 policy updates、评测协议和 8×A800 80GB 等条件。', 'Then align the paper’s 180×8 Stage 1, 3-epoch SFT, 150 policy updates, evaluation protocol, and 8×A800 80GB hardware condition.')}</span></div></li>
    </ol>
  </section>

  <section id="seed-step-00" class="step-section">
    <div class="step-number">00</div>
    <div class="step-copy">
      <p class="step-kicker">{t('联网电脑上做', 'Do this on the online side')}</p>
      <h3>{t('把离线服务器会用到的东西一次准备齐', 'Prepare everything the offline server will need')}</h3>
      <p>{t('服务器不能临时去 GitHub、Hugging Face、pip 或 WebShop 下载缺失文件，所以真正的第一步是做一个完整离线包。代码用 GitHub 管版本；大模型和数据通过 SFTP 单独传；每批大文件都保留 SHA256。', 'The server cannot fetch missing files from GitHub, Hugging Face, pip, or WebShop during a run, so the real first step is a complete offline bundle. Use GitHub for code history; transfer large models and data separately over SFTP; keep SHA256 manifests for large assets.')}</p>
      <div class="bundle-line"><code>code/</code><code>models/</code><code>data/alfworld/</code><code>data/webshop/</code><code>env/</code><code>runs/</code><code>SHA256SUMS.txt</code></div>
      <div class="plain-note"><strong>{t('WebShop 要特别注意', 'WebShop matters here')}</strong><span>{t('先在联网 Linux 环境完成它的 setup：数据下载、spaCy、Java/faiss 依赖和搜索索引都准备好，再整体搬进实验室。', 'Complete WebShop setup on an online Linux environment first: data download, spaCy, Java/faiss dependencies, and the search index should be ready before the tree enters the lab.')}</span></div>
      <div class="gate"><b>{t('这一关算过', 'Pass when')}</b><span>{t('离线包有固定目录；模型/数据有 hash；实验代码有明确 Git SHA；服务器不需要临时联网补文件。', 'Bundle layout is fixed; model/data have hashes; experiment code has a Git SHA; the server needs no last-minute internet downloads.')}</span></div>
    </div>
  </section>

  <section id="seed-step-01" class="step-section">
    <div class="step-number">01</div>
    <div class="step-copy">
      <p class="step-kicker">{t('离线服务器第一条命令', 'First command on the offline server')}</p>
      <h3>{t('先跑体检脚本，看到 READY 再碰训练', 'Run preflight first; touch training only after READY')}</h3>
      <p>{t('这份脚本会检查 GPU 数量、PyTorch CUDA、Git commit、SHA256、Qwen config、ALFWorld 数据和 WebShop 目录，同时保存 nvidia-smi 与 GPU topology。它默认四卡，以后迁移八卡只需要把 EXPECTED_GPU_COUNT 改成 8。', 'The script checks GPU count, PyTorch CUDA, Git commit, SHA256, Qwen config, ALFWorld data, and WebShop directories, while saving nvidia-smi and GPU topology. It defaults to four GPUs; later migration only changes EXPECTED_GPU_COUNT to 8.')}</p>
      <pre><code>{preflight}</code></pre>
      <a class="script-link" href="/guides/seed-4x3090-preflight.sh">{t('打开可复制的 preflight 脚本', 'Open the reusable preflight script')}</a>
      <pre><code>{offlineEnv}</code></pre>
      <div class="gate"><b>{t('这一关算过', 'Pass when')}</b><span><code>READY: offline bundle and GPU visibility passed the preflight gate.</code></span></div>
    </div>
  </section>

  <section id="seed-step-02" class="step-section">
    <div class="step-number">02</div>
    <div class="step-copy">
      <p class="step-kicker">ALFWorld</p>
      <h3>{t('先做最小数据链，不要直接跑论文规模', 'Start with the smallest data path, not paper scale')}</h3>
      <p>{t('官方 ALFWorld prepare_data.sh 自带 RUN_MODE=smoke：每类任务默认只取 1 个 task、1 个 rollout，正适合第一次验证。四卡机把 data parallel 从默认 8 改成 4。', 'The official ALFWorld prepare_data.sh includes RUN_MODE=smoke: by default it uses one task and one rollout per task type, which is ideal for first validation. On four GPUs, change data parallel from the default 8 to 4.')}</p>
      <pre><code>{alfworldSmoke}</code></pre>
      <p>{t('服务器没有公网时，Stage 1 的 analyzer 是最容易卡住的地方。实验室允许内部 analyzer，就让 SKILL_BASE_URL 指向它；没有的话，在合规的联网环境把 Stage 1 数据生成好、做 hash，再传回服务器。不要为了方便偷偷给服务器做代理绕过网络策略。', 'On an offline server, the Stage-1 analyzer is the most likely blocker. If the lab provides an internal analyzer, point SKILL_BASE_URL to it. Otherwise generate Stage-1 data in an approved online environment, hash it, and transfer it back. Do not proxy around the lab network policy just for convenience.')}</p>
      <pre><code>{progressCheck}</code></pre>
      <div class="gate"><b>{t('这一关算过', 'Pass when')}</b><span>{t('progress.json 里的 completed_rollouts 达到 expected_rollouts，并且 completed_skills、parse_ok_skills、sft_records 都大于 0。', 'progress.json reaches completed_rollouts == expected_rollouts and completed_skills, parse_ok_skills, and sft_records are all greater than zero.')}</span></div>
    </div>
  </section>

  <section id="seed-step-03" class="step-section">
    <div class="step-number">03</div>
    <div class="step-copy">
      <p class="step-kicker">WebShop</p>
      <h3>{t('先确认本地商店真的能用，再跑 1 task × 1 rollout', 'Make sure the local shop works, then run 1 task × 1 rollout')}</h3>
      <p>{t('WebShop 的官方 setup 会下载商品/指令数据、spaCy 模型并建立搜索索引，所以这一步必须在联网端提前完成。搬进服务器以后，先跑它的 text environment；能看到 Products loaded、Loaded goals 和 Available actions，再进入 SEED 的 prepare_data。', 'WebShop setup downloads product/instruction data, the spaCy model, and builds the search index, so setup belongs on the online side. After transfer, run the text environment first; once it prints product loading, goals, and available actions, move into SEED prepare_data.')}</p>
      <pre><code>{webshopSmoke}</code></pre>
      <div class="gate"><b>{t('这一关算过', 'Pass when')}</b><span>{t('本地 WebShop 能完成一次 search/click 交互；随后 progress.json 出现完成 rollout、有效 skill 和 SFT records。', 'Local WebShop completes a search/click interaction; then progress.json reports a completed rollout, valid skill, and SFT records.')}</span></div>
    </div>
  </section>

  <section id="seed-step-04" class="step-section">
    <div class="step-number">04</div>
    <div class="step-copy">
      <p class="step-kicker">Stage 1 · SFT</p>
      <h3>{t('两套数据链都过了，再训练 SFT checkpoint', 'Train SFT checkpoints only after both data paths pass')}</h3>
      <pre><code>{sftCommands}</code></pre>
      <div class="gate"><b>{t('这一关算过', 'Pass when')}</b><span>{t('训练正常结束；导出的 checkpoint 至少有 config.json 和模型权重；下一阶段 wrapper 不再报 “HF model not found”，并能实际加载 checkpoint。', 'Training exits cleanly; the exported checkpoint contains config.json and model weights; the next-stage wrapper no longer reports “HF model not found” and can load the checkpoint.')}</span></div>
    </div>
  </section>

  <section id="seed-step-05" class="step-section">
    <div class="step-number">05</div>
    <div class="step-copy">
      <p class="step-kicker">Stage 2 · 4 GPU RL</p>
      <h3>{t('先 DRY_RUN，再短跑；第一次别拿 3–6 天去赌配置', 'DRY_RUN, then short-run; do not gamble days on the first config')}</h3>
      <p>{t('官方 Stage-2 wrapper 默认 8 GPU，同时提供 DRY_RUN。四卡先显式写 N_GPUS_PER_NODE=4。DRY_RUN 过了，再用 10 epochs 做工程短跑，目的只是确认显存、通信、保存和恢复都工作。', 'The official Stage-2 wrapper defaults to 8 GPUs and provides DRY_RUN. On the four-GPU host, explicitly set N_GPUS_PER_NODE=4. After DRY_RUN passes, use a 10-epoch engineering run only to verify memory, communication, checkpoint save, and resume.')}</p>
      <pre><code>{dryRun}</code></pre>
      <pre><code>{shortRun}</code></pre>
      <div class="gate"><b>{t('这一关算过', 'Pass when')}</b><span>{t('训练至少跨过 warm-up；后面 5 个 update 都能稳定完成；loss/reward 是有限数；没有持续 OOM；checkpoint 能保存并恢复。记录每个稳定 update 的 wall-clock、每卡峰值显存和 GPU 利用率。', 'Training gets past warm-up; the next five updates complete stably; loss/reward are finite; there is no persistent OOM; checkpoints save and resume. Record wall-clock per stable update, peak VRAM per GPU, and GPU utilization.')}</span></div>
    </div>
  </section>

  <section id="seed-step-06" class="step-section">
    <div class="step-number">06</div>
    <div class="step-copy">
      <p class="step-kicker">{t('正式运行', 'Full run')}</p>
      <h3>{t('短跑稳定以后，才让 ALFWorld 和 WebShop 各自完整跑完', 'Once the short run is stable, complete ALFWorld and WebShop separately')}</h3>
      <pre><code>{fullRun}</code></pre>
      <p>{t('论文报告的是 150 个 policy updates；当前公开 wrapper 的 TOTAL_EPOCHS 默认值是 160。做论文可比实验前，要核对当前代码里的 epoch/update 映射和最终实际 update 数，不要只把某个变量改成 150 就宣布对齐。', 'The paper reports 150 policy updates, while the current public wrapper defaults TOTAL_EPOCHS to 160. Before a paper-comparable run, verify how the current code maps epochs to actual policy updates; do not simply rename or set one variable to 150 and declare alignment.')}</p>
      <div class="paper-reference">
        <strong>{t('论文里的 Qwen2.5-3B-Instruct 参考坐标', 'Paper reference for Qwen2.5-3B-Instruct')}</strong>
        <span>ALFWorld avg <b>91.8</b></span><span>WebShop score <b>88.5</b></span><span>WebShop success <b>78.9</b></span>
        <small>{t('这些数字用来检查量级和趋势。四卡方法复现不要求单次 run 精确等于论文数字。', 'Use these numbers to check scale and trend. A four-GPU method reproduction does not require one run to exactly equal the paper values.')}</small>
      </div>
      <div class="gate final-gate"><b>{t('完整复现主线算过', 'Mainline complete when')}</b><span>{t('ALFWorld + WebShop 都完成计划中的完整训练与评测；checkpoint、metrics、日志、配置、Git SHA 和数据 hash 都保留下来；SEED 与同条件 GRPO 有可比较结果。此时如果研究问题已经回答：我们在这个 3090 上就全部做完了。', 'ALFWorld + WebShop both finish the planned full training and evaluation; checkpoint, metrics, logs, configs, Git SHA, and data hashes are retained; SEED and same-condition GRPO have comparable results. If that answers the research question, the 3090 work is complete.')}</span></div>
    </div>
  </section>

  <section id="seed-step-07" class="step-section migration-section">
    <div class="step-number">07</div>
    <div class="step-copy">
      <p class="step-kicker">{t('8 卡迁移', 'Eight-GPU migration')}</p>
      <h3>{t('把“4 卡”留在配置里，不要写死在实验逻辑里', 'Keep “4 GPUs” in configuration, not in experiment logic')}</h3>
      <p>{t('如果 3090 因显存或总耗时无法完成，再迁移。代码、模型路径、数据路径、评测和 run manifest 都保持不变，只把 GPU 数、data parallel 和必要的显存参数重新做一次 preflight → DRY_RUN → short run。A800 80GB×8 用于更接近论文硬件；A100 80GB×8 可以做八卡硬件替代的方法复现。', 'Migrate only if memory or total runtime prevents completion on 3090. Keep code, model paths, data paths, evaluation, and run manifest unchanged; change GPU count, data parallel, and any necessary memory knobs, then repeat preflight → DRY_RUN → short run. 8×A800 80GB is the paper hardware; 8×A100 80GB is an eight-GPU hardware-substituted method run.')}</p>
      <pre><code>{migrateEight}</code></pre>
      <div class="gate"><b>{t('迁移完成', 'Migration pass')}</b><span>{t('同一个实验 commit、同一份数据 hash 和同一套评测，在八卡节点通过 preflight/DRY_RUN，并从既定 checkpoint 正常启动。', 'The same experiment commit, data hashes, and evaluation pass preflight/DRY_RUN on the eight-GPU node and launch from the intended checkpoint.')}</span></div>
    </div>
  </section>

  <section class="time-and-risk" aria-labelledby="seed-time-title">
    <div>
      <p class="section-kicker">{t('大概要多久', 'How long this will take')}</p>
      <h3 id="seed-time-title">{t('先按 1–2 天跑通整条链，再决定要不要花 3–6 天跑完整实验', 'Budget 1–2 days to prove the chain, then decide whether to spend 3–6 days on full runs')}</h3>
      <ul>
        <li><b>{t('离线材料准备', 'Offline staging')}</b><span>{t('约 4–12h；如果没有匹配的联网 Linux 环境，依赖打包可能更久。', '~4–12h; dependency packaging can take longer without a matching online Linux host.')}</span></li>
        <li><b>{t('服务器 + 两环境体检', 'Server + two environments')}</b><span>{t('约 2–6h。', '~2–6h.')}</span></li>
        <li><b>{t('两套最小数据链', 'Two minimal data paths')}</b><span>{t('约 1–3h，前提是 analyzer 路线已解决。', '~1–3h once the analyzer path is solved.')}</span></li>
        <li><b>{t('SFT + 缩小 RL + profiling', 'SFT + reduced RL + profiling')}</b><span>{t('先按 12–24h 预留。', 'Reserve 12–24h initially.')}</span></li>
        <li><b>{t('两环境完整运行', 'Full runs for both environments')}</b><span>{t('目前只用 72–144h 作为四卡排期先验；拿到 5 个稳定 update 后立刻用实测 wall-clock 重算。', 'Use 72–144h only as an initial four-GPU scheduling prior; replace it as soon as five stable update wall-clocks are measured.')}</span></li>
      </ul>
      <p class="time-note">{t('这里的小时数是工程排期，不是 3090 实测 benchmark。机器拓扑、OOM 调参、WebShop 依赖和 analyzer 都可能把时间拉长。', 'These hours are engineering planning ranges, not measured 3090 benchmarks. GPU topology, OOM tuning, WebShop dependencies, and the analyzer can all extend the schedule.')}</p>
    </div>
    <aside>
      <p class="section-kicker">{t('最难的 5 件事', 'The five hardest parts')}</p>
      <ol>
        <li><strong>{t('离线依赖', 'Offline dependencies')}</strong><span>{t('缺一个 wheel、模型分片或 WebShop 索引都会在服务器上变成硬阻塞。', 'One missing wheel, model shard, or WebShop index becomes a hard blocker offline.')}</span></li>
        <li><strong>Stage 1 analyzer</strong><span>{t('论文 SFT 数据需要外部 analyzer；你的服务器没有公网，必须提前确定合规路径。', 'Paper-style SFT data needs an external analyzer; the offline server needs an approved route planned in advance.')}</span></li>
        <li><strong>4×24GB</strong><span>{t('显存和 GPU 拓扑决定能否直接用默认配置，OOM 后需要调整 micro-batch / parallelism。', 'VRAM and topology determine whether defaults fit; OOM may require micro-batch / parallelism changes.')}</span></li>
        <li><strong>WebShop</strong><span>{t('它的数据、搜索索引和较老依赖栈比 ALFWorld 更容易出现环境问题。', 'Its data, search index, and older dependency stack make environment failures more likely than ALFWorld.')}</span></li>
        <li><strong>{t('判断“成功”', 'Judging success')}</strong><span>{t('脚本能跑只证明工程链通了；最终还要把 SEED 和同条件 GRPO 放在一起比较。', 'A running script proves the engineering chain only; final method evidence still compares SEED against same-condition GRPO.')}</span></li>
      </ol>
    </aside>
  </section>

  <footer class="source-note">
    <strong>{t('依据', 'Sources')}</strong>
    <span>{t('命令与默认参数来自当前官方 SEED 仓库；论文规模、150 policy updates、8×A800 80GB 和参考结果来自 SEED 论文；WebShop 本地环境输出与 setup 行为来自官方 WebShop 仓库。12–24h、72–144h 是本站的工程排期，需要被四卡真机 profiling 替换。', 'Commands and defaults come from the current official SEED repository; paper scale, 150 policy updates, 8×A800 80GB, and reference results come from the SEED paper; WebShop local-environment output and setup behavior come from the official WebShop repository. The 12–24h and 72–144h ranges are engineering planning ranges and should be replaced by four-GPU profiling.')}</span>
