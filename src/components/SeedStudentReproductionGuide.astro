---
import type { Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;

const offlineEnv = `export EXPECTED_GPU_COUNT="\${EXPECTED_GPU_COUNT:-4}"
export N_GPUS_PER_NODE="\${N_GPUS_PER_NODE:-\$EXPECTED_GPU_COUNT}"
export DATA_PARALLEL_SIZE="\${DATA_PARALLEL_SIZE:-\$EXPECTED_GPU_COUNT}"
export TENSOR_PARALLEL_SIZE="\${TENSOR_PARALLEL_SIZE:-1}"
export CUDA_VISIBLE_DEVICES=0,1,2,3
export WANDB_MODE=offline
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export MODELS_ROOT=/srv/seed/models
export DATA_ROOT=/srv/seed/data`;

const preflight = String.raw`chmod +x /srv/seed/tools/seed-4x3090-preflight.sh
SEED_ROOT=/srv/seed EXPECTED_GPU_COUNT=4 \
bash /srv/seed/tools/seed-4x3090-preflight.sh`;

const alfworldSmoke = String.raw`RUN_MODE=smoke \
DATA_PARALLEL_SIZE=4 \
TENSOR_PARALLEL_SIZE=1 \
MODEL_PATH="$MODELS_ROOT/Qwen2.5-3B-Instruct" \
SKILL_BASE_URL=http://127.0.0.1:8000/v1 \
SKILL_API_KEY=EMPTY \
SKILL_MODEL=local-analyzer \
bash scripts/sft/alfworld/prepare_data.sh`;

const webshopSmoke = String.raw`NUM_TASKS=1 \
ROLLOUTS_PER_TASK=1 \
MAX_TASKS=1 \
MAX_CANDIDATES=2 \
WEBSHOP_USE_SMALL=1 \
DATA_PARALLEL_SIZE=4 \
TENSOR_PARALLEL_SIZE=1 \
MODEL_PATH="$MODELS_ROOT/Qwen2.5-3B-Instruct" \
SKILL_BASE_URL=http://127.0.0.1:8000/v1 \
SKILL_API_KEY=EMPTY \
SKILL_MODEL=local-analyzer \
bash scripts/sft/webshop/prepare_data.sh`;

const progressCheck = String.raw`python - <<'PY'
import json, pathlib
for path in pathlib.Path('outputs').glob('*/progress.json'):
    p = json.loads(path.read_text())
    print(path)
    for k in ['status','completed_rollouts','expected_rollouts','completed_skills','parse_ok_skills','sft_records']:
        print(f'  {k}: {p.get(k)}')
PY`;

const sft = String.raw`NPROC_PER_NODE=4 bash scripts/sft/alfworld/train_sft.sh
NPROC_PER_NODE=4 bash scripts/sft/webshop/train_sft.sh`;

const dryRun = String.raw`N_GPUS_PER_NODE=4 DRY_RUN=true \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh

N_GPUS_PER_NODE=4 DRY_RUN=true \
bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;

const shortRun = String.raw`N_GPUS_PER_NODE=4 TOTAL_EPOCHS=10 SAVE_FREQ=5 TEST_FREQ=5 \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh

N_GPUS_PER_NODE=4 TOTAL_EPOCHS=10 SAVE_FREQ=5 TEST_FREQ=5 \
bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;

const fullRun = String.raw`N_GPUS_PER_NODE=4 bash examples/seed_trainer/run_alfworld_sft_glm_self.sh
N_GPUS_PER_NODE=4 bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;

const grpo = String.raw`MODEL_PATH="$MODELS_ROOT/Qwen2.5-3B-Instruct" \
bash examples/grpo_trainer/run_alfworld.sh trainer.n_gpus_per_node=4

MODEL_PATH="$MODELS_ROOT/Qwen2.5-3B-Instruct" \
bash examples/grpo_trainer/run_webshop.sh trainer.n_gpus_per_node=4`;

const migrate = String.raw`export EXPECTED_GPU_COUNT=8
export N_GPUS_PER_NODE=8
export DATA_PARALLEL_SIZE=8
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
SEED_ROOT=/srv/seed EXPECTED_GPU_COUNT=8 \
bash /srv/seed/tools/seed-4x3090-preflight.sh
N_GPUS_PER_NODE=8 DRY_RUN=true \
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh`;

const route = [
  ['00', t('准备离线包', 'Prepare offline bundle')],
  ['01', t('四卡服务器体检', 'Preflight four GPUs')],
  ['02', t('ALFWorld 最小跑通', 'ALFWorld smoke')],
  ['03', t('WebShop 最小跑通', 'WebShop smoke')],
  ['04', t('训练两套 SFT', 'Train both SFT checkpoints')],
  ['05', t('四卡 RL 短跑', 'Short-run four-GPU RL')],
  ['06', t('完整训练 + GRPO 对照', 'Full run + GRPO control')],
  ['07', t('必要时迁移 8 卡', 'Migrate to eight GPUs if needed')],
];
---

<section id="seed-student-mainline" class="seed-mainline" aria-labelledby="seed-mainline-title">
  <header class="hero">
    <p class="section-kicker">{t('SEED 复现主线 · ALFWorld + WebShop', 'SEED reproduction mainline · ALFWorld + WebShop')}</p>
    <h2 id="seed-mainline-title">{t('先用 4×RTX 3090 把两套实验一路跑到底', 'Take both experiments end to end on 4×RTX 3090 first')}</h2>
    <p>{t('服务器没有公网，所以先在联网端把模型、数据和依赖准备齐，再通过 SFTP 放进实验室。每一步只做一个判断：这一步有没有真的跑通。过了再放大。四张 3090 如果能完成计划中的完整训练和评测，我们在这个 3090 上就全部做完了。', 'The server has no public internet, so prepare models, data, and dependencies online and move them into the lab over SFTP. Each step answers one question: did this stage really work? Scale only after it passes. If four 3090s finish the planned full training and evaluation, the reproduction is complete there.')}</p>
    <div class="finish"><b>{t('最后怎么算完成？', 'When are we done?')}</b><span>{t('ALFWorld 和 WebShop 都完成完整训练与评测；SEED 与同条件 GRPO 有可比较结果；checkpoint、metrics、日志、配置、Git SHA 和数据 hash 都能追溯。', 'ALFWorld and WebShop both finish full training/evaluation; SEED has a comparable same-condition GRPO control; checkpoints, metrics, logs, configs, Git SHA, and data hashes are traceable.')}</span></div>
  </header>

  <nav class="route" aria-label={t('SEED 复现目录', 'SEED reproduction route')}>
    {route.map(([n, label]) => <a href={`#seed-step-${n}`}><b>{n}</b><span>{label}</span></a>)}
  </nav>

  <section class="success" aria-labelledby="success-title">
    <h3 id="success-title">{t('先把“成功”分成 6 层', 'Use six levels of success')}</h3>
    <ol>
      <li><b>1</b><span><strong>{t('机器准备好', 'Machine ready')}</strong>{t('preflight 全 PASS。', 'Preflight is all PASS.')}</span></li>
      <li><b>2</b><span><strong>{t('环境能跑', 'Environment works')}</strong>{t('能 reset、action、observation，WebShop 本地搜索也能用。', 'Reset/action/observation work, including local WebShop search.')}</span></li>
      <li><b>3</b><span><strong>{t('Stage 1 有产物', 'Stage 1 has artifacts')}</strong>{t('progress.json 里 rollout、skill、parse_ok_skills、sft_records 都有有效值。', 'progress.json has real rollout, skill, parse_ok_skills, and sft_records values.')}</span></li>
      <li><b>4</b><span><strong>{t('训练链跑通', 'Training chain works')}</strong>{t('SFT checkpoint 能加载；RL 能更新、保存、恢复；没有 NaN/Inf。', 'SFT checkpoint loads; RL updates, saves, resumes; no NaN/Inf.')}</span></li>
      <li><b>5</b><span><strong>{t('方法复现', 'Method reproduction')}</strong>{t('同模型/环境/评测下，多次 SEED 与 GRPO 对照能支持方法效果。', 'Repeated SEED vs GRPO controls under the same model/environment/evaluation support the method effect.')}</span></li>
      <li><b>6</b><span><strong>{t('论文可比', 'Paper comparable')}</strong>{t('再对齐 180×8 Stage 1、SFT 3 epochs、150 policy updates、评测和 8×A800 80GB。', 'Then align 180×8 Stage 1, 3 SFT epochs, 150 policy updates, evaluation, and 8×A800 80GB.')}</span></li>
    </ol>
  </section>

  <section id="seed-step-00" class="step"><b class="num">00</b><div>
    <h3>{t('联网端先做完整离线包', 'Build the full offline bundle on the online side')}</h3>
    <p>{t('代码放 GitHub 管版本；模型、ALFWorld 数据、准备好的 WebShop、Linux/Python/CUDA 依赖和 preflight 脚本通过 SFTP 搬运。WebShop 的 setup 会联网下载数据、spaCy 并建立搜索索引，所以要在联网 Linux 环境先做完。', 'Use GitHub for code history; move the model, ALFWorld data, prepared WebShop, Linux/Python/CUDA dependencies, and preflight script over SFTP. WebShop setup downloads data/spaCy and builds the search index, so finish it on an online Linux host.')}</p>
    <p class="paths"><code>code/</code><code>models/</code><code>data/alfworld/</code><code>data/webshop/</code><code>env/</code><code>tools/</code><code>runs/</code><code>SHA256SUMS.txt</code></p>
    <div class="gate"><b>{t('通过', 'Pass')}</b><span>{t('服务器不需要临时联网补文件；实验代码有 Git SHA；模型和数据有 SHA256。', 'No last-minute internet downloads; code has a Git SHA; models/data have SHA256.')}</span></div>
  </div></section>

  <section id="seed-step-01" class="step"><b class="num">01</b><div>
    <h3>{t('看到 READY 再开始训练', 'Start training only after READY')}</h3>
    <pre><code>{preflight}</code></pre><pre><code>{offlineEnv}</code></pre>
    <a href="/guides/seed-4x3090-preflight.sh">{t('打开 preflight 脚本', 'Open the preflight script')}</a>
    <div class="gate"><b>{t('通过', 'Pass')}</b><span><code>READY: offline bundle and GPU visibility passed the preflight gate.</code></span></div>
  </div></section>

  <section id="seed-step-02" class="step"><b class="num">02</b><div>
    <h3>ALFWorld · {t('先跑官方 smoke', 'run the official smoke path')}</h3>
    <p>{t('官方脚本支持 RUN_MODE=smoke；每类默认 1 task × 1 rollout。四卡把 DATA_PARALLEL_SIZE 从默认 8 改成 4。Stage 1 还需要 skill analyzer：实验室有本地 analyzer 就用内网地址；没有就把 Stage 1 数据在合规联网环境生成并 hash 后带回来。', 'The official script supports RUN_MODE=smoke, defaulting to 1 task × 1 rollout per type. On four GPUs set DATA_PARALLEL_SIZE=4 instead of the default 8. Stage 1 also needs a skill analyzer: use an internal endpoint if available, otherwise generate Stage-1 data in an approved online environment and bring it back with hashes.')}</p>
    <pre><code>{alfworldSmoke}</code></pre><pre><code>{progressCheck}</code></pre>
    <div class="gate"><b>{t('通过', 'Pass')}</b><span><code>completed_rollouts == expected_rollouts</code>；<code>completed_skills</code>、<code>parse_ok_skills</code>、<code>sft_records</code> &gt; 0。</span></div>
  </div></section>

  <section id="seed-step-03" class="step"><b class="num">03</b><div>
    <h3>WebShop · {t('先确认本地商店，再跑 1×1', 'prove the local shop, then run 1×1')}</h3>
    <p>{t('先运行 WebShop text environment。能看到 Products loaded、Loaded goals、Available actions，并完成一次 search/click，再进入 SEED。WebShop prepare_data 没有 RUN_MODE=smoke，所以用官方可覆盖参数缩成 1 task × 1 rollout。', 'Run the WebShop text environment first. Once it prints Products loaded, Loaded goals, Available actions and completes a search/click interaction, move to SEED. WebShop prepare_data has no RUN_MODE=smoke, so use its official override knobs for 1 task × 1 rollout.')}</p>
    <pre><code>{webshopSmoke}</code></pre>
    <div class="gate"><b>{t('通过', 'Pass')}</b><span>{t('本地交互成功，随后 progress.json 出现完成 rollout、有效 skill 和 SFT records。', 'Local interaction succeeds, then progress.json shows a completed rollout, valid skill, and SFT records.')}</span></div>
  </div></section>

  <section id="seed-step-04" class="step"><b class="num">04</b><div>
    <h3>{t('两套 Stage 1 都过了，再训练 SFT', 'Train SFT only after both Stage-1 paths pass')}</h3>
    <pre><code>{sft}</code></pre>
    <div class="gate"><b>{t('通过', 'Pass')}</b><span>{t('导出的 checkpoint 有 config.json 和模型权重；Stage-2 wrapper 能真正加载，不再报 HF model not found。', 'Exported checkpoint has config.json and weights; the Stage-2 wrapper loads it and no longer reports HF model not found.')}</span></div>
  </div></section>

  <section id="seed-step-05" class="step"><b class="num">05</b><div>
    <h3>{t('RL 先 DRY_RUN，再做 10 epochs 短跑', 'DRY_RUN first, then a 10-epoch RL short run')}</h3>
    <p>{t('官方 wrapper 默认 8 GPU，并提供 DRY_RUN。四卡显式写 N_GPUS_PER_NODE=4。短跑只用来确认显存、通信、保存/恢复和真实 update 时间。ALFWorld 与 WebShop 分开跑。', 'The official wrapper defaults to 8 GPUs and provides DRY_RUN. Explicitly set N_GPUS_PER_NODE=4. The short run checks memory, communication, save/resume, and real update time. Run ALFWorld and WebShop separately.')}</p>
    <pre><code>{dryRun}</code></pre><pre><code>{shortRun}</code></pre>
    <div class="gate"><b>{t('通过', 'Pass')}</b><span>{t('跨过 warm-up 后至少 5 个 update 稳定完成；loss/reward 有限；没有持续 OOM；checkpoint 能保存并恢复。记录每个 update wall-clock、峰值显存和 GPU 利用率。', 'After warm-up, at least five updates complete stably; loss/reward are finite; no persistent OOM; checkpoint saves/resumes. Record update wall-clock, peak VRAM, and GPU utilization.')}</span></div>
  </div></section>

  <section id="seed-step-06" class="step"><b class="num">06</b><div>
    <h3>{t('短跑稳定后，完整训练；再做同条件 GRPO', 'After stable short runs, finish training and add same-condition GRPO')}</h3>
    <pre><code>{fullRun}</code></pre>
    <p>{t('论文报告 150 policy updates；当前公开 Stage-2 wrapper 的 TOTAL_EPOCHS 默认是 160。做论文可比实验前，要核对代码里 epoch 与实际 update 的映射，不要只把一个变量改成 150 就当作对齐。', 'The paper reports 150 policy updates; the current public Stage-2 wrapper defaults TOTAL_EPOCHS to 160. Before a paper-comparable run, verify how epochs map to actual updates instead of simply setting one variable to 150.')}</p>
    <h4>{t('GRPO 对照', 'GRPO control')}</h4><pre><code>{grpo}</code></pre>
    <p class="paper">{t('论文 Qwen2.5-3B-Instruct 参考：ALFWorld avg 91.8；WebShop score 88.5；success 78.9。它们是量级和趋势参考，四卡单次 run 不需要精确复刻。', 'Paper reference for Qwen2.5-3B-Instruct: ALFWorld avg 91.8; WebShop score 88.5; success 78.9. These are scale/trend references, not exact targets for one four-GPU run.')}</p>
    <div class="gate final"><b>{t('主线完成', 'Mainline complete')}</b><span>{t('两环境完整训练 + 评测完成，SEED/GRPO 可比较，所有结果能追溯。研究问题已经回答时：我们在这个 3090 上就全部做完了。', 'Both environments finish full training + evaluation, SEED/GRPO are comparable, and all results are traceable. If the research question is answered, the 3090 reproduction is complete.')}</span></div>
  </div></section>

  <section id="seed-step-07" class="step"><b class="num">07</b><div>
    <h3>{t('3090 卡在显存或时间，再迁移 8 卡', 'Move to eight GPUs only if 3090 is blocked by memory or time')}</h3>
    <p>{t('实验逻辑不改；模型/数据/评测/run manifest 不改。只把 GPU 数、data parallel 和必要显存参数换到 8 卡，再重复 preflight → DRY_RUN → short run。8×A800 80GB 更接近论文硬件；8×A100 80GB 是硬件替代的方法复现。', 'Keep experiment logic, model/data/evaluation/run manifest unchanged. Change GPU count, data parallel, and necessary memory knobs, then repeat preflight → DRY_RUN → short run. 8×A800 80GB matches paper hardware more closely; 8×A100 80GB is a hardware-substituted method reproduction.')}</p>
    <pre><code>{migrate}</code></pre>
  </div></section>

  <section class="time-risk">
    <div><p class="section-kicker">{t('需要多久', 'Time')}</p><h3>{t('先按 1–2 天跑通链路；完整两环境先按 3–6 天排期', 'Plan 1–2 days to prove the chain; 3–6 days for both full environments')}</h3>
      <p>{t('离线材料 4–12h；服务器和两环境体检 2–6h；最小数据链 1–3h（analyzer 已解决）；SFT + 缩小 RL + profiling 先留 12–24h；完整两环境目前只把 72–144h 当四卡排期先验。拿到 5 个稳定 update 后，立刻用实测 wall-clock 重算。', 'Offline staging 4–12h; server/two-environment bring-up 2–6h; minimal data paths 1–3h once analyzer is solved; reserve 12–24h for SFT + reduced RL + profiling; use 72–144h only as an initial four-GPU scheduling prior for both full environments. Recalculate immediately after five stable updates.')}</p>
      <small>{t('这些是工程排期，不是 RTX 3090 实测 benchmark。', 'These are engineering planning ranges, not measured RTX 3090 benchmarks.')}</small>
    </div>
    <aside><p class="section-kicker">{t('主要难点', 'Main difficulties')}</p><ol>
      <li>{t('离线依赖：wheel、模型分片、ALFWorld 数据、WebShop 索引缺一个都会硬阻塞。', 'Offline dependencies: one missing wheel, model shard, ALFWorld asset, or WebShop index can hard-block the run.')}</li>
      <li>{t('Stage 1 analyzer：论文数据构造需要外部 analyzer，你的服务器没有公网。', 'Stage-1 analyzer: paper-style data construction needs an external analyzer while the server is offline.')}</li>
      <li>{t('4×24GB：OOM 后要调 micro-batch / parallelism，并受 GPU topology 影响。', '4×24GB: OOM tuning may require micro-batch/parallelism changes and depends on GPU topology.')}</li>
      <li>{t('WebShop：数据、搜索索引和旧依赖栈比 ALFWorld 更容易出环境问题。', 'WebShop: data, search index, and older dependencies create more environment risk than ALFWorld.')}</li>
      <li>{t('“能跑”与“方法复现”不同：最后必须有同条件 GRPO 对照。', '“Runs” and “method reproduced” differ: the final evidence needs a same-condition GRPO control.')}</li>
    </ol></aside>
  </section>

  <footer class="sources"><strong>{t('依据：', 'Sources: ')}</strong>{t('当前官方 SEED 代码与论文，以及官方 ALFWorld / WebShop 仓库。论文规模是 Stage 1 180×8、SFT 3 epochs、RL 150 policy updates，训练硬件为 8×NVIDIA A800 80GB。', 'Current official SEED code/paper and official ALFWorld/WebShop repositories. Paper scale is Stage 1 180×8, SFT 3 epochs, RL 150 policy updates, trained on 8×NVIDIA A800 80GB.')} <a href="https://github.com/jinyangwu/SEED" target="_blank" rel="noreferrer">SEED ↗</a> · <a href="https://arxiv.org/abs/2607.14777" target="_blank" rel="noreferrer">paper ↗</a> · <a href="https://github.com/alfworld/alfworld" target="_blank" rel="noreferrer">ALFWorld ↗</a> · <a href="https://github.com/princeton-nlp/WebShop" target="_blank" rel="noreferrer">WebShop ↗</a></footer>
</section>

<style>
  .seed-mainline{margin:18px 0 76px}.hero{max-width:900px;padding:28px 0 30px;border-bottom:1px solid var(--line)}.hero h2{max-width:820px;margin:7px 0 12px;font-size:clamp(1.7rem,3vw,2.55rem);letter-spacing:-.025em}.hero>p{max-width:850px;color:var(--muted);line-height:1.75}.finish,.gate{display:grid;grid-template-columns:140px minmax(0,1fr);gap:12px;padding:14px 16px;margin-top:16px;background:var(--surface-muted);border-left:3px solid var(--line)}.finish,.gate.final{border-left-color:var(--accent)}.finish span,.gate span{color:var(--muted)}
  .route{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:24px 0 44px;border-top:1px solid var(--line)}.route a{display:flex;gap:9px;padding:13px 9px;color:inherit;text-decoration:none;border-bottom:1px solid var(--line)}.route b,.num{font-family:var(--font-mono,monospace);color:var(--accent-deep)}
  .success{padding:22px;border:1px solid var(--line);border-radius:12px;margin-bottom:40px}.success h3{margin-top:0}.success ol{list-style:none;padding:0;margin:16px 0 0;display:grid;gap:9px}.success li{display:grid;grid-template-columns:30px 1fr;gap:10px}.success li>b{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--surface-muted)}.success strong{display:block}.success span{color:var(--muted)}
  .step{display:grid;grid-template-columns:54px minmax(0,1fr);gap:20px;padding:34px 0;border-top:1px solid var(--line);scroll-margin-top:90px}.step>div{max-width:920px}.step h3{margin:0 0 9px;max-width:800px}.step p{max-width:850px;color:var(--muted);line-height:1.7}.step h4{margin:22px 0 8px}.paths{display:flex;flex-wrap:wrap;gap:7px}.paths code{padding:6px 8px;background:var(--surface-muted);border-radius:6px}pre{padding:15px 17px;margin:14px 0;overflow-x:auto;border:1px solid var(--line);border-radius:9px;background:var(--surface-muted)}pre code{font-family:var(--font-mono,monospace);font-size:.78rem;line-height:1.58}.paper{padding:14px 16px;border:1px solid var(--line);border-radius:9px}
  .time-risk{display:grid;grid-template-columns:1.15fr .85fr;gap:32px;padding:34px 0;border-top:2px solid var(--text)}.time-risk h3{margin:6px 0 10px}.time-risk p,.time-risk small,.time-risk aside{color:var(--muted)}.time-risk aside{padding-left:24px;border-left:1px solid var(--line)}.time-risk li+li{margin-top:9px}.sources{padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font-size:.82rem;line-height:1.65}.sources strong{color:var(--text)}
  @media(max-width:760px){.route{grid-template-columns:repeat(2,1fr)}.time-risk{grid-template-columns:1fr}.time-risk aside{padding:22px 0 0;border-left:0;border-top:1px solid var(--line)}}@media(max-width:560px){.step,.finish,.gate{grid-template-columns:1fr}.step{gap:6px}.route{grid-template-columns:1fr}}
</style>
