---
import ExternalBrandMark from './common/ExternalBrandMark';
import { localePath, type Locale } from '../i18n';
import { aiGalaxySeedSnapshot as market } from '../data/aiGalaxySeedSnapshot';

interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const paperHref = localePath(locale, '/papers/seed/');
const modelHref = localePath(locale, '/models/qwen2-5-3b-instruct/');
const guideHref = `${localePath(locale, '/guide/')}#seed-reproduction`;
const workspaceHref = `${localePath(locale, '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1`;

const alfworldInstall = `conda create -n seed python==3.12 -y
conda activate seed
pip3 install vllm==0.11.0
pip3 install flash-attn==2.7.4.post1 --no-build-isolation --no-cache-dir
pip install -e .
pip3 install gymnasium==0.29.1
pip3 install stable-baselines3==2.6.0
pip3 install alfworld
alfworld-download -f`;
const alfworldRun = `bash scripts/sft/alfworld/prepare_data.sh
bash scripts/sft/alfworld/train_sft.sh
bash examples/seed_trainer/run_alfworld_sft_glm_self.sh`;
const webshopInstall = `conda create -n seed-webshop python==3.10 -y
conda activate seed-webshop
cd ./agent_system/environments/env_package/webshop/webshop
./setup.sh -d all
cd <SEED_REPO_ROOT>
pip3 install torch==2.6.0 --index-url https://download.pytorch.org/whl/cu124
pip3 install flash-attn==2.7.4.post1 --no-build-isolation
pip3 install -e .
pip3 install vllm==0.8.2`;
const webshopRun = `bash scripts/sft/webshop/prepare_data.sh
bash scripts/sft/webshop/train_sft.sh
bash examples/seed_trainer/run_webshop_sft_glm_self.sh`;
const envFile = `CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
WANDB_MODE=offline
MODELS_ROOT=/path/to/models
DATA_ROOT=/path/to/data-root
OPENAI_API_KEY=...
OPENAI_BASE_URL=...
OPENAI_MODEL=glm-5.2`;
---

<section id="seed-reproduction" class:list={['seed-reproduction', { compact }]} aria-labelledby="seed-reproduction-title">
  <header class="repro-hero">
    <div>
      <span class="section-kicker">{t('SEED 复现实战 · 从目标倒推', 'SEED reproduction · work backwards from the claim')}</span>
      <h2 id="seed-reproduction-title">{t('复现目标与 GPU 选择', 'Reproduction goals and GPU selection')}</h2>
      <p>{t('论文写的是 8×NVIDIA A800 80G，但算力市场不是论文附录：卡型、价格和库存都会变化。正确做法不是把“80G”都当成一样，而是把论文条件、当前市场和你的实验声明分开。', 'The paper uses 8×NVIDIA A800 80G, but a cloud marketplace is not a paper appendix: SKUs, prices, and inventory change. Do not treat every “80G” GPU as equivalent; keep paper conditions, current market facts, and your experiment claim separate.')}</p>
    </div>
    <aside>
      <strong>{t('这页只保留一条判断线', 'One decision line')}</strong>
      <p>{t('环境有没有跑通？→ 训练链有没有跑通？→ 是否要论文规模？→ 是否要求硬件也严格一致？每到下一步，才升级算力。', 'Does the environment run? → Does the training chain run? → Do you need paper scale? → Must the hardware match exactly? Upgrade compute only when the next question requires it.')}</p>
    </aside>
  </header>

  <ol class="mainline">
    <li><span>01</span><strong>{t('声明', 'Claim')}</strong><small>{t('方法验证 / 论文规模 / 严格硬件复现', 'Method / paper-scale / exact hardware')}</small></li>
    <li><span>02</span><strong>{t('环境', 'Environment')}</strong><small>ALFWorld → WebShop</small></li>
    <li><span>03</span><strong>{t('训练链', 'Training chain')}</strong><small>rollout → skill → OPD / GRPO</small></li>
    <li><span>04</span><strong>{t('真实算力', 'Real compute')}</strong><small>{t('按当前 SKU 选择，不猜库存', 'Choose from current SKUs; do not invent stock')}</small></li>
    <li><span>05</span><strong>{t('验证', 'Validation')}</strong><small>{t('结论与硬件替代边界写清楚', 'State the hardware-substitution boundary')}</small></li>
  </ol>

  <section class="block market-block" aria-labelledby="galaxy-title">
    <div class="section-heading-inline">
      <div>
        <span class="section-kicker">AI Galaxy / 智星云 · {isZh ? '公开产品快照' : 'public product snapshot'}</span>
        <h3 id="galaxy-title">{t('智星云 GPU 目录与选择', 'AI Galaxy GPU catalog and selection')}</h3>
      </div>
      <time datetime={market.checkedAtIso}>{isZh ? market.checkedAtZh : market.checkedAtEn}</time>
    </div>
    <p class="market-boundary">{isZh ? market.evidenceBoundary.zh : market.evidenceBoundary.en}</p>

    <div class="paper-vs-market">
      <article>
        <small>{t('论文要求', 'Paper condition')}</small>
        <h4>8×NVIDIA A800 80G</h4>
        <p>{t('SEED Appendix B.4 明确写明训练使用 8 张 A800 80G。这个条件相对稳定。', 'SEED Appendix B.4 explicitly reports training on eight A800 80G GPUs. This is a relatively stable paper fact.')}</p>
      </article>
      <span aria-hidden="true">≠</span>
      <article class="market-current">
        <small>{t('智星云当前公开目录', 'Current AI Galaxy public catalog')}</small>
        <h4>{t('没有公开列出 A800 80G×8', 'No public 8×A800 80G listing')}</h4>
        <p>{t('因此不能在这个平台的公开 SKU 中选一个别的 80G 卡，然后继续把实验叫“严格硬件复现”。', 'So you cannot choose another 80G SKU from the public catalog and still call the experiment an exact hardware reproduction.')}</p>
      </article>
    </div>

    <h4 class="decision-title">{t('新手直接照这个顺序选', 'A beginner can follow this exact order')}</h4>
    <div class="decision-grid">
      <article class="decision-card">
        <span class="decision-step">A</span>
        <small>{t('只想先把环境跑通', 'Only prove the environment')}</small>
        <h4>{market.recommendations.environment.sku}</h4>
        <strong>{market.recommendations.environment.price}</strong>
        <p>{isZh ? market.recommendations.environment.zh : market.recommendations.environment.en}</p>
        <div class="claim-label">{t('你的实验声明：环境 / rollout smoke test', 'Claim: environment / rollout smoke test')}</div>
      </article>
      <article class="decision-card">
        <span class="decision-step">B</span>
        <small>{t('开始验证 SFT + RL 训练链', 'Start validating the SFT + RL chain')}</small>
        <h4>{market.recommendations.reducedTraining.sku}</h4>
        <strong>{market.recommendations.reducedTraining.price}</strong>
        <p>{isZh ? market.recommendations.reducedTraining.zh : market.recommendations.reducedTraining.en}</p>
        <div class="claim-label">{t('你的实验声明：缩小规模的方法验证', 'Claim: reduced-scale method reproduction')}</div>
      </article>
      <article class="decision-card recommended">
        <span class="decision-step">C</span>
        <small>{t('要在智星云做最接近论文规模的版本', 'Closest paper-scale run available on AI Galaxy')}</small>
        <h4>{market.recommendations.paperScaleSubstitute.sku}</h4>
        <strong>{market.recommendations.paperScaleSubstitute.price}</strong>
        <p>{isZh ? market.recommendations.paperScaleSubstitute.zh : market.recommendations.paperScaleSubstitute.en}</p>
        <div class="claim-label">{t('你的实验声明：论文规模、硬件替代的方法复现', 'Claim: paper-scale, hardware-substituted method reproduction')}</div>
      </article>
      <article class="decision-card strict">
        <span class="decision-step">D</span>
        <small>{t('必须连硬件也严格复现', 'Hardware must match exactly')}</small>
        <h4>{market.recommendations.strict.sku}</h4>
        <strong>{market.recommendations.strict.price}</strong>
        <p>{isZh ? market.recommendations.strict.zh : market.recommendations.strict.en}</p>
        <div class="claim-label">{t('你的实验声明：只有拿到 A800 80G×8 后才叫严格硬件复现', 'Claim: exact hardware reproduction only after securing 8×A800 80G')}</div>
      </article>
    </div>

    <section class="why-a100" aria-labelledby="why-a100-title">
      <div>
        <span class="section-kicker">{t('为什么 C 选 A100 80G NVLINK×8', 'Why option C is 8×A100 80G NVLINK')}</span>
        <h4 id="why-a100-title">{t('A100 替代方案尽量减少关键条件变化', 'An A100 substitute minimizes changes to critical conditions')}</h4>
      </div>
      <ul>
        <li>{t('并行规模保持 8 张 GPU：先不改论文里的并行规模。', 'Keep the parallel scale at eight GPUs rather than changing the paper’s setup first.')}</li>
        <li>{t('单卡显存保持 80GB：避免 40GB / 24GB 迫使你修改切分、batch 或 rollout 结构。', 'Keep 80GB per GPU so 40GB / 24GB constraints do not force changes to sharding, batch, or rollout structure.')}</li>
        <li>{t('GPU 类型保持 Ampere 数据中心卡；智星云这个八卡 SKU 也明确标注 NVLINK。', 'Keep the GPU class at Ampere data-center cards; this AI Galaxy eight-GPU SKU also explicitly lists NVLINK.')}</li>
        <li>{t('但型号不同，所以训练吞吐、通信和时间成本可能变化；这一差异必须写进报告。', 'The model is still different, so throughput, communication behavior, and wall-clock cost can change; report that difference explicitly.')}</li>
      </ul>
    </section>

    <div class="catalog-wrap">
      <div>
        <h4>{t('公开按小时卡型', 'Public hourly GPU listings')}</h4>
        <table>
          <thead><tr><th>GPU</th><th>{t('显存', 'VRAM')}</th><th>{t('公开价格', 'Public price')}</th></tr></thead>
          <tbody>{market.hourly.map((item) => <tr><td>{item.gpu}</td><td>{item.vramGb}GB</td><td>¥{item.cnyPerHour.toFixed(2)}/{t('小时', 'h')}</td></tr>)}</tbody>
        </table>
      </div>
      <div>
        <h4>{t('公开八卡裸金属', 'Public eight-GPU bare metal')}</h4>
        <table>
          <thead><tr><th>GPU</th><th>{t('显存/卡', 'VRAM/GPU')}</th><th>{t('公开价格', 'Public price')}</th></tr></thead>
          <tbody>{market.bareMetal.map((item) => <tr><td>{item.gpu} ×{item.count}</td><td>{item.vramGb}GB</td><td>¥{item.cnyPerMonth.toLocaleString()}/{t('月', 'mo')}</td></tr>)}</tbody>
        </table>
      </div>
    </div>

    <aside class="not-recommended">
      <strong>{t('为什么不是便宜很多的 4090×8？', 'Why not the much cheaper 8×4090?')}</strong>
      <p>{t('因为论文是 80GB/卡，而 4090 是 24GB/卡；智星云公开的 4090 八卡配置还没有列出高速网卡。为了让它跑起来，你很可能必须改显存相关配置、并行方式甚至训练吞吐。它适合新的工程实验，不是“更便宜的同一个复现”。A100 40G×8 也会把每卡显存减半，所以排在 A100 80G×8 之后。', 'Because the paper uses 80GB per GPU while 4090 has 24GB per GPU; AI Galaxy’s public 8×4090 configuration also does not list a high-speed NIC. Making it fit can force memory-related configuration, parallelism, and throughput changes. It is useful for a new engineering experiment, not a cheaper version of the same reproduction. 8×A100 40G also halves per-GPU memory, so it ranks behind 8×A100 80G.')}</p>
    </aside>

    <div class="market-actions">
      <a class="button button-primary" href="https://gpu.ai-galaxy.com/store" target="_blank" rel="noreferrer">{t('现在打开算力市场，核对实时库存', 'Open the marketplace and check live inventory')} ↗</a>
      <a class="button button-secondary" href={market.sources.enterprise} target="_blank" rel="noreferrer">{t('查看智星云公开八卡配置', 'Open AI Galaxy eight-GPU listings')} ↗</a>
      <a class="button button-secondary" href={market.sources.rentalGuide} target="_blank" rel="noreferrer">{t('查看官方租用流程 / 预约说明', 'Open official rental / reservation guide')} ↗</a>
    </div>
  </section>

  {!compact && <>
    <section class="block" aria-labelledby="alf-title">
      <span class="section-kicker">01 · ALFWorld</span>
      <h3 id="alf-title">{t('ALFWorld 最小复现配置', 'ALFWorld minimal reproduction setup')}</h3>
      <p class="muted">{t('这里的目标不是训练出论文分数，而是确认 observation → action → reward → terminal outcome 这条环境链完整。对 Qwen2.5-3B 的单条推理 smoke test，优先用智星云当前公开的 1×RTX 4090 24G；环境没通之前，不要租八卡。', 'The goal here is not paper scores; it is verifying a complete observation → action → reward → terminal-outcome path. For a single Qwen2.5-3B inference smoke test, start with AI Galaxy’s current public 1×RTX 4090 24G option; do not rent eight GPUs before the environment works.')}</p>
      <div class="cards two"><article><h4>{t('安装', 'Install')}</h4><pre><code>{alfworldInstall}</code></pre></article><article><h4>{t('进入训练链', 'Enter the training chain')}</h4><pre><code>{alfworldRun}</code></pre><p>{t('按顺序保存一条 vanilla rollout，检查 Stage 1 trajectory → skill，再进入 Stage 2；这个顺序让每层证据都能独立验收。', 'Save a vanilla rollout, inspect Stage 1 trajectory → skill, then enter Stage 2. This order makes each evidence layer independently verifiable.')}</p></article></div>
      <p class="protocol"><strong>{t('论文协议：', 'Paper protocol: ')}</strong>{t('SFT 180 tasks × 8 rollouts；RL 2,400；150 次策略更新；batch 16；rollout group 8；prompt 2048；response 512；最大交互 30。测试 140 seen + 134 unseen，并按 6 类任务等权平均。', 'SFT 180 tasks × 8 rollouts; RL 2,400; 150 updates; batch 16; rollout group 8; prompt 2048; response 512; max 30 interactions. Test 140 seen + 134 unseen, equally weighted over six task categories.')}</p>
    </section>

    <section class="block" aria-labelledby="webshop-title">
      <span class="section-kicker">02 · WebShop</span>
      <h3 id="webshop-title">{t('第二阶段：WebShop 单独建 Python 3.10 环境，不为了“统一”破坏官方依赖', 'Stage two: give WebShop its own Python 3.10 environment instead of forcing cosmetic uniformity')}</h3>
      <p class="muted">{t('主 SEED 环境用 Python 3.12，而官方 WebShop 路径要求 Python ≤3.10。这里继续先做单条 episode；只有两个环境都稳定后，才进入更贵的训练资源。', 'The main SEED environment uses Python 3.12 while the official WebShop path requires Python ≤3.10. Continue with a single episode first; move to more expensive training compute only after both environments are stable.')}</p>
      <div class="cards two"><article><h4>{t('安装', 'Install')}</h4><pre><code>{webshopInstall}</code></pre></article><article><h4>{t('进入训练链', 'Enter the training chain')}</h4><pre><code>{webshopRun}</code></pre><p>{t('先确认页面状态、action 与 reward 能形成完整 episode，再生成 SFT 数据和训练。', 'First confirm page state, actions, and rewards form a complete episode before generating SFT data and training.')}</p></article></div>
      <p class="protocol"><strong>{t('论文协议：', 'Paper protocol: ')}</strong>{t('SFT 180 tasks × 8 rollouts；RL 2,400；150 次策略更新；batch 16；rollout group 8；prompt 4096；response 512；最大交互 15；测试 128 个任务，报告 Score 与 Succ。', 'SFT 180 tasks × 8 rollouts; RL 2,400; 150 updates; batch 16; rollout group 8; prompt 4096; response 512; max 15 interactions; test 128 tasks and report Score and Succ.')}</p>
    </section>

    <section class="block" aria-labelledby="training-title">
      <span class="section-kicker">03 · {t('缩小训练', 'Reduced training')}</span>
      <h3 id="training-title">{t('单卡 A100 80G 训练配置', 'Single-A100 80G training setup')}</h3>
      <p>{t('这一步才开始验证 SFT → GRPO / SEED 是否真正产生训练信号。保持 Qwen2.5-3B-Instruct，但缩小 batch、rollout 或任务数；你是在验证机制，不是在复现主表。80GB 的意义是减少因为显存不足而被迫改代码结构，而不是让实验自动变成严格复现。', 'This is where you start testing whether SFT → GRPO / SEED produces real training signals. Keep Qwen2.5-3B-Instruct but reduce batch, rollout count, or tasks; you are validating the mechanism, not reproducing the main table. The value of 80GB is reducing code distortions caused by memory pressure—not making the run strict automatically.')}</p>
    </section>

    <section class="block" aria-labelledby="env-title">
      <span class="section-kicker">04 · Common training config</span><h3 id="env-title">{t('论文规模运行变量', 'Paper-scale runtime variables')}</h3>
      <pre class="wide"><code>{envFile}</code></pre>
      <p class="protocol">{t('记录 repo commit、模型 revision、tokenizer/chat template、CUDA/driver、依赖锁定和实际 GPU 拓扑。换成 A100 时，GPU 型号与互联也必须进入 manifest，不能只写“8×80GB”。', 'Record repo commit, model revision, tokenizer/chat template, CUDA/driver, dependency lock state, and actual GPU topology. If substituting A100, record the GPU model and interconnect explicitly—not just “8×80GB.”')}</p>
    </section>

    <section class="block" aria-labelledby="validation-title">
      <span class="section-kicker">{t('最后才谈“复现成功”', 'Only now define reproduction success')}</span><h3 id="validation-title">{t('验证顺序：环境 → 数据链 → 训练信号 → 基线 → 论文结果 → 硬件差异', 'Validation order: environment → data path → training signal → baseline → paper result → hardware difference')}</h3>
      <ol class="validation"><li>{t('同一任务能重复启动，轨迹字段完整。', 'The same task starts reliably and yields a complete trajectory.')}</li><li>{t('Stage 1 能从 raw trajectory 追溯到 hindsight skill target。', 'Stage 1 traces a hindsight skill target back to the raw trajectory.')}</li><li>{t('Stage 2 的同一批 sampled actions 在普通与 skill 上下文重打分后产生可检查的 OPD 信号。', 'Stage 2 re-scores the same sampled actions in ordinary and skill contexts and yields an inspectable OPD signal.')}</li><li>{t('同模型同环境先跑 GRPO，再跑 SEED，否则无法归因 OPD。', 'Run GRPO before SEED under the same model and environment or OPD cannot be attributed.')}</li><li>{t('若使用 A100 80G NVLINK×8，报告必须把它列为硬件替代条件；不能写成“完全复现 8×A800 80G”。', 'If using 8×A100 80G NVLINK, the report must list it as a hardware substitution; do not write “exactly reproduced 8×A800 80G.”')}</li><li>{t('只有拿到 A800 80G×8，并且模型、数据、Table 5 超参数和评估协议也对齐，才进入严格硬件复现声明。', 'Only after securing 8×A800 80G and aligning model, data, Table 5 hyperparameters, and evaluation protocol should you make an exact-hardware reproduction claim.')}</li></ol>
    </section>
  </>}

  <section class="block sources" aria-labelledby="sources-title">
    <span class="section-kicker">{t('来源与时效', 'Sources and freshness')}</span>
    <h3 id="sources-title">{t('哪些内容是论文事实，哪些内容需要以后重新核验', 'What is a paper fact, and what must be rechecked later')}</h3>
    <ul>
      <li><strong>SEED:</strong> {t('8×A800 80G、训练超参数与 ALFWorld / WebShop 协议来自 arXiv v1。', '8×A800 80G, training hyperparameters, and ALFWorld / WebShop protocols come from arXiv v1.')} <a href="https://arxiv.org/html/2607.14777v1" target="_blank" rel="noreferrer">arXiv ↗</a></li>
      <li><strong>AI Galaxy:</strong> {t(`卡型与公开价格核验于 ${market.checkedAtZh}。这些信息会变，重新租卡前必须再次打开算力市场。`, `GPU SKUs and public prices were checked at ${market.checkedAtEn}. They can change; re-open the marketplace before renting again.`)} <a href={market.sources.hourly} target="_blank" rel="noreferrer">{t('公开云 GPU 页', 'Public cloud GPU page')} ↗</a> <a href={market.sources.enterprise} target="_blank" rel="noreferrer">{t('八卡配置', 'Eight-GPU configurations')} ↗</a></li>
      <li><strong>Qwen2.5-3B-Instruct:</strong> {t('官方模型页记录 3.09B 参数，仓库权重约 6.18GB；因此 24GB 4090 被这里只推荐为推理/环境 smoke test，而不是 RL 容量保证。', 'The official model page records 3.09B parameters and roughly 6.18GB of repository weights; that is why 24GB 4090 is recommended here only for inference/environment smoke tests, not as an RL capacity guarantee.')} <a href={market.sources.qwen} target="_blank" rel="noreferrer"><ExternalBrandMark href={market.sources.qwen} />Qwen ↗</a></li>
      <li><strong>NVIDIA A100:</strong> {t('官方规格确认 A100 80GB 属于 Ampere，80GB HBM2e，并支持 NVLink；这支持“它是当前公开目录中更接近的替代项”，但不把它变成 A800。', 'Official specifications confirm A100 80GB is Ampere, has 80GB HBM2e, and supports NVLink. That supports treating it as a closer current substitute, not as an A800 equivalent.')} <a href={market.sources.nvidiaA100} target="_blank" rel="noreferrer">NVIDIA ↗</a></li>
    </ul>
  </section>

  <footer class="repro-footer"><strong>{t('主线没有变：', 'The mainline never changes: ')}</strong>{t('先定义想证明什么，再决定模型、环境和算力。市场没有论文原卡时，要么改变实验声明，要么换供应商；不能改变事实的名字。', 'Define what you want to prove, then choose model, environment, and compute. If the marketplace lacks the paper’s GPU, either change the experiment claim or change providers; do not rename the facts.')}<nav><a href={compact ? guideHref : paperHref}>{compact ? t('打开完整实操', 'Open full practical guide') : t('SEED 论文页', 'SEED paper')} →</a><a href={modelHref}>Qwen2.5-3B-Instruct →</a><a href={workspaceHref}>{t('预填方法验证工作台', 'Prefill method workspace')} →</a></nav></footer>
</section>

<style>
  .seed-reproduction { margin: 56px 0; }
  .repro-hero { display:grid; grid-template-columns:minmax(0,1.7fr) minmax(250px,.7fr); gap:32px; padding-bottom:26px; border-bottom:1px solid var(--line); }
  .repro-hero h2 { margin:8px 0 12px; max-width:880px; }
  .repro-hero > div > p, .muted { color:var(--muted); }
  .repro-hero aside { padding:20px; border-left:3px solid var(--accent); background:var(--surface-muted); border-radius:0 14px 14px 0; }
  .repro-hero aside p { margin:7px 0 0; color:var(--muted); }
