---
import type { Locale } from '../i18n';
import { aiGalaxySeedSnapshot as market } from '../data/aiGalaxySeedSnapshot';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;

const hourly4090 = market.hourly.find((item) => item.gpu === 'RTX 4090 24G')?.cnyPerHour ?? 1.65;
const hourlyA100 = market.hourly.find((item) => item.gpu === 'NVIDIA A100 80G')?.cnyPerHour ?? 8;
const a100Eight = market.bareMetal.find((item) => item.gpu === 'A100 80G NVLINK');
const monthlyA100Eight = a100Eight?.cnyPerMonth ?? 30000;

const money = (value: number) => `¥${value.toFixed(value < 100 ? 1 : 0)}`;
const rangeCost = (lowHours: number, highHours: number, rate: number) => `${money(lowHours * rate)}–${money(highHours * rate)}`;

const fullRlPrompts = 2400;
const trainBatch = 16;
const rolloutGroup = 8;
const updates = fullRlPrompts / trainBatch;
const episodesPerUpdate = trainBatch * rolloutGroup;
const fullEpisodes = updates * episodesPerUpdate;
const alfMaxInteractions = fullEpisodes * 30;
const webMaxInteractions = fullEpisodes * 15;
const sftTrajectories = 180 * 8;

const exampleMedianUpdateMin = 8.2;
const exampleRlHours = exampleMedianUpdateMin * updates / 60;
const exampleFixedHours = 7;
const exampleRawHours = exampleRlHours + exampleFixedHours;
const exampleReserveHours = exampleRawHours * 1.15;
---

<section id="seed-compute-hours" class="seed-time-budget" aria-labelledby="seed-compute-hours-title">
  <header class="budget-head">
    <div>
      <span class="section-kicker">{t('SEED 复现 · 租卡时间预算', 'SEED reproduction · rental-time budget')}</span>
      <h2 id="seed-compute-hours-title">{t('不同方案到底要租多少小时？先给预算，再用真机数据改掉估算', 'How many rental hours does each option need? Start with a budget, then replace it with measurements')}</h2>
      <p>{t('SEED 论文没有报告 wall-clock 训练小时数，所以这里不能把一个“精确小时数”冒充成论文事实。下面的小时区间是租卡前的工程预算；真正开机后，用前 5 个稳定 update 的耗时重新计算。', 'The SEED paper does not report wall-clock training hours, so an exact runtime cannot honestly be presented as a paper fact. The ranges below are pre-rental engineering budgets; once the machine is running, replace them using the first five stable policy-update timings.')}</p>
    </div>
    <aside>
      <strong>{t('时效边界', 'Freshness boundary')}</strong>
      <p>{t(`GPU 价格沿用智星云公开产品快照：${market.checkedAtZh}。小时数不是平台承诺，也不是作者实测。`, `GPU prices use the AI Galaxy public-product snapshot checked at ${market.checkedAtEn}. Runtime ranges are neither platform guarantees nor author-reported measurements.`)}</p>
    </aside>
  </header>

  <div class="fact-strip" role="list" aria-label={t('论文可验证的工作量', 'Verifiable paper workload')}>
    <div role="listitem"><small>{t('RL prompts / 环境', 'RL prompts / env')}</small><strong>{fullRlPrompts.toLocaleString()}</strong></div>
    <div role="listitem"><small>{t('策略更新', 'Policy updates')}</small><strong>{updates}</strong><span>{fullRlPrompts} ÷ {trainBatch}</span></div>
    <div role="listitem"><small>{t('每次 update 的 episodes', 'Episodes / update')}</small><strong>{episodesPerUpdate}</strong><span>{trainBatch} × {rolloutGroup}</span></div>
    <div role="listitem"><small>{t('RL episodes / 环境', 'RL episodes / env')}</small><strong>{fullEpisodes.toLocaleString()}</strong><span>{updates} × {episodesPerUpdate}</span></div>
  </div>

  <section class="derivation" aria-labelledby="workload-derivation-title">
    <div>
      <span class="section-kicker">{t('先把能算死的东西算死', 'Calculate the fixed workload first')}</span>
      <h3 id="workload-derivation-title">{t('为什么 ALFWorld 通常要比 WebShop 预留更多时间', 'Why ALFWorld usually deserves a larger time budget than WebShop')}</h3>
    </div>
    <div class="equations">
      <p><strong>RL:</strong> 2,400 prompts ÷ batch 16 = <b>150 updates</b></p>
      <p><strong>{t('每个环境', 'Per environment')}:</strong> 150 × (16 prompts × 8 rollouts) = <b>19,200 episodes</b></p>
      <p><strong>ALFWorld:</strong> 19,200 × max 30 interactions = <b>{alfMaxInteractions.toLocaleString()} {t('次交互上限', 'max interactions')}</b></p>
      <p><strong>WebShop:</strong> 19,200 × max 15 interactions = <b>{webMaxInteractions.toLocaleString()} {t('次交互上限', 'max interactions')}</b></p>
      <p><strong>SFT:</strong> 180 tasks × 8 rollouts = <b>{sftTrajectories.toLocaleString()} trajectories</b>, {t('官方仓库默认训练 3 epochs', 'with 3 training epochs in the official repository defaults')}</p>
    </div>
    <p class="boundary-note">{t('注意：交互数是“最多”，不是实际平均 episode 长度；response 512 也是上限，不代表每一步都会生成 512 token。因此这些数字能解释工作量规模，但仍不能单独推出真实小时数。SEED 还要做 hindsight-skill 分析、普通/skill-augmented 重打分和策略更新，wall-clock 必须由真机 profiling 校准。', 'Interaction counts are maxima, not average episode lengths; response length 512 is also a cap, not a promise that every turn emits 512 tokens. These values explain workload scale but cannot by themselves produce a true wall-clock runtime. SEED also performs hindsight-skill analysis, ordinary/skill-augmented rescoring, and policy updates, so real wall-clock time must be calibrated on the rented machine.')}</p>
  </section>

  <h3 class="plans-title">{t('租卡前：按下面四档做时间与成本预算', 'Before renting: budget time and cost in four tiers')}</h3>
  <div class="plan-grid">
    <article class="plan-card">
      <div class="plan-top"><span>A</span><small>{t('环境 / rollout smoke test', 'Environment / rollout smoke test')}</small></div>
      <h4>RTX 4090 24G ×1</h4>
      <div class="hours">{t('两环境合计：4–8 小时', 'Both environments: 4–8 hours')}</div>
      <div class="cost">{rangeCost(4, 8, hourly4090)} · ¥{hourly4090.toFixed(2)}/{t('小时', 'h')}</div>
      <p>{t('这 4–8 小时不是训练论文结果，而是给第一次上云留的操作窗口：约 1–3 小时用于镜像、依赖、模型/环境资源；约 1–2 小时跑 ALFWorld 与 WebShop 的完整 episode；再留 2–3 小时处理 Python、CUDA、WebShop 服务或路径问题。环境一次跑稳后，后续通常不需要重复这笔时间。', 'This is not paper-result training time. It is a first-cloud bring-up window: roughly 1–3h for image/dependencies/model and environment assets, 1–2h for complete ALFWorld and WebShop episodes, plus a 2–3h debugging buffer for Python/CUDA/WebShop service/path issues. Once the environment is stable, this budget usually does not repeat.')}</p>
      <div class="claim">{t('得到的结论：环境可运行；不能声称复现训练结果。', 'Conclusion supported: the environment runs; no claim about reproduced training results.')}</div>
    </article>

    <article class="plan-card">
      <div class="plan-top"><span>B</span><small>{t('缩小版端到端方法验证', 'Reduced end-to-end method check')}</small></div>
      <h4>NVIDIA A100 80G ×1</h4>
      <div class="hours">{t('两环境合计：10–18 小时', 'Both environments: 10–18 hours')}</div>
      <div class="cost">{rangeCost(10, 18, hourlyA100)} · ¥{hourlyA100.toFixed(2)}/{t('小时', 'h')}</div>
      <p>{t('这里主动缩小数据与 RL update 数，只验证 trajectory → skill → re-score → OPD/GRPO → policy update 全链路。预算口径是：SFT/数据准备约 2–4 小时；缩到约 10 个 RL updates 后，按单卡每 update 约 20–45 分钟的保守规划先验，约 3.3–7.5 小时；再给评测、checkpoint、失败重跑留约 2–4 小时。合计后向上取整为 10–18 小时。', 'Here the dataset and RL-update count are intentionally reduced; the goal is only to exercise trajectory → skill → rescore → OPD/GRPO → policy update end to end. Budget basis: about 2–4h for SFT/data preparation; around 10 reduced RL updates using a conservative pre-measurement planning prior of roughly 20–45 min/update on one GPU (about 3.3–7.5h); plus roughly 2–4h for evaluation, checkpoints, and a failed rerun. Rounded upward: 10–18h.')}</p>
      <div class="claim">{t('得到的结论：方法链能训练；不能与论文主表比较。', 'Conclusion supported: the method chain trains; results are not paper-table comparable.')}</div>
    </article>

    <article class="plan-card recommended">
      <div class="plan-top"><span>C</span><small>{t('智星云当前最接近论文规模', 'Closest current AI Galaxy paper-scale option')}</small></div>
      <h4>A100 80G NVLINK ×8</h4>
      <div class="hours">{t('ALFWorld：18–32h · WebShop：12–24h · 两者：32–60h', 'ALFWorld: 18–32h · WebShop: 12–24h · both: 32–60h')}</div>
      <div class="cost">¥{monthlyA100Eight.toLocaleString()}/{t('月（公开裸金属标价）', 'month (public bare-metal price)')}</div>
      <p>{t('这是完整 150-update 预算，不再缩 RL workload。租卡前采用的规划先验是：ALFWorld 每 update 约 6–10 分钟 → 15–25 小时 RL；WebShop 每 update 约 4–7 分钟 → 10–17.5 小时 RL。再加入两套 SFT/数据准备、checkpoint merge 和评测约 6–12 小时，得到约 31–54.5 小时；考虑第一次复现的失败重跑与 I/O 波动，向外扩成 32–60 小时。每-update 分钟数是工程先验，不是论文实测，开机后必须替换。', 'This budget keeps the full 150-update RL workload. The pre-rental planning priors are roughly 6–10 min/update for ALFWorld (15–25h of RL) and 4–7 min/update for WebShop (10–17.5h of RL). Add roughly 6–12h for both SFT/data paths, checkpoint merging, and evaluation: about 31–54.5h, widened to 32–60h for first-reproduction reruns and I/O variance. The minutes-per-update values are engineering priors, not paper measurements, and must be replaced after startup.')}</p>
      <div class="claim">{t('得到的结论：论文规模、硬件替代的方法复现；A100 ≠ A800。', 'Conclusion supported: paper-scale, hardware-substituted method reproduction; A100 ≠ A800.')}</div>
      <p class="billing-note">{t('计费提醒：这个公开 SKU 是 ¥30,000/月，不要把 32–60 小时乘成“实际应付金额”。如果只能按月租，哪怕训练两天也仍按平台月租规则付费。32–60 小时的意义是排实验窗口、判断一个月能做几次完整尝试。', 'Billing note: this public SKU is ¥30,000/month. Do not multiply 32–60h into a fake payable amount. If the product is monthly-only, a two-day run is still billed under the platform’s monthly terms. The hour estimate is for scheduling experiments and deciding how many full attempts fit inside the rental month.')}</p>
    </article>

    <article class="plan-card strict">
      <div class="plan-top"><span>D</span><small>{t('严格硬件复现', 'Exact-hardware reproduction')}</small></div>
      <h4>NVIDIA A800 80G ×8</h4>
      <div class="hours">{t('论文未公开真实小时数；首次采购可先预留 40–72 小时窗口', 'Paper runtime is undisclosed; reserve a 40–72h initial window for procurement planning')}</div>
      <div class="cost">{t('智星云当前公开目录无此 SKU：价格需询价', 'No current public AI Galaxy SKU: price requires a quote')}</div>
      <p>{t('40–72 小时不是“论文训练用了这么久”。它只是采购窗口：以当前 A100×8 的 32–60 小时预算为锚，再加 20% 的未知拓扑 / 驱动 / A800 实例差异缓冲，得到 38.4–72 小时，向上取整为 40–72 小时。拿到机器后不要继续相信这个区间，直接用前 5 个稳定 update 重新算。', '40–72h is not a claim about the authors’ runtime. It is only a procurement window: use the current 8×A100 budget of 32–60h as an anchor and add a 20% engineering buffer for unknown topology/driver/A800-instance differences, giving 38.4–72h and rounded to 40–72h. Once the machine is secured, stop trusting this interval and recalculate from the first five stable updates.')}</p>
      <div class="claim">{t('只有模型、数据、超参数、评测与 A800×8 拓扑都对齐后，才讨论严格硬件复现。', 'Only after model, data, hyperparameters, evaluation, and 8×A800 topology are all aligned should the run be called exact-hardware reproduction.')}</div>
    </article>
  </div>

  <section class="calibration" aria-labelledby="calibration-title">
    <span class="section-kicker">{t('开机后的正确算法', 'The correct calculation after startup')}</span>
    <h3 id="calibration-title">{t('跑 5 个稳定 update，把网页估算换成你这台机器的数字', 'Run five stable updates and replace this webpage estimate with your machine’s numbers')}</h3>
    <div class="formula-box">
      <code>T_RL ≈ median(update_2..6) × 150 ÷ 60</code>
      <code>T_total ≈ T_prepare/SFT + T_RL + T_eval</code>
      <code>T_reserve ≈ T_total × 1.15</code>
    </div>
    <p>{t('为什么用中位数：第一次 update 常包含编译、cache warm-up、模型加载等一次性开销；单步也可能被环境卡顿或网络抖动拉长。跳过 warm-up 后取 5 个 update 的中位数，比拿某一个“看起来很快”的 step 外推 150 次可靠。最后的 ×1.15 是首次复现的工程缓冲，不是统计置信区间。', 'Why the median: the first update often contains compilation, cache warm-up, and model-loading overhead, while an individual step can be stretched by environment or network stalls. Skip warm-up and use the median of five updates; it is safer than extrapolating 150 updates from one unusually fast step. The final ×1.15 is an engineering buffer for a first reproduction, not a statistical confidence interval.')}</p>
    <div class="worked-example">
      <strong>{t('示例（不是 SEED 实测）：', 'Worked example (not a measured SEED result):')}</strong>
      <p>{t(`假设 A100×8 上稳定 update 的中位数是 ${exampleMedianUpdateMin} 分钟，那么 RL ≈ ${exampleMedianUpdateMin} × 150 ÷ 60 = ${exampleRlHours.toFixed(1)} 小时；如果准备/SFT/评测合计再花 ${exampleFixedHours} 小时，总计 ${exampleRawHours.toFixed(1)} 小时；首次复现再乘 1.15，建议预留约 ${exampleReserveHours.toFixed(1)} 小时。`, `If the stable median update time on 8×A100 is ${exampleMedianUpdateMin} min, RL ≈ ${exampleMedianUpdateMin} × 150 ÷ 60 = ${exampleRlHours.toFixed(1)}h. If preparation/SFT/evaluation add ${exampleFixedHours}h, total = ${exampleRawHours.toFixed(1)}h; with a 1.15 first-run buffer, reserve about ${exampleReserveHours.toFixed(1)}h.`)}</p>
    </div>
  </section>

  <aside class="cost-control">
    <strong>{t('最省钱的一条具体操作', 'One concrete way to avoid wasting the expensive machine')}</strong>
    <p>{t('Stage 1 的数据构造还依赖 OpenAI-compatible analyzer endpoint。先在便宜实例上完成能提前完成的下载、WebShop 安装、数据准备和 API 可用性检查，再启动 8×A100 裸金属。否则你可能在 ¥30,000/月的机器上等下载、修 Python 环境或等外部 API，而不是训练。', 'Stage-1 data construction also depends on an OpenAI-compatible analyzer endpoint. Complete downloads, WebShop installation, data preparation, and API-availability checks that can be done ahead of time on a cheap instance before starting the 8×A100 bare-metal machine. Otherwise the expensive monthly system can sit idle while you download assets, repair Python environments, or wait on an external API instead of training.')}</p>
  </aside>

  <div class="source-note">
    <strong>{t('证据边界：', 'Evidence boundary: ')}</strong>
    {t('2,400 RL prompts、batch 16、rollout group 8、150 updates、ALFWorld/WebShop 最大交互 30/15、SFT 180×8 和 3 epochs 来自 SEED 论文/官方仓库；智星云价格来自上方时间戳对应的公开页面。4–8h、10–18h、32–60h、40–72h，以及每-update 分钟数和 15%/20% buffer，全部是本站为租卡决策给出的工程预算，必须由真机 profiling 覆盖。', 'The 2,400 RL prompts, batch 16, rollout group 8, 150 updates, ALFWorld/WebShop maximum interactions 30/15, SFT 180×8, and 3 epochs come from the SEED paper/official repository. AI Galaxy prices come from the timestamped public pages above. The 4–8h, 10–18h, 32–60h, and 40–72h ranges, per-update minute priors, and 15%/20% buffers are this site’s engineering budgets for rental decisions and must be superseded by real profiling.')}
  </div>
</section>

<style>
  .seed-time-budget { margin: 44px 0 70px; padding-top: 38px; border-top: 1px solid var(--line); }
  .budget-head { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(230px, .55fr); gap: 24px; align-items: start; }
  .budget-head h2 { max-width: 820px; margin: 7px 0 10px; }
  .budget-head p { max-width: 820px; color: var(--muted); }
  .budget-head aside { padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-muted); }
  .budget-head aside p { margin: 6px 0 0; font-size: .88rem; }
  .fact-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 24px 0; }
  .fact-strip > div { padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .fact-strip small, .fact-strip strong, .fact-strip span { display: block; }
  .fact-strip small { color: var(--muted); }
  .fact-strip strong { margin: 5px 0 2px; font-size: 1.35rem; }
  .fact-strip span { color: var(--muted); font-size: .78rem; }
  .derivation, .calibration { margin: 26px 0; padding: 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .derivation h3, .calibration h3 { margin: 6px 0 14px; }
  .equations { display: grid; gap: 8px; padding: 14px 16px; border-radius: 12px; background: var(--surface-muted); }
  .equations p { margin: 0; font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: .86rem; overflow-wrap: anywhere; }
  .boundary-note { margin-bottom: 0; color: var(--muted); }
  .plans-title { margin: 34px 0 14px; }
  .plan-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .plan-card { padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .plan-card.recommended { border-width: 2px; }
  .plan-card.strict { border-style: dashed; }
  .plan-top { display: flex; align-items: center; gap: 9px; color: var(--muted); }
  .plan-top span { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--line); border-radius: 999px; font-weight: 800; color: var(--text); }
  .plan-card h4 { margin: 10px 0 6px; font-size: 1.05rem; }
  .hours { font-weight: 800; line-height: 1.5; }
  .cost { margin-top: 3px; color: var(--muted); font-size: .86rem; }
  .plan-card p { color: var(--muted); }
  .claim { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: .86rem; font-weight: 700; }
  .billing-note { padding: 10px 12px; border-radius: 10px; background: var(--surface-muted); font-size: .83rem; }
  .formula-box { display: grid; gap: 7px; margin: 12px 0; }
  .formula-box code { display: block; padding: 10px 12px; border-radius: 9px; background: var(--surface-muted); overflow-x: auto; }
  .worked-example { margin-top: 16px; padding: 14px; border-left: 3px solid var(--accent, currentColor); background: var(--surface-muted); }
  .worked-example p { margin: 5px 0 0; }
  .cost-control { margin: 20px 0; padding: 17px 19px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface-muted); }
  .cost-control p { margin: 6px 0 0; color: var(--muted); }
  .source-note { margin-top: 18px; color: var(--muted); font-size: .82rem; line-height: 1.65; }
  @media (max-width: 820px) {
    .budget-head, .plan-grid { grid-template-columns: 1fr; }
    .fact-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .fact-strip { grid-template-columns: 1fr; }
    .derivation, .calibration, .plan-card { padding: 16px; }
  }
</style>
