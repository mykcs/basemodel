---
import { localePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const missionHref = localePath(locale, '/research/seed-openevo/flow/');

const bootstrap = `gh api 'repos/mykcs/seed3090/contents/scripts/openevo_webshop/api_bootstrap.sh?ref=main' --jq .content \\
  | python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' \\
  | bash`;

const macChecks = `gh auth status
python3 --version
rsync --version | head -n 1
ssh -V`;

const gpuCheck = `nvidia-smi --query-gpu=index,name,memory.total,memory.used,utilization.gpu --format=csv`;

const successStatus = `STATUS=P0_PASS
SCIENTIFIC_REPRO=pass
EVOLUTION_SMOKE=pass
OFFICIAL_E2E=not_run
INFRA_E2E_STATUS=deferred_p2
FIRST_BLOCKER=none
LONG_RUN=<pid>
MAC_RESULT_DIR=<path>`;

const dataFiles = [
  'items_shuffle_1000.json',
  'items_ins_v2_1000.json',
  'items_human_ins.json',
];

const bugIndex = [
  {
    id: 'B01',
    where: t('代码获取', 'Code acquisition'),
    context: t('实验室网络可能允许访问 GitHub API，但普通 git clone / fetch 偶尔中断；另一个 worktree 也可能已经占用 main。', 'A lab network may reach the GitHub API while ordinary git clone / fetch is intermittent; another worktree may also already own main.'),
    fix: t('用 api.github.com 获取精确 snapshot / tarball，并用 commit SHA 验证内容；不要求本地 checkout 必须持有 main。', 'Fetch an exact snapshot / tarball through api.github.com and verify it by commit SHA; the local checkout does not need to own main.'),
  },
  {
    id: 'B02',
    where: t('源码身份', 'Source identity'),
    context: t('API snapshot 本身没有 .git。如果父目录恰好是另一个仓库，普通 Git 探测可能把父目录误当成当前源码。', 'An API snapshot has no .git directory. If a parent directory is another repository, ordinary Git discovery can mistake the parent for the current source.'),
    fix: t('优先读取 snapshot marker；只有 git show-toplevel 精确等于 source root 时，才按 Git checkout 处理。', 'Prefer the snapshot marker; treat the source as a Git checkout only when git show-toplevel exactly matches the source root.'),
  },
  {
    id: 'B03',
    where: t('补丁应用', 'Patch application'),
    context: t('git apply 的 corrupt patch 可能来自 unified-diff 行数错误，并不一定表示 OpenEvo 版本不匹配。', 'A corrupt patch error can come from incorrect unified-diff line counts; it does not necessarily mean the OpenEvo revision is wrong.'),
    fix: t('先校正 hunk count，再运行严格的 git apply --check；不要用 fuzzy / 3-way 掩盖真实冲突。', 'Correct hunk counts first, then run strict git apply --check; do not hide real conflicts with fuzzy / 3-way application.'),
  },
  {
    id: 'B04',
    where: t('WebShop 数据', 'WebShop data'),
    context: t('学生所在网络可能持续重置 Hugging Face 连接，或无法稳定访问 Google Drive。反复延长 timeout 并不会改变这个网络条件。', 'A student network may repeatedly reset Hugging Face connections or fail to reach Google Drive reliably. Longer timeouts do not change that network condition.'),
    fix: t('从固定 AgentGym commit 通过 GitHub API取得真实数据，保存到工作站的长期缓存，再同步到服务器。', 'Retrieve the real data from a pinned AgentGym commit through the GitHub API, keep it in a durable workstation cache, then sync it to the server.'),
  },
  {
    id: 'B05',
    where: t('托管任务', 'Hosted jobs'),
    context: t('托管任务如果没有真正启动 runner，日志里可能只有 admission / billing 错误，而没有任何下载步骤。', 'If a hosted job never admits a runner, its log may contain only admission or billing errors and no download step at all.'),
    fix: t('按 admission → runner → step → process → network → data 的顺序定位失败层；托管侧未启动时，不要继续调试下载代码。', 'Locate the failure layer in the order admission → runner → step → process → network → data; if the hosted runner never starts, do not keep debugging download code.'),
  },
  {
    id: 'B06',
    where: t('Python 与依赖', 'Python and dependencies'),
    context: t('一串 ModuleNotFoundError 既可能表示缺包，也可能说明脚本选错了解释器或旧虚拟环境。', 'A cascade of ModuleNotFoundError can mean missing packages, but it can also mean the script selected the wrong interpreter or an unrelated old environment.'),
    fix: t('先确认 Python 版本、CUDA Torch 和环境身份，再安装确定性的 WebShop / OpenEvo overlay。', 'Verify the Python version, CUDA Torch, and environment identity first; then install the deterministic WebShop / OpenEvo overlay.'),
  },
  {
    id: 'B07',
    where: t('验收范围', 'Acceptance scope'),
    context: t('核心科学链和完整服务基础设施回答的是两个不同问题：前者证明模型与演化机制真实运行，后者证明 vLLM / gateway / Docker 服务链可用。', 'The scientific chain and the full service infrastructure answer different questions: the former proves real model/evolution behavior, while the latter proves the vLLM / gateway / Docker service stack.'),
    fix: t('分开记录 P0 科学复现、P1 黄金环境、P2 基础设施 E2E 和 P3 扩展实验。', 'Track P0 scientific reproduction, P1 golden environment, P2 infrastructure E2E, and P3 scale-up separately.'),
  },
  {
    id: 'B08',
    where: t('结果解释', 'Result interpretation'),
    context: t('reward=0.0 可能来自一次真实但未完成任务的运行，因此不能仅凭数值为零判断管线失败。', 'A reward of 0.0 can come from a real run that did not complete the task, so zero alone does not prove the pipeline failed.'),
    fix: t('0.0 可以作为真实执行证据；只有受控条件下的数值改善，才能支持性能提升结论。', 'A 0.0 reward can still be real-execution evidence; only a controlled numerical improvement supports a performance-improvement claim.'),
  },
];
---

<main class="reprod shell">
  <header class="page-head">
    <p class="kicker">{t('SEED 基准上的 OpenEvo 实验', 'OpenEvo on SEED benchmarks')}</p>
    <h1>{t('OpenEvo × WebShop / ALFWorld 复现指南', 'OpenEvo × WebShop / ALFWorld Reproduction Guide')}</h1>
    <p class="subtitle">{t(
      '面向准备在实验室工作站与 GPU 服务器之间完成实验的学生和研究人员：先跑通 WebShop，再沿同一证据标准接入 ALFWorld。',
      'For students and researchers working across a lab workstation and a GPU server: establish WebShop first, then bring ALFWorld onto the same evidence standard.',
    )}</p>
    <a class="back-link" href={missionHref}>← {t('返回 SEED × OpenEvo 研究总览', 'Back to the SEED × OpenEvo research map')}</a>
  </header>

  <aside class="scope-note">
    <strong>{t('这份指南要证明什么', 'What this guide is meant to prove')}</strong>
    <p>{t(
      '第一阶段先证明 OpenEvo 能在真实 WebShop 环境中使用 CUDA 模型行动、生成数值结果、完成真实反思，并把演化内容带入下一代运行。WebShop 稳定后，再用相同方法接入 ALFWorld。历史 Kaggle / Colab 记录只作为环境参考，不代替本次服务器证据。',
      'The first stage proves that OpenEvo can act with a CUDA model in the real WebShop environment, produce a numeric result, complete real reflection, and carry evolved content into the next generation. After WebShop is stable, the same method is applied to ALFWorld. Historical Kaggle / Colab runs are environment references, not substitutes for evidence from this server.',
    )}</p>
    <div class="claim-row">
      <span><b>P0</b> {t('真实 WebShop + CUDA Qwen + reflector + gen0→gen1', 'real WebShop + CUDA Qwen + reflector + gen0→gen1')}</span>
      <span><b>P1</b> {t('冻结可复用环境', 'freeze a reusable environment')}</span>
      <span><b>P2</b> {t('vLLM / gateway / Docker E2E', 'vLLM / gateway / Docker E2E')}</span>
      <span><b>P3</b> {t('扩大任务与硬件规模', 'scale tasks and hardware')}</span>
    </div>
  </aside>

  <nav class="toc" aria-label={t('复现目录', 'Reproduction contents')}>
    <strong>{t('目录', 'Contents')}</strong>
    <ol>
      <li><a href="#environment">{t('实验拓扑与准备', 'Topology & setup')}</a></li>
      <li><a href="#code">{t('获取与固定代码', 'Get & pin code')}</a></li>
      <li><a href="#data">{t('数据准备', 'Prepare data')}</a></li>
      <li><a href="#runtime">{t('运行环境与依赖', 'Runtime & dependencies')}</a></li>
      <li><a href="#run">{t('执行 WebShop P0', 'Run WebShop P0')}</a></li>
      <li><a href="#outputs">{t('输出与验收', 'Outputs & acceptance')}</a></li>
      <li><a href="#alfworld">{t('接入 ALFWorld', 'Bring up ALFWorld')}</a></li>
      <li><a href="#troubleshooting">{t('故障索引', 'Troubleshooting')}</a></li>
    </ol>
  </nav>

  <section id="environment" class="section">
    <h2>{t('1. 实验拓扑与准备', '1. Experiment Topology & Setup')}</h2>

    <h3>{t('1.0 先确认哪台机器负责什么', '1.0 Decide which machine does what')}</h3>
    <p>{t(
      '复现这类实验时，学生通常会有一台可以访问公网的个人电脑或实验室工作站，同时使用一台位于实验室内网的 GPU 服务器。GPU 服务器主要承担计算任务，可能无法直接访问外网。本项目中，实验室 Mac 负责获取和缓存代码、模型、数据与离线依赖，再通过实验室网络上的 SSH / rsync 把同一份实验材料同步到 RTX6；RTX6 负责运行 GPU 实验。',
      'In this kind of reproduction, a student often has a personal computer or lab workstation with internet access and a GPU server on the lab network. The GPU server is intended for computation and may have no outbound internet access. In this project, the lab Mac acquires and caches code, models, data, and offline dependencies, then sends the same experiment bundle to RTX6 over the lab network with SSH / rsync; RTX6 runs the GPU experiment.',
    )}</p>
    <pre class="diagram"><code>{t(`Public internet
      ↓
Lab Mac / workstation ── acquire + verify + persistent cache
      ↓  SSH / rsync over the lab network
RTX6 (4× RTX3090) ── offline GPU execution`, `Public internet
      ↓
Lab Mac / workstation ── acquire + verify + persistent cache
      ↓  SSH / rsync over the lab network
RTX6 (4× RTX3090) ── offline GPU execution`)}</code></pre>

    <h3>{t('1.1 检查工作站工具', '1.1 Check workstation tools')}</h3>
    <p>{t('在负责下载和同步材料的 Mac 上运行：', 'Run on the Mac that acquires and relays the experiment bundle:')}</p>
    <pre><code>{macChecks}</code></pre>
    <p class="expected"><b>{t('预期：', 'Expected:')}</b> {t('GitHub CLI 已登录；Python 3、rsync 和 SSH 可用。自动脚本还会检查 tar、bash、cp、git、sshpass 与 macOS Keychain 工具。', 'GitHub CLI is authenticated; Python 3, rsync, and SSH are available. The automation also checks tar, bash, cp, git, sshpass, and the macOS Keychain utility.')}</p>

    <h3>{t('1.2 确认服务器 GPU 空闲', '1.2 Confirm an idle server GPU')}</h3>
    <p>{t('共享实验室服务器上可能同时有其他人的任务。只选择显存占用和利用率都接近空闲的 GPU；现有进程不属于本实验时，不执行 kill 或 reset。', 'Other researchers may be using the shared lab server. Select only a GPU whose memory use and utilization indicate it is idle; do not kill or reset processes that do not belong to this experiment.')}</p>
    <pre><code>{gpuCheck}</code></pre>

    <details class="trouble">
      <summary>{t('为什么在 Mac 上准备资产，而不是让 RTX6 临时下载？', 'Why prepare assets on the Mac instead of downloading from RTX6?')}</summary>
      <p>{t('因为 GPU 服务器的职责是稳定计算，而公网访问不是它的可靠能力。把下载放在服务器运行阶段，会让网络故障和模型/环境故障出现在同一条日志里。提前在有外网的工作站下载、校验并缓存资产，可以让服务器阶段只回答实验本身是否成功。', 'The GPU server is expected to provide stable computation; outbound internet access is not a reliable capability. Downloading during the server run mixes network failures with model or environment failures in the same log. Acquiring, validating, and caching assets on the internet-connected workstation keeps the server stage focused on the experiment itself.')}</p>
    </details>
  </section>

  <section id="code" class="section">
    <h2>{t('2. 获取与固定代码', '2. Get & Pin Project Code')}</h2>

    <h3>{t('2.1 用可验证的源码快照避免分支和网络差异', '2.1 Use a verifiable snapshot to avoid branch and network drift')}</h3>
    <p>{t(
      '在网络稳定、工作区简单的机器上，普通 git clone 完全可以使用。本实验室 Mac 曾出现 Git transport 间歇断连，而且已有 worktree 可能占用 main，因此自动入口改用 GitHub API 获取精确 tarball snapshot。OpenEvo 同时固定到已经审查的 commit，保证每次运行使用同一份源码。',
      'Ordinary git clone is fine on a stable network and a simple workspace. This lab Mac has seen intermittent Git transport failures, and an existing worktree may already own main, so the automated entrypoint uses the GitHub API to fetch an exact tarball snapshot. OpenEvo is pinned to a reviewed commit so every run uses the same source.',
    )}</p>
    <div class="facts">
      <div><span>{t('OpenEvo commit', 'OpenEvo commit')}</span><code>b9fac2e1f9a078229124c6fd3bd5ab1379c46d05</code></div>
      <div><span>{t('实验控制仓库', 'Experiment control repository')}</span><code>mykcs/seed3090</code></div>
    </div>

    <h3>{t('2.2 从一个入口启动', '2.2 Start from one entrypoint')}</h3>
    <p>{t('下面的命令在 Mac 上读取 seed3090/main 的精确内容，并在独立缓存目录中工作，不会切换或修改已有 checkout。', 'The command below reads the exact contents of seed3090/main on the Mac and works in a separate cache directory; it does not switch or modify an existing checkout.')}</p>
    <pre><code>{bootstrap}</code></pre>

    <h3>{t('2.3 自动入口完成的步骤', '2.3 What the entrypoint automates')}</h3>
    <ol class="steps">
      <li>{t('确认 GitHub CLI 的登录账号。', 'Verify the GitHub CLI account.')}</li>
      <li>{t('从 api.github.com 获取 seed3090/main 的精确 tarball snapshot。', 'Fetch an exact seed3090/main tarball snapshot from api.github.com.')}</li>
      <li>{t('复用或下载固定版本的 OpenEvo tarball。', 'Reuse or download the pinned OpenEvo tarball.')}</li>
      <li>{t('校验并应用实验补丁，再执行 Python 编译检查。', 'Validate and apply the experiment patch, then run Python compilation checks.')}</li>
      <li>{t('把源码、数据与离线 wheelhouse 同步到 RTX6。', 'Sync source, data, and the offline wheelhouse to RTX6.')}</li>
      <li>{t('在 RTX6 运行 P0，并把结果目录同步回 Mac。', 'Run P0 on RTX6 and sync the result directory back to the Mac.')}</li>
    </ol>

    <details class="trouble">
      <summary>{t('clone 失败或 main 已被另一个 worktree 使用时怎么办？', 'What if clone fails or another worktree already owns main?')}</summary>
      <p>{t('先确认 GitHub API 是否仍可访问。只要 API 可用，就使用精确 snapshot，不需要反复重试同一条 clone，也不需要破坏已有 worktree。这里要保持的是源码内容身份，而不是本地分支占用状态。', 'First confirm that the GitHub API is still reachable. If it is, use the exact snapshot instead of retrying the same clone or disturbing the existing worktree. The requirement is source-content identity, not local branch ownership.')}</p>
    </details>
  </section>

  <section id="data" class="section">
    <h2>{t('3. 数据准备', '3. Data Preparation')}</h2>

    <h3>{t('3.1 WebShop small 所需文件', '3.1 Files required by WebShop small')}</h3>
    <p>{t('当前 P0 使用 WebShop 的 1000 商品小规模设置，至少需要以下三份 JSON：', 'P0 currently uses the 1,000-product WebShop small setting and requires at least these three JSON files:')}</p>
    <pre><code>{dataFiles.join('\n')}</code></pre>

    <h3>{t('3.2 从固定来源下载并长期缓存', '3.2 Download from a pinned source and cache durably')}</h3>
    <p>{t(
      '为避免实验依赖学生所在网络能否访问 Hugging Face 或 Google Drive，bootstrap 从固定 AgentGym commit 中读取已收录的真实 WebShop 数据，并通过 GitHub Contents / Blob API 保存到 Mac 的长期缓存。文件通过 JSON、大小和 SHA256 校验后，才会同步到 RTX6。',
      'To avoid making the experiment depend on whether the student network can reach Hugging Face or Google Drive, the bootstrap reads the real vendored WebShop data from a pinned AgentGym commit and stores it in a durable Mac cache through the GitHub Contents / Blob API. Files are synced to RTX6 only after JSON, size, and SHA256 validation.',
    )}</p>

    <div class="facts">
      <div><span>{t('工作站缓存', 'Workstation cache')}</span><code>~/.cache/seed3090-openevo-webshop/webshop-data/</code></div>
      <div><span>{t('每次运行', 'Each run')}</span><code>cache hit → validate → relay</code></div>
    </div>

    <p class="note"><b>{t('为什么代码和数据分开管理：', 'Why code and data are managed separately:')}</b> {t('代码 snapshot 随 commit 变化，适合按运行重新生成；benchmark 数据体积更大、变化更少，成功校验后应长期复用。', 'Code snapshots change with commits and are cheap to regenerate per run; benchmark data is larger and changes less often, so a validated copy should be reused.')}</p>

    <details class="trouble">
      <summary>{t('第三方下载源持续超时或被重置时怎么办？', 'What if third-party download sources keep timing out or resetting?')}</summary>
      <p>{t('如果网络条件没有改变，继续调整重试顺序或 timeout 通常不会解决问题。同一种网络错误在相同条件下重复两次后，应改变数据源或传输路径，再重新验证。', 'If the network condition has not changed, changing retry order or timeout usually will not solve the problem. After the same network error occurs twice under the same conditions, change the data source or transfer path before testing again.')}</p>
    </details>
  </section>

  <section id="runtime" class="section">
    <h2>{t('4. 运行环境与依赖', '4. Runtime & Dependencies')}</h2>

    <h3>{t('4.1 先建立最小科学运行环境', '4.1 Build the minimum scientific runtime first')}</h3>
    <p>{t(
      '第一阶段只需要证明 WebShop 环境、CUDA 模型、反思与 gen0→gen1 演化链真实运行。因此先准备 Python ≥3.11 和可用的 CUDA Torch，再叠加确定版本的 WebShop / OpenEvo 依赖。vLLM、rollout server、gateway 和 Docker 属于后续 P2 服务链验证，不阻塞 P0。',
      'The first stage only needs to prove the real WebShop environment, CUDA model, reflection, and gen0→gen1 evolution chain. Start with Python ≥3.11 and working CUDA Torch, then layer the pinned WebShop / OpenEvo dependencies. vLLM, the rollout server, gateway, and Docker belong to the later P2 service-stack validation and do not block P0.',
    )}</p>

    <h3>{t('4.2 在 Mac 准备 Linux 离线 wheelhouse', '4.2 Prepare the Linux offline wheelhouse on the Mac')}</h3>
    <p>{t('bootstrap 为 Linux CPython 3.12 准备并缓存 wheelhouse，再与源码一起同步到 RTX6。WebShop 的 sparse / Lucene 路径包括：', 'The bootstrap prepares and caches a wheelhouse for Linux CPython 3.12, then syncs it with the source to RTX6. The WebShop sparse / Lucene path includes:')}</p>
    <ul>
      <li><code>gym==0.24.0</code></li>
      <li><code>env==0.1.0</code></li>
      <li><code>train==0.0.5</code></li>
      <li><code>pyserini==0.17.0</code> ({t('按 sparse/Lucene 所需依赖显式安装', 'installed with the explicit sparse/Lucene dependency set')})</li>
      <li><code>faiss-cpu</code></li>
      <li>{t('spaCy + en_core_web_sm', 'spaCy + en_core_web_sm')}</li>
    </ul>

    <h3>{t('4.3 在加载模型前验证搜索索引', '4.3 Validate the search index before loading the model')}</h3>
    <p>{t('三份 JSON 只证明原始数据存在。pipeline 还必须构建或打开 WebShop small 的 Lucene 索引，并通过 LuceneSearcher 完成一次真实查询。这样 Java、Pyserini 或索引问题会在模型占用 GPU 之前出现。', 'The three JSON files prove only that the raw data exists. The pipeline must also build or open the WebShop small Lucene index and complete a real LuceneSearcher query. This exposes Java, Pyserini, or index problems before the model occupies a GPU.')}</p>

    <details class="trouble">
      <summary>{t('出现很多 ModuleNotFoundError 时先检查什么？', 'What should be checked first when many ModuleNotFoundError messages appear?')}</summary>
      <p>{t('先记录实际使用的 Python 路径与版本，再检查该解释器是否能导入 CUDA Torch。确认环境身份后，再补齐确定版本的 overlay。逐个向未知的 system Python 安装包，可能制造第二套更难追踪的环境。', 'Record the actual Python path and version first, then check whether that interpreter imports CUDA Torch. After the environment identity is known, complete the pinned overlay. Installing packages one by one into an unknown system Python can create a second, harder-to-track environment.')}</p>
    </details>
  </section>

  <section id="run" class="section">
    <h2>{t('5. 执行 WebShop 科学 P0', '5. Run WebShop Scientific P0')}</h2>

    <h3>{t('5.1 使用同一个入口运行', '5.1 Run through the same entrypoint')}</h3>
    <p>{t('前面的 bootstrap 同时负责准备资产、同步服务器、运行 gate 和回收结果。使用同一个入口可以确保失败日志与结果目录采用同一格式。', 'The bootstrap prepares assets, syncs the server, runs the gates, and retrieves results. Using the same entrypoint keeps failure logs and result directories in one consistent format.')}</p>
    <pre><code>{bootstrap}</code></pre>

    <h3>{t('5.2 P0 的八项通过条件', '5.2 Eight P0 acceptance conditions')}</h3>
    <ol class="steps">
      <li>{t('真实 WebAgentTextEnv 完成 reset 和 step。', 'The real WebAgentTextEnv completes reset and step.')}</li>
      <li>{t('Qwen2.5-3B-Instruct 在 CUDA 上执行推理。', 'Qwen2.5-3B-Instruct performs inference on CUDA.')}</li>
      <li>{t('至少一个由模型生成的 action 被环境接受，轨迹不能全部来自 fallback。', 'At least one model-generated action is accepted by the environment; the trajectory cannot be fallback-only.')}</li>
      <li>{t('运行产生数值 task score；0.0 也是合法测量值。', 'The run produces a numeric task score; 0.0 is a valid measured value.')}</li>
      <li>{t('gen0 完整结束并保存轨迹。', 'gen0 completes and saves its trajectory.')}</li>
      <li>{t('由模型支持的 reflector 成功分析轨迹；静态 heuristic fallback 不计入通过。', 'A model-backed reflector successfully analyzes the trajectory; a static heuristic fallback does not count.')}</li>
      <li>{t('非空 evolution text 被注入 gen1 prompt。', 'Non-empty evolution text is injected into the gen1 prompt.')}</li>
      <li>{t('gen1 完整结束，machine verifier 通过。', 'gen1 completes and the machine verifier passes.')}</li>
    </ol>

    <h3>{t('5.3 P0 通过后的下一步', '5.3 Next step after P0')}</h3>
    <p>{t('先把第一次成功环境冻结为 P1 golden environment，再在同一环境上增加 episode 数、任务数或更长运行。这样后续失败可以和已验证基线比较。', 'First freeze the first successful setup as the P1 golden environment, then increase episode count, task count, or run length on the same setup. Later failures can then be compared with a validated baseline.')}</p>

    <details class="trouble">
      <summary>{t('为什么 reward=0.0 仍可能通过 P0？', 'Why can reward=0.0 still pass P0?')}</summary>
      <p>{t('P0 检查的是环境、模型动作、反思和演化机制是否真实执行。任务没有完成时，真实运行也可能得到 0.0。这个结果可以证明机制链存在，但不能证明 OpenEvo 改善了性能；性能结论需要受控对比。', 'P0 checks whether the environment, model action, reflection, and evolution mechanism really executed. A real run can still receive 0.0 when the task is not completed. That result proves the mechanism chain exists, but not that OpenEvo improved performance; a performance claim requires a controlled comparison.')}</p>
    </details>
  </section>

  <section id="outputs" class="section">
    <h2>{t('6. 输出与验收', '6. Outputs & Acceptance')}</h2>

    <h3>{t('6.1 读取机器可验证状态', '6.1 Read the machine-verifiable status')}</h3>
    <p>{t('脚本退出码只能说明进程是否正常结束，不能单独证明任务或演化成功。验收时同时检查 STATUS 文件和结果 artifact。完整 P0 预期为：', 'A process exit code says whether the process ended cleanly; it cannot by itself prove task or evolution success. Inspect both the STATUS file and result artifacts. A complete P0 should report:')}</p>
    <pre><code>{successStatus}</code></pre>

    <h3>{t('6.2 保存服务器与工作站两端结果', '6.2 Preserve results on both server and workstation')}</h3>
    <p>{t('RTX6 在运行目录中保存完整证据，dispatcher 再把已有日志和 artifact 同步到 Mac 的长期结果缓存。即使某个 gate 失败，已经生成的上游证据也应保留。', 'RTX6 stores the complete evidence in its run directory, and the dispatcher syncs existing logs and artifacts to the Mac’s durable result cache. Even if a gate fails, evidence from completed upstream stages should be preserved.')}</p>
    <pre><code>~/.cache/seed3090-openevo-webshop/results/</code></pre>

    <h3>{t('6.3 分开记录四种结论', '6.3 Keep four claim levels separate')}</h3>
    <dl class="claims">
      <div><dt>P0</dt><dd>{t('证明真实 WebShop、CUDA 模型动作、反思与 gen0→gen1 演化链。', 'Proves the real WebShop, CUDA model action, reflection, and gen0→gen1 evolution chain.')}</dd></div>
      <div><dt>P1</dt><dd>{t('冻结 Python、Torch/CUDA、Transformers、WebShop 依赖、Java/Pyserini、spaCy、模型/数据身份、wheelhouse 与 patch hash。', 'Freezes Python, Torch/CUDA, Transformers, WebShop dependencies, Java/Pyserini, spaCy, model/data identity, wheelhouse, and patch hashes.')}</dd></div>
      <div><dt>P2</dt><dd>{t('单独验证 vLLM → rollout → gateway → Docker → WebShopHarness → evaluator 服务链。', 'Separately validates the vLLM → rollout → gateway → Docker → WebShopHarness → evaluator service chain.')}</dd></div>
      <div><dt>P3</dt><dd>{t('使用实测显存、episode 时间和吞吐，规划更多任务或更大硬件上的扩展。', 'Uses measured memory, episode time, and throughput to plan more tasks or larger hardware.')}</dd></div>
    </dl>
  </section>

  <section id="alfworld" class="section">
    <h2>{t('7. 用同一标准接入 ALFWorld', '7. Bring ALFWorld onto the same standard')}</h2>

    <p class="note"><b>{t('当前状态：', 'Current state:')}</b> {t('这一节描述下一阶段的执行规范，不表示 ALFWorld 已经具备一键复现。先稳定 WebShop，可以得到可复用的环境、模型与演化基线，再减少 ALFWorld 适配时的变量。', 'This section defines the next-stage execution contract; it does not claim that ALFWorld already has a one-command reproduction. Stabilizing WebShop first provides a reusable environment, model, and evolution baseline and reduces variables during ALFWorld adaptation.')}</p>

    <h3>{t('7.1 从 OpenEvo 环境接口映射 ALFWorld', '7.1 Map ALFWorld from the OpenEvo environment contract')}</h3>
    <p>{t('先确认 OpenEvo 对任务、环境和评测证据的接口要求，再逐项实现 ALFWorld。这样可以区分“共享框架接口”和“某个 benchmark 的特有逻辑”。', 'Confirm OpenEvo’s task, environment, and evaluation-evidence contract first, then implement ALFWorld field by field. This separates the shared framework interface from benchmark-specific logic.')}</p>
    <table>
      <thead><tr><th>{t('接口', 'Interface')}</th><th>{t('需要确认', 'What to confirm')}</th><th>{t('通过证据', 'Pass evidence')}</th></tr></thead>
      <tbody>
        <tr><td>task / instruction</td><td>{t('任务文本和 split 的来源', 'source of task text and split')}</td><td>{t('固定 task id 可重复 reset', 'a fixed task id resets deterministically')}</td></tr>
        <tr><td>reset</td><td>{t('初始 observation / goal', 'initial observation / goal')}</td><td>{t('真实环境 reset 成功', 'real environment reset succeeds')}</td></tr>
        <tr><td>action</td><td>{t('动作语法、parser、admissible actions', 'action grammar, parser, admissible actions')}</td><td>{t('模型动作被真实 step 接受', 'a model action is accepted by a real step')}</td></tr>
        <tr><td>observation</td><td>{t('文本 observation 如何进入 prompt', 'how textual observations enter the prompt')}</td><td>{t('trajectory 保存真实 observation', 'the trajectory stores real observations')}</td></tr>
        <tr><td>done / reward</td><td>{t('终止条件、reward 与 evaluator', 'termination, reward, evaluator')}</td><td>{t('episode 返回数值结果', 'the episode returns a numeric result')}</td></tr>
        <tr><td>assets</td><td>{t('ALFWorld data / game files / cache 路径', 'ALFWorld data / game files / cache paths')}</td><td>{t('服务器无需公网也能启动', 'the server starts without outbound internet')}</td></tr>
      </tbody>
    </table>

    <h3>{t('7.2 ALFWorld 的证据阶梯', '7.2 ALFWorld evidence ladder')}</h3>
    <ol class="steps">
      <li>{t('静态 adapter / contract 检查。', 'Static adapter / contract check.')}</li>
      <li>{t('真实 ALFWorld reset 和一步真实 action。', 'Real ALFWorld reset and one real action.')}</li>
      <li>{t('CUDA Qwen 产生可接受动作。', 'CUDA Qwen produces an accepted action.')}</li>
      <li>{t('完整 episode 返回数值 reward。', 'A complete episode returns a numeric reward.')}</li>
      <li>{t('完成 gen0 → model-backed reflector → evolution injection → gen1。', 'Complete gen0 → model-backed reflector → evolution injection → gen1.')}</li>
      <li>{t('科学链稳定后，再验证 P2 服务基础设施。', 'After the scientific chain is stable, validate the P2 service infrastructure.')}</li>
    </ol>
  </section>

  <section id="troubleshooting" class="section">
    <h2>{t('8. 已知故障与诊断方法', '8. Known Failures & Diagnostic Methods')}</h2>
    <p>{t('下面按“出现环境 → 症状 → 修复”组织。第一次执行时不需要先读；遇到对应现象时再展开。', 'The entries below are organized as context → symptom → fix. First-time readers can skip them and expand only the matching situation.')}</p>

    <div class="bug-list">
      {bugIndex.map((bug) => (
        <details>
          <summary><code>{bug.id}</code><strong>{bug.where}</strong></summary>
          <p><b>{t('常见场景：', 'Context:')}</b>{bug.context}</p>
          <p><b>{t('处理方法：', 'Fix:')}</b>{bug.fix}</p>
        </details>
      ))}
    </div>

    <h3>{t('8.1 避免重复无效调试', '8.1 Avoid repeated ineffective debugging')}</h3>
    <ol class="steps">
      <li>{t('保存完整失败日志和结果目录，不只摘录最后一行。', 'Preserve the complete failure log and result directory, not only the final line.')}</li>
      <li>{t('按 admission → runner → process → network → asset → runtime → experiment 定位失败层。', 'Locate the failure layer in the order admission → runner → process → network → asset → runtime → experiment.')}</li>
      <li>{t('记录本次运行已经证明正常的上游层，下一轮不重复怀疑。', 'Record the upstream layers already proved healthy so the next attempt does not re-litigate them.')}</li>
      <li>{t('同一错误在相同条件下出现两次后，下一次至少改变一个因果变量。', 'After the same error occurs twice under the same conditions, change at least one causal variable for the next attempt.')}</li>
      <li>{t('优先修复最小、确定的问题；只有证据表明总体架构错误时才重构。', 'Fix the smallest deterministic problem first; redesign the architecture only when evidence shows the architecture itself is wrong.')}</li>
      <li>{t('每经过 2–3 个新 blocker，重新确认当前工作仍服务于原始科学问题。', 'After every two or three new blockers, confirm that the work still serves the original scientific question.')}</li>
    </ol>
  </section>

  <footer class="page-foot">
    <p>{t('这份指南随当前实验的可验证证据更新。历史故障保留在诊断区，但不会打断第一次执行的成功主线。', 'This guide evolves with verifiable evidence from the current experiment. Historical failures remain in the diagnostic section without interrupting the first-run success path.')}</p>
    <a href={missionHref}>← {t('返回研究总览', 'Back to research map')}</a>
  </footer>
</main>

