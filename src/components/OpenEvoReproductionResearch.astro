---
import { localePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const guideHref = `${localePath(locale, '/guide/')}#seed-reproduction`;

const bootstrap = `gh api 'repos/mykcs/seed3090/contents/scripts/openevo_webshop/api_bootstrap.sh?ref=main' --jq .content \\
  | python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' \\
  | bash`;

const macChecks = `gh auth status
python3 --version
rsync --version | head -n 1
ssh -V`;

const gpuCheck = `nvidia-smi --query-gpu=index,name,memory.total,memory.used,utilization.gpu --format=csv`;

const successStatus = `STATUS=P0_PASS
SCIENTIFIC_REPRO=pass
EVOLUTION_SMOKE=pass
OFFICIAL_E2E=not_run
INFRA_E2E_STATUS=deferred_p2
FIRST_BLOCKER=none
LONG_RUN=<pid>
MAC_RESULT_DIR=<path>`;

const dataFiles = [
  'items_shuffle_1000.json',
  'items_ins_v2_1000.json',
  'items_human_ins.json',
];

const bugIndex = [
  {
    id: 'B01',
    where: t('获取代码', 'Code acquisition'),
    symptom: t('Git clone / fetch 经常在 github.com:443 断开，worktree 还可能已经占用 main。', 'Git clone / fetch can disconnect on github.com:443, and another worktree may already own main.'),
    fix: t('执行链改用 api.github.com 的 exact snapshot / tarball；固定内容身份，而不是要求本地一定拥有 main。', 'Use exact api.github.com snapshots / tarballs; pin content identity instead of requiring local ownership of main.'),
  },
  {
    id: 'B02',
    where: t('源码校验', 'Source validation'),
    symptom: t('API snapshot 没有 .git，却被父目录 ~/.cache/.git 冒充成当前仓库。', 'An API snapshot had no .git, but a parent ~/.cache/.git was discovered as if it were the current repository.'),
    fix: t('snapshot marker 优先；只有 git show-toplevel 精确等于 source root 才承认是 Git checkout。', 'Prefer the snapshot marker; accept a Git checkout only when show-toplevel exactly matches the source root.'),
  },
  {
    id: 'B03',
    where: t('Patch', 'Patch'),
    symptom: t('git apply 报 corrupt patch，最初误以为 OpenEvo pin 不匹配。', 'git apply reported corrupt patch and was initially misdiagnosed as an OpenEvo pin mismatch.'),
    fix: t('先修 unified-diff hunk count，再 strict git apply --check；不使用 fuzzy / 3-way 掩盖真正不匹配。', 'Repair unified-diff hunk counts first, then use strict git apply --check; do not hide real mismatches with fuzzy / 3-way apply.'),
  },
  {
    id: 'B04',
    where: t('WebShop 数据', 'WebShop data'),
    symptom: t('HF reset、Google Drive timeout，重复 retry 没有改变因果条件。', 'HF resets and Google Drive timeouts repeated without changing the causal conditions.'),
    fix: t('改用固定 AgentGym commit 中 vendored 的真实数据，经 GitHub API 下载到 Mac persistent cache，再 rsync 到 RTX6。', 'Use the real vendored data from a pinned AgentGym commit, download it through the GitHub API to the Mac persistent cache, then rsync it to RTX6.'),
  },
  {
    id: 'B05',
    where: t('托管服务', 'Hosted services'),
    symptom: t('GitHub Actions bridge 十几秒结束、steps 为空、artifact=0，看起来像下载失败。', 'A GitHub Actions bridge ended in seconds with empty steps and no artifact, initially resembling a download failure.'),
    fix: t('先定位 admission → runner → step → process → network → data；确认是托管侧 admission/billing 后，移出关键路径。', 'Locate the failure layer in order: admission → runner → step → process → network → data; once hosted admission/billing is confirmed, remove it from the critical path.'),
  },
  {
    id: 'B06',
    where: t('Python / 依赖', 'Python / dependencies'),
    symptom: t('大量 ModuleNotFoundError 容易诱导我们逐个补包，但根因可能是错误解释器或错误环境。', 'Many ModuleNotFoundError messages invite package-by-package fixes even when the real issue is the wrong interpreter or environment.'),
    fix: t('P0 先找 Python ≥3.11 + CUDA Torch 的明确核心，再叠 deterministic overlay；不要无限考古历史 venv。', 'For P0, first obtain an obvious Python ≥3.11 + CUDA Torch core, then layer the deterministic overlay; do not mine historical venvs indefinitely.'),
  },
  {
    id: 'B07',
    where: t('验收', 'Acceptance'),
    symptom: t('曾把 vLLM / gateway / Docker official E2E 当成科学 P0 的必要条件。', 'vLLM / gateway / Docker official E2E was once treated as a requirement for scientific P0.'),
    fix: t('重新拆分：P0 科学复现；P1 冻结黄金环境；P2 基础设施 E2E；P3 扩展到 A800。', 'Split the claims: P0 scientific reproduction; P1 golden environment; P2 infrastructure E2E; P3 A800 scale-up.'),
  },
  {
    id: 'B08',
    where: t('结果解释', 'Result interpretation'),
    symptom: t('reward=0.0 容易被误判成“实验失败”，或 0.0→0.0 被写成性能提升。', 'reward=0.0 can be mistaken for an execution failure, or a 0.0→0.0 tie can be mislabeled as an improvement.'),
    fix: t('0.0 可以证明链路真实执行；只有数值提升才能证明性能改善。把机制证据和效果证据分开。', '0.0 may prove real execution; only a numerical improvement proves performance improvement. Separate mechanism evidence from effectiveness evidence.'),
  },
];
---

<main class="reprod shell">
  <header class="page-head">
    <p class="kicker">{t('复现 C · OpenEvo 实验', 'Reproduction C · OpenEvo experiments')}</p>
    <h1>{t('复现流程', 'Reproduction Process')}</h1>
    <p class="subtitle">{t(
      'OpenEvo × WebShop / ALFWorld：从实验室 Mac 到 4×RTX3090 的自进化实验复现手册',
      'OpenEvo × WebShop / ALFWorld: a step-by-step self-evolution reproduction manual from the lab Mac to 4×RTX3090',
    )}</p>
    <a class="back-link" href={guideHref}>← {t('返回 SEED 复现 C', 'Back to SEED Reproduction C')}</a>
  </header>

  <aside class="scope-note">
    <strong>{t('当前范围', 'Current scope')}</strong>
    <p>{t(
      '这是一份“照着做”的实验手册。当前第一目标是 OpenEvo × WebShop 的科学 P0；ALFWorld 放在 WebShop 跑通之后。页面不会把历史 Kaggle/Colab 成功误写成当前 RTX6 已完成。',
      'This is an execution-first manual. The immediate target is scientific P0 for OpenEvo × WebShop; ALFWorld follows after WebShop is stable. Historical Kaggle/Colab success is not presented as current RTX6 completion.',
    )}</p>
    <div class="claim-row">
      <span><b>P0</b> {t('真实 WebShop + CUDA Qwen + real reflector + gen0→gen1', 'real WebShop + CUDA Qwen + real reflector + gen0→gen1')}</span>
      <span><b>P1</b> {t('冻结黄金环境', 'freeze golden environment')}</span>
      <span><b>P2</b> {t('vLLM / gateway / Docker E2E', 'vLLM / gateway / Docker E2E')}</span>
      <span><b>P3</b> {t('3090 → A800 扩展', '3090 → A800 scale-up')}</span>
    </div>
  </aside>

  <nav class="toc" aria-label={t('复现目录', 'Reproduction contents')}>
    <strong>{t('目录', 'Contents')}</strong>
    <ol>
      <li><a href="#environment">{t('环境准备', 'Environment Setup')}</a></li>
      <li><a href="#code">{t('获取与固定代码', 'Get & Pin Project Code')}</a></li>
      <li><a href="#data">{t('数据准备', 'Data Preparation')}</a></li>
      <li><a href="#runtime">{t('运行环境与依赖', 'Runtime & Dependencies')}</a></li>
      <li><a href="#run">{t('执行 WebShop P0', 'Run WebShop P0')}</a></li>
      <li><a href="#outputs">{t('输出与验收', 'Outputs & Acceptance')}</a></li>
      <li><a href="#alfworld">{t('ALFWorld 下一步', 'ALFWorld Next')}</a></li>
      <li><a href="#troubleshooting">{t('故障索引', 'Troubleshooting Index')}</a></li>
    </ol>
  </nav>

  <section id="environment" class="section">
    <h2>{t('1. 环境准备', '1. Environment Setup')}</h2>

    <h3>{t('1.0 先确认实验拓扑', '1.0 Confirm the experiment topology')}</h3>
    <p>{t(
      '不要把“Mac 有公网”和“RTX6 有公网”混在一起。当前稳定架构是：ChatGPT/GitHub 负责控制面；实验室 Mac 负责下载与资产缓存；Mac 通过物理网络 + SSH/rsync 把代码、WebShop 数据和离线依赖送到 RTX6；RTX6 只负责 GPU 执行。',
      'Do not conflate internet access on the Mac with internet access on RTX6. The stable topology is: ChatGPT/GitHub as the control plane; the lab Mac as the acquisition/cache plane; the Mac relays code, WebShop data, and offline dependencies over the physical network with SSH/rsync; RTX6 only performs GPU execution.',
    )}</p>
    <pre class="diagram"><code>ChatGPT / GitHub
        ↓
Lab Mac  ── internet acquisition + persistent cache
        ↓  SSH / rsync over lab network
RTX6 (4× RTX3090) ── offline GPU execution</code></pre>

    <h3>{t('1.1 检查 Mac 端工具', '1.1 Check tools on the Mac')}</h3>
    <p>{t('在实验室 Mac 上运行：', 'Run on the lab Mac:')}</p>
    <pre><code>{macChecks}</code></pre>
    <p class="expected"><b>{t('预期：', 'Expected:')}</b> {t('GitHub CLI 已登录；Python 3 可用；rsync 与 SSH 存在。当前自动脚本还会检查 tar、bash、cp、git、sshpass 和 macOS security。', 'GitHub CLI is authenticated; Python 3 is available; rsync and SSH exist. The automation also checks tar, bash, cp, git, sshpass, and macOS security.')}</p>

    <h3>{t('1.2 GPU 安全检查', '1.2 GPU safety check')}</h3>
    <p>{t('RTX6 上只使用真正空闲的 GPU。不要 kill、reset 或抢占别人的进程。', 'Use only a genuinely idle GPU on RTX6. Never kill, reset, or preempt unrelated processes.')}</p>
    <pre><code>{gpuCheck}</code></pre>

    <div class="trouble">
      <h4>{t('Troubleshooting：为什么不直接让 RTX6 下载？', 'Troubleshooting: why not download directly on RTX6?')}</h4>
      <p>{t('因为这台服务器的出网能力不是可靠前提。过去的数据与源码问题已经证明：把下载塞进 GPU 阶段只会让“网络失败”和“实验失败”混在一起。资产先在 Mac 准备好，再 relay。', 'Outbound access from this server is not a reliable premise. Earlier source/data incidents showed that downloading during the GPU phase only mixes network failure with experiment failure. Prepare assets on the Mac, then relay them.')}</p>
    </div>
  </section>

  <section id="code" class="section">
    <h2>{t('2. 获取与固定代码', '2. Get & Pin Project Code')}</h2>

    <h3>{t('2.1 不要把 git clone 当成必需步骤', '2.1 Do not make git clone a prerequisite')}</h3>
    <p>{t(
      '当前 lab Mac 的 github.com Git transport 曾经间歇断连，因此正式入口使用 GitHub API snapshot。OpenEvo 也固定到已审查 commit，不跟随 stable/main 漂移。',
      'The lab Mac has experienced intermittent github.com Git transport failures, so the official entrypoint uses GitHub API snapshots. OpenEvo is also pinned to a reviewed commit instead of following stable/main drift.',
    )}</p>
    <div class="facts">
      <div><span>{t('OpenEvo pin', 'OpenEvo pin')}</span><code>b9fac2e1f9a078229124c6fd3bd5ab1379c46d05</code></div>
      <div><span>{t('控制仓库', 'Control repository')}</span><code>mykcs/seed3090</code></div>
    </div>

    <h3>{t('2.2 当前唯一执行入口', '2.2 Current single execution entrypoint')}</h3>
    <p>{t('在 Mac 上执行下面一条命令。它会读取最新 seed3090/main，而不会修改你已有的工作区。', 'Run this single command on the Mac. It reads the latest seed3090/main without mutating an existing worktree.')}</p>
    <pre><code>{bootstrap}</code></pre>

    <h3>{t('2.3 这条命令内部会做什么', '2.3 What this command does internally')}</h3>
    <ol class="steps">
      <li>{t('确认 gh 已登录且账号正确。', 'Verify GitHub CLI authentication and account identity.')}</li>
      <li>{t('通过 api.github.com 获取 seed3090/main 的 exact tarball snapshot。', 'Fetch an exact seed3090/main tarball snapshot through api.github.com.')}</li>
      <li>{t('复用或下载固定 OpenEvo tarball。', 'Reuse or download the pinned OpenEvo tarball.')}</li>
      <li>{t('规范化 patch hunk count，然后 strict apply-check + py_compile。', 'Normalize patch hunk counts, then strict apply-check + py_compile.')}</li>
      <li>{t('把源码、数据和 wheelhouse rsync 到 RTX6。', 'Rsync source, data, and wheelhouse to RTX6.')}</li>
      <li>{t('在 RTX6 启动 scientific P0 pipeline，最后把 artifacts 拉回 Mac。', 'Start the scientific P0 pipeline on RTX6 and retrieve artifacts back to the Mac.')}</li>
    </ol>

    <div class="trouble">
      <h4>{t('Troubleshooting：Git clone / worktree 问题', 'Troubleshooting: Git clone / worktree problems')}</h4>
      <p>{t('不要因为 clone 失败就反复重试，也不要为了拿 main 去破坏已有 worktree。当前入口只关心“exact content identity”，不要求本地必须持有 main 分支。', 'Do not keep retrying clone failures or disturb an existing worktree just to own main. The current entrypoint cares about exact content identity, not local branch ownership.')}</p>
    </div>
  </section>

  <section id="data" class="section">
    <h2>{t('3. 数据准备', '3. Data Preparation')}</h2>

    <h3>{t('3.1 WebShop small 数据', '3.1 WebShop small data')}</h3>
    <p>{t('P0 使用的 WebShop small 路线至少需要这三份 JSON：', 'The WebShop small path used by P0 requires at least these three JSON files:')}</p>
    <pre><code>{dataFiles.join('\n')}</code></pre>

    <h3>{t('3.2 数据如何获取', '3.2 How data is acquired')}</h3>
    <p>{t(
      '当前不再依赖 Hugging Face 或 Google Drive。bootstrap 会从固定 AgentGym commit 中 vendored 的真实 WebShop 数据，经 GitHub Contents/Blob API 下载到 Mac persistent cache；先做 JSON / size / SHA256 校验，再 relay 到 RTX6。',
      'The current path no longer depends on Hugging Face or Google Drive. The bootstrap retrieves real vendored WebShop data from a pinned AgentGym commit through the GitHub Contents/Blob API into a persistent Mac cache, validates JSON / size / SHA256, then relays it to RTX6.',
    )}</p>

    <div class="facts">
      <div><span>{t('Mac cache', 'Mac cache')}</span><code>~/.cache/seed3090-openevo-webshop/webshop-data/</code></div>
      <div><span>{t('策略', 'Policy')}</span><code>cache hit → validate → relay</code></div>
    </div>

    <p class="note"><b>{t('注意：', 'Note:')}</b> {t('代码 snapshot 是一次性的；benchmark data 是长期资产。成功缓存一次以后，不应该因为 seed3090 commit 变化就重新从公网下载。', 'Code snapshots are disposable; benchmark data is a durable asset. Once cached successfully, it should not be re-downloaded merely because the seed3090 commit changes.')}</p>

    <div class="trouble">
      <h4>{t('Troubleshooting：HF / Google Drive 一直失败', 'Troubleshooting: repeated HF / Google Drive failures')}</h4>
      <p>{t('这就是我们之前最典型的“钻牛角尖”：网络条件没变，却不断换顺序、延长 timeout、继续 retry。现在的规则是：同一错误类、同一条件连续两次后，必须改变一个因果变量。这里的变量就是数据源与传输拓扑。', 'This was the clearest example of tunnel vision: network conditions stayed the same while retry order and timeouts changed repeatedly. The current rule is: after the same error class twice under the same conditions, change one causal variable. Here that variable is the data source and transfer topology.')}</p>
    </div>
  </section>

  <section id="runtime" class="section">
    <h2>{t('4. 运行环境与依赖', '4. Runtime & Dependencies')}</h2>

    <h3>{t('4.1 P0 只安装科学链真正需要的东西', '4.1 Install only what scientific P0 needs')}</h3>
    <p>{t(
      'P0 不是基础设施展示。先得到 Python ≥3.11 + CUDA-capable Torch 的核心环境，再叠 WebShop/OpenEvo deterministic overlay。vLLM、rollout server、gateway、Docker 留到 P2。',
      'P0 is not an infrastructure showcase. First obtain a Python ≥3.11 + CUDA-capable Torch core, then layer the deterministic WebShop/OpenEvo overlay. vLLM, rollout server, gateway, and Docker belong to P2.',
    )}</p>

    <h3>{t('4.2 Mac 负责准备离线 wheelhouse', '4.2 The Mac prepares the offline wheelhouse')}</h3>
    <p>{t('bootstrap 会在 Mac 端缓存 Linux CPython 3.12 wheelhouse，再随同源码 relay 到 RTX6。当前 WebShop sparse/Lucene 路径重点包含：', 'The bootstrap caches a Linux CPython 3.12 wheelhouse on the Mac and relays it with the source to RTX6. The WebShop sparse/Lucene path currently focuses on:')}</p>
    <ul>
      <li><code>gym==0.24.0</code></li>
      <li><code>env==0.1.0</code></li>
      <li><code>train==0.0.5</code></li>
      <li><code>pyserini==0.17.0</code> ({t('本体按当前方案 --no-deps', 'package installed with --no-deps in the current plan')})</li>
      <li><code>faiss-cpu</code></li>
      <li>{t('spaCy + en_core_web_sm', 'spaCy + en_core_web_sm')}</li>
    </ul>

    <h3>{t('4.3 先验证 Lucene，再加载模型', '4.3 Validate Lucene before loading the model')}</h3>
    <p>{t('JSON 数据存在还不够。pipeline 必须能准备/打开 WebShop small index，并让 LuceneSearcher 做真实查询。Java / Pyserini / index 的问题应该在占用 GPU 之前暴露。', 'Having the JSON files is not sufficient. The pipeline must prepare/open the WebShop small index and run a real LuceneSearcher query. Java / Pyserini / index failures should surface before GPU allocation.')}</p>

    <div class="trouble">
      <h4>{t('Troubleshooting：一串 ModuleNotFoundError', 'Troubleshooting: a cascade of ModuleNotFoundError')}</h4>
      <p>{t('不要直接在错误的 system Python 上逐个 pip install。先确认解释器版本、CUDA Torch 与当前 overlay 的身份。环境是实验容器，不是实验目标。', 'Do not package-by-package pip install into the wrong system Python. First verify interpreter version, CUDA Torch, and overlay identity. The environment is the experiment container, not the experiment objective.')}</p>
    </div>
  </section>

  <section id="run" class="section">
    <h2>{t('5. 执行 WebShop 科学 P0', '5. Run WebShop Scientific P0')}</h2>

    <h3>{t('5.1 启动实验', '5.1 Start the experiment')}</h3>
    <p>{t('正式运行仍然只需要前面的 single entrypoint；不要绕过它手动拼接多条服务器命令。', 'The official run still uses the single entrypoint above; do not bypass it by manually reconstructing the server pipeline.')}</p>
    <pre><code>{bootstrap}</code></pre>

    <h3>{t('5.2 P0 必须真实证明什么', '5.2 What P0 must prove for real')}</h3>
    <ol class="steps">
      <li>{t('真实 WebAgentTextEnv reset / step。', 'Real WebAgentTextEnv reset / step.')}</li>
      <li>{t('Qwen2.5-3B-Instruct 在 CUDA 上推理。', 'Qwen2.5-3B-Instruct performs inference on CUDA.')}</li>
      <li>{t('至少一个模型产生的 action 被接受，不能全部依赖 fallback。', 'At least one model-produced action is accepted; trajectories cannot be fallback-only.')}</li>
      <li>{t('存在数值 task score；0.0 合法。', 'A numeric task score exists; 0.0 is valid.')}</li>
      <li>{t('gen0 完成。', 'gen0 completes.')}</li>
      <li>{t('真实 model-backed reflector 成功；heuristic fallback 不算。', 'A real model-backed reflector succeeds; heuristic fallback does not count.')}</li>
      <li>{t('非空 evolution text 真的注入 gen1 prompt。', 'Non-empty evolution text is actually injected into the gen1 prompt.')}</li>
      <li>{t('gen1 完成，machine verifier 通过。', 'gen1 completes and the machine verifier passes.')}</li>
    </ol>

    <h3>{t('5.3 成功后立即做什么', '5.3 What happens immediately after success')}</h3>
    <p>{t('P0_PASS 后，pipeline 应立即在同一已验证 runtime 上开始更长的 OpenEvo × WebShop run；同时进入 P1，把这个第一次成功的环境冻结成 golden environment。', 'After P0_PASS, the pipeline should immediately start a longer OpenEvo × WebShop run on the validated runtime, while P1 freezes this first successful environment as the golden environment.')}</p>

    <div class="trouble">
      <h4>{t('Troubleshooting：为什么 reward=0.0 仍可能 PASS？', 'Troubleshooting: why can reward=0.0 still PASS?')}</h4>
      <p>{t('P0 证明的是“真实自进化机制执行了”，不是“方法已经带来性能提升”。0.0 是合法的数值 reward，可以证明执行链；但 0.0→0.0 不能写成性能提升。', 'P0 proves that the real self-evolution mechanism executed, not that the method already improved performance. A numeric 0.0 reward can validate execution, but 0.0→0.0 must not be described as a performance improvement.')}</p>
    </div>
  </section>

  <section id="outputs" class="section">
    <h2>{t('6. 输出与验收', '6. Outputs & Acceptance')}</h2>

    <h3>{t('6.1 成功状态', '6.1 Successful status')}</h3>
    <p>{t('最终不要只看“脚本退出码=0”。检查 STATUS 文件和 artifact。完整 scientific P0 预期：', 'Do not accept only “script exit code = 0”. Inspect the STATUS file and artifacts. A complete scientific P0 should report:')}</p>
    <pre><code>{successStatus}</code></pre>

    <h3>{t('6.2 结果目录', '6.2 Result directories')}</h3>
    <p>{t('RTX6 结果会被回收至 Mac 的 persistent results cache。即使中途失败，dispatcher 也会尽量把已经产生的日志与 artifacts 拉回来。', 'RTX6 results are retrieved into the persistent Mac results cache. Even on failure, the dispatcher attempts to preserve and retrieve logs and artifacts already produced.')}</p>
    <pre><code>~/.cache/seed3090-openevo-webshop/results/</code></pre>

    <h3>{t('6.3 P1 / P2 / P3 不要混写', '6.3 Do not conflate P1 / P2 / P3')}</h3>
    <dl class="claims">
      <div><dt>P1</dt><dd>{t('第一次 P0 成功后冻结 Python、Torch/CUDA、Transformers、WebShop deps、Java/Pyserini、spaCy、数据/模型身份、wheelhouse 与 patch hash。', 'After the first P0 success, freeze Python, Torch/CUDA, Transformers, WebShop deps, Java/Pyserini, spaCy, data/model identity, wheelhouse, and patch hashes.')}</dd></div>
      <div><dt>P2</dt><dd>{t('单独验证 vLLM → rollout → gateway → Docker → WebShopHarness → evaluator。P2 失败不能推翻已通过的 P0。', 'Separately validate vLLM → rollout → gateway → Docker → WebShopHarness → evaluator. A P2 failure cannot downgrade a proven P0.')}</dd></div>
      <div><dt>P3</dt><dd>{t('用 3090 的真实显存、episode 时间、吞吐和长跑数据，估算 8×A800 的迁移与规模。', 'Use measured 3090 memory, episode time, throughput, and sustained-run data to plan the 8×A800 migration.')}</dd></div>
    </dl>
  </section>

  <section id="alfworld" class="section">
    <h2>{t('7. OpenEvo × ALFWorld：下一阶段复现', '7. OpenEvo × ALFWorld: Next Reproduction Stage')}</h2>

    <p class="note"><b>{t('证据边界：', 'Evidence boundary:')}</b> {t('这一部分目前是“下一阶段执行规范”，不是已经验证通过的 ALFWorld one-command reproduction。WebShop P0 没绿之前，不要让 ALFWorld 抢占主线。', 'This section is currently the execution specification for the next stage, not a validated one-command ALFWorld reproduction. Do not let ALFWorld preempt the WebShop P0 path before WebShop is green.')}</p>

    <h3>{t('7.1 先做接口考古，不复制 WebShop 名字', '7.1 Do interface archaeology before copying WebShop')}</h3>
    <p>{t('先从 OpenEvo 的 terminal / environment abstraction 反推 adapter contract，再逐项映射 ALFWorld：', 'Start from OpenEvo terminal/environment abstractions to derive the adapter contract, then map ALFWorld field by field:')}</p>
    <table>
      <thead><tr><th>{t('接口', 'Interface')}</th><th>{t('需要确认', 'What to confirm')}</th><th>{t('证据', 'Evidence')}</th></tr></thead>
      <tbody>
        <tr><td>task / instruction</td><td>{t('任务文本与 split 从哪里来', 'where task text and split come from')}</td><td>{t('固定 task id 可重复 reset', 'fixed task id can reset deterministically')}</td></tr>
        <tr><td>reset</td><td>{t('初始 observation / goal', 'initial observation / goal')}</td><td>{t('真实环境 reset 成功', 'real environment reset succeeds')}</td></tr>
        <tr><td>action</td><td>{t('动作语法、parser、admissible actions', 'action grammar, parser, admissible actions')}</td><td>{t('模型动作被真实 step 接受', 'model action accepted by a real step')}</td></tr>
        <tr><td>observation</td><td>{t('文本 observation 如何进入 prompt', 'how textual observations enter the prompt')}</td><td>{t('trajectory 保存真实 observation', 'trajectory stores real observations')}</td></tr>
        <tr><td>done / reward</td><td>{t('终止条件、reward 与 evaluator', 'termination, reward, evaluator')}</td><td>{t('episode 返回数值结果', 'episode returns a numeric result')}</td></tr>
        <tr><td>assets</td><td>{t('ALFWorld data / game files / cache 路径', 'ALFWorld data / game files / cache paths')}</td><td>{t('无公网 RTX6 也可启动', 'RTX6 can start without outbound internet')}</td></tr>
      </tbody>
    </table>

    <h3>{t('7.2 ALFWorld 的证据阶梯', '7.2 ALFWorld evidence ladder')}</h3>
    <ol class="steps">
      <li>{t('静态 adapter / contract 检查。', 'Static adapter / contract check.')}</li>
      <li>{t('真实 ALFWorld reset + 一步真实 action。', 'Real ALFWorld reset + one real action.')}</li>
      <li>{t('CUDA Qwen 产生可接受动作。', 'CUDA Qwen produces an accepted action.')}</li>
      <li>{t('完整 episode + numeric reward。', 'Complete episode + numeric reward.')}</li>
      <li>{t('gen0 → real reflector → evolution injection → gen1。', 'gen0 → real reflector → evolution injection → gen1.')}</li>
      <li>{t('最后再考虑 OpenEvo P2 service stack。', 'Only then consider the OpenEvo P2 service stack.')}</li>
    </ol>
  </section>

  <section id="troubleshooting" class="section">
    <h2>{t('8. Troubleshooting：已经踩过的坑', '8. Troubleshooting: Known Failure Modes')}</h2>
    <p>{t('下面不是历史流水账，而是出现同类 blocker 时应该直接套用的诊断索引。', 'This is not a chronological diary; it is a diagnostic index to reuse when the same blocker class appears.')}</p>

    <div class="bug-list">
      {bugIndex.map((bug) => (
        <article>
          <header><code>{bug.id}</code><strong>{bug.where}</strong></header>
          <p><b>{t('症状：', 'Symptom:')}</b>{bug.symptom}</p>
          <p><b>{t('正确修法：', 'Fix:')}</b>{bug.fix}</p>
        </article>
      ))}
    </div>

    <h3>{t('8.1 防止再次钻牛角尖的固定规则', '8.1 Fixed anti-tunnel-vision rules')}</h3>
    <ol class="steps">
      <li>{t('保留完整失败 artifact，不要只记最后一行报错。', 'Preserve the complete failure artifact, not only the final error line.')}</li>
      <li>{t('先定位失败层：admission → runner → process → network → asset → runtime → experiment。', 'Locate the failure layer first: admission → runner → process → network → asset → runtime → experiment.')}</li>
      <li>{t('写下已经被本轮证据证明正常的上游层。', 'Record which upstream layers this run already proved healthy.')}</li>
      <li>{t('同一错误类、同一条件连续两次后，第三次必须改变一个因果变量。', 'After the same error class twice under the same conditions, the third attempt must change a causal variable.')}</li>
      <li>{t('只修最小确定性问题；不要每个 blocker 都重新设计总架构。', 'Fix the smallest deterministic problem; do not redesign the whole architecture for every blocker.')}</li>
      <li>{t('每 2–3 轮 blocker 重新检查：我们现在修的东西，还是用户最初要证明的科学问题吗？', 'Every 2–3 blocker rounds, ask again: are we still fixing the scientific question the user originally wanted to prove?')}</li>
    </ol>
  </section>

  <footer class="page-foot">
    <p>{t('这份指南的 current path 会随着 seed3090 的真实实验证据更新；Bug 记录保留为历史证据，不因为后来跑通而删除。', 'The current path in this guide should evolve with real seed3090 experiment evidence; the bug record remains as historical evidence and is not deleted after later success.')}</p>
    <a href={guideHref}>← {t('返回复现 C', 'Back to Reproduction C')}</a>
  </footer>
</main>

