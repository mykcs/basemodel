---
import { localePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const seedGuideHref = `${localePath(locale, '/guide/')}#seed-reproduction`;
const paperHref = localePath(locale, '/papers/seed/');

const claims = [
  {
    id: 'P0',
    title: t('科学复现', 'Scientific reproduction'),
    text: t('真实 WebShop + Qwen CUDA + 非 fallback 动作 + 真实 reflector + evolution 注入 + gen0→gen1。做到这里，就证明核心自进化机制真的跑了。', 'Real WebShop + Qwen on CUDA + non-fallback action + real reflector + evolution injection + gen0→gen1. This is the proof that the scientific self-evolution mechanism really ran.'),
  },
  {
    id: 'P1',
    title: t('冻结黄金环境', 'Freeze the golden environment'),
    text: t('第一次 P0 成功后，再固定 Python / Torch / CUDA / Transformers / Java / Pyserini / spaCy / wheelhouse / 数据与模型身份。', 'After the first P0 success, freeze Python / Torch / CUDA / Transformers / Java / Pyserini / spaCy / wheelhouse / data and model identity.'),
  },
  {
    id: 'P2',
    title: t('OpenEvo 基础设施 E2E', 'OpenEvo infrastructure E2E'),
    text: t('再验证 vLLM → rollout → gateway → Docker → WebShopHarness → evaluator。它很重要，但回答的是基础设施问题，不再阻塞科学 P0。', 'Then validate vLLM → rollout → gateway → Docker → WebShopHarness → evaluator. It matters, but it answers an infrastructure question and no longer blocks scientific P0.'),
  },
  {
    id: 'P3',
    title: t('规模与 A800 迁移', 'Scale and A800 migration'),
    text: t('用 3090 实测的显存、episode 时间、模型加载和长跑数据，估算 8×A800 的迁移与规模化。', 'Use measured 3090 memory, episode time, model loading, and sustained-run evidence to plan the 8×A800 migration.'),
  },
];

const directSteps = [
  {
    n: '01',
    title: t('先把“成功”拆成 P0 / P1 / P2 / P3', 'Split success into P0 / P1 / P2 / P3 first'),
    body: t('不要再用一个“OpenEvo 跑通了”同时表示科学机制、环境、服务栈和规模。最先要证明的是科学 P0；官方服务栈放到 P2。', 'Do not let one phrase—“OpenEvo works”—mean mechanism, environment, service stack, and scale at once. Prove scientific P0 first; keep the official service stack in P2.'),
    gate: t('P0 的正证据写成机器可判断的条件。', 'Write P0 as machine-verifiable positive evidence.'),
  },
  {
    n: '02',
    title: t('先找历史黄金样本，再配环境', 'Find the historical golden run before designing the environment'),
    body: t('2026-07-29 的 WEIYING / Kaggle / Colab 记录是核心参考：真实 WebAgentTextEnv、Qwen2.5-3B、Transformers + CUDA、真实 reflector、inject_evolution、gen0→gen1。7/27 的 COMPLETED 是 stub 证据，不能混为一谈。', 'The 2026-07-29 WEIYING / Kaggle / Colab run is the core reference: real WebAgentTextEnv, Qwen2.5-3B, Transformers + CUDA, real reflector, inject_evolution, gen0→gen1. The 7/27 COMPLETED result was a stub proof and must not be conflated with it.'),
    gate: t('确认“历史成功”到底证明了哪一层，而不是只看 COMPLETED。', 'Classify what the historical success actually proved instead of reading only COMPLETED.'),
  },
  {
    n: '03',
    title: t('复用现有 WebShop adapter，不从零重写', 'Reuse the existing WebShop adapter; do not rewrite it from scratch'),
    body: t('OpenEvo 已经有 WebShop adapter 与 Colab 级历史证据。当前工作是把真实 Linux/GPU 科学链迁到 RTX6，而不是让远程执行 Agent 再设计一套 adapter。', 'OpenEvo already has a WebShop adapter and historical Colab-level evidence. The job is to move the real Linux/GPU scientific path onto RTX6, not to have the remote executor design another adapter.'),
    gate: t('先做 contract / schema / patch 静态检查；真正成功仍要靠真实环境。', 'Run contract / schema / patch static checks first; real success still requires the real environment.'),
  },
  {
    n: '04',
    title: t('把代码、资产、运行时分成三层', 'Separate code, assets, and runtime into three planes'),
    body: t('GitHub 是 control plane；WebShop JSON、wheelhouse、模型、索引是 asset plane；Python/CUDA/Java/GPU 是 runtime plane。先判断 blocker 属于哪层，再修。', 'GitHub is the control plane; WebShop JSON, wheelhouse, model, and index are the asset plane; Python/CUDA/Java/GPU are the runtime plane. Identify the owning plane before fixing a blocker.'),
    gate: t('不要因为 RTX6 无公网，就把下载逻辑塞进 GPU 运行阶段。', 'Do not push internet-download logic into the GPU runtime merely because RTX6 is offline.'),
  },
  {
    n: '05',
    title: t('WebShop 数据走已验证的 GitHub API 资产路线', 'Move WebShop data through the verified GitHub API asset route'),
    body: t('三份 small 数据从固定 AgentGym commit 的 GitHub Contents/Blob API 获取，在 Mac 做 JSON / size / SHA256 校验，写入 persistent cache，再 rsync 到 RTX6。成功一次后后续直接 cache hit。', 'Fetch the three small data files from a fixed AgentGym commit through GitHub Contents/Blob APIs, validate JSON / size / SHA256 on the Mac, persist the cache, then rsync to RTX6. Later runs should be cache hits.'),
    gate: t('RTX6 不需要访问 GitHub、HF 或 Google Drive 才能启动 WebShop。', 'RTX6 should not need GitHub, HF, or Google Drive access to start WebShop.'),
  },
  {
    n: '06',
    title: t('固定 OpenEvo SHA，严格打补丁', 'Pin OpenEvo and apply the validation patch strictly'),
    body: t('精确 tarball → archive 检查 → 解包 → 只修 unified diff hunk count → git apply --check → apply → py_compile。不要用 fuzzy / 3-way 把真实不匹配藏起来。', 'Exact tarball → archive check → extract → repair unified-diff hunk counts only → git apply --check → apply → py_compile. Do not use fuzzy / 3-way matching to hide a real mismatch.'),
    gate: t('patch 能解析与 patch 真匹配是两个不同的 gate。', 'Patch syntax and patch/source semantic compatibility are two different gates.'),
  },
  {
    n: '07',
    title: t('Mac 做 Linux wheelhouse，RTX6 离线装 overlay', 'Build the Linux wheelhouse on the Mac; install the overlay offline on RTX6'),
    body: t('保留老 WebShop 依赖：gym 0.24、env 0.1、train 0.0.5、Pyserini 0.17、faiss-cpu、spaCy model。Pyserini 本体 --no-deps，并显式验证 LuceneSearcher。', 'Preserve the old WebShop dependencies: gym 0.24, env 0.1, train 0.0.5, Pyserini 0.17, faiss-cpu, and the spaCy model. Install Pyserini itself with --no-deps and explicitly validate LuceneSearcher.'),
    gate: t('不是“import pyserini”就算过，而是 Lucene sparse path 真能 import/open index。', 'Do not pass on import pyserini alone; the Lucene sparse path must import and open the index.'),
  },
  {
    n: '08',
    title: t('P0 runtime 只要求真正需要的 CUDA core', 'Require only the CUDA core P0 actually needs'),
    body: t('快速找一个 Python≥3.11（当前 wheelhouse 对齐 3.12）且 CUDA Torch 可用的环境，再叠 overlay。找不到就建立项目专属 GPU env；不要扫描几十上百个历史 venv 追求偶然的完美组合。', 'Quickly find Python≥3.11 (current wheelhouse targets 3.12) with CUDA-capable Torch, then layer the overlay. If none is obvious, create a project-owned GPU env; do not mine dozens of historical venvs for an accidental perfect combination.'),
    gate: t('环境是实验的容器，不是实验本身。', 'The environment is a container for the experiment, not the experiment itself.'),
  },
  {
    n: '09',
    title: t('先开 Lucene index，再碰模型', 'Open the Lucene index before loading the model'),
    body: t('先确认 small data、resources_100、indexes_100、Java/Pyserini/Lucene 都通。索引缺失就重建最小 100-product index。', 'Verify small data, resources_100, indexes_100, Java/Pyserini/Lucene first. If needed, rebuild only the minimal 100-product index.'),
    gate: t('`LuceneSearcher(...).search()` 返回真实结果。', '`LuceneSearcher(...).search()` returns a real result.'),
  },
  {
    n: '10',
    title: t('跑最小真实 Transformers + CUDA rollout', 'Run the smallest real Transformers + CUDA rollout'),
    body: t('Qwen2.5-3B-Instruct 在 CUDA 上对真实 WebShop 生成动作；至少一个 parsed action 不能来自 fallback；reward=0.0 也可以。', 'Qwen2.5-3B-Instruct generates actions on CUDA against real WebShop; at least one parsed action must not come from fallback; reward=0.0 is valid.'),
    gate: t('真实 env + 真实 CUDA model + non-fallback action + numeric score。', 'Real env + real CUDA model + non-fallback action + numeric score.'),
  },
  {
    n: '11',
    title: t('马上跑真实 evolution：gen0 → reflector → injection → gen1', 'Immediately prove real evolution: gen0 → reflector → injection → gen1'),
    body: t('reflector 必须真调用模型，静态 heuristic fallback 不计成功；evolution text 必须非空且真的进入 gen1 prompt；最后由 verifier 验收。', 'The reflector must really call the model; static heuristic fallback does not count. Evolution text must be non-empty and actually enter the gen1 prompt, then the verifier accepts the artifacts.'),
    gate: t('这一层通过 = 科学 P0_PASS；立刻开始长跑。', 'Passing this layer = scientific P0_PASS; start the longer run immediately.'),
  },
  {
    n: '12',
    title: t('成功后先冻结 P1，再单独做 P2', 'Freeze P1 after success; do P2 separately'),
    body: t('先保存黄金环境清单与 hashes；P2 再验证 vLLM/gateway/Docker 服务栈。P2 失败不能把已经通过的 P0 改回失败。', 'First freeze the golden environment manifest and hashes; then validate the vLLM/gateway/Docker service stack as P2. A P2 failure cannot downgrade a proven P0.'),
    gate: t('科学证据与基础设施证据分别报告。', 'Report scientific evidence and infrastructure evidence separately.'),
  },
];

const bugs = [
  {
    id: 'B01',
    title: t('Git clone / worktree 卡死', 'Git clone / worktree dead end'),
    symptom: t('github.com:443 git transport 断连；另一个 worktree 已占 main。', 'github.com:443 Git transport disconnected; another worktree already owned main.'),
    wrong: t('假设远程执行一定能先得到正常 main checkout。', 'Assumed remote execution could always start from a normal main checkout.'),
    fix: t('改成 GitHub API exact snapshot；精确 detached HEAD 也合法；不改用户工作区。', 'Use exact GitHub API snapshots; exact detached HEAD is valid; do not mutate the user workspace.'),
    lesson: t('transport 不是实验声明的一部分。', 'Transport is not part of the experiment claim.'),
  },
  {
    id: 'B02',
    title: t('祖先 .git 被误认成仓库', 'Ancestor .git mistaken for the repo'),
    symptom: t('snapshot 没有 .git，但 git rev-parse 向上找到 ~/.cache/.git，origin 变成 mykcs/.cache.git。', 'The snapshot had no .git, but git rev-parse walked upward into ~/.cache/.git and reported mykcs/.cache.git.'),
    wrong: t('“git 命令成功”被误当成“当前目录就是这个 repo”。', 'A successful Git discovery command was mistaken for proof that the current directory was the repo.'),
    fix: t('snapshot marker 优先；show-toplevel 必须精确等于 source root。', 'Snapshot marker wins; show-toplevel must exactly equal the source root.'),
    lesson: t('工具会跨作用域搜索，必须验证 scope。', 'Tools can search across scopes; verify the scope.'),
  },
  {
    id: 'B03',
    title: t('corrupt patch 被误判成错 pin', 'Corrupt patch mistaken for a bad pin'),
    symptom: t('git apply 报 corrupt patch at line 24。', 'git apply reported corrupt patch at line 24.'),
    wrong: t('第一反应想换 OpenEvo commit。', 'The first impulse was to change the OpenEvo commit.'),
    fix: t('先修 hunk count 格式，再 strict apply-check；不改 payload。', 'Repair hunk-count syntax first, then strict apply-check without altering payload.'),
    lesson: t('先区分 parser failure 与 semantic mismatch。', 'Distinguish parser failure from semantic mismatch first.'),
  },
  {
    id: 'B04',
    title: t('数据下载反复钻牛角尖', 'Data-download tunnel vision'),
    symptom: t('HF reset、Google Drive timeout，换顺序和 retry 仍一样。', 'HF reset, Google Drive timeout, and retry/source reordering changed nothing.'),
    wrong: t('把结构性网络边界当成可通过多试几次解决的 transient bug。', 'Treated a structural network boundary as a transient problem that more retries could solve.'),
    fix: t('换 plane：固定 AgentGym 数据 → GitHub API → Mac persistent cache → RTX6。', 'Change plane: fixed AgentGym data → GitHub API → Mac persistent cache → RTX6.'),
    lesson: t('同一边界连续确定性失败，就改架构，不改 timeout。', 'Repeated deterministic boundary failure means change architecture, not timeout.'),
  },
  {
    id: 'B05',
    title: t('GitHub Actions 桥在运行前就失败', 'GitHub Actions bridge failed before execution'),
    symptom: t('workflow 没有任何 step，账户 billing/spending policy 直接拒绝 job。', 'The workflow had no steps because account billing/spending policy rejected the job before start.'),
    wrong: t('先设计 provider workflow，后检查账户能力。', 'Designed around the provider before checking account capability.'),
    fix: t('删掉 Actions bridge，回到已验证可达的 GitHub API。', 'Remove the Actions bridge and use the already verified GitHub API path.'),
    lesson: t('provider capability / billing 是架构前置条件。', 'Provider capability / billing is an architecture precondition.'),
  },
  {
    id: 'B06',
    title: t('重复 pin lookup 增加失败面', 'Redundant pin lookup added fragility'),
    symptom: t('exact tarball 已缓存，但额外 commit lookup 临时失败直接阻塞。', 'The exact tarball was cached, yet an extra commit lookup transiently failed and blocked the run.'),
    wrong: t('认为更多检查总是更安全。', 'Assumed more checks always meant more safety.'),
    fix: t('用 exact SHA tarball + archive integrity 作为单一强 identity proof。', 'Use the exact SHA tarball + archive integrity as the strong identity proof.'),
    lesson: t('每个远程检查也是 failure surface。', 'Every remote check is also a failure surface.'),
  },
  {
    id: 'B07',
    title: t('太晚才回看 Kaggle / Colab 黄金环境', 'Consulted the Kaggle / Colab golden environment too late'),
    symptom: t('自己重建依赖时漏掉 env、train、faiss-cpu、旧 WebShop 约束。', 'Reconstructed dependencies missed env, train, faiss-cpu, and old WebShop constraints.'),
    wrong: t('先相信现代 requirements / 经验，再看历史成功记录。', 'Trusted modern requirements and memory before looking at historical success.'),
    fix: t('把 7/29 真实成功 notebook 当作第一环境假设。', 'Use the real 7/29 notebook as the first environment hypothesis.'),
    lesson: t('复现工作先做 golden-run archaeology。', 'Reproduction work starts with golden-run archaeology.'),
  },
  {
    id: 'B08',
    title: t('Pyserini metadata 把 onnxruntime 拉进死胡同', 'Pyserini metadata dragged in an onnxruntime dead end'),
    symptom: t('wheelhouse resolver 因镜像没有 onnxruntime 而失败。', 'The wheelhouse resolver failed because the mirror did not contain onnxruntime.'),
    wrong: t('默认所有 transitive metadata dependency 都是当前 WebShop path 必需。', 'Assumed every transitive metadata dependency was required by the current WebShop path.'),
    fix: t('Pyserini --no-deps；显式管理 sparse/Lucene 依赖；实际 import LuceneSearcher。', 'Install Pyserini with --no-deps, explicitly manage sparse/Lucene dependencies, and import LuceneSearcher for real.'),
    lesson: t('验证实际 code path，而不是满足包的所有可能功能。', 'Validate the actual code path, not every possible package feature.'),
  },
  {
    id: 'B09',
    title: t('把 vLLM 绑到所有早期 gate', 'Coupled vLLM to every early gate'),
    symptom: t('扫描 100+ venv 找 torch+vllm+pydantic，科学 rollout 还没开始。', 'Scanned 100+ venvs for torch+vllm+pydantic before the scientific rollout even started.'),
    wrong: t('把最终基础设施依赖当成所有阶段的依赖。', 'Treated final infrastructure dependencies as dependencies of every stage.'),
    fix: t('P0 只要 CUDA Torch + overlay + Transformers；vLLM 移到 P2。', 'P0 needs CUDA Torch + overlay + Transformers; move vLLM to P2.'),
    lesson: t('dependency scope 跟 gate 走。', 'Dependency scope follows the gate.'),
  },
  {
    id: 'B10',
    title: t('同一个确定性 blocker 被重复跑', 'Repeated the same deterministic blocker'),
    symptom: t('相同 main、相同 source、相同缺包/网络边界，仍想“再跑一次看看”。', 'Same main, same source, same missing package/network boundary, yet tempted to “try once more.”'),
    wrong: t('没有先区分 transient 与 deterministic。', 'Failed to classify transient vs deterministic first.'),
    fix: t('只有 transient 才允许 identical retry；deterministic 必须先改变代码/资产/假设。', 'Only transient failures justify identical retry; deterministic blockers require code/asset/assumption changes first.'),
    lesson: t('重复失败不是进展。', 'Repeated failure is not progress.'),
  },
  {
    id: 'B11',
    title: t('auto-pilot 可能并发踩同一个 remote root', 'Auto-pilot could overlap on the same remote root'),
    symptom: t('每 20 分钟看到新 main 就启动，会让两个版本同时 rsync / 执行。', 'Starting every new main on a timer could make two versions rsync/run concurrently.'),
    wrong: t('把“自动推进”理解成“每个 commit 都排队跑”。', 'Interpreted autonomy as running every commit in a queue.'),
    fix: t('一条 active P0；只记录 latest pending SHA；当前任务结束后只跑最新。', 'One active P0; keep only the latest pending SHA; run only the latest when the current task ends.'),
    lesson: t('auto-pilot 需要 coalescing，不是堆队列。', 'Auto-pilot needs coalescing, not a growing queue.'),
  },
  {
    id: 'B12',
    title: t('局部修补累积，整体目标漂移', 'Local fixes accumulated until the goal drifted'),
    symptom: t('每一轮修复都合理，但最后开始把 official service stack 当成科学 P0 本身。', 'Each local fix was reasonable, but eventually the official service stack started to replace scientific P0 itself.'),
    wrong: t('长期调试没有周期性重新问“我们究竟要证明什么”。', 'Long debugging lacked a periodic re-check of what we were actually trying to prove.'),
    fix: t('每 2–3 轮做一次 re-synthesis：重画 claim、plane、gate、dependency。', 'Every 2–3 rounds, re-synthesize the claim, planes, gates, and dependencies.'),
    lesson: t('这是防止“钻牛角尖”最重要的制度。', 'This is the most important institutional defense against tunnel vision.'),
  },
];

const alfContract = [
  [t('任务/指令', 'Task/instruction'), t('OpenEvo task request', 'OpenEvo task request'), t('ALFWorld goal text / task type', 'ALFWorld goal text / task type')],
  [t('reset', 'reset'), t('创建 episode 初始 observation', 'Create initial episode observation'), t('现有 ALFWorld env reset', 'Existing ALFWorld env reset')],
  [t('动作', 'Action'), t('模型输出 → parser → env action', 'Model output → parser → env action'), t('ALFWorld textual action grammar', 'ALFWorld textual action grammar')],
  [t('观察', 'Observation'), t('trajectory observation message', 'Trajectory observation message'), t('文本 observation / feedback', 'Text observation / feedback')],
  [t('终止', 'Terminal'), t('done / terminal state', 'done / terminal state'), t('ALFWorld episode done', 'ALFWorld episode done')],
  [t('奖励', 'Reward'), t('numeric evaluator/result field', 'numeric evaluator/result field'), t('ALFWorld reward / success', 'ALFWorld reward / success')],
  [t('轨迹', 'Trajectory'), t('OpenEvo serializable turns', 'OpenEvo serializable turns'), t('action-observation sequence', 'action-observation sequence')],
  [t('确定性', 'Determinism'), t('seed / task identity', 'seed / task identity'), t('task split + seed', 'task split + seed')],
];
---

<article class="openevo-research">
  <header class="hero">
    <div class="breadcrumbs"><a href={seedGuideHref}>{t('SEED 复现 C', 'SEED reproduction C')}</a><span>/</span><span>OpenEvo</span></div>
    <p class="eyebrow">{t('研究扩展 · OpenEvo × WebShop / ALFWorld', 'Research extension · OpenEvo × WebShop / ALFWorld')}</p>
    <h1>{t('一条最短成功路线，和一条真实踩坑路线', 'One shortest-success route, plus the real bug trail')}</h1>
    <p class="lede">{t('这不是“已经一次写对的教程”。它来自一轮真实的远程复现实验：ChatGPT 负责设计与 GitHub 控制面，MiniMax 在实验室 Mac 上执行，RTX6 负责 4×3090 运行。我们把最终可复用的方法和当时走过的死胡同都保留下来。', 'This is not a tutorial that was magically correct on the first try. It comes from a real remote reproduction loop: ChatGPT designed through the GitHub control plane, MiniMax executed from the lab Mac, and RTX6 hosted the 4×3090 runtime. We preserve both the shortest reusable method and the dead ends that shaped it.')}</p>
    <div class="status-boundary">
      <strong>{t('当前证据边界', 'Current evidence boundary')}</strong>
      <p>{t('2026-07-29 历史 WEIYING/Kaggle/Colab 记录已经证明真实 WebShop + Qwen2.5-3B + Transformers CUDA + reflector + gen0→gen1 可以跑。当前 RTX6 科学 P0 仍需新鲜运行证据；不要把历史成功或环境准备状态写成“RTX6 已完成”。', 'The 2026-07-29 WEIYING/Kaggle/Colab record already proves real WebShop + Qwen2.5-3B + Transformers CUDA + reflector + gen0→gen1 can run. The current RTX6 scientific P0 still needs fresh runtime evidence; do not describe historical success or environment readiness as “RTX6 complete.”')}</p>
    </div>
    <div class="hero-actions"><a class="primary" href="#direct-line">{t('先看最短成功路线', 'Read the shortest success route')}</a><a href="#bug-line">{t('看我们怎么踩坑', 'Read the bug trail')}</a><a href={paperHref}>{t('回 SEED 论文页', 'Back to SEED paper')}</a></div>
  </header>

  <section class="claims" aria-labelledby="claim-title">
    <p class="eyebrow">{t('第一件事：别再把四种“成功”混在一起', 'First: stop mixing four different meanings of success')}</p>
    <h2 id="claim-title">P0 → P1 → P2 → P3</h2>
    <div class="claim-grid">{claims.map((claim) => <article><span>{claim.id}</span><h3>{claim.title}</h3><p>{claim.text}</p></article>)}</div>
  </section>

  <section class="architecture" aria-labelledby="architecture-title">
    <p class="eyebrow">{t('远程实验架构', 'Remote experiment architecture')}</p>
    <h2 id="architecture-title">{t('GitHub 是控制面，Mac 是桥，RTX6 是运行面', 'GitHub is the control plane, the Mac is the bridge, RTX6 is the runtime')}</h2>
    <pre><code>{`ChatGPT / planning Agent
        ↓ code · plan · acceptance · fixes
GitHub seed3090  ────────────── control plane
        ↓ exact snapshot / current plan
MiniMax Code on lab Mac ─────── online asset + SSH bridge
        ↓ rsync / evidence return
RTX6 · 4×RTX3090 ───────────── runtime plane
        ↓
WebShop / Qwen CUDA / evolution
        ↓
P0 scientific proof
        ↓
P1 freeze env · P2 service E2E · P3 scale`}</code></pre>
    <p>{t('把数据、wheel、模型称为 asset plane 很重要：很多早期 bug 其实不是“GPU 环境坏了”，而是资产根本没有可靠地到达 RTX6。', 'Naming data, wheels, and models as an asset plane matters: many early bugs were not “GPU environment failures” at all—the assets simply had no reliable path to RTX6.')}</p>
  </section>

  <section id="direct-line" class="track direct" aria-labelledby="direct-title">
    <div class="track-head"><span>A</span><div><p class="eyebrow">{t('最直接的线', 'The direct line')}</p><h2 id="direct-title">{t('如果今天从头来一次，按这 12 步走', 'If we restarted today, follow these 12 steps')}</h2><p>{t('目标不是“少写命令”，而是让每一步都最大化信息增益，并尽早碰到真实 WebShop + CUDA。', 'The goal is not fewer commands; it is maximal information gain per step and reaching real WebShop + CUDA as early as possible.')}</p></div></div>
    <ol class="steps">{directSteps.map((step) => <li><span class="num">{step.n}</span><div><h3>{step.title}</h3><p>{step.body}</p><div class="gate"><b>{t('通过标准', 'Pass when')}</b><span>{step.gate}</span></div></div></li>)}</ol>
  </section>

  <section class="p0-proof" aria-labelledby="p0-proof-title">
    <p class="eyebrow">{t('P0 的机器可验证定义', 'Machine-verifiable P0 definition')}</p>
    <h2 id="p0-proof-title">{t('0 分可以成功；fallback、mock 和空 COMPLETED 不行', 'A zero reward can pass; fallback, mocks, and empty COMPLETED cannot')}</h2>
    <div class="proof-grid">
      <article><b>1</b><span>{t('真实 WebShop reset / step', 'Real WebShop reset / step')}</span></article>
      <article><b>2</b><span>{t('Qwen2.5-3B 在 CUDA', 'Qwen2.5-3B on CUDA')}</span></article>
      <article><b>3</b><span>{t('至少一个 non-fallback 动作', 'At least one non-fallback action')}</span></article>
      <article><b>4</b><span>{t('numeric score，0.0 合法', 'Numeric score; 0.0 is valid')}</span></article>
      <article><b>5</b><span>{t('gen0 完成', 'gen0 completes')}</span></article>
      <article><b>6</b><span>{t('真实 model reflector', 'Real model reflector')}</span></article>
      <article><b>7</b><span>{t('evolution text 真注入 gen1', 'Evolution text really injected into gen1')}</span></article>
      <article><b>8</b><span>{t('gen1 + verifier 通过', 'gen1 + verifier pass')}</span></article>
    </div>
    <p class="warning">{t('0.0 → 0.0 可以证明机制执行，但绝不能写成“性能提升”或“promoted”。', '0.0 → 0.0 can prove mechanism execution, but must never be described as performance improvement or promotion.')}</p>
  </section>

  <section id="bug-line" class="track bugs" aria-labelledby="bug-title">
    <div class="track-head"><span>B</span><div><p class="eyebrow">{t('另一侧：真实 Bug 线', 'The other side: the real bug trail')}</p><h2 id="bug-title">{t('12 个失败不是 12 个随机事故，而是 8 类错误思维', 'Twelve failures were not random; they exposed recurring reasoning errors')}</h2><p>{t('每张卡都同时记录症状、错误假设、真正修法和可以沉淀的规则。', 'Each card records the symptom, the wrong assumption, the actual fix, and the durable rule.')}</p></div></div>
    <div class="bug-grid">{bugs.map((bug) => <article><span class="bug-id">{bug.id}</span><h3>{bug.title}</h3><dl><div><dt>{t('症状', 'Symptom')}</dt><dd>{bug.symptom}</dd></div><div><dt>{t('错误假设', 'Wrong assumption')}</dt><dd>{bug.wrong}</dd></div><div><dt>{t('真正修复', 'Actual fix')}</dt><dd>{bug.fix}</dd></div><div><dt>{t('沉淀规则', 'Durable rule')}</dt><dd>{bug.lesson}</dd></div></dl></article>)}</div>
  </section>

  <section class="reasoning" aria-labelledby="reasoning-title">
    <p class="eyebrow">{t('为什么我们会不停犯错？', 'Why did we keep making mistakes?')}</p>
    <h2 id="reasoning-title">{t('真正的问题不是不会写代码，而是没有定期重新综合', 'The deeper problem was not coding skill—it was failing to re-synthesize')}</h2>
    <div class="reasoning-grid">
      <article><h3>{t('完整性幻觉', 'Completeness illusion')}</h3><p>{t('总方案写得很长，于是自然产生“应该不会再有问题”的心理预期。真实机器却永远能暴露静态文档看不到的约束。', 'A long master plan created the feeling that nothing should go wrong. Real machines inevitably expose constraints static prose cannot see.')}</p></article>
      <article><h3>{t('路径执着', 'Path fixation')}</h3><p>{t('HF/GD 不通时，我们先想到换镜像、重试、加 timeout，而不是先问“为什么一定要走这条网络边界”。', 'When HF/GD failed, we first changed mirrors, retries, and timeouts instead of asking why that network boundary was required at all.')}</p></article>
      <article><h3>{t('基础设施替代科学目标', 'Infrastructure substituted for science')}</h3><p>{t('official service stack 越做越完整，最后差点变成 P0 本身；但它和“自进化机制是否真实运行”是两个问题。', 'The official service stack became increasingly complete until it almost replaced P0 itself, even though it answers a different question from whether self-evolution really runs.')}</p></article>
      <article><h3>{t('依赖大一统', 'Dependency over-unification')}</h3><p>{t('试图找一个 venv 一次满足 Torch、vLLM、Pydantic、WebShop 所有未来阶段，导致扫描 100+ 环境。', 'Trying to find one venv satisfying Torch, vLLM, Pydantic, and every future WebShop stage caused a scan across 100+ environments.')}</p></article>
      <article><h3>{t('历史证据用得太晚', 'Historical evidence came too late')}</h3><p>{t('如果一开始先读 7/29 的真实成功 notebook，env/train/faiss、Transformers path、0 分语义都会更早明确。', 'If we had started with the real 7/29 notebook, env/train/faiss, the Transformers path, and zero-reward semantics would have been clear much earlier.')}</p></article>
      <article><h3>{t('局部最优累积', 'Local optima accumulated')}</h3><p>{t('每次只修眼前 blocker，看起来都合理；但 2–3 轮后如果不重新画 claim/plane/gate，整体会越来越偏。', 'Each local blocker fix looked reasonable, but without redrawing claim/plane/gates every 2–3 rounds, the global design drifted.')}</p></article>
    </div>
    <div class="resynthesis"><strong>{t('新的制度', 'New rule')}</strong><span>{t('连续修 2–3 轮以后，必须重新问：P0 到底证明什么？当前 blocker 属于哪个 plane？有没有黄金样本？这个 gate 真必要吗？同一个 deterministic failure 是否在被重复跑？', 'After 2–3 fixes, explicitly re-ask: what does P0 prove? Which plane owns the blocker? Is there a golden run? Is this gate truly necessary? Are we repeating the same deterministic failure?')}</span></div>
  </section>

  <section class="alfworld" aria-labelledby="alfworld-title">
    <p class="eyebrow">{t('下一条研究线 · OpenEvo × ALFWorld', 'Next research line · OpenEvo × ALFWorld')}</p>
    <h2 id="alfworld-title">{t('不要照抄 WebShop adapter；先做接口考古', 'Do not clone the WebShop adapter blindly; do interface archaeology first')}</h2>
    <p>{t('WebShop P0 稳定以后，再开始 ALFWorld。第一步不是写代码，而是同时读 OpenEvo terminal interface、WebShop adapter、SEED 的 ALFWorld 集成，把契约对齐。', 'After WebShop P0 stabilizes, start ALFWorld. The first step is not coding; inspect the OpenEvo terminal interface, the WebShop adapter, and SEED’s ALFWorld integration together and align their contracts.')}</p>
    <div class="table-wrap"><table><thead><tr><th>{t('契约', 'Contract')}</th><th>OpenEvo</th><th>ALFWorld</th></tr></thead><tbody>{alfContract.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div>
    <h3>{t('ALFWorld 最小证明梯', 'Minimal ALFWorld proof ladder')}</h3>
    <ol class="alf-ladder"><li>{t('static adapter / parser tests', 'static adapter / parser tests')}</li><li>{t('真实 ALFWorld reset + 一个合法动作', 'real ALFWorld reset + one legal action')}</li><li>{t('真实 CUDA model action', 'real CUDA model action')}</li><li>{t('完整 episode + numeric reward', 'full episode + numeric reward')}</li><li>{t('真实 reflector / evolution proof', 'real reflector / evolution proof')}</li><li>{t('需要时再做 P2 official orchestration', 'P2 official orchestration only when needed')}</li></ol>
  </section>

  <section class="takeaways" aria-labelledby="takeaway-title">
    <p class="eyebrow">{t('最终沉淀', 'What we keep')}</p>
    <h2 id="takeaway-title">{t('以后再做类似实验，先记住这 10 条', 'Ten rules to carry into the next reproduction')}</h2>
    <ol><li>{t('详细方案 ≠ 已验证方案。', 'A detailed plan is not a validated plan.')}</li><li>{t('复现先找黄金历史运行。', 'Start reproduction from a golden historical run.')}</li><li>{t('把 scientific claim 和 infrastructure claim 分开。', 'Separate scientific and infrastructure claims.')}</li><li>{t('把 control / asset / runtime 三层分开。', 'Separate control / asset / runtime planes.')}</li><li>{t('一个边界连续确定性失败，就换架构。', 'Repeated deterministic boundary failure means change architecture.')}</li><li>{t('provider billing/权限先验证，再设计工作流。', 'Verify provider billing/permissions before designing around it.')}</li><li>{t('只要求当前 gate 真需要的依赖。', 'Require only dependencies the current gate truly needs.')}</li><li>{t('测试实际 code path，不迷信 metadata。', 'Test the real code path, not package metadata alone.')}</li><li>{t('deterministic blocker 不用同样代码无限重跑。', 'Do not endlessly rerun deterministic blockers with identical code.')}</li><li>{t('auto-pilot 串行 + latest SHA coalescing；每几轮强制重新综合。', 'Serialize auto-pilot + latest-SHA coalescing; force re-synthesis every few rounds.')}</li></ol>
  </section>
</article>

