---
import { localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---
<section class="agent-bridge" aria-labelledby="agent-bridge-title">
  <header class="agent-bridge-head">
    <span>{t('Agent 基础', 'Agent basics')}</span>
    <h2 id="agent-bridge-title">{t('Agent 运行与训练', 'Agent runtime and training')}</h2>
    <p>{t('如果已经理解 Transformer、微调、推理和 API，只需要补齐 Agent 的多步交互、trajectory、reward 与参数更新之间的关系。','If you already understand Transformers, fine-tuning, inference, and APIs, the missing layer is how multi-step interaction, trajectories, rewards, and parameter updates fit together.')}</p>
  </header>

  <ol class="bridge-steps">
    <li><span>01</span><div><h3>{t('Agent 运行循环', 'Agent runtime loop')}</h3><p>{t('模型根据当前 observation 选择 action / tool，环境返回新的 observation，直到任务终止。运行时通常不做反向传播。','The model chooses an action/tool from the current observation; the environment returns the next observation until termination. Runtime usually has no backpropagation.')}</p><code>observation → policy → action → environment → observation</code></div></li>
    <li><span>02</span><div><h3>{t('Agent 训练循环', 'Agent training loop')}</h3><p>{t('多个 rollout 被 reward / evaluator 评分，再转换为 loss 或 advantage，通过 optimizer 更新 policy。','Multiple rollouts are scored by rewards/evaluators, converted into losses or advantages, and used by an optimizer to update the policy.')}</p><code>rollouts → reward → loss / advantage → optimizer → policy'</code></div></li>
    <li><span>03</span><div><h3>{t('Agentic RL 基础', 'Agentic RL basics')}</h3><p>{t('Policy、Action、Trajectory、Reward、Advantage 是后面读 GRPO、OPD 和 SEED 时最重要的五个词。','Policy, Action, Trajectory, Reward, and Advantage are the five key concepts needed for GRPO, OPD, and SEED.')}</p></div></li>
    <li><span>04</span><div><h3>{t('SEED 的两阶段流程', 'SEED two-stage flow')}</h3><p>{t('Stage 1 用 hindsight skill SFT 学会分析完整轨迹；Stage 2 用 on-policy rollout、hindsight skill、GRPO 与 OPD 更新 policy 参数。','Stage 1 uses hindsight skill SFT to learn trajectory analysis; Stage 2 uses on-policy rollouts, hindsight skills, GRPO, and OPD to update policy parameters.')}</p></div></li>
  </ol>

  <div class="bridge-links"><a class="button button-primary" href={p('/research/seed-openevo/flow/seed/')}>{t('SEED 方法 →','SEED method →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/flow/loops/')}>{t('SEED / OpenEvo 更新机制','SEED / OpenEvo update mechanisms')}</a></div>
</section>

<style>
  .agent-bridge{margin:2rem 0}.agent-bridge-head{max-width:820px}.agent-bridge-head>span{color:var(--accent-deep);font-size:.7rem;font-weight:800}.agent-bridge-head h2{margin:.35rem 0 .55rem}.agent-bridge-head p{margin:0;color:var(--muted);line-height:1.65}.bridge-steps{margin:1rem 0 0;padding:0;border-top:1px solid var(--line);list-style:none}.bridge-steps li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:.2rem .85rem;padding:.9rem 0;border-bottom:1px solid var(--line)}.bridge-steps li>span{grid-column:1;grid-row:1/2;padding-top:.15rem;color:var(--accent-deep);font:800 .66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.bridge-steps li>div{grid-column:2;min-width:0}.bridge-steps h3{margin:.05rem 0 .3rem}.bridge-steps p{margin:0;color:var(--muted);font-size:.76rem;line-height:1.5}.bridge-steps code{display:block;margin-top:.45rem;padding:.5rem;border-radius:8px;background:var(--surface-muted);font-size:.68rem;overflow-wrap:anywhere}.bridge-links{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:1rem}@media(max-width:640px){.bridge-steps li{grid-template-columns:32px minmax(0,1fr);gap:.2rem .65rem}}
</style>
