---
import { getMessages, localePath, switchLocalePath, parsePath, type Locale } from '../i18n';
import { CommandMenu } from './navigation/CommandMenu.tsx';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = getMessages(locale);
const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';

// 语言切换与当前页状态共用同一个无 base path 路径，详情页会高亮所属列表入口。
const { pathNoBase } = parsePath(Astro.url.pathname);
const isCurrent = (path: string) => pathNoBase === path || (path !== '/' && pathNoBase.startsWith(path));

// 站内链接全部走 localePath, 英文版自动带 /en/ 前缀。
const primaryLinks = [
  { path: '/workspace/', label: m.nav.workspace },
  { path: '/models/', label: m.nav.models },
  { path: '/papers/', label: m.nav.papers },
  { path: '/guide/', label: m.nav.guide },
].map((link) => ({ ...link, href: localePath(locale, link.path), active: isCurrent(link.path) }));
const utilityLinks = [{ path: '/compare/', label: m.nav.compare }].map((link) => ({ ...link, href: localePath(locale, link.path), active: isCurrent(link.path) }));

// 语言切换: 映射当前路径到另一语言的等价路径。
const switchHref = switchLocalePath(otherLocale, pathNoBase);
---
<header class="site-header">
  <div class="shell nav-inner">
    <a class="brand" href={localePath(locale, '/')} aria-label={m.site.backHome}>
      <span class="brand-mark" aria-hidden="true">↗</span>
      <span><strong>{m.site.name}</strong><small>{m.site.tagline}</small></span>
    </a>
    <nav aria-label={m.nav.mainNav} class="desktop-nav">
      <div class="nav-primary">{primaryLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}</div>
      <div class="nav-secondary">{utilityLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}</div>
    </nav>
    <CommandMenu client:load locale={locale} m={m} />
    <a class="lang-switch" href={switchHref} aria-label={m.nav.switchLangLabel} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{m.nav.switchLang}</a>
    <button class="menu-toggle" type="button" aria-label={m.nav.openMenu} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <button class="theme-toggle" type="button" aria-label={m.nav.toggleTheme} title={m.nav.toggleTheme} aria-pressed="false" data-theme-toggle data-dark-label={m.nav.toggleLightTheme} data-light-label={m.nav.toggleDarkTheme}>◐</button>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <div class="shell">
      {[...primaryLinks, ...utilityLinks].map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
      <a class="lang-switch" href={switchHref} aria-label={m.nav.switchLangLabel} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{m.nav.switchLang}</a>
      <button class="theme-toggle" type="button" aria-label={m.nav.toggleTheme} title={m.nav.toggleTheme} aria-pressed="false" data-theme-toggle-mobile data-dark-label={m.nav.toggleLightTheme} data-light-label={m.nav.toggleDarkTheme}>◐</button>
    </div>
  </div>
</header>
<script>
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('is-open');
    menuToggle?.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !mobileMenu?.classList.contains('is-open')) return;
    mobileMenu.classList.remove('is-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    (menuToggle as HTMLElement | null)?.focus();
  });
  const themeToggles = [...document.querySelectorAll('[data-theme-toggle], [data-theme-toggle-mobile]')];
  const syncThemeControls = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeToggles.forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.setAttribute('aria-label', dark ? (toggle.getAttribute('data-dark-label') ?? '') : (toggle.getAttribute('data-light-label') ?? ''));
      toggle.setAttribute('title', dark ? (toggle.getAttribute('data-dark-label') ?? '') : (toggle.getAttribute('data-light-label') ?? ''));
      toggle.textContent = dark ? '☀' : '◐';
    });
  };
  themeToggles.forEach((toggle) => {
    if (toggle.getAttribute('data-theme-bound') === 'true') return;
    toggle.setAttribute('data-theme-bound', 'true');
    toggle.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.documentElement.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('atlas-theme', dark ? 'light' : 'dark'); } catch {}
      syncThemeControls();
      window.dispatchEvent(new CustomEvent('atlas:themechange', { detail: { theme: dark ? 'light' : 'dark' } }));
    });
  });
  syncThemeControls();
</script>
