---
import { getMessages, localePath, parsePath, type Locale } from '../i18n';
import { localizedRoute } from '../lib/sitemapRoutes';
import CommandMenu from './navigation/CommandMenu.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = getMessages(locale);
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const otherLocale: Locale = zh ? 'en' : 'zh';

// Keep the global header focused on two research surfaces plus a small set of
// genuinely top-level resources. Research subpages live inside their local nav.
const { pathNoBase } = parsePath(Astro.url.pathname);
const starts = (path: string) => pathNoBase === path || pathNoBase.startsWith(path.endsWith('/') ? path : `${path}/`);

const journeyLinks = [
  {
    id: 'flow',
    path: '/research/seed-openevo/flow/',
    label: t('流程理解图', 'Flow map'),
    meta: 'OpenEvo · SEED · ALFWorld · WebShop',
    active: starts('/research/seed-openevo/flow/'),
  },
  {
    id: 'study',
    path: '/research/seed-openevo/study/',
    label: t('OpenEvo × WebShop 科学研究', 'OpenEvo × WebShop study'),
    meta: t('实验 · 复现 · 结论 · 下一步', 'experiments · reproduce · findings · next'),
    active: starts('/research/seed-openevo/study/'),
  },
].map((link) => ({
  ...link,
  href: localePath(locale, link.path),
  current: pathNoBase === link.path,
}));

const utilityLinks = [
  { path: '/models/', label: m.nav.models, description: t('具体模型、checkpoint、权重和运行条件', 'Concrete models, checkpoints, weights, and runtime conditions') },
  { path: '/papers/', label: m.nav.papers, description: t('论文方法、模型角色、训练条件和来源', 'Paper methods, model roles, training conditions, and sources') },
  { path: '/compare/', label: t('比较模型', 'Compare models'), description: t('并排检查会改变实验公平性的模型差异', 'Inspect model differences that can change experimental fairness') },
  { path: '/workspace/', label: t('实验工作台', 'Experiment workspace'), description: t('保存模型、GPU、网络和训练条件', 'Save model, GPU, network, and training settings') },
  { path: '/data-status/', label: m.nav.dataStatus, description: t('数据更新、目录核验、未知字段与证据状态', 'Dataset updates, catalog checks, unknown fields, and evidence status') },
  { path: '/methodology/', label: t('方法与边界', 'Methodology'), description: t('事实来源、证据等级和比较边界', 'Sources, evidence levels, and comparison boundaries') },
].map((link) => ({
  ...link,
  href: localePath(locale, link.path),
  active: starts(link.path),
}));

const switchHref = localizedRoute(pathNoBase, otherLocale);
const commandMenuLabels = {
  search: m.nav.search,
  searchTitle: m.nav.searchTitle,
  closeSearch: m.nav.closeSearch,
  searchPlaceholder: m.nav.searchPlaceholder,
  noSearchResults: m.nav.noSearchResults,
  commandHint: m.nav.commandHint,
  searchModel: m.nav.searchModel,
  searchPaper: m.nav.searchPaper,
  searchFamily: m.nav.searchFamily,
  searchGuide: m.nav.searchGuide,
};
---
<header class="site-header" data-site-header>
  <div class="shell nav-inner">
    <a class="brand" href={localePath(locale, '/')} aria-label={m.site.backHome}>
      <span class="brand-mark" aria-hidden="true">BM</span>
      <span>
        <strong>{m.site.name}</strong>
        <small>{t('查看 Agent 实验里的模型、论文和复现步骤', 'Models, papers, and reproduction steps for agent experiments')}</small>
      </span>
    </a>

    <nav aria-label={m.nav.mainNav} class="desktop-nav mission-nav">
      <div class="journey-nav" aria-label={t('两条研究主线', 'Two primary research paths')}>
        {journeyLinks.map((link, index) => (
          <a class="journey-link" href={link.href} aria-current={link.current ? 'page' : undefined} data-active={link.active ? 'true' : undefined} data-journey={link.id}>
            <span class="journey-link__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="journey-link__copy"><strong>{link.label}</strong><small>{link.meta}</small></span>
          </a>
        ))}
      </div>

      <details class="resource-menu" data-resource-menu>
        <summary aria-label={t('打开资料入口', 'Open resource destinations')}>
          <span>{t('资料', 'Resources')}</span>
          <i aria-hidden="true"></i>
        </summary>
        <div class="resource-menu__panel">
          <div class="resource-menu__intro">
            <small>{t('实验资料', 'Research resources')}</small>
            <strong>{t('模型、论文、比较工具、实验工作台与证据状态', 'Models, papers, comparison tools, experiment workspace, and evidence status')}</strong>
          </div>
          <div class="resource-menu__links">
            {utilityLinks.map((link) => (
              <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                <strong>{link.label}</strong>
                <span>{link.description}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
    </nav>

    <CommandMenu locale={locale} labels={commandMenuLabels} />
    {switchHref && <a class="lang-switch" href={switchHref} aria-label={m.nav.switchLangLabel} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{m.nav.switchLang}</a>}
    <button class="menu-toggle" type="button" aria-label={m.nav.openMenu} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <button class="theme-toggle" type="button" aria-label={m.nav.toggleTheme} title={m.nav.toggleTheme} aria-pressed="false" data-theme-toggle data-dark-label={m.nav.toggleLightTheme} data-light-label={m.nav.toggleDarkTheme}>◐</button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="shell mobile-menu__inner">
      <section class="mobile-menu__section" aria-labelledby="mobile-journeys-title">
        <div class="mobile-menu__heading">
          <span id="mobile-journeys-title">{t('两条研究主线', 'Two primary research paths')}</span>
          <small>{t('先选你现在要完成的事', 'Start with what you need to accomplish')}</small>
        </div>
        <nav class="mobile-journeys" aria-label={t('主要操作', 'Main actions')}>
          {journeyLinks.map((link, index) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined} data-active={link.active ? 'true' : undefined}>
              <span>{String(index + 1).padStart(2,'0')}</span>
              <div><strong>{link.label}</strong><small>{link.meta}</small></div>
            </a>
          ))}
        </nav>
      </section>

      <section class="mobile-menu__section mobile-menu__utilities" aria-labelledby="mobile-tools-title">
        <div class="mobile-menu__heading">
          <span id="mobile-tools-title">{t('资料', 'Resources')}</span>
          <small>{t('模型、论文、比较、实验与证据', 'Models, papers, comparison, experiments, and evidence')}</small>
        </div>
        <nav class="mobile-utility-links" aria-label={t('资料', 'Resources')}>
          {utilityLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
        </nav>
      </section>

      <div class="mobile-menu__controls">
        {switchHref && <a class="lang-switch" href={switchHref} aria-label={m.nav.switchLangLabel} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{m.nav.switchLang}</a>}
        <button class="theme-toggle" type="button" aria-label={m.nav.toggleTheme} title={m.nav.toggleTheme} aria-pressed="false" data-theme-toggle-mobile data-dark-label={m.nav.toggleLightTheme} data-light-label={m.nav.toggleDarkTheme}>◐</button>
      </div>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const resourceMenu = document.querySelector<HTMLDetailsElement>('[data-resource-menu]');

  const setMobileMenu = (open: boolean, restoreFocus = false) => {
    mobileMenu?.classList.toggle('is-open', open);
    mobileMenu?.setAttribute('aria-hidden', String(!open));
    menuToggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('mobile-nav-open', open);
    if (open) {
      requestAnimationFrame(() => mobileMenu?.querySelector<HTMLElement>('a')?.focus());
    } else if (restoreFocus) {
      menuToggle?.focus();
    }
  };

  menuToggle?.addEventListener('click', () => {
    setMobileMenu(!mobileMenu?.classList.contains('is-open'));
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobileMenu(false)));

  document.addEventListener('click', (event) => {
    if (!resourceMenu?.open || resourceMenu.contains(event.target as Node)) return;
    resourceMenu.open = false;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (resourceMenu?.open) {
      const focusWasInside = resourceMenu.contains(document.activeElement);
      resourceMenu.open = false;
      if (focusWasInside) resourceMenu.querySelector<HTMLElement>('summary')?.focus();
    }
    if (mobileMenu?.classList.contains('is-open')) setMobileMenu(false, true);
  });

  const themeToggles = [...document.querySelectorAll<HTMLElement>('[data-theme-toggle], [data-theme-toggle-mobile]')];
  const syncThemeControls = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeToggles.forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.setAttribute('aria-label', dark ? (toggle.getAttribute('data-dark-label') ?? '') : (toggle.getAttribute('data-light-label') ?? ''));
      toggle.setAttribute('title', dark ? (toggle.getAttribute('data-dark-label') ?? '') : (toggle.getAttribute('data-light-label') ?? ''));
      toggle.textContent = dark ? '☀' : '◐';
    });
  };

  themeToggles.forEach((toggle) => {
    if (toggle.getAttribute('data-theme-bound') === 'true') return;
    toggle.setAttribute('data-theme-bound', 'true');
    toggle.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.documentElement.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('atlas-theme', dark ? 'light' : 'dark'); } catch {}
      syncThemeControls();
      window.dispatchEvent(new CustomEvent('atlas:themechange', { detail: { theme: dark ? 'light' : 'dark' } }));
    });
  });
  syncThemeControls();
</script>

<style>
  .site-header { --nav-accent: var(--accent, #2457d6); }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--nav-accent) 38%, var(--line));
    border-radius: 10px;
    background: color-mix(in srgb, var(--nav-accent) 8%, var(--surface));
    color: var(--nav-accent);
    font: 850 .68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: -.04em;
  }

  .mission-nav {
    min-width: 0;
    flex: 1 1 auto;
    justify-content: flex-end;
    gap: .45rem;
  }

  .journey-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(150px, 1fr));
    gap: .32rem;
    min-width: 0;
  }

  .journey-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .5rem;
    align-items: center;
    min-width: 0;
    min-height: 48px;
    padding: .42rem .55rem;
    border: 1px solid transparent;
    border-radius: 11px;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
  }

  .journey-link:hover,
  .journey-link:focus-visible {
    border-color: var(--line);
    background: color-mix(in srgb, var(--nav-accent) 5%, transparent);
    transform: translateY(-1px);
  }

  .journey-link[aria-current='page'],
  .journey-link[data-active='true'] {
    border-color: color-mix(in srgb, var(--nav-accent) 28%, var(--line));
    background: color-mix(in srgb, var(--nav-accent) 8%, var(--surface));
  }

  .journey-link__index {
    color: var(--nav-accent);
    font: 800 .58rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .journey-link__copy,
  .journey-link__copy strong,
  .journey-link__copy small { display: block; min-width: 0; }
  .journey-link__copy strong { overflow: hidden; font-size: .75rem; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
  .journey-link__copy small { margin-top: .2rem; overflow: hidden; color: var(--muted); font-size: .58rem; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }

  .resource-menu { position: relative; flex: 0 0 auto; }
  .resource-menu summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: .42rem;
    padding: .46rem .6rem;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--muted);
    cursor: pointer;
    font-size: .7rem;
    font-weight: 800;
    list-style: none;
  }
  .resource-menu summary::-webkit-details-marker { display: none; }
  .resource-menu summary:hover,
  .resource-menu summary:focus-visible,
  .resource-menu[open] summary { border-color: var(--line); color: var(--ink); background: var(--surface); }
  .resource-menu summary i {
    position: relative;
    width: 10px;
    height: 10px;
  }
  .resource-menu summary i::before,
  .resource-menu summary i::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 150ms ease;
  }
  .resource-menu summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  .resource-menu[open] summary i::after { transform: translate(-50%, -50%); }

  .resource-menu__panel {
    position: absolute;
    z-index: 50;
    top: calc(100% + .65rem);
    right: 0;
    box-sizing: border-box;
    width: min(520px, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    max-height: min(72vh, 640px);
    overflow-y: auto;
    padding: .75rem;
    border: 1px solid var(--line);
    border-radius: 17px;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    box-shadow: 0 22px 70px color-mix(in srgb, var(--ink) 16%, transparent);
    backdrop-filter: blur(18px);
  }

  .resource-menu__intro {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: .8rem;
    align-items: baseline;
    padding: .45rem .55rem .75rem;
  }
  .resource-menu__intro small { color: var(--nav-accent); font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .resource-menu__intro strong { min-width: 0; color: var(--ink); font-size: .72rem; line-height: 1.4; overflow-wrap: anywhere; white-space: normal; }

  .resource-menu__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .38rem;
  }
  .resource-menu__links a {
    display: grid;
    align-content: start;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: .2rem;
    padding: .72rem;
    border: 1px solid transparent;
    border-radius: 11px;
    color: inherit;
    text-decoration: none;
  }
  .resource-menu__links a:hover,
  .resource-menu__links a:focus-visible,
  .resource-menu__links a[aria-current='page'] {
    border-color: var(--line);
    background: color-mix(in srgb, var(--nav-accent) 6%, transparent);
  }
  .resource-menu__links strong,
  .resource-menu__links span { display: block; min-width: 0; white-space: normal; overflow-wrap: anywhere; }
  .resource-menu__links strong { color: var(--ink); font-size: .73rem; }
  .resource-menu__links span { margin-top: 0; color: var(--muted); font-size: .62rem; line-height: 1.4; }

  @media (max-width: 760px) {
    .resource-menu__panel { width: min(520px, calc(100vw - 1rem)); max-width: calc(100vw - 1rem); }
    .resource-menu__intro { grid-template-columns: 1fr; gap: .22rem; }
    .resource-menu__links { grid-template-columns: 1fr; }
  }

  .mobile-menu__inner {
    max-height: calc(100dvh - 66px);
    padding-top: 1rem;
    padding-bottom: 1.25rem;
    overflow-y: auto;
  }
  .mobile-menu__section + .mobile-menu__section { margin-top: 1.25rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .mobile-menu__heading { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; margin-bottom: .65rem; }
  .mobile-menu__heading span { color: var(--ink); font-size: .74rem; font-weight: 850; }
  .mobile-menu__heading small { color: var(--muted); font-size: .62rem; text-align: right; }

  .mobile-journeys { display: grid; gap: .5rem; }
  .mobile-journeys a {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: .7rem;
    align-items: center;
    min-height: 58px;
    padding: .65rem .75rem;
    border: 1px solid var(--line);
    border-radius: 13px;
    color: inherit;
    text-decoration: none;
  }
  .mobile-journeys a[aria-current='page'],
  .mobile-journeys a[data-active='true'] { border-color: color-mix(in srgb, var(--nav-accent) 40%, var(--line)); background: color-mix(in srgb, var(--nav-accent) 7%, transparent); }
  .mobile-journeys > a > span { color: var(--nav-accent); font: 800 .62rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .mobile-journeys strong,
  .mobile-journeys small { display: block; }
  .mobile-journeys strong { color: var(--ink); font-size: .86rem; }
  .mobile-journeys small { margin-top: .23rem; color: var(--muted); font-size: .67rem; }

  .mobile-utility-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .42rem; }
  .mobile-utility-links a {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding: .55rem .65rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-size: .72rem;
    font-weight: 750;
    text-decoration: none;
  }
  .mobile-utility-links a[aria-current='page'] { border-color: var(--nav-accent); color: var(--nav-accent); }

  .mobile-menu__controls {
    display: flex;
    gap: .55rem;
    align-items: center;
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .mobile-menu__controls .lang-switch,
  .mobile-menu__controls .theme-toggle { min-height: 44px; }

  :global(html.mobile-nav-open) { overflow: hidden; }

  @media (max-width: 1220px) {
    .journey-nav { grid-template-columns: repeat(2, minmax(128px, 1fr)); }
    .journey-link { padding-inline: .42rem; }
    .journey-link__copy small { display: none; }
  }

  @media (max-width: 1080px) {
    .brand { flex: 0 0 auto; }
    .journey-nav { grid-template-columns: repeat(2, minmax(112px, 1fr)); }
    .journey-link__index { display: none; }
    .journey-link { grid-template-columns: minmax(0, 1fr); text-align: center; }
    .resource-menu summary > span { display: none; }
  }

  @media (max-width: 960px) {
    .mission-nav { display: none; }
  }

  @media (max-width: 520px) {
    .brand-mark { width: 32px; height: 32px; }
    .mobile-menu__heading { display: grid; gap: .2rem; }
    .mobile-menu__heading small { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-link,
    .resource-menu summary i::before,
    .resource-menu summary i::after { transition: none; }
  }
</style>

<style is:global>
/* Research experience v3
   Keeps process diagrams semantic and readable on narrow screens. Connectors are
   rendered as CSS structure rather than text arrows, and long pipelines preserve
   their horizontal meaning through touch scrolling. */

.mission-chain li:not(:last-child)::after {
  content: '' !important;
  top: 50% !important;
  right: -.55rem !important;
  bottom: auto !important;
  width: .55rem !important;
  height: 2px !important;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 62%, var(--line));
  transform: translateY(-50%) !important;
}

.mission-chain li:not(:last-child) > a::after {
  content: '';
  position: absolute;
  z-index: 3;
  top: 50%;
  right: -.37rem;
  width: 6px;
  height: 6px;
  border: 1.5px solid var(--accent);
  border-radius: 50%;
  background: var(--surface);
  transform: translateY(-50%);
}

.intent-row > span[aria-hidden='true'] {
  position: relative;
  display: block;
  width: 28px;
  height: 14px;
  overflow: hidden;
  color: transparent;
  font-size: 0;
}

.intent-row > span[aria-hidden='true']::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 22px;
  height: 1.5px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 58%, var(--line));
  transform: translateY(-50%);
}

.intent-row > span[aria-hidden='true']::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  width: 6px;
  height: 6px;
  border: 1.5px solid var(--accent);
  border-radius: 50%;
  background: var(--surface);
  transform: translateY(-50%);
}

@media (max-width: 1020px) {
  .mission-chain {
    overflow: hidden;
  }

  .mission-chain figcaption::after {
    display: block;
    width: fit-content;
    margin-top: .65rem;
    padding: .3rem .55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    content: 'Swipe horizontally to inspect all experiment steps';
    font-size: .64rem;
    font-weight: 700;
  }

  html[lang='zh-CN'] .mission-chain figcaption::after {
    content: '横向滑动查看完整实验步骤';
  }

  .mission-chain ol {
    display: grid !important;
    grid-template-columns: none !important;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, min(76vw, 300px));
    gap: .65rem !important;
    margin-inline: -.15rem !important;
    padding: .15rem .15rem .9rem !important;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: .15rem;
    scroll-snap-type: inline mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .mission-chain li {
    scroll-snap-align: start;
  }

  .mission-chain li a {
    min-height: 176px !important;
  }

  .mission-chain li:not(:last-child)::after {
    top: 50% !important;
    right: -.65rem !important;
    bottom: auto !important;
    width: .65rem !important;
    height: 2px !important;
    transform: translateY(-50%) !important;
  }

  .mission-chain li:not(:last-child) > a::after {
    right: -.44rem;
  }
}

