---
import { getMessages, localePath, switchLocalePath, parsePath, type Locale } from '../i18n';
import { CommandMenu } from './navigation/CommandMenu.tsx';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = getMessages(locale);
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const otherLocale: Locale = zh ? 'en' : 'zh';
const { pathNoBase } = parsePath(Astro.url.pathname);
const starts = (path: string) => pathNoBase === path || pathNoBase.startsWith(path.endsWith('/') ? path : `${path}/`);

const journeyLinks = [
  {
    id: 'flow',
    path: '/research/seed-openevo/',
    label: t('流程理解图', 'Flow map'),
    meta: 'OpenEvo · SEED · ALFWorld · WebShop',
    active: starts('/research/seed-openevo/') && !starts('/research/seed-openevo/experiment/') && !starts('/research/seed-openevo/results/'),
  },
  {
    id: 'study',
    path: '/research/seed-openevo/experiment/',
    label: t('OpenEvo × WebShop 科学研究', 'OpenEvo × WebShop study'),
    meta: t('实验 · 复现 · 结论 · 下一步', 'experiments · reproduce · findings · next'),
    active: starts('/research/seed-openevo/experiment/') || starts('/research/seed-openevo/results/') || starts('/guide/openevo-webshop-alfworld/'),
  },
].map((link) => ({
  ...link,
  href: localePath(locale, link.path),
  current: pathNoBase === link.path,
}));

const utilityLinks = [
  { path: '/models/', label: m.nav.models, description: t('具体模型、checkpoint、权重和运行条件', 'Concrete models, checkpoints, weights, and runtime conditions') },
  { path: '/papers/', label: m.nav.papers, description: t('论文方法、模型角色、训练条件和来源', 'Paper methods, model roles, training conditions, and sources') },
  { path: '/compare/', label: t('比较模型', 'Compare models'), description: t('并排检查会改变实验公平性的模型差异', 'Inspect model differences that can change experimental fairness') },
  { path: '/workspace/', label: t('实验工作台', 'Experiment workspace'), description: t('保存模型、GPU、网络和训练条件', 'Save model, GPU, network, and training settings') },
  { path: '/data-status/', label: m.nav.dataStatus, description: t('数据更新、目录核验、未知字段与证据状态', 'Dataset updates, catalog checks, unknown fields, and evidence status') },
  { path: '/methodology/', label: t('方法与边界', 'Methodology'), description: t('事实来源、证据等级和比较边界', 'Sources, evidence levels, and comparison boundaries') },
].map((link) => ({
  ...link,
  href: localePath(locale, link.path),
  active: starts(link.path),
}));

const switchHref = switchLocalePath(otherLocale, pathNoBase);
---
<header class="site-header" data-site-header>
  <div class="shell nav-inner">
    <a class="brand" href={localePath(locale, '/')} aria-label={m.site.backHome}>
      <span class="brand-mark" aria-hidden="true">BM</span>
      <span>
        <strong>{m.site.name}</strong>
        <small>{t('查看 Agent 实验里的模型、论文和复现步骤', 'Models, papers, and reproduction steps for agent experiments')}</small>
      </span>
    </a>

    <nav aria-label={m.nav.mainNav} class="desktop-nav mission-nav">
      <div class="journey-nav" aria-label={t('两条研究主线', 'Two primary research paths')}>
        {journeyLinks.map((link, index) => (
          <a class="journey-link" href={link.href} aria-current={link.current ? 'page' : undefined} data-active={link.active ? 'true' : undefined} data-journey={link.id}>
            <span class="journey-link__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="journey-link__copy"><strong>{link.label}</strong><small>{link.meta}</small></span>
          </a>
        ))}
      </div>

      <details class="resource-menu" data-resource-menu>
        <summary aria-label={t('打开资料入口', 'Open resource destinations')}>
          <span>{t('资料', 'Resources')}</span>
          <i aria-hidden="true"></i>
        </summary>
        <div class="resource-menu__panel">
          <div class="resource-menu__intro">
            <small>{t('实验资料', 'Research resources')}</small>
            <strong>{t('模型、论文、比较工具、实验工作台与证据状态', 'Models, papers, comparison tools, experiment workspace, and evidence status')}</strong>
          </div>
          <div class="resource-menu__links">
            {utilityLinks.map((link) => (
              <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                <strong>{link.label}</strong>
                <span>{link.description}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
    </nav>

    <CommandMenu client:load locale={locale} m={m} />
    <a class="lang-switch" href={switchHref} aria-label={m.nav.switchLangLabel} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{m.nav.switchLang}</a>
    <button class="menu-toggle" type="button" aria-label={m.nav.openMenu} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <button class="theme-toggle" type="button" aria-label={m.nav.toggleTheme} title={m.nav.toggleTheme} aria-pressed="false" data-theme-toggle data-dark-label={m.nav.toggleLightTheme} data-light-label={m.nav.toggleDarkTheme}>◐</button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="shell mobile-menu__inner">
      <section class="mobile-menu__section" aria-labelledby="mobile-journeys-title">
        <div class="mobile-menu__heading">
          <span id="mobile-journeys-title">{t('两条研究主线', 'Two primary research paths')}</span>
          <small>{t('先选你现在要完成的事', 'Start with what you need to accomplish')}</small>
        </div>
        <nav class="mobile-journeys" aria-label={t('主要操作', 'Main actions')}>
          {journeyLinks.map((link, index) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined} data-active={link.active ? 'true' : undefined}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{link.label}</strong><small>{link.meta}</small></div>
            </a>
          ))}
        </nav>
      </section>

      <section class="mobile-menu__section mobile-menu__utilities" aria-labelledby="mobile-tools-title">
        <div class="mobile-menu__heading">
          <span id="mobile-tools-title">{t('资料', 'Resources')}</span>
          <small>{t('模型、论文、比较、实验与证据', 'Models, papers, comparison, experiments, and evidence')}</small>
        </div>
        <nav class="mobile-utility-links" aria-label={t('资料', 'Resources')}>
          {utilityLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
        </nav>
      </section>

      <div class="mobile-menu__controls">
        <a class="lang-switch" href={switchHref} aria-label={m.nav.switchLangLabel} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{m.nav.switchLang}</a>
        <button class="theme-toggle" type="button" aria-label={m.nav.toggleTheme} title={m.nav.toggleTheme} aria-pressed="false" data-theme-toggle-mobile data-dark-label={m.nav.toggleLightTheme} data-light-label={m.nav.toggleDarkTheme}>◐</button>
      </div>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const resourceMenu = document.querySelector<HTMLDetailsElement>('[data-resource-menu]');

  const setMobileMenu = (open: boolean, restoreFocus = false) => {
    mobileMenu?.classList.toggle('is-open', open);
    mobileMenu?.setAttribute('aria-hidden', String(!open));
    menuToggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('mobile-nav-open', open);
    if (open) {
      requestAnimationFrame(() => mobileMenu?.querySelector<HTMLElement>('a')?.focus());
    } else if (restoreFocus) {
      menuToggle?.focus();
    }
  };

  menuToggle?.addEventListener('click', () => {
    setMobileMenu(!mobileMenu?.classList.contains('is-open'));
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobileMenu(false)));
  document.addEventListener('click', (event) => {
    if (!resourceMenu?.open || resourceMenu.contains(event.target as Node)) return;
    resourceMenu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (resourceMenu?.open) {
      const shouldRestore = resourceMenu.contains(document.activeElement);
      resourceMenu.open = false;
      if (shouldRestore) resourceMenu.querySelector<HTMLElement>('summary')?.focus();
    }
    if (mobileMenu?.classList.contains('is-open')) setMobileMenu(false, true);
  });

  const themeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle], [data-theme-toggle-mobile]'));
  const syncThemeButtons = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(dark));
      button.setAttribute('aria-label', dark ? button.dataset.darkLabel ?? '' : button.dataset.lightLabel ?? '');
      button.setAttribute('title', dark ? button.dataset.darkLabel ?? '' : button.dataset.lightLabel ?? '');
      button.textContent = dark ? '☀' : '◐';
    });
  };
  themeButtons.forEach((button) => {
    if (button.dataset.themeBound === 'true') return;
    button.dataset.themeBound = 'true';
    button.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.documentElement.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('atlas-theme', dark ? 'light' : 'dark'); } catch {}
      syncThemeButtons();
      window.dispatchEvent(new CustomEvent('atlas:themechange', { detail: { theme: dark ? 'light' : 'dark' } }));
    });
  });
  syncThemeButtons();
</script>

<style>
  .site-header{position:sticky;top:0;z-index:1000;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(18px)}
  .nav-inner{min-height:76px;display:flex;align-items:center;gap:1rem}.brand{display:flex;align-items:center;gap:.7rem;color:inherit;text-decoration:none;flex:0 0 auto}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--line);border-radius:11px;background:var(--surface-muted);font:900 .72rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.brand>span:last-child{display:flex;flex-direction:column}.brand strong{font-size:.86rem}.brand small{max-width:230px;color:var(--muted);font-size:.62rem;line-height:1.25}.mission-nav{display:flex;align-items:center;gap:.55rem;margin-left:auto}.journey-nav{display:flex;gap:.45rem}.journey-link{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:.5rem;min-width:176px;padding:.55rem .65rem;border:1px solid var(--line);border-radius:12px;color:inherit;text-decoration:none;background:var(--surface)}.journey-link[data-active=true]{border-color:color-mix(in srgb,var(--accent-deep) 50%,var(--line));background:color-mix(in srgb,var(--accent-deep) 6%,var(--surface))}.journey-link__index{color:var(--accent-deep);font:800 .61rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.journey-link__copy{display:flex;flex-direction:column;min-width:0}.journey-link__copy strong{font-size:.71rem;line-height:1.2}.journey-link__copy small{margin-top:.15rem;color:var(--muted);font-size:.55rem;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.resource-menu{position:relative}.resource-menu summary{display:flex;align-items:center;gap:.4rem;padding:.55rem .65rem;cursor:pointer;border:1px solid var(--line);border-radius:10px;background:var(--surface);font-size:.7rem;font-weight:750;list-style:none}.resource-menu summary::-webkit-details-marker{display:none}.resource-menu summary i{width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px)}.resource-menu[open] summary i{transform:rotate(225deg) translate(-1px,-1px)}.resource-menu__panel{position:absolute;right:0;top:calc(100% + .6rem);width:min(620px,90vw);padding:.8rem;border:1px solid var(--line);border-radius:15px;background:var(--surface);box-shadow:0 22px 60px color-mix(in srgb,#000 14%,transparent)}.resource-menu__intro{padding:.35rem .4rem .75rem}.resource-menu__intro small,.resource-menu__intro strong{display:block}.resource-menu__intro small{color:var(--accent-deep);font-size:.61rem;font-weight:800}.resource-menu__intro strong{margin-top:.25rem;font-size:.78rem}.resource-menu__links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}.resource-menu__links a{padding:.7rem;border:1px solid var(--line);border-radius:10px;color:inherit;text-decoration:none}.resource-menu__links a:hover,.resource-menu__links a:focus-visible,.resource-menu__links a[aria-current=page]{border-color:var(--accent-deep)}.resource-menu__links strong,.resource-menu__links span{display:block}.resource-menu__links strong{font-size:.72rem}.resource-menu__links span{margin-top:.2rem;color:var(--muted);font-size:.6rem;line-height:1.4}.command-search-trigger{flex:0 0 auto}.lang-switch,.theme-toggle,.menu-toggle{flex:0 0 auto}.lang-switch{color:inherit;font-size:.68rem;text-decoration:none}.theme-toggle,.menu-toggle{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:9px}.theme-toggle{width:34px;height:34px}.menu-toggle{display:none;width:38px;height:34px;padding:8px}.menu-toggle span{display:block;height:1px;background:currentColor;margin:4px 0}.mobile-menu{display:none}
  @media(max-width:1180px){.journey-link{min-width:154px}.journey-link__copy small{display:none}.brand small{display:none}}
  @media(max-width:960px){.desktop-nav{display:none}.menu-toggle{display:block;margin-left:auto}.command-search-trigger{margin-left:0}.mobile-menu{display:block;position:fixed;inset:77px 0 auto;max-height:calc(100vh - 77px);overflow:auto;border-bottom:1px solid var(--line);background:var(--surface);transform:translateY(-120%);opacity:0;pointer-events:none;transition:transform .2s ease,opacity .2s ease}.mobile-menu.is-open{transform:translateY(0);opacity:1;pointer-events:auto}.mobile-menu__inner{padding-block:1rem 1.4rem}.mobile-menu__section+.mobile-menu__section{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line)}.mobile-menu__heading{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:.55rem}.mobile-menu__heading span{font-size:.7rem;font-weight:800}.mobile-menu__heading small{color:var(--muted);font-size:.6rem}.mobile-journeys{display:grid;gap:.45rem}.mobile-journeys a{display:grid;grid-template-columns:auto 1fr;gap:.65rem;padding:.75rem;border:1px solid var(--line);border-radius:11px;color:inherit;text-decoration:none}.mobile-journeys a[data-active=true]{border-color:var(--accent-deep)}.mobile-journeys>a>span{color:var(--accent-deep);font:800 .65rem ui-monospace,SFMono-Regular,Menlo,monospace}.mobile-journeys strong,.mobile-journeys small{display:block}.mobile-journeys strong{font-size:.78rem}.mobile-journeys small{margin-top:.2rem;color:var(--muted);font-size:.62rem}.mobile-utility-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem}.mobile-utility-links a{padding:.65rem;border:1px solid var(--line);border-radius:9px;color:inherit;text-align:center;text-decoration:none;font-size:.68rem}.mobile-menu__controls{display:flex;gap:.65rem;align-items:center;margin-top:1rem}.mobile-menu__controls .lang-switch{padding:.45rem .6rem;border:1px solid var(--line);border-radius:8px}.mobile-nav-open{overflow:hidden}}
  @media(max-width:620px){.nav-inner{min-height:68px}.mobile-menu{inset:69px 0 auto;max-height:calc(100vh - 69px)}.brand strong{font-size:.8rem}.brand-mark{width:34px;height:34px}.command-search-trigger{display:none}.mobile-utility-links{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
