---
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const profileUrl = 'https://mykcs.github.io/fuhuo_20260419/shared/personal-compute-profile.js';
const sourceUrl = 'https://github.com/mykcs/fuhuo_20260419/blob/main/public/shared/personal-compute-profile.js';
const ownerPage = 'https://mykcs.github.io/fuhuo_20260419/docs/machines/';
const rootId = `personal-compute-profile-${locale}`;
---

<section id={rootId} class="compute-profile" data-compute-profile data-locale={locale} data-profile-url={profileUrl} aria-labelledby={`${rootId}-title`}>
  <header class="profile-hero">
    <p class="section-kicker">{t('真实实验环境 · 由复活仓库统一维护', 'Real lab environment · owned by the fuhuo repository')}</p>
    <h1 id={`${rootId}-title`}>{t('我的设备、4×3090 和连接方式', 'My devices, 4×3090 lab, and connection paths')}</h1>
    <p>{t('这页不保存第二份设备清单。它在浏览器里读取复活仓库发布的共享档案，再按 Base Model 的研究工作流重新组织：控制端、网络路径、离线算力、连接观察和复现实验入口。','This page does not keep a second device inventory. It loads the shared profile published by the fuhuo repository, then presents it in the Base Model research workflow: control devices, network path, offline compute, connection observations, and reproduction entry points.')}</p>
    <div class="profile-status-row"><span class="profile-status" data-profile-status>{t('正在读取共享设备档案…', 'Loading the shared compute profile…')}</span><a href={sourceUrl} target="_blank" rel="noreferrer">{t('查看唯一源文件', 'Open the canonical source')} ↗</a><a href={ownerPage} target="_blank" rel="noreferrer">{t('查看复活网站版本', 'Open the fuhuo presentation')} ↗</a></div>
  </header>

  <figure class="control-topology" aria-labelledby={`${rootId}-topology-title`}>
    <figcaption><p class="section-kicker">{t('控制拓扑', 'Control topology')}</p><h2 id={`${rootId}-topology-title`}>{t('移动端控制 Mac，Mac 再进入离线服务器', 'Mobile controls the Mac; the Mac reaches the offline server')}</h2><p>{t('推荐让 Mac 同时保留 Wi‑Fi 和物理网线。Wi‑Fi 负责 GitHub 与云端 Agent；网线只负责实验室私有网络。','Keep both Wi-Fi and physical Ethernet active on the Mac. Wi-Fi carries GitHub and cloud-agent traffic; Ethernet carries only the private lab network.')}</p></figcaption>
    <ol class="topology-route"><li><span>01</span><strong data-topology-mobile>{t('移动设备', 'Mobile devices')}</strong><small>{t('远程查看支持的桌面会话', 'Inspect supported desktop sessions')}</small></li><li><span>02</span><strong data-topology-mac>{t('开发与控制设备', 'Development and control device')}</strong><small>{t('Wi‑Fi + Ethernet 双网络', 'Dual network: Wi-Fi + Ethernet')}</small></li><li><span>03</span><strong data-topology-lab>{t('离线 GPU 服务器', 'Offline GPU server')}</strong><small>SSH / SFTP / rsync</small></li></ol>
  </figure>

  <section class="profile-section" aria-labelledby={`${rootId}-devices-title`}><div class="section-heading"><p class="section-kicker">{t('设备清单', 'Device inventory')}</p><h2 id={`${rootId}-devices-title`}>{t('每台设备负责什么', 'What each device is responsible for')}</h2></div><div class="profile-grid" data-device-list></div></section>
  <section class="profile-section" aria-labelledby={`${rootId}-connections-title`}><div class="section-heading"><p class="section-kicker">{t('推荐连接顺序', 'Recommended connection order')}</p><h2 id={`${rootId}-connections-title`}>{t('先保留公网，再接实验室网线', 'Keep Internet access first, then attach the lab Ethernet')}</h2></div><ol class="connection-steps" data-connection-list></ol></section>
  <section class="profile-section observation-section" aria-labelledby={`${rootId}-observations-title`}><div class="section-heading"><p class="section-kicker">{t('时效性观察', 'Time-sensitive observations')}</p><h2 id={`${rootId}-observations-title`}>{t('一次连接成功或失败，不等于永久产品结论', 'One success or failure is not a permanent product verdict')}</h2></div><div class="observation-grid" data-observation-list></div></section>
  <aside class="profile-boundary" data-profile-boundary><strong>{t('单一来源边界', 'Single-source boundary')}</strong><p>{t('设备事实只在 mykcs/fuhuo_20260419 中修改。Base Model 只保存消费者 URL、页面结构和视觉表达。共享端点不可用时，本页显示失败状态，不在本仓库伪造一份备用设备清单。','Device facts are edited only in mykcs/fuhuo_20260419. Base Model stores only the consumer URL, page structure, and visual presentation. If the shared endpoint is unavailable, this page shows that failure instead of inventing a duplicate fallback inventory.')}</p></aside>
  <noscript><p class="profile-error">{t('需要启用 JavaScript 才能读取共享设备档案。', 'JavaScript is required to load the shared compute profile.')}</p></noscript>
</section>

<script is:inline>
(() => {
  const root = document.currentScript?.previousElementSibling;
  if (!(root instanceof HTMLElement) || !root.matches('[data-compute-profile]')) return;
  const zh = root.dataset.locale === 'zh';
  const text = { loaded: zh ? '共享档案已读取' : 'Shared profile loaded', failed: zh ? '共享档案暂时无法读取' : 'Shared profile is currently unavailable', retry: zh ? '复活网站发布恢复后，本页会自动显示，不需要复制数据。' : 'This page will populate automatically when the fuhuo publication is restored; no data copy is needed.', tools: zh ? '工具 / 使用方式' : 'Tools / usage', paths: zh ? '连接' : 'Connections', observed: zh ? '用户观察' : 'User observation', inference: zh ? '解释 / 推断' : 'Interpretation / inference', retest: zh ? '下次复测' : 'Retest next time' };
  const status = root.querySelector('[data-profile-status]'); const deviceList = root.querySelector('[data-device-list]'); const connectionList = root.querySelector('[data-connection-list]'); const observationList = root.querySelector('[data-observation-list]');
  const node = (tag, className, value) => { const element = document.createElement(tag); if (className) element.className = className; if (value !== undefined) element.textContent = value; return element; };
  const render = (profile) => {
    status.textContent = `${text.loaded} · ${profile.updatedAt}`; status.dataset.state = 'ready';
    const mobile = profile.devices.filter((device) => device.id === 'iphone' || device.id === 'ipad').map((device) => device.name).join(' / '); const mac = profile.devices.find((device) => device.id === 'macbook-pro-m4');
    root.querySelector('[data-topology-mobile]').textContent = mobile; root.querySelector('[data-topology-mac]').textContent = `${mac.name} · ${mac.hardware}`; root.querySelector('[data-topology-lab]').textContent = `${profile.lab.gpus.count}×${profile.lab.gpus.model.replace('NVIDIA GeForce ', '')} · ${profile.lab.gpus.vramPerGpuGb}GB`;
    profile.devices.forEach((device) => { const card=node('article','profile-card'); card.append(node('small','profile-card-label',device.role),node('h3','',`${device.name} · ${device.hardware}`)); const tools=node('ul','profile-list'); device.tools.forEach((tool)=>{const li=node('li');li.append(node('span','',tool.name),node('small','',tool.status));tools.append(li);}); card.append(node('strong','profile-card-subtitle',text.tools),tools,node('strong','profile-card-subtitle',text.paths),node('p','profile-card-paths',device.connections.join(' · '))); deviceList.append(card); });
    [...profile.recommendedConnections].sort((a,b)=>a.priority-b.priority).forEach((item)=>{const row=node('li','connection-step');row.append(node('b','connection-step-number',String(item.priority).padStart(2,'0')));const body=node('div');body.append(node('h3','',item.name),node('p','',item.summary));const steps=node('ol','profile-list');item.steps.forEach((step)=>steps.append(node('li','',step)));body.append(steps);if(item.checks){const checks=node('div','connection-checks');item.checks.forEach((check)=>checks.append(node('code','',check)));body.append(checks);}row.append(body);connectionList.append(row);});
    profile.observations.forEach((item)=>{const card=node('article','observation-card');const meta=node('div','observation-meta');meta.append(node('span','',`${text.observed} · ${item.status}`),node('time','',item.recordedAt));card.append(meta,node('h3','',item.observation));const interpretation=node('p');interpretation.append(node('strong','',`${text.inference}：`),document.createTextNode(item.interpretation));card.append(interpretation,node('strong','profile-card-subtitle',text.retest));const list=node('ul','profile-list');item.retest.forEach((step)=>list.append(node('li','',step)));card.append(list);observationList.append(card);});
  };
  const fail = () => { status.textContent = text.failed; status.dataset.state = 'failed'; const error=node('p','profile-error',text.retry); root.querySelector('[data-profile-boundary]')?.before(error); };
  const existing = window.__MYKCS_PERSONAL_COMPUTE_PROFILE__; if (existing) { render(existing); return; }
  const script=document.createElement('script'); script.src=`${root.dataset.profileUrl}?ts=${Date.now()}`; script.referrerPolicy='no-referrer'; script.onload=()=>window.__MYKCS_PERSONAL_COMPUTE_PROFILE__?render(window.__MYKCS_PERSONAL_COMPUTE_PROFILE__):fail(); script.onerror=fail; document.head.append(script);
})();
</script>

<style>
.compute-profile{width:min(1120px,calc(100% - 32px));margin:0 auto;padding:54px 0 90px}.profile-hero{max-width:900px}.profile-hero h1{max-width:860px;margin:7px 0 13px;font-size:clamp(2rem,4vw,3.6rem);letter-spacing:-.035em}.profile-hero>p{max-width:850px;color:var(--muted);font-size:1.03rem;line-height:1.75}.profile-status-row{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:20px;font-size:.82rem}.profile-status{padding:7px 10px;border:1px solid var(--line);border-radius:999px;color:var(--muted)}.profile-status[data-state=ready]{border-color:var(--accent-deep);color:var(--accent-deep)}.profile-status[data-state=failed]{border-color:var(--danger,#a43a32);color:var(--danger,#a43a32)}.profile-status-row a{color:var(--accent-deep);font-weight:700;text-decoration:none}.control-topology{margin:42px 0 54px;padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--surface-muted)}.control-topology figcaption{max-width:780px}.control-topology h2{margin:5px 0 8px}.control-topology figcaption>p:not(.section-kicker){color:var(--muted)}.topology-route{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:22px 0 0;padding:0;list-style:none;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.topology-route li{position:relative;display:grid;gap:4px;padding:16px}.topology-route li+li{border-left:1px solid var(--line)}.topology-route li:not(:last-child)::after{content:'→';position:absolute;right:-8px;top:50%;z-index:2;transform:translateY(-50%);padding:2px;background:var(--surface-muted);color:var(--accent-deep)}.topology-route span{font-family:var(--font-mono,monospace);font-size:.7rem;color:var(--accent-deep)}.topology-route small{color:var(--muted)}.profile-section{padding:36px 0;border-top:1px solid var(--line)}.section-heading{max-width:760px}.section-heading h2{margin:5px 0}.profile-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:20px}.profile-card,.observation-card{padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.profile-card-label,.profile-card small{color:var(--muted)}.profile-card h3{margin:6px 0 16px}.profile-card-subtitle{display:block;margin-top:14px;font-size:.78rem}.profile-list{display:grid;gap:7px;margin:8px 0 0;padding-left:18px}.profile-list span,.profile-list small{display:block}.profile-list small{margin-top:2px}.profile-card-paths{color:var(--muted);font-size:.83rem;line-height:1.55}.connection-steps{margin:20px 0 0;padding:0;list-style:none;border-top:1px solid var(--line)}.connection-step{display:grid;grid-template-columns:52px minmax(0,1fr);gap:18px;padding:24px 0;border-bottom:1px solid var(--line)}.connection-step-number{font-family:var(--font-mono,monospace);color:var(--accent-deep)}.connection-step h3{margin:0 0 6px}.connection-step p{max-width:850px;color:var(--muted)}.connection-checks{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.connection-checks code{padding:5px 7px;border-radius:5px;background:var(--surface-muted);font-size:.72rem}.observation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:20px}.observation-meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:.7rem}.observation-card h3{margin:10px 0}.observation-card p{color:var(--muted);line-height:1.62}.profile-boundary{margin-top:34px;padding:18px;border-left:3px solid var(--accent-deep);background:var(--surface-muted)}.profile-boundary p{max-width:880px;margin:5px 0;color:var(--muted)}.profile-error{margin:18px 0;padding:12px 14px;border:1px solid var(--danger,#a43a32);border-radius:8px;color:var(--danger,#a43a32)}@media(max-width:780px){.topology-route,.profile-grid,.observation-grid{grid-template-columns:1fr}.topology-route li+li{border-left:0;border-top:1px solid var(--line)}.topology-route li:not(:last-child)::after{content:'↓';right:auto;left:22px;top:auto;bottom:-10px;transform:none}.connection-step{grid-template-columns:38px minmax(0,1fr)}}@media(max-width:520px){.compute-profile{padding-top:34px}.profile-hero h1{font-size:2.15rem}.profile-status-row{align-items:flex-start;flex-direction:column}.control-topology{padding:16px}}
</style>
