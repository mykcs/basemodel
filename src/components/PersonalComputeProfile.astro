---
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const rootId = `public-lab-topology-${locale}`;
---

<section id={rootId} class="lab-topology" data-public-lab-topology aria-labelledby={`${rootId}-title`}>
  <header class="lab-hero">
    <p class="section-kicker">{t('公开实验环境参考', 'Public lab reference')}</p>
    <h1 id={`${rootId}-title`}>{t('把控制端、访问边界和内部算力分开', 'Separate the control plane, access boundary, and internal compute')}</h1>
    <p>{t('这个公开页面只保留可复用的实验室心智模型，不发布个人设备清单、私有网络地址或登录信息。具体机器事实只应在科学复现确实需要时，以最小必要粒度公开。','This public page keeps only a reusable lab mental model. It does not publish personal device inventory, private network addresses, or login details. Machine-specific facts should be disclosed only at the minimum level required for scientific reproducibility.')}</p>
  </header>

  <figure class="topology" aria-labelledby={`${rootId}-topology-title`}>
    <figcaption>
      <p class="section-kicker">{t('通用拓扑', 'Generic topology')}</p>
      <h2 id={`${rootId}-topology-title`}>{t('公网控制端 → 获批访问边界 → 内部算力', 'Internet-connected workstation → approved access boundary → internal compute')}</h2>
      <p>{t('内部算力不应因为远程操作便利而直接暴露到公网。组织提供的 VPN、堡垒机或其他访问方式应按本地政策配置，凭据保留在 Git 之外。','Internal compute should not be exposed directly to the public Internet merely for convenience. Use organization-approved VPN, bastion, or other access methods according to local policy, with credentials kept outside Git.')}</p>
    </figcaption>
    <ol class="topology-route">
      <li><span>01</span><strong>{t('控制工作站', 'Control workstation')}</strong><small>{t('代码、文档、云端协作', 'Code, docs, cloud collaboration')}</small></li>
      <li><span>02</span><strong>{t('访问边界', 'Access boundary')}</strong><small>{t('仅使用获批的身份验证与网络路径', 'Approved authentication and network path only')}</small></li>
      <li><span>03</span><strong>{t('内部算力', 'Internal compute')}</strong><small>{t('训练、推理与实验数据', 'Training, inference, and experiment data')}</small></li>
    </ol>
  </figure>

  <section class="lab-section" aria-labelledby={`${rootId}-public-title`}>
    <p class="section-kicker">{t('公开什么', 'What belongs in public')}</p>
    <h2 id={`${rootId}-public-title`}>{t('公开复现需要的事实，不公开基础设施身份', 'Publish reproducibility facts, not infrastructure identity')}</h2>
    <div class="rule-grid">
      <article><h3>{t('可以公开', 'Safe to publish')}</h3><ul><li>{t('模型、数据集、随机种子和实验预算', 'Model, dataset, seeds, and experiment budget')}</li><li>{t('必要的 GPU 数量 / 显存等聚合约束', 'Necessary aggregate GPU / VRAM constraints')}</li><li>{t('不包含凭据的安装和运行命令', 'Credential-free setup and run commands')}</li></ul></article>
      <article><h3>{t('留在私有上下文', 'Keep private')}</h3><ul><li>{t('个人设备清单和跨仓库设备档案', 'Personal device inventory and cross-repository profiles')}</li><li>{t('IP、主机名、用户名、VPN 端点与访问 token', 'IP addresses, hostnames, usernames, VPN endpoints, and access tokens')}</li><li>{t('能定位或直接进入实验室网络的细节', 'Details that identify or directly expose the lab network')}</li></ul></article>
    </div>
  </section>

  <aside class="privacy-boundary"><strong>{t('公开边界', 'Public boundary')}</strong><p>{t('历史 PR 或旧提交里出现过更具体的个人实验环境，不代表这些信息应该继续进入公开源码。当前页面是公开发布后的最小披露标准。','Historical PRs or older commits may mention a more specific personal environment; that does not make those details appropriate for current public source. This page defines the minimum-disclosure standard for public release.')}</p></aside>
</section>

<style>
.lab-topology{width:min(1080px,calc(100% - 32px));margin:0 auto;padding:54px 0 90px}.lab-hero{max-width:850px}.lab-hero h1{margin:7px 0 13px;font-size:clamp(2rem,4vw,3.45rem);letter-spacing:-.035em}.lab-hero>p{color:var(--muted);font-size:1.03rem;line-height:1.75}.topology{margin:42px 0 54px;padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--surface-muted)}.topology figcaption{max-width:800px}.topology h2{margin:5px 0 8px}.topology figcaption>p:not(.section-kicker){color:var(--muted)}.topology-route{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:22px 0 0;padding:0;list-style:none;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.topology-route li{display:grid;gap:4px;padding:16px}.topology-route li+li{border-left:1px solid var(--line)}.topology-route span{font-family:var(--font-mono,monospace);font-size:.7rem;color:var(--accent-deep)}.topology-route small{color:var(--muted)}.lab-section{padding:36px 0;border-top:1px solid var(--line)}.lab-section h2{max-width:760px;margin:5px 0 18px}.rule-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.rule-grid article{padding:20px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.rule-grid h3{margin-top:0}.rule-grid ul{display:grid;gap:8px;padding-left:20px;color:var(--muted)}.privacy-boundary{margin-top:34px;padding:18px;border-left:3px solid var(--accent-deep);background:var(--surface-muted)}.privacy-boundary p{max-width:880px;margin:5px 0;color:var(--muted)}@media(max-width:720px){.topology-route,.rule-grid{grid-template-columns:1fr}.topology-route li+li{border-left:0;border-top:1px solid var(--line)}}
</style>
