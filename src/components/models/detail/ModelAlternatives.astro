---
import type { AtlasModel } from '../../../lib/types';
import { localePath, type Locale } from '../../../i18n';

interface Props { model: AtlasModel; models: AtlasModel[]; locale: Locale }
const { model, models, locale } = Astro.props;
const alternatives = models.filter((candidate) => candidate.id !== model.id && candidate.family === model.family).sort((a, b) => b.release_date.localeCompare(a.release_date)).slice(0, 6);
---
<section class="detail-section" id="alternatives"><h2>{locale === 'zh' ? '替换候选与同族版本' : 'Replacement candidates and family versions'}</h2><p class="muted">{locale === 'zh' ? '以下候选仅依据目录中的家族、代际和发布日期生成；不是综合评分，也不替代实验验证。' : 'Candidates are derived from catalog family, generation, and release metadata; this is not a quality score or a substitute for experiments.'}</p>{alternatives.length ? <div class="alternative-grid">{alternatives.map((candidate) => <article class="alternative-card"><a href={localePath(locale, `/models/${candidate.id}/`)}><strong>{candidate.name}</strong><span>{candidate.generation} · {candidate.release_date}</span><small>{candidate.checkpoint.type} · {candidate.data_status}</small></a><a class="text-link" href={localePath(locale, `/workspace/?v=2&mode=modern&model=${model.id}`)}>{locale === 'zh' ? '在替换分析中查看 →' : 'Open replacement analysis →'}</a></article>)}</div> : <p class="muted">{locale === 'zh' ? '当前目录没有可核验的同族替换候选。' : 'No verifiable same-family replacement is currently in the catalog.'}</p>}</section>
