---
import { displayUnknown, semanticStatusExplanation, semanticStatusLabel } from '../../lib/format';
import type { Locale } from '../../i18n';
import type { SemanticStatus } from '../../lib/schemas';

interface Props {
  value: boolean | SemanticStatus | string | number | null | undefined;
  locale?: Locale;
  class?: string;
}

const { value, locale = 'zh', class: className = '' } = Astro.props;
const semanticStates = new Set(['not_disclosed', 'not_applicable', 'not_reported', 'not_verified', 'conflicting_evidence', 'not_published', 'unavailable', 'unknown']);
const isSemantic = typeof value === 'string' && semanticStates.has(value);
const stateClass = typeof value === 'boolean' ? (value ? 'is-true' : 'is-false') : isSemantic ? 'is-unknown' : 'is-value';
const icon = value === true ? '✓' : value === false ? '✕' : isSemantic ? '?' : '·';
const label = isSemantic ? semanticStatusLabel(value as string, locale) : displayUnknown(value, '', locale);
const explanation = isSemantic ? semanticStatusExplanation(value as string, locale) : '';
---
<span class={`semantic-status ${stateClass} ${className}`.trim()} data-semantic-status={isSemantic ? value : undefined} title={explanation || undefined} aria-label={explanation ? `${label}. ${explanation}` : label}>
  <span class="semantic-status-icon" aria-hidden="true">{icon}</span>
  <span>{label}</span>
  {explanation && <span class="sr-only">{explanation}</span>}
</span>
