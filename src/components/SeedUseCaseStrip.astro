---
import { localePath, type Locale } from '../i18n';
import { aiGalaxySeedSnapshot as market } from '../data/aiGalaxySeedSnapshot';

type Area = 'home' | 'models' | 'families' | 'compare' | 'papers' | 'workspace' | 'data-status' | 'methodology' | 'landscape';
interface Props { locale: Locale; area: Area; standalone?: boolean }
const { locale, area, standalone = false } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const zh: Record<Area, { title: string; body: string }> = {
  home: { title: '用 OpenEvo 复现 SEED 的两个实验', body: '先在现有 4×RTX 3090 服务器上跑通 ALFWorld 与 WebShop，保存训练、评测和对照结果。只有显存或时间被真机数据证明不足时，再评估 8×A800 / A100。' },
  models: { title: '确认 checkpoint 能否运行 SEED 实验', body: '原实验使用 Qwen2.5-3B-Instruct。需要替换模型时，逐项比较权重、训练支持、运行时、显存和实验可比性。' },
  families: { title: '需要换模型时，再从家族页找候选', body: 'SEED 原实验继续使用论文中的 checkpoint。只有新实验明确要换模型时，才按家族和代际寻找替代版本。' },
  compare: { title: '比较会影响实验结果的差异', body: '逐项查看模型、checkpoint、权重访问、RL 路径、上下文和硬件差异，并说明每项差异是否破坏公平比较。' },
  papers: { title: '确认 SEED 使用的模型、环境和训练设置', body: '在论文页核对 Qwen2.5-3B-Instruct、ALFWorld、WebShop、训练阶段、模型角色和论文硬件，再把这些条件写进执行记录。' },
  workspace: { title: '填写实际 GPU、网络、权重和训练条件', body: '工作台按你真实拥有的资源筛选方案。本项目示例是 4×24GB、离线运行和本地权重；需要迁移时再记录 8 卡配置。' },
  'data-status': { title: '确认数字来自论文、市场目录还是真机运行', body: '论文条件、云 GPU 目录、工程估算和真机结果分开保存。会变化的价格与库存带核验日期，运行结果带机器和日志记录。' },
  methodology: { title: '查看每个数字和判断的来源', body: '论文事实、市场目录、工程估算和真机测量使用不同标记。缺少来源的字段保持未知，不补成看似合理的数值。' },
  landscape: { title: '需要替换模型时，再从图表中找候选', body: '图表用于比较发布时间、参数规模、架构和硬件门槛。它不会自动替换 SEED 原实验使用的 checkpoint。' },
};
const en: Record<Area, { title: string; body: string }> = {
  home: { title: 'Reproduce both SEED experiments with OpenEvo', body: 'First run ALFWorld and WebShop on the available 4×RTX 3090 server and save training, evaluation, and control results. Consider 8×A800/A100 only when measurements show that memory or time is insufficient.' },
  models: { title: 'Confirm that a checkpoint can run the SEED experiment', body: 'The original experiment uses Qwen2.5-3B-Instruct. When replacing it, compare weight access, training support, runtime, memory, and experimental comparability field by field.' },
  families: { title: 'Use model families only when the experiment needs a replacement', body: 'Keep the paper checkpoint for the original SEED experiment. Search by family and generation only when a new experiment explicitly changes the model.' },
  compare: { title: 'Compare differences that can change the experiment', body: 'Inspect model, checkpoint, weight access, RL path, context, and hardware differences, then state whether each one breaks a fair comparison.' },
  papers: { title: 'Confirm the model, environments, and training settings used by SEED', body: 'Verify Qwen2.5-3B-Instruct, ALFWorld, WebShop, training stages, model roles, and paper hardware, then copy those settings into the run record.' },
  workspace: { title: 'Enter the GPU, network, weights, and training setup you actually have', body: 'The workspace filters plans using your real resources. This project uses 4×24GB, offline execution, and local weights as its example; record eight GPUs only when migration is needed.' },
  'data-status': { title: 'Check whether a number comes from the paper, a market catalog, or a measured run', body: 'Paper conditions, cloud-GPU catalogs, engineering estimates, and measured results stay separate. Prices and inventory carry check dates; runs carry machine and log records.' },
  methodology: { title: 'See where each number and judgment comes from', body: 'Paper facts, market catalogs, engineering estimates, and measurements use different labels. Fields without sources remain unknown instead of receiving plausible-looking values.' },
  landscape: { title: 'Use the chart to find candidates only when the model must change', body: 'The chart compares release time, parameter scale, architecture, and hardware threshold. It does not automatically replace the checkpoint used by the SEED experiment.' },
};
const copy = (isZh ? zh : en)[area];
const guideHref = `${localePath(locale, '/guide/')}#seed-reproduction`;
const paperHref = localePath(locale, '/papers/seed/');
const workspaceHref = `${localePath(locale, '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&gpu=24&gpus=4&runtime=verl&open=1`;
---
<section class:list={['seed-use-case', { standalone }]} aria-label={t('SEED 与 OpenEvo 实验步骤', 'SEED and OpenEvo experiment steps')}>
  <div class="head"><div><span class="section-kicker">{standalone ? t('这页能帮你做什么', 'What this page helps you do') : t('实验步骤', 'Experiment steps')}</span><h2>{copy.title}</h2><p>{copy.body}</p></div><a class="button button-primary" href={guideHref}>{t('查看实验步骤', 'View experiment steps')}</a></div>
  {standalone ? (
    <div class="compact"><span><strong>{t('本项目实例', 'Project example')}</strong> · 4×3090 → ALFWorld → WebShop → SFT → RL → GRPO</span><a href={workspaceHref}>{t('把实验条件记进工作台', 'Record the experiment setup in Workspace')} →</a></div>
  ) : (
    <div class="detail">
      <ol><li><b>01</b><span><strong>{t('用现有 GPU 先跑小测试', 'Run a small test on the available GPU')}</strong><small>4×RTX 3090 24GB</small></span></li><li><b>02</b><span><strong>{t('跑通 ALFWorld 与 WebShop', 'Bring up ALFWorld and WebShop')}</strong><small>{t('真实 observation / action / score', 'real observation / action / score')}</small></span></li><li><b>03</b><span><strong>{t('运行训练和对照', 'Run training and controls')}</strong><small>SFT → SEED RL → GRPO</small></span></li><li><b>04</b><span><strong>{t('显存或时间不足时才迁移', 'Migrate only when memory or time is insufficient')}</strong><small>{t('用真机数据决定是否使用 8 卡', 'Use measurements to decide on eight GPUs')}</small></span></li></ol>
      <aside><strong>{t('云端备用方案', 'Cloud fallback')}</strong><p>{t(`公开算力快照：${market.checkedAtZh}。只有四卡被真机显存或耗时数据证明不足时，再核对 A800/A100 的实际库存和价格。`, `Public compute snapshot: ${market.checkedAtEn}. Re-check A800/A100 inventory and prices only when measured memory or runtime shows that four GPUs are insufficient.`)}</p><small>{isZh ? market.evidenceBoundary.zh : market.evidenceBoundary.en}</small></aside>
      <div class="links"><a href={paperHref}>{t('核对 SEED 论文设置', 'Check the SEED paper settings')} →</a><a href="https://gpu.ai-galaxy.com/store" target="_blank" rel="noreferrer">{t('需要迁移时查看算力目录', 'Open the compute catalog when migration is needed')} ↗</a></div>
    </div>
  )}
</section>
<style>
.seed-use-case{margin:28px 0 34px;padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.seed-use-case.standalone{width:min(1180px,calc(100% - 32px));margin:10px auto 0;padding:12px 0 14px;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent}.head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px;align-items:end}.head h2{margin:6px 0 8px;max-width:820px;font-size:clamp(1.08rem,2vw,1.55rem)}.head p{max-width:840px;margin:0;color:var(--muted);line-height:1.6}.standalone .head h2{font-size:1.08rem}.standalone .head p{font-size:.82rem}.compact{display:flex;justify-content:space-between;gap:18px;margin-top:9px;padding-top:8px;border-top:1px solid var(--line);color:var(--muted);font-size:.76rem}.compact a,.links a{color:var(--accent-deep);font-weight:700;text-decoration:none}.detail>ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:20px 0 0;padding:0;list-style:none}.detail li{display:flex;gap:9px;padding:12px;border:1px solid var(--line);border-radius:9px}.detail li>b{color:var(--accent-deep);font-size:.72rem}.detail strong,.detail small{display:block}.detail small{margin-top:2px;color:var(--muted)}.detail aside{margin-top:14px;padding:14px 16px;border-left:3px solid var(--accent);background:var(--surface-muted)}.detail aside p{margin:4px 0}.detail aside small{color:var(--muted)}.links{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px;font-size:.84rem}@media(max-width:760px){.head{grid-template-columns:1fr}.detail>ol{grid-template-columns:repeat(2,minmax(0,1fr))}.compact{flex-direction:column;gap:5px}}@media(max-width:520px){.detail>ol{grid-template-columns:1fr}}
</style>
