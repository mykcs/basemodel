---
import { localePath, type Locale } from '../i18n';
import { aiGalaxySeedSnapshot as market } from '../data/aiGalaxySeedSnapshot';

type Area = 'home' | 'models' | 'families' | 'compare' | 'papers' | 'workspace' | 'data-status' | 'methodology' | 'landscape';

interface Props {
  locale: Locale;
  area: Area;
  standalone?: boolean;
}

const { locale, area, standalone = false } = Astro.props;
const isZh = locale === 'zh';

const zhCopy: Record<Area, { title: string; body: string }> = {
  home: {
    title: '先固定目标：复现 SEED，再使用网站里的其他功能',
    body: '不要先逛模型排行榜，也不要先租最贵的 GPU。先问清楚要证明什么：跑通方法，还是严格对齐论文。这个站接下来的模型、环境、算力与证据功能，都围绕这一个问题展开。',
  },
  models: {
    title: '模型页解决的是：SEED 到底该用哪个 checkpoint？',
    body: '严格复现先锁定论文使用的 Qwen2.5-3B-Instruct；换成更新模型是在做现代化重跑，不再是同一个实验。这里优先看 checkpoint、开放权重、RL 支持与硬件条件，而不是综合排行榜。',
  },
  families: {
    title: '家族页解决的是：为什么不直接换成更新一代？',
    body: 'Qwen 新一代可能更强，但“更强”不是严格复现的目标。先看论文所在代际，再决定是保持原 checkpoint，还是明确把研究问题改成“SEED 在新一代模型上是否仍成立”。',
  },
  compare: {
    title: '对比页只比较会改变复现结论的变量',
    body: '复现 SEED 时，真正需要比较的是 checkpoint、权重可得性、微调/RL 能力、veRL 运行路径和硬件档位。与当前实验无关的榜单差异先忽略。',
  },
  papers: {
    title: '论文页先把“方法、环境、算力”钉死',
    body: '以 SEED 为例：论文事实是 ALFWorld / WebShop、Qwen checkpoint、训练阶段和 8×A800 80G。接下来必须再看今天的算力市场是否真的提供这些条件，而不是看到“80G”就自动当成同一张卡。',
  },
  workspace: {
    title: '工作台把论文事实变成一份现实可执行的实验清单',
    body: '先选“方法验证”或“严格复现”，再固定模型、RL、运行时与 GPU。当前智星云公开目录没有 A800 80G×8，因此严格复现和 A100 替代必须作为两条不同路径记录。',
  },
  'data-status': {
    title: '数据状态页解决的是：哪些是事实，哪些会过期？',
    body: '模型论文是相对稳定事实；云平台卡型、价格和可用性是时效信息。算力结论必须带核验时间，并区分“公开产品目录”和“登录后的实时库存”。',
  },
  methodology: {
    title: '方法页负责把“论文事实、市场事实、工程建议”分开',
    body: '“8×A800 80G”是论文事实；“智星云当前公开最接近的是 A100 80G NVLINK×8”是带时间戳的市场事实；“先用 4090 跑环境、再用单张 A100 80G 做缩小训练”是工程建议。三者不能混写。',
  },
  landscape: {
    title: '模型空间不是排行榜，而是替代方案地图',
    body: '只有当你的目标从严格复现切换为方法复现或现代化重跑时，才应该在这里找替代模型。硬件也是同样逻辑：A100 可以是替代，但不能被重新命名成 A800。',
  },
};

const enCopy: Record<Area, { title: string; body: string }> = {
  home: {
    title: 'Fix the goal first: reproduce SEED, then use the rest of the site',
    body: 'Do not start from a leaderboard or the most expensive GPU. Decide what you need to prove: a method smoke test or a paper-aligned reproduction. Models, environments, compute, and evidence all serve that one question.',
  },
  models: {
    title: 'The model page answers: which checkpoint does SEED actually require?',
    body: 'Strict reproduction starts from Qwen2.5-3B-Instruct as used by the paper. Replacing it with a newer model changes the experiment into a modern rerun. Focus on checkpoint, weights, RL support, and hardware before generic rankings.',
  },
  families: {
    title: 'The family page answers: why not simply use the newest generation?',
    body: 'A newer Qwen generation may be stronger, but strict reproduction is not a strength contest. Keep the original checkpoint first; only switch generations when the research question explicitly becomes “does SEED transfer to a newer model?”',
  },
  compare: {
    title: 'Compare only variables that can change the reproduction claim',
    body: 'For SEED, compare checkpoint identity, weight access, fine-tuning/RL support, veRL runtime paths, and hardware requirements. Ignore leaderboard differences that do not answer the experiment you are running.',
  },
  papers: {
    title: 'Pin method, environment, and compute before implementation',
    body: 'For SEED, the paper fixes ALFWorld / WebShop, the Qwen checkpoint, training stages, and 8×A800 80G. The next step is checking whether today’s compute market actually offers those conditions—not treating every “80G” GPU as equivalent.',
  },
  workspace: {
    title: 'The workspace turns paper facts into a realistically executable manifest',
    body: 'Choose method reproduction or strict reproduction first, then pin model, RL, runtime, and GPUs. AI Galaxy’s current public catalog does not list 8×A800 80G, so exact reproduction and A100 substitution must remain distinct paths.',
  },
  'data-status': {
    title: 'Data status answers: what is stable, and what expires?',
    body: 'Paper facts are relatively stable; cloud GPU models, prices, and availability are time-sensitive. Compute claims need a checked-at timestamp and must distinguish public catalog listings from live post-login inventory.',
  },
  methodology: {
    title: 'Methodology separates paper facts, market facts, and engineering advice',
    body: '“8×A800 80G” is a paper fact; “AI Galaxy’s closest current public option is A100 80G NVLINK×8” is a timestamped market fact; “use 4090 for environment bring-up, then one A100 80G for reduced training” is engineering advice. Do not merge them.',
  },
  landscape: {
    title: 'The model space is a replacement map, not a leaderboard',
    body: 'Look for alternatives only after the goal changes from strict reproduction to method reproduction or a modern rerun. Hardware follows the same rule: A100 can be a substitute, but it cannot be renamed A800.',
  },
};

const copy = (isZh ? zhCopy : enCopy)[area];
const paperHref = localePath(locale, '/papers/seed/');
const guideHref = `${localePath(locale, '/guide/')}#seed-reproduction`;
const strictWorkspaceHref = `${localePath(locale, '/workspace/')}?v=2&mode=strict&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&gpu=80&gpus=8&runtime=verl&open=1`;
---

<section class:list={['seed-use-case', { 'seed-use-case-standalone': standalone }]} aria-label={isZh ? 'SEED 复现实战主线' : 'SEED reproduction mainline'}>
  <div class="seed-use-case-head">
    <div>
      <span class="section-kicker">{standalone ? (isZh ? 'SEED 复现上下文' : 'SEED reproduction context') : (isZh ? 'SEED 实战' : 'SEED worked example')}</span>
      <h2>{copy.title}</h2>
      <p>{copy.body}</p>
    </div>
    <div class="seed-use-case-actions">
      <a class="button button-primary" href={guideHref}>{isZh ? '完整复现路线' : 'Full reproduction route'}</a>
      {!standalone && <a class="button button-secondary" href={paperHref}>{isZh ? '打开 SEED 论文页' : 'Open SEED paper'}</a>}
    </div>
  </div>

  {standalone && (
    <div class="seed-use-case-compact">
      <span>{isZh ? '当前主线：目标 → 环境 → 算力 → 验证' : 'Current thread: goal → environment → compute → validation'}</span>
      <a href={strictWorkspaceHref}>{isZh ? '预填严格复现工作台' : 'Prefill strict workspace'} →</a>
    </div>
  )}

  {!standalone && (
    <div class="seed-use-case-detail">
      <ol class="seed-mainline">
        <li><span>01</span><div><strong>{isZh ? '目标' : 'Goal'}</strong><small>{isZh ? '先决定方法验证还是严格复现' : 'Method check or strict reproduction first'}</small></div></li>
        <li><span>02</span><div><strong>{isZh ? '环境' : 'Environment'}</strong><small>ALFWorld / WebShop</small></div></li>
        <li><span>03</span><div><strong>{isZh ? '真实算力' : 'Real compute'}</strong><small>{isZh ? '论文 A800×8；智星云当前公开最接近 A100 80G NVLINK×8' : 'Paper: A800×8; current closest public AI Galaxy option: A100 80G NVLINK×8'}</small></div></li>
        <li><span>04</span><div><strong>{isZh ? '验证' : 'Validation'}</strong><small>{isZh ? '同模型同环境：GRPO → SEED；硬件替代单独标注' : 'Same model and environment: GRPO → SEED; label hardware substitutions'}</small></div></li>
      </ol>

      <aside class="market-snapshot">
        <div>
          <strong>{isZh ? '智星云公开算力快照' : 'AI Galaxy public compute snapshot'}</strong>
          <small>{isZh ? market.checkedAtZh : market.checkedAtEn}</small>
        </div>
        <p>{isZh
          ? '当前公开页面未列出 A800 80G×8。要在智星云继续做论文规模的替代复现，选择 A100 80G NVLINK×8（¥30,000/月）；要做严格硬件复现，则先预约/询价 A800 80G×8，拿不到就换供应商。'
          : 'The current public pages do not list 8×A800 80G. For a paper-scale substitute on AI Galaxy, choose 8×A100 80G NVLINK (¥30,000/month). For exact hardware reproduction, request/reserve 8×A800 80G; if unavailable, switch providers.'}</p>
        <small>{isZh ? market.evidenceBoundary.zh : market.evidenceBoundary.en}</small>
      </aside>

      <div class="seed-use-case-links">
        <a href={strictWorkspaceHref}>{isZh ? '预填严格复现工作台' : 'Prefill strict workspace'} →</a>
        <a href="https://gpu.ai-galaxy.com/store" target="_blank" rel="noreferrer">{isZh ? '打开算力市场核对实时库存' : 'Open marketplace for live inventory'} ↗</a>
      </div>
    </div>
  )}
</section>

<style>
  .seed-use-case {
    margin: 28px 0 34px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .seed-use-case-standalone {
    width: min(1180px, calc(100% - 32px));
    margin: 14px auto 0;
    padding: 14px 0 16px;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
  }
  .seed-use-case-head {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(220px, 0.6fr);
    gap: 28px;
    align-items: end;
  }
  .seed-use-case h2 {
    margin: 7px 0 10px;
    max-width: 840px;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
  }
  .seed-use-case p {
    max-width: 820px;
    margin: 0;
    color: var(--muted);
  }
  .seed-use-case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }
  .seed-use-case-standalone .seed-use-case-head {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
  }
  .seed-use-case-standalone h2 {
    margin: 3px 0 5px;
    max-width: 760px;
    font-size: clamp(1.02rem, 1.7vw, 1.22rem);
    line-height: 1.25;
  }
  .seed-use-case-standalone p {
    max-width: 820px;
    font-size: .82rem;
    line-height: 1.55;
  }
  .seed-use-case-standalone .button {
    padding: 8px 11px;
    font-size: .78rem;
  }
  .seed-use-case-compact {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 10px;
    padding-top: 9px;
    border-top: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.45;
  }
  .seed-use-case-compact a {
    flex: 0 0 auto;
    color: var(--accent-deep);
    font-weight: 700;
    text-decoration: none;
  }
  .seed-mainline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  .seed-mainline li {
    display: flex;
    gap: 10px;
    min-width: 0;
    padding: 13px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .seed-mainline li > span {
    flex: 0 0 auto;
    color: var(--accent-deep);
    font-weight: 800;
    font-size: 0.78rem;
  }
  .seed-mainline strong,
  .seed-mainline small { display: block; }
  .seed-mainline strong { margin-bottom: 2px; font-size: 0.9rem; }
  .seed-mainline small { color: var(--muted); line-height: 1.45; }
  .market-snapshot {
    display: grid;
    grid-template-columns: minmax(170px, .35fr) minmax(0, 1.4fr);
    gap: 18px 24px;
    margin-top: 16px;
    padding: 16px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--surface);
  }
  .market-snapshot strong,
  .market-snapshot small { display: block; }
  .market-snapshot small { color: var(--muted); line-height: 1.45; }
  .market-snapshot > small { grid-column: 2; }
  .seed-use-case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 16px;
    font-size: 0.86rem;
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .seed-use-case-head,
    .seed-use-case-standalone .seed-use-case-head { grid-template-columns: 1fr; }
    .seed-use-case-actions { justify-content: flex-start; }
    .seed-mainline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .market-snapshot { grid-template-columns: 1fr; }
    .market-snapshot > small { grid-column: auto; }
  }
  @media (max-width: 520px) {
    .seed-use-case { padding: 18px; }
    .seed-use-case-standalone { padding: 12px 0 14px; }
    .seed-use-case-standalone .button { width: 100%; justify-content: center; }
    .seed-use-case-compact { align-items: flex-start; flex-direction: column; gap: 5px; }
    .seed-mainline { grid-template-columns: 1fr; }
  }
</style>
