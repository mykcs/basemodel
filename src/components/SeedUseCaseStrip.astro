---
import { localePath, type Locale } from '../i18n';
import { aiGalaxySeedSnapshot as market } from '../data/aiGalaxySeedSnapshot';

type Area = 'home' | 'models' | 'families' | 'compare' | 'papers' | 'workspace' | 'data-status' | 'methodology' | 'landscape';
interface Props { locale: Locale; area: Area; standalone?: boolean }
const { locale, area, standalone = false } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const zh: Record<Area, { title: string; body: string }> = {
  home: { title: '第一次来，就从一篇真的实验开始', body: '先用实验室的 4×RTX 3090 复现 SEED 的 ALFWorld 和 WebShop。机器能做完就到此为止；真的被显存或时间卡住，再看 8×A800 / A100。' },
  models: { title: '现在只问：这个 checkpoint 能不能继续做 SEED？', body: '复现主线先用 Qwen2.5-3B-Instruct。想换新模型时，再比较权重、训练支持、运行时和实验可比性。' },
  families: { title: '这里用来找“以后可以换什么”，不用来改今天的实验', body: '先把 SEED 跑完。之后想做新一代 Qwen 的现代化重跑，再从家族和代际里挑候选。' },
  compare: { title: '只比较会改变实验解释的差异', body: '模型、checkpoint、权重可得性、RL 路径、上下文和硬件变化都要写清楚。和当前实验无关的排行榜差异先放一边。' },
  papers: { title: '先把论文条件抄准，再去写代码', body: 'SEED 的两套环境、训练阶段、模型角色和论文硬件都在这里核对。Guide 负责把这些条件变成你能照着执行的步骤。' },
  workspace: { title: '把你手上的真实条件写进实验', body: '先填 4×24GB、离线、本地权重、RL。四卡能完成就不用租云卡；需要迁移时，再把 8 卡作为下一版实验配置。' },
  'data-status': { title: '这里帮你分清“论文事实”和“今天的市场信息”', body: '论文条件相对稳定；云 GPU 的型号、价格和库存会变。会变的信息都带核验时间，真机结果另外保存。' },
  methodology: { title: '每个数字都先问一句：它从哪里来？', body: '论文给出的条件、云平台当前报价、我们为了排机器做的时间估算、以及你在 3090 上测到的结果，四类证据分开记录。' },
  landscape: { title: '模型空间留到第二个问题再用', body: '第一件事先完成 SEED。第二件事如果是“换新模型后还成立吗”，再从这里找替代方案。' },
};
const en: Record<Area, { title: string; body: string }> = {
  home: { title: 'Start with one real experiment', body: 'Reproduce SEED on ALFWorld and WebShop using 4×RTX 3090 first. If that machine finishes the job, stop there; consider 8×A800/A100 only when memory or runtime becomes a real blocker.' },
  models: { title: 'Ask one question first: can this checkpoint continue the SEED experiment?', body: 'Keep Qwen2.5-3B-Instruct for the reproduction mainline. Compare weights, trainability, runtime, and comparability only when you intentionally change the model.' },
  families: { title: 'Use families for the next experiment, not to rewrite today’s one', body: 'Finish SEED first. If the next question is a modern rerun on a newer Qwen generation, choose candidates here.' },
  compare: { title: 'Compare only differences that change the experiment', body: 'Model, checkpoint, weight access, RL path, context, and hardware changes matter. Leaderboard gaps that do not answer this experiment can wait.' },
  papers: { title: 'Copy the paper conditions correctly before writing code', body: 'Verify SEED environments, training stages, model roles, and paper hardware here. The Guide turns those facts into executable steps.' },
  workspace: { title: 'Write down the resources you actually have', body: 'Start from 4×24GB, offline, local weights, and RL. If four GPUs finish the work, do not rent cloud hardware; record an eight-GPU configuration only when migration is needed.' },
  'data-status': { title: 'Separate paper facts from today’s market information', body: 'Paper conditions are relatively stable; cloud GPU models, prices, and inventory change. Timestamp time-sensitive facts and keep measured runs separate.' },
  methodology: { title: 'For every number, ask where it came from', body: 'Keep paper conditions, current cloud prices, engineering time estimates, and measurements from your 3090 machine as four different evidence levels.' },
  landscape: { title: 'Save the model landscape for the second question', body: 'Finish SEED first. Use this space when the next experiment asks whether the method still works with a newer model.' },
};
const copy = (isZh ? zh : en)[area];
const guideHref = `${localePath(locale, '/guide/')}#seed-reproduction`;
const paperHref = localePath(locale, '/papers/seed/');
const workspaceHref = `${localePath(locale, '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&gpu=24&gpus=4&runtime=verl&open=1`;
---
<section class:list={['seed-use-case', { standalone }]} aria-label={t('SEED 实验主线', 'SEED experiment mainline')}>
  <div class="head"><div><span class="section-kicker">{standalone ? t('当前页面在 SEED 实验里的位置', 'This page in the SEED experiment') : t('新手主线 · SEED', 'Beginner mainline · SEED')}</span><h2>{copy.title}</h2><p>{copy.body}</p></div><a class="button button-primary" href={guideHref}>{t('回到复现步骤', 'Open reproduction steps')}</a></div>
  {standalone ? (
    <div class="compact"><span><strong>SEED</strong> · 4×3090 → ALFWorld → WebShop → SFT → RL → GRPO</span><a href={workspaceHref}>{t('把当前结论记进工作台', 'Record this in Workspace')} →</a></div>
  ) : (
    <div class="detail">
      <ol><li><b>01</b><span><strong>{t('先用现有机器', 'Use the machine you have')}</strong><small>4×RTX 3090 24GB</small></span></li><li><b>02</b><span><strong>{t('先跑两个环境', 'Bring up both environments')}</strong><small>ALFWorld / WebShop</small></span></li><li><b>03</b><span><strong>{t('再做训练', 'Then train')}</strong><small>SFT → SEED RL → GRPO</small></span></li><li><b>04</b><span><strong>{t('最后决定要不要 8 卡', 'Only then decide on eight GPUs')}</strong><small>{t('3090 完成就结束；卡住再迁移', 'Stop if 3090 finishes; migrate only if blocked')}</small></span></li></ol>
      <aside><strong>{t('云端备用方案', 'Cloud fallback')}</strong><p>{t(`公开算力快照：${market.checkedAtZh}。如果四卡被显存或时间卡住，再核对 A800/A100 的实际库存和价格。`, `Public compute snapshot: ${market.checkedAtEn}. If four GPUs are blocked by memory or time, then re-check current A800/A100 inventory and prices.`)}</p><small>{isZh ? market.evidenceBoundary.zh : market.evidenceBoundary.en}</small></aside>
      <div class="links"><a href={paperHref}>{t('核对 SEED 论文', 'Check the SEED paper')} →</a><a href="https://gpu.ai-galaxy.com/store" target="_blank" rel="noreferrer">{t('需要迁移时再看算力市场', 'Check compute market only when migrating')} ↗</a></div>
    </div>
  )}
</section>
<style>
.seed-use-case{margin:28px 0 34px;padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.seed-use-case.standalone{width:min(1180px,calc(100% - 32px));margin:10px auto 0;padding:12px 0 14px;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent}.head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px;align-items:end}.head h2{margin:6px 0 8px;max-width:820px;font-size:clamp(1.08rem,2vw,1.55rem)}.head p{max-width:840px;margin:0;color:var(--muted);line-height:1.6}.standalone .head h2{font-size:1.08rem}.standalone .head p{font-size:.82rem}.compact{display:flex;justify-content:space-between;gap:18px;margin-top:9px;padding-top:8px;border-top:1px solid var(--line);color:var(--muted);font-size:.76rem}.compact a,.links a{color:var(--accent-deep);font-weight:700;text-decoration:none}.detail>ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:20px 0 0;padding:0;list-style:none}.detail li{display:flex;gap:9px;padding:12px;border:1px solid var(--line);border-radius:9px}.detail li>b{color:var(--accent-deep);font-size:.72rem}.detail strong,.detail small{display:block}.detail small{margin-top:2px;color:var(--muted)}.detail aside{margin-top:14px;padding:14px 16px;border-left:3px solid var(--accent);background:var(--surface-muted)}.detail aside p{margin:4px 0}.detail aside small{color:var(--muted)}.links{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px;font-size:.84rem}@media(max-width:760px){.head{grid-template-columns:1fr}.detail>ol{grid-template-columns:repeat(2,minmax(0,1fr))}.compact{flex-direction:column;gap:5px}}@media(max-width:520px){.detail>ol{grid-template-columns:1fr}}
</style>
