---
import { localePath, type Locale } from '../i18n';

interface Concept { id: string; title_zh: string; title_en: string; body_zh: string; body_en: string; model_ids: string[]; links?: Array<{ label_zh: string; label_en: string; href: string }> }
interface Glossary { term_zh: string; term_en: string; definition_zh: string; definition_en: string }
interface Props { locale: Locale; concepts: Concept[]; glossary: Glossary[]; steps: string[]; note: string }
const { locale, concepts, glossary, steps, note } = Astro.props;
const isZh = locale === 'zh';

// 学习路径是纯导航引导：把“先学什么、再看什么、最后去哪做”显式化，不产生新的研究结论。
const learningPath = [
  {
    num: '01',
    title: isZh ? '建立共同语言' : 'Learn the shared language',
    desc: isZh ? '先读下方概念地图，弄清 Base / Instruct、checkpoint、证据状态这些词在说什么。' : 'Start with the concept map below: Base vs Instruct, checkpoints, and what evidence states mean.',
    href: '#guide-concepts-title',
    go: isZh ? '就在本页 ↓' : 'On this page ↓',
    here: true,
  },
  {
    num: '02',
    title: isZh ? '看真实模型' : 'See real models',
    desc: isZh ? '在模型浏览器里按开放权重、LoRA、RL 等研究约束筛选真实候选。' : 'Filter real candidates in the model browser by open weights, LoRA, RL, and other research constraints.',
    href: localePath(locale, '/models/'),
    go: isZh ? '打开模型浏览器 →' : 'Open the model browser →',
    here: false,
  },
  {
    num: '03',
    title: isZh ? '读一篇论文案例' : 'Read one paper case',
    desc: isZh ? '看真实论文如何使用模型，以及替换模型时哪些结论会变化。' : 'See how real papers used models, and which conclusions change when a model is replaced.',
    href: localePath(locale, '/papers/'),
    go: isZh ? '打开论文案例库 →' : 'Open paper cases →',
    here: false,
  },
  {
    num: '04',
    title: isZh ? '做第一次决策' : 'Make your first decision',
    desc: isZh ? '打开工作台设定研究任务，把候选、对比和证据导出为一份决策记录。' : 'Set a research task in the workbench and export candidates, comparisons, and evidence as a decision memo.',
    href: localePath(locale, '/workspace/'),
    go: isZh ? '打开工作台 →' : 'Open the workbench →',
    here: false,
  },
];
---
<ol class="guide-steps">{steps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}</ol>
<section class="guide-path" aria-labelledby="guide-path-title">
  <div class="section-heading"><div><span class="section-kicker">{isZh ? '学习路径' : 'Learning path'}</span><h2 id="guide-path-title">{isZh ? '四步走到第一次模型决策' : 'Four steps to your first model decision'}</h2></div><p class="muted">{isZh ? '刚接触智能体和基础模型时，按这个顺序走一遍。' : 'New to agents and foundation models? Follow this order once.'}</p></div>
  <ol class="guide-path-list">{learningPath.map((item) => <li><a class:list={['guide-path-card', { 'is-here': item.here }]} href={item.href}><span class="guide-path-num" aria-hidden="true">{item.num}</span><strong>{item.title}</strong><small>{item.desc}</small><span class="guide-path-go">{item.go}</span></a></li>)}</ol>
</section>
<section class="guide-concept-map" aria-labelledby="guide-concepts-title">
  <div class="section-heading"><div><span class="section-kicker">{isZh ? '概念地图' : 'Concept map'}</span><h2 id="guide-concepts-title">{isZh ? '先建立模型选择的共同语言' : 'Build a shared language for model choice'}</h2></div><p class="muted">{isZh ? '从概念进入真实模型与研究任务。' : 'Move from concepts to real models and research tasks.'}</p></div>
  <nav class="concept-map-nav" aria-label={isZh ? '概念地图导航' : 'Concept map navigation'}>{concepts.map((concept) => <a href={`#concept-${concept.id}`}>{isZh ? concept.title_zh : concept.title_en}</a>)}</nav>
  <div class="concept-map-grid">{concepts.map((concept, index) => <article id={`concept-${concept.id}`} class="concept-card"><h3><span class="concept-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{isZh ? concept.title_zh : concept.title_en}</h3><p>{isZh ? concept.body_zh : concept.body_en}</p>{concept.model_ids.length > 0 && <div class="concept-model-links"><span>{isZh ? '真实模型示例' : 'Model examples'}</span>{concept.model_ids.map((id) => <a href={localePath(locale, `/models/${id}/`)}>{id}</a>)}</div>}{concept.links?.length ? <div class="concept-model-links"><span>{isZh ? '继续研究' : 'Continue research'}</span>{concept.links.map((link) => <a href={localePath(locale, link.href)}>{isZh ? link.label_zh : link.label_en}</a>)}</div> : null}</article>)}</div>
</section>
<section class="guide-glossary" aria-labelledby="guide-glossary-title"><div class="section-heading"><div><span class="section-kicker">{isZh ? '术语表' : 'Glossary'}</span><h2 id="guide-glossary-title">{isZh ? '在页面内解释关键术语' : 'Explain key terms in place'}</h2></div></div><div class="glossary-list">{glossary.map((item) => <details><summary>{isZh ? item.term_zh : item.term_en}</summary><p>{isZh ? item.definition_zh : item.definition_en}</p></details>)}</div></section>
<p class="callout">{note}</p>
<style>
  .guide-path { margin: 34px 0 40px; }
  .guide-path-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; padding: 0; margin: 0; list-style: none; }
  .guide-path-list li { min-width: 0; }
  .guide-path-card { display: grid; gap: 7px; align-content: start; height: 100%; padding: 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: inherit; text-decoration: none; transition: border-color .15s ease; }
  .guide-path-card:hover, .guide-path-card:focus-visible { border-color: var(--accent); }
  .guide-path-card.is-here { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: color-mix(in srgb, var(--accent) 5%, var(--surface)); }
  .guide-path-num { color: var(--accent-deep); font-size: .72rem; font-weight: 800; letter-spacing: .1em; }
  .guide-path-card strong { font-size: .95rem; }
  .guide-path-card small { color: var(--muted); font-size: .78rem; line-height: 1.55; }
  .guide-path-go { margin-top: 4px; color: var(--accent-deep); font-size: .76rem; font-weight: 700; }
  .concept-map-nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .concept-map-nav a { padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--muted); font-size: .78rem; text-decoration: none; transition: border-color .15s ease; }
  .concept-map-nav a:hover, .concept-map-nav a:focus-visible { color: var(--ink); border-color: var(--accent); }
  .concept-map-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 22px; }
  .concept-card { display: flex; flex-direction: column; padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); scroll-margin-top: 96px; }
  .concept-card h3 { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; font-size: 1.02rem; }
  .concept-num { flex: 0 0 auto; color: var(--accent-deep); font-size: .7rem; font-weight: 800; letter-spacing: .08em; }
  .concept-card > p { color: var(--muted); font-size: .86rem; margin-bottom: 12px; }
  .concept-model-links { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line); }
  .concept-model-links + .concept-model-links { margin-top: 0; border-top: 0; padding-top: 2px; }
  .concept-model-links > span { color: var(--muted); font-size: .72rem; font-weight: 650; margin-right: 2px; }
  .concept-model-links a { padding: 5px 9px; border: 1px solid var(--line); border-radius: 7px; background: var(--surface-muted); color: var(--ink); font-size: .74rem; text-decoration: none; transition: border-color .15s ease; }
  .concept-model-links a:hover, .concept-model-links a:focus-visible { border-color: var(--accent); color: var(--accent-deep); }
  .guide-glossary { margin-top: 40px; }
  .glossary-list { display: grid; gap: 8px; }
  .glossary-list details { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .glossary-list summary { cursor: pointer; font-weight: 650; font-size: .9rem; }
  .glossary-list details p { margin: 8px 0 0; color: var(--muted); font-size: .84rem; }
  @media (max-width: 900px) {
    .guide-path-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .concept-map-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .guide-path-list { grid-template-columns: 1fr; }
  }
</style>
