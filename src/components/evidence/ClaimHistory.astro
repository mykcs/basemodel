---
interface Claim { id: string; subjectType: string; subjectId: string; fieldPath: string; predicate?: string; value?: string | number | boolean | string[]; status: string; relation?: string; validFrom?: string; validTo?: string; evidenceNote?: string }
interface Props { claims: Claim[]; locale: 'zh' | 'en' }
const { claims, locale } = Astro.props;
---
<section class="section claim-history" aria-labelledby="claim-history-title"><div class="section-heading"><div><h2 id="claim-history-title">{locale === 'zh' ? '声明历史与冲突关系' : 'Claim history and conflicts'}</h2><p class="muted">{locale === 'zh' ? '声明按对象、字段、有效期和支持/反驳关系展示；没有记录的事实不会被补全。' : 'Claims retain subject, field, validity, and support/contradict relations; missing records are not filled in.'}</p></div></div>{claims.length ? <div class="comparison-table-wrap"><table><thead><tr><th>{locale === 'zh' ? '对象' : 'Subject'}</th><th>{locale === 'zh' ? '谓词/字段' : 'Predicate/field'}</th><th>{locale === 'zh' ? '值' : 'Value'}</th><th>{locale === 'zh' ? '关系' : 'Relation'}</th><th>{locale === 'zh' ? '有效期' : 'Validity'}</th></tr></thead><tbody>{claims.map((claim) => <tr><th scope="row">{claim.subjectId}</th><td>{claim.predicate ?? claim.fieldPath}</td><td>{Array.isArray(claim.value) ? claim.value.join(', ') : claim.value ?? claim.status}</td><td>{claim.relation ?? 'supports'}</td><td>{claim.validFrom ?? '—'} → {claim.validTo ?? '—'}</td></tr>)}</tbody></table></div> : <p class="muted">{locale === 'zh' ? '当前没有声明历史记录。' : 'No claim history is currently recorded.'}</p>}</section>
