---
import ExternalBrandMark from '../common/ExternalBrandMark';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  compact?: boolean;
  showSignals?: boolean;
}

const { locale, compact = false, showSignals = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const signals = [
  {
    title: 'Qwen 3.8 Max',
    evidenceDate: '2026-08-19',
    body: t(
      'Qwen 官方代码把 qwen3.8-max 从预览版（preview）提升为稳定版（stable），并写明它已列入 Bailian 模型目录。这能证明模型标识与这次状态变化；不能单独证明整个 Qwen 家族的旗舰（flagship）和退役关系。',
      'First-party Qwen code promoted qwen3.8-max from preview to stable and states that it is listed in the Bailian model catalog. This supports the model identifier and that status change; it does not by itself establish the full Qwen flagship or retirement map.',
    ),
    sources: [
      { label: t('Qwen 官方 commit', 'Qwen first-party commit'), href: 'https://github.com/QwenLM/qwen-code/commit/ff5aa6be824a8979713c8e07bc90f10bc1020905' },
    ],
  },
  {
    title: 'Qwen 3.8 Plus / Flash',
    evidenceDate: '2026-08-27',
    body: t(
      'Qwen 官方代码为 qwen3.8-plus 与 qwen3.8-flash 增加了图像和视频能力元数据。这能证明这些模型标识已进入一手代码，并支持相应模态信息；不能单独证明发布日期、旗舰或完整生命周期。',
      'First-party Qwen code added image and video modality metadata for qwen3.8-plus and qwen3.8-flash. This supports the identifiers and those modality fields; it does not by itself establish release dates, flagship status, or full lifecycle.',
    ),
    sources: [
      { label: t('Qwen 官方 commit', 'Qwen first-party commit'), href: 'https://github.com/QwenLM/qwen-code/commit/ac513de34e15f87b0bc4810893d7c370fac9f8b7' },
    ],
  },
  {
    title: 'Gemini 3.7 Flash',
    evidenceDate: '2026-08-13',
    body: t(
      'Google 官方 GenAI Python SDK 的 2.18.1 更新记录写着“Add gemini-3.7-flash”。这能证明官方 SDK 已记录这个模型标识；不能单独证明它是 Gemini 当前旗舰或完整家族状态。',
      'Google’s first-party GenAI Python SDK changelog for 2.18.1 says “Add gemini-3.7-flash.” This supports first-party SDK recognition of the identifier; it does not by itself establish current flagship or full-family status.',
    ),
    sources: [
      { label: t('Google 官方 SDK changelog', 'Google first-party SDK changelog'), href: 'https://github.com/googleapis/python-genai/blob/2cc99a9b365bda40ad60da33b206a31c096a79c5/CHANGELOG.md' },
    ],
  },
  {
    title: 'Grok 4.6',
    evidenceDate: '2026-08-13',
    body: t(
      'xAI 官方 Python SDK 的 1.18.0 更新把 grok-4.6 加进 ChatModel，并记录 xhigh 推理强度可由这类模型使用。这能证明官方 SDK 里的模型标识与该能力支持；不能单独证明当前旗舰或完整生命周期。',
      'xAI’s first-party Python SDK 1.18.0 added grok-4.6 to ChatModel and records xhigh reasoning effort as supported by models such as grok-4.6. This supports the SDK identifier and that capability; it does not by itself establish current flagship or full lifecycle.',
    ),
    sources: [
      { label: t('xAI 官方 SDK changelog', 'xAI first-party SDK changelog'), href: 'https://github.com/xai-org/xai-sdk-python/blob/4dab6a449736890a70d20bc886221a4219ff6ae7/CHANGELOG.md' },
    ],
  },
] as const;
---

<aside class:list={['catalog-freshness', compact && 'catalog-freshness--compact']} aria-label={t('模型目录事实边界', 'Model-catalog evidence boundary')}>
  <div class="catalog-freshness__summary">
    <strong>{t('“当前 / 最新”是带日期的目录快照', '“Current / latest” means a dated catalog snapshot')}</strong>
    <p>{t(
      '模型目录不是厂商的实时接口。每个“当前”判断只对页面写出的核验日期负责；核验日之后出现的一手证据先记成“新证据线索”，只有重新核对完整家族后才改旗舰（flagship）、退役和完整在售状态。',
      'This catalog is not a live vendor API. Every “current” claim is scoped to its displayed check date. New first-party evidence that appears later is recorded as a fresh-evidence lead; flagship, retirement, and full availability states change only after a full family recheck.',
    )}</p>
  </div>

  {showSignals && <div class="catalog-freshness__signals">
    <p class="catalog-freshness__signal-note">{t('下面日期是一手证据的记录日期，不是模型发布日期。', 'The dates below are first-party evidence dates, not model release dates.')}</p>
    <ol>
      {signals.map((signal) => <li>
        <div class="catalog-freshness__signal-head"><strong>{signal.title}</strong><time datetime={signal.evidenceDate}>{signal.evidenceDate}</time></div>
        <p>{signal.body}</p>
        <div class="catalog-freshness__sources">{signal.sources.map((source) => <a href={source.href} target="_blank" rel="noreferrer"><ExternalBrandMark href={source.href} />{source.label} ↗</a>)}</div>
      </li>)}
    </ol>
  </div>}
</aside>

<style>
  .catalog-freshness{margin:1rem 0 1.4rem;padding:1rem 1.05rem;border:1px solid var(--line);border-left:3px solid var(--accent-deep);border-radius:12px;background:var(--surface-muted)}
  .catalog-freshness__summary strong{display:block;font-size:.9rem;line-height:1.4}.catalog-freshness__summary p{max-width:86ch;margin:.4rem 0 0;color:var(--muted);font-size:.82rem;line-height:1.6}
  .catalog-freshness__signals{margin-top:.9rem;padding-top:.85rem;border-top:1px solid var(--line)}.catalog-freshness__signal-note{margin:0 0 .65rem;color:var(--muted);font-size:.78rem;line-height:1.5}.catalog-freshness__signals ol{margin:0;padding:0;list-style:none}.catalog-freshness__signals li{padding:.75rem 0;border-top:1px solid var(--line)}.catalog-freshness__signals li:first-child{border-top:0}.catalog-freshness__signal-head{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem}.catalog-freshness__signal-head strong{font-size:.86rem}.catalog-freshness__signal-head time{color:var(--muted);font-size:.76rem}.catalog-freshness__signals li>p{max-width:90ch;margin:.35rem 0;color:inherit;font-size:.8rem;line-height:1.55}.catalog-freshness__sources{display:flex;flex-wrap:wrap;gap:.5rem}.catalog-freshness__sources a{font-size:.76rem;font-weight:700}.catalog-freshness--compact{margin:.75rem 0 1rem;padding:.8rem .9rem}.catalog-freshness--compact .catalog-freshness__summary p{font-size:.8rem}@media(max-width:620px){.catalog-freshness__signal-head{align-items:flex-start;flex-direction:column;gap:.2rem}}
</style>
