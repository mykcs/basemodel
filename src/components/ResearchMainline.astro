---
import type { Locale } from '../i18n';

interface Props { locale: Locale; path: string }
type Stage = 'question' | 'constraints' | 'candidates' | 'evidence' | 'decision';
type Guide = { stage: Stage; current: string; why: string; next: string };

const { locale, path } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const stages: Array<{ id: Stage; label: string }> = [
  { id: 'question', label: t('确认实验', 'Confirm experiment') },
  { id: 'constraints', label: t('检查资源', 'Check resources') },
  { id: 'candidates', label: t('选择模型', 'Choose model') },
  { id: 'evidence', label: t('运行并记录', 'Run and record') },
  { id: 'decision', label: t('比较结果', 'Compare results') },
];
const stageTargets: Record<Stage, string> = {
  question: '/guide/',
  constraints: '/workspace/',
  candidates: '/models/',
  evidence: '/research/seed-openevo/',
  decision: '/research/seed-openevo/results/',
};
const localized = (target: string) => locale === 'en' ? `/en${target}` : target;
const exact = (v: string) => path === v || path === `${v}/`;
const starts = (v: string) => path.startsWith(`${v}/`);

let guide: Guide;
if (exact('/guide')) {
  guide = {
    stage: 'question',
    current: t('这页先解释 Agent 如何运行和训练，再进入 SEED 的 ALFWorld / WebShop 复现。', 'This page explains how an agent runs and trains, then moves into the SEED ALFWorld/WebShop reproduction.'),
    why: t('只有分清 trajectory、reward 和 policy update 出现在哪一步，后面的 RL 命令才知道在改变什么。', 'Separating trajectory, reward, and policy update shows what the later RL commands actually change.'),
    next: t('看完 Agent 与 SEED 的对应关系后，从第 00 步开始，并按每一步的 PASS 条件继续。', 'After the Agent-to-SEED mapping, start at step 00 and continue using each step’s PASS condition.'),
  };
} else if (exact('/papers') || starts('/papers')) {
  guide = { stage: 'question', current: t('确认论文使用的模型、环境、训练阶段和硬件。', 'Confirm the model, environments, training stages, and hardware used by the paper.'), why: t('这些设置决定你是在复现原实验、只验证方法，还是已经开始另一个实验。', 'These settings determine whether you are reproducing the original experiment, testing only the method, or starting a different experiment.'), next: t('准备运行时打开实验步骤；需要换模型时再进入模型页和工作台。', 'Open the experiment steps when you are ready to run; use the model pages and workspace only when changing the model.') };
} else if (exact('/workspace')) {
  guide = { stage: 'constraints', current: t('填写实际拥有的 GPU、网络、权重访问和训练条件。', 'Enter the GPU, network, weight access, and training setup you actually have.'), why: t('先排除跑不起来的方案，再比较模型能力。本项目的硬件示例是 4×24GB 离线服务器。', 'Remove plans that cannot run before comparing model capability. This project’s hardware example is an offline 4×24GB server.'), next: t('保存可执行方案；若现有机器已经完成实验，就保留结果并结束。', 'Save an executable plan; if the available machine completes the experiment, preserve the results and finish there.') };
} else if (exact('/models') || starts('/models')) {
  guide = { stage: 'candidates', current: t('确认这个 checkpoint 能否运行当前实验，再比较能力。', 'Confirm that this checkpoint can run the experiment before comparing capability.'), why: t('权重访问、可训练性、显存、论文角色和版本差异都可能先让一个模型出局。', 'Weight access, trainability, memory, paper role, and revision differences may rule out a model before capability matters.'), next: t('复现 SEED 时保留 Qwen2.5-3B-Instruct；替换模型时记录具体变化。', 'Keep Qwen2.5-3B-Instruct for SEED reproduction and record the exact change when substituting a model.') };
} else if (exact('/families') || starts('/families') || exact('/landscape')) {
  guide = { stage: 'candidates', current: t('这里列出模型家族和替代型号；SEED 原实验仍使用论文中的 checkpoint。', 'This page lists model families and alternatives; the original SEED experiment still uses the paper checkpoint.'), why: t('同一家族的新版本也会改变模型能力、模板、运行时和可比性。', 'A newer version in the same family can still change capability, templates, runtime, and comparability.'), next: t('只有新实验明确要换模型时，才选择一个具体替代 checkpoint。', 'Choose a concrete replacement checkpoint only when the new experiment explicitly changes the model.') };
} else if (exact('/methodology') || exact('/data-status')) {
  guide = { stage: 'evidence', current: t('确认每个数字来自论文、平台目录、工程估算还是真机运行。', 'Check whether each number comes from the paper, a platform catalog, an engineering estimate, or a measured run.'), why: t('四类信息的核验时间和可信范围不同，不能互相代替。', 'The four information types have different check dates and confidence boundaries and cannot replace one another.'), next: t('关键结论回到一手来源；价格带核验日期，真机结果带运行和硬件记录。', 'Return key claims to primary sources; date prices and attach run and hardware records to measurements.') };
} else if (exact('/compare')) {
  guide = { stage: 'decision', current: t('比较会改变实验结果或公平性的差异。', 'Compare differences that can change the outcome or fairness of the experiment.'), why: t('参数量、checkpoint、架构、上下文、权重访问和训练条件都可能成为额外变量。', 'Scale, checkpoint, architecture, context, weight access, and training setup can all become extra variables.'), next: t('确认差异可以接受后，把替换原因、风险和来源写进实验记录。', 'After accepting a difference, record the replacement reason, risk, and sources in the experiment record.') };
} else {
  guide = { stage: 'evidence', current: t('这页提供完成实验所需的模型、数据或运行信息。', 'This page provides model, data, or runtime information needed to complete the experiment.'), why: t('只把会影响当前实验的内容带到下一步。', 'Carry forward only information that changes the current experiment.'), next: t('找到需要的信息后，继续原来的实验步骤。', 'After finding the needed information, continue the original experiment steps.') };
}
---
<section class="research-mainline" aria-label={t('实验步骤', 'Experiment steps')}>
  <div class="shell research-mainline-inner">
    <ol class="research-mainline-stages">
      {stages.map((stage, index) => <li class:list={{ 'is-active': guide.stage === stage.id }}><a href={localized(stageTargets[stage.id])} aria-current={guide.stage === stage.id ? 'step' : undefined}><span>{String(index + 1).padStart(2, '0')}</span><strong>{stage.label}</strong></a></li>)}
    </ol>
    <div class="research-mainline-context">
      <div><small>{t('这页讲什么', 'What this page covers')}</small><strong>{guide.current}</strong></div>
      <div><small>{t('为什么重要', 'Why it matters')}</small><span>{guide.why}</span></div>
      <div><small>{t('接下来', 'Next')}</small><span>{guide.next}</span></div>
    </div>
  </div>
</section>
<style>
  .research-mainline{border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 76%,transparent)}.research-mainline-inner{padding-top:10px;padding-bottom:11px}.research-mainline-stages{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin:0;padding:0;list-style:none;border-bottom:1px solid var(--line)}.research-mainline-stages li{min-width:0;padding:6px 8px 7px;color:var(--muted);border-bottom:2px solid transparent}.research-mainline-stages li+li{border-left:1px solid color-mix(in srgb,var(--line) 70%,transparent)}.research-mainline-stages a{display:flex;align-items:baseline;gap:7px;min-width:0;width:100%;padding:4px 3px;border-radius:6px;color:inherit;text-decoration:none;transition:color 150ms ease,background 150ms ease}.research-mainline-stages a:hover{color:var(--ink);background:color-mix(in srgb,var(--accent) 6%,transparent)}.research-mainline-stages a:focus-visible{outline:2px solid var(--accent-deep);outline-offset:1px}.research-mainline-stages span{font-size:.62rem}.research-mainline-stages strong{font-size:.72rem;line-height:1.25}.research-mainline-stages .is-active{color:var(--ink);border-bottom-color:var(--accent-deep)}.research-mainline-stages .is-active span{color:var(--accent-deep);font-weight:800}.research-mainline-context{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr) minmax(0,1fr);gap:18px;margin-top:9px}.research-mainline-context>div{min-width:0}.research-mainline-context small{display:block;margin-bottom:3px;color:var(--accent-deep);font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.research-mainline-context strong,.research-mainline-context span{display:block;font-size:.76rem;line-height:1.48}.research-mainline-context span{color:var(--muted)}@media(max-width:760px){.research-mainline-stages{display:flex;overflow-x:auto}.research-mainline-stages li{flex:0 0 auto;min-width:112px}.research-mainline-context{grid-template-columns:1fr;gap:7px}.research-mainline-context>div{padding-left:10px;border-left:2px solid var(--line)}}
</style>
