---
import type { AtlasModel, AtlasPaper } from '../../lib/types';
interface Props { paper: AtlasPaper; models: AtlasModel[]; locale: 'zh' | 'en' }
const { paper, models, locale } = Astro.props;
const modelMap = new Map(models.map((model) => [model.id, model]));
---
<section class="shell detail-section paper-selection-rationale" id="model-selection">
  <h2>{locale === 'zh' ? '模型选择依据' : 'Model selection rationale'}</h2>
  <p class="muted">{locale === 'zh' ? '角色与权重更新来自论文案例记录；“为什么选它”只有在论文或代码明确给出时才会写入，未知不会被推断成事实。' : 'Roles and weight updates come from the paper case record. Selection reasons are written only when the paper or code states them; unknown is never inferred as fact.'}</p>
  {paper.model_selection?.length ? <div class="paper-list">{paper.model_selection.map((selection) => <div class="paper-row"><div><h3>{modelMap.get(selection.model_id)?.name ?? selection.model_id}</h3><p>{selection.rationale}</p></div><div class="paper-meta"><span class="tag">{selection.basis}</span></div></div>)}</div> : <div class="comparison-table-wrap"><table><caption class="sr-only">{locale === 'zh' ? '论文模型角色与选择依据状态' : 'Paper model roles and selection-evidence status'}</caption><thead><tr><th>{locale === 'zh' ? '模型' : 'Model'}</th><th>{locale === 'zh' ? '角色' : 'Role'}</th><th>{locale === 'zh' ? '权重更新' : 'Weights updated'}</th><th>{locale === 'zh' ? '选择依据' : 'Selection basis'}</th></tr></thead><tbody>{paper.models.map((use) => <tr><th scope="row">{modelMap.get(use.model_id)?.name ?? use.model_id}</th><td>{use.role}</td><td>{typeof use.weight_updated === 'boolean' ? (use.weight_updated ? (locale === 'zh' ? '是' : 'Yes') : (locale === 'zh' ? '否' : 'No')) : use.weight_updated}</td><td>{locale === 'zh' ? '未记录：需回到论文/代码核验' : 'Not recorded: verify in the paper/code'}</td></tr>)}</tbody></table></div>}
</section>
