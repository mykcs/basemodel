---
import { localePath, type Locale } from '../i18n';
import AgentEnvironmentTrajectory from './research/AgentEnvironmentTrajectory.astro';
import InteractiveResearchExplainer from './research/InteractiveResearchExplainer.tsx';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const gates = [
  {n:'01',title:t('连接服务器','Connect to the server'),body:t('日常实验使用普通账号；只有服务器 / Docker 控制面工作才进入 root 控制容器。','Use the ordinary account for daily experiments; enter the root control container only for server/Docker control-plane work.'),code:'ssh wangrui_user\n# approved control-plane work only\nssh wangrui_root\nwhoami && id'},
  {n:'02',title:t('确认控制面身份','Verify the control plane'),body:t('当前 SSH 进入 dev-wangr（hostname wangr-dev），不是物理 host shell。root 能访问 Docker socket，因此必须把“技术能力”和“授权范围”分开。','SSH currently lands in dev-wangr (hostname wangr-dev), not a physical-host shell. Root can access the Docker socket, so capability and authorization must remain separate.'),code:'hostname\nid\ndocker version\ndocker ps --format "table {{.Names}}\\t{{.Status}}"'},
  {n:'03',title:t('建立持久工作区','Bootstrap persistent workspace'),body:t('代码、环境、缓存、数据与实验输出都应落在普通科研用户拥有的持久目录，而不是容器临时 home。','Code, environments, caches, data, and run outputs belong in the ordinary research user’s persistent workspace, not a container-local home.'),code:'cd /path/to/zju-server\nbash scripts/bootstrap-research-workspace.sh\n# ordinary account verification\ncd /data/home/wangr/workspace\nprintf "probe\\n" > .write-test && rm .write-test'},
  {n:'04',title:t('重建四层仓库','Reconstruct the four repository layers'),body:t('zju-server 管机器事实；wangrui-server-environment 管可重建环境；openevo-experiment 管实验；OpenEvo Core 作为外部固定 SHA 依赖。','zju-server owns machine facts; wangrui-server-environment owns portable environment definitions; openevo-experiment owns experiments; OpenEvo Core remains an external pinned dependency.'),code:'workspace=/data/home/wangr/workspace\nmkdir -p "$workspace/repos" "$workspace/runtime/src"\n# normal reproduction: clone exact repositories into workspace/repos\n# then record git rev-parse HEAD for every active checkout'},
  {n:'05',title:t('验证 RTX 5090 实验容器','Validate the RTX 5090 experiment container'),body:t('先验证非 root UID/GID、BF16、matmul、backward、optimizer 和 bind-mount 写盘，不要直接把完整 WebShop 环境装进控制容器。','First validate non-root UID/GID, BF16, matmul, backward, optimizer, and bind-mounted writes; do not turn the control container into the full WebShop runtime.'),code:'cd /data/home/wangr/workspace/repos/openevo-experiment\n./scripts/build_experiment_image.sh\nGPU_REQUEST=device=0 ./scripts/run_gpu_smoke.sh\n./scripts/run_bind_mount_identity_gate.sh'},
  {n:'06',title:t('固定 OpenEvo 与 Qwen','Pin OpenEvo and Qwen'),body:t('当前已验证的机制证据使用 OpenEvo stable 796e6248… 与 Qwen2.5-3B-Instruct revision aa8e7253…。新的 run 必须重新记录精确 SHA / revision。','The verified mechanism evidence used OpenEvo stable 796e6248… and Qwen2.5-3B-Instruct revision aa8e7253…. Every new run must re-record exact SHAs/revisions.'),code:'git -C "$OPEN_EVO_ROOT" rev-parse HEAD\npython3 scripts/experiment_startup_report.py'},
  {n:'07',title:t('建立 OpenEvo × WebShop Python 环境','Build the OpenEvo × WebShop Python runtime'),body:t('不要把官方 SEED 的 Python 3.10 WebShop 环境和当前 OpenEvo adapter 的 Python ≥3.11 运行时混成一个环境。','Do not merge the official SEED Python 3.10 WebShop environment with the current OpenEvo adapter runtime, which requires Python ≥3.11.'),code:'python3 -m venv /data/home/wangr/workspace/runtime/envs/openevo\nsource /data/home/wangr/workspace/runtime/envs/openevo/bin/activate\npip install -e vendor/openevo-webshop\npip install -r scripts/openevo_webshop/runtime-overlay-requirements.txt\npython -c "import torch; print(torch.__version__, torch.version.cuda)"'},
  {n:'08',title:t('准备 WebShop 数据与搜索索引','Prepare WebShop data and search index'),body:t('当前实验使用固定的 1k 商品环境。三份 JSON、resources_1k 与 Lucene indexes_1k 都必须有 hash / behavior fingerprint；不能只凭目录名判断数据一致。','The current experiment uses the frozen 1k-product environment. The three JSON files, resources_1k, and Lucene indexes_1k need hashes/behavior fingerprints; directory names are not benchmark identity.'),code:'python3 scripts/openevo_webshop/prepare_webshop_data.py --validate-only --write-manifest "$WEBSHOP_DATA"\npython3 scripts/openevo_webshop/verify_indexes_1k.py \\\n  --index "$WEBSHOP_ROOT/search_engine/indexes_1k" \\\n  --catalog "$WEBSHOP_ROOT/data/items_shuffle_1000.json" \\\n  --resources "$WEBSHOP_ROOT/search_engine/resources_1k/documents.jsonl" \\\n  --fingerprint-out "$RUN_ROOT/indexes-1k-fingerprint.json"'},
  {n:'09',title:t('冻结任务合同','Freeze the task contract'),body:t('环境 seed、generation seed、task IDs、prompt、parser、max steps 与 evaluator 必须先固定，再比较 base / adapter。','Freeze environment seed, generation seeds, task IDs, prompt, parser, max steps, and evaluator before comparing base and adapters.'),code:'python3 scripts/openevo_webshop/webshop_task_manifest.py capture --seed-root "$SEED_ROOT" --out "$RUN_ROOT/task-manifest.json" --ledger-out "$RUN_ROOT/task-access-ledger.json"\npython3 scripts/openevo_webshop/webshop_task_manifest.py verify "$RUN_ROOT/task-manifest.json"'},
  {n:'10',title:t('先跑 CPU Gate','Run CPU gates first'),body:t('任务合同、manifest schema、adapter 身份和 index fingerprint 没过，不启动 GPU。','Do not launch GPU work until task contracts, manifest schemas, adapter identities, and the index fingerprint pass.'),code:'python3 scripts/validate_run_manifest.py templates/run-manifest.example.json\npython3 -m unittest discover -s tests -v\ngit diff --check'},
  {n:'11',title:t('运行真实 WebShop evaluator','Run the real WebShop evaluator'),body:t('Phase G 使用同一模型 revision、同一 evaluator、同一 dtype 与独立 fresh model state 比较 base / adapter_1x / cumulative。','Phase G compares base, adapter_1x, and cumulative with one model revision, evaluator, dtype, and fresh model state per arm.'),code:'python3 scripts/openevo_webshop/run_parametric_eval.py \\\n  --seed-root "$SEED_ROOT" \\\n  --task-manifest "$RUN_ROOT/task-manifest.json" \\\n  --access-ledger "$RUN_ROOT/task-access-ledger.json" \\\n  --adapter-one "$ADAPTER_1X" \\\n  --adapter-cumulative "$ADAPTER_CUM" \\\n  --gpu-uuid "$GPU_UUID" \\\n  --output "$RUN_ROOT"'},
  {n:'12',title:t('验收证据并进入下一 Gate','Validate evidence and advance'),body:t('每个 episode、summary、Run Manifest、adapter digest 和 W&B run 都要能追溯。Phase G 已完成且三臂均为 0；当前下一步是 Phase H0 natural-success search。','Episodes, summary, Run Manifest, adapter digests, and W&B runs must remain traceable. Phase G is complete with all arms at zero; the next gate is Phase H0 natural-success search.'),code:'find "$RUN_ROOT" -maxdepth 2 -type f | sort\npython3 scripts/validate_run_manifest.py "$RUN_ROOT/run-manifest.json"'},
] as const;
---
<section class="repro-guide" aria-labelledby="repro-title">
  <header class="hero"><span>OpenEvo · WebShop / ALFWorld</span><h1 id="repro-title">{t('OpenEvo 实验复现指南','OpenEvo experiment reproduction guide')}</h1><p>{t('从服务器权限、持久工作区和代码边界开始，再进入 WebShop / ALFWorld 环境、任务合同、GPU evaluator 与实验凭据。交互图负责建立心智模型，下面的 Gate 负责真正复现。','Start with server authority, persistent workspace, and code boundaries, then move into WebShop / ALFWorld environments, task contracts, the GPU evaluator, and experimental evidence. Interactive figures build the mental model; the gates below are the executable reproduction path.')}</p><nav class="hero-actions" aria-label={t('复现入口','Reproduction entry points')}><a href={p('/research/seed-openevo/results/')}>{t('当前实验结果 →','Current results →')}</a><a href="#repro-gates">{t('打开 12 个 Gate ↓','Open the 12 gates ↓')}</a></nav></header>
  <InteractiveResearchExplainer locale={locale} kind="server" client:visible />
  <section class="repo-map" aria-labelledby="repo-map-title" data-ui-audit="contrast layout"><header><span>{t('代码与机器的关系','Code / machine boundary')}</span><h2 id="repo-map-title">{t('四层仓库结构','Four repository layers')}</h2></header><ol class="repo-flow"><li class="infra" data-ui-audit-item><small>01 · MACHINE</small><strong>mykcs/zju-server</strong><p>{t('SSH、账号、Docker 权限、GPU / 存储事实','SSH, accounts, Docker authority, GPU/storage facts')}</p></li><li class="env" data-ui-audit-item><small>02 · PORTABLE ENV</small><strong>wangrui-server-environment</strong><p>{t('环境定义、恢复与可重建配置','environment definitions and recovery')}</p></li><li class="exp" data-ui-audit-item><small>03 · EXPERIMENT</small><strong>openevo-experiment</strong><p>{t('WebShop adapter、campaign、manifest、结果','WebShop adapter, campaigns, manifests, results')}</p></li><li class="core" data-ui-audit-item><small>04 · UPSTREAM CORE</small><strong>CompLifeLab-ZJU/OpenEvo</strong><p>{t('固定 SHA 的 Core / trainer','pinned Core / trainer')}</p></li></ol><aside>{t('seed3090 与 openevo-webshop 现在是历史迁移来源，不再是新的实验入口。','seed3090 and openevo-webshop are historical migration sources rather than new experiment entrypoints.')}</aside></section>
  <AgentEnvironmentTrajectory locale={locale} context="reproduction" />
  <section class="gate-section" id="repro-gates" aria-labelledby="gates-title"><header><span>{t('从空服务器到真实实验','From server to real experiment')}</span><h2 id="gates-title">{t('12 个复现 Gate','12 reproduction gates')}</h2><p>{t('每一步都有明确的进入条件、可执行检查与下一步证据。它们是 runbook，不是装饰性卡片。','Each step has a concrete entry condition, executable check, and evidence for what follows. This is a runbook, not a decorative card list.')}</p></header><ol class="gate-runbook" data-ui-audit="contrast layout">{gates.map((g)=><li data-ui-audit-item><div class="gate-num">{g.n}</div><div class="gate-copy"><h3>{g.title}</h3><p>{g.body}</p><pre><code>{g.code}</code></pre></div></li>)}</ol></section>
  <InteractiveResearchExplainer locale={locale} kind="compare" client:visible />
  <aside class="gap"><strong>{t('仍需工程化的缺口','Remaining reproducibility engineering gap')}</strong><p>{t('当前仓库已经严格验证 indexes_1k，但从公开 1k JSON 一键生成 resources_1k 并构建 Lucene indexes_1k 的完整 build recipe 仍应提升成独立脚本。这里明确保留缺口，不伪造未经验证的一键命令。','The repository strictly verifies indexes_1k, but the complete one-command recipe that generates resources_1k and builds Lucene indexes_1k from the public 1k JSON files still needs to become a dedicated script. The guide keeps this gap explicit instead of inventing an unverified command.')}</p></aside>
</section>
<style>
.repro-guide{--guide-rule:color-mix(in srgb,var(--line) 88%,transparent);width:min(1220px,calc(100% - 1rem));margin:1rem auto 5rem}.hero{width:min(1120px,calc(100% - 1rem));padding:1.6rem 0 2.2rem}.hero>span,.repo-map>header>span,.gate-section>header>span{color:var(--accent-deep);font:850 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.hero h1{margin:.45rem 0 .65rem}.hero p{max-width:78ch;margin:0;color:var(--muted);font-size:.94rem;line-height:1.72}.hero-actions{display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:1.15rem}.hero-actions a{color:var(--accent-deep);font-size:.74rem;font-weight:780;text-underline-offset:.2em}.repo-map,.gate-section{width:min(1120px,calc(100% - 1rem));margin:3.8rem auto 2.8rem;padding-top:1.2rem;border-top:1px solid var(--guide-rule)}.repo-map h2,.gate-section h2{margin:.3rem 0 .75rem}.repo-map>header,.gate-section>header{max-width:820px}.gate-section>header>p{margin:.4rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.55}.repo-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:1.2rem 0 0;padding:0;border-block:1px solid var(--guide-rule);list-style:none}.repo-flow li{position:relative;min-height:130px;padding:1rem .9rem 1rem 1rem;border-left:3px solid transparent}.repo-flow li+li{border-left-width:1px;border-left-color:var(--guide-rule)}.repo-flow li:not(:last-child):after{content:"";position:absolute;z-index:2;right:-5px;top:50%;width:8px;height:8px;border-top:1.5px solid var(--muted);border-right:1.5px solid var(--muted);background:var(--surface);transform:translateY(-50%) rotate(45deg)}.repo-flow li.infra{box-shadow:inset 3px 0 #2563eb}.repo-flow li.env{box-shadow:inset 3px 0 #0891b2}.repo-flow li.exp{box-shadow:inset 3px 0 #7c3aed}.repo-flow li.core{box-shadow:inset 3px 0 #d97706}.repo-flow small,.repo-flow strong{display:block}.repo-flow small{color:var(--muted);font-size:.54rem;letter-spacing:.04em}.repo-flow strong{margin:.45rem 0 .35rem;font-size:.68rem;overflow-wrap:anywhere}.repo-flow p{margin:0;color:var(--muted);font-size:.62rem;line-height:1.45}.repo-map>aside{margin:.8rem 0 0;padding:.6rem 0 .6rem .8rem;border-left:3px solid var(--muted);color:var(--muted);font-size:.66rem;line-height:1.5}.gate-runbook{margin:1.4rem 0 0;padding:0;border-top:1px solid var(--guide-rule);list-style:none}.gate-runbook>li{display:grid;grid-template-columns:58px minmax(0,1fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--guide-rule)}.gate-num{padding-top:.1rem;color:var(--accent-deep);font:850 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.gate-copy{min-width:0}.gate-copy h3{margin:0 0 .35rem;font-size:.86rem}.gate-copy p{max-width:78ch;margin:0;color:var(--muted);font-size:.72rem;line-height:1.55}.gate-copy pre{overflow:auto;margin:.65rem 0 0;padding:.65rem .75rem;border-left:3px solid color-mix(in srgb,var(--accent-deep) 65%,var(--line));background:var(--surface-muted);font-size:.62rem;line-height:1.5}.gap{width:min(1120px,calc(100% - 1rem));margin:2.8rem auto 0;padding:1rem 0 1rem 1rem;border-block:1px solid var(--guide-rule);border-left:4px solid #d97706}.gap strong{font-size:.72rem}.gap p{max-width:82ch;margin:.35rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.55}@media(max-width:820px){.repo-flow{grid-template-columns:1fr}.repo-flow li,.repo-flow li+li{min-height:0;border-left:0;border-top:1px solid var(--guide-rule);box-shadow:inset 3px 0 var(--line)}.repo-flow li:first-child{border-top:0}.repo-flow li:not(:last-child):after{right:auto;left:18px;top:auto;bottom:-5px;transform:rotate(135deg)}.repo-flow li.infra{box-shadow:inset 3px 0 #2563eb}.repo-flow li.env{box-shadow:inset 3px 0 #0891b2}.repo-flow li.exp{box-shadow:inset 3px 0 #7c3aed}.repo-flow li.core{box-shadow:inset 3px 0 #d97706}}@media(max-width:560px){.repro-guide{width:100%}.hero,.repo-map,.gate-section,.gap{width:min(100% - 1rem,1120px)}.gate-runbook>li{grid-template-columns:40px minmax(0,1fr);gap:.6rem}.gate-copy pre{font-size:.58rem}}
</style>
