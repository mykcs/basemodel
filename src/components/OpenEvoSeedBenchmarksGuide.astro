---
import { localePath, type Locale } from '../i18n';
import { openEvoScientificState } from '../lib/openEvoScientificState';
import AgentEnvironmentTrajectory from './research/AgentEnvironmentTrajectory.astro';
import InteractiveResearchExplainer from './research/InteractiveResearchExplainer.tsx';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const gates = [
  {n:'01',title:t('确认账号角色','Confirm account role'),body:t('日常科研使用普通账号；只有明确获授权的服务器 / Docker 控制面工作才进入控制账号。公开指南不发布真实 SSH alias、hostname 或端口。','Use an ordinary account for daily science; enter a control account only for explicitly authorized server/Docker control-plane work. The public guide does not publish real SSH aliases, hostnames, or ports.'),code:'ssh <ordinary-account>\nwhoami && id\n# approved control-plane work only:\nssh <approved-control-account>'},
  {n:'02',title:t('确认权限边界','Verify authority boundaries'),body:t('先判断自己处于物理 host、控制容器还是实验容器，再检查 Docker socket / GPU 可见性。技术能力不等于项目授权。','Identify whether you are on a physical host, control container, or experiment container before checking Docker-socket/GPU visibility. Technical capability is not project authorization.'),code:'hostname\nid\ntest -S /var/run/docker.sock && echo docker-socket-visible || true\nnvidia-smi -L'},
  {n:'03',title:t('建立持久工作区','Bootstrap persistent workspace'),body:t('代码、环境、缓存、数据与实验输出都应落在普通科研用户拥有的持久目录，而不是容器临时 home。真实项目路径由 zju-server 当前运行文档解析。','Code, environments, caches, data, and run outputs belong in a persistent directory owned by the ordinary research user rather than container-local home. Resolve the real project path from the current zju-server runbook.'),code:'export WORKSPACE=<approved-persistent-workspace>\ncd <zju-server-checkout>\nbash scripts/bootstrap-research-workspace.sh\ncd "$WORKSPACE"\nprintf "probe\\n" > .write-test && rm .write-test'},
  {n:'04',title:t('重建四层仓库','Reconstruct the four repository layers'),body:t('zju-server 管机器事实；wangrui-server-environment 管可重建环境；openevo-experiment 管实验；OpenEvo Core 作为外部固定 SHA 依赖。','zju-server owns machine facts; wangrui-server-environment owns portable environment definitions; openevo-experiment owns experiments; OpenEvo Core remains an external pinned dependency.'),code:'mkdir -p "$WORKSPACE/repos" "$WORKSPACE/runtime/src"\n# clone exact repositories into $WORKSPACE/repos\n# record git rev-parse HEAD for every active checkout'},
  {n:'05',title:t('验证 RTX 5090 实验容器','Validate the RTX 5090 experiment container'),body:t('先验证 non-root UID/GID、BF16、matmul、backward、optimizer 和 bind-mount 写盘；不要把完整 WebShop runtime 安装进控制容器。','First validate non-root UID/GID, BF16, matmul, backward, optimizer, and bind-mounted writes; do not turn the control container into the full WebShop runtime.'),code:'cd "$WORKSPACE/repos/openevo-experiment"\n./scripts/build_experiment_image.sh\nGPU_REQUEST=device=0 ./scripts/run_gpu_smoke.sh\n./scripts/run_bind_mount_identity_gate.sh'},
  {n:'06',title:t('固定 OpenEvo 与 Qwen','Pin OpenEvo and Qwen'),body:t('历史机制证据使用过固定的 OpenEvo 与 Qwen revision；新的 run 必须从实际 checkout 重新记录精确 SHA / revision，而不是复制旧值。','Historical mechanism evidence used pinned OpenEvo and Qwen revisions; every new run must record exact SHA/revision from the actual checkout rather than copying old values.'),code:'git -C "$OPEN_EVO_ROOT" rev-parse HEAD\npython3 scripts/experiment_startup_report.py'},
  {n:'07',title:t('建立隔离 Python runtime','Build an isolated Python runtime'),body:t('官方 SEED WebShop 环境与 OpenEvo adapter runtime 可能有不同 Python / dependency 合同；按各自 lock/requirements 重建，不要混成一个全局环境。','The official SEED WebShop environment and OpenEvo adapter runtime may have different Python/dependency contracts. Rebuild from their own locks/requirements instead of merging them into one global environment.'),code:'python3 -m venv "$WORKSPACE/runtime/envs/openevo"\nsource "$WORKSPACE/runtime/envs/openevo/bin/activate"\npip install -e vendor/openevo-webshop\npip install -r scripts/openevo_webshop/runtime-overlay-requirements.txt'},
  {n:'08',title:t('准备 WebShop 数据与索引','Prepare WebShop data and indexes'),body:t('冻结的 1k 商品环境需要三份 JSON、resources_1k 与 Lucene indexes_1k 的 hash / behavior fingerprint；目录名不是 benchmark identity。','The frozen 1k-product environment needs hashes/behavior fingerprints for the three JSON files, resources_1k, and Lucene indexes_1k; directory names are not benchmark identity.'),code:'python3 scripts/openevo_webshop/prepare_webshop_data.py --validate-only --write-manifest "$WEBSHOP_DATA"\npython3 scripts/openevo_webshop/verify_indexes_1k.py \\\n  --index "$WEBSHOP_ROOT/search_engine/indexes_1k" \\\n  --catalog "$WEBSHOP_ROOT/data/items_shuffle_1000.json" \\\n  --resources "$WEBSHOP_ROOT/search_engine/resources_1k/documents.jsonl" \\\n  --fingerprint-out "$RUN_ROOT/indexes-1k-fingerprint.json"'},
  {n:'09',title:t('冻结任务合同','Freeze the task contract'),body:t('environment seed、generation seed、task IDs、prompt、parser、max steps 与 evaluator 必须先固定，再比较 base / adapter。','Freeze environment seed, generation seeds, task IDs, prompt, parser, max steps, and evaluator before comparing base and adapters.'),code:'python3 scripts/openevo_webshop/webshop_task_manifest.py capture --seed-root "$SEED_ROOT" --out "$RUN_ROOT/task-manifest.json" --ledger-out "$RUN_ROOT/task-access-ledger.json"\npython3 scripts/openevo_webshop/webshop_task_manifest.py verify "$RUN_ROOT/task-manifest.json"'},
  {n:'10',title:t('先跑 CPU Gate','Run CPU gates first'),body:t('任务合同、manifest schema、adapter identity 和 index fingerprint 没过，不启动 GPU。','Do not launch GPU work until task contracts, manifest schemas, adapter identity, and the index fingerprint pass.'),code:'python3 scripts/validate_run_manifest.py templates/run-manifest.example.json\npython3 -m unittest discover -s tests -v\ngit diff --check'},
  {n:'11',title:t('运行真实 evaluator','Run the real evaluator'),body:t('历史 Phase G 使用同一模型 revision、evaluator、dtype 与独立 fresh model state 比较 base / adapter_1x / cumulative。新的 campaign 必须使用自己的 preregistration 和 manifest。','Historical Phase G compared base, adapter_1x, and cumulative with one model revision, evaluator, dtype, and fresh model state per arm. A new campaign must use its own preregistration and manifest.'),code:'python3 scripts/openevo_webshop/run_parametric_eval.py \\\n  --seed-root "$SEED_ROOT" \\\n  --task-manifest "$RUN_ROOT/task-manifest.json" \\\n  --access-ledger "$RUN_ROOT/task-access-ledger.json" \\\n  --adapter-one "$ADAPTER_1X" \\\n  --adapter-cumulative "$ADAPTER_CUM" \\\n  --gpu-uuid "$GPU_UUID" \\\n  --output "$RUN_ROOT"'},
  {n:'12',title:t('验收证据与解析实时状态','Validate evidence and resolve live state'),body:t('episode、summary、Run Manifest、adapter digest 与 W&B run 都要可追溯。Phase G / H0 只作为历史证据；实时下一步从实际 openevo-experiment branch 的 current-campaign 与最新 reconciliation/result 解析。','Episodes, summaries, Run Manifests, adapter digests, and W&B runs must remain traceable. Phase G / H0 are historical evidence; resolve the live next step from current-campaign and the latest reconciliation/result on the openevo-experiment branch actually in use.'),code:'find "$RUN_ROOT" -maxdepth 2 -type f | sort\npython3 scripts/validate_run_manifest.py "$RUN_ROOT/run-manifest.json"\ngit -C "$WORKSPACE/repos/openevo-experiment" rev-parse HEAD\n# read configs/experiment/current-campaign.json from that exact branch'},
] as const;
---
<section class="repro-guide" aria-labelledby="repro-title">
  <header class="hero">
    <span>OpenEvo · WebShop / ALFWorld</span>
    <h1 id="repro-title">{t('OpenEvo 实验复现指南','OpenEvo experiment reproduction guide')}</h1>
    <p>{t('从权限边界、持久工作区和代码身份开始，再进入 WebShop / ALFWorld 环境、任务合同、GPU evaluator 与实验凭据。公开页面只给可迁移的角色与占位路径；真实服务器身份和路径回 zju-server 当前运行文档解析。','Start from authority boundaries, persistent workspace, and code identity, then move into WebShop / ALFWorld environments, task contracts, the GPU evaluator, and experimental evidence. Public pages expose portable roles and placeholder paths only; resolve real server identities and paths from the current zju-server runbook.')}</p>
    <nav class="hero-actions" aria-label={t('复现入口','Reproduction entry points')}><a href={p('/research/seed-openevo/results/')}>{t('实验状态与结果 →','Experiment state and results →')}</a><a href="#repro-gates">{t('12 个复现 Gate ↓','12 reproduction gates ↓')}</a><a href={openEvoScientificState.currentCampaignUrl} target="_blank" rel="noreferrer">default-main current-campaign ↗</a></nav>
  </header>

  <InteractiveResearchExplainer locale={locale} kind="server" client:visible />

  <section class="repo-map" aria-labelledby="repo-map-title" data-ui-audit="contrast layout">
    <header><span>{t('代码与机器的关系','Code / machine boundary')}</span><h2 id="repo-map-title">{t('四层仓库结构','Four repository layers')}</h2></header>
    <ol class="repo-flow">
      <li class="infra" data-ui-audit-item><small>01 · MACHINE</small><strong>mykcs/zju-server</strong><p>{t('SSH 角色、Docker 权限、GPU / 存储与授权事实','SSH roles, Docker authority, GPU/storage and authorization facts')}</p></li>
      <li class="env" data-ui-audit-item><small>02 · PORTABLE ENV</small><strong>wangrui-server-environment</strong><p>{t('环境定义、恢复与可重建配置','environment definitions and recovery')}</p></li>
      <li class="exp" data-ui-audit-item><small>03 · EXPERIMENT</small><strong>openevo-experiment</strong><p>{t('campaign、manifest、preregistration、结果','campaigns, manifests, preregistration, results')}</p></li>
      <li class="core" data-ui-audit-item><small>04 · UPSTREAM CORE</small><strong>CompLifeLab-ZJU/OpenEvo</strong><p>{t('固定 SHA 的 Core / trainer','pinned Core / trainer')}</p></li>
    </ol>
    <aside>{t('seed3090 与 openevo-webshop 是历史迁移来源，不是新的实验入口。实时科学状态：实际 branch → current-campaign → reconciliation/result。','seed3090 and openevo-webshop are historical migration sources, not new experiment entry points. Live scientific state: actual branch → current-campaign → reconciliation/result.')}</aside>
  </section>

  <AgentEnvironmentTrajectory locale={locale} context="reproduction" />

  <section class="gate-section" id="repro-gates" aria-labelledby="gates-title">
    <header><span>{t('从空服务器到真实实验','From server to real experiment')}</span><h2 id="gates-title">{t('12 个复现 Gate','12 reproduction gates')}</h2><p>{t('每一步都有进入条件、可执行检查与下一步证据。代码块按内容自然高度显示，不用固定空白撑齐卡片。','Each step has an entry condition, executable check, and evidence for what follows. Code blocks use content-driven height rather than fixed empty space.')}</p></header>
    <ol class="gate-runbook" data-ui-audit="contrast layout">{gates.map((g)=><li data-ui-audit-item><div class="gate-num">{g.n}</div><div class="gate-copy"><h3>{g.title}</h3><p>{g.body}</p><pre><code>{g.code}</code></pre></div></li>)}</ol>
  </section>

  <InteractiveResearchExplainer locale={locale} kind="compare" client:visible />

  <aside class="gap"><strong>{t('仍需工程化的缺口','Remaining reproducibility engineering gap')}</strong><p>{t('仓库已经严格验证 indexes_1k，但从公开 1k JSON 一键生成 resources_1k 并构建 Lucene indexes_1k 的完整 build recipe 仍应提升成独立脚本。这里保留缺口，不伪造未经验证的一键命令。','The repository strictly verifies indexes_1k, but the complete one-command recipe that generates resources_1k and builds Lucene indexes_1k from the public 1k JSON files still needs to become a dedicated script. The guide keeps this gap explicit instead of inventing an unverified command.')}</p></aside>
</section>

<style>
.repro-guide{--guide-rule:color-mix(in srgb,var(--line) 88%,transparent);width:min(1220px,calc(100% - 1rem));margin:1rem auto 5rem}.hero,.repo-map,.gate-section,.gap{width:min(1120px,calc(100% - 1rem));margin-inline:auto}.hero{padding:1.6rem 0 2.2rem}.hero>span,.repo-map>header>span,.gate-section>header>span{color:var(--accent-deep);font:850 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.hero h1{margin:.45rem 0 .65rem}.hero p{max-width:78ch;margin:0;color:var(--muted);font-size:.94rem;line-height:1.72}.hero-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.15rem}.hero-actions a{color:var(--accent-deep);font-size:.74rem;font-weight:780;text-underline-offset:.2em}.repo-map,.gate-section{margin-top:3rem;padding-top:1.2rem;border-top:1px solid var(--guide-rule)}.repo-map h2,.gate-section h2{margin:.3rem 0 .75rem}.repo-map>header,.gate-section>header{max-width:820px}.repo-map>aside,.gate-section>header>p{max-width:82ch;color:var(--muted);font-size:.78rem;line-height:1.55}.repo-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:1.2rem 0;padding:0;border-block:1px solid var(--guide-rule);list-style:none}.repo-flow li{position:relative;min-height:126px;padding:1rem;border-left:3px solid transparent}.repo-flow li+li{border-left-width:1px;border-left-color:var(--guide-rule)}.repo-flow li.infra{box-shadow:inset 3px 0 #2563eb}.repo-flow li.env{box-shadow:inset 3px 0 #0891b2}.repo-flow li.exp{box-shadow:inset 3px 0 #7c3aed}.repo-flow li.core{box-shadow:inset 3px 0 #d97706}.repo-flow small,.repo-flow strong{display:block}.repo-flow small{color:var(--muted);font-size:.56rem}.repo-flow strong{margin-top:.45rem;font-size:.78rem;overflow-wrap:anywhere}.repo-flow p{margin:.4rem 0 0;color:var(--muted);font-size:.66rem;line-height:1.45}.gate-runbook{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:1.2rem 0 0;padding:0;list-style:none}.gate-runbook li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.65rem;align-content:start;padding:.9rem;border:1px solid var(--guide-rule);border-radius:13px;background:var(--surface)}.gate-num{color:var(--accent-deep);font:850 .66rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}.gate-copy h3{margin:0 0 .4rem;font-size:.88rem}.gate-copy p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.5}.gate-copy pre{min-height:0!important;height:auto!important;margin:.75rem 0 0;padding:.75rem;overflow:auto;border:1px solid var(--line);border-radius:9px;background:var(--surface-muted);white-space:pre}.gate-copy code{font-size:.64rem;line-height:1.5}.gap{margin-top:2.4rem;padding:1rem;border:1px solid var(--guide-rule);border-radius:13px;background:var(--surface-muted)}.gap strong{font-size:.78rem}.gap p{margin:.35rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}@media(max-width:900px){.repo-flow,.gate-runbook{grid-template-columns:1fr 1fr}}@media(max-width:640px){.repro-guide{width:min(100% - .5rem,1220px)}.repo-flow,.gate-runbook{grid-template-columns:1fr}.repo-flow li+li{border-left:0;border-top:1px solid var(--guide-rule)}.hero-actions{display:grid}.hero-actions a{min-height:40px;display:flex;align-items:center}.gate-runbook li{grid-template-columns:1.65rem minmax(0,1fr)}}
</style>