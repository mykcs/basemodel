---
import { localePath, type Locale } from '../i18n';
import AgentMechanismDialogues from './research/AgentMechanismDialogues.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const activeRoot = 'https://github.com/mykcs/openevo-experiment/blob/main';
const seedRoot = 'https://github.com/mykcs/seed3090/blob/main';
const bridgeRoot = 'https://github.com/mykcs/openevo-webshop/blob/main';

const steps = [
  { n:'01', title:t('固定实验身份','Pin experiment identity'), body:t('记录 openevo-experiment commit、OpenEvo SHA、Qwen2.5-3B revision、campaign、任务 split 与 adapter 身份。','Record the openevo-experiment commit, OpenEvo SHA, Qwen2.5-3B revision, campaign, task split, and adapter identity.') },
  { n:'02', title:t('确认运行环境','Validate runtime'), body:t('检查 Python、CUDA、WebShop 依赖、模型加载与任务合同；服务器可见 GPU 数量与本次实验分配分开记录。','Check Python, CUDA, WebShop dependencies, model loading, and the task contract; record visible server inventory separately from the experiment allocation.') },
  { n:'03', title:t('运行 WebShop','Run WebShop'), body:t('使用冻结的 prompt、parser、evaluator、step budget 与 generation seeds；每个 episode 保存原始动作、观察、score、termination 和 fallback。','Use frozen prompts, parser, evaluator, step budget, and generation seeds; preserve raw actions, observations, score, termination, and fallbacks for every episode.') },
  { n:'04', title:t('保存参数状态','Preserve parameter state'), body:t('adapter 训练、fresh reload、参数 digest 与累计 component 都必须有可追溯记录；不能只保存一个文件名。','Adapter training, fresh reload, parameter digests, and cumulative components must be traceable; a filename alone is not enough.') },
  { n:'05', title:t('比较实验结果','Compare outcomes'), body:t('先比较同合同下的 base / adapter，再分析失败分布。Phase G 已完成 12 个 episodes；三臂 score / win 均为 0。','Compare base and adapter under one contract before studying failure distributions. Phase G completed 12 episodes; all three arms had zero score/win outcomes.') },
  { n:'06', title:t('进入 Phase H0','Enter Phase H0'), body:t('在新的 train-only WebShop tasks 上先搜索 64–128 个有效 rollouts；仍无成功时最多扩到 256，再决定成功监督或 teacher bootstrap。','Search 64–128 valid rollouts on new train-only WebShop tasks; extend to at most 256 if success remains zero, then choose successful supervision or teacher bootstrap.') },
] as const;
---

<section class="seed-benchmark-guide" aria-labelledby="seed-benchmark-guide-title">
  <header class="seed-guide-hero">
    <div>
      <span class="seed-guide-kicker">OpenEvo · WebShop / ALFWorld</span>
      <h1 id="seed-benchmark-guide-title">{t('OpenEvo 实验复现指南', 'OpenEvo experiment reproduction guide')}</h1>
      <p>{t('当前执行主线来自 openevo-experiment。指南先覆盖 WebShop 的真实模型、参数更新、任务评测和结果记录；ALFWorld 在当前 WebShop 科学门槛之后接入。','The active execution line comes from openevo-experiment. This guide first covers real-model WebShop execution, parameter updates, task evaluation, and result records; ALFWorld follows after the current WebShop scientific gate.')}</p>
      <div class="seed-guide-actions"><a class="button button-primary" href={p('/research/seed-openevo/results/')}>{t('当前实验结果 →','Current experiment results →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/experiment/')}>{t('实验入口','Experiment entry')}</a></div>
    </div>
    <aside class="current-hardware"><span>{t('当前实验分配','Current experiment allocation')}</span><strong>5× RTX 5090</strong><p>{t('OpenEvo 服务器资产记录可见 8×RTX5090；本次实验使用其中 5 张。','OpenEvo server inventory records 8 visible RTX5090 GPUs; this experiment uses 5 of them.')}</p><small>{t('历史：RTX6 · 4×RTX3090','Historical: RTX6 · 4×RTX3090')}</small></aside>
  </header>

  <section class="guide-section" aria-labelledby="topology-title">
    <div class="section-heading"><span>01</span><div><small>{t('环境','Environment')}</small><h2 id="topology-title">{t('实验拓扑', 'Experiment topology')}</h2></div></div>
    <div class="topology">
      <article><small>{t('实验仓库','Experiment repo')}</small><strong>openevo-experiment</strong><span>{t('campaign、配置、Run Manifest 与结果证据','campaign, configuration, Run Manifests, and result evidence')}</span></article>
      <i aria-hidden="true">→</i>
      <article><small>{t('OpenEvo 服务器','OpenEvo server')}</small><strong>5× RTX 5090</strong><span>{t('当前实验分配；服务器总可见库存单独记录','current allocation; total visible inventory is recorded separately')}</span></article>
      <i aria-hidden="true">→</i>
      <article><small>WebShop</small><strong>Qwen2.5-3B-Instruct</strong><span>{t('冻结任务合同、parser、evaluator 与 generation seeds','frozen task contract, parser, evaluator, and generation seeds')}</span></article>
      <i aria-hidden="true">→</i>
      <article><small>{t('证据','Evidence')}</small><strong>Run Manifest + JSON + W&B</strong><span>{t('本地 provenance 为核心记录，W&B 负责观测','local provenance is canonical; W&B provides observability')}</span></article>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="steps-title">
    <div class="section-heading"><span>02</span><div><small>{t('执行','Execution')}</small><h2 id="steps-title">{t('复现步骤', 'Reproduction steps')}</h2></div></div>
    <ol class="step-list">{steps.map((step)=><li><span>{step.n}</span><div><strong>{step.title}</strong><p>{step.body}</p></div></li>)}</ol>
  </section>

  <section class="guide-section" aria-labelledby="results-title">
    <div class="section-heading"><span>03</span><div><small>{t('当前状态','Current status')}</small><h2 id="results-title">{t('Phase G 与 Phase H0', 'Phase G and Phase H0')}</h2></div></div>
    <div class="phase-grid"><article><span>Phase G · completed</span><strong>2 goals × 2 seeds × 3 arms = 12 episodes</strong><p>{t('base、adapter1x、cumulative 的 mean score 均为 0.000，wins 均为 0/4。','base, adapter1x, and cumulative all had mean score 0.000 and 0/4 wins.')}</p></article><article><span>Phase H0 · next</span><strong>Natural Success Search</strong><p>{t('先判断 Qwen2.5-3B 在新 train-only tasks 上能否产生自然成功经验，再决定监督数据策略。','First determine whether Qwen2.5-3B can produce natural successful experience on new train-only tasks, then choose the supervision-data strategy.')}</p></article></div>
  </section>

  <section class="guide-section" aria-labelledby="history-title">
    <div class="section-heading"><span>04</span><div><small>{t('来源迁移','Source migration')}</small><h2 id="history-title">{t('历史仓库', 'Historical repositories')}</h2></div></div>
    <div class="history-grid"><article><code>seed3090</code><strong>{t('RTX6 / 4×3090 历史实验','RTX6 / 4×3090 historical experiments')}</strong><p>{t('保留 WebShop / ALFWorld bring-up、失败轨迹和早期参数实验。','Preserves WebShop/ALFWorld bring-up, failure traces, and early parametric experiments.')}</p><a href={`${seedRoot}/README.md`}>README ↗</a></article><article><code>openevo-webshop</code><strong>{t('WebShop × SD-LoRA 迁移仓库','WebShop × SD-LoRA migration repository')}</strong><p>{t('保留 runner、dataset adapter 与迁移前的 WebShop 诊断。','Preserves the runner, dataset adapter, and pre-migration WebShop diagnostics.')}</p><a href={`${bridgeRoot}/README.md`}>README ↗</a></article><article><code>openevo-experiment</code><strong>{t('当前实验仓库','Current experiment repository')}</strong><p>{t('新的实验开发、campaign 与结论从这里继续。','New experimental development, campaigns, and conclusions continue here.')}</p><a href={`${activeRoot}/README.md`}>README ↗</a></article></div>
  </section>

  <AgentMechanismDialogues locale={locale} />
</section>

<style>
  .seed-benchmark-guide{width:min(1180px,calc(100% - 2rem));margin:1.2rem auto 5rem}.seed-guide-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:1rem;align-items:start;padding:clamp(1.2rem,3vw,2rem);border:1px solid var(--line);border-radius:20px;background:var(--surface)}.seed-guide-kicker{color:var(--accent-deep);font-size:.72rem;font-weight:800}.seed-guide-hero h1{margin:.5rem 0 .7rem}.seed-guide-hero>div>p{max-width:72ch;margin:0;color:var(--muted);line-height:1.7}.seed-guide-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.current-hardware{padding:1rem;border:1px solid var(--line);border-radius:13px;background:var(--surface-muted)}.current-hardware span,.current-hardware strong,.current-hardware small{display:block}.current-hardware span,.current-hardware small{color:var(--muted);font-size:.68rem}.current-hardware strong{margin:.4rem 0;font-size:1.35rem}.current-hardware p{margin:.4rem 0;color:var(--muted);font-size:.74rem;line-height:1.5}.guide-section{padding:1.6rem 0;border-top:1px solid var(--line)}.section-heading{display:grid;grid-template-columns:2.4rem minmax(0,1fr);gap:.6rem;margin-bottom:1rem}.section-heading>span{color:var(--accent-deep);font:800 .7rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.section-heading small{display:block;color:var(--muted);font-size:.66rem}.section-heading h2{margin:.15rem 0 0}.topology{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.4rem;align-items:center}.topology article{grid-column:span 1;padding:.8rem;border:1px solid var(--line);border-radius:12px}.topology i{text-align:center;color:var(--accent-deep);font-style:normal}.topology small,.topology strong,.topology span{display:block}.topology small{color:var(--muted);font-size:.62rem}.topology strong{margin:.35rem 0;font-size:.78rem}.topology span{color:var(--muted);font-size:.66rem;line-height:1.4}.step-list{display:grid;gap:.5rem;margin:0;padding:0;list-style:none}.step-list li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.7rem;padding:.8rem;border:1px solid var(--line);border-radius:12px}.step-list li>span{color:var(--accent-deep);font:800 .68rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.step-list strong{font-size:.8rem}.step-list p{margin:.3rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}.phase-grid,.history-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.history-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.phase-grid article,.history-grid article{padding:.9rem;border:1px solid var(--line);border-radius:13px}.phase-grid span,.history-grid code{color:var(--accent-deep);font-size:.68rem;font-weight:800}.phase-grid strong,.history-grid strong{display:block;margin:.45rem 0;font-size:.82rem}.phase-grid p,.history-grid p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.5}.history-grid a{display:inline-block;margin-top:.55rem;font-size:.7rem}@media(max-width:900px){.seed-guide-hero{grid-template-columns:1fr}.topology{grid-template-columns:1fr}.topology i{transform:rotate(90deg)}.phase-grid,.history-grid{grid-template-columns:1fr}}@media(max-width:560px){.seed-benchmark-guide{width:min(100% - 1rem,1180px)}}
</style>
