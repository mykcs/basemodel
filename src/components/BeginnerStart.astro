---
import { localePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const guideHref = localePath(locale, '/guide/');
const seedPaperHref = localePath(locale, '/papers/seed/');
const steps = [
  {
    number: '01',
    title: t('先看懂 SEED 在 ALFWorld 里到底“跑”了什么', 'First see what SEED actually runs inside ALFWorld'),
    body: t('用一个真实任务把 policy、action、environment、trajectory 和 reward 串起来；不先背 Agent 术语表。', 'Use one real task to connect policy, action, environment, trajectory, and reward instead of memorizing an agent glossary first.'),
    href: `${guideHref}#agent-runtime-loop`,
    action: t('看 Agent 运行循环', 'See the agent runtime loop'),
  },
  {
    number: '02',
    title: t('再看 SEED 为什么要做 hindsight skill + OPD / GRPO', 'Then see why SEED uses hindsight skills + OPD / GRPO'),
    body: t('先分清“一次 episode 在运行”和“很多 rollouts 之后更新权重”，再理解稀疏 reward 为什么需要更密的学习信号。', 'Separate one episode running from weight updates across many rollouts, then understand why sparse rewards motivate a denser learning signal.'),
    href: `${guideHref}#agent-training`,
    action: t('看运行 / 训练双循环', 'See runtime vs training'),
  },
  {
    number: '03',
    title: t('最后真正复现：ALFWorld → WebShop → 算力 → 验证', 'Then reproduce it: ALFWorld → WebShop → compute → validation'),
    body: t('从官方环境命令开始，先低成本跑通链路；只有要与论文主表比较时，才把目标升级到 8×A800 80GB 的严格复现。', 'Start from the official environment commands and prove the chain cheaply; only move to the paper’s 8×A800 80GB topology when the goal is main-table comparison.'),
    href: `${guideHref}#seed-reproduction`,
    action: t('进入 SEED 复现实战', 'Open the SEED reproduction route'),
  },
];
---
<section class="learning-start" aria-labelledby="learning-start-title">
  <div class="shell learning-start-inner">
    <div class="learning-start-copy">
      <span class="learning-start-kicker">{t('新手只跟一条主线 · 复现 SEED', 'One beginner thread · reproduce SEED')}</span>
      <h2 id="learning-start-title">{t('不要同时学十件事：用一篇论文把 Agent、模型、环境和 GPU 串起来', 'Do not learn ten disconnected things at once: use one paper to connect agents, models, environments, and GPUs')}</h2>
      <p>{t('模型筛选、家族、对比、论文、工作台和数据状态都不是独立功能。先把目标固定为“复现 SEED”，每个功能只回答这条复现链上的一个问题；走完一次，再把方法迁移到其他论文。', 'Model filtering, families, comparisons, papers, the workspace, and data status are not separate features. Fix the goal as “reproduce SEED”; each feature answers one question on that path. Transfer the workflow only after completing it once.')}</p>
      <a class="text-link" href={seedPaperHref}>{t('先看 SEED 论文案例', 'Open the SEED paper case')} →</a>
    </div>
    <ol class="learning-start-steps">
      {steps.map((step) => (
        <li>
          <a href={step.href}>
            <span class="learning-step-number" aria-hidden="true">{step.number}</span>
            <span class="learning-step-copy">
              <strong>{step.title}</strong>
              <small>{step.body}</small>
              <span class="learning-step-action">{step.action} →</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .learning-start-steps { grid-template-columns: 1fr; }
  .learning-start-steps a { min-height: 0; }
</style>
