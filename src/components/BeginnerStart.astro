---
import { localePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const guideHref = localePath(locale, '/guide/');
const seedWorkspaceHref = `${localePath(locale, '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1`;
const steps = [
  {
    number: '01',
    title: t('先用 10 分钟补齐 Agent 心智模型', 'Build the agent mental model in 10 minutes'),
    body: t('从你已经熟悉的 checkpoint、API、日志和指标，映射到 policy、tool、trajectory、reward；先看懂 Agent 到底怎么跑。', 'Map checkpoints, APIs, logs, and metrics you already know to policy, tools, trajectories, and rewards; first understand how an agent actually runs.'),
    href: `${guideHref}#agent-primer-title`,
    action: t('进入 Agent 101', 'Open Agent 101'),
  },
  {
    number: '02',
    title: t('再分清运行时和训练时', 'Then separate runtime from training'),
    body: t('一次任务里通常不更新权重；Agentic RL 是收集很多 rollouts、评分、更新 policy，再进入下一轮。', 'Weights usually stay fixed inside one task; agentic RL collects rollouts, scores them, updates the policy, then repeats.'),
    href: `${guideHref}#agent-training`,
    action: t('看运行 / 训练双循环', 'See the two loops'),
  },
  {
    number: '03',
    title: t('最后用 SEED 把概念落到真实论文', 'Finally ground the concepts in SEED'),
    body: t('看 hindsight-skill SFT、on-policy rollout、OPD + GRPO，再带着 GPU、开放权重和运行时约束进入工作台。', 'Connect hindsight-skill SFT, on-policy rollouts, and OPD + GRPO, then bring GPU, open-weight, and runtime constraints into the workspace.'),
    href: seedWorkspaceHref,
    action: t('打开预填 SEED 工作台', 'Open the prefilled SEED workspace'),
  },
];
---
<section class="learning-start" aria-labelledby="learning-start-title">
  <div class="shell learning-start-inner">
    <div class="learning-start-copy">
      <span class="learning-start-kicker">{t('懂机器学习，但不熟 Agent？从这里开始', 'Know ML, but new to agents? Start here')}</span>
      <h2 id="learning-start-title">{t('先看懂 Agent 怎么运行和学习，再谈该选哪个基础模型', 'Understand how agents run and learn before choosing a backbone')}</h2>
      <p>{t('这个站不是模型排行榜，也不会默认你完全不懂 AI。它假设你已经接触过 Transformer、微调、推理和 API，然后帮你补上 Agent、Agentic RL 和论文复现之间缺失的那一层。', 'This site is not a model leaderboard, and it does not assume you are new to AI. It assumes familiarity with Transformers, fine-tuning, inference, and APIs, then fills the missing layer between agents, agentic RL, and paper reproduction.')}</p>
    </div>
    <ol class="learning-start-steps">
      {steps.map((step) => (
        <li>
          <a href={step.href}>
            <span class="learning-step-number" aria-hidden="true">{step.number}</span>
            <span class="learning-step-copy">
              <strong>{step.title}</strong>
              <small>{step.body}</small>
              <span class="learning-step-action">{step.action} →</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .learning-start-steps { grid-template-columns: 1fr; }
  .learning-start-steps a { min-height: 0; }
</style>
