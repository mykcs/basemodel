---
import { localePath, type Locale } from '../../i18n';

export type MissionPage = 'hub' | 'base-model' | 'seed' | 'openevo' | 'benchmarks' | 'webshop' | 'alfworld' | 'loops' | 'results';
interface Props { locale: Locale; page: MissionPage }
const { locale, page } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---

<div class="mission-page">
  {page === 'base-model' && <>
    <section class="mission-section">
      <div class="mission-section__heading"><span>01</span><div><small>{t('模型', 'Model')}</small><h2>Qwen2.5-3B-Instruct</h2></div></div>
      <div class="model-name-diagram">
        <div><strong>Qwen</strong><span>{t('模型家族', 'model family')}</span></div>
        <div><strong>2.5</strong><span>{t('代际标签', 'generation label')}</span></div>
        <div><strong>3B</strong><span>{t('参数规模', 'parameter scale')}</span></div>
        <div><strong>Instruct</strong><span>{t('指令对齐 checkpoint', 'instruction-aligned checkpoint')}</span></div>
      </div>
      <p class="section-copy">{t('模型名只是入口。复现实验还需要固定具体 revision、精度、量化、上下文、推理后端、chat template、prompt/action grammar 和权重是否更新。', 'The model name is only the entry point. Reproduction also requires the exact revision, precision, quantization, context, inference backend, chat template, prompt/action grammar, and whether weights are updated.')}</p>
    </section>

    <section class="mission-section">
      <div class="mission-section__heading"><span>02</span><div><small>{t('字段', 'Fields')}</small><h2>{t('实验字段', 'Experiment fields')}</h2></div></div>
      <dl class="term-grid">
        <div><dt>Base / Instruct</dt><dd>{t('不同 checkpoint 类型，不能在复现中无说明地互换。', 'Different checkpoint types; they are not interchangeable without disclosure.')}</dd></div>
        <div><dt>Parameters</dt><dd>{t('影响存储、显存与计算，不直接等同于任务表现。', 'Affects storage, memory, and compute; it is not task performance itself.')}</dd></div>
        <div><dt>Context</dt><dd>{t('一次推理可处理的 token 窗口，不等于 Agent 的有效长期记忆。', 'The token window for one inference call, not effective long-term agent memory.')}</dd></div>
        <div><dt>BF16 / FP16 / INT4</dt><dd>{t('数值精度或量化状态，会影响显存、吞吐和数值行为。', 'Precision or quantization affects memory, throughput, and numerical behavior.')}</dd></div>
        <div><dt>SFT / LoRA / RL</dt><dd>{t('不同的权重更新方式，必须在比较时明确。', 'Different weight-update modes that must be explicit in comparisons.')}</dd></div>
        <div><dt>Checkpoint / revision</dt><dd>{t('真正可复现的模型状态。', 'The reproducible model state.')}</dd></div>
      </dl>
    </section>

    <section class="mission-section">
      <div class="mission-section__heading"><span>03</span><div><small>{t('控制变量', 'Controls')}</small><h2>{t('可比性变量', 'Comparability variables')}</h2></div></div>
      <table class="mission-table"><thead><tr><th>{t('变量', 'Variable')}</th><th>{t('影响', 'Impact')}</th><th>{t('处理', 'Treatment')}</th></tr></thead><tbody>
        <tr><td>checkpoint</td><td>{t('动作质量、token 分布、训练起点', 'action quality, token distribution, training start')}</td><td>{t('严格复现固定；换模型另立实验', 'pin for strict reproduction; model changes are separate experiments')}</td></tr>
        <tr><td>{t('精度 / 量化', 'precision / quantization')}</td><td>{t('显存、吞吐、采样', 'memory, throughput, sampling')}</td><td>{t('记录并固定', 'record and hold fixed')}</td></tr>
        <tr><td>{t('推理后端', 'inference backend')}</td><td>{t('采样与运行行为', 'sampling and runtime behavior')}</td><td>{t('作为协议变量记录', 'record as a protocol variable')}</td></tr>
        <tr><td>prompt / parser</td><td>{t('合法动作与 fallback', 'valid actions and fallbacks')}</td><td>{t('比较时保持一致', 'hold fixed in comparisons')}</td></tr>
      </tbody></table>
      <div class="section-actions"><a class="button button-primary" href={p('/models/qwen2-5-3b-instruct/')}>{t('模型记录 →', 'Model record →')}</a></div>
    </section>
  </>}

  {page === 'seed' && <>
    <section class="mission-section" data-explainer-step="2">
      <div class="mission-section__heading"><span>01</span><div><small>{t('学习信号', 'Learning signal')}</small><h2>{t('奖励与 hindsight skill', 'Reward and hindsight skill')}</h2></div></div>
      <p class="section-copy">{t('Agent 任务常只有稀疏终局奖励。SEED 用完整轨迹生成 hindsight skill，再把 skill 导致的动作概率变化转成更密集的 token 级学习信号。', 'Agent tasks often provide sparse terminal rewards. SEED generates hindsight skills from completed trajectories, then converts skill-induced action-probability changes into denser token-level learning signals.')}</p>
      <div class="flow"><div><b>{t('完整轨迹', 'Completed trajectory')}</b></div><i>→</i><div><b>hindsight skill</b></div><i>→</i><div><b>OPD signal</b></div></div>
    </section>

    <section class="mission-section" data-explainer-step="4">
      <div class="mission-section__heading"><span>02</span><div><small>{t('训练', 'Training')}</small><h2>{t('SEED 训练阶段', 'SEED training stages')}</h2></div></div>
      <div class="two-grid">
        <article><span>Stage 1</span><h3>Hindsight-skill SFT</h3><ol><li>{t('收集离线轨迹', 'Collect offline trajectories')}</li><li>{t('外部 analyzer 生成 hindsight skill', 'External analyzer generates hindsight skills')}</li><li>{t('模型学习轨迹分析能力', 'The model learns trajectory analysis')}</li></ol></article>
        <article><span>Stage 2</span><h3>Self-evolving OPD + RL</h3><ol><li>{t('当前 policy 收集 on-policy 轨迹', 'Current policy collects on-policy trajectories')}</li><li>{t('同一 checkpoint 生成 skill', 'The same checkpoint generates skills')}</li><li>{t('固定原动作进行双上下文重打分', 'Re-score the same sampled actions under two contexts')}</li><li>{t('联合优化 RL 与 OPD', 'Jointly optimize RL and OPD')}</li></ol></article>
      </div>
    </section>

    <section class="mission-section" data-explainer-step="5">
      <div class="mission-section__heading"><span>03</span><div><small>{t('时间尺度', 'Time scales')}</small><h2>{t('SEED 的双时间尺度', 'SEED time scales')}</h2></div></div>
      <div class="two-grid"><article><h3>Episode / rollout</h3><p>{t('观察 → 动作 → 环境反馈，直到终止；本轮权重保持固定。', 'Observation → action → environment feedback until termination; weights stay fixed within the rollout.')}</p></article><article><h3>Policy update</h3><p>{t('收集一组轨迹 → hindsight → reward / advantage / OPD → optimizer → 新 checkpoint。', 'Collect trajectories → hindsight → reward / advantage / OPD → optimizer → new checkpoint.')}</p></article></div>
      <p class="section-copy">{t('SEED 的目标是把行为变化内化进 policy 参数，而不是部署时永久携带额外 skill prompt。', 'SEED aims to internalize behavioral change into policy parameters rather than carrying an extra skill prompt at deployment.')}</p>
      <div class="section-actions"><a class="button button-primary" href={p('/papers/seed/')}>{t('SEED 论文页 →', 'SEED paper →')}</a></div>
    </section>
  </>}

  {page === 'openevo' && <>
    <section class="mission-section" data-explainer-step="1">
      <div class="mission-section__heading"><span>01</span><div><small>{t('任务边界', 'Task boundary')}</small><h2>{t('OpenEvo 的任务边界', 'OpenEvo task boundary')}</h2></div></div>
      <ol class="step-track"><li><b>{t('固定 Project Head', 'Pin Project Head')}</b><span>{t('任务开始时锁定 model / adapter / context revision', 'pin model / adapter / context revisions at task start')}</span></li><li><b>{t('运行任务', 'Run task')}</b><span>{t('保存 transcript、trajectory、score 与失败信息', 'save transcript, trajectory, score, and failures')}</span></li><li><b>{t('封存证据', 'Seal evidence')}</b><span>{t('完成任务的数据成为 evolution input', 'completed-task data becomes evolution input')}</span></li><li><b>{t('运行演化方法', 'Run evolution method')}</b><span>{t('生成声明类型的 artifact / adapter', 'produce the declared artifact / adapter')}</span></li><li><b>{t('验证与发布', 'Validate and publish')}</b><span>{t('接受的状态组成 successor revision', 'accepted state forms a successor revision')}</span></li><li><b>{t('后续任务加载', 'Load later')}</b><span>{t('新 revision 从后续任务开始生效', 'the new revision activates on a later task')}</span></li></ol>
    </section>

    <section class="mission-section" data-explainer-step="3">
      <div class="mission-section__heading"><span>02</span><div><small>{t('载体', 'Carriers')}</small><h2>{t('OpenEvo 演化载体', 'OpenEvo evolution carriers')}</h2></div></div>
      <div class="four-grid"><article><span>text_memory</span><h3>{t('文本记忆', 'Text memory')}</h3><p>{t('把历史经验作为后续上下文。', 'Carry prior experience as later context.')}</p></article><article><span>skill_bundle</span><h3>{t('技能包', 'Skill bundle')}</h3><p>{t('保存可复用代码、规则或工具化技能。', 'Preserve reusable code, rules, or tool-oriented skills.')}</p></article><article><span>agent_system</span><h3>{t('系统行为', 'Agent system')}</h3><p>{t('版本化系统级行为指导。', 'Versioned system-level behavior guidance.')}</p></article><article><span>parametric_memory</span><h3>{t('参数载体', 'Parametric carrier')}</h3><p>{t('adapter / 参数更新路径；当前正式实验使用 SD-LoRA。', 'Adapter / parameter update path; the active experiment uses SD-LoRA.')}</p></article></div>
    </section>

    <section class="mission-section" data-explainer-step="2">
      <div class="mission-section__heading"><span>03</span><div><small>{t('基准', 'Benchmarks')}</small><h2>{t('Benchmark 接入契约', 'Benchmark integration contract')}</h2></div></div>
      <table class="mission-table"><thead><tr><th>{t('层', 'Layer')}</th><th>{t('必须保存', 'Required evidence')}</th></tr></thead><tbody><tr><td>{t('环境', 'Environment')}</td><td>reset / observation / valid action / termination</td></tr><tr><td>{t('轨迹', 'Trajectory')}</td><td>{t('动作、观察、分数、结束原因、模型输出', 'actions, observations, scores, termination, model outputs')}</td></tr><tr><td>{t('评测', 'Evaluation')}</td><td>{t('连续分数、exact success、步骤与失败类型', 'continuous score, exact success, steps, failure types')}</td></tr><tr><td>{t('演化', 'Evolution')}</td><td>{t('输入 artifact、方法身份、输出 artifact、激活 revision', 'input artifact, method identity, output artifact, activated revision')}</td></tr></tbody></table>
    </section>
  </>}

  {page === 'benchmarks' && <>
    <section class="mission-section" data-explainer-step="1">
      <div class="mission-section__heading"><span>01</span><div><small>{t('环境', 'Environments')}</small><h2>{t('交互与评测', 'Interaction and evaluation')}</h2></div></div>
      <div class="two-grid"><article><h3>ALFWorld</h3><p>{t('文本化具身任务。核心结果是各任务家族 success rate 与不加权 macro-average；循环、无效动作和状态遗漏单独记录。', 'Text-based embodied tasks. Core outcomes are per-family success rates and an unweighted macro-average; loops, invalid actions, and missed state remain separate diagnostics.')}</p></article><article><h3>WebShop</h3><p>{t('网页购物导航任务。同时报告 normalized task-completion score 与 exact success；query、点击、属性选择和 fallback 单独记录。', 'Web-shopping navigation. Report normalized task-completion score and exact success together; preserve queries, clicks, attribute choices, and fallbacks separately.')}</p></article></div>
      <nav class="benchmark-detail-links" aria-label={t('打开独立环境讲解', 'Open dedicated environment explainers')}>
        <a href={p('/research/seed-openevo/webshop/')}><strong>WebShop</strong><span>{t('打开购物网页交互与评分讲解', 'Open the shopping interaction and scoring explainer')}</span></a>
        <a href={p('/research/seed-openevo/alfworld/')}><strong>ALFWorld</strong><span>{t('打开物体状态与前置条件讲解', 'Open the object-state and precondition explainer')}</span></a>
      </nav>
    </section>

    <section class="mission-section" data-explainer-step="-1">
      <div class="mission-section__heading"><span>02</span><div><small>{t('证据', 'Evidence')}</small><h2>{t('结果与轨迹证据', 'Outcome and trajectory evidence')}</h2></div></div>
      <table class="mission-table"><thead><tr><th>{t('证据', 'Evidence')}</th><th>ALFWorld</th><th>WebShop</th></tr></thead><tbody><tr><td>{t('最终成功', 'Final success')}</td><td>success / failure</td><td>exact success</td></tr><tr><td>{t('部分完成', 'Partial completion')}</td><td>—</td><td>normalized score</td></tr><tr><td>{t('轨迹诊断', 'Trajectory diagnostics')}</td><td>{t('循环、无效动作、状态遗漏', 'loops, invalid actions, missed state')}</td><td>{t('query、click、option、fallback', 'query, click, option, fallback')}</td></tr></tbody></table>
    </section>

    <section class="mission-section" data-explainer-step="0">
      <div class="mission-section__heading"><span>03</span><div><small>{t('对比', 'Comparison')}</small><h2>{t('公平比较协议', 'Fair-comparison protocol')}</h2></div></div>
      <ul class="control-list"><li>{t('同一模型 checkpoint / revision', 'Same model checkpoint / revision')}</li><li>{t('同一任务集与 split', 'Same task set and split')}</li><li>{t('同一 prompt、action grammar 与 parser', 'Same prompt, action grammar, and parser')}</li><li>{t('同一步数、rollout 数与 sampling 参数', 'Same step, rollout, and sampling budgets')}</li><li>{t('同一 evaluator 与 score 定义', 'Same evaluator and score definition')}</li><li>{t('同一推理精度与后端，或明确记录替代', 'Same precision and backend, or an explicit substitution')}</li></ul>
    </section>
  </>}

  {page === 'webshop' && <>
    <section class="mission-section" data-explainer-step="0">
      <div class="mission-section__heading"><span>01</span><div><small>{t('购物任务', 'Shopping task')}</small><h2>{t('目标与网页状态', 'Goal and page state')}</h2></div></div>
      <p class="section-copy">{t('WebShop 不是让模型直接回答商品名。一个自然语言 goal 先约束品类、属性与预算，Agent 每一步只依据当前文本页面选择可执行 action，环境再返回新的页面 observation。', 'WebShop does not ask the model to name a product directly. A natural-language goal constrains category, attributes, and budget; at each step the agent selects an executable action from the current text page, and the environment returns a new page observation.')}</p>
    </section>

    <section class="mission-section" data-explainer-step="2">
      <div class="mission-section__heading"><span>02</span><div><small>{t('动作', 'Actions')}</small><h2>{t('搜索与商品选择', 'Search and product selection')}</h2></div></div>
      <dl class="term-grid"><div><dt>search</dt><dd>{t('提交 query，进入搜索结果页面。', 'Submit a query and enter a results page.')}</dd></div><div><dt>click</dt><dd>{t('打开商品、选择属性或触发购买。', 'Open a product, select an attribute, or trigger purchase.')}</dd></div><div><dt>observation</dt><dd>{t('保存每一步实际可见的文本页面。', 'Preserve the text page actually visible at each step.')}</dd></div><div><dt>fallback</dt><dd>{t('解析失败时单独记录，不能伪装成模型动作。', 'Record parser fallback separately; it is not a model action.')}</dd></div></dl>
    </section>

    <section class="mission-section" data-explainer-step="4">
      <div class="mission-section__heading"><span>03</span><div><small>{t('评测', 'Evaluation')}</small><h2>{t('分数与成功边界', 'Score and success boundary')}</h2></div></div>
      <table class="mission-table"><thead><tr><th>{t('字段', 'Field')}</th><th>{t('含义', 'Meaning')}</th><th>{t('记录方式', 'Recording')}</th></tr></thead><tbody><tr><td>task_score</td><td>{t('归一化任务完成度，范围 0–1。', 'Normalized task completion in the range 0–1.')}</td><td>{t('保留连续数值', 'preserve the continuous value')}</td></tr><tr><td>won</td><td>{t('是否精确满足终局约束。', 'Whether terminal constraints are satisfied exactly.')}</td><td>{t('与 score 分开保存', 'store separately from score')}</td></tr><tr><td>DEMO</td><td>{t('交互图中的 1.0 仅为教学示意。', 'The 1.0 shown in the interactive figure is illustrative only.')}</td><td>{t('不并入实验结果', 'exclude from experiment results')}</td></tr></tbody></table>
      <div class="section-actions"><a class="button button-primary" href={p('/research/seed-openevo/benchmarks/')}>{t('比较两个环境', 'Compare both environments')}</a><a class="button button-secondary" href={p('/guide/openevo-webshop-alfworld/')}>{t('打开实验指南', 'Open experiment guide')}</a></div>
    </section>
  </>}

  {page === 'alfworld' && <>
    <section class="mission-section" data-explainer-step="0">
      <div class="mission-section__heading"><span>01</span><div><small>{t('世界状态', 'World state')}</small><h2>{t('目标与世界状态', 'Goal and world state')}</h2></div></div>
      <p class="section-copy">{t('ALFWorld 把家务目标放进可执行的文本世界。Agent 观察房间、物体、容器与属性状态，再用 goto、pick、open、put、heat 等动作逐步改变世界。', 'ALFWorld places household goals in an executable text world. The agent observes rooms, objects, receptacles, and attributes, then changes the world step by step with actions such as goto, pick, open, put, and heat.')}</p>
    </section>

    <section class="mission-section" data-explainer-step="3">
      <div class="mission-section__heading"><span>02</span><div><small>{t('约束', 'Constraints')}</small><h2>{t('动作前置条件', 'Action preconditions')}</h2></div></div>
      <p class="section-copy">{t('动作在语言上合理并不代表环境允许执行。示意任务中，apple 必须先进入已打开的 microwave，heat 才能改变 heated 状态；失败动作与原世界状态都应留在轨迹里。', 'An action sounding plausible does not make it executable. In the illustrative task, the apple must enter an open microwave before heat can change its heated state; both failed actions and the unchanged world state belong in the trajectory.')}</p>
      <ul class="control-list"><li>{t('动作前记录 observation 与可用动作', 'Record the observation and available actions before acting')}</li><li>{t('状态转换后记录物体位置与属性', 'Record object location and attributes after transition')}</li><li>{t('前置条件失败单列为诊断证据', 'Keep precondition failures as separate diagnostic evidence')}</li><li>{t('循环与无效动作不等同于任务失败原因', 'Do not collapse loops and invalid actions into one failure cause')}</li></ul>
    </section>

    <section class="mission-section" data-explainer-step="8">
      <div class="mission-section__heading"><span>03</span><div><small>{t('评测', 'Evaluation')}</small><h2>{t('成功率与数据 split', 'Success rate and data splits')}</h2></div></div>
      <table class="mission-table"><thead><tr><th>{t('字段', 'Field')}</th><th>{t('含义', 'Meaning')}</th><th>{t('边界', 'Boundary')}</th></tr></thead><tbody><tr><td>success</td><td>{t('终局目标是否满足。', 'Whether the terminal goal is satisfied.')}</td><td>{t('二元任务结果', 'binary task outcome')}</td></tr><tr><td>task-family rate</td><td>{t('每个家务任务家族的成功率。', 'Success rate for each household task family.')}</td><td>{t('按家族分别报告', 'report by family')}</td></tr><tr><td>macro-average</td><td>{t('各任务家族成功率的不加权平均。', 'Unweighted average of task-family success rates.')}</td><td>{t('不能与 WebShop normalized score 混用', 'do not mix with WebShop normalized score')}</td></tr><tr><td>split</td><td>train / valid_seen / valid_unseen</td><td>{t('保存原始环境 split 与上层抽样', 'preserve the environment split and upper-level sampling')}</td></tr></tbody></table>
      <div class="section-actions"><a class="button button-primary" href={p('/research/seed-openevo/benchmarks/')}>{t('比较两个环境', 'Compare both environments')}</a><a class="button button-secondary" href={p('/guide/openevo-webshop-alfworld/')}>{t('打开实验指南', 'Open experiment guide')}</a></div>
    </section>
  </>}

  {page === 'loops' && <>
    <section class="mission-section" data-explainer-step="2">
      <div class="mission-section__heading"><span>01</span><div><small>{t('循环', 'Loops')}</small><h2>{t('两种更新循环', 'Two update loops')}</h2></div></div>
      <div class="two-grid"><article><span>SEED</span><h3>{t('参数更新', 'Parameter update')}</h3><p>on-policy trajectories → hindsight skill → re-score → GRPO + OPD → policy θt+1</p></article><article><span>OpenEvo</span><h3>{t('跨任务演化', 'Cross-task evolution')}</h3><p>completed task → sealed evidence → evolution method → artifact / adapter → successor revision</p></article></div>
    </section>

    <section class="mission-section" data-explainer-step="3">
      <div class="mission-section__heading"><span>02</span><div><small>{t('接口', 'Interfaces')}</small><h2>{t('更新对象与接口', 'Updated objects and interfaces')}</h2></div></div>
      <table class="mission-table"><thead><tr><th>{t('维度', 'Dimension')}</th><th>SEED</th><th>OpenEvo</th></tr></thead><tbody><tr><td>{t('经验来源', 'Experience')}</td><td>on-policy trajectories</td><td>sealed task/session evidence</td></tr><tr><td>{t('中间产物', 'Intermediate')}</td><td>hindsight skill</td><td>versioned artifact / adapter</td></tr><tr><td>{t('更新对象', 'Updated object')}</td><td>policy parameters</td><td>carrier / adapter / successor revision</td></tr><tr><td>{t('生效边界', 'Activation')}</td><td>{t('下一次 policy update 后', 'after policy update')}</td><td>{t('后续任务加载 revision 时', 'when a later task loads the revision')}</td></tr></tbody></table>
    </section>

    <section class="mission-section" data-explainer-step="4">
      <div class="mission-section__heading"><span>03</span><div><small>{t('实验设计', 'Experiment design')}</small><h2>{t('受控比较', 'Controlled comparison')}</h2></div></div>
