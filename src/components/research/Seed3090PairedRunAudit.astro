---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const sourceRoot = 'https://github.com/mykcs/seed3090/blob/main';

const sharedContract = [
  {
    label: t('阶段', 'Stage'),
    value: 'promotion-dev',
  },
  {
    label: t('逻辑配对键', 'Logical pair key'),
    value: '(task_id, rollout_seed)',
  },
  {
    label: t('冻结模型', 'Frozen model'),
    value: 'Qwen2.5-3B-Instruct',
  },
  {
    label: t('在线预算', 'Online budget'),
    value: t('15 steps · 256 new tokens', '15 steps · 256 new tokens'),
  },
] as const;

const arms = [
  {
    id: 'v0',
    label: 'V0',
    role: t('无记忆对照', 'No-memory control'),
    memory: t('规范化空值', 'Canonical empty value'),
    details: [
      t('同一 runner 与入口', 'Same runner and entrypoint'),
      t('同一 prompt、parser 与 evaluator', 'Same prompt, parser, and evaluator'),
      t('同一 episode / step seed', 'Same episode and step seeds'),
      t('每个 episode 重新 reset', 'Fresh reset for every episode'),
    ],
  },
  {
    id: 'o1',
    label: 'O1',
    role: t('冻结文本记忆处理组', 'Frozen text-memory treatment'),
    memory: t('一个 SHA 绑定的只读记忆', 'One SHA-bound read-only memory'),
    details: [
      t('同一 runner 与入口', 'Same runner and entrypoint'),
      t('同一 prompt、parser 与 evaluator', 'Same prompt, parser, and evaluator'),
      t('同一 episode / step seed', 'Same episode and step seeds'),
      t('每个 episode 重载同一记忆哈希', 'Reload the same memory hash every episode'),
    ],
  },
] as const;

const evidenceGroups = [
  {
    title: t('身份', 'Identity'),
    purpose: t('证明正在运行冻结的那一个实验', 'Prove this is the frozen experiment'),
    fields: [
      'protocol_version · run_uuid',
      'merged Git commit + tree',
      'task / instruction hash',
      'model · source · indexes_1k digests',
    ],
  },
  {
    title: t('隔离与执行', 'Isolation and execution'),
    purpose: t('证明两组没有继承不同的隐藏状态', 'Prove neither arm inherited hidden state'),
    fields: [
      'effective environment + model seed',
      'fresh session · cart · history · KV state',
      'attempt_id · UTC start / end',
      'GPU UUID · PID · user ownership',
    ],
  },
  {
    title: t('轨迹与判分', 'Trajectory and evaluation'),
    purpose: t('让每一步动作和分数都能复核', 'Make every action and score auditable'),
    fields: [
      'observation · raw model output',
      'parsed action · fallback flag',
      'reward · score · success · termination',
      'step-indexed provenance',
    ],
  },
  {
    title: t('封存', 'Seal'),
    purpose: t('证明记录之后没有被静默改写', 'Prove records were not silently rewritten'),
    fields: [
      'path · size · sha256',
      'expected / observed logical keys',
      'remote verification attestation',
      'independent Mac attestation',
    ],
  },
] as const;

const outcomes = [
  {
    state: 'advance',
    valid: t('是', 'Yes'),
    delta: '> 0.0',
    status: 'PROMOTION_PASS',
    meaning: t(
      '这个候选记忆可以进入已知任务的工程资格赛；这仍不是效果显著性结论。',
      'This memory candidate may enter the known-task engineering qualification; it is still not an efficacy or significance claim.',
    ),
  },
  {
    state: 'stop',
    valid: t('是', 'Yes'),
    delta: '≤ 0.0',
    status: 'NOT_ELIGIBLE',
    meaning: t(
      '本次冻结候选没有通过选择规则；不能据此推断文本记忆无效。',
      'This frozen candidate did not pass the selection rule; that does not show text memory is ineffective.',
    ),
  },
  {
    state: 'invalid',
    valid: t('否', 'No'),
    delta: t('不计算', 'Not evaluated'),
    status: 'QUALIFICATION_INVALID',
    meaning: t(
      '缺失、重复、额外记录、fallback、非法分数或 provenance 不一致都会让整组无效，并保留在封存分母里。',
      'Missing, duplicate, extra, fallback, illegal-score, or provenance-mismatched records invalidate the whole gate and remain in the sealed denominator.',
    ),
  },
] as const;
---

<section
  id="seed3090-paired-run-audit"
  class="paired-run"
  aria-labelledby="paired-run-title"
  data-testid="seed3090-paired-run-audit"
>
  <header class="paired-run__header">
    <div>
      <p class="paired-run__eyebrow">
        {t('从状态地图进入一次真实运行', 'From the status map into one real run')}
        <span aria-hidden="true">·</span>
        <time datetime="2026-08-12">2026-08-12</time>
      </p>
      <h2 id="paired-run-title">
        {t(
          '一对 V0 / O1 分数，怎样才变成可以相信的证据？',
          'When does one V0 / O1 pair become evidence worth trusting?',
        )}
      </h2>
      <p>
        {t(
          'seed3090 的下一层启发，是把“跑实验”拆成冻结配对、episode 证据包和 fail-closed 决策。读者不只看到结果，还能看懂结果凭什么可比。',
          'The next reusable lesson from seed3090 is to split “run the experiment” into a frozen pair, an episode evidence packet, and a fail-closed decision. Readers can see not only the outcome, but why it is comparable.',
        )}
      </p>
    </div>
    <aside class="paired-run__rule" aria-label={t('核心公平规则', 'Core fairness rule')}>
      <span>{t('唯一处理变量', 'Only treatment variable')}</span>
      <code>external_memory_bytes</code>
      <strong>
        {t(
          '其他执行合同必须逐字节或逐字段一致。',
          'Every other execution contract must match byte-for-byte or field-for-field.',
        )}
      </strong>
      <small>{t('以下是协议示意，不是已产生的成绩。', 'This is a protocol illustration, not measured output.')}</small>
    </aside>
  </header>

  <figure class="pair-console" aria-labelledby="pair-console-title">
    <figcaption>
      <span>{t('01 · 冻结一对比较', '01 · Freeze one paired comparison')}</span>
      <h3 id="pair-console-title">
        {t('先锁定共同合同，再让记忆成为唯一差异', 'Lock the shared contract before memory becomes the sole difference')}
      </h3>
    </figcaption>

    <div class="pair-console__shared" aria-label={t('共同合同', 'Shared contract')}>
      <span>{t('两组共同读取', 'Read by both arms')}</span>
      <dl>
        {sharedContract.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd><code>{item.value}</code></dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="pair-console__arms">
      <article class="pair-arm" data-arm={arms[0].id}>
        <div class="pair-arm__title">
          <span>{arms[0].label}</span>
          <div>
            <strong>{arms[0].role}</strong>
            <small>{t('actor weights：冻结', 'actor weights: frozen')}</small>
          </div>
        </div>
        <dl>
          <div>
            <dt>external_memory_bytes</dt>
            <dd>{arms[0].memory}</dd>
          </div>
        </dl>
        <ul>{arms[0].details.map((detail) => <li>{detail}</li>)}</ul>
      </article>

      <div class="pair-console__difference" aria-label={t('唯一差异', 'Only difference')}>
        <span>{t('只允许这里不同', 'Only this may differ')}</span>
        <code>memory</code>
      </div>

      <article class="pair-arm" data-arm={arms[1].id}>
        <div class="pair-arm__title">
          <span>{arms[1].label}</span>
          <div>
            <strong>{arms[1].role}</strong>
            <small>{t('actor weights：同一冻结版本', 'actor weights: same frozen revision')}</small>
          </div>
        </div>
        <dl>
          <div>
            <dt>external_memory_bytes</dt>
            <dd>{arms[1].memory}</dd>
          </div>
        </dl>
        <ul>{arms[1].details.map((detail) => <li>{detail}</li>)}</ul>
      </article>
    </div>

    <p class="pair-console__boundary">
      <strong>{t('配对边界：', 'Pairing boundary: ')}</strong>
      {t(
        'arm、执行顺序、attempt ID 或 resume 位置都不能改变逻辑 seed；同一 pair 的 V0 与 O1 必须到达真实环境 reset 和真实模型 generator。',
        'Arm, execution order, attempt ID, and resume position cannot change the logical seed; both V0 and O1 in a pair must reach the real environment reset and the real model generator.',
      )}
    </p>
  </figure>

  <section class="evidence-packet" aria-labelledby="evidence-packet-title">
    <header>
      <div>
        <span>{t('02 · episode 证据包', '02 · Episode evidence packet')}</span>
        <h3 id="evidence-packet-title">
          {t('一个 score 旁边，至少还要保存四组证据', 'A score needs four evidence groups beside it')}
        </h3>
      </div>
      <p>
        {t(
          '逻辑记录键固定为 (stage, task_id, rollout_seed, arm)。分数不能脱离身份、隔离、轨迹和封存信息单独进入分析。',
          'The logical record key is (stage, task_id, rollout_seed, arm). A score cannot enter analysis without identity, isolation, trajectory, and sealing evidence.',
        )}
      </p>
    </header>

    <ol>
      {evidenceGroups.map((group, index) => (
        <li>
          <span class="evidence-packet__index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h4>{group.title}</h4>
            <p>{group.purpose}</p>
            <ul>{group.fields.map((field) => <li><code>{field}</code></li>)}</ul>
          </div>
        </li>
      ))}
    </ol>

    <aside class="launch-boundary">
      <div>
        <span>{t('运行前', 'Before launch')}</span>
        <strong>Q0–Q4</strong>
        <p>{t('协议、代码、三补丁、indexes_1k 与合同检查全部在 CPU 门完成。', 'Protocol, code, three-patch, indexes_1k, and contract checks finish at the CPU gate.')}</p>
      </div>
      <code>GPU_WORKLOAD_LAUNCHED=0</code>
      <div>
        <span>{t('获得授权后', 'After authorization')}</span>
        <strong>Q5</strong>
        <p>{t('只占用一张确认空闲且归属清楚的 RTX3090，串行执行 promotion。', 'Use one verified-idle, ownership-clear RTX3090 and run promotion serially.')}</p>
      </div>
    </aside>
  </section>

  <section class="decision-table" aria-labelledby="decision-table-title">
    <header>
      <div>
        <span>{t('03 · fail-closed 决策', '03 · Fail-closed decision')}</span>
        <h3 id="decision-table-title">
          {t('先判断证据是否有效，再看 paired delta', 'Validate the evidence before reading paired delta')}
        </h3>
      </div>
      <p>
        {t(
          'promotion-dev 固定为 2 个任务 × 2 个 rollout seeds × 2 个 arms，也就是 8 episodes / 4 pairs。任何记录问题都不能靠“清洗后重算”消失。',
          'promotion-dev is fixed at 2 tasks × 2 rollout seeds × 2 arms: 8 episodes / 4 pairs. Record failures cannot disappear through post-hoc cleaning.',
        )}
      </p>
    </header>

    <div class="decision-table__scroll" tabindex="0" role="region" aria-label={t('资格赛结果判定表', 'Qualification outcome table')}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('全部预期记录有效？', 'All expected records valid?')}</th>
            <th scope="col">mean(O1 − V0)</th>
            <th scope="col">{t('封存后的状态', 'Status after sealing')}</th>
            <th scope="col">{t('允许的解释', 'Permitted interpretation')}</th>
          </tr>
        </thead>
        <tbody>
          {outcomes.map((outcome) => (
            <tr data-state={outcome.state}>
              <td>{outcome.valid}</td>
              <td><code>{outcome.delta}</code></td>
              <td><code>{outcome.status}</code></td>
              <td>{outcome.meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <details class="retry-boundary">
    <summary>{t('一个 episode 出错，为什么不能重跑到成功？', 'Why not rerun a failed episode until it succeeds?')}</summary>
    <div>
      <p>
        {t(
          '一旦 episode 已经产生环境状态、模型结果或记录，API、parser、environment fallback 与异常就成为这个逻辑键的终止错误。把它替换成一次更好的重跑，会在看到结果后改变固定分母，并破坏可归因性。',
          'Once an episode has produced environment state, model output, or a record, API, parser, environment fallback, or an exception becomes the terminal error for that logical key. Replacing it with a better retry changes the frozen denominator after seeing outcomes and breaks attribution.',
        )}
      </p>
      <p>
        {t(
          '只有在 episode 开始前、没有产生任何环境状态、模型结果或记录的 transport failure，才允许使用同一逻辑 seed、不同 attempt ID 的有界重试。所有 attempt 仍要保留。',
          'Only a transport failure before the episode starts, with no environment state, model result, or record, may receive a bounded retry using the same logical seed and a new attempt ID. Every attempt is still preserved.',
        )}
      </p>
    </div>
  </details>

  <footer class="paired-run__sources">
    <div>
      <strong>{t('内容边界', 'Content boundary')}</strong>
      <p>{t('本节把 seed3090 的前瞻协议转成网页心智模型；它没有生成新的实验结果，也没有替代仓库中的机器证据。', 'This section turns the seed3090 prospective protocol into a web mental model; it does not create new experiment results or replace machine evidence in the repository.')}</p>
    </div>
    <nav aria-label={t('seed3090 协议来源', 'seed3090 protocol sources')}>
      <a href={`${sourceRoot}/docs/project/EXPERIMENT_PLAN.md`} target="_blank" rel="noreferrer">EXPERIMENT_PLAN.md</a>
      <a href={`${sourceRoot}/docs/agent-handoffs/OPENEVO-SEED-WEBSHOP-COMPARISON-GATE-20260812.md`} target="_blank" rel="noreferrer">COMPARISON_GATE</a>
    </nav>
  </footer>
</section>

<style>
  .paired-run {
    --run-accent: var(--accent, #2457d6);
    width: min(1180px, calc(100% - 2rem));
    margin: clamp(1.25rem, 3vw, 2.5rem) auto clamp(4rem, 8vw, 7rem);
    padding: clamp(1.2rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    color: var(--text, var(--ink));
  }

  .paired-run__header,
  .evidence-packet > header,
  .decision-table > header,
  .paired-run__sources {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .46fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .paired-run__eyebrow,
  .pair-console figcaption > span,
  .evidence-packet > header span,
  .decision-table > header span {
    margin: 0;
    color: var(--run-accent);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .paired-run__eyebrow span { margin-inline: .35rem; }

  .paired-run h2 {
    max-width: 19ch;
    margin: .7rem 0 .85rem;
    font-size: clamp(2rem, 4.4vw, 4.2rem);
    line-height: 1;
    letter-spacing: -.05em;
  }

  .paired-run__header > div > p:last-child,
  .evidence-packet > header > p,
  .decision-table > header > p,
  .paired-run__sources p {
    margin: 0;
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.72;
  }

  .paired-run__rule {
    display: grid;
    gap: .7rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--run-accent) 28%, var(--line));
    border-radius: 18px;
    background: color-mix(in srgb, var(--run-accent) 6%, var(--surface));
  }

  .paired-run__rule span,
  .pair-console__shared > span,
  .launch-boundary span {
    color: var(--muted);
    font-size: .66rem;
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .paired-run__rule code {
    width: fit-content;
    max-width: 100%;
    padding: .35rem .5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow-wrap: anywhere;
    font-size: .8rem;
  }

  .paired-run__rule strong { font-size: .92rem; line-height: 1.45; }
  .paired-run__rule small { color: var(--muted); font-size: .66rem; line-height: 1.5; }

  .pair-console,
  .evidence-packet,
  .decision-table {
    margin: clamp(2.5rem, 6vw, 5rem) 0 0;
  }

  .pair-console figcaption,
  .evidence-packet > header,
  .decision-table > header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .pair-console h3,
  .evidence-packet h3,
  .decision-table h3 {
    max-width: 26ch;
    margin: .55rem 0 0;
    font-size: clamp(1.45rem, 2.5vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -.035em;
  }

  .pair-console__shared {
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 16px 16px 8px 8px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
  }

  .pair-console__shared dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .65rem;
    margin: .75rem 0 0;
  }

  .pair-console__shared dl > div {
    min-width: 0;
    padding: .7rem;
    border: 1px solid var(--line);
    border-radius: 11px;
  }

  .pair-console dt,
  .pair-arm dt {
    color: var(--muted);
    font-size: .62rem;
    font-weight: 800;
  }

  .pair-console dd,
  .pair-arm dd {
    margin: .3rem 0 0;
    font-size: .73rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .pair-console__arms {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(112px, .24fr) minmax(0, 1fr);
    align-items: stretch;
    gap: .65rem;
    margin-top: .65rem;
  }

  .pair-arm {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
  }

  .pair-arm[data-arm='o1'] {
    border-style: double;
    border-width: 3px;
  }

  .pair-arm__title {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .75rem;
    align-items: start;
  }

  .pair-arm__title > span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid color-mix(in srgb, var(--run-accent) 35%, var(--line));
    border-radius: 50%;
    color: var(--run-accent);
    font: 850 .75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .pair-arm__title strong { display: block; font-size: .9rem; }
  .pair-arm__title small { display: block; margin-top: .25rem; color: var(--muted); font-size: .64rem; }
  .pair-arm dl { margin: 1rem 0 0; padding-top: .75rem; border-top: 1px solid var(--line); }
  .pair-arm ul { display: grid; gap: .5rem; margin: .85rem 0 0; padding: 0; list-style: none; }
  .pair-arm li { position: relative; padding-left: .9rem; color: var(--muted); font-size: .69rem; line-height: 1.45; }
  .pair-arm li::before { content: ''; position: absolute; top: .45em; left: 0; width: 5px; height: 5px; border: 1.5px solid var(--run-accent); border-radius: 50%; }

  .pair-console__difference {
    position: relative;
    display: grid;
    place-content: center;
    gap: .35rem;
    min-width: 0;
    padding: .75rem .45rem;
    text-align: center;
  }

  .pair-console__difference::before,
  .pair-console__difference::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    background: var(--line);
  }

  .pair-console__difference::before { top: 0; height: calc(50% - 27px); }
  .pair-console__difference::after { bottom: 0; height: calc(50% - 27px); }
  .pair-console__difference span { color: var(--muted); font-size: .6rem; line-height: 1.35; }
  .pair-console__difference code { font-size: .72rem; overflow-wrap: anywhere; }

  .pair-console__boundary {
    margin: .7rem 0 0;
    padding: .9rem 1rem;
    border-left: 3px solid var(--run-accent);
    background: color-mix(in srgb, var(--run-accent) 5%, transparent);
    color: var(--muted);
    font-size: .71rem;
    line-height: 1.6;
  }

  .pair-console__boundary strong { color: var(--text, var(--ink)); }

  .evidence-packet > header,
  .decision-table > header { grid-template-columns: minmax(0, .9fr) minmax(280px, 1fr); }

  .evidence-packet > ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }

  .evidence-packet > ol > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .65rem;
    min-width: 0;
    padding: 1rem;
    border-right: 1px solid var(--line);
  }

  .evidence-packet > ol > li:last-child { border-right: 0; }
  .evidence-packet__index { color: var(--run-accent); font: 850 .65rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .evidence-packet h4 { margin: 0; font-size: .86rem; }
  .evidence-packet ol p { margin: .4rem 0 0; color: var(--muted); font-size: .67rem; line-height: 1.5; }
  .evidence-packet ol ul { display: grid; gap: .45rem; margin: .75rem 0 0; padding: .7rem 0 0; border-top: 1px dashed var(--line); list-style: none; }
  .evidence-packet ol li li { min-width: 0; }
  .evidence-packet ol code { display: block; color: var(--muted); font-size: .6rem; line-height: 1.45; overflow-wrap: anywhere; }

  .launch-boundary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem;
