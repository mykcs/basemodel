---
import type { Locale } from '../../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const sourceRoot = 'https://github.com/mykcs/seed3090/blob/main';
const same = [t('同一个模型：Qwen2.5-3B-Instruct','Same model: Qwen2.5-3B-Instruct'),t('同一个 WebShop 环境和任务','Same WebShop environment and tasks'),t('同一套提示词、动作解析和评分方法','Same prompts, action parser, and evaluator'),t('同一个随机条件和执行预算','Same random conditions and execution budget')];
const evidence = [[t('这是哪一次实验？','Which experiment is this?'),'protocol_version · run_uuid · Git commit · task hash'],[t('两边真的从同样状态开始吗？','Did both sides start from the same state?'),'effective seed · fresh session · cart · history · KV state'],[t('AI 实际做了什么？','What did the AI actually do?'),'observation · raw model output · parsed action · fallback flag · reward · score'],[t('记录后来有没有被改过？','Were records changed later?'),'path · size · sha256 · remote verification attestation · independent Mac attestation']];
---
<section id="seed3090-paired-run-audit" class="paired-run" aria-labelledby="paired-run-title" data-testid="seed3090-paired-run-audit">
<header class="plain-header"><p class="eyebrow">{t('seed3090：怎样做一次可信的比较','seed3090: how to make a trustworthy comparison')}</p><h2 id="paired-run-title">{t('我们到底在做什么实验？','What experiment are we actually running?')}</h2><p class="lede">{t('让同一个 AI 在相同条件下完成 WebShop 任务。一次不给它过去的经验，一次给它一份冻结的经验。然后比较：这份经验到底有没有帮助。','Let the same AI complete WebShop tasks under the same conditions. One run gets no prior experience; the other gets one frozen experience memory. Then compare whether that memory actually helps.')}</p></header>

<figure class="story" aria-labelledby="story-title"><figcaption id="story-title">{t('先看完整过程','Start with the whole process')}</figcaption><ol>
<li><b>1</b><strong>{t('AI 做任务','AI does the task')}</strong><p>{t('在真实 WebShop 里观察页面并选择动作。','It observes real WebShop pages and chooses actions.')}</p></li>
<li><b>2</b><strong>{t('记录过程','Record the run')}</strong><p>{t('保存动作、结果和失败位置，不只留下最后分数。','Keep actions, outcomes, and failure points, not only the final score.')}</p></li>
<li><b>3</b><strong>{t('形成经验','Create memory')}</strong><p>{t('OpenEvo 把轨迹和反思整理成外部文本记忆。','OpenEvo turns trajectories and reflection into external text memory.')}</p></li>
<li><b>4</b><strong>{t('公平地再比较','Compare fairly')}</strong><p>{t('一边没有经验，一边读取冻结经验；其他条件相同。','One side has no memory; the other reads frozen memory; everything else matches.')}</p></li>
<li><b>5</b><strong>{t('先验实验，再看分数','Validate, then score')}</strong><p>{t('如果比较不公平或记录不完整，这组结果直接作废。','If fairness breaks or records are incomplete, the result is invalid.')}</p></li>
</ol></figure>

<section class="why"><div><p class="kicker">{t('为什么要这么严格？','Why be this strict?')}</p><h3>{t('因为我们只想回答一个问题：经验有没有帮助。','Because we want to answer one question: did the memory help?')}</h3></div><p>{t('如果第二次同时换了模型、任务、随机数、提示词或评分方法，即使分数变高，我们也不知道原因。所以 seed3090 最近的大量工作，本质上是在把这些条件锁定。','If the second run also changes the model, task, randomness, prompt, or scoring method, a higher score has no clear cause. Much of the recent seed3090 work is therefore about locking those conditions down.')}</p></section>

<figure class="compare" aria-labelledby="compare-title"><figcaption><span>{t('公平比较','Fair comparison')}</span><h3 id="compare-title">{t('两边几乎完全一样，唯一允许不同的是“有没有这份经验”','Both sides are nearly identical; the only allowed difference is whether the memory is present')}</h3></figcaption><div class="shared"><strong>{t('两边必须相同','Must match on both sides')}</strong><ul>{same.map((x)=><li>{x}</li>)}</ul></div><div class="arms"><article><em>V0</em><h4>{t('没有经验','No memory')}</h4><p>{t('AI 正常做任务，但读取的是空经验。','The AI runs normally but reads empty memory.')}</p><code>external_memory_bytes = Canonical empty value</code></article><div class="difference"><span>{t('唯一差异','Only difference')}</span><strong>{t('经验','memory')}</strong></div><article><em>O1</em><h4>{t('有冻结的经验','Frozen memory')}</h4><p>{t('同一个 AI、同一任务，只额外读取一份固定且只读的文本经验。','Same AI and task, with one fixed read-only text memory added.')}</p><code>external_memory_bytes = SHA-bound read-only memory</code></article></div><p class="note">{t('技术上，同一 pair 使用逻辑键 ','Technically, each pair uses ')}<code>(task_id, rollout_seed)</code> · {t('同一 runner 与入口','Same runner and entrypoint')}</p></figure>

<section class="results"><header><p class="kicker">{t('结果应该怎么读？','How should we read the result?')}</p><h3>{t('先判断这次比较能不能信，再判断谁的分数更高','First decide whether the comparison is valid; only then compare scores')}</h3></header><div class="result-grid">
<article><span>{t('实验有效 + 有经验的一边更好','Valid + memory side is better')}</span><strong>{t('继续下一阶段','Advance')}</strong><p>{t('这份候选经验值得继续测试，但还不能宣布 OpenEvo 已被证明有效。','This candidate is worth further testing, but this is not an efficacy or significance claim.')}</p><code>PROMOTION_PASS</code></article>
<article><span>{t('实验有效 + 没有变好','Valid + no improvement')}</span><strong>{t('这份候选不晋级','Candidate stops')}</strong><p>{t('只能说明这一次候选没通过规则；不能据此说文本记忆无效。','This candidate did not pass the rule; it does not show text memory is ineffective.')}</p><code>NOT_ELIGIBLE</code></article>
<article><span>{t('实验本身有问题','Experiment invalid')}</span><strong>{t('不比较分数','Do not compare')}</strong><p>{t('缺记录、重复记录、fallback、非法分数或来源不一致，都不能事后删除。','Missing/duplicate records, fallback, illegal scores, or provenance mismatches cannot be cleaned away.')}</p><code>QUALIFICATION_INVALID</code></article>
</div></section>

<aside class="big"><p class="kicker">{t('放回整个研究里看','The big picture')}</p><h3>{t('当前研究阶段先证明 OpenEvo 和 SEED 的比较是否公平，再讨论谁更好','The current research stage first tests whether the OpenEvo–SEED comparison is fair before asking which is better')}</h3><ol><li><span>{t('已完成','Done')}</span><strong>{t('真实链路能跑','Real chain runs')}</strong><p>{t('真实 WebShop、Qwen CUDA 动作、反思、记忆注入和下一轮运行已经打通。','Real WebShop, Qwen CUDA actions, reflection, memory injection, and the next run all work.')}</p></li><li class="now"><span>{t('现在','Now')}</span><strong>{t('证明 V0 / O1 比较公平','Prove V0 / O1 is fair')}</strong><p>{t('锁定除经验之外的变量，并保留完整证据。','Lock every variable except memory and preserve complete evidence.')}</p></li><li><span>{t('下一步','Next')}</span><strong>{t('在新任务上测试效果','Test fresh-task efficacy')}</strong><p>{t('通过资格赛后，再做 fresh-task pilot 和多随机种子比较。','After qualification, run a fresh-task pilot and multi-seed comparison.')}</p></li><li><span>{t('之后','Later')}</span><strong>{t('比较不同自进化机制','Compare evolution mechanisms')}</strong><p>{t('到那时才讨论外部文本记忆与 SEED 参数学习的差异。','Only then compare external text memory with SEED parameter learning.')}</p></li></ol></aside>

<details class="tech"><summary>{t('我是研究人员：查看技术细节','Researcher view: technical details')}</summary><div><h3>{t('每个分数必须带着证据','Every score travels with evidence')}</h3><p>{t('逻辑记录键：','Logical record key: ')}<code>(stage, task_id, rollout_seed, arm)</code></p><div class="evidence">{evidence.map(([a,b])=><article><strong>{a}</strong><code>{b}</code></article>)}</div><h3>{t('GPU 运行前先过 CPU 门','Pass the CPU gate before GPU work')}</h3><p><code>Q0–Q4 · GPU_WORKLOAD_LAUNCHED=0</code></p><p>{t('协议、代码、数据索引和合同检查通过后，Q5 才允许使用一张确认空闲的 RTX3090。','Only after protocol, code, index, and contract checks pass may Q5 use one verified-idle RTX3090.')}</p><h3>{t('资格赛规模','Qualification size')}</h3><p><code>2 tasks × 2 rollout seeds × 2 arms = 8 episodes / 4 pairs</code></p><p>{t('失败记录不能在看过结果后被删除或替换；这就是 fail-closed。','Failed records cannot be deleted or replaced after outcomes are visible; this is fail-closed.')}</p></div></details>
<footer class="sources"><strong>{t('权威技术来源','Authoritative sources')}</strong><nav><a href={`${sourceRoot}/docs/project/EXPERIMENT_PLAN.md`} target="_blank" rel="noreferrer">EXPERIMENT_PLAN.md</a><a href={`${sourceRoot}/docs/agent-handoffs/OPENEVO-SEED-WEBSHOP-COMPARISON-GATE-20260812.md`} target="_blank" rel="noreferrer">COMPARISON_GATE</a></nav></footer>
</section>
<style>
.paired-run{max-width:1180px;margin:4rem auto;padding:0 1.25rem}.plain-header{max-width:850px}.eyebrow,.kicker{font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}h2{font-size:clamp(2.2rem,5vw,4rem);line-height:1.05;max-width:14ch;margin:.5rem 0 1rem}.lede{font-size:1.2rem;line-height:1.75;color:var(--muted)}.story,.compare,.tech{border:1px solid var(--border);border-radius:24px;padding:clamp(1.2rem,3vw,2rem);margin:3rem 0}.story figcaption,.compare figcaption>span{font-weight:800}.story ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:1rem}.story li{position:relative}.story li b{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--border);border-radius:50%;margin-bottom:.8rem}.story li:not(:last-child)::after{content:'';position:absolute;top:17px;left:42px;width:calc(100% - 34px);height:1px;background:var(--border)}.story strong,.big strong{display:block}.story p,.why>p,.compare p,.results p,.big p{color:var(--muted);line-height:1.65}.why{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin:4rem 0}.why h3,.results h3,.big h3,.compare h3{font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.2}.shared{background:var(--surface);padding:1rem 1.25rem;border-radius:16px}.shared ul{display:grid;grid-template-columns:1fr 1fr;gap:.5rem 1.5rem}.arms{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:stretch;margin-top:1rem}.arms article{border:1px solid var(--border);border-radius:18px;padding:1.25rem}.arms em{font-style:normal;font-weight:900}.difference{align-self:center;text-align:center;padding:.75rem}.difference span{display:block;font-size:.72rem;color:var(--muted)}.difference strong{font-size:1.1rem}.note{font-size:.85rem}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.result-grid article{border:1px solid var(--border);border-radius:18px;padding:1.25rem}.result-grid span{font-size:.8rem;color:var(--muted)}.result-grid strong{display:block;font-size:1.2rem;margin:.5rem 0}.big{margin:4rem 0;padding:clamp(1.2rem,3vw,2rem);background:var(--surface);border-radius:24px}.big ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.big li{border-top:3px solid var(--border);padding-top:1rem}.big li.now{border-top-color:currentColor}.big li>span{font-size:.75rem;font-weight:800;color:var(--muted)}.tech summary{cursor:pointer;font-weight:850;font-size:1.05rem}.tech>div{padding-top:1.5rem}.evidence{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.evidence article{display:grid;gap:.5rem;padding:1rem;background:var(--surface);border-radius:14px}.evidence code{white-space:normal}.sources{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--border);padding-top:1.25rem}.sources nav{display:flex;gap:1rem;flex-wrap:wrap}code{font-size:.82em;overflow-wrap:anywhere}
@media(max-width:800px){.story ol,.big ol{grid-template-columns:1fr}.story li{padding-left:3rem}.story li b{position:absolute;left:0}.story li:not(:last-child)::after{left:17px;top:38px;width:1px;height:calc(100% - 18px)}.why{grid-template-columns:1fr}.shared ul,.evidence{grid-template-columns:1fr}.arms{grid-template-columns:1fr}.difference{border-block:1px dashed var(--border)}.result-grid{grid-template-columns:1fr}.sources{display:block}.sources nav{margin-top:.75rem}}
</style>