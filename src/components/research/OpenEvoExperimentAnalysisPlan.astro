---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';

type Mode = '7b-self' | 'four-arm';
interface Props { locale: Locale; mode: Mode }
const { locale, mode } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const sevenBRows = [
  { id:'A1', q:t('先确认我们到底训练了什么','First establish what actually trained'), evidence:t('Stage 1 完成 1,440 次任务尝试，得到 41 条合格成功轨迹；其中有 8 个不同任务各自至少成功 2 次，所以达到了启动训练门槛，并完成 8 次 SD-LoRA 参数更新。Stage 2 又完成 20,480 次尝试；在当时冻结的逐块 8 任务 method-control 下，80 个数据块均未放行，因此 Stage 2 参数更新数是 0。','Stage 1 completed 1,440 task attempts and produced 41 qualifying exact-success trajectories. Eight distinct tasks each succeeded at least twice, meeting the bootstrap threshold and triggering eight SD-LoRA parameter updates. Stage 2 then completed 20,480 more attempts; under the frozen per-block eight-task method-control, none of its 80 blocks was admitted, so Stage-2 parameter updates remained zero.'), method:t('冻结并记录实验执行状态、样本选择记录、学习适配器文件的 SHA 哈希和最终评测来源；同时把 Stage 1 与 Stage 2 的参数更新次数分开统计。','Freeze execution-state, selection, adapter SHA, and final-eval provenance; separate Stage-1 and Stage-2 parameter updates.'), gpu:t('不需要','No'), time:t('10–20 分钟','10–20 min'), out:t('一张“真实训练链”证据表','A ground-truth training-chain table') },
  { id:'A2', q:t('为什么这次历史 Stage 2 是 0 次更新？','Why did this historical Stage 2 record zero updates?'), evidence:t('这次运行采用逐块 method-control：每个 256 次尝试的数据块必须覆盖至少 8 个“重复成功的不同任务”才允许更新。实际每块平均 1.91 个、中位数 2 个、最高 7 个，因此按照当时的程序，80 块都被挡在参数更新之前。与此同时，20,480 次尝试仍产生了 797 条合格成功轨迹。','This run used a per-block method-control: each 256-attempt block needed at least eight distinct repeatedly successful tasks before an update was allowed. Blocks averaged 1.91 such identities, with median 2 and maximum 7, so under that program all 80 blocks were stopped before parameter updates. At the same time, the 20,480 attempts produced 797 qualifying exact-success trajectories.'), method:t('把“运行事实”和“算法解释”分开：7 < 8 是本次程序零更新的直接原因；797 条成功轨迹说明不能把它解释成“没有可学习数据”；逐块清零是否适合作为长期 Stage 2 仍是开放问题。','Separate run fact from algorithm interpretation: 7 < 8 directly explains zero updates under this program; 797 successful trajectories rule out the story that there was no learnable data; whether per-block resets belong in long-term Stage 2 remains open.'), gpu:t('不需要','No'), time:t('20–40 分钟','20–40 min'), out:t('旧运行事实、设计限制与未决算法问题三栏证据表','A three-column record of run facts, design limitation, and unresolved algorithm question') },
  { id:'A3', q:t('逐块清零是否把可学习经验切得太碎？','Did per-block resetting fragment learnable experience?'), evidence:t('事后统计显示：原 256 次窗口为 0/80 达到旧门槛；合并到 512 次是 4/40，1,024 次是 12/20，2,048 次是 10/10。这说明结论对统计窗口高度敏感，但不能单凭事后合并确定新的长期算法。','Post-hoc statistics give 0/80 qualifying old 256-attempt windows, 4/40 at 512 attempts, 12/20 at 1,024, and 10/10 at 2,048. This shows strong sensitivity to the accounting window, but post-hoc pooling alone cannot define the new long-term algorithm.'), method:t('把这些数字保留为 method-control 的敏感性分析，不把 512/1,024/2,048 中任一窗口宣布为新最优规则。新的 Stage 2 必须另行预先登记累计、更新和清空条件。','Keep these numbers as a sensitivity analysis of the method-control; do not declare any of 512/1,024/2,048 the new optimal rule. A new Stage 2 must separately preregister accumulation, update, and reset conditions.'), gpu:t('不需要','No'), time:t('15–30 分钟','15–30 min'), out:t('证明旧结论依赖窗口，而不是挑选新的最佳窗口','Show dependence on the old window without selecting a new best window') },
  { id:'A4', q:t('loss 下降是否真的对应 WebShop 能力上升？','Did lower loss actually track WebShop capability?'), evidence:t('同一套已封存的 128 个评测任务已经覆盖初始基础模型和 8 个 Stage-1 更新后保存点。平均任务得分依次为 13.33 / 17.13 / 18.41 / 13.67 / 17.63 / 16.51 / 22.01 / 20.72 / 25.66；训练 loss 则从 0.479 单调降到 0.055。','The complete sweep on the same sealed 128-task panel is finished: base / increment-00…07 Task Score = 13.33 / 17.13 / 18.41 / 13.67 / 17.63 / 16.51 / 22.01 / 20.72 / 25.66 while training loss falls monotonically from 0.479 to 0.055.'), method:t('GPU 补测已经完成。结论是“总体后期更强，但不是每次参数更新都会更强”：第 2→3 次更新以及第 6→7 次更新后，固定 128 任务上的得分都出现回落。因此训练 loss 不能被当成会与未参与训练的评测任务能力同步升降的指标。','The GPU sweep is complete. The result is later checkpoints are stronger overall, but not every update helps: score regresses at increment-01→02 and increment-05→06, so loss is not a monotonic proxy for held-out capability.'), gpu:t('已完成 · 2×5090','Complete · 2×5090'), time:t('实际运行耗时 4,813.6 秒（约 80.2 分钟）','Observed wall time 4,813.6 s (~80.2 min)'), out:t('第 8 次更新后的最后保存点得分最高；训练 loss 与任务能力总体有关，但每次更新后的能力并不会单调上升','Final increment-07 is best; loss and capability move together overall, but the capability curve is clearly non-monotonic') },
  { id:'A5', q:t('25.66 的提升到底来自“更会做题”还是“更会说合法动作”？','Did the 25.66 gain come from solving tasks or producing more executable actions?'), evidence:t('固定 128 任务的最终评测：初始基础模型到 7B/self 的平均任务得分从 13.33 升到 25.66；技术有效轨迹从 109 增到 122，动作格式或解析失败从 19 降到 6，需要系统修复动作格式的轨迹从 80 降到 47，而完整成功只从 3 个增到 4 个。','On the 128-task final panel: base 13.33 → self 25.66; valid 109→122, parser/action failures 19→6, repairs 80→47, while exact success rose only 3→4.'), method:t('对同一批任务逐题配对分析：哪些任务从技术无效变为有效、哪些只是部分得分提高、哪些从未完整成功变为完整成功、哪些反而退步；然后再把失败轨迹按原因分类。','Run per-task paired decomposition: invalid→valid, partial-reward gains, exact fail→success, regressions, then classify failure trajectories.'), gpu:t('不需要','No'), time:t('30–60 分钟','30–60 min'), out:t('格式能力、搜索/推理能力、最终购买成功三层贡献','Contribution from format, search/reasoning, and final purchase success') },
  { id:'A6', q:t('“继续训练更多步”值得吗？','Is more training worth it?'), evidence:t('训练保存点补测显示，第 8 次 Stage-1 更新后的保存点得分最高，但能力曲线两次回落，完整成功只从 3/128 增到 4/128。Stage 2 的 0 次更新来自旧 method-control 没有放行，不能当成模型经过合理 Stage 2 训练后的结果。','The final Stage-1 checkpoint scores best, but capability regresses twice and exact success moves only from 3/128 to 4/128. Stage 2 recorded zero updates because the old method-control admitted none; it is not an outcome after a well-designed Stage 2.'), method:t('不能靠 loss 下降决定继续训练，也不能只把 8 改成 7。应先预先登记新的长期 Stage 2 学习合同：何时累计、何时更新、更新后何时清空，以及怎样避免事后挑最优窗口。','Neither falling loss nor simply changing 8 to 7 is sufficient. First preregister a new long-term Stage-2 learning contract: when to accumulate, when to update, when to reset after an update, and how to avoid post-hoc window optimization.'), gpu:t('决策本身不需要','No for the decision'), time:t('训练保存点证据已完成','Checkpoint evidence closed'), out:t('先设计长期学习合同，再决定续跑；不把旧零更新当作模型上限','Design the long-term learning contract before rerunning; do not treat old zero-update as a model ceiling') },
  { id:'A7', q:t('怎样验证新的 Stage 2，而不掉进“事后挑最优”陷阱？','How should a new Stage 2 be tested without post-hoc optimization?'), evidence:t('旧运行只能证明：在冻结的逐块 8 任务规则下，数据没有进入参数更新。它不能证明降低门槛、扩大窗口或无限累计中的任何一个方案会让在线策略变好；一旦发生更新，后续轨迹分布也会改变。','The old run proves only that data did not enter parameter updates under the frozen per-block eight-task rule. It cannot establish that lowering the threshold, enlarging the window, or accumulating indefinitely will improve the online policy; once an update occurs, later trajectory distributions change.'), method:t('从同一 Stage-1 保存点起跑，预先固定一个新的累计—更新—清空合同，并冻结任务顺序、采样和评测。旧 7/8 配置保留为历史 method-control 对照，而不是被称为 OpenEVO 官方长期 Stage 2。','Restart from the same Stage-1 checkpoint with one preregistered accumulate-update-reset contract while freezing task order, sampling, and evaluation. Keep the old 7/8 configuration as a historical method-control comparator, not as the official long-term OpenEVO Stage 2.'), gpu:t('需要 2 张卡','2 GPUs'), time:t('完整在线复现约 28–30 小时；较小诊断版本约 6 小时','Full online replication about 28–30 h; a smaller diagnostic version about 6 h'), out:t('新长期 Stage 2 合同相对历史 method-control 的因果检验','A causal test of the new long-term Stage-2 contract against the historical method-control') },
];

const armPlans = [
  { arm:'3B / self', state:t('Stage 1：未达到启动门槛，因此 0 次参数更新；旧 Stage 2：20,480 次任务尝试全部完成，其中 138 条是合格成功轨迹；最好的一批只有 2 个不同任务能够重复完整成功，低于当时要求的 8 个，因此没有触发 Stage-2 参数更新；封存的最终 128 任务评测为 Task Score ×100 = 1.71、完整成功 1/128、技术有效 121/128','Stage 1: bootstrap threshold not reached, so 0 parameter updates; old Stage 2 completed all 20,480 task attempts and produced 138 qualifying exact-success trajectories. The best batch had only two distinct tasks that succeeded repeatedly, below the historical requirement of eight, so Stage 2 triggered no parameter update; the sealed 128-task final records Task Score ×100 = 1.71, exact success 1/128, and 121/128 valid episodes'), q:t('3B 为什么很难让足够多的不同任务各自重复完整成功？','Why does 3B struggle to make enough distinct tasks each succeed repeatedly?'), evidence:t('Stage 1 只有 4 条合格成功轨迹，而且这些成功只来自 1 个能重复成功的任务；启动参数训练需要 8 个这样的不同任务，所以没有创建学习适配器。旧 Stage 2 随后完成 20,480 次任务尝试并得到 138 条合格成功轨迹；但最好的一批也只有 2 个不同任务能够重复完整成功，而当时要求至少 8 个才允许更新参数。因此 80 批数据都没有触发参数更新。','Stage 1 produced only four qualifying exact-success trajectories, all from one task that succeeded repeatedly; bootstrap requires eight such distinct tasks, so no learned adapter was created. The old Stage 2 then completed 20,480 attempts and produced 138 qualifying exact-success trajectories. Even the best batch contained only two distinct tasks that succeeded repeatedly, while the historical rule required at least eight before an update was allowed. None of the 80 batches therefore triggered a parameter update.'), work:t('把成功轨迹、动作格式失败和任务类型分开统计，重点判断：3B 是本身几乎产生不了完整成功，还是“每块必须有 8 个不同任务重复成功”的同一门槛对 3B 过严。','Separate successful trajectories, action-format failures, and task types to test whether 3B rarely produces exact success at all or whether the same eight-distinct-task threshold is too strict for 3B.'), gpu:t('不需要','No'), time:t('45–75 分钟','45–75 min') },
  { arm:'7B / self', state:t('Stage 1：8 次参数更新；Stage 2：80 个数据块全部完成、0 次参数更新；最终 Task Score ×100 = 25.66；8 个 Stage-1 保存点补测已完成','Stage 1: 8 parameter updates; Stage 2: all 80 blocks completed with 0 parameter updates; final Task Score ×100 = 25.66; evaluation sweep across all eight Stage-1 checkpoints complete'), q:t('Stage 1 的 8 次参数更新学到了什么，以及为什么 Stage 2 完成全部探索后仍没有改动参数？','What did the eight Stage-1 parameter updates learn, and why did Stage 2 finish all exploration without changing the parameters?'), evidence:t('8 个 Stage-1 参数更新后的保存点都已补测：训练 loss 从 0.479 降到 0.055，但固定 128 任务上的 Task Score 会中途回落，最终 25.66 是最高点。Stage 2 的 20,480 次尝试里虽有 797 条合格成功轨迹，但最好的一块也只有 7 个不同任务能够各自重复成功；规则需要 8 个，因此 Stage 2 没有触发参数更新。','All eight post-update Stage-1 checkpoints have been evaluated: training loss fell from 0.479 to 0.055, while Task Score on the fixed 128 tasks regressed between some updates; the final 25.66 is the best point. Stage 2 produced 797 qualifying exact-success trajectories across 20,480 attempts, but even the best block had only seven distinct tasks with repeated success; the rule requires eight, so Stage 2 triggered no parameter update.'), work:t('训练保存点的 GPU 补测已经完成；剩余重点是逐题失败类型分解，以及“8 个重复成功任务”这一参数更新门槛的因果检验，而不是重复同一批保存点测试。','The GPU checkpoint gap is closed; remaining work should focus on per-task failure decomposition and a causal test of the eight-repeated-task update threshold rather than repeating the same checkpoint sweep.'), gpu:t('训练保存点补测已完成；后续只有参数更新门槛的因果实验需要 GPU','Checkpoint sweep complete; only a later causal update-threshold experiment needs GPUs'), time:t('GPU sweep 实跑约 80.2 分钟','GPU sweep observed ~80.2 min') },
  { arm:'3B + MiniMax', state:t('MiniMax 回看监督后的启动训练：8 次参数更新；旧 Stage 2 完成 59 批完整数据，共 15,104 次任务尝试和 38 条合格成功轨迹；最好的一批只有 1 个不同任务能够重复完整成功，低于当时要求的 8 个，因此没有触发参数更新。第 60 批已产生 171 次任务尝试时由用户明确停止并标记旧方法已被取代；不再继续最终评测','Bootstrap with MiniMax hindsight supervision: 8 parameter updates; old Stage 2 completed 59 full batches with 15,104 task attempts and 38 qualifying exact-success trajectories. The best batch had only one distinct task that succeeded repeatedly, below the historical requirement of eight, so no parameter update was triggered. The owner explicitly stopped and superseded the old method after 171 attempts had been produced in batch 60; no final evaluation will be continued'), q:t('MiniMax 在任务结束后提供的回看监督，能不能让原本达不到启动训练门槛的 3B 真正发生参数学习？','Can MiniMax hindsight supervision after a completed task make 3B, which otherwise fails the bootstrap threshold, actually begin parameter learning?'), evidence:t('它复用 3B/self 完全相同的 1,440 条学生任务轨迹；MiniMax 只在一整次任务结束后回看轨迹并生成监督，不替学生在 WebShop 里行动。启动阶段完成了 8 次 SD-LoRA 参数更新，训练 loss 从 2.798 降到 1.827。旧 Stage 2 随后留下 59 批完整数据，但这 59 批都没有触发参数更新；最好的一批只有 1 个不同任务能够重复完整成功，而当时的规则要求至少 8 个。停止时第 60 批已经产生的 171 次任务尝试也原样保留，但不混入前 59 批完整统计。','It reuses exactly the same 1,440 student task trajectories as 3B/self. MiniMax reviews a completed task trajectory to generate supervision and never acts in WebShop for the student. Bootstrap completed eight SD-LoRA parameter updates and training loss fell from 2.798 to 1.827. The old Stage 2 then retained 59 complete batches, none of which triggered a parameter update. Even the best batch had only one distinct task that succeeded repeatedly, while the historical rule required at least eight. The 171 attempts already produced in batch 60 were preserved when the run stopped but are not mixed into the 59 complete-batch statistics.'), work:t('先分析 MiniMax 启动训练是否改善了动作技术有效性、部分任务得分，以及 Stage 2 中“不同任务重复完整成功”的覆盖率；不要把所有差异直接归因成纯 MiniMax 效应。','First test whether this bootstrap improves technical action validity, partial task score, and Stage-2 coverage of distinct tasks with repeated exact success; do not attribute every difference to a pure MiniMax effect.'), gpu:t('现有过程分析不需要；训练保存点能力曲线可选','No for process analysis; optional for checkpoint capability curve'), time:t('CPU 45–90 分钟；可选 GPU 约 1–2 小时','CPU 45–90 min; optional GPU about 1–2 h') },
  { arm:'7B + MiniMax', state:t('MiniMax 回看监督后的启动训练：8 次参数更新；旧 Stage 2：20,480 次任务尝试全部完成，其中 592 条是合格成功轨迹；最好的一批有 7 个不同任务能够重复完整成功，低于当时要求的 8 个，因此没有触发 Stage-2 参数更新；历史 128 任务最终 Task Score ×100 = 16.94，完整成功 0/128','Bootstrap with MiniMax hindsight supervision: 8 parameter updates; old Stage 2 completed all 20,480 task attempts and produced 592 qualifying exact-success trajectories. The best batch had seven distinct tasks that succeeded repeatedly, below the historical requirement of eight, so Stage 2 triggered no parameter update; historical 128-task final Task Score ×100 = 16.94 with 0/128 exact successes'), q:t('7B 不靠外部老师也能启动参数学习时，MiniMax 的任务后回看监督还改变了什么？','When 7B can already bootstrap itself, what does MiniMax post-task hindsight supervision still change?'), evidence:t('启动阶段完成 8 次参数更新，训练 loss 从 2.737 降到 1.634。旧 Stage 2 随后完成 20,480 次任务尝试并得到 592 条合格成功轨迹。按当时规则，每 256 次尝试里至少要有 8 个不同任务各自重复完整成功才允许更新；实际最好的一批只有 7 个，因此 80 批数据都没有触发参数更新，最终评测继续使用 MiniMax 启动训练结束时的 adapter。','Bootstrap completed eight parameter updates and training loss fell from 2.737 to 1.634. The old Stage 2 then completed 20,480 task attempts and produced 592 qualifying exact-success trajectories. Under the historical rule, every 256 attempts needed at least eight distinct tasks that each succeeded repeatedly before an update was allowed; the best batch reached only seven. None of the 80 batches therefore triggered a parameter update, so final evaluation continued to use the post-MiniMax-bootstrap adapter.'), work:t('最终与 7B/self 在相同任务上逐题配对比较；Stage 2 只比较两组都已完成的相同数据块前缀，分别看合格成功轨迹、达标任务身份和动作解析状态，追踪启动训练对后续自探索的影响。','Pair final tasks against 7B/self and compare only matched Stage-2 block prefixes, tracking qualifying success trajectories, qualifying task identities, and parser state to trace how bootstrap changes later self-exploration.'), gpu:t('过程分析不需要；训练保存点能力曲线可选 2×5090','No for process analysis; optional checkpoint capability curve on 2×5090'), time:t('CPU 45–90 分钟；可选 GPU 1.5–2 小时','CPU 45–90 min; optional GPU 1.5–2 h') },
];

const fourRows = [
  { id:'B1', q:t('外部分析老师 + 启动训练这一整套实验处理有没有帮助？','Does the external-analyzer + bootstrap treatment bundle help?'), contrast:'3B：MiniMax 回看监督组 − self 组；7B：MiniMax 回看监督组 − self 组', method:t('等各组最终评测完成后，在相同的 128 个任务上逐题配对比较；同时比较 Stage 1 / Stage 2 参数更新次数、技术有效性、部分任务得分和完整成功。这里比较的是一整套实验处理，不只是“换了一个老师”。','After each final completes, use paired task contrasts on the same 128-task panel and compare parameter updates, validity, partial reward, and exact success. The treatment changes more than teacher identity alone.'), gpu:t('最终评测完成后不需要额外 GPU','No once finals exist'), time:t('45–75 分钟','45–75 min') },
  { id:'B2', q:t('MiniMax 的启动训练是否改变后续模型自主探索时的成功任务覆盖率？','Does the MiniMax bootstrap change downstream self-exploration coverage?'), contrast:t('同一模型、同样多的 Stage-2 数据块：比较合格成功轨迹数、达标任务身份数，以及离“8 个身份”门槛还差多少','Same model and the same number of Stage-2 blocks: compare qualifying successes, qualifying task identities, and how far each block is from the eight-identity threshold'), method:t('只比较实验进度相同的前缀：3B/MiniMax 已在 59 个完整 block 后停止，因此 3B 对照最多比较双方前 59 个完整 block；7B 两组都完成 80 个 block，可比较完整 80-block 序列。画出随数据块推进的成功任务覆盖率，不把 partial block 混入完整 block。','Compare only matched progress prefixes: because 3B/MiniMax was stopped after 59 complete blocks, the 3B contrast is bounded to the first 59 complete blocks from each arm; both 7B arms completed all 80 blocks and can use the full sequence. Plot successful-task coverage without mixing the partial block into complete-block statistics.'), gpu:t('不需要','No'), time:t('45–90 分钟','45–90 min') },
  { id:'B3', q:t('“每块至少 8 个重复成功任务”的参数更新门槛，是不是四组实验的共同瓶颈？','Is the requirement of eight repeatedly successful tasks per block a shared bottleneck across all four arms?'), contrast:t('每 256 次任务尝试里有多少个不同任务能重复完整成功，以及离 8 个任务的更新门槛还差多少','How many distinct tasks achieve repeated exact success in each 256 attempts, and how far that is from the eight-task update threshold'), method:t('四组都用同一口径统计：哪些数据块达到 8 个任务、哪些只差 1–2 个；如果允许相邻窗口累积会发生什么；以及早期、中期、后期是否有系统变化。已有快照里，所有已完成的数据块都没有触发 Stage-2 参数更新，所以这是优先级很高的共同机制问题。','Use the same analysis across all four arms: which blocks reach eight tasks, which miss by only one or two, what would happen under adjacent-window pooling, and whether early/middle/late behavior changes systematically. In the available snapshot, no completed block has triggered a Stage-2 parameter update, making this a high-priority shared mechanism question.'), gpu:t('不需要','No'), time:t('45–75 分钟','45–75 min') },
  { id:'B4', q:t('模型规模改变的是“能不能启动参数学习”，还是启动训练后的任务能力？','Does scale change bootstrap feasibility or post-bootstrap capability?'), contrast:t('无外部老师：7B vs 3B；MiniMax 回看监督组：7B vs 3B','self: 7B vs 3B; MiniMax bundle: 7B vs 3B'), method:t('把“是否达到启动训练门槛”、各训练保存点的 loss、Stage 2 成功任务覆盖率和最终平均任务得分分开分析，不把“7B 分高”简化成一个数字。','Separate bootstrap admission, checkpoint loss, Stage-2 coverage, and final task score instead of reducing scale to one score.'), gpu:t('不需要','No'), time:t('30–60 分钟','30–60 min') },
  { id:'B5', q:t('MiniMax 这一整套实验处理的收益幅度是否随模型大小改变？','Does the MiniMax treatment-bundle contrast depend on model size?'), contrast:'(7B MiniMax − 7B self) − (3B MiniMax − 3B self)', method:t('四组最终评测全部完成后，可以比较“MiniMax 相对 self 的提升幅度在 3B 与 7B 上是否不同”。但 self 与 MiniMax 的启动阶段使用了不同的样本选择和监督方式，所以这个差异只能解释为整套实验处理与模型规模的交互，不能解释成纯粹的“老师身份”因果效应。','After all finals complete, compute a descriptive difference-in-differences / interaction. Because self and MiniMax use non-identical bootstrap selection and supervision, call it a treatment-bundle interaction, not a pure teacher causal interaction.'), gpu:t('不需要','No'), time:t('30–60 分钟','30–60 min') },
  { id:'B6', q:t('最终分数差异究竟来自格式、部分进展还是完整成功？','Do final differences come from formatting, partial progress, or exact completion?'), contrast:t('技术有效性 / 动作修复 / 无效动作 → 部分任务得分 → 完整成功','technical validity / action repair / invalid actions → partial task score → exact success'), method:t('四组使用同一套失败原因分类，并对每个任务做前后状态转移表；这样可以避免把“动作格式更合法”误写成“推理能力大幅提升”。','Apply one failure taxonomy and per-task paired transition matrix across all arms so better action validity is not mislabeled as a large reasoning gain.'), gpu:t('不需要','No'), time:t('1–2 小时','1–2 h') },
  { id:'B7', q:t('怎样和 SEED 论文结果放在一起讲？','How should these results be discussed beside SEED?'), contrast:t('本地四组实验处理对比 ≠ 直接拿论文模型保存点的分数做减法','Local four-arm treatment comparison ≠ direct subtraction from the paper checkpoint'), method:t('SEED 论文报告的数字只作为外部参照。若要正式声称“OpenEvo vs SEED”，仍需先对齐任务定义、训练与外部老师预算、被评测的模型保存点和评测器；这四组实验首先回答的是启动学习与后续自进化机制。','Use SEED paper-reported numbers as external context only. A formal OpenEvo-vs-SEED claim still requires aligned task semantics, training/teacher budget, checkpoint, and evaluator; these four arms first answer bootstrap/self-evolution mechanism questions.'), gpu:t('不需要','No'), time:t('20–30 分钟','20–30 min') },
  { id:'B8', q:t('只做这一轮四组实验，能不能证明一般规律？','Can one four-arm run establish a general rule?'), contrast:t('同一批任务上的统计不确定性 ≠ 更换训练随机种子后的不确定性','task-level uncertainty ≠ training-seed uncertainty'), method:t('同一批 128 个任务的逐题配对结果，可以估计这一轮实验在任务层面的统计不确定性；若要声称实验处理方式或模型规模的效果具有稳健性，还需要使用不同训练随机种子独立重复实验。','The 128 paired tasks can yield task-level bootstrap CIs for this run; robust treatment/scale claims require independent training seeds.'), gpu:t('首轮分析不需要；不同训练随机种子的重复实验才需要','No initially; GPUs for multi-seed'), time:t('首轮分析 20–30 分钟；不同训练随机种子的重复实验属于多日预算','20–30 min initially; multi-seed is a multi-day budget') },
];

const seed7BWebShopRows = [
  { method: 'Vanilla', score: '5.9', success: '1.6' },
  { method: 'Skill-Prompt*', score: '1.7', success: '0.8' },
  { method: 'OPSD', score: '4.5', success: '2.3' },
  { method: 'GRPO', score: '80.9', success: '72.6' },
  { method: 'Skill-GRPO', score: '80.4', success: '71.9' },
  { method: 'Skill-GRPO*', score: '87.0', success: '81.2', successRank: 'second' },
  { method: 'GRPO+OPSD', score: '86.8', success: '76.5' },
  { method: 'Skill-SD', score: '86.1', success: '76.5' },
  { method: 'RLSD', score: '87.4', success: '77.3' },
  { method: 'SDAR', score: '89.4', success: '82.8', scoreRank: 'second', successRank: 'best' },
  { method: 'SEED (Ours)', score: '89.7', success: '78.1', scoreRank: 'best' },
];

const isSeven = mode === '7b-self';
const rows = isSeven ? sevenBRows : fourRows;
---
<article class="analysis-plan" data-testid={`experiment-analysis-plan-${mode}`}>
  <header class="analysis-hero">
    <p class="eyebrow">{isSeven ? t('实验后分析方案 · 7B / SELF', 'POST-EXPERIMENT ANALYSIS · 7B / SELF') : t('四组联合分析方案 · SELF / MINIMAX', 'FOUR-ARM ANALYSIS · SELF / MINIMAX')}</p>
    <h1>{isSeven ? t('7B 无外部教师实验：我们还能从这一轮实验里知道什么？','7B without an external teacher: what else can this run tell us?') : t('3B / 7B × self / MiniMax：四组实验怎样一起回答问题？','3B / 7B × self / MiniMax: what can the four arms tell us together?')}</h1>
    <p class="lede">{isSeven
      ? t('训练保存点的 GPU 补测已经完成。现在必须把旧运行事实和长期算法分开：7 < 8 准确解释当时程序为什么没有更新，但逐块清零的 8 任务规则只是历史 method-control，不是 OpenEVO 长期 Stage 2 的必然定义。尚未解决的是新的累计—更新—清空合同与逐题失败机制。','The checkpoint GPU sweep is complete. Run fact and long-term algorithm must now be separated: 7 < 8 accurately explains why that program did not update, but the per-block eight-task reset rule was a historical method-control, not a necessary definition of long-term OpenEVO Stage 2. The unresolved work is a new accumulate-update-reset contract and finer per-task failure analysis.')
      : t('这四组可以画成 3B/7B × self/MiniMax 的 2×2 比较图，但它不是一个只改变“老师身份”的纯因果实验。MiniMax 不替学生做 WebShop 任务，而是在一次完整任务轨迹结束后回看并生成监督；这同时改变了启动训练阶段的监督内容和样本选择方式。Stage 2 则都回到本地学生模型自己探索。因此我们比较的是“整套启动处理方式”、模型规模以及后续自主探索，而不能把所有差异都归因给 MiniMax 这个老师本身。','The four arms form a useful 3B/7B × self/MiniMax comparison map, but not a clean causal experiment on teacher identity. MiniMax acts only after a completed trajectory and changes the bootstrap supervision/selection bundle; Stage 2 returns to local student self. We therefore compare treatment bundles, scale, and downstream self-exploration rather than attributing every difference to MiniMax.')}</p>
    <div class="hero-actions"><a href={p('/research/seed-openevo/study/results/')}>{t('← 返回实验结果','← Back to results')}</a>{isSeven && <a href={p('/research/seed-openevo/study/results/four-arm-analysis/')}>{t('查看四组联合方案 →','Open four-arm plan →')}</a>}</div>
  </header>

  {isSeven && (
    <section class="stage1-choice-map" aria-labelledby="stage1-choice-title" data-testid="stage1-choice-map">
      <div class="section-kicker">{t('Stage 1 设计分岔', 'STAGE 1 DESIGN FORK')}</div>
      <h2 id="stage1-choice-title">{t('同样 1,440 条轨迹：老师是谁，和讲评怎样写回参数，是两次不同选择','The same 1,440 trajectories create two separate choices: who analyzes them, and how the analysis is written back into parameters')}</h2>
      <p>{t('我们现在把旧实验放回正确的位置：MiniMax 确实完整分析了 1,440 / 1,440 条 7B 轨迹；问题出在后面的参数写入只选了其中 16 条。这里的 16 / 1,440 数的是“真正进入参数训练的讲评记录”，不是模型分数，也不是 MiniMax 只分析了 16 条。这个选择与做题时的采样温度（rollout temperature）无关。','We now place the historical run on the correct branch: MiniMax did analyze all 1,440/1,440 7B trajectories; the later parameter-write stage selected only 16 of them. That choice is independent of rollout temperature.')}</p>

      <div class="choice-flow" role="img" aria-label={t('Stage 1 选择树：1440 条轨迹先选择 GLM 或 MiniMax 分析，再选择 SFT 或 SD-LoRA；SD-LoRA 又分全量利用 1440 条和历史只用 16 条。','Stage-1 choice tree: 1,440 trajectories are analyzed by GLM or MiniMax, then written back by SFT or SD-LoRA; SD-LoRA further branches into full 1,440-record use or the historical 16-record subset.')} >
        <div class="choice-step choice-step--source"><span>01</span><strong>1,440 {t('条 Qwen WebShop 轨迹','Qwen WebShop trajectories')}</strong><small>180 个任务 × 每任务 8 次完整尝试</small></div>
        <div class="choice-arrow">↓</div>
        <div class="choice-row">
          <article><span>02A · SEED</span><strong>GLM-5.2</strong><small>{t('任务结束后的回看分析者（hindsight analyzer）','post-episode hindsight analyzer')}</small></article>
          <article class="choice-active"><span>02B · OUR SUBSTITUTE</span><strong>MiniMax-M3</strong><small>{t('7B：1,440/1,440 解析成功','7B: 1,440/1,440 parsed successfully')}</small></article>
        </div>
        <div class="choice-arrow">↓</div>
        <div class="choice-row">
          <article><span>03A</span><strong>SFT</strong><small>{t('SEED：整理后把训练集完整学习 3 轮（3 epochs）','SEED: train the compiled corpus for 3 epochs')}</small></article>
          <article class="choice-active"><span>03B</span><strong>SD-LoRA</strong><small>{t('OpenEVO 参数写入路径','OpenEVO parameter-write path')}</small></article>
        </div>
        <div class="choice-arrow">↓</div>
        <div class="choice-row">
          <article><span>04A · NEXT</span><strong>{t('充分利用 1,440 条','Use all 1,440 analyses')}</strong><small>{t('尚未作为正式实验跑过','Not yet run as the formal experiment')}</small></article>
          <article class="choice-legacy"><span>04B · ACTUALLY RAN</span><strong>{t('只用 16 / 1,440 条','Use only 16 / 1,440')}</strong><small>8 tasks × rollout slots 0,1</small></article>
        </div>
      </div>

      <aside class="legacy-experiment" id="legacy-minimax-16">
        <div class="legacy-experiment__header">
          <span>{t('历史实验 · 设计未达到原预期','HISTORICAL RUN · DESIGN DID NOT MATCH THE ORIGINAL INTENT')}</span>
          <strong>MiniMax → SD-LoRA → 16 / 1,440</strong>
        </div>
        <p>{t('这次运行不是工程故障：代码忠实执行了当时预先冻结的实验方案（preregistration）。但从现在重新确认的科学目标看，它没有实现“MiniMax 分析 1,440 条后，让 OpenEVO 充分学习这些讲评”。其余 1,424 条讲评仍被保存为分析证据，但没有进入这次 Stage 1 参数训练。','This run was not an engineering failure: the code faithfully executed the frozen preregistration. In light of the clarified scientific intent, however, it did not implement “MiniMax analyzes 1,440 trajectories and OpenEVO learns from the full set.” The remaining 1,424 analyses were preserved as evidence but did not enter this Stage-1 parameter training.')}</p>
        <div class="legacy-facts">
          <div><span>{t('MiniMax 分析','MiniMax analyzed')}</span><strong>1,440 / 1,440</strong></div>
          <div><span>{t('真正进入启动参数训练','Entered bootstrap')}</span><strong>16 / 1,440</strong></div>
          <div><span>{t('SD-LoRA 参数更新次数','SD-LoRA increments')}</span><strong>8</strong></div>
          <div><span>{t('Stage 2 参数更新次数','Stage-2 updates')}</span><strong>0</strong></div>
          <div><span>7B 本地 128 任务最终得分</span><strong>16.94</strong></div>
          <div><span>{t('完整成功任务数','Exact success')}</span><strong>0 / 128</strong></div>
        </div>
        <p class="legacy-boundary"><strong>{t('这个 16.94 代表什么：','What the 16.94 represents: ')}</strong>{t('16.94 是这条“只学 16 条讲评 + 后续 Stage 2 没有触发参数更新”的历史路径结果，不应被写成“完整利用 MiniMax 1,440 条讲评后的 OpenEVO 成绩”，也不能据此判断 SD-LoRA 本身无效。','16.94 belongs to this historical path: only 16 analyzer records were learned, and the later Stage 2 triggered no parameter update. It must not be presented as OpenEVO after fully learning all 1,440 MiniMax analyses, nor as evidence that SD-LoRA itself is ineffective.')}</p>
        <details class="legacy-evidence">
          <summary>{t('展开：到底选了哪 16 条？为什么和采样温度从 0 改到 0.4 不是一回事','Expand: which 16 were selected, and why this is different from temperature=0→0.4')}</summary>
          <p>{t('当时的样本选择规则只按固定位置取样，不按结果好坏挑样本：取 Stage 1 的第 0–7 个语义任务，每个任务只取第 0 和第 1 次完整尝试；两种模型规模使用同一组任务位置。','The selection policy was schedule-only: Stage-1 semantic task ordinals 0–7, with rollout slots 0 and 1 from each task. No outcome score was used for selection, and both model sizes used the same semantic positions.')}</p>
          <code>task000:0 · task000:1 · task001:0 · task001:1 · task002:0 · task002:1 · task003:0 · task003:1 · task004:0 · task004:1 · task005:0 · task005:1 · task006:0 · task006:1 · task007:0 · task007:1</code>
          <p>{t('采样温度从 0 改到 0.4，影响的是“Qwen 做 WebShop 时，同一任务的 8 次完整尝试有多随机”；16 / 1,440 则发生在 MiniMax 已经完成全部分析之后，决定哪些讲评真正进入启动参数训练。两者发生在不同环节，不是同一个问题。','Changing temperature from 0 to 0.4 changes how stochastic Qwen is across the eight WebShop rollouts. The 16/1,440 choice happens later, after MiniMax has already analyzed the trajectories, as a downstream bootstrap selection. These are different issues.')}</p>
          <p>{t('旧实验配置还明确规定 `same_16_records_reused_in_each_increment=true`：同一组 16 条记录被重复用于 8 次顺序 SD-LoRA 参数更新；每次更新都使用 16 条训练记录，并执行 16 个优化步。后面的机器字段保留用于审计，不承担读者解释。','The historical recipe also explicitly sets same_16_records_reused_in_each_increment=true: the same 16 records were used for eight sequential SD-LoRA increments, each with training_record_count=16 and optimizer_steps=16.')}</p>
        </details>
      </aside>
    </section>
  )}

  {isSeven ? (
    <>
      <section class="snapshot" aria-labelledby="snapshot-title">
        <div class="section-kicker">{t('服务器事实快照', 'SERVER FACT SNAPSHOT')}</div>
        <h2 id="snapshot-title">{t('Stage 2 的任务尝试量与参数更新量','Stage-2 task-attempt volume and parameter updates')}</h2>
        <p>{t('北京时间 2026-08-29 19:35 的只读审计确认：最终 128 任务评测加载的是 Stage 1 第 8 次参数更新后的保存点（increment-07）。Stage 2 随后完成了全部 20,480 次任务尝试；按这次历史运行冻结的逐块 8 任务 method-control，80 个数据块均未放行，因此没有创建新的学习适配器，最终参数仍停留在 Stage 1 结束时。这是旧程序的运行事实，不是合理长期 Stage 2 训练后的能力结论。','A read-only audit at 2026-08-29 19:35 UTC+8 confirms that the final 128-task evaluation loaded the checkpoint after the eighth Stage-1 parameter update (increment-07). Stage 2 then completed all 20,480 attempts. Under this historical run’s frozen per-block eight-task method-control, none of the 80 blocks was admitted, so no new adapter was created and parameters remained at the end of Stage 1. This is a fact about the old program, not a capability conclusion after a well-designed long-term Stage 2.')}</p>
        <div class="score-comparison" data-testid="webshop-7b-score-comparison">
          <div class="score-comparison__heading">
            <div class="score-comparison__latex-caption">
              <span>Table 1:</span>
              <h3>{t('Qwen2.5-7B-Instruct 在 WebShop 上的性能对比', 'Performance comparison on WebShop · Qwen2.5-7B-Instruct')}</h3>
            </div>
            <p>{t('论文行按原表的 WebShop 数字排版；表尾追加我们的两组 7B 正式最终评测：无外部教师的 self 组，以及由 MiniMax 在任务结束后提供回看分析的组。','Paper rows preserve the reported WebShop values; the two formal OpenEVO 7B finals are appended below: self and the MiniMax hindsight-analyzer arm.')}</p>
          </div>
          <div class="score-comparison__wrap">
            <table class="score-comparison__table">
              <caption>{t('SEED Table 1 的 Qwen2.5-7B-Instruct / WebShop 子表，加上 OpenEVO 7B 两个实验位。','The Qwen2.5-7B-Instruct / WebShop slice of SEED Table 1, plus two OpenEVO 7B experiment slots.')}</caption>
              <thead><tr><th>{t('方法','Method')}</th><th>{t('教师 / 回看分析者','Teacher / analyzer')}</th><th>{t('WebShop 平均任务得分','WebShop Score')}</th><th>{t('完整成功率','Succ.')}</th></tr></thead>
              <tbody>
                <tr class="score-comparison__group"><th colspan="4">{t('SEED 论文报告 · Qwen2.5-7B-Instruct','SEED paper-reported · Qwen2.5-7B-Instruct')}</th></tr>
                {seed7BWebShopRows.map((row) => (
                  <tr class="score-comparison__paper-row">
                    <th scope="row">{row.method}</th>
                    <td class="score-comparison__muted">—</td>
                    <td class:list={[row.scoreRank === 'best' && 'is-best', row.scoreRank === 'second' && 'is-second']}>{row.score}</td>
                    <td class:list={[row.successRank === 'best' && 'is-best', row.successRank === 'second' && 'is-second']}>{row.success}</td>
                  </tr>
                ))}
                <tr class="score-comparison__group score-comparison__group--openevo"><th colspan="4">OpenEVO · Qwen2.5-7B-Instruct</th></tr>
                <tr class="score-comparison__ours">
                  <th scope="row">OpenEVO · 7B / self</th>
                  <td>{t('无外部教师','No external teacher')}</td>
                  <td><strong>25.66</strong><small>{t('同一套本地 128 任务：基础模型 13.33 → 最终 25.66','same local panel: base 13.33 → final 25.66')}</small></td>
                  <td><strong>3.1%</strong><small>3/128 → 4/128</small></td>
                </tr>
                <tr class="score-comparison__minimax">
                  <th scope="row">OpenEVO · 7B + MiniMax</th>
                  <td>MiniMax <small>{t('任务结束后的回看分析者（hindsight analyzer）','post-episode hindsight analyzer')}</small></td>
                  <td><strong>16.94</strong><small>{t('同一套本地 128 任务：基础模型 13.33 → 最终 16.94','same local panel: base 13.33 → final 16.94')}</small></td>
                  <td><strong>0.0%</strong><small>{t('完整成功：基础模型 3/128 → 最终 0/128','base 3/128 → final 0/128')}</small></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="score-comparison__note"><strong>{t('读表边界：','Reading boundary: ')}</strong>{t('论文 89.7 / 78.1 与 OpenEVO self 25.66 / 3.1%、MiniMax 16.94 / 0.0% 放在同一张表里是为了让读者看懂数字来自哪里，不代表它们已经是同一批 128 题、同一模型保存点（checkpoint）或可以直接相减的方法效果。MiniMax 的 0.0% 明确表示这次 128 个有效评测任务里完整成功 0 个，不是“结果缺失”。星号（*）沿用论文含义：使用技能验证（with skills validation）。','Paper 89.7 / 78.1 and OpenEVO self 25.66 / 3.1% plus MiniMax 16.94 / 0.0% are shown together so readers can see where each number comes from; this does not mean they already share the same exact 128 tasks/checkpoint or can be directly subtracted as a method effect. The asterisk (*) keeps the paper definition: validation with skills.')} <a href="https://arxiv.org/html/2607.14777v1" target="_blank" rel="noreferrer">SEED Table 1 ↗</a></p>
        </div>
        <dl class="fact-line">
          <div><dt>{t('最终平均任务得分（Task Score ×100）','Final mean Task Score ×100')}</dt><dd>13.33 → <strong>25.66</strong></dd></div>
          <div><dt>{t('完整成功','Exact success')}</dt><dd>3/128 → <strong>4/128</strong></dd></div>
          <div><dt>Stage 1</dt><dd><strong>8</strong> {t('次参数更新','parameter updates')}</dd></div>
          <div><dt>Stage 2</dt><dd><strong>0</strong> {t('次参数更新','parameter updates')}</dd></div>
          <div><dt>{t('Stage-2 合格成功轨迹','Stage-2 qualifying exact-success trajectories')}</dt><dd><strong>797</strong> / 20,480</dd></div>
          <div><dt>{t('单个 256 次数据块的达标任务身份','Qualifying task identities per 256-attempt block')}</dt><dd>{t('实际最高','observed maximum')} <strong>7</strong>；{t('允许参数更新的门槛','update threshold')} <strong>8</strong></dd></div>
        </dl>
      </section>
      <figure class="reasoning-line">
        <figcaption>{t('目前最重要的因果链','The most important causal chain to test')}</figcaption>
        <ol><li><span>01</span>{t('Stage 1 找到少量成功经验','Stage 1 finds a small success set')}</li><li><span>02</span>{t('8 次 SD-LoRA 更新，loss 0.479 → 0.055','8 SD-LoRA updates, loss 0.479 → 0.055')}</li><li><span>03</span>{t('Stage 2 收集到 797 条合格成功轨迹','Stage 2 collects 797 qualifying exact-success trajectories')}</li><li><span>04</span>{t('最好的一块也只有 7 个不同任务能各自重复完整成功','Even the best block has only 7 distinct tasks with repeated exact success')}</li><li><span>05</span>{t('历史 method-control 要求单块达到 8；最好的一块是 7，因此当时程序的 80 个数据块都没有触发更新','The historical method-control requires 8 per block; the best block has 7, so that program triggers no update across 80 blocks')}</li><li><span>06</span>{t('最终 25.66 实际上是 Stage-1 后模型的成绩','Final 25.66 is effectively the post-Stage-1 model')}</li></ol>
      </figure>
    </>
  ) : (
    <>
      <section class="snapshot" aria-labelledby="factor-title">
        <div class="section-kicker">{t('服务器快照 · 2026-08-29 20:06 UTC+8', 'SERVER SNAPSHOT · 2026-08-29 20:06 UTC+8')}</div>
        <h2 id="factor-title">{t('四组是真实可比的研究地图，但不是“只更换老师身份”的纯因果 2×2','A useful four-arm comparison map, not a pure teacher-only causal 2×2')}</h2>
        <p>{t('H1.46 复用 H1.45 self 组完全相同的 1,440 条学生任务轨迹。MiniMax 从未替学生在 WebShop 里行动，只在一次完整任务结束后回看轨迹并生成监督。真正改变的是“外部分析老师 + 启动阶段的样本选择与监督”这一整套实验处理。历史上让 Kimi 逐步替学生行动的尝试属于工程无效路径，不计入这里的科学结果。','H1.46 reuses the same 1,440 frozen student trajectories from the H1.45 self arms. MiniMax never acts in WebShop; it generates hindsight supervision only after an episode completes. The changed object is the external-analyzer plus bootstrap-selection/supervision treatment bundle. Historical step-level Kimi actor attempts are engineering-invalid and excluded from this table.')}</p>
        <div class="matrix-wrap"><table class="factor-matrix"><thead><tr><th></th><th>{t('OpenEvo 原生 self 启动训练','OpenEvo 原生 self 启动训练')}</th><th>{t('MiniMax 任务后回看分析 + OpenEvo 启动训练','MiniMax 任务后回看分析 + OpenEvo 启动训练')}</th></tr></thead><tbody><tr><th>Qwen2.5-3B</th><td><strong>3B / self</strong><small>{t('Stage 1：0 次参数更新（未达到启动门槛）；Stage 2：已完成 65/80 个数据块，0 次参数更新；最终评测尚未完成','Stage 1: 0 parameter updates (bootstrap threshold not reached); Stage 2: 65/80 blocks complete, 0 parameter updates; final evaluation not yet complete')}</small></td><td><strong>3B + MiniMax</strong><small>{t('启动阶段：8 次参数更新；Stage 2：已完成 31/80 个数据块，0 次参数更新；最终评测尚未完成','Bootstrap: 8 parameter updates; Stage 2: 31/80 blocks complete, 0 parameter updates; final evaluation not yet complete')}</small></td></tr><tr><th>Qwen2.5-7B</th><td><strong>7B / self</strong><small>{t('Stage 1：8 次参数更新；Stage 2：80 个数据块全部完成，0 次参数更新；最终 Task Score ×100 = 25.66','Stage 1: 8 parameter updates; Stage 2: all 80 blocks complete, 0 parameter updates; final Task Score ×100 = 25.66')}</small></td><td><strong>7B + MiniMax</strong><small>{t('启动阶段：8 次参数更新；Stage 2：已完成 56/80 个数据块，0 次参数更新；最终评测尚未完成','Bootstrap: 8 parameter updates; Stage 2: 56/80 blocks complete, 0 parameter updates; final evaluation not yet complete')}</small></td></tr></tbody></table></div>
      </section>
      <figure class="reasoning-line">
        <figcaption>{t('四组联合分析真正要顺着这条链追问','The joint analysis follows this evidence chain')}</figcaption>
        <ol><li><span>01</span>{t('共享同一批冻结的学生任务轨迹：先控制“学生做过什么题”','Shared frozen student trajectories control what the student actually attempted')}</li><li><span>02</span>{t('启动训练的监督来源不同：self 使用自身完整成功轨迹；MiniMax 组使用任务后回看监督','Bootstrap treatments differ: self clean-success vs MiniMax hindsight supervision')}</li><li><span>03</span>{t('观察是否真正触发参数更新，以及每个训练保存点学到了什么','Measure whether updates are unlocked and what checkpoints learn')}</li><li><span>04</span>{t('回到统一的本地学生自探索 Stage 2，比较成功任务覆盖率和参数更新门槛命中情况','Return to local student self-exploration in Stage 2 and compare successful-task coverage and update-threshold hits')}</li><li><span>05</span>{t('最后在统一的 128 个任务上比较部分任务得分与完整成功','Only then compare partial task score and exact success on one 128-task panel')}</li><li><span>06</span>{t('把差异称为“整套实验处理的效果”；若要单独判断分析老师身份的作用，还需要一个流程完全相同、只把老师换成 self 的对照组','Call differences treatment-bundle effects; a matched self-analyzer control is needed to isolate analyzer identity')}</li></ol>
      </figure>
      <section class="per-arm-section" aria-labelledby="per-arm-title">
        <div class="section-kicker">{t('每个实验内部', 'WITHIN EACH ARM')}</div>
        <h2 id="per-arm-title">{t('四组各自先回答什么？','What should each arm answer first?')}</h2>
        <div class="per-arm-grid">{armPlans.map((arm) => <article><header><h3>{arm.arm}</h3><span>{arm.state}</span></header><p><strong>{arm.q}</strong></p><p>{arm.evidence}</p><p class="arm-work">{arm.work}</p><footer><span>GPU · {arm.gpu}</span><span>{t('分析时间','Analysis time')} · {arm.time}</span></footer></article>)}</div>
      </section>
    </>
  )}

  <section class="plan-section" aria-labelledby="plan-title">
    <div class="section-kicker">{t('分析顺序', 'ANALYSIS ORDER')}</div>
    <h2 id="plan-title">{isSeven ? t('先用现成数据排除解释，再决定是否占 GPU','Use existing evidence to narrow explanations before taking GPUs') : t('等各组可比的最终评测完成前，先做不会污染结果的过程分析','Do non-contaminating process analysis before comparable finals close')}</h2>
    <div class="plan-table-wrap">
      <table class="plan-table">
        <thead><tr><th>{t('优先级','ID')}</th><th>{t('要回答的问题','Question')}</th>{!isSeven && <th>{t('关键对照','Contrast')}</th>}<th>{t('怎么做','Method')}</th><th>GPU</th><th>{t('预计时间','Time')}</th></tr></thead>
        <tbody>{rows.map((row:any)=><tr><td><strong>{row.id}</strong></td><td><b>{row.q}</b>{isSeven && <span>{row.evidence}</span>}</td>{!isSeven && <td><code>{row.contrast}</code></td>}<td>{row.method}{isSeven && <span class="output">→ {row.out}</span>}</td><td>{row.gpu}</td><td>{row.time}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="decision-section" aria-labelledby="decision-title">
    <div class="section-kicker">{t('停止规则', 'STOPPING RULE')}</div>
    <h2 id="decision-title">{isSeven ? t('什么证据会让我们选择不同的下一步？','What evidence would change the next experiment?') : t('什么情况下四组比较才可以下结论？','When is the four-arm comparison ready for claims?')}</h2>
    {isSeven ? <dl class="decision-list">
      <div><dt>{t('训练保存点的评测曲线已经完整','Checkpoint curve is now closed')}</dt><dd>{t('最后一个训练保存点得分最高，但中间两次参数更新后出现明显回落；这支持“后期训练仍可能有收益”，不支持“每多更新一次参数就一定更好”。','The final checkpoint is best, but the curve has two clear regressions; this supports possible benefit from later training, not the claim that every additional update helps.')}</dd></div>
      <div><dt>{t('训练 loss 继续下降，但固定任务评测分数已经不再同步上升','Loss falls while held-out score plateaus')}</dt><dd>{t('说明优化目标和真正任务能力脱节；继续把 loss 压低不是首选。','Suggests objective/task-capability mismatch; lower loss is not the first priority.')}</dd></div>
      <div><dt>{t('成功轨迹不少，但每个数据块的“不同重复成功任务数”始终低于 8','Many successful trajectories, but every block stays below eight distinct repeatedly successful tasks')}</dt><dd>{t('先预先登记新的累计—更新—清空合同，再检验它是否改变在线学习结果；不能只凭 0 次更新说模型太弱，也不能事后从更大窗口里挑一个看起来最好的方案。','Preregister a new accumulate-update-reset contract before testing online learning. Do not infer model weakness from zero updates, and do not post-hoc select whichever larger window looks best.')}</dd></div>
      <div><dt>{t('动作格式错误减少，但完整成功几乎不变','Formatting improves while exact success stays flat')}</dt><dd>{t('应先把收益解释成动作可执行性改善；下一步再重点检查搜索和推理能力，而不是继续把主要问题归因给动作解析器。','Interpret the gain as execution-validity improvement; target search/reasoning rather than the parser.')}</dd></div>
    </dl> : <dl class="decision-list">
      <div><dt>{t('先等对应实验组的最终评测完成并封存','Wait until every arm has a final seal')}</dt><dd>{t('尚未完成的实验组不能把缺失结果填成 0，也不能用只跑了一部分的 Stage 2 任务尝试来排最终名次；过程数据只能用于解释机制和规划后续分析。','Do not fill incomplete arms with zero or rank partial Stage-2 rollouts as final outcomes; process data are for mechanism analysis and planning only.')}</dd></div>
      <div><dt>{t('Stage 2 已完成的数据块仍全部没有触发参数更新','No completed Stage-2 block has yet triggered a parameter update')}</dt><dd>{t('如果四组最终都保持 0 次 Stage-2 参数更新，应写成“在这套共同的历史 method-control 下，各组数据都未被放行”。不能把它写成模型没有可学习数据，也不能说比较了经过合理 Stage-2 参数训练后的强弱，因为实际没有发生 Stage-2 参数训练。','If all four arms finish with zero Stage-2 updates, report that none was admitted under the shared historical method-control. Do not call this absence of learnable data or compare capability after well-designed Stage-2 training, because no Stage-2 parameter training occurred.')}</dd></div>
      <div><dt>{t('MiniMax 整套实验处理在 3B 和 7B 上是否呈现同方向变化','MiniMax bundle has the same direction at both scales')}</dt><dd>{t('如果两种模型规模都呈现同方向变化，可以说这一轮“整套实验处理”的对照支持共同趋势；仍不能写成纯 MiniMax 因果效应，也不能替代使用不同训练随机种子的独立重复实验。','This run can support a common treatment-bundle direction, but not a pure MiniMax causal effect and not training-seed robustness.')}</dd></div>
      <div><dt>{t('MiniMax 整套实验处理的收益幅度在 3B 与 7B 上差很多','Large scale × treatment interaction')}</dt><dd>{t('下一步应设计流程严格匹配的 self 分析老师对照，或更严格的启动训练消融实验，分别隔离“分析内容”“样本选择规则”和“模型规模”的影响。','The next experiment should add a matched self-analyzer control or stricter bootstrap-matched ablation to separate analyzer content, selection rule, and model scale.')}</dd></div>
      <div><dt>{t('最终分数差异主要伴随技术有效性与动作修复变化','Final differences track validity/repair')}</dt><dd>{t('先报告动作执行链的改善，再谨慎讨论搜索和推理能力；不要把格式改善直接写成完整任务能力。','Report execution-chain improvement first and be cautious about search/reasoning claims; formatting gains are not the same as full task capability.')}</dd></div>
    </dl>}
  </section>

  <details class="provenance"><summary>{t('证据边界与时间估算依据','Evidence boundaries and timing basis')}</summary><div>
    {isSeven ? <p>{t('训练保存点补测已于 2026-08-29 完成：7 个中间保存点，加上已有的初始基础模型与最终保存点，共 9 个点都在同一套 128 任务上评测；实际运行时间 4,813.6 秒（约 80.2 分钟）。该补测属于事后诊断（post-hoc diagnostic）。因为正式 128 任务已经被用来观察中间保存点，它今后不再是完全“未看过”的模型选择数据；正式后续实验应使用独立诊断任务，或在看结果前先固定选择规则。','The checkpoint sweep completed on 2026-08-29: seven intermediate points plus existing base/final give nine endpoints on the same panel, with observed wall time 4,813.6 seconds (~80.2 minutes). This run is a post-hoc diagnostic. Because the formal 128-task panel has now been used to inspect intermediate checkpoints, it is no longer fully unseen for model selection; later formal experiments should use a separate diagnostic panel or freeze selection rules before looking at results.')}</p>
      : <p>{t('H1.46 的结论边界已经明确：H1.45 的 self 组是 OpenEvo 原生对照，并不是“除了分析老师身份以外其它流程都完全匹配”的对照。因此在缺少这种严格匹配的 self 分析老师组时，不能声称观察到的是纯粹的分析老师身份因果效应。如果四组最终评测共享同一套 128 任务，可以用逐题配对的重采样方法描述这一轮实验在任务层面的不确定性；但这仍不能替代使用不同训练随机种子的独立重复实验。SEED 论文报告的数字只作为外部参照。','H1.46 explicitly states that the H1.45 self arms are OpenEvo-native controls, not analyzer-matched self-teacher controls; without a matched self-analyzer arm, no pure analyzer-identity causal claim is allowed. If the four finals share one 128-task panel, paired-task bootstrap can describe task-level uncertainty within this run, but it still does not replace independent training seeds. SEED paper-reported numbers remain external context only.')}</p>}
  </div></details>

  <nav class="plan-footer" aria-label={t('分析方案导航','Analysis plan navigation')}>
    <a href={p('/research/seed-openevo/study/results/')}>{t('实验结果','Results')}</a>
    <a aria-current={isSeven ? 'page' : undefined} href={p('/research/seed-openevo/study/results/7b-self-analysis/')}>7B / self</a>
    <a aria-current={!isSeven ? 'page' : undefined} href={p('/research/seed-openevo/study/results/four-arm-analysis/')}>{t('四组联合','Four-arm')}</a>
  </nav>
</article>

