.matrix-wrap,.plan-table-wrap{max-width:100%;overflow-x:auto}.factor-matrix,.plan-table{width:100%;border-collapse:collapse;text-align:left}.factor-matrix th,.factor-matrix td,.plan-table th,.plan-table td{padding:.85rem .8rem;border-bottom:1px solid var(--color-border);vertical-align:top}.factor-matrix thead th,.plan-table thead th{color:var(--color-text-muted);font-size:.7rem;letter-spacing:.04em}.factor-matrix td{min-width:220px}.factor-matrix small{display:block;margin-top:.3rem;color:var(--color-text-muted);font-size:.68rem}.plan-table{min-width:880px}.plan-table tbody td{font-size:.76rem;line-height:1.5}.plan-table tbody td:first-child{width:56px;color:var(--color-accent)}.plan-table tbody td:nth-child(2){min-width:240px}.plan-table td b,.plan-table td span{display:block}.plan-table td span{margin-top:.35rem;color:var(--color-text-muted)}.plan-table td .output{color:var(--color-text);font-weight:650}.plan-table code{white-space:normal;color:var(--color-text);font-size:.72rem}
