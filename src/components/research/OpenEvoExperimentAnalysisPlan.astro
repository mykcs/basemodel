---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';

type Mode = '7b-self' | 'four-arm';
interface Props { locale: Locale; mode: Mode }
const { locale, mode } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const sevenBRows = [
  { id:'A1', q:t('先确认我们到底训练了什么','First establish what actually trained'), evidence:t('Stage 1：1,440 rollout、41 qualified positives、8 个 identity；8 次 SD-LoRA increment。Stage 2：20,480 rollout，但 80/80 block 都是 no-update。','Stage 1: 1,440 rollouts, 41 qualified positives, 8 identities, and 8 SD-LoRA increments. Stage 2: 20,480 rollouts, but all 80/80 blocks were no-update.'), method:t('冻结 execution-state、selection、adapter SHA 和 final-eval provenance；把 Stage 1 与 Stage 2 的参数更新数分开。','Freeze execution-state, selection, adapter SHA, and final-eval provenance; separate Stage-1 and Stage-2 parameter updates.'), gpu:t('不需要','No'), time:t('10–20 分钟','10–20 min'), out:t('一张“真实训练链”证据表','A ground-truth training-chain table') },
  { id:'A2', q:t('Stage 2 为什么没有继续学习？','Why did Stage 2 stop learning?'), evidence:t('Stage 2 有 797 条 qualified-positive trajectory；单 block qualifying identity 平均 1.91、中位数 2、最大 7，而 gate 需要 8。','Stage 2 still produced 797 qualified-positive trajectories; qualifying identities per block averaged 1.91, median 2, maximum 7, while the gate requires 8.'), method:t('按 80 个 block 画 clean-positive、identity、valid、repair、invalid-action 曲线；检查早中晚是否枯竭。','Plot clean positives, identities, valid rows, repairs, and invalid actions across all 80 blocks; test whether the process decays over time.'), gpu:t('不需要','No'), time:t('20–40 分钟','20–40 min'), out:t('gate / coverage 诊断图与结论','Gate / coverage diagnostic figures') },
  { id:'A3', q:t('是不是 256-rollout 分块本身把可学习数据切碎了？','Did the 256-rollout window fragment usable experience?'), evidence:t('事后把相邻 block 合并：1-block 窗口 0/80 达 gate；2-block 4/40；4-block 12/20；8-block 10/10。','Post-hoc pooling gives 0/80 qualifying one-block windows, 4/40 two-block windows, 12/20 four-block windows, and 10/10 eight-block windows.'), method:t('只做 admission counterfactual，不改原实验：比较 256/512/1024/2048 rollout 的 gate 命中率和时间分布。','Run an admission-only counterfactual without rewriting the original experiment: compare gate hit rates for 256/512/1024/2048-rollout windows.'), gpu:t('不需要','No'), time:t('15–30 分钟','15–30 min'), out:t('“模型没数据”与“gate 没放行”的区分','Separation of data scarcity from gate admission') },
  { id:'A4', q:t('loss 下降是否真的对应 WebShop 能力上升？','Did lower loss actually track WebShop capability?'), evidence:t('8 个 Stage-1 checkpoint 全部完整；training loss 0.479 → 0.055，但现有正式评测只有 base 与最终 checkpoint。','All eight Stage-1 checkpoints are intact; training loss fell from 0.479 to 0.055, but formal evaluation exists only for base and the final checkpoint.'), method:t('先整理 8 点 loss / rank / component 曲线；再把 7 个中间 checkpoint 分别跑同一诊断 panel，建立 loss→held-out score 曲线。','First extract the eight-point loss/rank/component curve; then evaluate the seven intermediate checkpoints on one diagnostic panel to build a loss→held-out-score curve.'), gpu:t('第二步需要 2 张卡','2 GPUs for step two'), time:t('CPU 10–15 分钟；完整 128-task checkpoint sweep 约 1.5–2 小时','CPU 10–15 min; full 128-task checkpoint sweep about 1.5–2 h'), out:t('是否“继续拟合”仍能换来真实能力','Whether additional fitting still buys real capability') },
  { id:'A5', q:t('25.66 的提升到底来自“更会做题”还是“更会说合法动作”？','Did the 25.66 gain come from solving tasks or producing more executable actions?'), evidence:t('128-task final：base 13.33 → self 25.66；valid 109→122，parser/action failure 19→6，parser repair 80→47；exact success 3→4。','On the 128-task final panel: base 13.33 → self 25.66; valid 109→122, parser/action failures 19→6, repairs 80→47, while exact success rose only 3→4.'), method:t('做逐题 paired decomposition：invalid→valid、partial reward 提升、exact fail→success、退步；再抽取失败轨迹分类。','Run per-task paired decomposition: invalid→valid, partial-reward gains, exact fail→success, regressions, then classify failure trajectories.'), gpu:t('不需要','No'), time:t('30–60 分钟','30–60 min'), out:t('格式能力、搜索/推理能力、最终购买成功三层贡献','Contribution from format, search/reasoning, and final purchase success') },
  { id:'A6', q:t('“继续训练更多步”值得吗？','Is more training worth it?'), evidence:t('现状不是“Stage 2 loss 还没降完”，而是 Stage 2 optimizer update=0。','The current state is not “Stage-2 loss has not converged”; Stage-2 optimizer updates equal zero.'), method:t('先综合 A2–A5。只有当 checkpoint curve 仍上升且 gate 数据足够时，再设计 continuation；否则优先测试 gate/coverage 机制。','Synthesize A2–A5 first. Continue training only if the checkpoint curve still rises and usable data exist; otherwise prioritize the gate/coverage mechanism.'), gpu:t('决策本身不需要','No for the decision'), time:t('20–30 分钟综合','20–30 min synthesis'), out:t('继续训练 / 改 gate / 改探索三选一','Choose among more training, gate changes, or exploration changes') },
  { id:'A7', q:t('gate 真的是造成停滞的因果因素吗？','Is the gate causally responsible for the stall?'), evidence:t('现有 20,480 rollout 可以证明 admission bottleneck，但不能证明“改 gate 后线上 policy 会怎样”，因为一旦早期更新，后面的 trajectory 分布也会改变。','Existing 20,480 rollouts establish an admission bottleneck, but cannot prove online behavior after a gate change because an early update would change later trajectory distributions.'), method:t('最后才做新实验：从同一个 Stage-1 checkpoint 起跑，只改 preregistered admission/accumulation rule，其余 schedule、sampling、evaluation 全部冻结。','Only as the final step, run a new experiment from the same Stage-1 checkpoint, changing only the preregistered admission/accumulation rule while freezing schedule, sampling, and evaluation.'), gpu:t('需要 2 张卡','2 GPUs'), time:t('完整在线复现约 28–30 小时；先做较小诊断版本可压到约 6 小时','Full online replication about 28–30 h; a smaller diagnostic version can be about 6 h'), out:t('真正的 gate 因果检验','A causal gate intervention test') },
];

const armPlans = [
  { arm:'3B / self', state:t('Stage-1 0 update · Stage-2 65/80 · Stage-2 update 0 · final 待完成','Stage-1 0 updates · Stage-2 65/80 · Stage-2 updates 0 · final pending'), q:t('3B 为什么几乎无法形成可重复的 clean-success identity？','Why does 3B rarely form repeatable clean-success identities?'), evidence:t('Stage 1 只有 4 条 qualified positive、1 个 qualifying identity，因此没有 bootstrap adapter；当前 Stage 2 已写 16,640 rollout，也仍未触发更新。','Stage 1 produced only 4 qualified positives and 1 qualifying identity, so no bootstrap adapter was created; 16,640 Stage-2 rollouts are currently written and still have not triggered an update.'), work:t('做成功轨迹/格式失败/任务类型分解，重点判断是 base capability starvation，还是同一个 8-identity gate 对 3B 过严。','Decompose successful trajectories, formatting failures, and task types; test base-capability starvation versus an 8-identity gate that may be too strict for 3B.'), gpu:t('不需要','No'), time:t('45–75 分钟','45–75 min') },
  { arm:'7B / self', state:t('Stage-1 8 updates · Stage-2 80/80 · Stage-2 update 0 · final 25.66','Stage-1 8 updates · Stage-2 80/80 · Stage-2 updates 0 · final 25.66'), q:t('25.66 是 bootstrap 学到的什么，以及为什么 Stage 2 完全没有继续更新？','What did the bootstrap learn to reach 25.66, and why did Stage 2 never update?'), evidence:t('8 个完整 Stage-1 checkpoint；loss 0.479→0.055；Stage 2 20,480 rollout 有 797 条 clean positive，但单 block identity 最大 7 < gate 8。','Eight complete Stage-1 checkpoints; loss 0.479→0.055; Stage 2 produced 797 clean positives across 20,480 rollouts, yet the maximum identities in one block was 7 < gate 8.'), work:t('按本页 A1–A7 完整分析；CPU 先做 gate、逐题与 failure taxonomy，再决定是否做 checkpoint sweep。','Use the full A1–A7 plan on this page: CPU-first gate, per-task, and failure analyses, then decide whether to run a checkpoint sweep.'), gpu:t('大部分不需要；checkpoint sweep 需 2×5090','Mostly no; checkpoint sweep needs 2×5090'), time:t('CPU 约 2–3 小时；可选 GPU 1.5–2 小时','CPU about 2–3 h; optional GPU 1.5–2 h') },
  { arm:'3B + MiniMax', state:t('MiniMax bootstrap 8 updates · Stage-2 31/80 · Stage-2 update 0 · final 待完成','MiniMax bootstrap 8 updates · Stage-2 31/80 · Stage-2 updates 0 · final pending'), q:t('外部 hindsight supervision 能不能把“完全没有 bootstrap”的 3B 拉进可学习状态？','Can external hindsight supervision move 3B from no bootstrap into a learnable state?'), evidence:t('它复用 3B/self 的同一批 1,440 条冻结 student trajectory；MiniMax 只在 episode 后分析。正式 SD-LoRA bootstrap 8/8 完成，loss 2.798→1.827；当前 Stage 2 仍 0 update。','It reuses exactly the same 1,440 frozen student trajectories as 3B/self; MiniMax analyzes only after each episode. Formal SD-LoRA bootstrap completed 8/8 increments, loss 2.798→1.827; Stage 2 still has 0 updates so far.'), work:t('先分析 bootstrap 是否改善 action validity / partial reward / Stage-2 clean-success coverage；不要把差异直接叫“MiniMax 因果效应”。','First test whether the bootstrap improves action validity, partial reward, or Stage-2 clean-success coverage; do not label the difference a pure MiniMax causal effect.'), gpu:t('现有过程分析不需要；checkpoint capability curve 可选','No for process analysis; optional for checkpoint capability curve'), time:t('CPU 45–90 分钟；可选 GPU 约 1–2 小时','CPU 45–90 min; optional GPU about 1–2 h') },
  { arm:'7B + MiniMax', state:t('MiniMax bootstrap 8 updates · Stage-2 56/80 · Stage-2 update 0 · final 待完成','MiniMax bootstrap 8 updates · Stage-2 56/80 · Stage-2 updates 0 · final pending'), q:t('7B 本来就能 bootstrap 时，外部 hindsight supervision 还改变了什么？','When 7B can already bootstrap itself, what does external hindsight supervision change?'), evidence:t('正式 bootstrap 8/8 完成，loss 2.737→1.634；当前 14,336 条 Stage-2 rollout 中仍无参数更新。','Formal bootstrap completed 8/8 increments, loss 2.737→1.634; 14,336 Stage-2 rollouts are currently written with no parameter update so far.'), work:t('最终与 7B/self 做同任务 paired 对照，并在同样 Stage-2 block 前缀比较 clean-positive / identity / parser 状态，追踪 bootstrap 对后续自探索的影响。','Pair final tasks against 7B/self and compare clean positives, identities, and parser states over matched Stage-2 block prefixes to trace how bootstrap changes later self-exploration.'), gpu:t('过程分析不需要；checkpoint capability curve 可选 2×5090','No for process analysis; optional checkpoint capability curve on 2×5090'), time:t('CPU 45–90 分钟；可选 GPU 1.5–2 小时','CPU 45–90 min; optional GPU 1.5–2 h') },
];

const fourRows = [
  { id:'B1', q:t('外部 analyzer + bootstrap 这套 treatment bundle 有没有帮助？','Does the external-analyzer + bootstrap treatment bundle help?'), contrast:'3B: MiniMax bundle − self; 7B: MiniMax bundle − self', method:t('等各自 final 完成后，在相同 128-task panel 上做 paired task contrast；同时比较 Stage-1/Stage-2 参数更新、validity、partial reward 和 exact success。这里的 treatment 不只是“换一个 teacher”。','After each final completes, use paired task contrasts on the same 128-task panel and compare parameter updates, validity, partial reward, and exact success. The treatment changes more than teacher identity alone.'), gpu:t('final 已存在后不需要','No once finals exist'), time:t('45–75 分钟','45–75 min') },
  { id:'B2', q:t('MiniMax bootstrap 是否改变后续 self-exploration 的覆盖率？','Does the MiniMax bootstrap change downstream self-exploration coverage?'), contrast:t('同模型、同 Stage-2 block 前缀：q-positive / identity / distance-to-gate','Same model and matched Stage-2 block prefixes: q-positive / identities / distance-to-gate'), method:t('只比较相同 schedule positions，不能拿 31 个 block 的 3B+MiniMax 去除以 65 个 block 的 3B/self 后直接下结论。画 matched-prefix coverage curve。','Compare identical schedule positions only; do not directly contrast 31 MiniMax blocks against 65 self blocks. Build matched-prefix coverage curves.'), gpu:t('不需要','No'), time:t('45–90 分钟','45–90 min') },
  { id:'B3', q:t('Stage-2 gate 是不是四组共同瓶颈？','Is the Stage-2 gate a shared bottleneck across all four arms?'), contrast:t('每 256 rollout 的 qualifying identity 数与 gate=8 的距离','Qualifying identities per 256 rollouts versus gate=8'), method:t('四组统一统计 gate hit、near-miss、窗口累积反事实和早/中/晚趋势。当前快照中所有已闭合 block 都是 no-update，因此这是优先级很高的共同机制问题。','Use one analysis for gate hits, near misses, pooling counterfactuals, and early/middle/late trends across all arms. Every closed block in the current snapshot is no-update, making this a high-priority shared mechanism question.'), gpu:t('不需要','No'), time:t('45–75 分钟','45–75 min') },
  { id:'B4', q:t('模型规模改变的是“能不能 bootstrap”，还是 bootstrap 后的任务能力？','Does scale change bootstrap feasibility or post-bootstrap capability?'), contrast:t('self: 7B vs 3B；MiniMax bundle: 7B vs 3B','self: 7B vs 3B; MiniMax bundle: 7B vs 3B'), method:t('把 bootstrap admission、checkpoint loss、Stage-2 coverage 和 final task score 分层，不把“7B 分高”简化成一个数字。','Separate bootstrap admission, checkpoint loss, Stage-2 coverage, and final task score instead of reducing scale to one score.'), gpu:t('不需要','No'), time:t('30–60 分钟','30–60 min') },
  { id:'B5', q:t('MiniMax treatment 的收益是否随模型大小改变？','Does the MiniMax treatment-bundle contrast depend on model size?'), contrast:'(7B MiniMax − 7B self) − (3B MiniMax − 3B self)', method:t('final 全部完成后可以做描述性的 difference-in-differences / interaction；但因为 self 与 MiniMax 的 bootstrap selection/supervision 不完全同构，只能称 treatment-bundle interaction，不能称纯 teacher causal interaction。','After all finals complete, compute a descriptive difference-in-differences / interaction. Because self and MiniMax use non-identical bootstrap selection and supervision, call it a treatment-bundle interaction, not a pure teacher causal interaction.'), gpu:t('不需要','No'), time:t('30–60 分钟','30–60 min') },
  { id:'B6', q:t('最终分数差异究竟来自格式、部分进展还是完整成功？','Do final differences come from formatting, partial progress, or exact completion?'), contrast:t('valid / repair / invalid-action → partial reward → exact success','valid / repair / invalid-action → partial reward → exact success'), method:t('四组统一 failure taxonomy，并做逐任务 paired transition matrix；这能防止把“动作更合法”误写成“推理能力大幅提升”。','Apply one failure taxonomy and per-task paired transition matrix across all arms so better action validity is not mislabeled as a large reasoning gain.'), gpu:t('不需要','No'), time:t('1–2 小时','1–2 h') },
  { id:'B7', q:t('怎样和 SEED 论文结果放在一起讲？','How should these results be discussed beside SEED?'), contrast:t('本地四组 treatment comparison ≠ 论文 checkpoint 直接减法','Local four-arm treatment comparison ≠ direct subtraction from the paper checkpoint'), method:t('SEED paper-reported 数字只作为外部参照。正式“OpenEvo vs SEED”仍需对齐任务语义、训练/teacher预算、checkpoint 与 evaluator；这四组首先回答 bootstrap/自进化机制问题。','Use SEED paper-reported numbers as external context only. A formal OpenEvo-vs-SEED claim still requires aligned task semantics, training/teacher budget, checkpoint, and evaluator; these four arms first answer bootstrap/self-evolution mechanism questions.'), gpu:t('不需要','No'), time:t('20–30 分钟','20–30 min') },
  { id:'B8', q:t('一次四组 run 能不能证明一般规律？','Can one four-arm run establish a general rule?'), contrast:t('task-level 不确定性 ≠ training-seed 不确定性','task-level uncertainty ≠ training-seed uncertainty'), method:t('128 个 paired task 可以给这一次 run 的 task-level bootstrap CI；若要声称 treatment / scale 效应稳健，再做独立 training seeds。','The 128 paired tasks can yield task-level bootstrap CIs for this run; robust treatment/scale claims require independent training seeds.'), gpu:t('首轮不需要；多 seed 才需要','No initially; GPUs for multi-seed'), time:t('首轮 20–30 分钟；多 seed 属于多日预算','20–30 min initially; multi-seed is a multi-day budget') },
];

const isSeven = mode === '7b-self';
const rows = isSeven ? sevenBRows : fourRows;
---
<article class="analysis-plan" data-testid={`experiment-analysis-plan-${mode}`}>
  <header class="analysis-hero">
    <p class="eyebrow">{isSeven ? t('实验后分析方案 · 7B / SELF', 'POST-EXPERIMENT ANALYSIS · 7B / SELF') : t('四组联合分析方案 · SELF / MINIMAX', 'FOUR-ARM ANALYSIS · SELF / MINIMAX')}</p>
    <h1>{isSeven ? t('7B 无外部教师实验：我们还能从这一次 run 里知道什么？','7B without an external teacher: what else can this run tell us?') : t('3B / 7B × self / MiniMax：四组实验怎样一起回答问题？','3B / 7B × self / MiniMax: what can the four arms tell us together?')}</h1>
    <p class="lede">{isSeven
      ? t('先不追加训练。现有服务器产物已经足够把“模型能力不足”“训练数据覆盖不足”“Stage-2 gate 没放行”“loss 与真实任务能力脱节”拆成不同问题；只有最后两个问题需要重新占用 GPU。','Do not add training yet. Existing server artifacts are enough to separate model capability, experience coverage, Stage-2 admission, and loss-to-capability mismatch; only the final two questions require new GPU evaluation or training.')
      : t('这四组可以画成 3B/7B × self/MiniMax 的 2×2 比较图，但不是一个干净的“teacher identity 因果实验”。MiniMax 只在完整 trajectory 之后做 hindsight analysis，并改变了 bootstrap supervision/selection bundle；Stage 2 又都回到本地 student self。我们因此比较 treatment bundle、模型规模和后续 self-exploration，而不是把所有差异都归给 MiniMax。','The four arms form a useful 3B/7B × self/MiniMax comparison map, but not a clean causal experiment on teacher identity. MiniMax acts only after a completed trajectory and changes the bootstrap supervision/selection bundle; Stage 2 returns to local student self. We therefore compare treatment bundles, scale, and downstream self-exploration rather than attributing every difference to MiniMax.')}</p>
    <div class="hero-actions"><a href={p('/research/seed-openevo/study/results/')}>{t('← 返回实验结果','← Back to results')}</a>{isSeven && <a href={p('/research/seed-openevo/study/results/four-arm-analysis/')}>{t('查看四组联合方案 →','Open four-arm plan →')}</a>}</div>
  </header>

  {isSeven ? (
    <>
      <section class="snapshot" aria-labelledby="snapshot-title">
        <div class="section-kicker">{t('服务器事实快照', 'SERVER FACT SNAPSHOT')}</div>
        <h2 id="snapshot-title">{t('先把“跑了很多 rollout”和“真的更新了参数”分开','Separate rollout volume from actual parameter updates')}</h2>
        <p>{t('北京时间 2026-08-29 19:35 对正式 7B/self 目录的只读审计显示：最终评测加载的 adapter 就是 Stage-1 increment-07；Stage 2 虽然完整跑完 20,480 条 rollout，但没有产生新的 adapter。','A read-only audit of the formal 7B/self directory at 2026-08-29 19:35 UTC+8 shows that final evaluation loaded the Stage-1 increment-07 adapter; Stage 2 completed all 20,480 rollouts but produced no new adapter.')}</p>
        <dl class="fact-line">
          <div><dt>{t('最终 Task Score ×100','Final Task Score ×100')}</dt><dd>13.33 → <strong>25.66</strong></dd></div>
          <div><dt>{t('完整成功','Exact success')}</dt><dd>3/128 → <strong>4/128</strong></dd></div>
          <div><dt>Stage 1</dt><dd><strong>8</strong> {t('次参数更新','parameter updates')}</dd></div>
          <div><dt>Stage 2</dt><dd><strong>0</strong> {t('次参数更新','parameter updates')}</dd></div>
          <div><dt>{t('Stage-2 clean positive','Stage-2 clean positives')}</dt><dd><strong>797</strong> / 20,480</dd></div>
          <div><dt>{t('每 block identity','Identities per block')}</dt><dd>{t('最大','max')} <strong>7</strong> / gate 8</dd></div>
        </dl>
      </section>
      <figure class="reasoning-line">
        <figcaption>{t('目前最重要的因果链','The most important causal chain to test')}</figcaption>
        <ol><li><span>01</span>{t('Stage 1 找到少量成功经验','Stage 1 finds a small success set')}</li><li><span>02</span>{t('8 次 SD-LoRA 更新，loss 0.479 → 0.055','8 SD-LoRA updates, loss 0.479 → 0.055')}</li><li><span>03</span>{t('Stage 2 仍产生 797 条 clean positive','Stage 2 still produces 797 clean positives')}</li><li><span>04</span>{t('每个 256-rollout block 最多只有 7 个可重复成功 identity','Each 256-rollout block reaches at most 7 repeat-success identities')}</li><li><span>05</span>{t('gate 需要 8，所以 80/80 block 都不更新','The gate needs 8, so all 80/80 blocks skip updates')}</li><li><span>06</span>{t('最终 25.66 实际上是 Stage-1 后模型的成绩','Final 25.66 is effectively the post-Stage-1 model')}</li></ol>
      </figure>
    </>
  ) : (
    <>
      <section class="snapshot" aria-labelledby="factor-title">
        <div class="section-kicker">{t('服务器快照 · 2026-08-29 20:06 UTC+8', 'SERVER SNAPSHOT · 2026-08-29 20:06 UTC+8')}</div>
        <h2 id="factor-title">{t('四组是真实可比的研究地图，但不是“只换 teacher”的纯因果 2×2','A useful four-arm comparison map, not a pure teacher-only causal 2×2')}</h2>
        <p>{t('H1.46 复用 H1.45 self arms 的同一批 1,440 条冻结 student trajectory；MiniMax 从未替学生在 WebShop 里行动，只在 episode 结束后生成 hindsight supervision。真正被改变的是“外部 analyzer + bootstrap selection/supervision”这一整套 treatment bundle。历史 Kimi step-level actor attempt 属工程无效路径，不进入这张表。','H1.46 reuses the same 1,440 frozen student trajectories from the H1.45 self arms. MiniMax never acts in WebShop; it generates hindsight supervision only after an episode completes. The changed object is the external-analyzer plus bootstrap-selection/supervision treatment bundle. Historical step-level Kimi actor attempts are engineering-invalid and excluded from this table.')}</p>
        <div class="matrix-wrap"><table class="factor-matrix"><thead><tr><th></th><th>{t('OpenEvo-native self bootstrap','OpenEvo-native self bootstrap')}</th><th>{t('MiniMax post-hoc analyzer + OpenEvo bootstrap','MiniMax post-hoc analyzer + OpenEvo bootstrap')}</th></tr></thead><tbody><tr><th>Qwen2.5-3B</th><td><strong>3B / self</strong><small>{t('Stage-1 0 update · Stage-2 65/80 · Stage-2 update 0 · final pending','Stage-1 0 updates · Stage-2 65/80 · Stage-2 updates 0 · final pending')}</small></td><td><strong>3B + MiniMax</strong><small>{t('bootstrap 8 updates · Stage-2 31/80 · Stage-2 update 0 · final pending','bootstrap 8 updates · Stage-2 31/80 · Stage-2 updates 0 · final pending')}</small></td></tr><tr><th>Qwen2.5-7B</th><td><strong>7B / self</strong><small>{t('Stage-1 8 updates · Stage-2 80/80 · Stage-2 update 0 · final 25.66','Stage-1 8 updates · Stage-2 80/80 · Stage-2 updates 0 · final 25.66')}</small></td><td><strong>7B + MiniMax</strong><small>{t('bootstrap 8 updates · Stage-2 56/80 · Stage-2 update 0 · final pending','bootstrap 8 updates · Stage-2 56/80 · Stage-2 updates 0 · final pending')}</small></td></tr></tbody></table></div>
      </section>
      <figure class="reasoning-line">
        <figcaption>{t('四组联合分析真正要顺着这条链追问','The joint analysis follows this evidence chain')}</figcaption>
        <ol><li><span>01</span>{t('共享冻结 student trajectory：先控制“学生做过什么题”','Shared frozen student trajectories control what the student actually attempted')}</li><li><span>02</span>{t('bootstrap treatment 不同：self clean-success vs MiniMax hindsight supervision','Bootstrap treatments differ: self clean-success vs MiniMax hindsight supervision')}</li><li><span>03</span>{t('观察参数更新是否被解锁，以及 checkpoint 学到了什么','Measure whether updates are unlocked and what checkpoints learn')}</li><li><span>04</span>{t('回到统一的 local self Stage 2，比较 exploration coverage / gate','Return to local self Stage 2 and compare exploration coverage / gate behavior')}</li><li><span>05</span>{t('最后才在统一 128-task panel 比 partial / exact success','Only then compare partial and exact success on one 128-task panel')}</li><li><span>06</span>{t('把差异称为 treatment-bundle effect；需要 matched self-analyzer 才能隔离纯 analyzer identity','Call differences treatment-bundle effects; a matched self-analyzer control is needed to isolate analyzer identity')}</li></ol>
      </figure>
      <section class="per-arm-section" aria-labelledby="per-arm-title">
        <div class="section-kicker">{t('每个实验内部', 'WITHIN EACH ARM')}</div>
        <h2 id="per-arm-title">{t('四组各自先回答什么？','What should each arm answer first?')}</h2>
        <div class="per-arm-grid">{armPlans.map((arm) => <article><header><h3>{arm.arm}</h3><span>{arm.state}</span></header><p><strong>{arm.q}</strong></p><p>{arm.evidence}</p><p class="arm-work">{arm.work}</p><footer><span>GPU · {arm.gpu}</span><span>{t('分析时间','Analysis time')} · {arm.time}</span></footer></article>)}</div>
      </section>
    </>
  )}

  <section class="plan-section" aria-labelledby="plan-title">
    <div class="section-kicker">{t('分析顺序', 'ANALYSIS ORDER')}</div>
    <h2 id="plan-title">{isSeven ? t('先用现成数据排除解释，再决定是否占 GPU','Use existing evidence to narrow explanations before taking GPUs') : t('等可比 final 闭合前，先做不会污染结果的过程分析','Do non-contaminating process analysis before comparable finals close')}</h2>
    <div class="plan-table-wrap">
      <table class="plan-table">
        <thead><tr><th>{t('优先级','ID')}</th><th>{t('要回答的问题','Question')}</th>{!isSeven && <th>{t('关键对照','Contrast')}</th>}<th>{t('怎么做','Method')}</th><th>GPU</th><th>{t('预计时间','Time')}</th></tr></thead>
        <tbody>{rows.map((row:any)=><tr><td><strong>{row.id}</strong></td><td><b>{row.q}</b>{isSeven && <span>{row.evidence}</span>}</td>{!isSeven && <td><code>{row.contrast}</code></td>}<td>{row.method}{isSeven && <span class="output">→ {row.out}</span>}</td><td>{row.gpu}</td><td>{row.time}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="decision-section" aria-labelledby="decision-title">
    <div class="section-kicker">{t('停止规则', 'STOPPING RULE')}</div>
    <h2 id="decision-title">{isSeven ? t('什么证据会让我们选择不同的下一步？','What evidence would change the next experiment?') : t('什么情况下四组比较才可以下结论？','When is the four-arm comparison ready for claims?')}</h2>
    {isSeven ? <dl class="decision-list">
      <div><dt>{t('checkpoint score 仍持续上升','Checkpoint score still rises')}</dt><dd>{t('才支持“当前训练预算可能不够”；优先 continuation。','Supports the hypothesis that current training budget is insufficient; prioritize continuation.')}</dd></div>
      <div><dt>{t('loss 继续下降，但 held-out score 已平台','Loss falls while held-out score plateaus')}</dt><dd>{t('说明优化目标和真正任务能力脱节；继续把 loss 压低不是首选。','Suggests objective/task-capability mismatch; lower loss is not the first priority.')}</dd></div>
      <div><dt>{t('success 数据很多，但 gate 一直不打开','Many successful trajectories but the gate stays closed')}</dt><dd>{t('优先做 admission/accumulation 因果实验，而不是把模型简单归因成“太弱”。','Prioritize an admission/accumulation causal test rather than simply blaming model weakness.')}</dd></div>
      <div><dt>{t('格式错误下降，但 exact success 不动','Formatting improves while exact success stays flat')}</dt><dd>{t('把收益解释成执行合法性改善；下一步针对 search/reasoning，而不是 parser。','Interpret the gain as execution-validity improvement; target search/reasoning rather than the parser.')}</dd></div>
    </dl> : <dl class="decision-list">
      <div><dt>{t('先等对应 arm 的 final seal','Wait until every arm has a final seal')}</dt><dd>{t('未完成 arm 不填 0、不用 partial Stage-2 rollout 排最终名次；过程数据只用于解释机制和规划分析。','Do not fill incomplete arms with zero or rank partial Stage-2 rollouts as final outcomes; process data are for mechanism analysis and planning only.')}</dd></div>
      <div><dt>{t('Stage-2 仍然全是 no-update','Stage 2 remains all no-update')}</dt><dd>{t('如果四组最终都没有 Stage-2 update，主结论应转向 bootstrap treatment + shared gate bottleneck；不能说“经过大量 Stage-2 训练后谁更强”，因为根本没有 Stage-2 参数训练。','If all four arms finish with zero Stage-2 updates, the main story becomes bootstrap treatment plus a shared gate bottleneck. Do not say one method is better after extensive Stage-2 training when no Stage-2 parameter training occurred.')}</dd></div>
      <div><dt>{t('MiniMax bundle 在两个模型规模同方向','MiniMax bundle has the same direction at both scales')}</dt><dd>{t('可以说本次 treatment-bundle 对照支持共同方向；仍不能写成纯 MiniMax causal effect，也不能替代 training-seed replication。','This run can support a common treatment-bundle direction, but not a pure MiniMax causal effect and not training-seed robustness.')}</dd></div>
      <div><dt>{t('模型规模 × treatment interaction 很大','Large scale × treatment interaction')}</dt><dd>{t('下一步应设计 matched self-analyzer control 或更严格的 bootstrap-matched ablation，去隔离“analyzer 内容”“selection rule”和“模型规模”。','The next experiment should add a matched self-analyzer control or stricter bootstrap-matched ablation to separate analyzer content, selection rule, and model scale.')}</dd></div>
      <div><dt>{t('final 差异能被 validity/repair 解释','Final differences track validity/repair')}</dt><dd>{t('先报告执行链改善，再谨慎讨论 search/reasoning；不要把格式改善直接写成完整任务能力。','Report execution-chain improvement first and be cautious about search/reasoning claims; formatting gains are not the same as full task capability.')}</dd></div>
    </dl>}
  </section>

  <details class="provenance"><summary>{t('证据边界与时间估算依据','Evidence boundaries and timing basis')}</summary><div>
    {isSeven ? <p>{t('时间预算不是承诺，而是按本轮 7B/self 的实跑 block 吞吐做的规划范围。checkpoint sweep 只需要补 7 个中间点，因为 base 和最终 checkpoint 已有正式 128-task 结果。若把正式 128 panel 的中间 checkpoint 结果用于后续模型选择，它就不再是完全“未看过”的最终测试；因此正式后续实验应重新冻结选择规则或使用独立 diagnostic panel。','Time estimates are planning ranges based on observed 7B/self block throughput. The checkpoint sweep needs only seven intermediate points because base and the final checkpoint already have formal 128-task results. If intermediate-checkpoint results on the formal panel are used for future model selection, that panel is no longer fully unseen; a later formal experiment should therefore freeze its selection rule independently or use a separate diagnostic panel.')}</p>
      : <p>{t('H1.46 自己的 claim boundary 已明确：H1.45 self arms 是 OpenEvo-native controls，不是 analyzer-matched self-teacher controls；没有 matched self-analyzer arm 时，不允许声称纯 analyzer identity causal effect。四组 final 若共享同一 128-task panel，可以做逐 task paired bootstrap 描述这一次 run 的 task-level 不确定性，但它仍不能替代独立 training seeds。SEED paper-reported 数字只作为外部参照。','H1.46 explicitly states that the H1.45 self arms are OpenEvo-native controls, not analyzer-matched self-teacher controls; without a matched self-analyzer arm, no pure analyzer-identity causal claim is allowed. If the four finals share one 128-task panel, paired-task bootstrap can describe task-level uncertainty within this run, but it still does not replace independent training seeds. SEED paper-reported numbers remain external context only.')}</p>}
  </div></details>

  <nav class="plan-footer" aria-label={t('分析方案导航','Analysis plan navigation')}>
    <a href={p('/research/seed-openevo/study/results/')}>{t('实验结果','Results')}</a>
    <a aria-current={isSeven ? 'page' : undefined} href={p('/research/seed-openevo/study/results/7b-self-analysis/')}>7B / self</a>
    <a aria-current={!isSeven ? 'page' : undefined} href={p('/research/seed-openevo/study/results/four-arm-analysis/')}>{t('四组联合','Four-arm')}</a>
  </nav>
</article>

