.snapshot,.per-arm-section,.plan-section,.decision-section{padding:2rem 0;border-top:1px solid var(--color-border)}.snapshot h2,.per-arm-section h2,.plan-section h2,.decision-section h2{max-width:860px;margin:.35rem 0 .7rem;font-size:clamp(1.45rem,3vw,2.35rem);letter-spacing:-.03em}.snapshot>p{max-width:78ch;margin:0 0 1rem;color:var(--color-text-muted);line-height:1.7}.fact-line{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:1.2rem 0 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.fact-line>div{padding:1rem .8rem}.fact-line>div+div{border-left:1px solid var(--color-border)}.fact-line dt{color:var(--color-text-muted);font-size:.72rem}.fact-line dd{margin:.3rem 0 0;font-size:.95rem}.fact-line strong{font-size:1.18rem}
.reasoning-line{margin:0 0 2rem;padding:1.2rem 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.reasoning-line figcaption{margin-bottom:.8rem;font-weight:800}.reasoning-line ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;margin:0;padding:0}.reasoning-line li{position:relative;padding:.9rem 1rem .9rem 2.5rem;min-height:86px;border-left:1px solid var(--color-border);font-size:.8rem;line-height:1.5}.reasoning-line li span{position:absolute;left:.7rem;top:.95rem;color:var(--color-accent);font:800 .68rem ui-monospace,SFMono-Regular,Menlo,monospace}
