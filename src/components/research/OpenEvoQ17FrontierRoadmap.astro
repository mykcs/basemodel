---
import { localePath, type Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const briefingHref = p('/research/seed-openevo/study/briefing/#frontier-roadmap');
const directApplyHref = p('/research/seed-openevo/study/briefing/#directapply-progress');
const gdrHref = p('/research/seed-openevo/study/capability-exploration/gdr-directapply/');
const evidenceHref = '/research/seed-openevo/evidence/q17-directapply-frontier-plan-20260910-2312-sgt.json';
const planPrHref = 'https://github.com/mykcs/openevo-experiment/pull/420';
const planFileHref = 'https://github.com/mykcs/openevo-experiment/blob/docs/q17-frontier-roadmap-20260910/docs/experiment-tracking/Q17_DIRECTAPPLY_FRONTIER_PLAN_20260910.md';
const papers = [
  ['WebRL', 'https://proceedings.iclr.cc/paper_files/paper/2025/hash/c66e1fcc9691aae706250638f36f681b-Abstract-Conference.html'],
  ['SPEAR', 'https://github.com/TencentYoutuResearch/SPEAR'],
  ['Agent Q', 'https://arxiv.org/abs/2408.07199'],
  ['GiGPO', 'https://proceedings.neurips.cc/paper_files/paper/2025/hash/420c9f777c0b4f78d515e53cf74d58b2-Abstract-Conference.html'],
  ["RL's Razor", 'https://proceedings.iclr.cc/paper_files/paper/2026/hash/618c95f4557c15b253fb0e6f548ea0c0-Abstract-Conference.html'],
] as const;
---
<main data-copy-review class="frontier-roadmap" data-reader-frontier>
  <section class="frontier-hero" aria-labelledby="frontier-title">
    <p class="eyebrow">Q17 DirectApply / No-GDR · 2026-09-10</p>
    <h1 id="frontier-title">{t('模型没有简单卡死；下一步要找能力边界在哪里', 'The model did not simply stall; the next step is to locate its frontier')}</h1>
    <p class="lede">{t('这条页面把今天的计划固定下来：先用现有 WebShop 曲线和轨迹判断 1.7B DirectApply 到底学到了什么，再把“平台期”拆成几个可以独立验证的实验。未知结果先留空，不提前写成胜负。', 'This page freezes today’s plan: use the current WebShop curve and traces to understand what the 1.7B DirectApply run is learning, then split the plateau question into independently testable experiments. Unknown results stay blank instead of becoming premature claims.')}</p>
    <div class="hero-links" aria-label={t('相关入口', 'Related entries')}>
      <a href={directApplyHref}>{t('看当前曲线', 'Current curve')}</a>
      <a href={gdrHref}>{t('GDR → DirectApply 背景', 'GDR → DirectApply context')}</a>
      <a href={briefingHref}>{t('看汇报 Slide', 'Briefing slide')}</a>
      <a href={planPrHref}><ExternalBrandMark href={planPrHref} />{t('永久计划 PR #420', 'Durable plan PR #420')}</a>
      <a href={planFileHref}><ExternalBrandMark href={planFileHref} />{t('Markdown 文件', 'Markdown file')}</a>
    </div>
  </section>

  <section class="frontier-section" aria-labelledby="known-now">
    <p class="section-kicker">01 · {t('现在已经知道', 'Known now')}</p>
    <h2 id="known-now">{t('不是“卡死”，而是经历平台后又恢复上升', 'Not a dead stall: a plateau was followed by recovery')}</h2>
    <div class="metric-grid">
      <article><span>{t('封口数据', 'Sealed data')}</span><strong>R0–R121</strong><p>{t('122 轮、15,616 次正式 rollout。R122 只完成 rollout，尚未封口。', '122 rounds, 15,616 formal rollouts. R122 had rollouts written but was not sealed.')}</p></article>
      <article><span>{t('Score 变化', 'Score movement')}</span><strong>49.90 → 63.52</strong><p>{t('R90–99 回落到 49.90，R110–119 恢复到 63.52。', 'R90–99 fell to 49.90, then R110–119 recovered to 63.52.')}</p></article>
      <article><span>{t('可靠性', 'Reliability')}</span><strong>23.91% → 33.67%</strong><p>{t('Success@1 上升比 Success@8 更明显，说明“偶尔会做”正在变成“更常做对”。', 'Success@1 rose more clearly than Success@8, suggesting occasional competence is becoming more reliable.')}</p></article>
      <article><span>{t('训练材料', 'Training material')}</span><strong>111 / 122</strong><p>{t('多数轮次里，SD-LoRA 选中的 task 数与已经 exact success 的 task 数完全相同。', 'In most rounds, the number of tasks selected for SD-LoRA exactly matched the exact-success task count.')}</p></article>
    </div>
  </section>

  <section class="frontier-section" aria-labelledby="blank-results">
    <p class="section-kicker">02 · {t('先留空，不编结果', 'Blank until measured')}</p>
    <h2 id="blank-results">{t('这些格子等离线诊断或 successor 跑完后再填', 'These boxes wait for diagnostics or successor results')}</h2>
    <div class="blank-grid">
      <div class="blank-card"><span>Frontier Curriculum ΔSuccess@8</span><b>{t('待填', 'TBD')}</b></div>
      <div class="blank-card"><span>{t('State coverage 增量', 'State coverage delta')}</span><b>{t('待填', 'TBD')}</b></div>
      <div class="blank-card"><span>{t('Delayed reject counterfactual', 'Delayed reject counterfactual')}</span><b>{t('待填', 'TBD')}</b></div>
      <div class="blank-card"><span>{t('Partial preference 是否启动', 'Partial preference decision')}</span><b>{t('待填', 'TBD')}</b></div>
    </div>
  </section>

  <section class="frontier-section two-col" aria-labelledby="metrics-plan">
    <div>
      <p class="section-kicker">03 · {t('先补指标', 'Add measurements first')}</p>
      <h2 id="metrics-plan">{t('不要只看 loss，要分清稳定性、覆盖面和探索', 'Do not only watch loss: separate reliability, coverage, and exploration')}</h2>
      <ul class="check-list">
        <li>{t('Success@1 / @2 / @4 / @8 与 best-of-8。', 'Success@1 / @2 / @4 / @8 and best-of-8.')}</li>
        <li>{t('0-exact、near-miss、frontier task 数。', '0-exact, near-miss, and frontier task counts.')}</li>
        <li>{t('selected task identity 与 exact-success identity 的重合。', 'Overlap between selected task identities and exact-success identities.')}</li>
        <li>{t('state/page coverage、重复动作、真正改变状态的动作比例。', 'State/page coverage, repeated actions, and state-changing action rate.')}</li>
        <li>{t('之后再补 KL、ACC/BWT/FWT；PCGrad 等冲突指标先不排第一。', 'Add KL and ACC/BWT/FWT later; do not prioritize PCGrad until conflict is measured.')}</li>
      </ul>
    </div>
    <aside class="boundary-box">
      <strong>{t('边界', 'Boundary')}</strong>
      <p>{t('这些指标先从已有 trace 离线计算，不调用模型，不占 GPU，不写回正式 run root，不打开 final panel。', 'These measurements are computed offline from existing traces first: no model calls, no GPU use, no writes under the formal run root, and no final-panel access.')}</p>
    </aside>
  </section>

  <section class="frontier-section" aria-labelledby="experiments-plan">
    <p class="section-kicker">04 · {t('再做实验', 'Then run experiments')}</p>
    <h2 id="experiments-plan">{t('把一个大问题拆成四个小问题', 'Split one large question into four small tests')}</h2>
    <div class="experiment-grid">
      <article><span>A</span><h3>{t('Offline Diagnostic Pack', 'Offline Diagnostic Pack')}</h3><p>{t('先把已有 R0–R121 轨迹变成 JSON、CSV、Markdown 和 manifest。', 'Turn existing R0–R121 traces into JSON, CSV, Markdown, and a manifest.')}</p></article>
      <article><span>B</span><h3>{t('Frontier Curriculum', 'Frontier Curriculum')}</h3><p>{t('同样 128 rollout，只把第二波机会优先给“没有成功但已经接近”的 task。', 'Keep 128 rollouts, but give the second wave to tasks that are not solved yet but are close.')}</p></article>
      <article><span>C</span><h3>{t('Partial-credit Preference', 'Partial-credit Preference')}</h3><p>{t('失败轨迹先做比较信号，不把整条失败轨迹当正确答案 SFT。', 'Use failed traces as comparative signal, not as full positive SFT targets.')}</p></article>
      <article><span>D</span><h3>{t('Delayed Counterfactual', 'Delayed Counterfactual')}</h3><p>{t('在 shadow-GDR reject 边界复制状态，比较“采用”和 KEEP_PRIOR 之后 5/10 轮。', 'Branch at shadow-GDR reject boundaries and compare adopted vs KEEP_PRIOR after 5/10 rounds.')}</p></article>
    </div>
  </section>

  <section class="frontier-section two-col" aria-labelledby="literature">
    <div>
      <p class="section-kicker">05 · {t('论文不是装饰', 'Papers are not decoration')}</p>
      <h2 id="literature">{t('它们分别提醒我们该补什么证据', 'They tell us which evidence to add')}</h2>
      <p>{t('WebRL / SPEAR 指向 curriculum 与探索；Agent Q / GiGPO 指向失败轨迹的比较学习；ReST-MCTS* 提醒不要把 partial failure 直接当正确答案；continual-learning 与 RL’s Razor 指向遗忘和 KL drift。', 'WebRL / SPEAR point to curriculum and exploration; Agent Q / GiGPO point to comparative learning from failed traces; ReST-MCTS* warns against treating partial failures as correct demonstrations; continual-learning work and RL’s Razor motivate forgetting and KL-drift diagnostics.')}</p>
      <div class="paper-links">
        {papers.map(([label, href]) => <a href={href}>{href.includes('github.com') ? <ExternalBrandMark href={href} /> : null}{label}</a>)}
      </div>
    </div>
    <aside class="boundary-box muted">
      <strong>{t('不能提前写成', 'Do not claim yet')}</strong>
      <p>{t('DirectApply 已赢、DirectApply 已失败、GDR 已赢、或 Frontier Curriculum 一定有效。当前页面只固定计划和可验证假设。', 'That DirectApply won, DirectApply failed, GDR won, or Frontier Curriculum must work. This page only fixes the plan and testable hypotheses.')}</p>
      <a href={evidenceHref}>{t('只读计划证据 JSON', 'Read-only plan evidence JSON')}</a>
    </aside>
  </section>
</main>

<style>
.frontier-roadmap{--max:1120px;width:min(var(--max),calc(100% - 2rem));margin:0 auto 4rem;color:var(--ink)}
.frontier-hero{padding:4.5rem 0 2.3rem;border-bottom:1px solid var(--line)}.eyebrow,.section-kicker{font:800 16px/1.25 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--accent-deep);margin:0 0 .8rem}.frontier-hero h1{max-width:860px;font-size:clamp(2.4rem,6vw,5.25rem);line-height:.96;letter-spacing:-.07em;margin:0}.lede{max-width:780px;margin:1.25rem 0 0;font-size:1.1rem;line-height:1.65;color:var(--muted)}.hero-links,.paper-links{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.4rem}.hero-links a,.paper-links a,.boundary-box a{border:1px solid var(--line);border-radius:999px;padding:.55rem .8rem;color:var(--accent-deep);text-decoration:none;background:var(--surface)}.frontier-section{padding:2.8rem 0;border-bottom:1px solid var(--line)}.frontier-section h2{max-width:820px;font-size:clamp(1.75rem,3.5vw,3.2rem);line-height:1.02;letter-spacing:-.05em;margin:.2rem 0 1.2rem}.metric-grid,.blank-grid,.experiment-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.metric-grid article,.experiment-grid article,.blank-card,.boundary-box{border:1px solid var(--line);background:var(--surface);padding:1rem;min-width:0}.metric-grid span,.blank-card span,.experiment-grid span{display:block;font:800 16px/1.25 var(--font-mono);letter-spacing:.05em;color:var(--muted)}.metric-grid strong{display:block;margin:.75rem 0 .55rem;font:850 1.75rem/1 var(--font-mono);letter-spacing:-.04em}.metric-grid p,.experiment-grid p,.boundary-box p,.frontier-section p,.check-list{color:var(--muted);line-height:1.55}.blank-card{min-height:8.5rem;display:flex;flex-direction:column;justify-content:space-between;background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--surface) 92%,transparent),color-mix(in srgb,var(--surface) 92%,transparent) 10px,color-mix(in srgb,var(--line) 35%,transparent) 10px,color-mix(in srgb,var(--line) 35%,transparent) 12px)}.blank-card b{font-size:1.6rem;letter-spacing:.18em;color:var(--muted)}.two-col{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:1.5rem;align-items:start}.check-list{padding-left:1.2rem}.check-list li+li{margin-top:.55rem}.experiment-grid article span{width:2rem;height:2rem;border-radius:999px;background:var(--accent-deep);color:var(--surface);display:grid;place-items:center;margin-bottom:.8rem}.experiment-grid h3{font-size:1.2rem;margin:.2rem 0 .5rem}.boundary-box{border-left:4px solid var(--accent-deep)}.boundary-box.muted{border-left-color:var(--warning)}@media(max-width:860px){.metric-grid,.blank-grid,.experiment-grid,.two-col{grid-template-columns:1fr}.frontier-hero{padding-top:2.5rem}.metric-grid strong{font-size:1.45rem}}
</style>
