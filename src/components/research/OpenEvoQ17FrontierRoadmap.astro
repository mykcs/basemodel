---
import { localePath, type Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import { OPEN_EVO_DIRECT_APPLY_R97_DYNAMICS } from '../../data/openEvoDirectApplyHistoricalR97';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const briefingHref = p('/research/seed-openevo/study/briefing/#frontier-roadmap');
const directApplyHref = p('/research/seed-openevo/study/briefing/#directapply-progress');
const gdrHref = p('/research/seed-openevo/study/capability-exploration/gdr-directapply/');
const evidenceHref = '/research/seed-openevo/evidence/q17-directapply-frontier-plan-20260910-2312-sgt.json';
const planPrHref = 'https://github.com/mykcs/openevo-experiment/pull/420';
const planFileHref = 'https://github.com/mykcs/openevo-experiment/blob/afc7b74500b98134c12f2ee9cc880ac2980ffc10/docs/experiment-tracking/Q17_DIRECTAPPLY_FRONTIER_PLAN_20260910.md';
const papers = [
  ['WebRL', 'https://proceedings.iclr.cc/paper_files/paper/2025/hash/c66e1fcc9691aae706250638f36f681b-Abstract-Conference.html'],
  ['SPEAR', 'https://github.com/TencentYoutuResearch/SPEAR'],
  ['Agent Q', 'https://arxiv.org/abs/2408.07199'],
  ['GiGPO', 'https://proceedings.neurips.cc/paper_files/paper/2025/hash/420c9f777c0b4f78d515e53cf74d58b2-Abstract-Conference.html'],
  ["RL's Razor", 'https://proceedings.iclr.cc/paper_files/paper/2026/hash/618c95f4557c15b253fb0e6f548ea0c0-Abstract-Conference.html'],
] as const;

const plateauDynamics = OPEN_EVO_DIRECT_APPLY_R97_DYNAMICS;
const plateauMovingAverage = plateauDynamics.score.map((point, index) => {
  const rows = plateauDynamics.score.slice(Math.max(0, index - 11), index + 1);
  return { round: point.round, score: rows.reduce((sum, row) => sum + row.score, 0) / rows.length };
});
const plateauScoreChart = { left: 42, right: 676, top: 16, bottom: 220, maxRound: plateauDynamics.score.at(-1)?.round ?? 97, maxScore: 80 };
const plateauScoreX = (round: number) => plateauScoreChart.left + (round / plateauScoreChart.maxRound) * (plateauScoreChart.right - plateauScoreChart.left);
const plateauScoreY = (score: number) => plateauScoreChart.bottom - (score / plateauScoreChart.maxScore) * (plateauScoreChart.bottom - plateauScoreChart.top);
const plateauScoreRawPoints = plateauDynamics.score.map((point) => `${plateauScoreX(point.round).toFixed(1)},${plateauScoreY(point.score).toFixed(1)}`).join(' ');
const plateauScoreTrendPoints = plateauMovingAverage.map((point) => `${plateauScoreX(point.round).toFixed(1)},${plateauScoreY(point.score).toFixed(1)}`).join(' ');
const plateauLossChart = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0, maxLoss: 1.10 };
const plateauLossX = (round: number) => plateauLossChart.left + (round / plateauScoreChart.maxRound) * (plateauLossChart.right - plateauLossChart.left);
const plateauLossY = (loss: number) => plateauLossChart.bottom - ((loss - plateauLossChart.minLoss) / (plateauLossChart.maxLoss - plateauLossChart.minLoss)) * (plateauLossChart.bottom - plateauLossChart.top);
const plateauLossPoints = plateauDynamics.loss.map((point) => `${plateauLossX(point.round).toFixed(1)},${plateauLossY(point.loss).toFixed(1)}`).join(' ');
const plateauCandidateRounds = plateauDynamics.loss.map((point) => point.round);
---

<section data-copy-review class="frontier-roadmap" data-reader-frontier aria-labelledby="frontier-title">
  <section class="frontier-hero" aria-labelledby="frontier-title">
    <p class="eyebrow">2026-09-10 · {t('当时的分析计划', 'Earlier analysis plan')}</p>
    <h2 id="frontier-title">{t('同题重测前的排查计划', 'The investigation plan before the same-task test')}</h2>
    <p class="lede">{t('这部分保留 9 月 10 日的旧计划，方便回看我们当时为什么会想到 9 月 11 日的同题重测。上面的同题结果是更新的证据；下面没跑过的方案仍然只是想法，不算结果。最终测试也一直锁着。', 'This keeps the September 10 plan so it is clear why we later ran the September 11 same-task test. The same-task result above is newer evidence. Ideas below that were never run are still just ideas, not results, and the final test stayed locked.')}</p>
    <div class="hero-links" aria-label={t('相关入口', 'Related links')}>
      <a href={directApplyHref}>{t('训练曲线', 'Training curve')}</a>
      <a href={gdrHref}>{t('为什么从 GDR 改到 DirectApply', 'Why we moved from GDR to DirectApply')}</a>
      <a href={briefingHref}>{t('汇报 Slide', 'Briefing slide')}</a>
    </div>
  </section>

  <section class="frontier-section" aria-labelledby="known-now">
    <p class="frontier-section-kicker">01 · {t('当时看到的现象', 'What we saw at the time')}</p>
    <h2 id="known-now">{t('分数先掉下去，后来又涨回来', 'The score fell, then recovered')}</h2>
    <div class="metric-grid">
      <article><span>{t('当时跑到', 'Run progress')}</span><strong>R0–R121</strong><p>{t('2026-09-10 23:12 的快照里，122 轮、15,616 次 WebShop 尝试已经完整保存。R122 当时还没结束，所以没有算进去。', 'In the September 10 23:12 snapshot, 122 rounds and 15,616 WebShop attempts were fully saved. R122 was still unfinished then, so it was left out.')}</p></article>
      <article><span>{t('训练分数', 'Training score')}</span><strong>49.90 → 63.52</strong><p>{t('R90–99 的平均分掉到 49.90，R110–119 又回到 63.52。', 'The R90–99 average fell to 49.90, then R110–119 recovered to 63.52.')}</p></article>
      <article><span>{t('一次就做对的比例', 'Solved on the first try')}</span><strong>25.62% → 34.38%</strong><p>{t('同一道题只给一次机会时，成功率提高得更明显。说明当时首先改善的是“第一次就做对”的稳定性。', 'Success improved more clearly when the model only got one try. The first visible improvement was therefore in solving a task correctly on the first attempt.')}</p></article>
      <article><span>{t('拿去训练的题', 'Tasks used for training')}</span><strong>111 / 122</strong><p>{t('122 轮里有 111 轮，SD-LoRA 选中的题数，和这一轮真正完全做对的题数一样。多数时候，训练材料基本来自模型这一轮已经会做的题。', 'In 111 of 122 rounds, the number of tasks selected for SD-LoRA matched the number of tasks fully solved in that round. Most of the time, the training material was therefore coming from tasks the model had already solved.')}</p></article>
    </div>
    <div class="plateau-visual" data-q17-plateau-visual>
      <div class="plateau-visual-head">
        <h3>{t('训练还在继续，但分数没有稳定往上', 'Training continued, but the score did not rise steadily')}</h3>
        <p>{t('这张图直接复用汇报 Slide 的 2026-09-10 09:52 SGT 快照。左边是每轮 WebShop Score，右边是 SD-LoRA 每次参数更新时的训练损失（training loss）。R70 以后参数仍在持续更新，但任务分数开始大幅上下波动。', 'This directly reuses the 2026-09-10 09:52 SGT briefing snapshot. The left chart is round-by-round WebShop Score; the right chart is SD-LoRA training loss at each parameter update. After R70, parameter updates continued while task score began fluctuating strongly.')}</p>
      </div>
      <div class="plateau-charts">
        <figure class="training-chart score-chart">
          <figcaption>{t('每轮 WebShop Score', 'WebShop Score by round')} <span>{t('细线=每轮；粗线=12轮移动平均；底部短线=SD-LoRA 更新', 'thin=each round; thick=12-round moving average; bottom ticks=SD-LoRA updates')}</span></figcaption>
          <svg viewBox="0 0 700 248" role="img" aria-label={t('DirectApply 每轮 WebShop Score 与移动平均曲线', 'DirectApply WebShop Score and moving-average curve by round')}>
            <line x1="42" y1="220" x2="676" y2="220" class="chart-axis" /><line x1="42" y1="118" x2="676" y2="118" class="chart-gridline" /><line x1="42" y1="16" x2="676" y2="16" class="chart-gridline" />
            <text x="14" y="224" class="chart-label">0</text><text x="8" y="122" class="chart-label">40</text><text x="8" y="20" class="chart-label">80</text>
            <text x="42" y="242" class="chart-label">R0</text><text x="350" y="242" class="chart-label">R49</text><text x="646" y="242" class="chart-label">R97</text>
            <polyline points={plateauScoreRawPoints} class="score-raw" /><polyline points={plateauScoreTrendPoints} class="score-trend" />
            {plateauCandidateRounds.map((round) => <line x1={plateauScoreX(round)} x2={plateauScoreX(round)} y1="220" y2="228" class="candidate-tick" />)}
          </svg>
        </figure>
        <figure class="training-chart loss-chart">
          <figcaption>{t('SD-LoRA 训练损失', 'SD-LoRA training loss')} <span>{t('每个点=一次参数更新', 'each point=one parameter update')}</span></figcaption>
          <svg viewBox="0 0 360 248" role="img" aria-label={t('DirectApply SD-LoRA training loss 曲线', 'DirectApply SD-LoRA training-loss curve')}>
            <line x1="36" y1="220" x2="340" y2="220" class="chart-axis" /><line x1="36" y1="118" x2="340" y2="118" class="chart-gridline" /><line x1="36" y1="16" x2="340" y2="16" class="chart-gridline" />
            <text x="4" y="224" class="chart-label">0</text><text x="4" y="122" class="chart-label">0.55</text><text x="4" y="20" class="chart-label">1.10</text><text x="36" y="242" class="chart-label">R0</text><text x="310" y="242" class="chart-label">R97</text>
            <polyline points={plateauLossPoints} class="loss-line" />{plateauDynamics.loss.map((point) => <circle cx={plateauLossX(point.round)} cy={plateauLossY(point.loss)} r="2.4" class="loss-dot" />)}
          </svg>
        </figure>
      </div>
      <p class="plateau-readout"><strong>{t('R70 后出现震荡：', 'After R70:')}</strong>{t('R70–79 / R80–89 / R90–97 的平均 Score 是 58.35 → 55.36 → 50.83。也就是说，SD-LoRA 还在训练，但能力没有稳定累积成更高分。后来的封口证据又显示 R110–119 恢复到 63.52，所以它证明的是一段“震荡平台”，不是永久卡死，也还不能证明平台由 SD-LoRA 本身造成。', 'Mean Score for R70–79 / R80–89 / R90–97 was 58.35 → 55.36 → 50.83. SD-LoRA was still training, but capability was not steadily accumulating into higher score. Later sealed evidence recovered to 63.52 at R110–119, so this is evidence of a noisy plateau, not a permanent stall, and it does not yet prove SD-LoRA itself caused the plateau.')}</p>
      <p class="plateau-source"><a href={plateauDynamics.evidenceHref}>{t('R0–R97 曲线证据', 'R0–R97 curve evidence')}</a> · <a href={directApplyHref}>{t('在 Slide 里看同一张图', 'See the same chart in the briefing')}</a></p>
    </div>
  </section>

  <section class="frontier-section" aria-labelledby="blank-results">
    <p class="frontier-section-kicker">02 · {t('当时还没跑', 'Not run at the time')}</p>
    <h2 id="blank-results">{t('这些想法当时只是计划，没有结果', 'These were plans, not results')}</h2>
    <div class="blank-grid">
      <div class="blank-card" data-placeholder-key="frontier_curriculum_delta_success_at_8"><span>{t('给“差一点成功”的题更多机会', 'Give near-success tasks more chances')}</span><b>{t('未运行', 'Not run')}</b></div>
      <div class="blank-card" data-placeholder-key="frontier_curriculum_state_coverage_delta"><span>{t('看模型有没有走到更多不同页面', 'Check whether the model reaches more distinct pages')}</span><b>{t('未运行', 'Not run')}</b></div>
      <div class="blank-card" data-placeholder-key="delayed_reject_counterfactual"><span>{t('把被拒绝的更新延后几轮再比较', 'Recheck rejected updates several rounds later')}</span><b>{t('未运行', 'Not run')}</b></div>
      <div class="blank-card" data-placeholder-key="partial_credit_preference_start_decision"><span>{t('让“差一点成功”的失败轨迹也提供比较信号', 'Use near-success failures as comparison signal')}</span><b>{t('未运行', 'Not run')}</b></div>
    </div>
  </section>

  <section class="frontier-section two-col" aria-labelledby="metrics-plan">
    <div>
      <p class="frontier-section-kicker">03 · {t('当时想先补的数据', 'Data we wanted to add first')}</p>
      <h2 id="metrics-plan">{t('需要补哪些数据', 'Data we still needed')}</h2>
      <ul class="check-list">
        <li>{t('同一道题做 1 次、2 次、4 次、8 次时，至少成功一次的比例。', 'How often a task succeeds when the model gets 1, 2, 4, or 8 tries.')}</li>
        <li>{t('哪些题 8 次都没做成，哪些题已经接近成功。', 'Which tasks still fail after 8 tries, and which ones are close to success.')}</li>
        <li>{t('真正拿去训练的题，和真正做成功的题是不是同一批。', 'Whether the tasks used for training are the same tasks the model already solved.')}</li>
        <li>{t('模型到底访问了多少不同页面 / 状态，是否一直重复同一动作。', 'How many different pages or states the model actually reaches, and whether it keeps repeating the same actions.')}</li>
        <li>{t('如果这些还解释不了，再看参数更新前后差多大、旧能力是不是被新更新影响。', 'If that is still not enough, then measure how much parameter updates move and whether new updates hurt old abilities.')}</li>
      </ul>
    </div>
    <aside class="boundary-box">
      <strong>{t('当时的安全边界', 'Safety boundary at the time')}</strong>
      <p>{t('这一步原本只读已经保存的日志：不重新跑模型、不占 GPU、不写正式实验目录，也不打开最终 128 题。网页只负责展示，不能替实验仓授权新实验。', 'This step was meant to read already-saved logs only: no model rerun, no GPU use, no writes to the formal experiment directory, and no access to the final 128 tasks. The website can explain the plan, but it cannot authorize a new experiment.')}</p>
    </aside>
  </section>

  <section class="frontier-section" aria-labelledby="experiments-plan">
    <p class="frontier-section-kicker">04 · {t('后续实验设想', 'Possible follow-up experiments')}</p>
    <h2 id="experiments-plan">{t('后续实验的四个设想', 'Four possible follow-up experiments')}</h2>
    <div class="experiment-grid">
      <article><span>A</span><h3>{t('旧日志里的成功与训练记录', 'Success and training records in the saved logs')}</h3><p>{t('这项后来已经完成：我们核对了“哪些题被拿去训练”和“哪些题真正做成功”，又按学长建议补了成功率、输出长度、entropy 和上面的 R127 / R128 同题重测。', 'This was later completed: first we checked which tasks were used for training versus which tasks were actually solved, then added success rate, output length, entropy, and the R127/R128 same-task test shown above.')}</p></article>
      <article><span>B</span><h3>{t('给“差一点成功”的题更多机会', 'Give near-success tasks more chances')}</h3><p>{t('总尝试次数仍然保持 128，但后半段优先给“还没做成、已经很接近”的题。旧计划里叫 Frontier Curriculum。', 'Keep the total at 128 attempts, but give later chances first to tasks that are unsolved and already close. The old plan called this Frontier Curriculum.')}</p></article>
      <article><span>C</span><h3>{t('失败但接近成功的轨迹也拿来比较', 'Compare failures that were close to success')}</h3><p>{t('不把失败轨迹当成正确答案，而是比较哪一条更接近成功，让失败也能提供一点学习信号。旧计划里叫 Partial-credit Preference。', 'Do not treat a failed trace as a correct answer. Instead, compare which failed attempt was closer to success so failures can still provide some learning signal. The old plan called this Partial-credit Preference.')}</p></article>
      <article><span>D</span><h3>{t('被拒绝的参数更新，晚几轮再看值不值得', 'Recheck a rejected update several rounds later')}</h3><p>{t('如果以后单独授权，就在不改当前正式实验的前提下，比较“当时采用这笔参数更新”和“当时不采用”经过 5 / 10 轮之后谁更好。旧计划里叫 Delayed Counterfactual。', 'If separately authorized later, compare “take this update” versus “keep the old state” after 5 or 10 more rounds, without changing the current formal run. The old plan called this Delayed Counterfactual.')}</p></article>
    </div>
  </section>

  <section class="frontier-section two-col" aria-labelledby="literature">
    <div>
      <p class="frontier-section-kicker">05 · {t('论文给了哪些线索', 'What the papers suggested')}</p>
      <h2 id="literature">{t('这些论文只帮我们找检查方向，不替我们下结论', 'The papers suggest what to check; they do not decide our result')}</h2>
      <p>{t('WebRL / SPEAR 提醒我们可以把更多训练机会给难题和接近成功的题；Agent Q / GiGPO 提醒失败轨迹也能拿来做比较；ReST-MCTS* 提醒失败不能直接当正确示范；continual-learning 相关工作和 RL’s Razor 提醒我们要单独检查旧能力会不会被后续更新影响。', 'WebRL and SPEAR suggest giving more learning chances to hard or near-success tasks. Agent Q and GiGPO suggest comparing failed traces rather than throwing them away. ReST-MCTS* warns against treating failures as correct demonstrations. Continual-learning work and RL’s Razor suggest checking whether later updates hurt abilities learned earlier.')}</p>
      <div class="paper-links">
        {papers.map(([label, href]) => <a href={href}><ExternalBrandMark href={href} />{label}</a>)}
      </div>
    </div>
    <aside class="boundary-box muted">
      <strong>{t('这些都还不是我们的实验结果', 'These are still not our experiment results')}</strong>
      <p>{t('我们还没有证明 DirectApply 一定好或一定坏，也没有证明上面的任何改法有效。没跑过的方案就只能写成“准备测试”，不能写成结果。', 'We have not shown that DirectApply is definitely good or bad, and we have not shown that any follow-up idea above works. An experiment that has not been run stays a plan, not a result.')}</p>
      <a href={evidenceHref}>{t('计划原始数据', 'Plan data')}</a>
      <a href={planPrHref}><ExternalBrandMark href={planPrHref} />{t('实验仓 PR #420', 'Experiment PR #420')}</a>
      <a href={planFileHref}><ExternalBrandMark href={planFileHref} />{t('原始计划文档', 'Original plan document')}</a>
    </aside>
  </section>
</section>
<style>
.frontier-roadmap{--max:1120px;width:min(var(--max),calc(100% - 2rem));margin:0 auto 4rem;color:var(--ink)}
.frontier-hero{padding:4.5rem 0 2.3rem;border-bottom:1px solid var(--line)}.eyebrow,.frontier-section-kicker{font:800 18px/1.25 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--accent-deep);margin:0 0 .8rem}.frontier-hero h2{max-width:860px;font-size:clamp(2.4rem,6vw,5.25rem);line-height:.96;letter-spacing:-.07em;margin:0}.lede{max-width:780px;margin:1.25rem 0 0;font-size:1.1rem;line-height:1.65;color:var(--muted)}.hero-links,.paper-links{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.4rem}.hero-links a,.paper-links a,.boundary-box a{border:1px solid var(--line);border-radius:999px;padding:.55rem .8rem;color:var(--accent-deep);text-decoration:none;background:var(--surface)}.frontier-section{padding:2.8rem 0;border-bottom:1px solid var(--line)}.frontier-section h2{max-width:820px;font-size:clamp(1.75rem,3.5vw,3.2rem);line-height:1.02;letter-spacing:-.05em;margin:.2rem 0 1.2rem}.metric-grid,.blank-grid,.experiment-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.metric-grid article,.experiment-grid article,.blank-card,.boundary-box{border:1px solid var(--line);background:var(--surface);padding:1rem;min-width:0}.metric-grid span,.blank-card span,.experiment-grid span{display:block;font:800 18px/1.25 var(--font-mono);letter-spacing:.05em;color:var(--muted)}.metric-grid strong{display:block;margin:.75rem 0 .55rem;font:850 1.75rem/1 var(--font-mono);letter-spacing:-.04em}.metric-grid p,.experiment-grid p,.boundary-box p,.frontier-section p,.check-list{color:var(--muted);line-height:1.55}.blank-card{min-height:8.5rem;display:flex;flex-direction:column;justify-content:space-between;background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--surface) 92%,transparent),color-mix(in srgb,var(--surface) 92%,transparent) 10px,color-mix(in srgb,var(--line) 35%,transparent) 10px,color-mix(in srgb,var(--line) 35%,transparent) 12px)}.blank-card b{font-size:1.6rem;letter-spacing:.18em;color:var(--muted)}.two-col{display:g