---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { SD_LORA_HISTORY_OVERVIEW_ROUTE, SD_LORA_HISTORY_SERIES } from '../../data/sdLoraHistorySeries';
import OpenEvoSdLoraHistorySeriesNav from './OpenEvoSdLoraHistorySeriesNav.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const root = '/research/seed-openevo/study/capability-exploration/';
const neutral = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '').replace(/\/+$/, '');
const slug = neutral.split('/').at(-1) || SD_LORA_HISTORY_OVERVIEW_ROUTE;
const item = SD_LORA_HISTORY_SERIES.find((entry) => entry.route === slug);
const overview = slug === SD_LORA_HISTORY_OVERVIEW_ROUTE;
if (!overview && !item) throw new Error(`Unknown SD-LoRA history series route: ${slug}`);
const title = overview
  ? t('从不断增长的 SD-LoRA，到固定大小的学习状态', 'From growing SD-LoRA history to a fixed-size learning state')
  : item!.title[locale];
const summary = overview
  ? t('这个专题把一次工程问题一路追到一个科学问题：参数历史为什么一直增长，这些历史是否都必要，以及未来能不能用一个固定大小的状态保留真正需要的信息。', 'This series follows an engineering problem into a scientific one: why parameter history keeps growing, whether all of it is necessary, and whether a fixed-size state can preserve what future learning really needs.')
  : item!.summary[locale];
---
<article class="series-page" data-copy-review data-testid="sd-lora-history-series-page">
  <header class="sdlora-series-hero">
    <p class="series-page__eyebrow">{overview ? t('SD-LoRA 专题总览', 'SD-LoRA SERIES OVERVIEW') : `${item!.number} / 07`}</p>
    <h1>{title}</h1>
    <p class="series-page__lede">{summary}</p>
    <p class="series-page__state">{t('当前先建立页面结构和导航。没有完成的科学实验不会提前写成结论。', 'For now this route establishes structure and navigation. Unfinished scientific experiments are not presented as conclusions.')}</p>
  </header>

  {overview ? (
    <section class="series-page__chapters" aria-labelledby="series-chapters-title">
      <h2 id="series-chapters-title">{t('七个连续问题', 'Seven connected questions')}</h2>
      <ol>
        {SD_LORA_HISTORY_SERIES.map((entry) => (
          <li>
            <a href={p(`${root}${entry.route}/`)}>
              <span>{entry.number}</span>
              <strong>{entry.title[locale]}</strong>
              <p>{entry.summary[locale]}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ) : (
    <section class="series-page__empty" aria-labelledby="series-empty-title">
      <h2 id="series-empty-title">{t('这页接下来会放什么', 'What will go on this page')}</h2>
      <p>{summary}</p>
      <p>{t('下一步会从已经封存的实验和新研究计划中填入可追溯证据；在那之前，这里只保留研究问题和导航。', 'The next step is to fill this page with traceable evidence from sealed experiments and the new research plan. Until then it keeps only the research question and navigation.')}</p>
    </section>
  )}

  <OpenEvoSdLoraHistorySeriesNav locale={locale} />
</article>
<style>
.series-page{width:100%;padding:0 0 4rem}.sdlora-series-hero,.series-page__chapters,.series-page__empty{width:min(960px,calc(100% - 2rem));margin:0 auto}.sdlora-series-hero{min-height:calc(100svh - var(--header-height,72px));box-sizing:border-box;padding:clamp(2.2rem,7vw,5rem) 0 1.2rem}.series-page__eyebrow{margin:0 0 .6rem;color:var(--accent-deep);font:800 1rem/1.2 var(--font-mono)}.sdlora-series-hero h1{max-width:15ch;margin:0;font-size:clamp(2.1rem,5.8vw,4.9rem);line-height:1.02;letter-spacing:-.045em}.series-page__lede{max-width:48rem;margin:1.1rem 0 0;color:var(--ink);font-size:clamp(1.08rem,2vw,1.3rem);line-height:1.65}.series-page__state{max-width:48rem;margin:.9rem 0 0;padding-left:.8rem;border-left:2px solid var(--line);color:var(--muted);font-size:1rem;line-height:1.6}.series-page__chapters h2,.series-page__empty h2{font-size:clamp(1.45rem,3vw,2.1rem);line-height:1.2}.series-page__chapters ol{display:grid;gap:.7rem;margin:1.2rem 0 0;padding:0;list-style:none}.series-page__chapters a{display:grid;grid-template-columns:2.4rem minmax(0,1fr);gap:.2rem .8rem;padding:1rem 0;border-top:1px solid var(--line);color:inherit;text-decoration:none}.series-page__chapters a:hover strong,.series-page__chapters a:focus-visible strong{color:var(--accent-deep)}.series-page__chapters a:focus-visible{outline:2px solid var(--accent-deep);outline-offset:4px}.series-page__chapters span{grid-row:1 / span 2;color:var(--accent-deep);font:800 1rem/1.2 var(--font-mono)}.series-page__chapters strong{font-size:1.1rem;line-height:1.4}.series-page__chapters p,.series-page__empty p{margin:.25rem 0 0;color:var(--muted);font-size:1rem;line-height:1.6}.series-page__empty{padding-top:1rem}.series-page__empty p{max-width:48rem}@media(max-width:680px){.sdlora-series-hero,.series-page__chapters,.series-page__empty{width:min(100% - 1rem,960px)}.sdlora-series-hero{min-height:calc(100svh - var(--header-height,64px));padding-top:2rem}.series-page__chapters a{grid-template-columns:2rem minmax(0,1fr)}}
</style>
