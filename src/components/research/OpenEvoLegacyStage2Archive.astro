---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh=locale==='zh';
const t=(cn:string,en:string)=>zh?cn:en;
const p=(x:string)=>localePath(locale,x);
const archiveRevision='f2d436659f060c6e1cba1fec391b1fbf20cec0dd';
const adapterRevision='cc64938ac0bbef573b631d2742e3b9f477aff36b';
const hfArchive=`https://huggingface.co/datasets/miyuki17/openevo-webshop-superseded-stage2-archive/tree/${archiveRevision}`;
const hfAdapters=`https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}`;
const ghcr='https://github.com/mykcs/openevo-experiment/pkgs/container/openevo-scientific';
const arms=[
 {id:'3b-self',label:'3B / self',blocks:'80 / 80',attempts:'20,480',positive:'138',max:'2 / 8',updates:'0',state:t('base；Stage 1 未形成 adapter','base; no Stage-1 adapter'),status:t('完成；历史方法控制','complete; historical method-control')},
 {id:'7b-self',label:'7B / self',blocks:'80 / 80',attempts:'20,480',positive:'797',max:'7 / 8',updates:'0',state:'Stage-1 increment-07',status:t('完成；历史方法控制','complete; historical method-control')},
 {id:'3b-minimax',label:'3B / MiniMax',blocks:'59 / 80 + block-59 partial',attempts:'15,104 + 171 partial',positive:'38*',max:'1 / 8',updates:'0',state:'H1.46 3B bootstrap increment-07',status:t('74.58% 时由用户明确停止并 supersede','stopped and superseded by owner at 74.58%')},
 {id:'7b-minimax',label:'7B / MiniMax',blocks:'80 / 80',attempts:'20,480',positive:'592',max:'7 / 8',updates:'0',state:'H1.46 7B bootstrap increment-07',status:t('完成；历史方法控制','complete; historical method-control')},
] as const;
const checkpointLinks=[
 {label:'3B / self',href:`https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/blob/${adapterRevision}/stage1-3b-self-no-update.json`,kind:t('base / no-update pointer','base / no-update pointer')},
 {label:'7B / self',href:`https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}/stage1/7b-self/adapter`,kind:'Stage-1 increment-07 adapter'},
 {label:'3B / MiniMax',href:`https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}/stage1/3b-minimax/adapter`,kind:'MiniMax bootstrap increment-07'},
 {label:'7B / MiniMax',href:`https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}/stage1/7b-minimax/adapter`,kind:'MiniMax bootstrap increment-07'},
] as const;
const armPath=(id:string)=>p(`/research/seed-openevo/study/results/${id}-analysis/`);
---
<main class="legacy" data-testid="legacy-stage2-archive">
 <OpenEvoStage2StrategyChooser locale={locale} active="legacy" />
 <header class="legacy__hero">
  <div><p>SUPERSEDED METHOD-CONTROL · 2026-08-30</p><h1>{t('旧 Stage 2：256 窗口硬门槛','Old Stage 2: 256-window hard gate')}</h1><span>{t('这不是“OpenEVO 做不到学习”的结论，而是一个被我们错误提升为长期 Stage 2 算法的方法控制规则。结果仍有价值：它精确展示了一个过硬、局部窗口化的 success gate 如何阻断参数更新。','This is not evidence that OpenEVO cannot learn. It is a method-control rule that was mistakenly promoted into the long-term Stage-2 algorithm. The data remain useful because they show how a brittle, window-local success gate can block parameter evolution.')}</span></div>
  <aside><b>{t('为什么判定设计错误','WHY IT IS SUPERSEDED')}</b><p>{t('256 不是问题本身；问题是把“8 个不同 task × 每个至少 2 次 clean exact success”绑定到单个 256-rollout block，并禁止跨窗口积累。这样 update gate 更像在测一小段时间里的幸运密度，而不是当前模型有没有足够 grounded evidence 可以学习。','256 itself is not the core problem. The mistake was binding “8 distinct tasks × at least 2 clean exact successes each” to one 256-rollout block and forbidding evidence accumulation. The gate measures lucky local density more than whether grounded learnable evidence exists.')}</p></aside>
 </header>
 <section class="legacy__section"><p class="kicker">{t('四个历史实验','FOUR HISTORICAL ARMS')}</p><h2>{t('3B / 7B × self / MiniMax：真实完成状态','3B / 7B × self / MiniMax: actual completion state')}</h2>
  <div class="legacy__arms">{arms.map(a=><a href={armPath(a.id)}><div><span>{a.status}</span><strong>{a.label}</strong></div><dl><div><dt>blocks</dt><dd>{a.blocks}</dd></div><div><dt>rollouts</dt><dd>{a.attempts}</dd></div><div><dt>qualified positive</dt><dd>{a.positive}</dd></div><div><dt>{t('单块最好 identity','best identities')}</dt><dd>{a.max}</dd></div><div><dt>Stage-2 update</dt><dd>{a.updates}</dd></div><div><dt>{t('模型状态','model state')}</dt><dd>{a.state}</dd></div></dl><em>{t('打开这一臂的历史结果与 checkpoint 解释 →','Open this arm’s historical result and checkpoint explanation →')}</em></a>)}</div>
  <p class="legacy__note">* {t('3B/MiniMax 的 38 是 59 个完整 block 的 qualified-positive 合计；正在进行的第 60 个 block 在停止时保留 171 条 partial rollout，不把 partial 混入完整 block 统计。','For 3B/MiniMax, 38 is the qualified-positive total over 59 complete blocks. The in-progress 60th block retained 171 partial rollouts at stop time and is not mixed into complete-block statistics.')}</p>
  <div class="legacy__checkpoint-links" aria-label={t('历史模型状态链接','Historical model-state links')}>{checkpointLinks.map(x=><a href={x.href}><span>{x.label}</span><strong>{x.kind}</strong><small>{t('固定 HF revision 打开 →','Open pinned HF revision →')}</small></a>)}</div>
  <p class="legacy__note">{t(`归档固定 revision：${archiveRevision}；Stage-1 / bootstrap adapter 固定 revision：${adapterRevision}。Stage 2 没有新权重，因此这里链接的是实际进入旧 Stage 2 的模型状态，而不是伪造的“Stage-2 checkpoint”。`,`Pinned archive revision: ${archiveRevision}; pinned Stage-1/bootstrap adapter revision: ${adapterRevision}. Stage 2 created no new weights, so these links point to the actual policy states entering old Stage 2 rather than fabricated “Stage-2 checkpoints”.`)}</p>
 </section>
 <section class="legacy__section legacy__why"><div><p class="kicker">{t('从数据看错误在哪里','WHAT THE DATA EXPOSE')}</p><h2>{t('很多成功轨迹 ≠ 允许学习','Many successful trajectories did not imply permission to learn')}</h2></div><ol>
  <li><b>01</b><strong>{t('每块只看自己','Each block stood alone')}</strong><p>{t('每 256 条重算一次；上一个窗口的稀疏成功不能帮助下一个窗口。','The gate reset every 256 rollouts; sparse success from prior windows could not help later windows.')}</p></li>
  <li><b>02</b><strong>{t('门槛要求局部重复成功','The gate demanded local repeated success')}</strong><p>{t('必须同时出现至少 8 个不同 task，每个 task 在同块至少成功 2 次。','At least eight distinct tasks each had to succeed twice within the same block.')}</p></li>
  <li><b>03</b><strong>{t('四臂 Stage 2 都是 0 update','All four Stage-2 arms had zero updates')}</strong><p>{t('7B/self 有 797 条 qualified positive，7B/MiniMax 有 592 条，仍没有任何一个 block 触发更新。','7B/self had 797 qualified positives and 7B/MiniMax had 592, yet no block triggered an update.')}</p></li>
 </ol></section>
 <section class="legacy__section"><p class="kicker">ARTIFACT ARCHIVE</p><h2>{t('错误实验不删除：远端归档 + 本地 smoke 保留','Do not erase the wrong experiment: remote archive + local smoke retention')}</h2>
  <div class="legacy__links"><a href={hfArchive}><span>HF · private research archive</span><strong>superseded-stage2-archive ↗</strong><small>{t('完整旧 run root、manifest、receipt、说明','Exact old run roots, manifests, receipts, documentation')}</small></a><a href={hfAdapters}><span>HF · private model state</span><strong>Stage-1 / bootstrap adapters ↗</strong><small>{t('Stage 2 没有产生新 adapter；no-update checkpoint 用 pointer 表示','Stage 2 created no new adapters; no-update checkpoints remain pointers')}</small></a><a href={ghcr}><span>GHCR · runtime</span><strong>h144-runtime-live-d0f879601089 ↗</strong><small>sha256:d0f879…88e2850</small></a></div>
  <p class="legacy__note">{t('服务器原始 H1.45/H1.46 run root 当前继续保留；另有一份约 213 MB 的永久 local smoke kit，包含 3B/7B 可加载 adapter、四臂真实样例、selection/summary/receipt 与 exact runtime retention tag。HF 验证通过也不会自动触发删除。','The original H1.45/H1.46 run roots remain on the server. A separate ~213 MB permanent local smoke kit keeps loadable 3B/7B adapters, grounded four-arm examples, selections/summaries/receipts, and an exact-runtime retention tag. Successful HF verification does not authorize deletion.')}</p>
 </section>
</main>
<style>
.legacy{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}.legacy__hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:2rem;padding:2rem 0;border-bottom:1px solid var(--color-border)}.legacy__hero>div>p,.kicker{margin:0 0 .55rem;color:var(--color-accent);font:800 .64rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.legacy__hero h1,.legacy__section h2{margin:0;letter-spacing:-.04em}.legacy__hero h1{font-size:clamp(2rem,5vw,4rem)}.legacy__hero>div>span,.legacy__hero aside p{display:block;margin-top:.8rem;color:var(--color-text-muted);line-height:1.7}.legacy__hero aside{align-self:end;padding:1rem;border:1px dashed var(--color-border);border-radius:12px}.legacy__hero aside b{font-size:.72rem}.legacy__hero aside p{font-size:.78rem;margin-bottom:0}.legacy__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.legacy__section h2{font-size:clamp(1.4rem,3vw,2.2rem)}
.legacy__arms{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1.2rem}.legacy__arms>a{display:flex;flex-direction:column;gap:.8rem;padding:1rem;border:1px solid var(--color-border);border-radius:12px;color:var(--color-text);text-decoration:none}.legacy__arms>a:hover{border-color:var(--color-accent)}.legacy__arms a>div{display:flex;flex-direction:column;gap:.25rem}.legacy__arms span{color:var(--color-text-muted);font-size:.63rem}.legacy__arms strong{font-size:1rem}.legacy__arms dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin:0}.legacy__arms dl>div{padding:.55rem;border-radius:8px;background:color-mix(in srgb,var(--color-text) 3.5%,transparent)}.legacy__arms dt{color:var(--color-text-muted);font-size:.58rem}.legacy__arms dd{margin:.18rem 0 0;font:750 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}.legacy__arms em{margin-top:auto;color:var(--color-accent);font-size:.68rem;font-style:normal}.legacy__note{margin:1rem 0 0;color:var(--color-text-muted);font-size:.72rem;line-height:1.65}
.legacy__checkpoint-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin-top:1rem}.legacy__checkpoint-links a{display:flex;flex-direction:column;gap:.18rem;padding:.75rem;border:1px solid var(--color-border);border-radius:9px;color:var(--color-text);text-decoration:none}.legacy__checkpoint-links a:hover{border-color:var(--color-accent)}.legacy__checkpoint-links span,.legacy__checkpoint-links small{color:var(--color-text-muted);font-size:.6rem}.legacy__checkpoint-links strong{font-size:.72rem;overflow-wrap:anywhere}
.legacy__why{display:grid;grid-template-columns:minmax(200px,.65fr) minmax(0,1.35fr);gap:1.4rem}.legacy__why ol{list-style:none;margin:0;padding:0}.legacy__why li{display:grid;grid-template-columns:36px minmax(150px,.65fr) minmax(0,1.35fr);gap:.7rem;padding:.8rem 0;border-bottom:1px solid var(--color-border)}.legacy__why li b{color:var(--color-accent);font:800 .62rem ui-monospace,SFMono-Regular,Menlo,monospace}.legacy__why li strong{font-size:.78rem}.legacy__why li p{margin:0;color:var(--color-text-muted);font-size:.74rem;line-height:1.55}.legacy__links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin-top:1.1rem}.legacy__links a{display:flex;flex-direction:column;gap:.25rem;padding:.9rem;border:1px solid var(--color-border);border-radius:10px;color:var(--color-text);text-decoration:none}.legacy__links a:hover{border-color:var(--color-accent)}.legacy__links span,.legacy__links small{color:var(--color-text-muted);font-size:.62rem}.legacy__links strong{font-size:.76rem;overflow-wrap:anywhere}
@media(max-width:800px){.legacy__hero,.legacy__why,.legacy__arms,.legacy__links,.legacy__checkpoint-links{grid-template-columns:1fr}.legacy__why li{grid-template-columns:30px 1fr}.legacy__why li p{grid-column:2}}
</style>
