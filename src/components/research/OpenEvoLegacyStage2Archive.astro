---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { legacyStage2Archive, legacyStage2Arms } from '../../data/openEvoLegacyStage2Archive';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (x: string) => localePath(locale, x);
const { archiveRevision, adapterRevision } = legacyStage2Archive;
const hfArchive = `https://huggingface.co/datasets/miyuki17/openevo-webshop-superseded-stage2-archive/tree/${archiveRevision}`;
const hfArchiveHead = 'https://huggingface.co/datasets/miyuki17/openevo-webshop-superseded-stage2-archive';
const hfAdapters = `https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}`;
const ghcr = 'https://github.com/mykcs/openevo-experiment/pkgs/container/openevo-scientific';
const checkpointHref = (arm: (typeof legacyStage2Arms)[number]) =>
  `https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/${arm.checkpointPath.endsWith('.json') ? 'blob' : 'tree'}/${adapterRevision}/${arm.checkpointPath}`;
---
<main class="legacy" data-testid="legacy-stage2-archive">
  <OpenEvoStage2StrategyChooser locale={locale} active="legacy" />
  <header class="legacy__hero">
    <div>
      <p>SUPERSEDED METHOD-CONTROL · 2026-08-30</p>
      <h1>{t('历史 Stage 2：逐块硬门槛已取代，运行数据仍保留', 'Historical Stage 2: the per-block hard gate is superseded; run data is retained')}</h1>
      <span>{t('这不是“OpenEVO 做不到学习”的结论。我们把一次方法控制实验里的局部成功门槛错误提升成了长期学习规则；历史结果必须保留，但不能再代表当前 OpenEVO 的 Stage 2。', 'This is not evidence that OpenEVO cannot learn. A local success threshold from a method-control study was mistakenly promoted into a long-horizon learning rule. The historical result must be preserved, but it no longer represents current OpenEVO Stage 2.')}</span>
    </div>
    <aside>
      <b>{t('被取代的是哪条规则', 'WHICH RULE WAS SUPERSEDED')}</b>
      <p>{t('旧程序每 256 次完整任务尝试就重新检查一次：同一块里至少要有 8 个不同任务各自完整成功至少 2 次，才允许更新参数。问题在于它把这条局部方法控制门槛当成了长期学习规则；历史任务尝试、成功轨迹和模型保存点仍是有效运行证据。', 'The old program rechecked every 256 complete task attempts and allowed a parameter update only if at least eight distinct tasks each achieved two exact successes within that block. The problem was promoting this local method-control threshold into a long-horizon learning rule; the historical attempts, successful trajectories, and model states remain valid run evidence.')}</p>
    </aside>
  </header>
  <section class="legacy__section" aria-labelledby="legacy-arm-title">
    <p class="kicker">{t('选择一个历史实验', 'CHOOSE A HISTORICAL ARM')}</p>
    <h2 id="legacy-arm-title">{t('先选模型，再选有没有 MiniMax 任务后回看老师', 'Choose the model, then whether MiniMax hindsight analysis was used')}</h2>
    <p class="legacy__intro">{t('这里的“有老师”只表示 MiniMax 在一次 WebShop 任务结束后分析学生轨迹；MiniMax 从不替 Qwen 搜索或点击。没有 JavaScript 时，四个实验会全部顺序展示。', '“With a teacher” means MiniMax analyzes the student trajectory after a WebShop episode; it never searches or clicks for Qwen. Without JavaScript, all four arms remain visible in sequence.')}</p>
    <div class="legacy__selector" data-legacy-stage2-selector>
      <fieldset>
        <legend>{t('模型大小', 'Model size')}</legend>
        <div class="legacy__choice-row">
          <button type="button" data-model-choice="3b" aria-pressed="true">3B</button>
          <button type="button" data-model-choice="7b" aria-pressed="false">7B</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>{t('老师来源', 'Teacher source')}</legend>
        <div class="legacy__choice-row">
          <button type="button" data-teacher-choice="self" aria-pressed="true">{t('无外部老师（self）', 'No external teacher (self)')}</button>
          <button type="button" data-teacher-choice="minimax" aria-pressed="false">{t('MiniMax 任务后回看', 'MiniMax post-task hindsight')}</button>
        </div>
      </fieldset>
    </div>

    <div class="legacy__arm-panels" data-legacy-arm-panels>
      {legacyStage2Arms.map((arm) => (
        <article class="legacy__arm-panel" id={`legacy-${arm.id}`} data-arm-panel data-model={arm.model} data-teacher={arm.teacher}>
          <header>
            <div><span>{arm.status[locale]}</span><strong>{arm.label}</strong></div>
            <em>{arm.finalEvaluation.status === 'sealed' ? t('128 任务最终评测：已封存', '128-task final evaluation: sealed') : t('最终评测：未运行', 'Final evaluation: not run')}</em>
          </header>
          <dl class="legacy__metrics">
            <div><dt>{t('256 次任务尝试的数据块', '256-attempt blocks')}</dt><dd>{arm.blocks}</dd></div>
            <div><dt>{t('完整任务尝试', 'complete task attempts')}</dt><dd>{arm.rollouts}</dd></div>
            <div><dt>{t('可用于训练的完整成功轨迹', 'trainable exact-success trajectories')}</dt><dd>{arm.qualifiedPositives}</dd></div>
            <div><dt>{t('单个数据块里最多有多少个任务重复成功', 'most repeatedly-successful distinct tasks in one block')}</dt><dd>{arm.bestIdentity}</dd></div>
            <div><dt>{t('Stage-2 参数更新', 'Stage-2 parameter updates')}</dt><dd>{arm.stage2Updates}</dd></div>
            <div><dt>{t('进入 Stage 2 的参数状态', 'Stage-2 entry state')}</dt><dd>{arm.entryState}</dd></div>
          </dl>
          {arm.finalEvaluation.status === 'sealed' ? (
            <div class="legacy__final">
              <div><span>{t('平均任务得分 ×100', 'Mean Task Score ×100')}</span><b>{arm.finalEvaluation.taskScoreX100?.toFixed(2)}</b></div>
              <div><span>{t('完整成功', 'Exact success')}</span><b>{arm.finalEvaluation.exactSuccess}</b></div>
              <div><span>{t('技术有效轨迹', 'Valid episodes')}</span><b>{arm.finalEvaluation.validEpisodes}</b></div>
            </div>
          ) : (
            <div class="legacy__final legacy__final--not-run"><strong>{t('没有封存 final eval，不等于 0 分', 'No sealed final eval; this is not a score of zero')}</strong></div>
          )}
          <p>{arm.finalEvaluation.note[locale]}</p>
          <div class="legacy__actions">
            <a href={p(`/research/seed-openevo/study/results/${arm.resultPath}/`)}>{t('打开这一臂的完整历史结果 →', 'Open the full historical result →')}</a>
            <a href={checkpointHref(arm)}>{t('打开实际模型状态 / checkpoint pointer →', 'Open actual model state / checkpoint pointer →')}</a>
          </div>
        </article>
      ))}
    </div>
    <p class="legacy__note">{t('表里的 2 / 8、7 / 8 等写法表示：一个 256 次任务尝试的数据块里，实际有多少个不同任务达到了“各自至少完整成功 2 次”的旧条件；分母 8 是当时允许参数更新的任务数门槛，不是模型分数。', 'Values such as 2 / 8 or 7 / 8 mean how many distinct tasks in one 256-attempt block met the old requirement of at least two exact successes each; the denominator 8 is the old task-count threshold for permitting a parameter update, not a model score.')}</p>
    <p class="legacy__note">* {t('3B/MiniMax 的 38 只统计已经完整跑完的 59 个数据块；第 60 个数据块停止时已完成 171 次任务尝试，这 171 次被原样保留，但不混进完整数据块的统计。', 'For 3B/MiniMax, 38 covers only the 59 complete blocks. The 60th block retained 171 task attempts at stop time; they are preserved but not mixed into complete-block statistics.')}</p>
  </section>
  <section class="legacy__section legacy__why">
    <div><p class="kicker">{t('从数据看错误在哪里', 'WHAT THE DATA EXPOSE')}</p><h2>{t('有成功数据，却被局部门槛挡住了学习', 'Learnable successes existed, but the local gate blocked learning')}</h2></div>
    <ol>
      <li><b>01</b><strong>{t('窗口各算各的', 'Each window stood alone')}</strong><p>{t('每 256 条重新计算；前一窗口的稀疏成功不能改变下一窗口的更新资格。', 'The gate reset every 256 rollouts; sparse success from an earlier window could not change the next window’s eligibility.')}</p></li>
      <li><b>02</b><strong>{t('局部重复成功要求太强', 'Local repeated-success requirement')}</strong><p>{t('至少 8 个不同任务都要在同一窗口里各自完整成功至少 2 次。7B 两条历史臂最好都只到 7 / 8。', 'At least eight distinct tasks each had to achieve two exact successes in the same window. Both historical 7B arms peaked at only 7 / 8.')}</p></li>
      <li><b>03</b><strong>{t('成功轨迹与参数更新被错误地绑死', 'Success evidence and parameter updates were over-coupled')}</strong><p>{t('7B/self 累计 797 条、7B/MiniMax 累计 592 条合格成功轨迹，但 Stage 2 参数更新仍都是 0。这个现象证明旧 gate 很苛刻，不证明 OpenEVO 本身没有可学习数据。', '7B/self accumulated 797 and 7B/MiniMax 592 qualified positives, yet both recorded zero Stage-2 parameter updates. This demonstrates how restrictive the old gate was; it does not show that OpenEVO had no learnable evidence.')}</p></li>
    </ol>
  </section>

  <section class="legacy__section">
    <p class="kicker">CHECKPOINT SEMANTICS</p>
    <h2>{t('0 次 Stage-2 更新，就不能伪造一个“Stage-2 checkpoint”', 'Zero Stage-2 updates means there is no fabricated “Stage-2 checkpoint”')}</h2>
    <p class="legacy__intro">{t('四个历史 headline arm 的 Stage 2 都没有产生新 adapter bytes。因此链接的是“真正进入旧 Stage 2 的参数状态”：3B/self 是 base/no-update pointer，其余三条是 Stage-1 或 MiniMax bootstrap 的 increment-07 adapter。', 'None of the four historical headline arms created new adapter bytes in Stage 2. Links therefore point to the real parameter state that entered old Stage 2: a base/no-update pointer for 3B/self and the Stage-1 or MiniMax-bootstrap increment-07 adapters for the other three arms.')}</p>
    <div class="legacy__checkpoint-links">
      {legacyStage2Arms.map((arm) => (
        <a href={checkpointHref(arm)}><span>{arm.label}</span><strong>{arm.entryState}</strong><small>{t('固定 HF revision 打开 →', 'Open pinned HF revision →')}</small></a>
      ))}
    </div>
    <p class="legacy__note">{t(`Stage-1 / bootstrap adapter 固定 revision：${adapterRevision}。`, `Pinned Stage-1/bootstrap adapter revision: ${adapterRevision}.`)}</p>
  </section>
  <section class="legacy__section">
    <p class="kicker">ARTIFACT ARCHIVE</p>
    <h2>{t('完整远端归档 + 永久本地 smoke kit；上传成功也不自动删除', 'Exact remote archive + permanent local smoke kit; upload success never auto-deletes')}</h2>
    <div class="legacy__archive-facts">
      <div><b>184,168</b><span>{t('个源文件进入 SHA-256 清单', 'source files covered by SHA-256 manifest')}</span></div>
      <div><b>11.64 GB</b><span>{t('压缩前历史源文件', 'historical source bytes before compression')}</span></div>
      <div><b>3</b><span>{t('个精确 tar.gz 已做远端逐字节 / gzip 全流验证', 'exact tar.gz archives with fresh byte + full gzip verification')}</span></div>
      <div><b>213 MiB</b><span>{t('永久服务器 engineering smoke kit', 'permanent server engineering smoke kit')}</span></div>
    </div>
    <div class="legacy__links">
      <a href={hfArchive}><span>HF · immutable archive revision</span><strong>superseded-stage2-archive ↗</strong><small>{archiveRevision}</small></a>
      <a href={hfArchiveHead}><span>HF · reader warning / current README</span><strong>{t('查看“已取代实验”说明 ↗', 'Read the superseded-experiment warning ↗')}</strong><small>{t('README 可更新；历史二进制仍由固定 revision 锚定', 'README may evolve; historical bytes stay pinned by revision')}</small></a>
      <a href={hfAdapters}><span>HF · historical model states</span><strong>Stage-1 / bootstrap adapters ↗</strong><small>{adapterRevision}</small></a>
      <a href={ghcr}><span>GHCR · exact runtime</span><strong>h144-runtime-live-d0f879601089 ↗</strong><small>sha256:d0f879…88e2850</small></a>
    </div>
    <p class="legacy__note">{t('服务器两个核心 H1.45/H1.46 原始 run root 继续保留，delete_authorized=false。永久 smoke kit 共 63 个文件、约 222.8 MB，63/63 SHA-256 校验通过，包含 3 个可加载 adapter、四臂真实样例、selection / summary / execution-state、历史 receipt 与 exact runtime retention tag。', 'The two core H1.45/H1.46 raw run roots remain on the server with delete_authorized=false. The permanent smoke kit contains 63 files (~222.8 MB), passes 63/63 SHA-256 checks, and keeps three loadable adapters, grounded examples from all four arms, selection/summary/execution-state files, historical receipts, and the exact-runtime retention tag.')}</p>
  </section>
</main>

<script is:inline>
(() => {
  const root = document.querySelector('[data-legacy-stage2-selector]');
  const panels = [...document.querySelectorAll('[data-arm-panel]')];
  if (!root || !panels.length) return;
  const params = new URLSearchParams(location.search);
  let model = params.get('model') === '7b' ? '7b' : '3b';
  let teacher = params.get('teacher') === 'minimax' ? 'minimax' : 'self';
  const render = () => {
    root.querySelectorAll('[data-model-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.modelChoice === model)));
    root.querySelectorAll('[data-teacher-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.teacherChoice === teacher)));
    panels.forEach((panel) => { panel.hidden = !(panel.dataset.model === model && panel.dataset.teacher === teacher); });
    const next = new URL(location.href); next.searchParams.set('model', model); next.searchParams.set('teacher', teacher); history.replaceState(null, '', next);
  };
  root.querySelectorAll('[data-model-choice]').forEach((button) => button.addEventListener('click', () => {
    model = button.dataset.modelChoice;
    render();
  }));
  root.querySelectorAll('[data-teacher-choice]').forEach((button) => button.addEventListener('click', () => {
    teacher = button.dataset.teacherChoice;
    render();
  }));
  render();
})();
</script>
<style>
.legacy{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}
.legacy__hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:2rem;padding:2rem 0;border-bottom:1px solid var(--color-border)}
.legacy__hero>div>p,.kicker{margin:0 0 .55rem;color:var(--color-accent);font:800 .64rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}
.legacy__hero h1,.legacy__section h2{margin:0;letter-spacing:-.04em}.legacy__hero h1{font-size:clamp(2rem,5vw,4rem)}
.legacy__hero>div>span,.legacy__hero aside p,.legacy__intro{display:block;margin:.8rem 0 0;color:var(--color-text-muted);line-height:1.7}
.legacy__hero aside{align-self:end;padding:1rem;border:1px dashed var(--color-border);border-radius:12px}.legacy__hero aside b{font-size:.72rem}.legacy__hero aside p{font-size:.78rem;margin-bottom:0}
.legacy__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.legacy__section h2{font-size:clamp(1.4rem,3vw,2.2rem)}.legacy__intro{max-width:86ch;font-size:.8rem}
.legacy__selector{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1.1rem;padding:1rem;border:1px solid var(--color-border);border-radius:14px;background:color-mix(in srgb,var(--color-text) 2%,transparent)}
.legacy__selector fieldset{min-width:0;margin:0;padding:0;border:0}.legacy__selector legend{margin-bottom:.5rem;color:var(--color-text-muted);font-size:.66rem;font-weight:760}
.legacy__choice-row{display:flex;gap:.45rem;flex-wrap:wrap}.legacy__choice-row button{appearance:none;padding:.58rem .78rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-bg);color:var(--color-text);font:760 .72rem/1.2 inherit;cursor:pointer}.legacy__choice-row button[aria-pressed="true"]{border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 8%,var(--color-bg));color:var(--color-accent)}
.legacy__arm-panels{margin-top:1rem}.legacy__arm-panel{padding:1.1rem;border:1px solid var(--color-border);border-radius:14px;background:var(--color-bg)}.legacy__arm-panel[hidden]{display:none}.legacy__arm-panel>header{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.legacy__arm-panel>header>div{display:flex;flex-direction:column;gap:.25rem}.legacy__arm-panel>header span,.legacy__arm-panel>header em{color:var(--color-text-muted);font-size:.64rem;font-style:normal}.legacy__arm-panel>header strong{font-size:1.15rem}
.legacy__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:1rem 0 0}.legacy__metrics>div{padding:.65rem;border-radius:9px;background:color-mix(in srgb,var(--color-text) 3.5%,transparent)}.legacy__metrics dt{color:var(--color-text-muted);font-size:.6rem}.legacy__metrics dd{margin:.2rem 0 0;font:760 .72rem ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
.legacy__final{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin-top:.7rem;padding:.75rem;border:1px solid color-mix(in srgb,var(--color-accent) 30%,var(--color-border));border-radius:10px}.legacy__final>div{display:flex;flex-direction:column;gap:.2rem}.legacy__final span{color:var(--color-text-muted);font-size:.6rem}.legacy__final b{font:820 .9rem ui-monospace,SFMono-Regular,Menlo,monospace}.legacy__final--not-run{display:block;color:var(--color-accent);font-size:.76rem}.legacy__arm-panel>p{margin:.8rem 0 0;color:var(--color-text-muted);font-size:.75rem;line-height:1.6}
.legacy__actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:.8rem}.legacy__actions a{color:var(--color-accent);font-size:.7rem;font-weight:760;text-decoration:none}.legacy__actions a:hover{text-decoration:underline}.legacy__note{margin:1rem 0 0;color:var(--color-text-muted);font-size:.72rem;line-height:1.65}
.legacy__why{display:grid;grid-template-columns:minmax(200px,.65fr) minmax(0,1.35fr);gap:1.4rem}.legacy__why ol{list-style:none;margin:0;padding:0}.legacy__why li{display:grid;grid-template-columns:36px minmax(150px,.65fr) minmax(0,1.35fr);gap:.7rem;padding:.8rem 0;border-bottom:1px solid var(--color-border)}.legacy__why li b{color:var(--color-accent);font:800 .62rem ui-monospace,SFMono-Regular,Menlo,monospace}.legacy__why li strong{font-size:.78rem}.legacy__why li p{margin:0;color:var(--color-text-muted);font-size:.74rem;line-height:1.55}
.legacy__checkpoint-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin-top:1rem}.legacy__checkpoint-links a,.legacy__links a{display:flex;flex-direction:column;gap:.22rem;padding:.8rem;border:1px solid var(--color-border);border-radius:10px;color:var(--color-text);text-decoration:none}.legacy__checkpoint-links a:hover,.legacy__links a:hover{border-color:var(--color-accent)}.legacy__checkpoint-links span,.legacy__checkpoint-links small,.legacy__links span,.legacy__links small{color:var(--color-text-muted);font-size:.61rem}.legacy__checkpoint-links strong,.legacy__links strong{font-size:.74rem;overflow-wrap:anywhere}
.legacy__archive-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin-top:1rem}.legacy__archive-facts>div{padding:.8rem;border:1px solid var(--color-border);border-radius:10px}.legacy__archive-facts b{display:block;color:var(--color-accent);font:820 1.05rem ui-monospace,SFMono-Regular,Menlo,monospace}.legacy__archive-facts span{display:block;margin-top:.3rem;color:var(--color-text-muted);font-size:.65rem;line-height:1.45}.legacy__links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:.8rem}
@media(max-width:800px){.legacy__hero,.legacy__why,.legacy__selector,.legacy__links,.legacy__checkpoint-links{grid-template-columns:1fr}.legacy__metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.legacy__archive-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.legacy__why li{grid-template-columns:30px 1fr}.legacy__why li p{grid-column:2}.legacy__arm-panel>header{flex-direction:column}}
@media(max-width:520px){.legacy__metrics,.legacy__final,.legacy__archive-facts{grid-template-columns:1fr}}
</style>
