---
import ExternalBrandMark from '../common/ExternalBrandMark';
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { legacyStage2Archive, legacyStage2Arms } from '../../data/openEvoLegacyStage2Archive';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';
import OpenEvoLegacyStage2ResearchJourney from './OpenEvoLegacyStage2ResearchJourney.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (x: string) => localePath(locale, x);
const { archiveRevision, adapterRevision } = legacyStage2Archive;
const hfArchive = `https://huggingface.co/datasets/miyuki17/openevo-webshop-superseded-stage2-archive/tree/${archiveRevision}`;
const hfArchiveHead = 'https://huggingface.co/datasets/miyuki17/openevo-webshop-superseded-stage2-archive';
const hfAdapters = `https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}`;
const ghcr = 'https://github.com/mykcs/openevo-experiment/pkgs/container/openevo-scientific';
const checkpointHref = (arm: (typeof legacyStage2Arms)[number]) =>
  `https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/${arm.checkpointPath.endsWith('.json') ? 'blob' : 'tree'}/${adapterRevision}/${arm.checkpointPath}`;
---
<main data-copy-review class="legacy" data-testid="legacy-stage2-archive">
  <OpenEvoStage2StrategyChooser locale={locale} active="legacy" />
  <header class="legacy__hero">
    <div>
      <p>SUPERSEDED METHOD-CONTROL · 2026-08-30</p>
      <h1>{t("旧批次门槛：有成功经验，参数仍然没有更新", "Old batch gate: successful experience existed, but parameters still did not update")}</h1>
      <span data-budget-boundary>{t("这个历史 Stage 2 给每组最多 20,480 次 WebShop 任务尝试。3B/self、7B/self 和 7B/MiniMax 完成全部预算；3B/MiniMax 提前停止，完整记录与未完成批次分别保留。7B/self 收集到 797 条可以用于训练的完整成功轨迹，7B/MiniMax 也有 592 条，但两组都没有发生任何 Stage-2 参数更新。原因不是没有成功数据，而是当时把每 256 次尝试单独检查：同一批里至少要有 8 个不同任务各自成功 2 次才允许更新；最好的一批只有 7 个。", "This historical Stage 2 allowed at most 20,480 WebShop attempts per arm. 3B/self, 7B/self, and 7B/MiniMax completed that budget; 3B/MiniMax stopped early, with complete records and the unfinished batch retained separately. 7B/self collected 797 trainable exact-success trajectories and 7B/MiniMax collected 592, yet neither arm made a Stage-2 parameter update. The issue was not a lack of successful data: every 256 attempts were judged separately, and an update required at least eight distinct tasks each succeeding twice in that batch; the best batch reached seven.")}</span>
    </div>
    <aside>
      <b>{t("更新门槛的影响", "Effect of the update gate")}</b>
      <p>{t('问题不是数字 256 本身，而是“每 256 次任务尝试就把前面的成功清零，再重新判断一次”。同一批里凑不到 8 个重复成功的不同任务，模型就完全不更新参数。这样一条原本适合小实验的数据选择规则，被误当成了长期训练必须反复通过的门。', 'The problem was not the number 256 itself. The program reset the decision every 256 task attempts and discarded earlier success for the next decision. If one batch did not contain eight distinct repeatedly successful tasks, parameters did not update at all. A rule suited to a bounded study was mistakenly turned into a gate that long-running training had to pass repeatedly.')}</p>
    </aside>
  </header>
  <OpenEvoLegacyStage2ResearchJourney locale={locale} />
  <section class="legacy__section" aria-labelledby="legacy-arm-title">
    <h2 id="legacy-arm-title">{t("四组历史结果", "Four historical groups")}</h2>
    <p class="legacy__intro">{t("Qwen 独立执行搜索和点击，MiniMax 只在任务结束后分析记录。四组分别比较 3B、7B 与是否使用 MiniMax 事后分析；每组记录任务次数、成功经验、参数更新及最终测试。", "Qwen independently performs searches and clicks; MiniMax only reviews completed tasks. The four groups combine 3B or 7B with self-analysis or MiniMax feedback, recording attempts, successful experience, parameter updates, and final tests.")}</p>
    <div class="legacy__selector" data-legacy-stage2-selector>
      <fieldset>
        <legend>{t('模型大小', 'Model size')}</legend>
        <div class="legacy__choice-row">
          <button type="button" data-model-choice="3b" aria-pressed="true">3B</button>
          <button type="button" data-model-choice="7b" aria-pressed="false">7B</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>{t('老师来源', 'Teacher source')}</legend>
        <div class="legacy__choice-row">
          <button type="button" data-teacher-choice="self" aria-pressed="true">{t('无外部老师（self）', 'No external teacher (self)')}</button>
          <button type="button" data-teacher-choice="minimax" aria-pressed="false">{t('MiniMax 任务后回看', 'MiniMax post-task hindsight')}</button>
        </div>
      </fieldset>
    </div>

    <div class="legacy__arm-panels" data-legacy-arm-panels>
      {legacyStage2Arms.map((arm) => (
        <article class="legacy__arm-panel" id={`legacy-${arm.id}`} data-arm-panel data-model={arm.model} data-teacher={arm.teacher}>
          <header>
            <div><span>{arm.status[locale]}</span><strong>{arm.label}</strong></div>
            <em>{arm.finalEvaluation.status === 'sealed' ? t('128 任务最终评测：已封存', '128-task final evaluation: sealed') : t('最终评测：未运行', 'Final evaluation: not run')}</em>
          </header>
          <dl class="legacy__metrics">
            <div><dt>{t('完整批次', 'complete batches')}</dt><dd>{arm.blocks}</dd></div>
            <div><dt>{t('任务尝试', 'task attempts')}</dt><dd>{arm.rollouts}</dd></div>
            <div><dt>{t('可用于训练的完整成功轨迹', 'trainable exact-success traces')}</dt><dd>{arm.qualifiedPositives}</dd></div>
            <div><dt>{t('单批最多有多少个任务重复成功', 'best repeated-success task count in one batch')}</dt><dd>{arm.bestIdentity}</dd></div>
            <div><dt>{t('Stage 2 实际参数更新', 'actual Stage-2 parameter updates')}</dt><dd>{arm.stage2Updates}</dd></div>
            <div><dt>{t('Stage 2 开始时使用的模型参数', 'model state entering Stage 2')}</dt><dd>{arm.entryState}</dd></div>
          </dl>
          {arm.finalEvaluation.status === 'sealed' ? (
            <div class="legacy__final">
              <div><span>{t('平均任务得分 ×100', 'Mean Task Score ×100')}</span><b>{arm.finalEvaluation.taskScoreX100?.toFixed(2)}</b></div>
              <div><span>{t('完整成功', 'Exact success')}</span><b>{arm.finalEvaluation.exactSuccess}</b></div>
              <div><span>{t('技术有效轨迹', 'Valid episodes')}</span><b>{arm.finalEvaluation.validEpisodes}</b></div>
            </div>
          ) : (
            <div class="legacy__final legacy__final--not-run"><strong>{t("最终测试未运行，没有可报告的测试分数", "Final evaluation was not run; no test score is available")}</strong></div>
          )}
          <p>{arm.finalEvaluation.note[locale]}</p>
          <div class="legacy__actions">
            <a href={p(`/research/seed-openevo/study/results/${arm.resultPath}/`)}>{t("查看该组完整历史结果 →", "Open this group’s historical result →")}</a>
            <a href={checkpointHref(arm)}><ExternalBrandMark href={checkpointHref(arm)} />{t("查看实际模型保存点 →", "Open the actual saved model state →")}</a>
          </div>
        </article>
      ))}
    </div>
    <p class="legacy__note">* {t("3B/MiniMax 的 38 条可训练成功记录只统计 59 个完整批次；第 60 批停止时已完成 171 次尝试。这些记录原样保留，但不混入完整批次的统计。", "The 38 trainable successes for 3B/MiniMax cover only 59 complete batches. The final partial batch had 171 attempts at stop time; those records are preserved separately from complete-batch statistics.")}</p>
  </section>
  <section class="legacy__section legacy__why">
    <div><h2>{t("成功经验未触发训练的原因", "Why successful experience did not trigger training")}</h2></div>
    <ol>
      <li><b>01</b><strong>{t('每 256 次重新清零判断', 'The decision reset every 256 attempts')}</strong><p>{t('上一批已经积累的成功不会带到下一批继续用。模型必须在单独一批里重新证明自己。', 'Successes from the previous batch could not carry forward. The model had to re-qualify from scratch inside every batch.')}</p></li>
      <li><b>02</b><strong>{t('同一批必须同时凑齐 8 个任务', 'One batch had to contain all eight tasks')}</strong><p>{t('每个任务还要至少完整成功 2 次。7B 两组表现最好的一批都只有 7 个这样的任务，因此永远差 1 个，参数也就永远不更新。', 'Each task also had to succeed at least twice. The best batch in both 7B runs reached only seven such tasks, always one short, so parameters never updated.')}</p></li>
      <li><b>03</b><strong>{t('整段实验有很多成功，却一次都没学', 'Many successes accumulated, but the model never learned from them')}</strong><p>{t('7B/self 最终有 797 条可训练成功轨迹，7B/MiniMax 有 592 条，但 Stage 2 参数更新仍然都是 0。这正是我们后来判定旧设计不合理的核心证据。', '7B/self ended with 797 trainable exact-success traces and 7B/MiniMax with 592, yet both still recorded zero Stage-2 updates. This mismatch is the core evidence that led us to reject the old design.')}</p></li>
    </ol>
  </section>

  <section class="legacy__section">
    <h2>{t("最终保留的模型状态", "Preserved final model states")}</h2>
    <p class="legacy__intro">{t('四组历史实验在 Stage 2 都没有产生新的模型参数。因此这里链接的不是一个虚构的“Stage-2 最终模型”，而是每组真正进入 Stage 2 时使用的参数：3B/self 仍是基础模型，其余三组使用 Stage 1 结束时或 MiniMax 启动训练结束时的第 8 个保存点。', 'None of the four historical runs produced new model parameters in Stage 2. These links therefore point to the real state that entered Stage 2 rather than a fictional Stage-2 checkpoint: 3B/self remained at base, while the other three used the final Stage-1 or MiniMax-bootstrap checkpoint.')}</p>
    <div class="legacy__checkpoint-links">
      {legacyStage2Arms.map((arm) => (
        <a href={checkpointHref(arm)}><ExternalBrandMark href={checkpointHref(arm)} /><span>{arm.label}</span><strong>{arm.entryState}</strong><small>{t("查看固定版本 →", "Open the pinned version →")}</small></a>
      ))}
    </div>
    <p class="legacy__note">{t(`Stage-1 / bootstrap adapter 固定 revision：${adapterRevision}。`, `Pinned Stage-1/bootstrap adapter revision: ${adapterRevision}.`)}</p>
  </section>
  <section class="legacy__section">
    <h2>{t("购物记录、模型与运行文件", "Shopping traces, models, and runtime files")}</h2>
    <div class="legacy__archive-facts">
      <div><b>184,168</b><span>{t('个源文件进入 SHA-256 清单', 'source files covered by SHA-256 manifest')}</span></div>
      <div><b>11.64 GB</b><span>{t('压缩前历史源文件', 'historical source bytes before compression')}</span></div>
      <div><b>3</b><span>{t('个精确 tar.gz 已做远端逐字节 / gzip 全流验证', 'exact tar.gz archives with fresh byte + full gzip verification')}</span></div>
      <div><b>213 MiB</b><span>{t("用于检查运行环境的服务器工具包", "Server toolkit for checking the runtime environment")}</span></div>
    </div>
    <div class="legacy__links">
      <a href={hfArchive}><ExternalBrandMark href={hfArchive} /><span>HF · immutable archive revision</span><strong>superseded-stage2-archive ↗</strong><small>{archiveRevision}</small></a>
      <a href={hfArchiveHead}><ExternalBrandMark href={hfArchiveHead} /><span>HF · reader warning / current README</span><strong>{t('查看“已取代实验”说明 ↗', 'Read the superseded-experiment warning ↗')}</strong><small>{t('README 可更新；历史二进制仍由固定 revision 锚定', 'README may evolve; historical bytes stay pinned by revision')}</small></a>
      <a href={hfAdapters}><ExternalBrandMark href={hfAdapters} /><span>HF · historical model states</span><strong>Stage-1 / bootstrap adapters ↗</strong><small>{adapterRevision}</small></a>
      <a href={ghcr}><ExternalBrandMark href={ghcr} /><span>GHCR · exact runtime</span><strong>h144-runtime-live-d0f879601089 ↗</strong><small>sha256:d0f879…88e2850</small></a>
    </div>
    <p class="legacy__note">{t('服务器两个核心 H1.45/H1.46 原始 run root 继续保留，delete_authorized=false。永久 smoke kit 共 63 个文件、约 222.8 MB，63/63 SHA-256 校验通过，包含 3 个可加载 adapter、四臂真实样例、selection / summary / execution-state、历史 receipt 与 exact runtime retention tag。', 'The two core H1.45/H1.46 raw run roots remain on the server with delete_authorized=false. The permanent smoke kit contains 63 files (~222.8 MB), passes 63/63 SHA-256 checks, and keeps three loadable adapters, grounded examples from all four arms, selection/summary/execution-state files, historical receipts, and the exact-runtime retention tag.')}</p>
  </section>
</main>

<script is:inline>
(() => {
  const root = document.querySelector('[data-legacy-stage2-selector]');
  const panels = [...document.querySelectorAll('[data-arm-panel]')];
  if (!root || !panels.length) return;
  const params = new URLSearchParams(location.search);
  let model = params.get('model') === '7b' ? '7b' : '3b';
  let teacher = params.get('teacher') === 'minimax' ? 'minimax' : 'self';
  const render = () => {
    root.querySelectorAll('[data-model-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.modelChoice === model)));
    root.querySelectorAll('[data-teacher-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.teacherChoice === teacher)));
    panels.forEach((panel) => { panel.hidden = !(panel.dataset.model === model && panel.dataset.teacher === teacher); });
    const next = new URL(location.href); next.searchParams.set('model', model); next.searchParams.set('teacher', teacher); history.replaceState(null, '', next);
  };
  root.querySelectorAll('[data-model-choice]').forEach((button) => button.addEventListener('click', () => {
    model = button.dataset.modelChoice;
    render();
  }));
  root.querySelectorAll('[data-teacher-choice]').forEach((button) => button.addEventListener('click', () => {
    teacher = button.dataset.teacherChoice;
    render();
  }));
  render();
})();
</script>
<style>
.legacy{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}
.legacy__hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:2rem;padding:2rem 0;border-bottom:1px solid var(--color-border)}
.legacy__hero>div>p{margin:0 0 .55rem;color:var(--color-accent);font:800 1rem var(--font-mono);letter-spacing:.09em}
.legacy__hero h1,.legacy__section h2{margin:0;letter-spacing:-.04em}.legacy__hero h1{font-size:clamp(1.9rem,3.5vw,2.8rem)}
.legacy__hero>div>span,.legacy__hero aside p,.legacy__intro{display:block;margin:.8rem 0 0;color:var(--color-text-muted);line-height:1.7}
.legacy__hero aside{align-self:end;padding:1rem;border:1px dashed var(--color-border);border-radius:12px}.legacy__hero aside b{font-size:1rem}.legacy__hero aside p{font-size:1rem;margin-bottom:0}
.legacy__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.legacy__section h2{font-size:clamp(1.4rem,3vw,2.2rem)}.legacy__intro{max-width:86ch;font-size:1rem}
.legacy__selector{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1.1rem;padding:1rem;border:1px solid var(--color-border);border-radius:14px;background:color-mix(in srgb,var(--color-text) 2%,transparent)}
.legacy__selector fieldset{min-width:0;margin:0;padding:0;border:0}.legacy__selector legend{margin-bottom:.5rem;color:var(--color-text-muted);font-size:1rem;font-weight:760}
.legacy__choice-row{display:flex;gap:.45rem;flex-wrap:wrap}.legacy__choice-row button{appearance:none;padding:.58rem .78rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-bg);color:var(--color-text);font:760 1rem/1.2 inherit;cursor:pointer}.legacy__choice-row button[aria-pressed="true"]{border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 8%,var(--color-bg));color:var(--color-accent)}
.legacy__arm-panels{margin-top:1rem}.legacy__arm-panel{padding:1.1rem;border:1px solid var(--color-border);border-radius:14px;background:var(--color-bg)}.legacy__arm-panel[hidden]{display:none}.legacy__arm-panel>header{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.legacy__arm-panel>header>div{display:flex;flex-direction:column;gap:.25rem}.legacy__arm-panel>header span,.legacy__arm-panel>header em{color:var(--color-text-muted);font-size:1rem;font-style:normal}.legacy__arm-panel>header strong{font-size:1.15rem}
.legacy__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:1rem 0 0}.legacy__metrics>div{padding:.65rem;border-radius:9px;background:color-mix(in srgb,var(--color-text) 3.5%,transparent)}.legacy__metrics dt{color:var(--color-text-muted);font-size:1rem}.legacy__metrics dd{margin:.2rem 0 0;font:760 1rem var(--font-mono);overflow-wrap:anywhere}
.legacy__final{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin-top:.7rem;padding:.75rem;border:1px solid color-mix(in srgb,var(--color-accent) 30%,var(--color-border));border-radius:10px}.legacy__final>div{display:flex;flex-direction:column;gap:.2rem}.legacy__final span{color:var(--color-text-muted);font-size:1rem}.legacy__final b{font:820 1rem var(--font-mono)}.legacy__final--not-run{display:block;color:var(--color-accent);font-size:1rem}.legacy__arm-panel>p{margin:.8rem 0 0;color:var(--color-text-muted);font-size:1rem;line-height:1.6}
.legacy__actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:.8rem}.legacy__actions a{color:var(--color-accent);font-size:1rem;font-weight:760;text-decoration:none}.legacy__actions a:hover{text-decoration:underline}.legacy__note{margin:1rem 0 0;color:var(--color-text-muted);font-size:1rem;line-height:1.65}
.legacy__why{display:grid;grid-template-columns:minmax(200px,.65fr) minmax(0,1.35fr);gap:1.4rem}.legacy__why ol{list-style:none;margin:0;padding:0}.legacy__why li{display:grid;grid-template-columns:36px minmax(150px,.65fr) minmax(0,1.35fr);gap:.7rem;padding:.8rem 0;border-bottom:1px solid var(--color-border)}.legacy__why li b{color:var(--color-accent);font:800 1rem var(--font-mono)}.legacy__why li strong{font-size:1rem}.legacy__why li p{margin:0;color:var(--color-text-muted);font-size:1rem;line-height:1.55}
.legacy__checkpoint-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin-top:1rem}.legacy__checkpoint-links a,.legacy__links a{display:flex;flex-direction:column;gap:.22rem;padding:.8rem;border:1px solid var(--color-border);border-radius:10px;color:var(--color-text);text-decoration:none}.legacy__checkpoint-links a:hover,.legacy__links a:hover{border-color:var(--color-accent)}.legacy__checkpoint-links span,.legacy__checkpoint-links small,.legacy__links span,.legacy__links small{color:var(--color-text-muted);font-size:1rem}.legacy__checkpoint-links strong,.legacy__links strong{font-size:1rem;overflow-wrap:anywhere}
.legacy__archive-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin-top:1rem}.legacy__archive-facts>div{padding:.8rem;border:1px solid var(--color-border);border-radius:10px}.legacy__archive-facts b{display:block;color:var(--color-accent);font:820 1.05rem var(--font-mono)}.legacy__archive-facts span{display:block;margin-top:.3rem;color:var(--color-text-muted);font-size:1rem;line-height:1.45}.legacy__links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:.8rem}
@media(max-width:800px){.legacy__hero,.legacy__why,.legacy__selector,.legacy__links,.legacy__checkpoint-links{grid-template-columns:1fr}.legacy__metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.legacy__archive-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.legacy__why li{grid-template-columns:30px 1fr}.legacy__why li p{grid-column:2}.legacy__arm-panel>header{flex-direction:column}}
@media(max-width:520px){.legacy__metrics,.legacy__final,.legacy__archive-facts{grid-template-columns:1fr}}
</style>
