---
import { localePath, type Locale } from '../../i18n';
import SeedOpenEvoMissionHero from './SeedOpenEvoMissionHero.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const pages = [
  { label: t('实验总览', 'Experiment overview'), href: p('/research/seed-openevo/'), active: true },
  { label: t('模型', 'Model'), href: p('/research/seed-openevo/base-model/') },
  { label: t('SEED 方法', 'SEED method'), href: p('/research/seed-openevo/seed/') },
  { label: t('OpenEvo 方法', 'OpenEvo method'), href: p('/research/seed-openevo/openevo/') },
  { label: 'ALFWorld / WebShop', href: p('/research/seed-openevo/benchmarks/') },
  { label: t('比较两种更新', 'Compare updates'), href: p('/research/seed-openevo/loops/') },
  { label: t('查看结果', 'View results'), href: p('/research/seed-openevo/results/') },
];

const objects = [
  {
    index: '01',
    title: 'Qwen2.5-3B-Instruct',
    body: t('确认具体 revision、精度、推理后端、prompt 和动作格式。', 'Confirm the exact revision, precision, inference backend, prompt, and action format.'),
    href: p('/research/seed-openevo/base-model/'),
  },
  {
    index: '02',
    title: t('SEED 怎样更新模型', 'How SEED updates the model'),
    body: t('完整轨迹产生 hindsight skill，再通过 OPD 与 RL 更新 policy 参数。', 'Completed trajectories produce hindsight skills, then OPD and RL update policy parameters.'),
    href: p('/research/seed-openevo/seed/'),
  },
  {
    index: '03',
    title: t('OpenEvo 怎样更新下一次任务', 'How OpenEvo changes the next task'),
    body: t('任务结束后保存数据，生成 artifact 或 revision，并在后续任务加载。', 'After a task ends, it saves data, creates an artifact or revision, and loads it in a later task.'),
    href: p('/research/seed-openevo/openevo/'),
  },
  {
    index: '04',
    title: 'ALFWorld',
    body: t('模型根据文本观察执行多步具身任务，主要比较各任务家族成功率。', 'The model follows text observations through multi-step embodied tasks, measured mainly by success rates across task families.'),
    href: p('/research/seed-openevo/benchmarks/'),
  },
  {
    index: '05',
    title: 'WebShop',
    body: t('模型搜索商品并选择属性，比较归一化任务分数和精确成功率。', 'The model searches products and selects attributes, measured by normalized task score and exact success.'),
    href: p('/research/seed-openevo/benchmarks/'),
  },
];

const runSteps = [
  {
    index: '1',
    title: t('按论文设置复现 SEED', 'Reproduce SEED with the paper setup'),
    body: t('使用 Qwen2.5-3B-Instruct，跑通 ALFWorld 与 WebShop，并保存论文方法需要的训练与评测记录。', 'Use Qwen2.5-3B-Instruct, run ALFWorld and WebShop, and save the training and evaluation records required by the paper method.'),
    href: p('/research/seed-openevo/seed/'),
    action: t('查看 SEED 方法', 'View the SEED method'),
  },
  {
    index: '2',
    title: t('在相同条件下运行 OpenEvo', 'Run OpenEvo under the same conditions'),
    body: t('固定模型、任务、提示词、随机种子、步数和计算预算，只更换任务结束后的更新方式。', 'Fix the model, tasks, prompts, random seeds, step limits, and compute budget; change only the post-task update method.'),
    href: p('/guide/openevo-webshop-alfworld/'),
    action: t('打开运行步骤', 'Open the run steps'),
  },
  {
    index: '3',
    title: t('比较分数、轨迹和失败原因', 'Compare scores, trajectories, and failure reasons'),
    body: t('分别查看成功率、任务分数、循环、无效动作、fallback、耗时和更新文件，再决定 OpenEvo 要改什么。', 'Compare success, task score, loops, invalid actions, fallbacks, runtime, and update files before deciding what to change in OpenEvo.'),
    href: p('/research/seed-openevo/results/'),
    action: t('查看结果要求', 'View result requirements'),
  },
];

const evidence = [
  {
    title: t('环境能启动', 'Environment starts'),
    proof: t('reset、import 或搜索索引通过', 'reset, import, or search index passes'),
    limit: t('还没有证明模型执行了真实动作', 'does not yet prove a real model action'),
  },
  {
    title: t('模型执行真实动作', 'Model executes a real action'),
    proof: t('CUDA 模型产生可执行的 non-fallback action', 'the CUDA model produces an executable non-fallback action'),
    limit: t('还没有证明 SEED 或 OpenEvo 的更新生效', 'does not yet prove a SEED or OpenEvo update took effect'),
  },
  {
    title: t('更新真正生效', 'The update takes effect'),
    proof: t('SEED 参数发生更新，或 OpenEvo 的新 revision 被后续任务加载', 'SEED parameters change, or a later task loads the new OpenEvo revision'),
    limit: t('还没有证明两组结果可以公平比较', 'does not yet prove the two results are fairly comparable'),
  },
  {
    title: t('两组结果可比较', 'The two results are comparable'),
    proof: t('模型、任务、提示词、随机种子、预算和 evaluator 一致', 'model, tasks, prompts, random seeds, budget, and evaluator match'),
    limit: t('还没有证明某个 OpenEvo 改动导致提升', 'does not yet prove that an OpenEvo change caused an improvement'),
  },
  {
    title: t('改动后用相同条件重跑', 'Rerun one change under the same conditions'),
    proof: t('只改变一个 OpenEvo 载体或方法，并重复同一组实验', 'change one OpenEvo carrier or method and repeat the same experiment'),
    limit: t('可以形成范围明确、可复核的结论', 'supports a bounded, auditable conclusion'),
    strong: true,
  },
];
---
<div class="mission-page plain-mission-hub">
  <SeedOpenEvoMissionHero locale={locale} compact />

  <nav class="mission-tabs" aria-label={t('SEED 与 OpenEvo 实验页面', 'SEED and OpenEvo experiment pages')}>
    {pages.map((item) => (
      <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <section class="mission-section" id="questions">
    <div class="mission-section__heading">
      <span>01</span>
      <div><small>{t('开始前', 'Before you start')}</small><h2>{t('先确认模型、两种方法和两个环境', 'Confirm the model, both methods, and both environments')}</h2></div>
    </div>
    <div class="object-grid">
      {objects.map((item) => (
        <a href={item.href}>
          <span>{item.index}</span>
          <strong>{item.title}</strong>
          <p>{item.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mission-section" id="site-map">
    <div class="mission-section__heading">
      <span>02</span>
      <div><small>{t('运行顺序', 'Run order')}</small><h2>{t('按三个步骤完成复现和比较', 'Complete the reproduction and comparison in three steps')}</h2></div>
    </div>
    <ol class="run-step-grid">
      {runSteps.map((item) => (
        <li>
          <span>{item.index}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <a href={item.href}>{item.action} →</a>
        </li>
      ))}
    </ol>
  </section>

  <section class="mission-section" id="evidence">
    <div class="mission-section__heading">
      <span>03</span>
      <div><small>{t('保存结果', 'Save results')}</small><h2>{t('每一步保存什么，能说明什么', 'What to save at each step and what it proves')}</h2></div>
    </div>
    <ol class="evidence-grid">
      {evidence.map((item, index) => (
        <li class:list={{ strong: item.strong }}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{item.title}</strong>
          <p>{item.proof}</p>
          <small>{item.limit}</small>
        </li>
      ))}
    </ol>
  </section>
</div>

<style>
  .mission-page { width: min(1120px, calc(100% - 2rem)); margin: 1rem auto 4rem; }
  .mission-tabs { position: sticky; z-index: 12; top: .5rem; display: flex; gap: .35rem; overflow-x: auto; margin: 1rem 0 2rem; padding: .45rem; border: 1px solid var(--line); border-radius: 16px; background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(16px); }
  .mission-tabs a { flex: 0 0 auto; padding: .62rem .8rem; border-radius: 11px; color: var(--muted); font-size: .78rem; font-weight: 750; text-decoration: none; }
  .mission-tabs a:hover, .mission-tabs a:focus-visible { color: var(--text); background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .mission-tabs a[aria-current='page'] { color: var(--accent-on-fill, #fff); background: var(--accent-fill, var(--accent)); }
  .mission-section { padding: clamp(1.4rem, 3vw, 2.6rem) 0; border-top: 1px solid var(--line); scroll-margin-top: 5rem; }
  .mission-section__heading { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: .8rem; align-items: start; margin-bottom: 1.3rem; }
  .mission-section__heading > span { color: var(--accent-deep); font: 850 .8rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; padding-top: .25rem; }
  .mission-section__heading small { display: block; color: var(--muted); font-size: .72rem; font-weight: 800; letter-spacing: .04em; }
  .mission-section__heading h2 { margin: .35rem 0 0; max-width: 30ch; font-size: clamp(1.65rem, 3.2vw, 3rem); line-height: 1.08; letter-spacing: -.03em; }
  .object-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .6rem; }
  .object-grid a { min-width: 0; min-height: 190px; display: flex; flex-direction: column; padding: 1rem; border: 1px solid var(--line); border-radius: 16px; color: inherit; text-decoration: none; }
  .object-grid a:hover, .object-grid a:focus-visible { border-color: var(--accent); }
  .object-grid span { color: var(--accent-deep); font: 800 .7rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .object-grid strong { margin-top: auto; font-size: .92rem; line-height: 1.3; }
  .object-grid p { margin: .55rem 0 0; color: var(--muted); font-size: .74rem; line-height: 1.5; }
  .run-step-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .run-step-grid li { min-width: 0; display: flex; flex-direction: column; padding: 1.15rem; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .run-step-grid li > span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; color: var(--accent-on-fill, #fff); background: var(--accent-fill, var(--accent)); font-weight: 800; }
  .run-step-grid h3 { margin: 1rem 0 .55rem; font-size: 1.08rem; line-height: 1.3; }
  .run-step-grid p { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.6; }
  .run-step-grid a { margin-top: auto; padding-top: 1rem; color: var(--accent-deep); font-size: .78rem; font-weight: 750; text-decoration: none; }
  .evidence-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .55rem; margin: 0; padding: 0; list-style: none; }
  .evidence-grid li { min-width: 0; min-height: 185px; padding: .95rem; border: 1px solid var(--line); border-radius: 16px; }
  .evidence-grid li > span { color: var(--accent-deep); font: 800 .68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .evidence-grid strong { display: block; margin-top: .75rem; font-size: .86rem; line-height: 1.35; }
  .evidence-grid p { margin: .55rem 0 0; color: var(--muted); font-size: .72rem; line-height: 1.5; }
  .evidence-grid small { display: block; margin-top: .7rem; padding-top: .6rem; border-top: 1px dashed var(--line); color: var(--warning); font-size: .68rem; line-height: 1.45; }
  .evidence-grid .strong { border-color: color-mix(in srgb, var(--accent) 60%, var(--line)); background: color-mix(in srgb, var(--accent) 7%, transparent); }
  @media (max-width: 1020px) { .object-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .evidence-grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .mission-page { width: min(100% - 1rem, 1120px); } .mission-section__heading { grid-template-columns: 2.4rem minmax(0, 1fr); } .object-grid, .run-step-grid { grid-template-columns: 1fr; } .object-grid a { min-height: 145px; } }
</style>
