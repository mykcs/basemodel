---
import { localePath, type Locale } from '../../i18n';
import SeedOpenEvoMissionHero from './SeedOpenEvoMissionHero.astro';
import SeedOpenEvoTrainingDesignOverview from './SeedOpenEvoTrainingDesignOverview.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const objectGroups = [
  {
    label: t('模型', 'Model'),
    items: [
      { title:'Qwen2.5-3B-Instruct', body:t('固定同一版模型参数（checkpoint，也就是模型参数快照）、数值精度和运行设置。','Pin the same model-parameter snapshot (checkpoint), numerical precision, and runtime settings.'), href:p('/models/qwen2-5-3b-instruct/#experiment-setup') },
    ],
  },
  {
    label: t('学习方法', 'Learning methods'),
    items: [
      { title:'SEED', body:t('把任务后的成功经验整理成技能，再通过后续参数优化更新模型；具体优化方法留到 SEED 方法页。','Turns successful hindsight experience into skills, then updates the model through later parameter optimization; the SEED method page explains the specific optimizer.'), href:p('/research/seed-openevo/flow/seed/') },
      { title:'OpenEvo', body:t('先封存任务证据；后续持续学习阶段（Stage 2）会分别更新文字记忆、可复用技能、行为规则和 LoRA（少量适配参数），通过既定检查的新版本才进入下一批任务。','Seals task evidence first; later continual learning (Stage 2) separately updates written memory, reusable skills, behavior rules, and LoRA adapter parameters, and only versions that pass the frozen checks enter the next task batch.'), href:p('/research/seed-openevo/flow/openevo/') },
    ],
  },
  {
    label: t('任务环境', 'Task environments'),
    items: [
      { title:'ALFWorld', body:t('文本形式的具身任务，主要看任务是否完成。','Text-based embodied tasks evaluated primarily by task completion.'), href:p('/research/seed-openevo/flow/alfworld/') },
      { title:'WebShop', body:t('网页购物任务，同时看完成度分数和是否完整成功。','Web-shopping tasks measured by both progress score and exact success.'), href:p('/research/seed-openevo/flow/webshop/') },
    ],
  },
];
---
<div class="mission-page plain-mission-hub">
  <SeedOpenEvoMissionHero locale={locale} compact />

  <section class="mission-section" id="questions" aria-labelledby="research-objects-title">
    <div class="mission-section__heading"><span>01</span><strong id="research-objects-title">{t('研究对象', 'Research objects')}</strong></div>
    <p class="section-intro">{t('这项研究固定一个模型，对比两种学习方法，并在两个任务环境里测量它们。','This study pins one model, compares two learning methods, and measures them in two task environments.')}</p>
    <dl class="object-map">
      {objectGroups.map((group)=><div class="object-map__row"><dt>{group.label}</dt><dd>{group.items.map((item)=><a href={item.href}><strong>{item.title}</strong><span>{item.body}</span></a>)}</dd></div>)}
    </dl>
  </section>

  <section class="mission-section" id="training-design" aria-labelledby="training-design-title">
    <div class="mission-section__heading"><span>02</span><h2 id="training-design-title">{t('训练设计', 'Training design')}</h2></div>
    <p class="section-intro">{t('下面用 WebShop 展开两阶段。第一阶段（Stage 1）是做题与事后复盘：Qwen 自己完成购物任务，任务结束后 MiniMax（外部复盘模型）只回看已保存轨迹，不替 Qwen 选动作。第二阶段（Stage 2）才是持续学习：它用这些轨迹和复盘去更新后续状态。外部模型不能在做题过程中替 Qwen 选动作；这六步只说明 WebShop，不自动代表 ALFWorld 使用同一交互流程。', 'The WebShop example has two stages. Stage 1 is task execution and post-task review: Qwen completes the shopping task itself, and only after the task ends does MiniMax, an external review model, inspect the saved trace without choosing actions for Qwen. Stage 2 is continual learning, which uses those traces and reviews to update later state. The external model never chooses actions during the task, and this six-step example describes WebShop only.')}</p>
    <SeedOpenEvoTrainingDesignOverview locale={locale} />
  </section>

  <section class="mission-section" id="site-map">
    <div class="mission-section__heading"><span>03</span><h2>{t('实验路线', 'Experiment route')}</h2></div>
    <ol class="run-step-grid">
      <li><span>1</span><h3>{t('对齐 SEED 的实验条件', 'Align SEED conditions')}</h3><p>{t('固定模型、ALFWorld / WebShop 环境和评测条件，避免把“方法差异”和“实验设置差异”混在一起。','Pin the model, ALFWorld / WebShop environments, and evaluation conditions so method differences are not confused with setup differences.')}</p><a href={p('/research/seed-openevo/flow/seed/')}>{t('SEED 方法','SEED method')} →</a></li>
      <li><span>2</span><h3>{t('运行 OpenEvo', 'Run OpenEvo')}</h3><p>{t('正式科学状态以 openevo-experiment 为准；旧的 RTX6 路线保留为历史证据，不代表现在的运行状态。','Current formal scientific state is governed by openevo-experiment; the RTX6 path is retained as historical evidence, not live state.')}</p><a href={p('/research/seed-openevo/study/run/')}>{t('实验指南','Experiment guide')} →</a></li>
      <li><span>3</span><h3>{t('比较结果与失败原因', 'Compare results and failures')}</h3><p>{t('比较任务分数、完整成功、交互轨迹和失败模式，再检查 LoRA 等参数更新状态，决定下一轮真正能改变结论的实验。','Compare scores, exact success, trajectories, failure modes, and LoRA and other parameter-update state before choosing the next experiment that can change the conclusion.')}</p><a href={p('/research/seed-openevo/study/results/')}>{t('研究结果','Research findings')} →</a></li>
    </ol>
  </section>

  <section class="mission-section" id="evidence">
    <div class="mission-section__heading"><span>04</span><h2>{t('每轮实验要留下什么证据', 'Evidence requirements')}</h2></div>
    <p class="section-intro">{t('实验跑完不代表结论就可信。四类记录分别证明环境真的运行、模型是否更新、任务结果发生了什么，以及这一轮实验到底是哪一轮。','A completed run is not automatically a trustworthy scientific result. Four evidence groups show that the environment ran, whether the model changed, what happened on the tasks, and which run produced the evidence.')}</p>
    <ol class="evidence-grid">
      <li><span>01</span><strong>{t('环境与模型', 'Environment and model')}</strong><p>{t('真实环境重新开始一题（reset）、真实 CUDA 计算，以及明确的模型版本号（revision）。','A real environment reset, real CUDA execution, and a pinned model revision.')}</p></li>
      <li><span>02</span><strong>{t('更新状态', 'Update state')}</strong><p>{t('参数指纹（digest，用来核对参数有没有变化）、LoRA 适配器、任务后生成的演化文件或后继模型版本，用于证明模型究竟有没有被更新。','Parameter digests, LoRA adapters, post-task evolution files, or successor model revisions that show whether the model was actually updated.')}</p></li>
      <li><span>03</span><strong>{t('任务结果', 'Task outcomes')}</strong><p>{t('任务分数（score）、是否成功（success）、交互步数（steps）、无法执行时的备用动作（fallback）和结束原因（termination）。','Task score, success, interaction steps, fallback actions when output cannot execute, and termination reason.')}</p></li>
      <li><span>04</span><strong>{t('实验身份', 'Experiment identity')}</strong><p>{t('运行清单（Run Manifest，记录模型、代码、配置和任务集合）与代码提交 SHA，用于准确重建“到底跑了什么”。','The Run Manifest records the model, code, configuration, and task set; together with the code commit SHA it reconstructs exactly what was run.')}</p></li>
    </ol>
  </section>
</div>

<style>
  .mission-page{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem}
  .mission-section{padding:clamp(1.8rem,4vw,3rem) 0;border-top:1px solid var(--line)}
  .plain-mission-hub>.mission-section:first-of-type{padding-top:1rem}
  .mission-section__heading{display:grid;grid-template-columns:2.4rem minmax(0,1fr);gap:.65rem;margin-bottom:.55rem}
  .mission-section__heading>span{color:var(--accent-deep);font:800 .72rem/1.4 var(--font-mono)}
  .mission-section__heading h2{margin:0}
  .mission-section__heading>strong{display:block;font-size:1.05rem;line-height:1.3;letter-spacing:-.01em}
  .section-intro{max-width:72ch;margin:0 0 1.25rem 3.05rem;color:var(--muted);font-size:.9rem;line-height:1.65}
  .object-map{margin:0;padding:0;border-bottom:1px solid var(--line)}
  .object-map__row{display:grid;grid-template-columns:minmax(7.5rem,10rem) minmax(0,1fr);gap:1.25rem;padding:1rem 0;border-top:1px solid var(--line)}
  .object-map__row dt{color:var(--muted);font-size:.76rem;font-weight:760;line-height:1.5}
  .object-map__row dd{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0}
  .object-map__row:first-child dd{grid-template-columns:1fr}
  .object-map__row a{display:grid;grid-template-columns:minmax(8.5rem,auto) minmax(0,1fr);gap:.9rem;align-items:start;padding:0 1rem;color:inherit;text-decoration:none}
  .object-map__row a:first-child{padding-left:0}
  .object-map__row a+a{border-left:1px solid var(--line)}
  .object-map__row strong{font-size:.95rem;line-height:1.45}
  .object-map__row a>span{color:var(--muted);font-size:.8rem;line-height:1.55}
  .object-map__row a:hover strong,.object-map__row a:focus-visible strong{color:var(--accent-deep)}
  .run-step-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:0;padding:0;border-block:1px solid var(--line);list-style:none}
  .run-step-grid li{position:relative;display:flex;min-width:0;flex-direction:column;padding:1.1rem 1.35rem 1.1rem 0}
  .run-step-grid li+li{padding-left:1.35rem;border-left:1px solid var(--line)}
  .run-step-grid li:not(:last-child)::after{content:'→';position:absolute;top:1.05rem;right:-.48rem;z-index:1;padding:0 .2rem;color:var(--muted);background:var(--canvas)}
  .run-step-grid li>span{color:var(--accent-deep);font:800 .72rem/1.4 var(--font-mono)}
  .run-step-grid h3{margin:.55rem 0 .4rem;font-size:1rem}
  .run-step-grid p{margin:0;color:var(--muted);font-size:.8rem;line-height:1.6}
  .run-step-grid a{margin-top:auto;padding-top:.85rem;font-size:.78rem;font-weight:750}
  .evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0;padding:0;border-top:1px solid var(--line);list-style:none}
  .evidence-grid li{padding:1rem 1.25rem 1rem 0;border-bottom:1px solid var(--line)}
  .evidence-grid li:nth-child(even){padding-left:1.25rem;border-left:1px solid var(--line)}
  .evidence-grid li>span{color:var(--accent-deep);font:800 .68rem/1 var(--font-mono)}
  .evidence-grid strong{display:block;margin-top:.55rem}
  .evidence-grid p{margin:.4rem 0 0;color:var(--muted);font-size:.8rem;line-height:1.55}
  @media(max-width:760px){
    .mission-page{width:min(100% - 1rem,1120px)}
    .section-intro{margin-left:0}
    .object-map__row{grid-template-columns:1fr;gap:.6rem}
    .object-map__row dd,.object-map__row:first-child dd{grid-template-columns:1fr}
    .object-map__row a{grid-template-columns:1fr;gap:.25rem;padding:.8rem 0}
    .object-map__row a+a{border-left:0;border-top:1px solid var(--line)}
    .run-step-grid{grid-template-columns:1fr}
    .run-step-grid li,.run-step-grid li+li{padding:1rem 0;border-left:0;border-bottom:1px solid var(--line)}
    .run-step-grid li:last-child{border-bottom:0}
    .run-step-grid li:not(:last-child)::after{content:'↓';top:auto;right:auto;bottom:-.55rem;left:.25rem;background:var(--canvas)}
    .evidence-grid{grid-template-columns:1fr}
    .evidence-grid li,.evidence-grid li:nth-child(even){padding:1rem 0;border-left:0}
  }
</style>
