---
import "../../styles/research-article.css";
import { localePath, type Locale } from '../../i18n';
import SeedOpenEvoMissionHero from './SeedOpenEvoMissionHero.astro';
import SeedOpenEvoTrainingDesignOverview from './SeedOpenEvoTrainingDesignOverview.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const objectGroups = [
  {
    label: t('模型', 'Model'),
    items: [
      { title:'Qwen2.5-3B-Instruct', body:t('固定同一版模型参数（checkpoint，也就是模型参数快照）、数值精度和运行设置。','Pin the same model-parameter snapshot (checkpoint), numerical precision, and runtime settings.') },
    ],
  },
  {
    label: t('学习方法', 'Learning methods'),
    items: [
      { title:'SEED', body:t('Stage 1 用外部教师提供事后技能，做三轮 SFT；Stage 2 由当前策略自行复盘，用 GRPO + OPD 持续更新参数。','Stage 1 uses an external teacher to produce hindsight skills and performs three-epoch SFT. In Stage 2, the current policy self-reviews and updates parameters with GRPO + OPD.'), href:p('/research/seed-openevo/flow/seed/') },
      { title:'OpenEVO', body:t('Stage 1 用外部教师分析完整轨迹并进行初始参数蒸馏；Stage 2 用内部任务反馈继续更新参数和可复用经验，通过准入检查后才进入下一轮。','Stage 1 uses an external teacher to analyze full trajectories and distill initial parameters. Stage 2 uses internal feedback to update parameters and reusable experience, admitting changes only after checks.'), href:p('/research/seed-openevo/flow/openevo/') },
    ],
  },
  {
    label: t('任务环境', 'Task environments'),
    items: [
      { title:'ALFWorld', body:t('文本形式的具身任务，主要看任务是否完成。','Text-based embodied tasks evaluated primarily by task completion.'), href:p('/research/seed-openevo/flow/alfworld/') },
      { title:'WebShop', body:t('网页购物任务，同时看完成度分数和是否完整成功。','Web-shopping tasks measured by both progress score and exact success.'), href:p('/research/seed-openevo/flow/webshop/') },
    ],
  },
];
---
<div class="mission-page plain-mission-hub evo-approved-reader evo-reading-overview">
  <SeedOpenEvoMissionHero locale={locale} compact />

  <section class="mission-section" id="training-design" aria-labelledby="training-design-title">
    <div class="mission-section__heading"><h2 id="training-design-title"><span class="evo-article__heading-number" aria-hidden="true">01</span> {t('SEED × OpenEVO 两阶段学习范式', 'SEED × OpenEVO two-stage learning paradigm')}</h2></div>
    <p class="section-intro">{t('左边是 SEED，右边是 OpenEVO；每一行都在回答同一个问题。第一阶段都采集 WebShop 轨迹、请外部高能力教师模型 API 事后分析并训练初始参数；第二阶段都从新任务中获取反馈，但各自构造学习信号、更新状态的机制不同。此处只比较 WebShop 方法，不把它自动推广到 ALFWorld。', 'SEED is on the left and OpenEVO on the right; each row answers the same question. In Stage 1, both collect WebShop trajectories, use an external high-capability teacher-model API after task completion, and train initial parameters. In Stage 2, both learn from new task feedback, but construct signals and update state differently. This is a WebShop method comparison, not an automatic description of ALFWorld.')}</p>
    <SeedOpenEvoTrainingDesignOverview locale={locale} />
  </section>

  <section class="mission-section" id="questions" aria-labelledby="research-objects-title">
    <div class="mission-section__heading"><h2 id="research-objects-title"><span class="evo-article__heading-number" aria-hidden="true">02</span> {t('模型、任务与比较范围', 'Models, tasks, and comparison scope')}</h2></div>
    <p class="section-intro">{t('完整系统比较先固定模型、任务和评分；只有要单独归因到第二阶段学习器时，才进一步要求两边共享第一阶段证据与同一个起点。','A full-system comparison first pins the model, tasks, and scoring. Only Stage-2 attribution additionally requires shared Stage-1 evidence and the same starting state.')}</p>
    <dl class="object-map">
      {objectGroups.map((group)=><div class="object-map__row"><dt>{group.label}</dt><dd>{group.items.map((item)=>'href' in item ? <a href={item.href}><strong>{item.title}</strong><span>{item.body}</span></a> : <div class="object-map__fact"><strong>{item.title}</strong><span>{item.body}</span></div>)}</dd></div>)}
    </dl>
  </section>

  <section class="mission-section" id="site-map">
    <div class="mission-section__heading"><h2><span class="evo-article__heading-number" aria-hidden="true">03</span> {t('实验运行与结果比较', 'Experiment execution and result comparison')}</h2></div>
    <ol class="run-step-grid">
      <li><h3 id={t('对齐-seed-的实验条件','align-seed-conditions')}><span class="evo-article__heading-number" aria-hidden="true">1</span> {t('对齐 SEED 的实验条件', 'Align SEED conditions')}</h3><p>{t('固定模型、ALFWorld / WebShop 环境和评测条件，避免把“方法差异”和“实验设置差异”混在一起。','Pin the model, ALFWorld / WebShop environments, and evaluation conditions so method differences are not confused with setup differences.')}</p><a href={p('/research/seed-openevo/flow/seed/')}>{t('SEED 方法','SEED method')} →</a></li>
      <li><h3 id={t('运行-openevo','run-openevo')}><span class="evo-article__heading-number" aria-hidden="true">2</span> {t('运行 OpenEvo', 'Run OpenEvo')}</h3><p>{t('正式科学状态以 openevo-experiment 为准；旧的 RTX6 路线保留为历史证据，不代表现在的运行状态。','Current formal scientific state is governed by openevo-experiment; the RTX6 path is retained as historical evidence, not live state.')}</p><a href={p('/research/seed-openevo/study/run/')}>{t('实验指南','Experiment guide')} →</a></li>
      <li><h3 id={t('比较结果与失败原因','compare-results-and-failures')}><span class="evo-article__heading-number" aria-hidden="true">3</span> {t('比较结果与失败原因', 'Compare results and failures')}</h3><p>{t('比较任务分数、完整成功、交互轨迹和失败模式，再检查 LoRA（只训练少量适配参数的方法）等参数更新状态，决定下一轮真正能改变结论的实验。','Compare scores, exact success, trajectories, failure modes, and LoRA and other parameter-update state before choosing the next experiment that can change the conclusion.')}</p><a href={p('/research/seed-openevo/study/results/')}>{t('研究结果','Research findings')} →</a></li>
    </ol>
  </section>

  <section class="mission-section" id="evidence">
    <div class="mission-section__heading"><h2><span class="evo-article__heading-number" aria-hidden="true">04</span> {t('每轮都要留下可重建的证据', 'Every run must leave reconstructable evidence')}</h2></div>
    <p class="section-intro">{t('实验跑完不代表结论就可信。四类记录分别证明环境真的运行、模型是否更新、任务结果发生了什么，以及这一轮实验到底是哪一轮。','A completed run is not automatically a trustworthy scientific result. Four evidence groups show that the environment ran, whether the model changed, what happened on the tasks, and which run produced the evidence.')}</p>
    <ol class="evidence-grid">
      <li><span>01</span><strong>{t('环境与模型', 'Environment and model')}</strong><p>{t('真实环境重新开始一题（reset）、真实 CUDA 计算，以及明确的模型版本号（revision，也就是本次实验固定的模型版本）。','A real environment reset, real CUDA execution, and a pinned model revision.')}</p></li>
      <li><span>02</span><strong>{t('更新状态', 'Update state')}</strong><p>{t('参数指纹（digest，用来核对参数有没有变化）、LoRA（少量参数适配）适配器、任务后生成的演化文件或后继模型版本，用于证明模型究竟有没有被更新。','Parameter digests, LoRA adapters, post-task evolution files, or successor model revisions that show whether the model was actually updated.')}</p></li>
      <li><span>03</span><strong>{t('任务结果', 'Task outcomes')}</strong><p>{t('任务分数（score）、是否成功（success）、交互步数（steps）、无法执行时的备用动作（fallback）和结束原因（termination）。','Task score, success, interaction steps, fallback actions when output cannot execute, and termination reason.')}</p></li>
      <li><span>04</span><strong>{t('实验身份', 'Experiment identity')}</strong><p>{t('运行清单（Run Manifest，记录模型、代码、配置和任务集合）与代码提交 SHA，用于准确重建“到底跑了什么”。','The Run Manifest records the model, code, configuration, and task set; together with the code commit SHA it reconstructs exactly what was run.')}</p></li>
    </ol>
    <p class="evidence-model-link"><a href={p('/models/qwen2-5-3b-instruct/#experiment-setup')}>{t('查看固定模型的实验设置', 'View the pinned model setup')} →</a></p>
  </section>
</div>

<style>
  .mission-page{}
  .mission-section{padding:clamp(1.8rem,4vw,3rem) 0;border-top:1px solid var(--line)}
  .plain-mission-hub>.mission-section:first-of-type{padding-top:1rem}
  .mission-section__heading{display:grid;grid-template-columns:minmax(0,1fr);gap:.65rem;margin-bottom:.55rem}
  .mission-section__heading>span{color:var(--accent-deep);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-heading) var(--font-interface)}
  .mission-section__heading h2{margin:0}
  .mission-section__heading>strong{display:block;font-size:var(--type-section);line-height:var(--type-leading-heading);letter-spacing:normal}
  .section-intro{max-width:72ch;margin:0 0 1.25rem;color:var(--muted);font-size:var(--article-body-size, .9rem);line-height:var(--article-body-leading, 1.65)}
  .object-map{margin:0;padding:0;border-bottom:1px solid var(--line)}
  .object-map__row{display:grid;grid-template-columns:minmax(7.5rem,10rem) minmax(0,1fr);gap:1.25rem;padding:1rem 0;border-top:1px solid var(--line)}
  .object-map__row dt{color:var(--muted);font-size:var(--type-meta);font-family:var(--font-interface);font-weight:var(--type-weight-label);line-height:var(--type-leading-caption)}
  .object-map__row dd{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0}
  .object-map__row:first-child dd{grid-template-columns:1fr}
  .object-map__row a,.object-map__fact{display:grid;grid-template-columns:minmax(8.5rem,auto) minmax(0,1fr);gap:.9rem;align-items:start;padding:0 1rem;color:inherit;text-decoration:none}
  .object-map__row a:first-child,.object-map__fact:first-child{padding-left:0}
  .object-map__row a+a{border-left:1px solid var(--line)}
  .object-map__row strong{font-size:var(--type-minor-heading);line-height:var(--type-leading-heading)}
  .object-map__row a>span,.object-map__fact>span{color:var(--muted);font-size:var(--type-body-small);font-family:var(--font-interface);line-height:var(--type-leading-body)}
  .object-map__row a:hover strong,.object-map__row a:focus-visible strong{color:var(--accent-deep)}
  .run-step-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:0;padding:0;border-block:1px solid var(--line);list-style:none}
  .run-step-grid li{position:relative;display:flex;min-width:0;flex-direction:column;padding:1.1rem 1.35rem 1.1rem 0}
  .run-step-grid li+li{padding-left:1.35rem;border-left:1px solid var(--line)}
  .run-step-grid li:not(:last-child)::after{content:'→';position:absolute;top:1.05rem;right:-.48rem;z-index:1;padding:0 .2rem;color:var(--muted);background:var(--bg)}
  .run-step-grid li>span{color:var(--accent-deep);font:var(--type-weight-label) var(--type-meta)/1.4 var(--font-interface)}
  .run-step-grid h3{margin:.55rem 0 .4rem;font-size:var(--article-subsection-size, 1rem)}
  .run-step-grid p{margin:0;color:var(--muted);font-size:var(--article-body-size, .8rem);line-height:var(--article-body-leading, 1.6)}
  .run-step-grid a{margin-top:auto;padding-top:.85rem;font-size:var(--type-meta);font-weight:var(--type-weight-heading)}
  .evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0;padding:0;border-top:1px solid var(--line);list-style:none}
  .evidence-grid li{padding:1rem 1.25rem 1rem 0;border-bottom:1px solid var(--line)}
  .evidence-grid li:nth-child(even){padding-left:1.25rem;border-left:1px solid var(--line)}
  .evidence-grid li>span{color:var(--accent-deep);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-heading) var(--font-interface)}
  .evidence-grid strong{display:block;margin-top:.55rem}
  .evidence-grid p{margin:.4rem 0 0;color:var(--muted);font-size:var(--article-body-size, .8rem);line-height:var(--article-body-leading, 1.55)}
  .evidence-model-link{margin:.85rem 0 0;font-size:var(--type-meta)}.evidence-model-link a{color:var(--accent-deep);font-weight:var(--type-weight-heading);text-underline-offset:.2em}
  @media(max-width:760px){
    .mission-page{}
    .section-intro{margin-left:0}
    .object-map__row{grid-template-columns:1fr;gap:.6rem}
    .object-map__row dd,.object-map__row:first-child dd{grid-template-columns:1fr}
    .object-map__row a,.object-map__fact{grid-template-columns:1fr;gap:.25rem;padding:.8rem 0}
    .object-map__row a+a{border-left:0;border-top:1px solid var(--line)}
    .run-step-grid{grid-template-columns:1fr}
    .run-step-grid li,.run-step-grid li+li{padding:1rem 0;border-left:0;border-bottom:1px solid var(--line)}
    .run-step-grid li:last-child{border-bottom:0}
    .run-step-grid li:not(:last-child)::after{content:'↓';top:auto;right:auto;bottom:-.55rem;left:.25rem;background:var(--bg)}
    .evidence-grid{grid-template-columns:1fr}
    .evidence-grid li,.evidence-grid li:nth-child(even){padding:1rem 0;border-left:0}
  }
@container reading-overview (max-width:900px){
  .object-map__row dd{grid-template-columns:1fr}
  .object-map__row a,.object-map__fact{grid-template-columns:1fr;gap:.25rem;padding:.8rem 0}
  .object-map__row a+a{border-left:0;border-top:1px solid var(--line)}
}
</style>
