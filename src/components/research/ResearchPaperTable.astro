---
import type { HTMLAttributes } from 'astro/types';
import '../../styles/research-booktabs.css';
import { preparePaperTable, paperTableText } from '../../lib/researchPaperTable';

interface Props extends HTMLAttributes<'table'> { presentation?: boolean }
const { class: tableClass, presentation = false, ...attributes } = Astro.props;
let contents = await Astro.slots.render('default');
const captionSlot = await Astro.slots.render('caption');
contents = preparePaperTable(contents);
const hasCaption = /<caption\b/.test(contents);
const label = paperTableText(hasCaption ? contents.match(/<caption\b[^>]*>([\s\S]*?)<\/caption>/)?.[1] ?? '' : captionSlot);
---
<div class:list={['research-booktabs-wrap', presentation && 'research-booktabs-wrap--presentation']} role="region" tabindex="0" aria-label={label || undefined} data-paper-table-scroll>
  <table {...attributes} class:list={['research-booktabs', tableClass]} data-research-paper-table>
    {!hasCaption && <caption><Fragment set:html={captionSlot} /></caption>}
    <Fragment set:html={contents} />
  </table>
</div>
