---
/**
 * Static, print-friendly dot–whisker figure for source-bound paired estimates.
 * Zero is always the unchanged-condition reference; no generated observations.
 */
interface Effect { id: string; label: string; estimate: number; low: number; high: number }
interface Props {
  id: string;
  title: string;
  unit: string;
  min: number;
  max: number;
  ticks: number[];
  effects: ReadonlyArray<Effect>;
  caption: string;
}
const { id, title, unit, min, max, ticks, effects, caption } = Astro.props;
if (!(min < 0 && max > 0 && min < max) || effects.length===0 ||
  effects.some(e => !Number.isFinite(e.estimate) || !Number.isFinite(e.low) || !Number.isFinite(e.high) ||
    e.low > e.estimate || e.estimate > e.high || e.low < min || e.high > max)) {
  throw new Error('PaperIntervalPlot needs real ordered confidence intervals and a zero reference');
}
const at = (n: number) => ((n-min)/(max-min)*100);
const fmt = (n: number) => (n > 0 ? '+' : '') + n.toFixed(2).replace('-', '−');
const ariaText = effects.map(e => `${e.label}: ${fmt(e.estimate)}, 95% CI [${fmt(e.low)}, ${fmt(e.high)}] ${unit}`).join('; ');
---
<figure class="paper-effect" data-paper-effect={id} data-paper-figure="interval">
  <h4 class="paper-effect__title">{title}</h4>
  <div class="paper-effect__plot" role="img" aria-label={`${title}；${ariaText}；竖虚线为零差异`}>
    {effects.map((e) => (
      <div class="paper-effect__row" data-effect-row={e.id}>
        <span class="paper-effect__label">{e.label}</span>
        <div class="paper-effect__track" aria-hidden="true">
          <i class="paper-effect__zero" style={`left:${at(0)}%`}></i>
          <i class="paper-effect__whisker" style={`left:${at(e.low)}%;width:${at(e.high)-at(e.low)}%`}></i>
          <i class="paper-effect__start" style={`left:${at(e.low)}%`}></i>
          <i class="paper-effect__end" style={`left:${at(e.high)}%`}></i>
          <i class="paper-effect__dot" style={`left:${at(e.estimate)}%`}></i>
        </div>
        <span class="paper-effect__value">{fmt(e.estimate)} <small>[{fmt(e.low)}, {fmt(e.high)}]</small></span>
      </div>
    ))}
    <div class="paper-effect__row paper-effect__axis-row" aria-hidden="true">
      <span></span>
      <div class="paper-effect__axis">
        {ticks.map(tick => <span style={`left:${at(tick)}%`}>{tick}</span>)}
      </div>
      <span></span>
    </div>
  </div>
  <p class="paper-effect__unit">{unit} · 圆点表示两种条件在相同题目上的平均差值；横线表示 95% 置信区间；虚线表示差值为零</p>
  <figcaption>{caption}</figcaption>
</figure>

<style>
.paper-effect{max-width:890px;margin:1.15rem 0 1.55rem;padding:.85rem 0 1rem;border-block:1px solid var(--paper-line,var(--color-border))}
.paper-effect__title{font-family:Georgia,"Noto Serif SC","Songti SC",serif;font-size:1.03em;line-height:1.45;font-weight:650;margin:.1rem 0 1rem}
.paper-effect__plot{display:grid;gap:.45rem}
.paper-effect__row{display:grid;grid-template-columns:minmax(9.5rem,1.12fr) minmax(13rem,1.9fr) minmax(10rem,1.12fr);align-items:center;gap:.72rem;min-height:2.25rem}
.paper-effect__label{font-size:.88em;line-height:1.45;overflow-wrap:anywhere}
.paper-effect__track{height:2rem;position:relative;border-bottom:1px solid color-mix(in srgb,var(--paper-ink,currentColor) 32%,transparent)}
.paper-effect__track i{position:absolute;display:block}
.paper-effect__zero{top:0;bottom:0;border-left:1px dashed var(--paper-muted,currentColor);opacity:.8}
.paper-effect__whisker{top:1.02rem;height:1.5px;background:var(--paper-ink,currentColor)}
.paper-effect__start,.paper-effect__end{top:.69rem;height:.68rem;border-left:1.5px solid var(--paper-ink,currentColor)}
.paper-effect__dot{top:.67rem;width:.73rem;height:.73rem;border:2px solid var(--paper-ink,currentColor);background:var(--paper,var(--color-surface,#fff));border-radius:50%;transform:translateX(-50%)}
.paper-effect__value{font-family:Georgia,"Songti SC",serif;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;font-size:.9em}
.paper-effect__value small{display:block;font-family:inherit;font-size:.8em;color:var(--paper-muted,var(--color-text-muted));font-weight:400}
.paper-effect__axis-row{min-height:1.1rem}
.paper-effect__axis{height:1.3rem;position:relative;font: .74em Georgia,serif;color:var(--paper-muted,var(--color-text-muted))}
.paper-effect__axis span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.paper-effect p.paper-effect__unit{font-size:.78em;line-height:1.55;margin:.3rem 0;color:var(--paper-muted,var(--color-text-muted))}
.paper-effect figcaption{font-size:.86em;line-height:1.66;color:var(--paper-muted,var(--color-text-muted));margin:.55rem 0 0;max-width:82ch}
@media(max-width:700px){
 .paper-effect__row{grid-template-columns:minmax(0,1fr);gap:.13rem;padding-block:.38rem}
 .paper-effect__track{width:calc(100% - 1.4rem);margin-inline:.7rem}
 .paper-effect__label{font-size:.89em;font-weight:600}
 .paper-effect__value{text-align:left;font-size:.82em}
 .paper-effect__value small{display:inline}
 .paper-effect__axis-row{padding:0}
 .paper-effect__axis{width:calc(100% - 1.4rem);margin-inline:.7rem}
 .paper-effect__axis-row>span{display:none}
}
@media print{.paper-effect{break-inside:avoid}.paper-effect__track{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
