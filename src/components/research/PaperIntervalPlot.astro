---
import PublicationPlot from './PublicationPlot.astro';
import plotData from '../../data/advisorConfidenceIntervals.json';
import manifest from '../../../figures/latex/advisor-confidence-intervals.manifest.json';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
/**
 * Static, print-friendly dot–whisker figure for source-bound paired estimates.
 * Zero is always the unchanged-condition reference; no generated observations.
 */
interface Effect { id: string; label: string; estimate: number; low: number; high: number }
interface Props {
  id: string;
  title: string;
  unit: string;
  min: number;
  max: number;
  ticks: number[];
  effects: ReadonlyArray<Effect>;
  caption: string;
  /** Single-column-like for small evidence; opt into double-column-like for dense multi-row evidence. */
  widthTier?: 'single' | 'double';
  /** Reader-facing subtraction identity, required when the compared conditions are not obvious. */
  comparison?: string;
  negativeLabel?: string;
  positiveLabel?: string;
  takeaway?: string;
}
const { id, title, unit, min, max, ticks, effects, caption, widthTier = 'single', comparison, negativeLabel = '前一个条件更低', positiveLabel = '前一个条件更高', takeaway } = Astro.props;
const root = resolve(process.cwd());
const sha256 = (bytes: Buffer | string) => createHash('sha256').update(bytes).digest('hex');
const dataBytes = readFileSync(resolve(root, manifest.dataPath));
if (sha256(dataBytes) !== manifest.dataSha256 || JSON.stringify(JSON.parse(dataBytes.toString('utf8'))) !== JSON.stringify(plotData)) {
  throw new Error('Advisor confidence interval data changed without rebuilding its PGFPlots manifest');
}
const figure = plotData.figures.find(item => item.id === id);
const figureBuild = manifest.figures.find(item => item.id === id);
if (!figure || !figureBuild || figureBuild.variants.some(variant =>
  sha256(readFileSync(resolve(root, variant.texPath))) !== variant.texSha256 ||
  sha256(readFileSync(resolve(root, variant.svgPath))) !== variant.svgSha256)) {
  throw new Error(`Advisor confidence interval PGFPlots assets are missing or stale for ${id}`);
}
if (figureBuild.widthTier !== widthTier || figure.axis.min !== min || figure.axis.max !== max || JSON.stringify(figure.axis.ticks) !== JSON.stringify(ticks) ||
  JSON.stringify(figureBuild.source) !== JSON.stringify(figure.source) || figureBuild.scaleFactor !== figure.scaleFactor ||
  figure.effects.length !== effects.length || figure.effects.some((item, index) => {
    const supplied = effects[index];
    return !supplied || item.id !== supplied.id || item.estimate.toFixed(2) !== supplied.estimate.toFixed(2) ||
      item.low.toFixed(2) !== supplied.low.toFixed(2) || item.high.toFixed(2) !== supplied.high.toFixed(2);
  })) {
  throw new Error(`Rendered confidence interval summary disagrees with the frozen PGFPlots data for ${id}`);
}
const captionId = `advisor-${id}-caption`;
const variants = Object.fromEntries(figureBuild.variants.map(variant => [variant.kind, variant]));
const svgDimensions = (variant: typeof figureBuild.variants[number]) => {
  const text = readFileSync(resolve(root, variant.svgPath), 'utf8').slice(0, 400);
  const width = /width="([\d.]+)pt"/.exec(text)?.[1];
  const height = /height="([\d.]+)pt"/.exec(text)?.[1];
  if (!width || !height) throw new Error(`PGFPlots SVG has no intrinsic dimensions: ${variant.svgPath}`);
  return { width: Math.round(Number(width)), height: Math.round(Number(height)) };
};
const desktop = variants.desktop;
if (!desktop) throw new Error(`PGFPlots desktop variant missing for ${id}`);
const coordinateText = (value: number) => Number(value).toPrecision(15).replace(/(?:\.0+|(?:(\.\d*?)0+))$/, '$1');
for (const variant of figureBuild.variants) {
  const tex = readFileSync(resolve(root, variant.texPath), 'utf8');
  if (!tex.includes('\\usepackage{pgfplots}') || !tex.includes('axis cs:0,') || figure.effects.some(effect =>
    ![effect.low, effect.estimate, effect.high].every(value => tex.includes(`(${coordinateText(value)},`)))) {
    throw new Error(`PGFPlots TeX coordinates disagree with frozen estimates for ${id}/${variant.kind}`);
  }
}
const dimensions = svgDimensions(desktop);
const mobile = variants.mobile;
if (!(min < 0 && max > 0 && min < max) || effects.length===0 ||
  effects.some(e => !Number.isFinite(e.estimate) || !Number.isFinite(e.low) || !Number.isFinite(e.high) ||
    e.low > e.estimate || e.estimate > e.high || e.low < min || e.high > max)) {
  throw new Error('PaperIntervalPlot needs real ordered confidence intervals and a zero reference');
}
const fmt = (n: number) => (n > 0 ? '+' : '') + n.toFixed(2).replace('-', '−');
const ariaText = effects.map(e => `${e.label}: ${fmt(e.estimate)}, 95% CI [${fmt(e.low)}, ${fmt(e.high)}] ${unit}`).join('; ');
---
<figure class:list={{ 'paper-effect': true, 'paper-effect--double': widthTier === 'double' }} data-paper-effect={id} data-paper-figure="interval" data-paper-width={widthTier}>
  <h4 class="paper-effect__title">{title}</h4>
  {comparison && <p class="paper-effect__comparison"><strong>比较方式：</strong>{comparison}</p>}
  <div class="paper-effect__directions" aria-hidden="true">
    <span>← {negativeLabel}</span>
    <span>{positiveLabel} →</span>
  </div>
  <div class="paper-effect__summary" aria-label={`${title}；${comparison ?? '前一种条件减后一种条件'}；${ariaText}`}>
    {effects.map((e) => (
      <div class="paper-effect__item" data-effect-row={e.id}>
        <div class="paper-effect__row-heading">
          <span class="paper-effect__label">{e.label}</span>
          <span class="paper-effect__value"><strong>{fmt(e.estimate)}</strong><small>{unit} · 平均变化</small></span>
        </div>
        <p class="paper-effect__interval"><strong>95% 置信区间：</strong>{fmt(e.low)} 至 {fmt(e.high)} {unit}{e.low <= 0 && e.high >= 0 && <span> · 区间包含 0</span>}</p>
      </div>
    ))}
  </div>
  <PublicationPlot id={id} src={`/${desktop.svgPath.replace(/^public\//, '')}`} mobileSrc={mobile ? `/${mobile.svgPath.replace(/^public\//, '')}` : undefined} alt={`${title}；${comparison ?? '前一种条件减后一种条件'}；${ariaText}；虚线为零差异，圆点为估计值，横线为 95% 置信区间`} captionId={captionId} widthTier={widthTier} naturalWidth={dimensions.width} naturalHeight={dimensions.height} />
  <p class="paper-effect__unit"><strong>怎么看：</strong>圆点是两种条件的平均差值，横线是 95% 置信区间；与下方坐标轴的 0 刻度对齐的竖虚线表示没有平均变化。区间跨过 0 不能证明两种条件完全一样。</p>
  {takeaway && <p class="paper-effect__takeaway"><strong>目前能判断：</strong>{takeaway}</p>}
  <figcaption id={captionId}>{caption}</figcaption>
</figure>

<style>
.paper-effect {
  width:min(100%,var(--research-evidence-single-width,38rem));
  max-width:100%;
  min-width:0;
  margin:1.4rem 0 1.8rem;
  padding:var(--research-evidence-inset,clamp(.95rem,2vw,1.35rem));
  border:1px solid var(--research-evidence-frame,color-mix(in srgb,var(--paper-ink,#1f2b29) 25%,var(--paper,#fff)));
  border-radius:.42rem;
  background:var(--paper,var(--color-surface,#fff));
  color:var(--paper-ink,var(--color-text));
  box-shadow:none;
  overflow:hidden;
  font-variant-numeric:tabular-nums;
}
.paper-effect--double{width:min(100%,var(--research-evidence-double-width,55.625rem))}
.paper-effect__title{font-family:var(--font-interface);font-size:var(--research-evidence-title-size,1.06rem);line-height:var(--type-leading-heading);font-weight:650;margin:0 0 .5rem}
.paper-effect p.paper-effect__comparison{margin:.25rem 0 .9rem;font-size:var(--type-caption);line-height:var(--type-leading-caption);color:var(--paper-muted,var(--color-text-muted));overflow-wrap:anywhere}
.paper-effect__comparison strong{color:var(--paper-ink,var(--color-text));font-weight:650}
.paper-effect__directions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:.55rem;align-items:center;font-size:var(--type-caption);line-height:var(--type-leading-caption);color:var(--paper-muted,var(--color-text-muted));padding:.4rem .1rem .5rem;border-top:1px solid var(--paper-line,var(--color-border));}
.paper-effect__directions span:first-child{text-align:left}
.paper-effect__directions span:last-child{text-align:right}
.paper-effect__summary{display:grid;gap:0;min-width:0}
.paper-effect__item{min-width:0;padding:.78rem 0 .65rem;border-top:1px solid var(--paper-line,var(--color-border))}
.paper-effect__row-heading{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:.15rem 1rem;min-width:0}
.paper-effect__label{font-size:var(--type-table);line-height:var(--type-leading-caption);font-weight:650;overflow-wrap:anywhere}
.paper-effect__value{display:inline-flex;gap:.4rem;align-items:baseline;flex-wrap:wrap;text-align:right;font-family:var(--font-interface);font-variant-numeric:tabular-nums}
.paper-effect__value strong{font-size:var(--type-table);line-height:var(--type-leading-caption);font-weight:var(--type-weight-normal);white-space:nowrap}
.paper-effect__value small{font-family:inherit;font-size:var(--type-caption);font-weight:400;line-height:var(--type-leading-caption);color:var(--paper-muted,var(--color-text-muted))}
.paper-effect p.paper-effect__interval{max-width:100%;margin:.3rem 0 0;font-size:var(--type-body-small);line-height:var(--type-leading-caption);color:var(--paper-muted,var(--color-text-muted));overflow-wrap:anywhere}
.paper-effect__interval strong{font-weight:650;color:var(--paper-ink,var(--color-text))}
.paper-effect p.paper-effect__unit{margin:.5rem 0 .35rem;padding-top:.7rem;border-top:1px solid var(--paper-line,var(--color-border));font-size:var(--type-body-small);line-height:var(--type-leading-body);color:var(--paper-muted,var(--color-text-muted))}
.paper-effect p.paper-effect__takeaway{max-width:100%;font-size:var(--type-body-small);line-height:var(--type-leading-body);margin:.72rem 0 .3rem;color:var(--paper-ink,var(--color-text))}
.paper-effect__takeaway strong{font-weight:var(--type-weight-strong)}
.paper-effect figcaption{font:var(--type-weight-normal) var(--research-evidence-caption-size,var(--type-caption))/1.68 var(--font-interface);color:var(--paper-muted,var(--color-text-muted));margin:.75rem 0 0;max-width:82ch;overflow-wrap:anywhere}
@media(max-width:700px){
  .paper-effect{padding:1rem .9rem}
  .paper-effect__directions{font-size:var(--type-caption);gap:.4rem}
  .paper-effect__value{font-size:var(--type-table)}
}
@media print{
  .paper-effect{break-inside:avoid;box-shadow:none;border-color:#666}
  .paper-effect :global(.publication-plot img){-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
