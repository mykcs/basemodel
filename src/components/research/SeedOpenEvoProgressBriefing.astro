---
import { localePath, type Locale } from '../../i18n';
import { OPEN_EVO_3B_TRAINING_DYNAMICS } from '../../data/openEvo3BTrainingDynamics';
import { OPEN_EVO_LONG_RUN_TRAINING_DYNAMICS } from '../../data/openEvoLongRunTrainingDynamics';
import { OPEN_EVO_DIRECT_APPLY_LIVE_DYNAMICS } from '../../data/openEvoDirectApplyLiveDynamics';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const flowHref = p('/research/seed-openevo/flow/');
const technicalHref = p('/research/seed-openevo/study/briefing/technical-notes/');
const taskArithmeticHref = 'https://arxiv.org/abs/2212.04089';
const measurementPackHref = 'https://github.com/mykcs/openevo-experiment/pull/317';
const gatedDeltaPaperHref = 'https://arxiv.org/abs/2412.06464';
const stateAwarePromptHref = 'https://github.com/mykcs/openevo-experiment/blob/main/configs/experiment/h1.8-state-aware-action-selection.json';
const directApplyLiveAuthorityHref = 'https://github.com/mykcs/openevo-experiment/commit/911e3afec1bc14d2194fa59b8feb3a232c34da85';
const directApplyLiveSnapshotHref = OPEN_EVO_DIRECT_APPLY_LIVE_DYNAMICS.evidenceHref;
const directApplyPlateauEvidenceHref = '/research/seed-openevo/evidence/q17-directapply-plateau-diagnostic-20260910-1038-sgt.json';
const frontierPlanHref = p('/research/seed-openevo/study/capability-exploration/q17-directapply-frontier/');
const frontierPlanMarkdownHref = 'https://github.com/mykcs/openevo-experiment/blob/301c78235327dbb0baa13da4ac9401f94c42a486/docs/experiment-tracking/Q17_DIRECTAPPLY_FRONTIER_PLAN_20260910.md';
const frontierEvidenceHref = '/research/seed-openevo/evidence/q17-directapply-frontier-plan-20260910-2312-sgt.json';

const dynamics3B = OPEN_EVO_3B_TRAINING_DYNAMICS;
const dynamics7B = OPEN_EVO_LONG_RUN_TRAINING_DYNAMICS.sevenB;
const dynamics17B = OPEN_EVO_LONG_RUN_TRAINING_DYNAMICS.onePointSevenB;
const dynamicsDirectApply = OPEN_EVO_DIRECT_APPLY_LIVE_DYNAMICS;
const movingAverage = (series: readonly { round: number; score: number }[], window = 12) => series.map((point, index) => {
  const start = Math.max(0, index - window + 1);
  const windowRows = series.slice(start, index + 1);
  return { round: point.round, score: windowRows.reduce((sum, row) => sum + row.score, 0) / windowRows.length };
});
const meanScore = (series: readonly { score: number }[]) => series.reduce((sum, row) => sum + row.score, 0) / series.length;

const scoreTrend = movingAverage(dynamics3B.score);
const scoreChart = { left: 42, right: 676, top: 16, bottom: 220, maxRound: dynamics3B.score.at(-1)?.round ?? 122, maxScore: 22 };
const scoreX = (round: number) => scoreChart.left + (round / scoreChart.maxRound) * (scoreChart.right - scoreChart.left);
const scoreY = (score: number) => scoreChart.bottom - (score / scoreChart.maxScore) * (scoreChart.bottom - scoreChart.top);
const scoreRawPoints = dynamics3B.score.map((point) => `${scoreX(point.round).toFixed(1)},${scoreY(point.score).toFixed(1)}`).join(' ');
const scoreTrendPoints = scoreTrend.map((point) => `${scoreX(point.round).toFixed(1)},${scoreY(point.score).toFixed(1)}`).join(' ');
const lossChart = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0.95, maxLoss: 1.85 };
const lossX = (round: number) => lossChart.left + (round / scoreChart.maxRound) * (lossChart.right - lossChart.left);
const lossY = (loss: number) => lossChart.bottom - ((loss - lossChart.minLoss) / (lossChart.maxLoss - lossChart.minLoss)) * (lossChart.bottom - lossChart.top);
const lossPoints = dynamics3B.loss.map((point) => `${lossX(point.round).toFixed(1)},${lossY(point.loss).toFixed(1)}`).join(' ');
const earlyScoreMean = meanScore(dynamics3B.score.slice(0, 20));
const lateScoreRows = dynamics3B.score.slice(-23);
const lateScoreMean = meanScore(lateScoreRows);
const firstLoss = dynamics3B.loss[0]?.loss ?? 0;
const lastLoss = dynamics3B.loss.at(-1)?.loss ?? 0;

const scoreTrend7B = movingAverage(dynamics7B.score);
const scoreChart7B = { left: 42, right: 676, top: 16, bottom: 220, maxRound: 148, maxScore: 90 };
const scoreX7B = (round: number) => scoreChart7B.left + (round / scoreChart7B.maxRound) * (scoreChart7B.right - scoreChart7B.left);
const scoreY7B = (score: number) => scoreChart7B.bottom - (score / scoreChart7B.maxScore) * (scoreChart7B.bottom - scoreChart7B.top);
const scoreRawPoints7B = dynamics7B.score.map((point) => `${scoreX7B(point.round).toFixed(1)},${scoreY7B(point.score).toFixed(1)}`).join(' ');
const scoreTrendPoints7B = scoreTrend7B.map((point) => `${scoreX7B(point.round).toFixed(1)},${scoreY7B(point.score).toFixed(1)}`).join(' ');
const lossChart7B = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0, maxLoss: 0.70 };
const lossX7B = (round: number) => lossChart7B.left + (round / scoreChart7B.maxRound) * (lossChart7B.right - lossChart7B.left);
const lossY7B = (loss: number) => lossChart7B.bottom - ((loss - lossChart7B.minLoss) / (lossChart7B.maxLoss - lossChart7B.minLoss)) * (lossChart7B.bottom - lossChart7B.top);
const lossPoints7B = dynamics7B.loss.map((point) => `${lossX7B(point.round).toFixed(1)},${lossY7B(point.loss).toFixed(1)}`).join(' ');
const earlyScoreMean7B = meanScore(dynamics7B.score.slice(0, 20));
const lateScoreMean7B = meanScore(dynamics7B.score.slice(-20));
const firstLoss7B = dynamics7B.loss[0]?.loss ?? 0;
const lastLoss7B = dynamics7B.loss.at(-1)?.loss ?? 0;

const scoreTrend17B = movingAverage(dynamics17B.score);
const earlyScoreMean17B = meanScore(dynamics17B.score.slice(0, 20));
const lateScoreMean17B = meanScore(dynamics17B.score.slice(-20));
const scoreChart17BFull = { left: 42, right: 676, top: 16, bottom: 220, maxRound: 159, maxScore: 70 };
const scoreX17BFull = (round: number) => scoreChart17BFull.left + (round / scoreChart17BFull.maxRound) * (scoreChart17BFull.right - scoreChart17BFull.left);
const scoreY17BFull = (score: number) => scoreChart17BFull.bottom - (score / scoreChart17BFull.maxScore) * (scoreChart17BFull.bottom - scoreChart17BFull.top);
const scoreRawPoints17BFull = dynamics17B.score.map((point) => `${scoreX17BFull(point.round).toFixed(1)},${scoreY17BFull(point.score).toFixed(1)}`).join(' ');
const scoreTrendPoints17BFull = scoreTrend17B.map((point) => `${scoreX17BFull(point.round).toFixed(1)},${scoreY17BFull(point.score).toFixed(1)}`).join(' ');
const lossChart17BFull = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0, maxLoss: 1.10 };
const lossX17BFull = (round: number) => lossChart17BFull.left + (round / scoreChart17BFull.maxRound) * (lossChart17BFull.right - lossChart17BFull.left);
const lossY17BFull = (loss: number) => lossChart17BFull.bottom - ((loss - lossChart17BFull.minLoss) / (lossChart17BFull.maxLoss - lossChart17BFull.minLoss)) * (lossChart17BFull.bottom - lossChart17BFull.top);
const lossPoints17BFull = dynamics17B.loss.map((point) => `${lossX17BFull(point.round).toFixed(1)},${lossY17BFull(point.loss).toFixed(1)}`).join(' ');
const candidateRounds3B = dynamics3B.loss.map((point) => point.round);
const acceptedRounds3B = dynamics3B.loss.filter((point) => point.accepted).map((point) => point.round);

const scoreTrendDirectApply = movingAverage(dynamicsDirectApply.score);
const earlyScoreMeanDirectApply = meanScore(dynamicsDirectApply.score.slice(0, 20));
const lateScoreMeanDirectApply = meanScore(dynamicsDirectApply.score.slice(-20));
const scoreChartDirectApply = { left: 42, right: 676, top: 16, bottom: 220, maxRound: dynamicsDirectApply.score.at(-1)?.round ?? 97, maxScore: 80 };
const scoreXDirectApply = (round: number) => scoreChartDirectApply.left + (round / scoreChartDirectApply.maxRound) * (scoreChartDirectApply.right - scoreChartDirectApply.left);
const scoreYDirectApply = (score: number) => scoreChartDirectApply.bottom - (score / scoreChartDirectApply.maxScore) * (scoreChartDirectApply.bottom - scoreChartDirectApply.top);
const scoreRawPointsDirectApply = dynamicsDirectApply.score.map((point) => `${scoreXDirectApply(point.round).toFixed(1)},${scoreYDirectApply(point.score).toFixed(1)}`).join(' ');
const scoreTrendPointsDirectApply = scoreTrendDirectApply.map((point) => `${scoreXDirectApply(point.round).toFixed(1)},${scoreYDirectApply(point.score).toFixed(1)}`).join(' ');
const lossChartDirectApply = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0, maxLoss: 1.10 };
const lossXDirectApply = (round: number) => lossChartDirectApply.left + (round / scoreChartDirectApply.maxRound) * (lossChartDirectApply.right - lossChartDirectApply.left);
const lossYDirectApply = (loss: number) => lossChartDirectApply.bottom - ((loss - lossChartDirectApply.minLoss) / (lossChartDirectApply.maxLoss - lossChartDirectApply.minLoss)) * (lossChartDirectApply.bottom - lossChartDirectApply.top);
const lossPointsDirectApply = dynamicsDirectApply.loss.map((point) => `${lossXDirectApply(point.round).toFixed(1)},${lossYDirectApply(point.loss).toFixed(1)}`).join(' ');
const directApplyCandidateRounds = dynamicsDirectApply.loss.map((point) => point.round);
const firstLossDirectApply = dynamicsDirectApply.loss[0]?.loss ?? 0;
const lastLossDirectApply = dynamicsDirectApply.loss.at(-1)?.loss ?? 0;
---

<article class="briefing" data-ui-audit="surface" data-testid="progress-briefing">
  <section id="briefing-top" class="briefing-slide briefing-cover" data-briefing-primary aria-labelledby="briefing-title">
    <div class="slide-inner">
      <h1 id="briefing-title">{t('OpenEVO 暑期考核汇报', 'OpenEVO Summer Research Review')}</h1>
      <p class="cover-thesis">{t('OpenEVO 让模型从任务经验中持续更新记忆与参数。我们用模拟网购任务 WebShop 测试它的学习上限，并把 SEED 论文结果作为参照；7B 分数没有达到预期后，我们把问题拆成更小、可以被实验否证的问题。', 'OpenEVO lets a model keep updating its memory and parameters from task experience. We use the simulated shopping task WebShop to test that learning ceiling and SEED paper results as a reference; when the 7B score remained below our target, we broke the problem into smaller falsifiable questions.')}</p>
      <dl class="cover-meta" aria-label={t('汇报基本信息', 'Briefing information')}>
        <div><dt>{t('汇报日期', 'Date')}</dt><dd>2026-09-08</dd></div>
        <div><dt>{t('汇报人', 'Presenter')}</dt><dd>{t('OpenEVO 项目组', 'OpenEVO project team')}</dd></div>
        <div><dt>{t('任务', 'Task')}</dt><dd>WebShop</dd></div>
      </dl>
    </div>
  </section>
  <section id="contents" class="briefing-slide tone-blue" aria-labelledby="contents-title">
    <div class="slide-inner split-slide">
      <div class="agenda-pane">
        <h2 id="contents-title">{t('目录', 'Agenda')}</h2>
        <ol class="agenda-list">
          <li><span>01</span><strong>{t('7B 长周期结果', '7B long-horizon result')}</strong></li>
          <li><span>02</span><strong>{t('1.7B / 3B 诊断实验', '1.7B / 3B diagnostic experiments')}</strong></li>
          <li><span>03</span><strong>{t('参数方向与更新准入', 'Parameter direction and update admission')}</strong></li>
          <li><span>04</span><strong>{t('当前结果与下一步选择', 'Current results and next priority')}</strong></li>
        </ol>
      </div>
      <aside class="tldr-pane" aria-label={t('先看三件事', 'Three things to know')}>
        <p class="tldr-label">{t('先看三件事', 'Three things to know')}</p>
        <ul>
          <li>{t('7B 长周期训练里，round Score 持续上升、SD-LoRA loss 持续下降；冻结 128 题终评是 49.33 / 100。', 'During the 7B long-horizon run, round Score rises while SD-LoRA loss falls; the frozen 128-task final is 49.33 / 100.')}</li>
          <li>{t('我们随后用更小实验逐个排除解释：步数、记忆容量、信息组织、参数更新方向都分别做了对照。', 'We then used smaller experiments to test explanations one by one: action horizon, memory capacity, information organization, and parameter-update direction.')}</li>
          <li>{t('最后问题集中到参数更新：GDR = Gated Delta Rule，它决定训练好的 SD-LoRA 候选能否进入下一轮模型。1.7B 正式线训练出 44 个候选，最后只有 7 个进入后续模型，于是我们启动 DirectApply 对照。', 'The question eventually narrows to parameter updates: GDR = Gated Delta Rule decides whether a trained SD-LoRA candidate enters the next model state. The formal 1.7B line trained 44 candidates and only 7 entered later states, motivating a DirectApply comparison.')}</li>
        </ul>
      </aside>
      <p class="slide-number">02 / 23</p>
    </div>
  </section>
  <section id="science-attempts" class="briefing-slide tone-blue" aria-labelledby="science-attempts-title">
    <div class="slide-inner summary-slide science-summary-slide">
      <h2 id="science-attempts-title">{t('我们做过哪些科学尝试', 'Scientific attempts we ran')}</h2>
      <p class="slide-thesis">{t('每一步都来自前一步的观察：先看见具体问题，再只改一个关键条件，看判断会不会改变。', 'Each step starts from an observation: identify the concrete problem, change one key condition, and see whether the judgment changes.')}</p>
      <div class="science-path-list">
        <article><span>{t('先让训练真正发生', 'make learning actually happen')}</span><strong>{t('撤掉旧 Stage 2 gate，解开 64-component 上限', 'Remove the old Stage 2 gate and the 64-component cap')}</strong><p>{t('这一步回答：低分前先确认参数有没有机会更新。', 'This answers whether parameters had a real chance to update before judging the low score.')}</p></article>
        <article><span>{t('再排除简单解释', 'rule out simple explanations')}</span><strong>{t('15 → 30、state-aware prompt、2048 → 4096、20 → 10+10、3B Harness', '15 → 30, state-aware prompt, 2048 → 4096, 20 → 10+10, 3B Harness')}</strong><p>{t('这些实验回答：低分来自步数、记忆容量、动作接口，还是更深的学习机制。', 'These experiments ask whether the low score came from horizon, memory capacity, action interface, or a deeper learning mechanism.')}</p></article>
        <article><span>{t('最后追参数机制', 'then inspect parameter mechanics')}</span><strong>{t('TaskVector、GDR、DirectApply / No-GDR', 'TaskVector, GDR, DirectApply / No-GDR')}</strong><p>{t('这一步转向新的因果问题：参数到底往哪里学，准入规则会不会截断长期有用的更新。', 'This turns to the next causal question: where parameters move and whether admission rules cut off useful long-term updates.')}</p></article>
      </div>
      <p class="slide-number">03 / 23</p>
    </div>
  </section>
  <section id="results" class="briefing-slide tone-paper" aria-labelledby="results-title">
    <div class="slide-inner">
      <h2 id="results-title">{t('当前 WebShop 结果与 SEED 论文参照', 'Current WebShop results and the SEED paper reference')}</h2>
      <p class="slide-thesis">{t('沿用 SEED 论文常见的两列：Score 看任务要求完成了多少，Succ. 看整道任务是否完整成功。', 'Use the familiar two WebShop columns from the SEED paper: Score for partial task completion and Succ. for full task success.')}</p>
      <p class="table-boundary"><strong>{t('SEED 与 OpenEVO 口径不同。', 'SEED and OpenEVO use different measurement setups.')}</strong>{t('SEED 是论文报告值；OpenEVO 是本地冻结 128 题终评。这里统一用 Score / Succ. 方便读表，不能直接用 89.7 与 49.33 的差值判断胜负。', 'SEED values are paper-reported; OpenEVO uses our local frozen 128-task final panel. The shared Score / Succ. columns are for readability, not for declaring a winner from the 89.7 versus 49.33 gap.')}</p>
      <div class="paper-table-wrap" tabindex="0" aria-label={t('SEED 论文与 OpenEVO 当前 WebShop 结果', 'SEED paper and current OpenEVO WebShop results')}>
        <table class="paper-table">
          <thead><tr><th>Method / Model</th><th>WebShop Score</th><th>WebShop Succ.</th></tr></thead>
          <tbody>
            <tr class="method-group"><th colspan="3">SEED {t('（论文报告值）', '(paper-reported)')}</th></tr>
            <tr><th scope="row">SEED (Qwen2.5-3B)</th><td>88.5</td><td>78.9%</td></tr>
            <tr><th scope="row">SEED (Qwen2.5-7B)</th><td>89.7</td><td>78.1%</td></tr>
            <tr><th scope="row">SEED (Qwen3-1.7B)</th><td>87.1</td><td>77.3%</td></tr>
            <tr class="method-group ours"><th colspan="3">OpenEVO {t('（我们的实验）', '(our experiments)')}</th></tr>
            <tr><th scope="row">OpenEVO {t('（7B，长周期训练）', '(7B, long-horizon)')}</th><td>49.33</td><td>45.31%</td></tr>
            <tr class="pending-row"><th scope="row">OpenEVO {t('（3B，独立实验线）', '(3B, independent line)')}</th><td>—</td><td>—</td></tr>
            <tr><th scope="row">OpenEVO {t('（1.7B，GDR）', '(1.7B, GDR)')}</th><td>37.60</td><td>0.78%</td></tr>
            <tr class="pending-row"><th scope="row">OpenEVO {t('（1.7B，DirectApply）', '(1.7B, DirectApply)')}</th><td>—</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
      <div class="table-notes single-note">
        <p>{t('3B 确实做过独立实验线，但目前没有同口径冻结终评，所以保持空白；DirectApply 也还没有封存最终分数。GDR = Gated Delta Rule，决定一个已经训练好的 SD-LoRA 候选是否进入下一轮模型。', 'The 3B line is real, but it has no same-protocol frozen final, so it remains blank; DirectApply is also unfinished. GDR = Gated Delta Rule decides whether an already-trained SD-LoRA candidate enters the next model state.')}</p>
      </div>
      <p class="slide-number">04 / 23</p>
    </div>
  </section>
  <section id="openevo-method" class="briefing-slide tone-green" aria-labelledby="openevo-method-title">
    <div class="slide-inner method-slide">
      <h2 id="openevo-method-title">{t('最早的 7B 只收任务经验；完整长跑后来才带上四类学习状态', 'The earliest 7B collected task experience; the full long run later carried four learning states')}</h2>
      <p class="slide-thesis">{t('最早 7B 和最终长跑属于两个阶段，状态也不同。早期 7B 更接近 baseline：先让学生模型自己跑 WebShop，MiniMax 只在任务结束后回看，再研究成功轨迹能不能转成参数更新。这里比较 LoRA 和 SD-LoRA，是为了排除一个可能误判：如果只有 SD-LoRA 效果差，问题可能在 SD-LoRA 机制；如果普通 LoRA 也差，问题就更可能在数据、任务或训练逻辑。后来才逐步进入完整的 OpenEVO Stage 2。', 'The earliest 7B and the final long run are different experiment stages with different active states. The early 7B line was closer to a baseline: the student model first ran WebShop, MiniMax reviewed completed tasks, and we tested whether successful trajectories could become parameter updates. We compared LoRA and SD-LoRA to avoid a false diagnosis: if only SD-LoRA failed, the mechanism might be at fault; if ordinary LoRA also failed, the problem likely lay in the data, task, or training logic. The full OpenEVO Stage 2 came later.')}</p>
      <div class="method-stage-grid">
        <article>
          <header><span>Stage 1</span><strong>{t('先收 1,440 条学生轨迹，研究自己的成功经验能不能变成参数更新', 'Collect 1,440 student trajectories and test whether its own successes can become parameter updates')}</strong></header>
          <ol>
            <li><b>180 × 8</b><p>{t('180 个 WebShop 任务，每题 8 次完整尝试，都由学生模型自己做。', 'The student model makes eight full attempts on each of 180 WebShop tasks.')}</p></li>
            <li><b>MiniMax review</b><p>{t('任务结束以后再回看成功、失败和重复搜索；MiniMax 不替学生模型执行环境动作。', 'After the task ends, MiniMax reviews successes, failures, and loops; it does not act in the environment for the student.')}</p></li>
            <li><b>LoRA / SD-LoRA</b><p>{t('早期参数实验把同一批成功轨迹分别交给 LoRA 和 SD-LoRA。我们当时想确认的是：已经收到了成功轨迹，为什么把这些经验写进参数以后，任务能力还是没有明显变好？如果普通 LoRA 能学起来、只有 SD-LoRA 学不起来，问题更可能出在 SD-LoRA 的更新机制；如果两种都学不起来，就要继续查数据、任务信号或训练逻辑。这一阶段还没有注入后来完整长跑里的四类滚动状态。', 'Early parameter experiments gave the same success trajectories to LoRA and SD-LoRA. The question was concrete: after collecting successful trajectories, why did writing that experience into parameters still fail to produce a clear capability gain? If ordinary LoRA learned while SD-LoRA did not, the SD-LoRA update mechanism became the likely culprit; if both failed, we would keep looking at the data, task signal, or training logic. The full four-state long-run carrier set was not injected here.')}</p></li>
          </ol>
        </article>
        <article>
          <header><span>Stage 2</span><strong>{t('后来每 128 次新任务形成一轮，四类状态一起带到下一轮', 'Later, every 128 new attempts form a round and four states carry forward')}</strong></header>
          <ol>
            <li><b>{t('做 128 次任务', 'run 128 attempts')}</b><p>{t('模型继续用自己的当前状态跑 WebShop，产生这一轮的新经验。', 'The model runs WebShop from its current state and produces new experience for the round.')}</p></li>
            <li><b>{t('分别判断更新', 'decide each update')}</b><p>{t('Text Memory、Skill Bundle、Agent System 和 SD-LoRA 按各自规则判断是否变化；没有触发条件时可以保持原样。', 'Text Memory, Skill Bundle, Agent System, and SD-LoRA each follow their own update rule and may remain unchanged when not triggered.')}</p></li>
            <li><b>{t('带到下一轮', 'carry forward')}</b><p>{t('下一轮实际使用这些非参数状态与累计 SD-LoRA 参数状态继续做任务。', 'The next round uses these non-parametric states together with the cumulative SD-LoRA parameter state.')}</p></li>
          </ol>
        </article>
      </div>
      <div class="carrier-strip" aria-label={t('四类学习状态', 'Four learning states')}>
        <span><strong>Text Memory</strong>{t('把跨任务经验整理成可复用文字记忆', 'consolidates cross-task experience into reusable text memory')}</span>
        <span><strong>Skill Bundle</strong>{t('沉淀重复出现的操作与策略', 'stores recurring operations and strategies')}</span>
        <span><strong>Agent System</strong>{t('影响 Agent 在环境里的思考与行动规则', 'shapes how the agent reasons and acts in the environment')}</span>
        <span><strong>SD-LoRA</strong>{t('真正改变模型参数侧行为', 'changes parameter-side model behavior')}</span>
      </div>
      <p class="slide-number">05 / 23</p>
    </div>
  </section>
  <section id="stage2-gate" class="briefing-slide tone-gold" aria-labelledby="stage2-gate-title">
    <div class="slide-inner gate-slide">
      <h2 id="stage2-gate-title">{t('训练跑了很久，但参数一次都没有更新', 'The training ran for a long time, but the parameters never updated')}</h2>
      <p class="gate-question">{t('既然已经有不少成功和正向轨迹，为什么这些经验一直没有写进参数？', 'There were already successful and positive trajectories, so why had none of that experience entered the parameters?')}</p>
      <p class="slide-thesis">{t('我们回头查旧 Stage 2 的更新规则。系统每收集一批 256 次做题记录，就数一数：里面有多少个不同的 WebShop 任务已经提供了合格成功经验。旧规则规定必须凑够 8 个不同任务，才允许把经验写进参数。真实训练里，最好的一批也只能凑到 7 个。就像门口规定“8 个人到齐才开门”，每次最多只来 7 个；即使这 7 个已经做得很好，门也永远不会开。', 'We inspected the old Stage-2 update rule. For each batch of 256 task attempts, the system counted how many distinct WebShop tasks had produced qualifying success evidence. The old rule required eight distinct tasks before any experience could enter the parameters. In the real run, the best batch reached only seven. It was like a door that opens only when eight people arrive, while at most seven ever show up; even if those seven did well, the door stayed closed.')}</p>
      <div class="before-after gate-compare">
        <div class="before"><span>{t('原本用途：控制实验', 'Original use: control experiment')}</span><strong>{t('8 个任务身份 × 每个 2 条成功', '8 task identities × 2 successes each')}</strong><p>{t('为了回答同一个问题——成功轨迹已经有了，为什么参数学习仍没有明显带来任务能力提升——我们让 LoRA 和 SD-LoRA 看到同一份成功数据。普通 LoRA 如果能学而 SD-LoRA 不能，才支持把问题指向 SD-LoRA；两种都学不起来，就继续查数据、任务信号和训练逻辑。这里的 8 只是让对照更公平的数据构造条件；长期学习不应沿用它。', 'To answer the same question—successful trajectories existed, so why did parameter learning still fail to produce a clear task-capability gain—we gave LoRA and SD-LoRA the same success data. If ordinary LoRA learned while SD-LoRA did not, that would implicate the SD-LoRA mechanism; if both failed, the search would move to the data, task signal, or training logic. The number 8 only made that comparison fair; long-run learning should not inherit it.')}</p></div>
        <div class="after"><span>{t('后来误用：Stage 2 gate', 'Later misuse: Stage-2 gate')}</span><strong>{t('每 256 次 rollout 不到 8 个身份就不更新', 'no update unless a 256-rollout window reaches 8 identities')}</strong><p>{t('实际窗口最多只有 7 个 qualifying identities；于是 20,480 次 rollout 和 797 条 positive 轨迹，仍然得到 0 次参数更新。', 'A real window topped out at 7 qualifying identities; thus 20,480 rollouts and 797 positive trajectories still produced zero parameter updates.')}</p></div>
      </div>
      <div class="resolution-box"><strong>{t('我们怎么解决', 'How we fixed the scientific rule')}</strong><p>{t('撤掉这个人数门槛，把正式 Stage 2 固定成 round-local：一轮 128 次 WebShop 尝试里，只要出现至少一个 clean exact-success task，就给 SD-LoRA 一次更新机会；如果没有成功，就明确记为 NOOP。这样模型有没有学到东西，才不再被历史控制门槛挡住。', 'We removed this identity-count gate and froze formal Stage 2 as round-local: in one 128-rollout WebShop round, at least one clean exact-success task gives SD-LoRA one update opportunity; if there is no success, the round is recorded as NOOP. Only then is learning no longer blocked by a historical control threshold.')}</p></div>
      <p class="slide-bridge">{t('撤掉这个 gate 以后，参数终于开始连续更新；接着才暴露出另一个完全不同的 64-component 工程容量问题。', 'After removing this gate, parameter updates finally began to accumulate; only then did a separate 64-component engineering-capacity problem appear.')}</p>
