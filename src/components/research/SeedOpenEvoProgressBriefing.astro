          <figcaption>{t('发生候选训练时的 SD-LoRA loss', 'SD-LoRA loss when candidate training occurs')} <span>{t('只有真正训练候选的轮次才有点', 'points exist only when a candidate is actually trained')}</span></figcaption>
          <svg viewBox="0 0 360 248" role="img" aria-label={t('3B SD-LoRA 候选训练 loss 曲线', '3B SD-LoRA candidate-training loss curve')}>
            <line x1="36" y1="220" x2="340" y2="220" class="chart-axis" />
            <line x1="36" y1="118" x2="340" y2="118" class="chart-gridline" />
