            <text x="4" y="224" class="chart-label">0.95</text><text x="6" y="122" class="chart-label">1.40</text><text x="6" y="31" class="chart-label">1.80</text>
            <text x="36" y="242" class="chart-label">R0</text><text x="315" y="242" class="chart-label">R122</text>
