---
import { localePath, type Locale } from '../../i18n';
import { OPEN_EVO_3B_TRAINING_DYNAMICS } from '../../data/openEvo3BTrainingDynamics';
import { OPEN_EVO_LONG_RUN_TRAINING_DYNAMICS } from '../../data/openEvoLongRunTrainingDynamics';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const flowHref = p('/research/seed-openevo/flow/');
const technicalHref = p('/research/seed-openevo/study/briefing/technical-notes/');

const dynamics3B = OPEN_EVO_3B_TRAINING_DYNAMICS;
const dynamics7B = OPEN_EVO_LONG_RUN_TRAINING_DYNAMICS.sevenB;
const dynamics17B = OPEN_EVO_LONG_RUN_TRAINING_DYNAMICS.onePointSevenB;
const movingAverage = (series: readonly { round: number; score: number }[], window = 12) => series.map((point, index) => {
  const start = Math.max(0, index - window + 1);
  const windowRows = series.slice(start, index + 1);
  return { round: point.round, score: windowRows.reduce((sum, row) => sum + row.score, 0) / windowRows.length };
});
const meanScore = (series: readonly { score: number }[]) => series.reduce((sum, row) => sum + row.score, 0) / series.length;

const scoreTrend = movingAverage(dynamics3B.score);
const scoreChart = { left: 42, right: 676, top: 16, bottom: 220, maxRound: dynamics3B.score.at(-1)?.round ?? 122, maxScore: 22 };
const scoreX = (round: number) => scoreChart.left + (round / scoreChart.maxRound) * (scoreChart.right - scoreChart.left);
const scoreY = (score: number) => scoreChart.bottom - (score / scoreChart.maxScore) * (scoreChart.bottom - scoreChart.top);
const scoreRawPoints = dynamics3B.score.map((point) => `${scoreX(point.round).toFixed(1)},${scoreY(point.score).toFixed(1)}`).join(' ');
const scoreTrendPoints = scoreTrend.map((point) => `${scoreX(point.round).toFixed(1)},${scoreY(point.score).toFixed(1)}`).join(' ');
const lossChart = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0.95, maxLoss: 1.85 };
const lossX = (round: number) => lossChart.left + (round / scoreChart.maxRound) * (lossChart.right - lossChart.left);
const lossY = (loss: number) => lossChart.bottom - ((loss - lossChart.minLoss) / (lossChart.maxLoss - lossChart.minLoss)) * (lossChart.bottom - lossChart.top);
const lossPoints = dynamics3B.loss.map((point) => `${lossX(point.round).toFixed(1)},${lossY(point.loss).toFixed(1)}`).join(' ');
const earlyScoreMean = meanScore(dynamics3B.score.slice(0, 20));
const lateScoreRows = dynamics3B.score.slice(-23);
const lateScoreMean = meanScore(lateScoreRows);
const firstLoss = dynamics3B.loss[0]?.loss ?? 0;
const lastLoss = dynamics3B.loss.at(-1)?.loss ?? 0;

const scoreTrend7B = movingAverage(dynamics7B.score);
const scoreChart7B = { left: 42, right: 676, top: 16, bottom: 220, maxRound: 148, maxScore: 90 };
const scoreX7B = (round: number) => scoreChart7B.left + (round / scoreChart7B.maxRound) * (scoreChart7B.right - scoreChart7B.left);
const scoreY7B = (score: number) => scoreChart7B.bottom - (score / scoreChart7B.maxScore) * (scoreChart7B.bottom - scoreChart7B.top);
const scoreRawPoints7B = dynamics7B.score.map((point) => `${scoreX7B(point.round).toFixed(1)},${scoreY7B(point.score).toFixed(1)}`).join(' ');
const scoreTrendPoints7B = scoreTrend7B.map((point) => `${scoreX7B(point.round).toFixed(1)},${scoreY7B(point.score).toFixed(1)}`).join(' ');
const lossChart7B = { left: 36, right: 340, top: 16, bottom: 220, minLoss: 0, maxLoss: 0.70 };
const lossX7B = (round: number) => lossChart7B.left + (round / scoreChart7B.maxRound) * (lossChart7B.right - lossChart7B.left);
const lossY7B = (loss: number) => lossChart7B.bottom - ((loss - lossChart7B.minLoss) / (lossChart7B.maxLoss - lossChart7B.minLoss)) * (lossChart7B.bottom - lossChart7B.top);
const lossPoints7B = dynamics7B.loss.map((point) => `${lossX7B(point.round).toFixed(1)},${lossY7B(point.loss).toFixed(1)}`).join(' ');
const earlyScoreMean7B = meanScore(dynamics7B.score.slice(0, 20));
const lateScoreMean7B = meanScore(dynamics7B.score.slice(-20));
const firstLoss7B = dynamics7B.loss[0]?.loss ?? 0;
const lastLoss7B = dynamics7B.loss.at(-1)?.loss ?? 0;

const scoreTrend17B = movingAverage(dynamics17B.score);
const miniScore17B = { left: 28, right: 492, top: 10, bottom: 112, maxRound: 159, maxScore: 65 };
const miniScoreX17B = (round: number) => miniScore17B.left + (round / miniScore17B.maxRound) * (miniScore17B.right - miniScore17B.left);
const miniScoreY17B = (score: number) => miniScore17B.bottom - (score / miniScore17B.maxScore) * (miniScore17B.bottom - miniScore17B.top);
const miniScoreRaw17B = dynamics17B.score.map((point) => `${miniScoreX17B(point.round).toFixed(1)},${miniScoreY17B(point.score).toFixed(1)}`).join(' ');
const miniScoreTrend17B = scoreTrend17B.map((point) => `${miniScoreX17B(point.round).toFixed(1)},${miniScoreY17B(point.score).toFixed(1)}`).join(' ');
const miniLoss17B = { left: 28, right: 492, top: 8, bottom: 60, minLoss: 0, maxLoss: 1.10 };
const miniLossX17B = (round: number) => miniLoss17B.left + (round / miniScore17B.maxRound) * (miniLoss17B.right - miniLoss17B.left);
const miniLossY17B = (loss: number) => miniLoss17B.bottom - ((loss - miniLoss17B.minLoss) / (miniLoss17B.maxLoss - miniLoss17B.minLoss)) * (miniLoss17B.bottom - miniLoss17B.top);
const miniLossPoints17B = dynamics17B.loss.map((point) => `${miniLossX17B(point.round).toFixed(1)},${miniLossY17B(point.loss).toFixed(1)}`).join(' ');
const earlyScoreMean17B = meanScore(dynamics17B.score.slice(0, 20));
const lateScoreMean17B = meanScore(dynamics17B.score.slice(-20));
const firstLoss17B = dynamics17B.loss[0]?.loss ?? 0;
const lastLoss17B = dynamics17B.loss.at(-1)?.loss ?? 0;
---

<article class="briefing" data-ui-audit="surface" data-testid="progress-briefing">
  <section id="briefing-top" class="briefing-slide briefing-cover" data-briefing-primary aria-labelledby="briefing-title">
    <div class="slide-inner">
      <h1 id="briefing-title">{t('OpenEVO 暑期考核汇报', 'OpenEVO Summer Research Review')}</h1>
      <p class="cover-thesis">{t('OpenEVO 让模型从任务经验中持续更新记忆与参数。我们用模拟网购任务 WebShop 测试它的学习上限，并把 SEED 论文结果作为参照；7B 分数没有达到预期后，我们把问题拆成更小、可以被实验否证的问题。', 'OpenEVO lets a model keep updating its memory and parameters from task experience. We use the simulated shopping task WebShop to test that learning ceiling and SEED paper results as a reference; when the 7B score remained below our target, we broke the problem into smaller falsifiable questions.')}</p>
      <dl class="cover-meta" aria-label={t('汇报基本信息', 'Briefing information')}>
        <div><dt>{t('汇报日期', 'Date')}</dt><dd>2026-09-08</dd></div>
        <div><dt>{t('汇报人', 'Presenter')}</dt><dd>{t('OpenEVO 项目组', 'OpenEVO project team')}</dd></div>
        <div><dt>{t('任务', 'Task')}</dt><dd>WebShop</dd></div>
      </dl>
    </div>
  </section>

  <section id="contents" class="briefing-slide tone-blue" aria-labelledby="contents-title">
    <div class="slide-inner split-slide">
      <div class="agenda-pane">
        <h2 id="contents-title">{t('目录', 'Agenda')}</h2>
        <ol class="agenda-list">
          <li><span>01</span><strong>{t('7B 长周期结果', '7B long-horizon result')}</strong></li>
          <li><span>02</span><strong>{t('1.7B / 3B 诊断实验', '1.7B / 3B diagnostic experiments')}</strong></li>
          <li><span>03</span><strong>{t('参数方向与更新准入', 'Parameter direction and update admission')}</strong></li>
          <li><span>04</span><strong>{t('当前结果与下一步选择', 'Current results and next priority')}</strong></li>
        </ol>
      </div>
      <aside class="tldr-pane" aria-label="Too long, Don't read">
        <p class="tldr-label">Too long, Don't read</p>
        <ul>
          <li>{t('7B 长周期实验最终测试是 49.33 / 100：模型能持续学习，但离我们想追的能力上限还有明显距离。', 'The 7B long-horizon run finishes at 49.33 / 100: the model can keep learning, but the ceiling remains well below the target we want to understand.')}</li>
          <li>{t('我们随后用更小实验逐个排除解释：步数、记忆容量、信息组织、参数更新方向都分别做了对照。', 'We then used smaller experiments to test explanations one by one: action horizon, memory capacity, information organization, and parameter-update direction.')}</li>
          <li>{t('最后问题集中到参数更新：1.7B 实验实际训练了 44 个 SD-LoRA 更新；加入 GDR（Gated Delta Rule，选择性更新规则）后只有 7 个真正写入后续模型，因此我们又启动 DirectApply 对照。', 'The question eventually narrows to parameter updates: the 1.7B run actually trained 44 SD-LoRA updates; after adding GDR (Gated Delta Rule, a selective update rule), only 7 entered later model states, motivating a DirectApply comparison.')}</li>
        </ul>
      </aside>
      <div class="attempts-summary" aria-label={t('本次具体尝试', 'Concrete attempts in this review')}>
        <strong>{t('这次具体做过的尝试', 'Concrete experiments and diagnostics')}</strong>
        <div>
          <span>{t('7B 长周期训练基线', '7B long-horizon baseline')}</span>
          <span>{t('1.7B / 3B 小模型诊断线', '1.7B / 3B diagnostic lines')}</span>
          <span>{t('最大步数 15 → 30', 'max steps 15 → 30')}</span>
          <span>{t('Text Memory 2048 → 4096，再做 10+10 分块', 'Text Memory 2048 → 4096, then bounded 10+10')}</span>
          <span>{t('TaskVector 参数更新方向分析', 'TaskVector update-direction analysis')}</span>
          <span>{t('GDR 选择性更新 vs DirectApply', 'selective GDR updates vs DirectApply')}</span>
        </div>
      </div>
      <p class="slide-number">02 / 12</p>
    </div>
  </section>

  <section id="results" class="briefing-slide tone-paper" aria-labelledby="results-title">
    <div class="slide-inner">
      <h2 id="results-title">{t('当前 WebShop 结果与 SEED 论文参照', 'Current WebShop results and the SEED paper reference')}</h2>
      <p class="slide-thesis">{t('沿用 SEED 论文常见的两列：Score 看任务要求完成了多少，Succ. 看整道任务是否完整成功。', 'Use the familiar two WebShop columns from the SEED paper: Score for partial task completion and Succ. for full task success.')}</p>
      <p class="table-boundary"><strong>{t('SEED 与 OpenEVO 不是同协议直接对照。', 'SEED and OpenEVO are not a same-protocol head-to-head comparison.')}</strong>{t('SEED 是论文报告值；OpenEVO 是本地冻结 128 题终评。这里统一用 Score / Succ. 方便读表，不能直接用 89.7 与 49.33 的差值判断胜负。', 'SEED values are paper-reported; OpenEVO uses our local frozen 128-task final panel. The shared Score / Succ. columns are for readability, not for declaring a winner from the 89.7 versus 49.33 gap.')}</p>
      <div class="paper-table-wrap" tabindex="0" aria-label={t('SEED 论文与 OpenEVO 当前 WebShop 结果', 'SEED paper and current OpenEVO WebShop results')}>
        <table class="paper-table">
          <thead><tr><th>{t('方法', 'Method')}</th><th>WebShop Score</th><th>WebShop Succ.</th></tr></thead>
          <tbody>
            <tr class="method-group"><th colspan="3">SEED {t('（论文报告值）', '(paper-reported)')}</th></tr>
            <tr><th scope="row">SEED (Qwen2.5-3B)</th><td>88.5</td><td>78.9%</td></tr>
            <tr><th scope="row">SEED (Qwen2.5-7B)</th><td>89.7</td><td>78.1%</td></tr>
            <tr><th scope="row">SEED (Qwen3-1.7B)</th><td>87.1</td><td>77.3%</td></tr>
            <tr class="method-group ours"><th colspan="3">OpenEVO {t('（我们的实验）', '(our experiments)')}</th></tr>
            <tr><th scope="row">OpenEVO {t('（7B，长周期训练）', '(7B, long-horizon)')}</th><td>49.33</td><td>45.31%</td></tr>
            <tr><th scope="row">OpenEVO {t('（1.7B，GDR）', '(1.7B, GDR)')}</th><td>37.60</td><td>0.78%</td></tr>
            <tr class="pending-row"><th scope="row">OpenEVO {t('（3B，独立实验线）', '(3B, independent line)')}</th><td>—</td><td>—</td></tr>
            <tr class="pending-row"><th scope="row">OpenEVO {t('（1.7B，DirectApply）', '(1.7B, DirectApply)')}</th><td>—</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
      <div class="table-notes single-note">
        <p>{t('3B 确实做过独立实验线，但目前没有一个能与这张冻结终评表直接并列的最终分数，所以不硬填；DirectApply 也还没有最终分数。', 'The 3B line is real, but we do not have a final number that belongs beside this frozen panel, so it remains blank; DirectApply is also unfinished.')}</p>
      </div>
      <p class="slide-number">03 / 12</p>
    </div>
  </section>

  <section id="seven-b" class="briefing-slide tone-blue" aria-labelledby="seven-b-title">
    <div class="slide-inner dynamics-slide seven-b-dynamics">
      <h2 id="seven-b-title">{t('7B：训练过程明显学起来，但冻结终评仍是 49.33', '7B: training clearly improves, while the frozen final remains 49.33')}</h2>
      <p class="slide-thesis">{t(`Qwen2.5-7B 先按 180 个任务 × 每个任务 8 次尝试 = 1,440 条轨迹启动（temperature=0.4，每条最多 15 步），再进入长周期 Stage 2。训练轮次的 WebShop Score 前 20 轮平均 ${earlyScoreMean7B.toFixed(2)} / 100，最后 20 轮平均 ${lateScoreMean7B.toFixed(2)} / 100；143 次已接纳 SD-LoRA 更新的 loss 从 ${firstLoss7B.toFixed(2)} 降到 ${lastLoss7B.toFixed(2)}。`, `Qwen2.5-7B starts from 180 tasks × 8 rollouts = 1,440 Stage-1 trajectories (temperature=0.4, max 15 steps) and then enters long-horizon Stage 2. Training-round WebShop Score averages ${earlyScoreMean7B.toFixed(2)} / 100 over the first 20 rounds and ${lateScoreMean7B.toFixed(2)} / 100 over the last 20; loss across 143 admitted SD-LoRA updates falls from ${firstLoss7B.toFixed(2)} to ${lastLoss7B.toFixed(2)}.`)}</p>
      <div class="dynamics-grid">
        <figure class="dynamics-chart score-chart">
          <figcaption>{t('7B 每轮 WebShop Score', '7B WebShop Score by round')} <span>{t('细线=原始轮次；粗线=12轮移动平均', 'thin=raw rounds; thick=12-round moving average')}</span></figcaption>
          <svg viewBox="0 0 700 248" role="img" aria-label={t('7B 每轮 WebShop Score 与移动平均曲线', '7B WebShop Score and moving-average curve by round')}>
            <line x1="42" y1="220" x2="676" y2="220" class="chart-axis" />
            <line x1="42" y1="118" x2="676" y2="118" class="chart-gridline" />
            <line x1="42" y1="16" x2="676" y2="16" class="chart-gridline" />
            <text x="14" y="224" class="chart-label">0</text><text x="8" y="122" class="chart-label">45</text><text x="8" y="20" class="chart-label">90</text>
            <text x="42" y="242" class="chart-label">R0</text><text x="350" y="242" class="chart-label">R74</text><text x="646" y="242" class="chart-label">R148</text>
            <polyline points={scoreRawPoints7B} class="score-raw" />
            <polyline points={scoreTrendPoints7B} class="score-trend" />
          </svg>
        </figure>
        <figure class="dynamics-chart loss-chart">
          <figcaption>{t('143 次已接纳更新的 SD-LoRA loss', 'SD-LoRA loss for 143 admitted updates')} <span>{t('每个点对应一次真正写入后续模型的参数更新', 'each point is an update written into the continuing model')}</span></figcaption>
          <svg viewBox="0 0 360 248" role="img" aria-label={t('7B 已接纳 SD-LoRA 更新的训练 loss 曲线', '7B admitted SD-LoRA update training-loss curve')}>
            <line x1="36" y1="220" x2="340" y2="220" class="chart-axis" />
            <line x1="36" y1="118" x2="340" y2="118" class="chart-gridline" />
            <line x1="36" y1="16" x2="340" y2="16" class="chart-gridline" />
            <text x="6" y="224" class="chart-label">0</text><text x="3" y="122" class="chart-label">0.35</text><text x="3" y="20" class="chart-label">0.70</text>
            <text x="36" y="242" class="chart-label">R0</text><text x="310" y="242" class="chart-label">R148</text>
            <polyline points={lossPoints7B} class="loss-line" />
          </svg>
        </figure>
      </div>
      <div class="long-run-strip" aria-label={t('7B 实验尺度与冻结终评', '7B scale and frozen final evaluation')}>
        <span><strong>Stage 1</strong>1,440 {t('条启动轨迹', 'startup trajectories')}</span>
        <span><strong>Stage 2</strong>149 {t('轮 · 19,072 次有效环境交互', 'rounds · 19,072 accepted rollouts')}</span>
        <span><strong>{t('冻结 128 题终评', 'Frozen 128-task final')}</strong>49.33 / 100 · {t('完整成功 58 / 128（45.31%）', '58 / 128 complete successes (45.31%)')}</span>
      </div>
      <p class="dynamics-boundary">{t('这里最重要的不是“训练中某一轮最高有多高”，而是训练过程和最终泛化要分开看：Score 曲线与 loss 都说明参数学习确实发生；冻结终评 49.33 则说明这些学习还没有等量转化成未参与训练的最终任务能力。于是我们继续追问：瓶颈是在任务长度、记忆组织，还是参数更新机制？', 'The key point is not the highest training-round score. Training dynamics and final generalization are different measurements: the Score curve and loss show real parameter learning, while the frozen 49.33 final shows that learning does not transfer one-for-one to held-out final tasks. That motivates the next question: is the bottleneck task horizon, memory organization, or the parameter-update mechanism?')}</p>
      <p class="source-note"><a href={technicalHref}>{t('W&B 曲线身份、训练分数与冻结终评边界', 'W&B run identity and the training-vs-final boundary')}</a></p>
      <p class="slide-number">04 / 12</p>
    </div>
  </section>

  <section id="small-arms" class="briefing-slide tone-green" aria-labelledby="small-arms-title">
    <div class="slide-inner small-arms-slide">
      <h2 id="small-arms-title">{t('1.7B 和 3B：用更小实验定位瓶颈', '1.7B and 3B: smaller experiments to locate the bottleneck')}</h2>
      <p class="slide-thesis">{t('小模型让我们更快做单变量诊断。1.7B 的完整 GDR 线尤其关键：训练过程并没有停住，但“训练出一个更新”和“让这个更新进入后续模型”之间出现了很大的落差。', 'Smaller models let us run one-variable diagnostics faster. The complete 1.7B GDR line is especially revealing: training does not stop, yet a large gap appears between training an update and admitting it into the continuing model.')}</p>
      <div class="small-model-grid">
        <article class="small-model-card one-seven-card">
          <header><span>1.7B</span><div><h3>{t('160 轮都跑完了，但 44 个候选只接纳 7 个', 'All 160 rounds finish, but only 7 of 44 candidates are admitted')}</h3><p>{t(`前 20 轮任务 Score 平均 ${earlyScoreMean17B.toFixed(2)}，最后 20 轮 ${lateScoreMean17B.toFixed(2)}。`, `Training-round Score averages ${earlyScoreMean17B.toFixed(2)} over the first 20 rounds and ${lateScoreMean17B.toFixed(2)} over the last 20.`)}</p></div></header>
          <figure class="mini-score-chart">
            <figcaption>{t('每轮 WebShop Score；下方短线 = 候选更新发生的轮次', 'WebShop Score by round; bottom ticks = candidate-update rounds')}</figcaption>
            <svg viewBox="0 0 520 126" role="img" aria-label={t('1.7B 每轮 WebShop Score、候选更新与 GDR 接纳轮次', '1.7B WebShop Score, candidate updates, and GDR admissions by round')}>
              <line x1="28" y1="112" x2="492" y2="112" class="chart-axis" />
              <line x1="28" y1="61" x2="492" y2="61" class="chart-gridline" />
              <text x="5" y="115" class="chart-label">0</text><text x="1" y="64" class="chart-label">32.5</text><text x="1" y="14" class="chart-label">65</text>
              <polyline points={miniScoreRaw17B} class="score-raw" />
              <polyline points={miniScoreTrend17B} class="score-trend mini" />
              {dynamics17B.candidateRounds.map((round) => <line x1={miniScoreX17B(round)} x2={miniScoreX17B(round)} y1="115" y2="122" class="candidate-tick" />)}
              {dynamics17B.acceptedRounds.map((round) => <line x1={miniScoreX17B(round)} x2={miniScoreX17B(round)} y1="113" y2="124" class="accepted-tick" />)}
            </svg>
          </figure>
          <figure class="mini-loss-chart">
            <figcaption>{t('canonical W&B 中可核验的 loss：7 个被 GDR 接纳的更新', 'Verifiable loss in canonical W&B: the 7 updates admitted by GDR')}</figcaption>
            <svg viewBox="0 0 520 68" role="img" aria-label={t('1.7B 七个被接纳 SD-LoRA 更新的训练 loss', 'Training loss for the seven admitted 1.7B SD-LoRA updates')}>
              <line x1="28" y1="60" x2="492" y2="60" class="chart-axis" />
              <polyline points={miniLossPoints17B} class="loss-line mini" />
              {dynamics17B.loss.map((point) => <circle cx={miniLossX17B(point.round)} cy={miniLossY17B(point.loss)} r="3.2" class="loss-dot accepted" />)}
              <text x="30" y="12" class="chart-label">{firstLoss17B.toFixed(2)}</text><text x="455" y="50" class="chart-label">{lastLoss17B.toFixed(2)}</text>
            </svg>
          </figure>
          <div class="small-model-stats"><span><strong>44</strong>{t(' 个 SD-LoRA 候选实际训练', ' SD-LoRA candidates trained')}</span><span><strong>7</strong>{t(' 个进入后续模型', ' entered later model states')}</span><span><strong>37.60</strong>{t(' 冻结终评', ' frozen final')}</span></div>
          <p class="mini-boundary">{t('160 轮 / 20,480 次环境交互全部完成。W&B 对 44 个候选轮次都有发生记录，但候选被拒绝后没有保留可作为 authority 的 training_loss 字段；所以这里不补造 37 个 loss 点。', 'All 160 rounds / 20,480 environment interactions completed. W&B records all 44 candidate-attempt rounds, but rejected candidates do not retain an authoritative training_loss field; we therefore do not fabricate 37 missing loss points.')}</p>
        </article>
        <article class="small-model-card three-b-card">
          <header><span>3B</span><div><h3>{t('另一条独立持续学习线也确实学起来了', 'The independent 3B continual-learning line also shows learning')}</h3><p>{t('Qwen2.5-3B 先按 180×8 的第一阶段采集 1,440 条轨迹，后续进入独立的持续学习实验线。', 'Qwen2.5-3B first collected 1,440 Stage-1 trajectories under the 180×8 schedule, then entered its own continual-learning line.')}</p></div></header>
          <div class="three-b-preview">
            <div><strong>{earlyScoreMean.toFixed(2)} → {lateScoreMean.toFixed(2)}</strong><span>{t('前 20 轮 → 最后 23 轮平均任务 Score', 'first-20 → last-23 mean training-round Score')}</span></div>
            <div><strong>{firstLoss.toFixed(2)} → {lastLoss.toFixed(2)}</strong><span>{t('已记录候选训练 loss', 'recorded candidate-training loss')}</span></div>
            <div><strong>—</strong><span>{t('没有同口径冻结终评，不硬填最终分数', 'no same-protocol frozen final score; leave it blank')}</span></div>
          </div>
          <p class="three-b-next">{t('下一页把 3B 的完整 123 轮 Score 与候选训练 loss 展开。它帮助排除“这条训练线根本没工作”的简单工程解释，但不能代替冻结终评。', 'The next slide expands the full 123-round 3B Score and candidate-training loss. It rules out the simple engineering claim that this training line never worked, but it cannot substitute for a frozen final evaluation.')}</p>
        </article>
      </div>
      <p class="slide-number">05 / 12</p>
    </div>
  </section>

  <section id="training-dynamics" class="briefing-slide tone-blue" aria-labelledby="training-dynamics-title">
    <div class="slide-inner dynamics-slide">
      <h2 id="training-dynamics-title">{t('3B：任务得分上升，训练 loss 同时下降', '3B: task score rises while training loss falls')}</h2>
      <p class="slide-thesis">{t(`左图是每轮 WebShop 任务得分（Score），不是 loss：123 个已封存 round 中，前 20 轮平均 ${earlyScoreMean.toFixed(2)} / 100，最后 23 轮平均 ${lateScoreMean.toFixed(2)} / 100。右图才是 SD-LoRA 训练 loss：从 ${firstLoss.toFixed(2)} 降到约 ${lastLoss.toFixed(2)}。`, `The left chart is per-round WebShop task Score, not loss: across 123 sealed rounds, the first 20 average ${earlyScoreMean.toFixed(2)} / 100 and the last 23 average ${lateScoreMean.toFixed(2)} / 100. The right chart is SD-LoRA training loss, falling from ${firstLoss.toFixed(2)} to about ${lastLoss.toFixed(2)}.`)}</p>
      <div class="dynamics-grid">
        <figure class="dynamics-chart score-chart">
          <figcaption>{t('每轮 WebShop Score', 'WebShop Score by round')} <span>{t('细线=原始轮次；粗线=12轮移动平均', 'thin=raw rounds; thick=12-round moving average')}</span></figcaption>
          <svg viewBox="0 0 700 248" role="img" aria-label={t('3B 每轮 WebShop Score 与移动平均曲线', '3B WebShop Score and moving-average curve by round')}>
            <line x1="42" y1="220" x2="676" y2="220" class="chart-axis" />
            <line x1="42" y1="127.3" x2="676" y2="127.3" class="chart-gridline" />
            <line x1="42" y1="34.5" x2="676" y2="34.5" class="chart-gridline" />
            <text x="14" y="224" class="chart-label">0</text><text x="8" y="131" class="chart-label">10</text><text x="8" y="38" class="chart-label">20</text>
