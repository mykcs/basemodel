---
import type { Locale } from '../../i18n';
import SeedOpenEvoResearchPageCore from './SeedOpenEvoResearchPageCore.astro';
import ExplainerScrollLink from './ExplainerScrollLink.astro';

type DetailPage = 'seed' | 'openevo' | 'benchmarks' | 'webshop' | 'alfworld' | 'loops' | 'results';
interface Props { locale: Locale; page: DetailPage }
const { locale, page } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const hasExplainer = Astro.slots.has('default');

const copy: Record<DetailPage, { title: string; lede: string }> = {
  seed: {
    title: t('SEED 学习流程与参数更新', 'SEED learning flow and parameter updates'),
    lede: t('SEED 是一种让 Agent 用自己的任务轨迹继续训练 policy 的方法。在这套 WebShop 复现里，Stage 1 先收集 Qwen 完成的购物轨迹，再由外部 GLM-5.2 生成 hindsight skill 做 SFT；Stage 2 改由当前 policy 自己复盘，并通过 OPD 与 GRPO 更新参数。', 'SEED is a method for training an agent policy from its own task trajectories. In this WebShop reproduction, Stage 1 first collects completed Qwen shopping trajectories, then external GLM-5.2 produces hindsight skills for SFT; Stage 2 moves the reflection into the current policy and updates parameters with OPD and GRPO.'),
  },
  openevo: {
    title: t('OpenEvo 跨任务演化流程', 'OpenEvo cross-task evolution flow'),
    lede: t('OpenEvo 是一个让 Agent 在任务之间保留并验证学习结果的演化框架：每次任务结束后先封存真实证据，再运行声明的演化方法；只有通过验证的 artifact、adapter 或 revision 才从后续任务开始生效。', 'OpenEvo is an evolution framework for preserving and validating what an agent learns across tasks: each completed task first seals its evidence, then runs the declared evolution method; only validated artifacts, adapters, or revisions activate on later tasks.'),
  },
  benchmarks: {
    title: t('ALFWorld 与 WebShop', 'ALFWorld and WebShop'),
    lede: t('两种 benchmark 的任务结构、动作空间和评分方式不同，应分别保存结果和失败模式。', 'The benchmarks use different task structures, action spaces, and scoring, so outcomes and failure modes should be recorded separately.'),
  },
  webshop: {
    title: t('WebShop 任务与评测', 'WebShop tasks and evaluation'),
    lede: t('WebShop 是一个模拟电商网站 benchmark：Agent 根据自然语言购物要求连续搜索、浏览、选择商品属性并完成购买。SEED 用它评测长程 Agent，并分别报告 normalized Score 与 exact Success。', 'WebShop is a simulated e-commerce benchmark where an agent follows a natural-language shopping request through repeated search, browsing, product-option selection, and purchase. SEED uses it to evaluate long-horizon agents and reports normalized Score and exact Success separately.'),
  },
  alfworld: {
    title: t('ALFWorld 任务与评测', 'ALFWorld tasks and evaluation'),
    lede: t('ALFWorld 是一个文本化具身任务 benchmark：Agent 根据家务目标在可执行世界里移动、拿取、打开、放置、加热等，直到满足终局条件。这里分别记录任务是否成功、各任务家族成功率和 macro-average；这些指标不能和 WebShop normalized Score 混用。', 'ALFWorld is a text-based embodied-task benchmark where an agent follows household goals by moving, picking up, opening, placing, heating, and otherwise changing an executable world until the terminal condition is satisfied. We report task success, task-family success rates, and the macro-average separately; these metrics are not interchangeable with WebShop normalized Score.'),
  },
  loops: {
    title: t('SEED 与 OpenEvo 更新机制', 'SEED and OpenEvo update mechanisms'),
    lede: t('比较两种方法的经验来源、更新对象、生效边界与下一轮如何继续。', 'Compare experience sources, updated objects, activation boundaries, and how the next round proceeds.'),
  },
  results: {
    title: t('OpenEvo × WebShop 研究结果', 'OpenEvo × WebShop research findings'),
    lede: t('我们从七个最自然的问题开始：OpenEvo 有没有学习、有没有成功经验、能不能迁移、能不能持续变好，以及最后能不能和 SEED 在同一套正式评估下比较。', 'We start from seven natural questions: whether OpenEvo learns, whether it has successful experience to learn from, whether that transfers, whether improvement continues, and whether it can ultimately be compared with SEED under the same formal evaluation.'),
  },
};

const current = copy[page];
---
<div class:list={['plain-detail', { 'plain-detail--results': page === 'results' }]} data-locale={locale}>
  {page !== 'results' && (
    <header class="plain-detail__header">
      <h1>{current.title}</h1>
      <p>{current.lede}</p>
    </header>
  )}
  {hasExplainer && <div class="plain-detail__interactive"><slot /></div>}
  {page !== 'results' && page !== 'webshop' && <div class="plain-detail-core"><SeedOpenEvoResearchPageCore locale={locale} page={page} /></div>}
  {hasExplainer && page !== 'results' && <ExplainerScrollLink />}
</div>

<style>
  .plain-detail{width:min(1160px,calc(100% - 2rem));margin:1rem auto 4rem}
  .plain-detail__header{max-width:900px;padding:clamp(1.6rem,4vw,3.2rem) 0 1.3rem}
  .plain-detail__header h1{margin:0 0 .7rem;letter-spacing:-.035em}
  .plain-detail__header p{max-width:70ch;margin:0;color:var(--muted);font-size:1rem;line-height:1.72}
  .plain-detail__interactive{margin:0 0 2.6rem}
  .plain-detail__interactive :global(.irx){width:100%;margin:0}
  .plain-detail-core{padding-top:.4rem;border-top:1px solid color-mix(in srgb,var(--line) 74%,transparent)}
  .plain-detail-core :global(.mission-page){width:100%;margin:0}
  .plain-detail-core :global(.mission-page__header),.plain-detail-core :global(.mission-tabs){display:none}
  .plain-detail__interactive :global(.irx + .irx){margin-top:1.5rem}
  .plain-detail-core{width:min(780px,100%);margin-inline:auto}
  @media(max-width:720px){.plain-detail{width:min(100% - 1rem,1160px)}.plain-detail__header{padding-top:1.2rem}.plain-detail__header p{font-size:.9rem}.plain-detail__interactive{margin-bottom:1.6rem}}
</style>

<style is:global>
  .plain-detail[data-locale='zh'] .paper-nav::before,
  .plain-detail[data-locale='en'] .paper-nav::before{
    flex:0 0 auto;
    padding-right:.8rem;
    border-right:1px solid var(--line);
    color:var(--ink);
    font:800 .64rem/1.5 var(--font-mono);
    letter-spacing:.06em;
  }
  .plain-detail[data-locale='zh'] .paper-nav::before{content:'本页内容'}
  .plain-detail[data-locale='en'] .paper-nav::before{content:'On this page'}

  @media(max-width:720px){
    .plain-detail[data-locale] .paper-nav::before{width:100%;padding:0 0 .35rem;border-right:0;border-bottom:1px solid var(--line)}
  }

  @media print {
    body:has(.plain-detail--results) .site-header,
    body:has(.plain-detail--results) .research-context-bar,
    body:has(.plain-detail--results) .plain-detail__nav,
    body:has(.plain-detail--results) .plain-detail__header,
    body:has(.plain-detail--results) .research-navigation,
    body:has(.plain-detail--results) .page-outline,
    body:has(.plain-detail--results) .compare-tray,
    body:has(.plain-detail--results) .global-quick-view,
    body:has(.plain-detail--results) .actionable-content-status,
    body:has(.plain-detail--results) .actionable-copy-button,
    body:has(.plain-detail--results) .actionable-inline-copy-button,
    body:has(.plain-detail--results) .skip-link,
    body:has(.plain-detail--results) .site-footer {
      display: none !important;
    }

    body:has(.plain-detail--results) .plain-detail,
    body:has(.plain-detail--results) .plain-detail__interactive {
      width: 100%;
      margin: 0;
    }

    body:has(.plain-detail--results) .actionable-inline-code {
      cursor: auto;
      text-decoration: none;
    }

    body:has(.plain-detail--results) .actionable-inline-code::after {
      display: none;
    }
  }
</style>
