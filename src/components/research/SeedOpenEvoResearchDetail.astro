---
import type { Locale } from '../../i18n';
import SeedOpenEvoResearchPageCore from './SeedOpenEvoResearchPageCore.astro';
import SeedOpenEvoResearchNav from './SeedOpenEvoResearchNav.astro';
import ExplainerScrollLink from './ExplainerScrollLink.astro';

type DetailPage = 'base-model' | 'seed' | 'openevo' | 'benchmarks' | 'webshop' | 'alfworld' | 'loops' | 'results';
interface Props { locale: Locale; page: DetailPage }
const { locale, page } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const hasExplainer = Astro.slots.has('default');

const copy: Record<DetailPage, { eyebrow: string; title: string; lede: string }> = {
  'base-model': {
    eyebrow: t('实验模型', 'Experiment model'),
    title: t('Qwen2.5-3B-Instruct 实验设置', 'Qwen2.5-3B-Instruct experiment setup'),
    lede: t('同一个模型名不能唯一确定实验状态：checkpoint、revision、精度、量化、上下文、推理后端和权重更新方式都会改变实际运行或训练条件，因此这些身份必须一起记录。', 'A model name alone does not uniquely identify an experiment state: checkpoint, revision, precision, quantization, context, inference backend, and weight-update mode can all change the actual runtime or training conditions, so these identities must be recorded together.'),
  },
  seed: {
    eyebrow: t('方法', 'Method'),
    title: t('SEED 方法与参数更新', 'SEED method and parameter updates'),
    lede: t('SEED 从完整轨迹生成 hindsight skill，并通过 OPD 与 RL 把学习信号写回 policy 参数。', 'SEED generates hindsight skills from completed trajectories and writes the learning signal back into policy parameters through OPD and RL.'),
  },
  openevo: {
    eyebrow: t('方法', 'Method'),
    title: t('OpenEvo 演化流程', 'OpenEvo evolution flow'),
    lede: t('OpenEvo 以任务边界封存证据，运行演化方法，并让后续任务加载接受的 artifact、adapter 或 revision。', 'OpenEvo seals evidence at task boundaries, runs evolution methods, and lets later tasks load accepted artifacts, adapters, or revisions.'),
  },
  benchmarks: {
    eyebrow: t('实验环境', 'Experiment environments'),
    title: 'ALFWorld 与 WebShop',
    lede: t('两种 benchmark 的任务结构、动作空间和评分方式不同，因此结果和失败模式必须分别保存；否则同一个“成功率”或“分数”会混入不同语义。', 'The benchmarks use different task structures, action spaces, and scoring, so outcomes and failure modes must be recorded separately; otherwise a shared label such as “success rate” or “score” would mix different semantics.'),
  },
  webshop: {
    eyebrow: t('实验环境', 'Experiment environment'),
    title: t('WebShop 任务与评测', 'WebShop tasks and evaluation'),
    lede: t('从 Agent 怎么操作商店开始，一路看清原始 benchmark、官方 small 商品世界、synthetic goal generation、SEED goal split 和最终评分。', 'Start from how the Agent operates the shop, then follow the original benchmark, official small product world, synthetic goal generation, SEED goal split, and final evaluation.'),
  },
  alfworld: {
    eyebrow: t('实验环境', 'Experiment environment'),
    title: t('ALFWorld 世界状态与任务成功', 'ALFWorld world state and task success'),
    lede: t('沿着物体位置、容器状态、动作前置条件与终局目标，理解文本化具身任务的长期规划。', 'Follow object locations, receptacle state, action preconditions, and terminal goals through a text-based embodied task.'),
  },
  loops: {
    eyebrow: t('比较', 'Comparison'),
    title: t('SEED 与 OpenEvo 更新机制', 'SEED and OpenEvo update mechanisms'),
    lede: t('两种方法都可能改变后续行为，但更新对象和生效边界并不相同。因此不能把差异简化成“参数 vs memory”，而要同时比较经验来源、更新对象、生效边界以及下一轮如何继续。', 'Both methods can change later behavior, but their updated objects and activation boundaries differ. The comparison therefore cannot be reduced to “parameters vs memory”; it must also track experience source, updated object, activation boundary, and how the next round proceeds.'),
  },
  results: {
    eyebrow: t('研究结果', 'Research findings'),
    title: t('OpenEvo × WebShop 研究结果', 'OpenEvo × WebShop research findings'),
    lede: t('七个问题串起当前证据：OpenEvo 有没有学习、有没有成功经验、能不能迁移、能不能持续变好，以及 2026-08-25 的 SEED 官方保留任务首轮评测为什么还需要修复后复测。', 'Seven questions connect the current evidence: whether OpenEvo learns, whether successful experience exists, whether it transfers, whether improvement continues, and why the 2026-08-25 first SEED-held-out run still requires a repaired rerun.'),
  },
};

const current = copy[page];
---
<div class:list={['plain-detail', { 'plain-detail--results': page === 'results' }]} data-locale={locale}>
  <header class="plain-detail__header">
    <div>{current.eyebrow}</div>
    <h1>{current.title}</h1>
    <p>{current.lede}</p>
  </header>
  <SeedOpenEvoResearchNav locale={locale} page={page} />
  {hasExplainer && <div class="plain-detail__interactive"><slot /></div>}
  {page !== 'results' && page !== 'webshop' && <div class="plain-detail-core"><SeedOpenEvoResearchPageCore locale={locale} page={page} /></div>}
  {hasExplainer && page !== 'results' && <ExplainerScrollLink />}
</div>

<style>
  .plain-detail{width:min(1160px,calc(100% - 2rem));margin:1rem auto 4rem}
  .plain-detail__header{max-width:900px;padding:clamp(1.6rem,4vw,3.2rem) 0 1.3rem}
  .plain-detail__header>div{color:var(--accent-deep);font:800 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}
  .plain-detail__header h1{margin:.5rem 0 .7rem;letter-spacing:-.035em}
  .plain-detail__header p{max-width:70ch;margin:0;color:var(--muted);font-size:1rem;line-height:1.72}
  .plain-detail__interactive{margin:0 0 2.6rem}
  .plain-detail__interactive :global(.irx){width:100%;margin:0}
  .plain-detail-core{padding-top:.4rem;border-top:1px solid color-mix(in srgb,var(--line) 74%,transparent)}
  .plain-detail-core :global(.mission-page){width:100%;margin:0}
  .plain-detail-core :global(.mission-page__header),.plain-detail-core :global(.mission-tabs){display:none}
  .plain-detail__interactive :global(.irx + .irx){margin-top:1.5rem}
  .plain-detail-core{width:min(780px,100%);margin-inline:auto}
  @media(max-width:720px){.plain-detail{width:min(100% - 1rem,1160px)}.plain-detail__header{padding-top:1.2rem}.plain-detail__header p{font-size:.9rem}.plain-detail__interactive{margin-bottom:1.6rem}}
</style>

<style is:global>
  .plain-detail[data-locale='zh'] .paper-nav::before,
  .plain-detail[data-locale='en'] .paper-nav::before{
    flex:0 0 auto;
    padding-right:.8rem;
    border-right:1px solid var(--line);
    color:var(--ink);
    font:800 .64rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;
    letter-spacing:.06em;
  }
  .plain-detail[data-locale='zh'] .paper-nav::before{content:'本页内容'}
  .plain-detail[data-locale='en'] .paper-nav::before{content:'On this page'}

  @media(max-width:720px){
    .plain-detail[data-locale] .paper-nav::before{width:100%;padding:0 0 .35rem;border-right:0;border-bottom:1px solid var(--line)}
  }

  @media print {
    body:has(.plain-detail--results) .site-header,
    body:has(.plain-detail--results) .research-context-bar,
    body:has(.plain-detail--results) .plain-detail__header,
    body:has(.plain-detail--results) .research-navigation,
    body:has(.plain-detail--results) .page-outline,
    body:has(.plain-detail--results) .compare-tray,
    body:has(.plain-detail--results) .global-quick-view,
    body:has(.plain-detail--results) .actionable-content-status,
    body:has(.plain-detail--results) .actionable-copy-button,
    body:has(.plain-detail--results) .actionable-inline-copy-button,
    body:has(.plain-detail--results) .skip-link,
    body:has(.plain-detail--results) .site-footer {
      display: none !important;
    }

    body:has(.plain-detail--results) .plain-detail,
    body:has(.plain-detail--results) .plain-detail__interactive {
      width: 100%;
      margin: 0;
    }

    body:has(.plain-detail--results) .actionable-inline-code {
      cursor: auto;
      text-decoration: none;
    }

    body:has(.plain-detail--results) .actionable-inline-code::after {
      display: none;
    }
  }
</style>