---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import ParameterComparisonExample from './ParameterComparisonExample.astro';
import ResearchTaskContext from './ResearchTaskContext.astro';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchJourney from './ResearchJourney.astro';
import ResearchStateRail from './ResearchStateRail.astro';
import ResearchDepth from './ResearchDepth.astro';
import ExperimentLifecycle from './ExperimentLifecycle.astro';
import OpenEvoM1DResults from './OpenEvoM1DResults.astro';
import { OPEN_EVO_MECHANISM_SOURCE as source, OPEN_EVO_MECHANISM_EXPERIMENTS as experiments, OPEN_EVO_MECHANISM_BOUNDARIES, mechanismEvidenceUrl } from '../../data/openEvoMechanismNarrative';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const causal = experiments.filter((row) => row.track === 'causal');
const reference = experiments.find((row) => row.id === 'M1-D')!;
const amendment = mechanismEvidenceUrl(source.m1aAmendment);
const gateAmendment = mechanismEvidenceUrl(source.m1cAmendment);
const release = `https://github.com/mykcs/openevo-experiment/blob/${source.activationCommit}/${source.activationRelease}`;
const terms = zh ? [
  { term: 'OpenEvo', meaning: '让模型从自己完成的 WebShop 轨迹中继续学习；这里研究的是学习后参数和行为怎么一起变化。' },
  { term: '参数方向', meaning: '一次或一组训练更新把模型参数推向的方向；“变化大”本身还不能证明它有用。' },
  { term: '因果干预', meaning: '把真实变化加进去或拿出来，再和同幅度随机变化比较，观察行为是否因此改变。' },
  { term: 'M1-D', meaning: '独立的 SEED Stage1 初始化参照，只比较最初 1,440 条经验，不给 M1-C 提供方向信号。' },
] : [
  { term: 'OpenEvo', meaning: 'A framework that keeps learning from completed WebShop trajectories; here we study how learning changes both parameters and behavior.' },
  { term: 'parameter direction', meaning: 'The direction a training update moves model parameters; a large movement alone does not prove usefulness.' },
  { term: 'causal intervention', meaning: 'Add or remove the real change and compare it with equally sized random changes to test whether behavior changes because of that direction.' },
  { term: 'M1-D', meaning: 'An independent SEED Stage-1 initialization reference over 1,440 experiences; it does not supply the M1-C steering signal.' },
];
const m1dSteps = zh ? [
  { id: 'qualify', kicker: '开始', title: '先匹配任务、模型和运行环境', summary: '先核对模型身份、购物环境和服务接口；检查全部通过，并获得独立授权后，才能开始采集。', outcome: 'M1-D 获得 Stage1 执行权，但仍然没有结果。', state: '已授权' },
  { id: 'collect', kicker: '收集', title: '同一个 3B 模型完成 180 × 8 = 1,440 条', summary: '模型按 SEED 的方法完成规定的购物任务；MiniMax 不在购物过程中指导它。', outcome: '得到一份完整 raw Stage1 corpus。', state: '固定预算' },
  { id: 'seal', kicker: '固定记录', title: '核对并固定保存全部 1,440 次购物记录', summary: '保存完成证明和整批数据的校验值后，才发布完全成功率、平均分和无效尝试比例等结果。', outcome: 'raw 行为语料变成可审计、不可回写的证据。', state: '等待结果封存' },
  { id: 'analyze', kicker: '事后分析', title: 'MiniMax 对 1,440 / 1,440 做同口径事后分析', summary: '用同一个分析器，比较 SEED 与已有 OpenEvo 初始记录中的成功、错误、重复搜索和多样性。', outcome: '得到初始化教材的结构性差异，而不是 SEED 最终分数。', state: '已预注册' },
  { id: 'stop', kicker: '结束', title: '比较完成后硬停：SEED Stage2 = 0', summary: '比较完成即结束：不生成技能、不做监督微调、不进入 SEED 后续训练，也不使用最终测试题。', outcome: 'M1-D closeout，只回答“最初 1,440 条经验有什么不同”。', state: '硬边界' },
] : [
  { id: 'qualify', kicker: 'START', title: 'Match the task world, model identity, and runtime first', summary: 'Only after identity / world / endpoint qualification can the independent release authorize Stage 1.', outcome: 'M1-D gains execution authority but still has no result.', state: 'Authorized' },
  { id: 'collect', kicker: 'COLLECT', title: 'Use the same 3B model for 180 × 8 = 1,440 attempts', summary: 'Collect the frozen task set under SEED Stage-1 semantics; MiniMax does not guide online actions.', outcome: 'Produce one complete raw Stage-1 corpus.', state: 'Fixed budget' },
  { id: 'seal', kicker: 'SEAL', title: 'Seal all 1,440 trajectories and the corpus identity first', summary: 'Exact success, mean score, invalid rate, and related fields stay unpublished until the completion receipt and corpus SHA exist.', outcome: 'Turn raw behavior into auditable evidence that cannot be rewritten.', state: 'Awaiting result seal' },
  { id: 'analyze', kicker: 'POST-HOC', title: 'Run MiniMax on 1,440 / 1,440 with the same analysis contract', summary: 'Then compare the SEED corpus with existing OpenEvo 3B Stage 1 using the same analyzer for success, errors, loops, and diversity.', outcome: 'Measure structural differences in initialization experience, not SEED final performance.', state: 'Preregistered' },
  { id: 'stop', kicker: 'STOP', title: 'Hard stop after the comparison: SEED Stage 2 = 0', summary: 'No skill generation, SFT, SEED Stage 2 training, or final-panel access.', outcome: 'Close M1-D with only the initialization-corpus claim.', state: 'Hard boundary' },
];
const stateLifecycle = (row: (typeof experiments)[number]) => row.execution;
const stateItems = experiments.map((row) => ({
  id: row.id,
  name: row.name[locale],
  lifecycle: stateLifecycle(row),
  lifecycleLabel: row.state[locale],
  resultLabel: row.results === 'sealed' ? (zh ? '结果已封存' : 'Result sealed') : (zh ? '结果未封存' : 'Result unsealed'),
  note: row.id === 'M1-D' ? (zh ? '独立初始化参照，不给 M1-C 提供方向信号。' : 'Independent initialization reference; it does not supply the M1-C direction signal.') : undefined,
  current: row.id === 'M1-D',
}));
---
<article class="mechanism-map" data-testid="openevo-mechanism-map" data-reader-page="mechanism" data-ui-audit="contrast layout">
  <ResearchOrientation
    locale={locale}
    eyebrow="OPENEVO × WEBSHOP · MECHANISM-1.0"
    title={t("AI 练习购物后，哪些变化真的有用？", "What changes help AI after shopping practice?")}
    lede={t("我们研究 AI 能不能从自己的尝试中学习：让模型在模拟商店按要求买东西，再用这些经验训练它。前面的实验关注“能做到多好”；本页进一步检查，训练留下的哪些内部变化真的影响了购物表现。下面先用一次购物说明任务，再解释怎样做对照实验。", "We train AI on its attempts in a simulated shop. Earlier experiments measured performance; this page tests which internal changes affect it. Start with one shopping example below.")}
    question={t("学习带来的内部变化，真的影响购物能力吗？", "Do changes from learning affect shopping ability?")}
    why={t("只看分数还不知道原因；弄清哪些变化有用，才能为改进学习方法提供依据。", "Scores alone do not explain why. Finding useful changes can inform better learning methods.")}
    start={t("从已经保存的训练历史中选取可区分的模型状态，并取得各实验的执行授权。", "Choose distinct saved model states and obtain authority for each experiment.")}
    finish={t("A/B 检验方向；通过门槛才可申请 C。D 独立在 1,440 次尝试及分析比较后结束。", "A/B test directions; passing the gate permits a request for C. D stops independently after 1,440 attempts and analysis.")}
    state={t("A、B、C 尚未获执行授权；D 已授权，结果未封存。", "A, B and C are not authorized; D is authorized and its results are unsealed.")}
    stateTone="authorized"
    backHref={p('/research/seed-openevo/study/capability-exploration/')}
    backLabel={t('OpenEvo 能力探索', 'OpenEvo capability exploration')}
    actionHref="#shopping-task"
    actionLabel={t('先看一次购物任务', 'Start with one shopping task')}
    terms={terms}
  />

  <ResearchTaskContext locale={locale} />

  <ParameterComparisonExample locale={locale} />

  <ResearchStateRail
    locale={locale}
    title={t('先看谁有执行权、谁已经有结果', 'Separate execution authority from scientific results')}
    intro={t('“已授权”只代表可以按固定合同运行；“结果已封存”才代表网站可以发布科学结果。', '“Authorized” only means the fixed contract may execute; scientific results become publishable only after a result seal.')}
    items={stateItems}
  />

  <section class="mechanism-map__section" id="experiment-dependencies" aria-labelledby="mechanism-dependency-title">
    <h2 id="mechanism-dependency-title">{t('主实验的依赖关系', 'Dependencies between the causal experiments')}</h2>
    <figure class="mechanism-route" data-testid="mechanism-dependency-map">
      <div class="mechanism-route__origin" data-dependency="source">{t('先核验已封存的训练历史和参数分析', 'First verify the sealed training history and parameter analysis')}</div>
      <svg class="mechanism-route__connector" viewBox="0 0 20 32" aria-hidden="true"><path d="M10 1v27M4 22l6 6 6-6" /></svg>
      <ul class="mechanism-route__fork" aria-label={t('两个不同的因果问题', 'Two distinct causal questions')}>
        <li data-ui-audit-item><a href="#m1-a" data-dependency="M1-A"><span>M1-A</span><strong>{t('加上真实变化', 'Add the real change')}</strong><p>{t('检验：移植到更早的模型后，行为是否改变。', 'Test whether transplanting it to an earlier model changes behavior.')}</p></a></li>
        <li data-ui-audit-item><a href="#m1-b" data-dependency="M1-B"><span>M1-B</span><strong>{t('移除主要变化', 'Remove a major change')}</strong><p>{t('检验：移除之后，行为是否额外受损。', 'Test whether removing it causes extra behavioral harm.')}</p></a></li>
      </ul>
      <svg class="mechanism-route__connector" viewBox="0 0 20 32" aria-hidden="true"><path d="M10 1v27M4 22l6 6 6-6" /></svg>
      <div class="mechanism-route__gate" data-dependency="gate"><strong>{t('特定方向有效的证据达到门槛了吗？', 'Does evidence for a useful direction pass the threshold?')}</strong><p>{t('先检查 M1-A 修订结果；未通过时再检查 M1-B 的第一组变化。', 'Check the M1-A successor first; if it does not pass, check M1-B Theme 1.')}</p></div>
      <svg class="mechanism-route__connector" viewBox="0 0 20 32" aria-hidden="true"><path d="M10 1v27M4 22l6 6 6-6" /></svg>
      <ul class="mechanism-route__fork" aria-label={t('门槛检查的两个分支', 'Two possible gate outcomes')}>
        <li data-ui-audit-item><a href="#m1-c" data-dependency="M1-C"><span>{t('通过门槛，并另获执行授权', 'Gate passes, plus separate execution authority')}</span><strong>{t('M1-C · 指导后续学习', 'M1-C · Guide later learning')}</strong><p>{t('三组各 512 次尝试，修改幅度和任务预算相同。', 'Three arms, 512 attempts each, with equal update magnitude and task budgets.')}</p></a></li>
        <li class="mechanism-route__stop" data-dependency="stop" data-ui-audit-item><span>{t('未通过门槛', 'Gate does not pass')}</span><strong>{t('结束这条路线，不启动 M1-C', 'End this route without starting M1-C')}</strong><p>{t('记录没有方向特异信号，不为了得到正结果临时换方向。', 'Record no direction-specific signal; do not switch directions to chase a positive result.')}</p></li>
      </ul>
      <figcaption>{t('连接线表示证据依赖，不表示实验已经运行。点选实验可跳到它的开始、结束与产出条件。', 'Connections represent evidence dependencies, not completed execution. Select an experiment to inspect its start, stop, and output conditions.')}</figcaption>
    </figure>
    <aside class="mechanism-map__reference-branch" data-dependency="M1-D"><strong>{t('独立参照：M1-D', 'Independent reference: M1-D')}</strong><p>{t('它比较最初收集的购物经验，不提供 M1-C 的方向信号，也不是主实验的第四步。', 'It compares initially collected shopping experience. It does not supply a direction signal to M1-C and is not a fourth sequential step.')}</p><a href="#m1-d">{t('查看初始化参照的条件', 'Inspect the initialization-reference conditions')}</a></aside>
  </section>

  <section class="mechanism-map__section" id="causal-experiments" aria-labelledby="mechanism-causal-title">
    <h2 id="mechanism-causal-title">{t('主实验的开始与结束', 'Start and stop conditions of the causal experiments')}</h2>
    <p>{t('主实验使用 Qwen3-1.7B 模型；独立参照使用 Qwen2.5-3B 模型。1.7B、3B 是模型规模的名称，不是分数。', 'The causal experiments use Qwen3-1.7B; the independent reference uses Qwen2.5-3B. The 1.7B and 3B labels describe model sizes, not scores.')}</p>
    <p class="mechanism-map__amendment" data-predecessor-status="not-identifiable">{t('原 M1-A 的两个末段取点对应同一个模型，没有实际参数差异，所以无法检验原定方向。这是取点不可识别，不是已经测得“变化没有用”。修订实验改用相邻且互不相同的接受状态；它仍需独立授权。', 'The original M1-A late anchors resolve to the same model, leaving no parameter difference to test. This is non-identifiability, not a measured absence of causal effect. A separate successor uses adjacent distinct accepted states and still requires independent authority.')}</p>
    {causal.map((row) => <ExperimentLifecycle experiment={row} locale={locale} />)}
    <div class="mechanism-map__threshold" data-reader-gate>
      <h3>{t('后续学习的放行门槛', 'The gate for guided learning')}</h3>
      <p>{t('优先采用 M1-A 修订方向：加上完整变化后，平均任务分比三个随机对照的中位数至少高 1 分，且完整成功次数不比原模型少。', 'Prefer the M1-A successor direction: its full positive change must beat the median of all three random controls by at least one mean task-score point, without reducing exact-success count relative to the baseline.')}</p>
      <p>{t('若上述条件未通过，再检查 M1-B 的第一组变化：移除它造成的平均分损失，比每一个随机移除对照至少多 1 分，且完整成功次数没有增加。两者都未通过就不启动 M1-C。', 'Otherwise check M1-B Theme 1: removing it must hurt mean score at least one point more than every random-removal control, without increasing exact-success count. If neither passes, M1-C does not start.')}</p>
      <a href={gateAmendment} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={gateAmendment} />{t('门槛修订依据（需仓库权限）', 'Gate amendment (repository access required)')}</a>
    </div>
    <details class="mechanism-map__details">
      <summary>{t('技术细节：原取点、修订取点与随机对照', 'Technical detail: original anchors, successor selection, and random controls')}</summary>
      <p>{t('原预注册的 25% / 50% / 75% / 100% 分别对应 R27 / R49 / R49 / R49。因此 theta_100% − theta_75% 为零向量；原预注册保留并标记 BLOCKED_NOT_IDENTIFIABLE，不能供给 M1-C 信号。', 'The original 25% / 50% / 75% / 100% anchors map to R27 / R49 / R49 / R49. Thus theta_100% − theta_75% is a zero vector. Preserve that preregistration as BLOCKED_NOT_IDENTIFIABLE; it cannot supply the M1-C signal.')}</p>
      <p>{t('修订实验机械选取 S(K−2)、S(K−1)、S(K)，用最后两个状态之差作为 TaskVector，移植到 S(K−2)。三份 adapter 身份必须两两不同，Gram 范数有限且大于 0；不根据 reward 挑选另一个窗口。', 'The successor mechanically selects S(K−2), S(K−1), and S(K). The difference of the last two is the TaskVector, transplanted to S(K−2). Adapter identities must be pairwise distinct and the Gram norm finite and positive; reward does not select another window.')}</p>
      <p>{t('M1-A 保留 +0.5τ、+1τ、−1τ、三个 Gram 范数匹配随机方向及自然状态对照。M1-B 在看行为结果前，按 contribution_norm 冻结前三个 principal parameter themes。M1-C 的方向微调为候选 Gram 范数的 10%，随后缩放回原范数；零更新仍为零更新。', 'M1-A preserves +0.5τ, +1τ, −1τ, three Gram-norm-matched random directions, and natural-state references. M1-B freezes the top three principal parameter themes by contribution_norm before behavioral outcomes. M1-C uses a 10%-of-candidate-Gram-norm nudge, then rescales to the original norm; a zero update remains a no-op.')}</p>
      <a href={amendment} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={amendment} />{t('原预注册处置与独立修订（需仓库权限）', 'Predecessor disposition and separate successor (repository access required)')}</a>
    </details>
  </section>

  <section class="mechanism-map__section" id="initialization-reference" aria-labelledby="mechanism-reference-title">
    <h2 id="mechanism-reference-title">{t('独立参照 M1-D：从哪里开始，在哪里硬停？', 'Independent reference M1-D: where does it start and where does it hard-stop?')}</h2>
    <p>{t('M1-D 只比较初始化阶段收集的购物经验。它不提供 M1-C 的方向信号，也不继续执行 SEED 后续训练。', 'M1-D compares only the shopping experience collected during initialization. It does not supply the M1-C direction signal and does not continue into later SEED training.')}</p>
    <ResearchJourney locale={locale} title={t('M1-D 的完整生命周期', 'The complete M1-D lifecycle')} intro={t('核对前提 → 购物 1,440 次 → 固定记录 → MiniMax 事后分析 → 比较 → 结束。', 'START → 1,440 → trajectory seal → MiniMax → matched compare → STOP.')} steps={m1dSteps} compact />
    <ExperimentLifecycle experiment={reference} locale={locale} />
    <OpenEvoM1DResults locale={locale} />
  </section>

  <section class="mechanism-map__section" id="evidence-boundary" aria-labelledby="mechanism-boundary-title">
    <h2 id="mechanism-boundary-title">{t('证据边界与来源', 'Evidence boundaries and sources')}</h2>
    <ul>{OPEN_EVO_MECHANISM_BOUNDARIES[locale].map((item) => <li>{item}</li>)}</ul>
    <p>{t('诊断任务来自规定的训练任务范围，不能据此宣称对全新任务普遍有效。M1-D 只解释初始化经验，不能与 SEED 论文最终分数直接相减来声称方法优势。', 'Diagnostics use the prescribed training-task range; they do not establish generalization to fresh tasks. M1-D addresses initialization experience only; subtracting a SEED paper-final score cannot establish a method advantage.')}</p>
    <ResearchDepth locale={locale} kind="operations" summary={t('运行依据：授权、共享 GPU 与分析器绑定', 'Operational provenance: release, shared GPUs, and analyzer binding')}>
      <p>{t('以下是执行授权的历史记录，不是实时占用监控。放行记录只授权 M1-D Stage1；不能用它启动 M1-A/B/C。正式采集单 GPU、9000 MiB、无抢占。', 'These are execution-authorization records, not live occupancy. The release authorizes M1-D Stage1 only, not M1-A/B/C. Formal collection uses one GPU, 9000 MiB, and no preemption.')}</p>
      <dl class="mechanism-map__technical-facts"><div><dt>GPU0–3 SHARED RAY</dt><dd>GPU0–3 SHARED RAY = AUTHORIZED</dd></div><div><dt>M1-D Stage1</dt><dd>M1-D STAGE1 = ACTIVATED</dd></div><div><dt>MiniMax</dt><dd>{source.minimaxBinding}</dd></div></dl>
      <a href={release} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={release} />{t('独立放行记录（需仓库权限）', 'Independent execution release (repository access required)')}</a>
    </ResearchDepth>
    <footer class="mechanism-map__provenance">{t('科学来源', 'Scientific source')}：openevo-experiment/{source.branch} · <time datetime={source.checkedDate}>{source.checkedDate}</time> · <code>{source.mergedCommit.slice(0, 8)}</code>. {t('网站投影已核对的设计与授权，不自行授予实验执行权。', 'The website projects verified design and authorization; it never grants experiment execution authority.')}</footer>
  </section>
</article>
<style>
.mechanism-map{width:min(1120px,calc(100% - 2rem));margin:1.5rem auto 4rem;color:var(--ink);font-size:1rem;line-height:1.75}.mechanism-map__hero{padding-bottom:1.25rem;border-bottom:1px solid var(--line)}.mechanism-map__back{font-size:.9rem;color:var(--accent-deep);text-underline-offset:.2em}.mechanism-map h1{font-size:clamp(2rem,3.4vw,2.8rem);line-height:1.3;letter-spacing:-.025em;margin:.7rem 0;max-width:24ch}.mechanism-map__lede{font-size:1.18rem;max-width:48rem;line-height:1.8;margin:.75rem 0}.mechanism-map__identity,.mechanism-map__time{font-size:.88rem;color:var(--muted);line-height:1.7}.mechanism-map__snapshot{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin:1.1rem 0}.mechanism-map__snapshot>div{min-width:0;border-left:3px solid var(--accent-deep);padding:.4rem 0 .4rem 1rem}.mechanism-map__snapshot dt{font-weight:750}.mechanism-map__snapshot dd{margin:.3rem 0 0}.mechanism-map__section{margin-top:2.25rem;padding-top:1.5rem;border-top:1px solid var(--line);min-width:0}.mechanism-map h2{font-size:1.6rem;line-height:1.4;margin:0 0 .8rem}.mechanism-map h3{font-size:1.25rem;line-height:1.5}.mechanism-map__section>p,.mechanism-map__section>ul{max-width:48rem;margin:.8rem 0;line-height:1.8}.mechanism-map a:focus-visible{outline:2px solid var(--accent-deep);outline-offset:4px}.mechanism-map__section a{color:var(--accent-deep);text-underline-offset:.2em}.mechanism-route{margin:1.3rem 0}.mechanism-route__origin,.mechanism-route__gate{width:min(100%,42rem);margin:auto;text-align:center;padding:.75rem 1rem;border-block:2px solid var(--line);box-sizing:border-box;background:var(--surface-muted)}.mechanism-route__gate p{margin:.4rem 0;line-height:1.7}.mechanism-route__connector{display:block;height:2rem;width:1.25rem;margin:auto;fill:none;stroke:var(--muted);stroke-width:1.5}.mechanism-route__fork{list-style:none;padding:1rem 0 0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;position:relative}.mechanism-route__fork::before{content:"";position:absolute;top:0;left:25%;width:50%;border-top:1px solid var(--muted)}.mechanism-route__fork>li{position:relative;min-width:0}.mechanism-route__fork>li::before{content:"";height:1rem;position:absolute;left:50%;top:-1rem;border-left:1px solid var(--muted)}.mechanism-route__fork a,.mechanism-route__stop{display:block;border:1px solid var(--line);border-radius:var(--radius-panel);padding:1rem;color:var(--ink);text-decoration:none;min-height:100%;box-sizing:border-box;background:var(--surface)}.mechanism-route__fork a:hover{border-color:var(--accent-deep);background:var(--surface-muted)}.mechanism-route__fork span{display:block;font-size:.85rem;font-weight:700;color:var(--accent-deep);margin-bottom:.35rem}.mechanism-route__fork strong{display:block;font-size:1.15rem}.mechanism-route__fork p{margin:.5rem 0 0;line-height:1.75;color:var(--ink)}.mechanism-route figcaption{font-size:.88rem;color:var(--muted);line-height:1.7;margin-top:.9rem}.mechanism-map__reference-branch{border-left:3px dashed var(--color-info);padding:.75rem 1rem;background:var(--surface-muted);max-width:48rem}.mechanism-map__reference-branch p{margin:.4rem 0}.mechanism-map__amendment{padding:.8rem 1rem;border-left:3px solid var(--color-warning);background:var(--surface-muted)}.mechanism-map__threshold{padding:1rem 0;border-top:1px solid var(--line);max-width:48rem}.mechanism-map__threshold h3{margin:0}.mechanism-map__threshold p{line-height:1.8}.mechanism-map__details{padding:1rem 0;border-top:1px solid var(--line);margin-top:1rem}.mechanism-map__details summary{cursor:pointer;font-weight:700;min-height:44px;display:list-item;line-height:1.7}.mechanism-map__details summary:focus-visible{outline:2px solid var(--accent-deep);outline-offset:4px}.mechanism-map__details p{max-width:48rem;line-height:1.8}.mechanism-map__details a{display:inline-flex;align-items:center;gap:.4rem;max-width:100%;flex-wrap:wrap}.mechanism-map__technical-facts{margin:1rem 0;overflow-wrap:anywhere}.mechanism-map__technical-facts dt{font-weight:700}.mechanism-map__technical-facts dd{margin:.25rem 0 1rem}.mechanism-map__provenance{font-size:.85rem;color:var(--muted);line-height:1.75;margin-top:1rem;overflow-wrap:anywhere}.mechanism-map__provenance code{font-size:inherit}@media(max-width:760px){.mechanism-map{width:calc(100% - 2rem);margin-top:1rem}.mechanism-map__snapshot{grid-template-columns:1fr;gap:.75rem}.mechanism-map h1{font-size:2rem}.mechanism-map__lede{font-size:1.05rem}.mechanism-route__fork{grid-template-columns:1fr;gap:.8rem;padding:0 0 0 1rem;border-left:1px solid var(--muted)}.mechanism-route__fork::before{display:none}.mechanism-route__fork>li::before{left:-1rem;top:1.5rem;width:1rem;height:0;border-left:0;border-top:1px solid var(--muted)}.mechanism-route__connector{margin-left:0}.mechanism-route__origin,.mechanism-route__gate{text-align:left}.mechanism-map__section{margin-top:1.5rem;padding-top:1.25rem}}@media print{.mechanism-map{width:100%;margin:0}.mechanism-route__fork a{color:var(--ink)}}
