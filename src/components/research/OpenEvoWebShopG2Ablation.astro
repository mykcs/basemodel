---
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const evidenceRoot = 'https://github.com/mykcs/openevo-experiment/blob/476039e9ce82767120db803d57f016db3b1414ce';
const h142Root = 'https://github.com/mykcs/openevo-experiment/blob/d1f35ecdf84c61b07df7c646e83588d63b9297bd';

const gates = [
  {
    id: 'gate-1',
    badge: t('未通过', 'Failed'),
    title: t('Gate 1 · 新经验获取', 'Gate 1 · New experience acquisition'),
    subtitle: t('Acquisition —— G2 还能不能从新任务里学到东西？', 'Acquisition — can G2 still learn from new tasks?'),
    points: [
      t('H1.41 C0 acquisition 点估计 = 0，MEASUREMENT_INVALID。', 'H1.41 C0 acquisition point estimate = 0, MEASUREMENT_INVALID.'),
      t('H1.40：32 次尝试 / 28 次有效；唯一 4/4 parser-invalid 的 cell 属于测量无效，而非“能力为零”。', 'H1.40: 32 attempts / 28 valid; the single 4/4 parser-invalid cell is measurement-invalid, not “zero capability”.'),
    ],
    verdict: t('读法：新经验获取没有出现正向信号，但关键 cell 的测量本身先失效，结论只能是“未通过”，不能写成“能力已消失”。', 'Reading: acquisition showed no positive signal, but the key cell’s measurement failed first — the honest result is “gate not cleared”, not “capability gone”.'),
  },
  {
    id: 'gate-2',
    badge: t('未通过', 'Failed'),
    title: t('Gate 2 · 旧能力保留', 'Gate 2 · Prior capability retention'),
    subtitle: t('Retention —— 写入新经验后，旧能力是否被灾难性遗忘？', 'Retention — does writing new experience catastrophically forget the old?'),
    points: [
      t('H1.40 retention Δ = −0.1635，95% CI [−0.4073, 0.0355]。', 'H1.40 retention Δ = −0.1635, 95% CI [−0.4073, 0.0355].'),
      t('H1.41 校准复测：C0 / C1 两条 arm 的 retention 都是 −0.065625，方向一致为负。', 'H1.41 calibrated re-measurement: retention on both C0 and C1 arms = −0.065625, consistently negative.'),
    ],
    verdict: t('读法：灾难性遗忘是当前证据最强的瓶颈——新经验写入与旧能力保留没有同时成立。', 'Reading: catastrophic forgetting is the strongest evidenced bottleneck — new-experience write-in and old-capability retention did not hold together.'),
  },
  {
    id: 'gate-3',
    badge: t('未通过', 'Failed'),
    title: t('Gate 3 · 迁移延续性', 'Gate 3 · Sustained generalization'),
    subtitle: t('Preservation —— H1.39 已复现的单步迁移收益，能否在 G2 上保持？', 'Preservation — does the H1.39-replicated one-step transfer survive on G2?'),
    points: [
      t('preservation Δ = −0.0036，95% CI [−0.0801, 0.0755]，与 0 不可区分。', 'preservation Δ = −0.0036, 95% CI [−0.0801, 0.0755] — indistinguishable from zero.'),
      t('LoRA 参数增量覆盖后，正向迁移信号崩塌；预留的 T2 fresh-transfer 面板（t2Opened = false）从未打开。', 'After the LoRA parameter increments were overwritten, the positive transfer signal collapsed; the reserved T2 fresh-transfer panel (t2Opened = false) never opened.'),
    ],
    verdict: t('读法：单步迁移的可复现性只建立在 G1 上；多代写入后泛化未能延续。', 'Reading: one-step transfer replicates only on G1; generalization did not persist after multi-generation writes.'),
  },
] as const;
---

<section class="g2-ablation" id="g2-ablation" aria-labelledby="g2-ablation-title">
  <header class="section-heading">
    <p>G2 ABLATION</p>
    <div>
      <h2 id="g2-ablation-title">{t('第二代演化为什么受阻：三道门', 'Why second-generation evolution stalled: three gates')}</h2>
      <p>{t(
        '多代演化要成立，三道能力门必须同时通过：学到新经验、不丢旧能力、保住已复现的迁移收益。G2 的真实写入链条是完整的——上游 E2 harvest 256 次尝试筛出 132 条 qualified positive（33 个 qualifying identities，16 条入选记录），G2 写入 16 components · effective rank 64 · 8 个 sequential increments——但三道门都停在了“未通过”。',
        'Continual evolution requires three capability gates to clear together: acquiring new experience, retaining old capability, and preserving the already-replicated transfer gain. G2’s write chain is real — upstream E2 harvest filtered 256 attempts into 132 qualified positives (33 qualifying identities, 16 selected records), and G2 wrote 16 components at effective rank 64 across 8 sequential increments — yet all three gates stopped at “failed”.',
      )}</p>
    </div>
  </header>

  <div class="gate-grid">
    {gates.map((gate) => (
      <article class="gate-card" id={gate.id}>
        <div class="gate-top">
          <h3>{gate.title}</h3>
          <span class="gate-badge">{gate.badge}</span>
        </div>
        <p class="gate-subtitle">{gate.subtitle}</p>
        <ul>
          {gate.points.map((point) => <li>{point}</li>)}
        </ul>
        <p class="gate-verdict">{gate.verdict}</p>
      </article>
    ))}
  </div>

  <aside class="mechanism-note">
    <h3>{t('机制假说（H1.40-MD 解剖）', 'Mechanism hypothesis (H1.40-MD autopsy)')}</h3>
    <p>{t(
      '对 G2 参数做成分级解剖后，旧成分系数平均 ≈ 0.691，新写入成分 ≈ 0.181：新的 LoRA 增量在参数空间里被旧权重稀释。把 replay 从 62 条历史 + 2 条当前改为 48 + 16 后，遗忘幅度收窄。这是机制层面的诊断信号，不是因果证明——修测量优先于换方法。',
      'A component-level autopsy of G2 found old-component coefficients averaging ≈ 0.691 versus ≈ 0.181 for newly written increments: new LoRA increments are diluted by old weights in parameter space. Shifting replay from 62 historical + 2 current examples to 48 + 16 narrowed the forgetting. This is a mechanistic diagnostic signal, not causal proof — fixing measurement comes before swapping methods.',
    )}</p>
  </aside>

  <details class="evidence-details" id="evidence-g2" name="research-evidence">
    <summary>{t('证据链与代码回溯', 'Evidence chain & code provenance')}</summary>
    <div class="evidence-detail-body">
      <div class="evidence-link-grid">
        <a href={`${evidenceRoot}/docs/evidence/remote-runs/2026-08-20/h1.40-g2-r2/g2-training-reconciliation-v1.json`} target="_blank" rel="noreferrer">
          <small>Machine result</small><span>G2 training reconciliation（训练对账）</span><b aria-hidden="true">↗</b>
        </a>
        <a href={`${evidenceRoot}/docs/evidence/remote-runs/2026-08-20/h1.40-g2-r2/formal-upstream-evaluation-v5b-summary.json`} target="_blank" rel="noreferrer">
          <small>Machine result</small><span>Formal upstream summary（正式上游评估摘要）</span><b aria-hidden="true">↗</b>
        </a>
        <a href={`${evidenceRoot}/docs/evidence/remote-runs/2026-08-20/h1.40-g2-r2/FORMAL_UPSTREAM_EVALUATION_REPORT.md`} target="_blank" rel="noreferrer">
          <small>Human report</small><span>Formal upstream evaluation report（正式上游评估报告）</span><b aria-hidden="true">↗</b>
        </a>
        <a href={`${evidenceRoot}/docs/evidence/remote-runs/2026-08-20/h1.40-md/ARTIFACT_AUTOPSY.md`} target="_blank" rel="noreferrer">
          <small>Human report</small><span>H1.40-MD artifact autopsy（参数解剖）</span><b aria-hidden="true">↗</b>
        </a>
        <a href={`${h142Root}/docs/evidence/remote-runs/2026-08-21/h1.41/H141_RECONCILIATION_V5.md`} target="_blank" rel="noreferrer">
          <small>Machine result</small><span>H1.41 reconciliation（机制筛选对账）</span><b aria-hidden="true">↗</b>
        </a>
        <a href={`${h142Root}/docs/evidence/remote-runs/2026-08-21/h1.42-mv/H142_STAGE_B_CLOSEOUT.md`} target="_blank" rel="noreferrer">
          <small>Human report</small><span>H1.42 Stage B closeout（测量校准收口）</span><b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
  </details>
</section>

<style>
  .g2-ablation{max-width:1160px;margin:0 auto;padding:0 24px 52px;color:var(--color-text)}
  .section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}
  .section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.14em}
  .section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}
  .section-heading div>p{margin:0;max-width:72ch;color:var(--color-text-muted);font-size:.94rem;line-height:1.68}
  .gate-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .gate-card{padding:20px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}
  .gate-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
  .gate-card h3{margin:0;font-size:1.02rem;line-height:1.35;letter-spacing:-.02em}
  .gate-badge{flex-shrink:0;padding:3px 9px;border:1px solid var(--color-danger);border-radius:999px;color:var(--color-danger);font-size:.66rem;font-weight:750}
  .gate-subtitle{margin:8px 0 0;color:var(--color-text-muted);font-size:.76rem;line-height:1.55}
  .gate-card ul{margin:12px 0 0;padding-left:18px;display:grid;gap:8px}
  .gate-card li{color:var(--color-text-muted);font-size:.8rem;line-height:1.62;font-variant-numeric:tabular-nums}
  .gate-verdict{margin:14px 0 0;padding-top:12px;border-top:1px solid var(--color-border);font-size:.78rem;line-height:1.6}
  .mechanism-note{margin-top:12px;padding:20px;border:1px dashed var(--color-border);border-radius:15px;background:var(--color-surface)}
  .mechanism-note h3{margin:0 0 8px;font-size:.95rem;letter-spacing:-.015em}
  .mechanism-note p{margin:0;max-width:88ch;color:var(--color-text-muted);font-size:.84rem;line-height:1.68}
  .evidence-details{margin-top:12px;border-top:1px solid var(--color-border)}
  .evidence-details summary{display:flex;align-items:center;justify-content:space-between;cursor:pointer;padding:14px 0 2px;color:var(--color-accent);font-size:.78rem;font-weight:750;list-style:none}
  .evidence-details summary::-webkit-details-marker{display:none}
  .evidence-details summary::after{content:'＋';font-weight:500}
  .evidence-details[open] summary::after{content:'−'}
  .evidence-detail-body{padding:12px 0 2px}
  .evidence-link-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .evidence-link-grid a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:5px 10px;padding:12px;border:1px solid var(--color-border);border-radius:11px;background:var(--color-surface);color:var(--color-text);text-decoration:none}
  .evidence-link-grid a:hover,.evidence-link-grid a:focus-visible{border-color:var(--color-accent)}
  .evidence-link-grid small{grid-column:1;color:var(--color-accent);font:700 .65rem ui-monospace,SFMono-Regular,Menlo,monospace}
  .evidence-link-grid span{grid-column:1;font-size:.76rem;line-height:1.45;overflow-wrap:anywhere}
  .evidence-link-grid b{grid-column:2;grid-row:1 / span 2;align-self:center;color:var(--color-accent)}
  @media(max-width:960px){
    .gate-grid{grid-template-columns:1fr}
  }
  @media(max-width:720px){
    .g2-ablation{padding-inline:18px}
    .section-heading{grid-template-columns:1fr;gap:8px}
    .evidence-link-grid{grid-template-columns:1fr}
  }
</style>
