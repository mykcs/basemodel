---
import { localePath, type Locale } from '../../i18n';
import { openEvoScientificState } from '../../lib/openEvoScientificState';
import AgentEnvironmentTrajectory from './AgentEnvironmentTrajectory.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const route = [
  { index:'01', title:t('实时状态入口','Live-state source'), body:t('实际工作 branch 的 current-campaign.json + 最新有效 reconciliation/result。','current-campaign.json on the branch actually in use + the latest valid reconciliation/result.'), href:p('/research/seed-openevo/study/results/') },
  { index:'02', title:t('历史里程碑 · Phase G','Historical milestone · Phase G'), body:t('12 个正式 episodes 已完成；base、adapter1x、cumulative 的 score / win 均为 0。','12 formal episodes completed; base, adapter1x, and cumulative all had zero score/win outcomes.'), href:p('/research/seed-openevo/study/results/') },
  { index:'03', title:`${t('默认分支快照','Default-branch snapshot')} · ${openEvoScientificState.defaultBranchSnapshot.phase}`, body:t(`截至 ${openEvoScientificState.checkedAt}，main 记录 ${openEvoScientificState.defaultBranchSnapshot.status}；活跃科学分支可能领先。`,`As checked ${openEvoScientificState.checkedAt}, main records ${openEvoScientificState.defaultBranchSnapshot.status}; an active scientific branch may be ahead.`), href:openEvoScientificState.currentCampaignUrl },
] as const;
---

<div class="gateway">
  <header class="gateway__hero">
    <div>
      <span>OpenEvo · WebShop</span>
      <h1>{t('OpenEvo × WebShop 实验', 'OpenEvo × WebShop experiment')}</h1>
      <p>{t('openevo-experiment 是科学 source of truth。要确认“实验现在进行到哪里”，需要看实际运行 branch 的 current-campaign.json 和最新有效 reconciliation/result；静态阶段名或 GPU 数量只能说明某个历史时点。','openevo-experiment is the scientific source of truth. To determine the current experiment state, use current-campaign.json on the branch actually running the work plus the latest valid reconciliation/result; a static phase label or GPU count describes only a historical point in time.')}</p>
      <div class="gateway__actions"><a class="button button-primary" href={p('/research/seed-openevo/study/results/')}>{t('实验状态与结果 →','Experiment state and results →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/study/run/')}>{t('复现指南','Reproduction guide')}</a></div>
    </div>
    <aside aria-label={t('实验状态解析','Experiment state resolution')}>
      <small>{t('默认 main 快照','Default main snapshot')}</small><strong>{openEvoScientificState.defaultBranchSnapshot.phase}</strong>
      <dl><div><dt>{t('核验日期','Checked')}</dt><dd>{openEvoScientificState.checkedAt}</dd></div><div><dt>{t('状态','Status')}</dt><dd>{openEvoScientificState.defaultBranchSnapshot.status}</dd></div><div><dt>{t('实时状态','Live state')}</dt><dd>{t('实际 branch → campaign → reconciliation','actual branch → campaign → reconciliation')}</dd></div></dl>
    </aside>
  </header>

  <nav class="gateway__route" aria-label={t('实验状态','Experiment status')}>{route.map((item)=><a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}><span>{item.index}</span><div><strong>{item.title}</strong><p>{item.body}</p></div></a>)}</nav>

  <AgentEnvironmentTrajectory locale={locale} context="reproduction" />

  <section class="gateway__section gateway__study-brief" aria-labelledby="study-brief-title">
    <header><span>{t('研究主线', 'Research mainline')}</span><h2 id="study-brief-title">{t('研究、实验、复现与下一步', 'Study, experiments, reproduction, and next step')}</h2></header>
    <div class="study-grid">
      <article><strong>{t('研究对象', 'Object')}</strong><h3>{t('OpenEvo 的经验载体能否改善 WebShop 后续任务？', 'Can OpenEvo experience carriers improve later WebShop tasks?')}</h3><p>{t('固定模型、任务协议、评测边界和证据身份，区分经验捕获、训练拟合、旧任务保留与新任务迁移。', 'Pin the model, task contract, evaluation boundary, and evidence identity; separate experience capture, training fit, old-task retention, and fresh-task transfer.')}</p></article>
      <article><strong>{t('实际实验', 'Experiments')}</strong><h3>Phase G → H1.40</h3><p>{t('截至 H1.40，E2 经验供给与 G2 创建都已经通过，但 acquisition、retention、preservation 三个 gates 没有同时通过，因此 T2 仍未打开。', 'By H1.40, E2 experience supply and G2 construction had both passed, but the acquisition, retention, and preservation gates did not pass together, so T2 remained closed.')}</p><a href={p('/research/seed-openevo/study/results/')}>{t('查看实验结果 →', 'Open experiment results →')}</a></article>
      <article><strong>{t('复现路径', 'Reproduction')}</strong><h3>{t('先固定身份，再执行同一协议', 'Pin identities, then run the same contract')}</h3><p>{t('从代码 revision、任务 manifest、模型身份、evaluator gate 与 Run Manifest 开始；服务器实名和路径只在实验室私有运行文档中解析。', 'Start with the code revision, task manifest, model identity, evaluator gates, and Run Manifest; resolve real server identities and paths only in the private laboratory runbook.')}</p><a href={p('/research/seed-openevo/study/run/')}>{t('打开可执行复现指南 →', 'Open the executable reproduction guide →')}</a></article>
      <article><strong>{t('结论与下一步', 'Finding and next')}</strong><h3>{t('第一代内部迁移已复现；稳定多代持续整合尚未建立', 'First-generation internal transfer is replicated; stable multi-generation integration is not established')}</h3><p>{t('现有证据支持经验捕获、参数更新，以及特定条件下的第一代内部新任务迁移；下一步真正缺的是 SEED official held-out 的公平比较与更稳定的多代整合验证。', 'Current evidence supports experience capture, parameter updates, and first-generation internal fresh-task transfer under specific conditions; the key remaining work is a fair SEED official held-out comparison and a more stable multi-generation integration test.')}</p></article>
    </div>
  </section>

  <section class="gateway__section gateway__sources" aria-labelledby="source-flow-title">
    <header><span>{t('一手来源', 'Primary sources')}</span><h2 id="source-flow-title">{t('ALFWorld 与 WebShop 的官方流程资料', 'Official flow references for ALFWorld and WebShop')}</h2></header>
    <div class="source-grid">
      <a href="https://arxiv.org/abs/2010.03768" target="_blank" rel="noreferrer"><strong>ALFWorld paper</strong><span>{t('TextWorld 抽象策略与 ALFRED 视觉环境的对齐', 'Alignment between TextWorld abstract policies and the ALFRED visual environment')}</span></a>
      <a href="https://github.com/alfworld/alfworld" target="_blank" rel="noreferrer"><strong>ALFWorld repository</strong><span>{t('安装、TextWorld / THOR 运行和环境 API', 'Installation, TextWorld / THOR runs, and environment API')}</span></a>
      <a href="https://arxiv.org/abs/2207.01206" target="_blank" rel="noreferrer"><strong>WebShop paper</strong><span>{t('goal → search / click → 商品属性 → purchase → score', 'goal → search / click → product attributes → purchase → score')}</span></a>
      <a href="https://github.com/princeton-nlp/WebShop" target="_blank" rel="noreferrer"><strong>WebShop repository</strong><span>{t('环境启动、text / HTML mode 与 trajectory log', 'Environment setup, text / HTML modes, and trajectory logs')}</span></a>
    </div>
  </section>

  <section class="gateway__section" aria-labelledby="phaseg-gateway-title">
    <header><span>{t('历史证据 · Phase G','Historical evidence · Phase G')}</span><h2 id="phaseg-gateway-title">{t('正式比较结果', 'Formal comparison result')}</h2></header>
    <div class="summary-grid"><article><strong>base</strong><b>0.000 · 0/4</b><span>{t('平均分 · 成功','mean score · wins')}</span></article><article><strong>adapter1x</strong><b>0.000 · 0/4</b><span>{t('平均分 · 成功','mean score · wins')}</span></article><article><strong>cumulative</strong><b>0.000 · 0/4</b><span>{t('平均分 · 成功','mean score · wins')}</span></article></div>
    <p>{t('这组 bounded matrix 没有测到任务收益差异，但 Phase D–F 已独立证明 adapter 的参数状态、reload 与模型输出确实发生变化。该结果是历史证据，不是当前 campaign 的替代品。','This bounded matrix did not measure a task-outcome difference, while Phase D–F independently established real adapter-state, reload, and model-output changes. This is historical evidence, not a substitute for the current campaign.')}</p>
  </section>

  <section class="gateway__section" aria-labelledby="live-state-gateway-title">
    <header><span>{t('实时状态合同','Live-state contract')}</span><h2 id="live-state-gateway-title">{t('实验状态解析路径', 'Experiment state resolution')}</h2></header>
    <ol class="next-track"><li><b>branch</b><span>{t('先确认真正执行实验的 openevo-experiment branch / SHA','identify the openevo-experiment branch / SHA actually running the science')}</span></li><li><b>campaign</b><span>{t('读取该 branch 的 current-campaign.json','read current-campaign.json from that branch')}</span></li><li><b>result</b><span>{t('继续解析该 campaign 或 successor 的最新有效 reconciliation / result','follow the latest valid reconciliation/result for that campaign or successor')}</span></li><li><b>GPU</b><span>{t('按 preregistration、父级策略、授权 UUID 与 live-idle 核验解析分配','resolve allocation from preregistration, parent policy, authorized UUIDs, and live-idle checks')}</span></li></ol>
    <p>{zh ? openEvoScientificState.liveStateRule.zh : openEvoScientificState.liveStateRule.en}</p>
  </section>

  <footer class="gateway__next"><div><span>{t('默认分支快照','Default-branch snapshot')}</span><h2>{openEvoScientificState.defaultBranchSnapshot.phase} · {openEvoScientificState.defaultBranchSnapshot.status}</h2><p>{t(`这是 ${openEvoScientificState.checkedAt} 对 main 的带日期核验，不声称覆盖更靠前的活跃科学分支。`,`This is a dated ${openEvoScientificState.checkedAt} check of main and does not claim to cover a newer active scientific branch.`)}</p></div><a class="button button-primary" href={openEvoScientificState.currentCampaignUrl} target="_blank" rel="noreferrer">current-campaign ↗</a></footer>
</div>

<style>
  .gateway{width:min(1120px,calc(100% - 2rem));margin:1rem auto 5rem}.gateway__hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);overflow:hidden;border:1px solid var(--line);border-radius:20px;background:var(--surface)}.gateway__hero>div{padding:clamp(1.4rem,3vw,2.5rem)}.gateway__hero>div>span,.gateway__section>header>span,.gateway__next>div>span{color:var(--accent-deep);font-size:.7rem;font-weight:800}.gateway__hero h1{margin:.55rem 0 .75rem}.gateway__hero>div>p{max-width:70ch;margin:0;color:var(--muted);line-height:1.7}.gateway__actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.gateway__hero aside{display:flex;flex-direction:column;padding:1.2rem;border-left:1px solid var(--line);background:var(--surface-muted)}.gateway__hero aside>small{color:var(--muted)}.gateway__hero aside>strong{margin:.5rem 0;font-size:1.7rem}.gateway__hero dl{margin:auto 0 0}.gateway__hero dl div{padding:.55rem 0;border-top:1px solid var(--line)}.gateway__hero dt{color:var(--muted);font-size:.65rem}.gateway__hero dd{margin:.2rem 0 0;font-size:.74rem}.gateway__route{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin:1rem 0}.gateway__route a{display:grid;grid-template-columns:auto 1fr;gap:.7rem;padding:.9rem;border:1px solid var(--line);border-radius:13px;color:inherit;text-decoration:none}.gateway__route>a>span{color:var(--accent-deep);font:800 .66rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.gateway__route strong{font-size:.82rem}.gateway__route p{margin:.3rem 0 0;color:var(--muted);font-size:.7rem;line-height:1.45}.gateway :global(.trajectory-lab){width:100%;margin-inline:0}.gateway__section{margin-top:2rem;padding-top:1.3rem;border-top:1px solid var(--line)}.gateway__section header h2{margin:.2rem 0 .8rem}.study-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.study-grid article{padding:.9rem;border:1px solid var(--line);border-radius:12px}.study-grid strong{color:var(--accent-deep);font-size:.7rem}.study-grid h3{margin:.35rem 0 .3rem;font-size:.84rem}.study-grid p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.5}.study-grid a{display:inline-block;margin-top:.55rem;font-size:.72rem;font-weight:750}.source-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem}.source-grid a{padding:.8rem;border:1px solid var(--line);border-radius:12px;color:inherit;text-decoration:none}.source-grid a:hover,.source-grid a:focus-visible{border-color:var(--accent-deep);background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.source-grid strong,.source-grid span{display:block}.source-grid strong{font-size:.75rem}.source-grid span{margin-top:.3rem;color:var(--muted);font-size:.68rem;line-height:1.45}.summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.summary-grid article,.next-track li{padding:.85rem;border:1px solid var(--line);border-radius:12px}.summary-grid strong,.summary-grid b,.summary-grid span{display:block}.summary-grid strong{font-size:.74rem}.summary-grid b{margin:.4rem 0;font:800 .9rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.summary-grid span,.gateway__section>p{color:var(--muted);font-size:.72rem;line-height:1.5}.next-track{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:0;padding:0;list-style:none}.next-track b,.next-track span{display:block}.next-track b{color:var(--accent-deep)}.next-track span{margin-top:.35rem;color:var(--muted);font-size:.7rem;line-height:1.45}.gateway__next{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:end;margin-top:2rem;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface-muted)}.gateway__next h2{margin:.2rem 0}.gateway__next p{max-width:70ch;margin:.3rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}@media(max-width:860px){.gateway__hero{grid-template-columns:1fr}.gateway__hero aside{border-top:1px solid var(--line);border-left:0}.gateway__route,.study-grid,.source-grid,.summary-grid,.next-track{grid-template-columns:1fr 1fr}.gateway__next{grid-template-columns:1fr}}@media(max-width:560px){.gateway{width:min(100% - 1rem,1120px)}.gateway__route,.study-grid,.source-grid,.summary-grid,.next-track{grid-template-columns:1fr}}
</style>
