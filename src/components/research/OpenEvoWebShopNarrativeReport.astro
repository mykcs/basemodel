    {hasHistoricalAppendix && <details data-testid="rtx6-appendix"><summary>{t('附录 B：更早的 RTX3090 参数实验', 'Appendix B: earlier RTX3090 parametric experiments')}</summary><div class="historical-slot"><slot name="historical" /></div></details>}
