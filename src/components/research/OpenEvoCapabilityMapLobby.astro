---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ResearchTaskContext from './ResearchTaskContext.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const firstRunHref = p('/research/seed-openevo/study/capability-exploration/first-run/');
const archiveHref = p('/research/seed-openevo/study/capability-exploration/archive/');
const redesignHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/');
const successorExplorationHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/exploration/');
const successorReportHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/report/');
const stage1EvolutionHref = p('/research/seed-openevo/study/capability-exploration/stage1-evolution/');
const stage2AnalysisHref = p('/research/seed-openevo/study/capability-exploration/stage2-7b-analysis/');
const mechanismHref = p('/research/seed-openevo/study/capability-exploration/mechanism-1-0/');
const archiveLinks = [
  { href: p('/research/seed-openevo/study/capability-exploration/stage1-previous/'), label: t('历史 Stage 1', 'Historical Stage 1') },
  { href: p('/research/seed-openevo/study/capability-exploration/stage2-256-window/'), label: t('旧 Stage 2：256-window 设计', 'Old Stage 2: 256-window design') },
  { href: p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/'), label: 'Ceiling-1.0' },
  { href: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/'), label: t('Harness 诊断记录', 'Harness diagnostic record') },
];
---
<section class="map-lobby" data-testid="openevo-capability-map-lobby" data-reader-page="lobby" aria-labelledby="map-lobby-title" data-ui-audit="contrast layout">
  <header class="map-lobby__head">
    <p class="map-lobby__kicker">{t('OpenEvo × WebShop 研究', 'OpenEvo × WebShop research')}</p>
    <h1 id="map-lobby-title">{t('OpenEvo 能力探索', 'OpenEvo capability exploration')}</h1>
    <p class="map-lobby__lead" data-reader-purpose>{t('模型在模拟商店里搜索、选规格和购买，目标是买到符合要求的商品。我们研究：它能否利用做任务的经验，逐步改善下一次尝试？', 'A model searches, chooses options, and purchases in a simulated store to satisfy a shopping request. We study whether it can use that experience to improve its next attempt.')}</p>
    <p>{t('三条研究路径回答不同的问题。第一轮记录历史探索；重设计研究统一规则后的学习；参数机制实验检查学到的变化是否真的起作用。', 'Three research paths answer different questions: the first records historical exploration, the redesign studies learning under shared rules, and the mechanism experiments test whether learned changes actually matter.')}</p>
  </header>

  <nav class="map-lobby__choices" aria-label={t('选择实验地图', 'Choose an experiment map')}>
    <a class="map-choice" href={firstRunHref} data-map-choice="first-run" data-ui-audit-item>
      <span class="map-choice__state">{t('历史实验 · 7B / 3B', 'Historical experiment · 7B / 3B')}</span>
      <h2>{t('第一轮 OpenEvo 实验', 'First OpenEvo experiment run')}</h2>
      <strong>{t('经验积累后，模型真的开始学习了吗？', 'Did accumulating experience lead to actual learning?')}</strong>
      <p>{t('检查哪些训练真正改变了模型、哪些旧规则挡住了更新，以及这些问题为什么需要重新设计。', 'Inspect which training changed the model, which old rules blocked updates, and why those findings led to a redesign.')}</p>
      <b>{t('查看历史探索', 'Explore the history')}</b>
    </a>
    <a class="map-choice" href={redesignHref} data-map-choice="redesign" data-ui-audit-item>
      <span class="map-choice__state">{t('独立的新一轮设计 · 3B + 1.7B', 'Separate successor design · 3B + 1.7B')}</span>
      <h2>{t('3B + 1.7B：重新设计 OpenEvo', '3B + 1.7B: redesigning OpenEvo')}</h2>
      <strong>{t('统一购物规则后，两种模型怎样学习？', 'How do two models learn under shared shopping rules?')}</strong>
      <p>{t('两个模型使用同一套动作接口和经验采集规则。研究过程和结果报告分别展示，但使用同一份实验事实。', 'Both models use the same action interface and experience-collection rules. The exploration history and result report present the same experiment facts.')}</p>
      <b>{t('查看新设计与结果入口', 'Open the design and result gateway')}</b>
    </a>
    <a class="map-choice" href={mechanismHref} data-map-choice="mechanism-1-0" data-ui-audit-item>
      <span class="map-choice__state">{t('机制与干预 · 条件实验', 'Mechanism and intervention · conditional experiments')}</span>
      <h2>{t('Mechanism-1.0 参数机制', 'Mechanism-1.0 parameter effects')}</h2>
      <strong>{t('学到的参数变化真的有用吗？', 'Do the learned parameter changes actually help?')}</strong>
      <p>{t('把学习留下的变化移植或移除，再与同幅度随机修改比较。证据达到预设门槛后，才尝试用它指导后续学习。', 'Transplant or remove the changes left by learning and compare with equally sized random modifications. Try guiding later learning only after the evidence passes a fixed gate.')}</p>
      <b>{t('查看实验依赖、开始与结束', 'Inspect dependencies, starts, and stops')}</b>
    </a>
  </nav>
  <p class="map-lobby__boundary">{t('旧轨迹保留为历史证据，不冒充新版数据。不同实验不能因为网页放在一起就合并成同一次训练或同一个分数。', 'Old trajectories remain historical evidence, not successor data. Sharing a website does not merge separate experiments into one training run or one score.')}</p>

  <ResearchTaskContext locale={locale} />

  <section class="map-lobby__deep-dives" aria-labelledby="deep-dives-title">
    <header><h2 id="deep-dives-title">{t('专题与两种读法', 'Focused topics and two reading paths')}</h2><p>{t('探索版解释为什么改；报告版解释做了什么、结果支持什么。它们不是两个实验组。7B 参数分析保留在历史实验中。', 'The exploration view explains why the design changed; the report explains what was done and what the evidence supports. They are not separate experimental arms. The 7B parameter analysis belongs to the historical campaign.')}</p></header>
    <nav aria-label={t('专题研究地图', 'Focused research maps')}>
      <a href={successorExplorationHref} data-deep-dive="successor-exploration"><strong>{t('3B + 1.7B 探索版', '3B + 1.7B exploration')}</strong><span>{t('按研究顺序追踪假设、对照实验、失败和修改决定。', 'Follow hypotheses, controlled checks, failures, and design decisions in research order.')}</span></a>
      <a href={successorReportHref} data-deep-dive="successor-report"><strong>{t('3B + 1.7B 报告与论文版', '3B + 1.7B report / paper')}</strong><span>{t('从共同设置、初始经验到后续学习和结果边界，直接核查证据。', 'Inspect the shared setup, initial experience, later learning, and result boundaries.')}</span></a>
      <a href={stage2AnalysisHref} data-deep-dive="stage2-7b-analysis"><strong>{t('7B 参数变化分析', '7B parameter-change analysis')}</strong><span>{t('检查历史训练中哪些数值真正改变，以及它们能支持什么结论。', 'Inspect which values changed in historical training and what those observations support.')}</span></a>
      <a href={stage1EvolutionHref} data-deep-dive="stage1-evolution"><strong>{t('早期阶段探索史（兼容旧链接）', 'Early-stage exploration (legacy link)')}</strong><span>{t('与 3B + 1.7B 探索版共享内容，保留旧书签入口。', 'The same content as the 3B + 1.7B exploration view, retained for older bookmarks.')}</span></a>
    </nav>
  </section>
  <details class="map-lobby__archive">
    <summary>{t('历史实验与技术档案', 'Historical experiments and technical archive')}</summary>
    <p>{t('精确的旧数据、训练产物和运行记录保留在这里。Server/Kaggle、重试恢复、模型文件、运行修复与提交身份属于证据深层，不是新的科学实验分支。', 'Exact historical data, training artifacts, and execution records remain here. Server/Kaggle, retry recovery, model files, runtime repairs, and commit identities are deeper evidence, not new scientific branches.')}</p>
    <a class="map-lobby__archive-main" href={archiveHref}>{t('打开完整实验档案', 'Open the full experiment archive')}</a>
    <nav aria-label={t('实验档案链接', 'Experiment archive links')}>{archiveLinks.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
  </details>
</section>
<style>
.map-lobby{width:min(1120px,calc(100% - 2rem));margin:1.5rem auto 4rem;color:var(--ink);font-size:1rem}.map-lobby__head{padding-bottom:1rem;border-bottom:1px solid var(--line)}.map-lobby__kicker{font-size:.9rem;color:var(--accent-deep);font-weight:700}.map-lobby__head h1{font-size:clamp(2rem,3.5vw,2.8rem);line-height:1.3;margin:.6rem 0}.map-lobby__head>p{max-width:48rem;line-height:1.8;margin:.75rem 0}.map-lobby__lead{font-size:1.15rem}.map-lobby__choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding:1.5rem 0 1rem}.map-choice{display:flex;flex-direction:column;gap:.7rem;padding:1.1rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface);color:var(--ink);text-decoration:none;min-width:0;transition:border-color .18s ease,background-color .18s ease}.map-choice:hover{border-color:var(--accent-deep);background:var(--surface-muted)}.map-lobby a:focus-visible,.map-lobby summary:focus-visible{outline:2px solid var(--accent-deep);outline-offset:4px}.map-choice__state{font-size:.85rem;line-height:1.6;color:var(--accent-deep)}.map-choice h2{font-size:1.4rem;line-height:1.5;margin:0;letter-spacing:-.01em}.map-choice>strong{font-size:1rem;line-height:1.65}.map-choice p{margin:0;line-height:1.8}.map-choice b{margin-top:auto;padding-top:.5rem;color:var(--accent-deep);font-size:.9rem;text-decoration:underline;text-underline-offset:.2em}.map-lobby__boundary{max-width:48rem;line-height:1.75;border-left:3px solid var(--line);padding-left:1rem}.map-lobby__deep-dives{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--line)}.map-lobby__deep-dives h2{font-size:1.5rem;line-height:1.4;margin:0}.map-lobby__deep-dives header p{max-width:48rem;line-height:1.8;margin:.8rem 0}.map-lobby__deep-dives nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2rem}.map-lobby__deep-dives nav>a{display:grid;gap:.4rem;padding:1rem 0;border-top:1px solid var(--line);color:var(--ink);text-decoration:none}.map-lobby__deep-dives nav>a strong{color:var(--accent-deep);text-decoration:underline;text-underline-offset:.2em;line-height:1.6}.map-lobby__deep-dives nav>a span{line-height:1.8}.map-lobby__archive{border-top:1px solid var(--line);padding:1.25rem 0;margin-top:1.5rem}.map-lobby__archive summary{cursor:pointer;font-weight:700;line-height:1.7;min-height:44px}.map-lobby__archive p{max-width:48rem;line-height:1.8}.map-lobby__archive a{color:var(--accent-deep);text-underline-offset:.2em}.map-lobby__archive-main{display:inline-block;padding:.5rem 0;font-weight:700}.map-lobby__archive nav{display:flex;gap:.75rem 1.25rem;flex-wrap:wrap;padding-top:.5rem}@media(max-width:980px){.map-lobby__choices{grid-template-columns:1fr}.map-choice{padding:1rem}.map-choice h2{font-size:1.35rem}}@media(max-width:760px){.map-lobby__deep-dives nav{grid-template-columns:1fr}.map-lobby__lead{font-size:1.05rem}.map-lobby{margin-top:1rem}.map-lobby__archive nav{display:grid;gap:1rem}}@media(prefers-reduced-motion:reduce){.map-choice{transition:none}}
</style>
