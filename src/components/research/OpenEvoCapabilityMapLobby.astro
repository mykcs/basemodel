---
import "../../styles/research-article.css";
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ResearchOrientation from './ResearchOrientation.astro';
import { CAPABILITY_READER_ROUTES, CAPABILITY_TOPIC_GROUPS } from '../../data/capabilityReaderRoutes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const root = '/research/seed-openevo/study/capability-exploration/';
const groups = CAPABILITY_TOPIC_GROUPS.map((group) => ({
  ...group,
  pages: group.routes.map((route) => {
    const entry = CAPABILITY_READER_ROUTES.find((item) => item.route === route);
    if (!entry) throw new Error(`Missing research directory entry: ${route}`);
    return entry;
  }),
}));
---
<section data-copy-review class="map-lobby evo-approved-reader evo-reading-overview" data-testid="openevo-capability-map-lobby" data-reader-page="lobby" data-ui-audit="contrast layout">
  <div class="map-lobby__first-screen">
    <ResearchOrientation
      locale={locale} layout="focus"
      title={t('OpenEVO 研究专题', 'OpenEVO research topics')}
      lede={t('参数怎样学习、长期状态怎样保存、更新为什么有效：已有研究按问题归类，实验发生顺序保留在实验目录。', 'Find research on parameter learning, long-term state, and update mechanisms. The experiment directory keeps the chronological progression.')}
      question={t('同一条研究线里的实验、方法解释和历史记录分别在哪里？', 'Where are the experiments, method explanations, and historical records?')}
      why={t('实验顺序与专题查找服务不同任务；每个研究页面在本目录只归入一个主题。', 'Chronology and topic lookup serve different tasks; each research page has one topical home here.')}
      start={t('按主题进入原研究页面。', 'Choose a topic to open its original research page.')}
      finish={t('具体结果、原始来源与比较边界由链接的研究页给出。', 'Linked research pages own the results, original sources, and comparison boundaries.')}
      state={t('目录分类不代表实验完成状态，也不授予实验执行权限。', 'Directory categories do not state experiment completion or grant execution authority.')}
      stateTone="historical"
      actionHref={p('/research/seed-openevo/study/')}
      actionLabel={t('按时间查看实验', 'Browse experiments chronologically')}
    />
  </div>
  <p class="map-lobby__archive" data-reader-context data-reader-task data-reader-purpose>{t('研究对象是模型执行搜索、点击和购买的 WebShop 模拟购物任务。', 'The research studies models searching, clicking, and buying in the WebShop shopping simulator.')} <a href={p('/research/seed-openevo/flow/webshop/')}>{t('WebShop 任务与评分', 'WebShop tasks and scoring')}</a></p>
  <nav class="map-lobby__archive" aria-label={t('研究主题', 'Research topics')} data-topic-navigation>
    <ul>{groups.map((group) => <li><a href={`#topic-${group.id}`}>{group.label[locale]}</a></li>)}</ul>
  </nav>
  {groups.map((group) => (
    <section class="map-lobby__archive" id={`topic-${group.id}`} aria-labelledby={`topic-${group.id}-title`} data-topic-group={group.id}>
      <h2 id={`topic-${group.id}-title`}>{group.label[locale]}</h2>
      <ul>
        {group.pages.map((entry) => (
          <li data-topic-route={entry.route}>
            <a href={p(`${root}${entry.route}/`)}>{entry.label[locale]}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <div class="map-lobby__archive">
    <h2>{t('方法背景与研究文章', 'Background and research articles')}</h2>
    <p><a href={p('/research/seed-openevo/flow/')}>{t('SEED / OpenEVO 方法与任务环境', 'SEED / OpenEVO methods and task environments')}</a></p>
    <ol>
      <li><a href={p('/research/seed-openevo/study/openevo-methods/')}>{t('OpenEVO 的参数记忆方法', 'OpenEVO parameter-memory methods')}</a></li>
      <li><a href={p('/research/seed-openevo/study/advisor-questions/')}>{t('L 学长十问：问题与背景', 'Ten research questions and their background')}</a></li>
      <li><a href={p('/research/seed-openevo/study/parameter-memory-results/')}>{t('我们的回应实验', 'Our response experiments')}</a></li>
    </ol>
  </div>
</section>
<style>
.map-lobby{display:block}.map-lobby__first-screen{min-height:0}.map-lobby__latest-evidence{width:min(1120px,calc(100% - 2rem));margin:1.5rem auto 2.2rem;padding:.9rem 0 .9rem 1.1rem;border-left:3px solid var(--accent-deep);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.4rem;align-items:end}.map-lobby__latest-evidence div{min-width:0}.map-lobby__latest-evidence-meta{margin:0;color:var(--muted);font-size:var(--type-body);font-weight:var(--type-weight-label);line-height:var(--type-leading-caption)}.map-lobby .map-lobby__latest-evidence .map-lobby__latest-evidence-meta{font-size:var(--type-body);line-height:var(--type-leading-caption)}.map-lobby__latest-evidence strong{display:block;margin:.25rem 0;font-size:var(--article-section-size,clamp(1.25rem,2.1vw,1.7rem));line-height:var(--type-leading-heading);letter-spacing:normal;font-weight:var(--type-weight-heading)}.map-lobby__latest-evidence p{max-width:54rem;margin:.35rem 0 0;color:var(--muted);font-size:var(--article-body-size, 1rem);line-height:var(--article-body-leading, 1.58)}.map-lobby__latest-evidence>a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent-deep);font-weight:var(--type-weight-label);text-underline-offset:.2em}.map-lobby .map-lobby__latest-evidence>a{font-size:var(--type-body)}.map-lobby__latest-evidence>a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.map-lobby__terms{width:min(1120px,calc(100% - 2rem));margin:1rem auto;border-block:1px solid var(--line)}.map-lobby__terms>summary{padding:.8rem 0;color:var(--muted);font-size:var(--type-body);font-weight:var(--type-weight-label);cursor:pointer}.map-lobby__terms dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0 0 .8rem}.map-lobby__terms dl>div{padding:.7rem;border-top:1px solid var(--line)}.map-lobby__terms dt{font-weight:var(--type-weight-label)}.map-lobby__terms dd{margin:.25rem 0 0;color:var(--muted);font-size:var(--type-body);line-height:var(--type-leading-body)}.map-lobby__current-ablation{width:min(1120px,calc(100% - 2rem));margin:1rem auto;padding:1rem 1.15rem;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;border:1px solid var(--accent-deep);border-radius:var(--radius-panel);background:var(--surface-muted)}.map-lobby__current-ablation div{min-width:0}.map-lobby__current-ablation small{display:block;color:var(--accent-deep);letter-spacing:normal;font-family:var(--font-interface);font-size:var(--type-body);font-weight:var(--type-weight-label);line-height:var(--type-leading-caption)}.map-lobby__current-ablation strong{display:block;margin:.28rem 0;font-size:var(--type-minor-heading);line-height:var(--type-leading-heading);font-weight:var(--type-weight-heading)}.map-lobby__current-ablation p{margin:0;max-width:48rem;color:var(--muted);font-size:var(--article-body-size, 1rem);line-height:var(--article-body-leading, 1.55)}.map-lobby__current-ablation>a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent-deep);font-weight:var(--type-weight-label);text-underline-offset:.2em}.map-lobby__current-ablation>a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.map-lobby__deep-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.map-lobby__deep-links>a{display:grid;gap:.28rem;padding:.72rem;border-left:2px solid var(--line);background:var(--surface-muted);color:inherit;text-decoration:none}.map-lobby__deep-links>a:hover,.map-lobby__deep-links>a:focus-visible{border-left-color:var(--accent);background:var(--surface)}.map-lobby__deep-links>a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.map-lobby__deep-links small{color:var(--accent-deep);letter-spacing:normal;font-family:var(--font-interface);font-size:var(--type-body);font-weight:var(--type-weight-label);line-height:var(--type-leading-caption)}.map-lobby__deep-links strong{font-size:var(--type-body);line-height:var(--type-leading-heading);font-weight:var(--type-weight-heading)}.map-lobby__deep-links span{color:var(--muted);font-size:var(--type-body);line-height:var(--type-leading-caption)}.map-lobby__archive>p{margin:0;max-width:52rem;color:var(--muted);font-size:var(--article-body-size, 1rem);line-height:var(--article-body-leading, 1.5)}.map-lobby__archive-main{display:inline-flex;margin-top:.55rem;color:var(--accent-deep);font-size:var(--type-body);font-weight:var(--type-weight-label);text-underline-offset:.2em}.map-lobby__archive nav{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin-top:.65rem}.map-lobby__archive nav a{color:var(--accent-deep);font-size:var(--type-body);text-underline-offset:.2em}@media(max-width:760px){.map-lobby__latest-evidence,.map-lobby__current-ablation,.map-lobby__terms{width:min(100% - 1rem,1120px)}.map-lobby__latest-evidence{grid-template-columns:1fr;gap:.5rem;padding-left:.85rem}.map-lobby__current-ablation{grid-template-columns:1fr;gap:.5rem}.map-lobby__terms dl,.map-lobby__deep-links{grid-template-columns:1fr}.map-lobby__archive nav{display:grid}}

.map-lobby :is(.map-lobby__latest-evidence-meta,.map-lobby__latest-evidence>a,.map-lobby__terms>summary,.map-lobby__terms dt,.map-lobby__terms dd,.map-lobby__current-ablation small,.map-lobby__current-ablation>a,.map-lobby__deep-links small,.map-lobby__deep-links span,.map-lobby__archive-main,.map-lobby__archive nav a){font-size:var(--type-body)}
.map-lobby :is(.map-lobby__latest-evidence p,.map-lobby__current-ablation p,.map-lobby__archive>p){font-size:var(--type-body)}
.map-lobby .map-lobby__latest-evidence strong{font-size:var(--article-section-size, var(--type-article-section))}
.map-lobby .map-lobby__current-ablation strong,.map-lobby .map-lobby__deep-links strong{font-size:var(--type-minor-heading)}

.map-lobby>[data-topic-group],.map-lobby>[data-topic-navigation],.map-lobby>.map-lobby__archive{width:min(1120px,calc(100% - 2rem));margin:1.5rem auto}
.map-lobby>[data-topic-navigation]>ul{display:flex;flex-wrap:wrap;gap:.5rem 1rem;list-style:none;margin:0;padding:0}
.map-lobby [data-topic-route] a{display:flex;align-items:center;box-sizing:border-box;min-height:44px;padding:.35rem 0}
</style>
