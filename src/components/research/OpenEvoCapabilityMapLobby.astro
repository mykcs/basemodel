---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchJourney from './ResearchJourney.astro';
import ResearchDepth from './ResearchDepth.astro';
import ResearchTaskContext from './ResearchTaskContext.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const firstRunHref = p('/research/seed-openevo/study/capability-exploration/first-run/');
const archiveHref = p('/research/seed-openevo/study/capability-exploration/archive/');
const redesignHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/');
const successorExplorationHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/exploration/');
const successorReportHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/report/');
const stage1EvolutionHref = p('/research/seed-openevo/study/capability-exploration/stage1-evolution/');
const stage2AnalysisHref = p('/research/seed-openevo/study/capability-exploration/stage2-7b-analysis/');
const mechanismHref = p('/research/seed-openevo/study/capability-exploration/mechanism-1-0/');
const gdrDirectApplyHref = p('/research/seed-openevo/study/capability-exploration/gdr-directapply/');
const archiveLinks = [
  { href: p('/research/seed-openevo/study/capability-exploration/stage1-previous/'), label: t('历史 Stage 1', 'Historical Stage 1') },
  { href: p('/research/seed-openevo/study/capability-exploration/stage2-256-window/'), label: t('旧 Stage 2：256-window 设计', 'Old Stage 2: 256-window design') },
  { href: p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/'), label: 'Ceiling-1.0' },
  { href: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/'), label: t('Harness 诊断记录', 'Harness diagnostic record') },
];
const terms = zh ? [
  { term: 'OpenEvo', meaning: '让模型从自己走出的轨迹中继续学习；这里的“能力探索”是在 WebShop 上逐步验证它能学到什么。' },
  { term: 'Stage 1', meaning: '先让当前模型自己跑任务，收集第一批可学习经验；这一阶段先看模型原本能做到什么。' },
  { term: 'Stage 2', meaning: '在 Stage1 证据经过分析和封存后，才允许进入的后续自进化阶段；“准备好”不等于“自动开始”。' },
  { term: 'Harness', meaning: '模型与 WebShop 环境之间的公共接口规则。它应该帮助合法交互，但不能偷偷教购物策略。' },
] : [
  { term: 'OpenEvo', meaning: 'A framework where a model keeps learning from trajectories it produced itself; this area tests that idea step by step on WebShop.' },
  { term: 'Stage 1', meaning: 'The model first acts on its own to create an initial experience corpus, revealing what it can already do before downstream evolution.' },
  { term: 'Stage 2', meaning: 'A later self-evolution phase that can start only after Stage-1 evidence is sealed and separately authorized.' },
  { term: 'Harness', meaning: 'The shared interface between the model and WebShop. It should enable legal interaction without teaching a shopping strategy.' },
];
const steps = zh ? [
  {
    id: 'first-run', kicker: '第一代问题', title: '第一轮：OpenEvo 能不能真的持续更新？',
    summary: '从初始经验到后续学习，观察 7B / 3B 的参数更新、失败和容量限制。',
    detail: '这轮实验告诉我们“系统能跑起来”，也暴露了 购物动作接口、更新规则和参数容量会影响结论。',
    outcome: '研究重点从“跑通”转向“怎样让比较更公平、起跑线更可信”。', state: '历史证据',
    href: firstRunHref, hrefLabel: '进入第一轮实验', mapChoice: 'first-run',
  },
  {
    id: 'redesign', kicker: '第二代问题', title: '重新设计：两种模型使用相同购物接口，各自表现怎样？',
    summary: '固定一套不提供具体购物解法的接口。两种模型各完成 1,440 次尝试，再用同一套方法分析已有记录。',
    detail: '这一代分别检查模型的购物表现与接口转换动作时的错误，再固定两种模型共用的运行规则。',
    outcome: '我们获得更可比的 Stage1 起跑线，也保留真实绕路作为历史证据。', state: '新一轮设计',
    href: redesignHref, hrefLabel: '进入 3B + 1.7B 学习实验', mapChoice: 'redesign',
  },
  {
    id: 'mechanism-1-0', kicker: '第三代问题', title: 'Mechanism-1.0：分数变了以后，参数里到底发生了什么？',
    summary: '把学习留下的参数变化加上或移除，与同幅度随机修改比较，检查哪些变化影响购物表现。',
    detail: '只有真实参数方向优于同幅度随机修改的证据达到预设门槛，才可申请用它指导后续学习。',
    outcome: '研究从“能走多高”推进到“能不能解释、验证并控制自我进化”。', state: '当前主实验', current: true,
    href: mechanismHref, hrefLabel: '进入 Mechanism-1.0', mapChoice: 'mechanism-1-0',
  },
] : [
  { id: 'first-run', kicker: 'FIRST QUESTION', title: 'First run: can OpenEvo sustain real updates?', summary: 'Follow the older Stage 1 → Stage 2 run and see what the 7B / 3B paths revealed about learning and capacity.', detail: 'The run showed that the system can evolve, but also that action interfaces, update rules, and parameter capacity can change what a result means.', outcome: 'The next question became how to make starting points and comparisons more defensible.', state: 'Historical evidence', href: firstRunHref, hrefLabel: 'Open the first experiment', mapChoice: 'first-run' },
  { id: 'redesign', kicker: 'SECOND QUESTION', title: 'Redesign: where do 3B and 1.7B start under one shared harness?', summary: 'Freeze one strategy-neutral harness, collect 1,440 trajectories per model, then apply the same post-hoc analysis.', detail: 'This separates model capability from broken action serialization and splits the same evidence into exploration and report/paper reading modes.', outcome: 'We get a more defensible Stage-1 starting comparison while keeping the real detours as history.', state: 'Current successor', href: redesignHref, hrefLabel: 'Open the 3B + 1.7B successor', mapChoice: 'redesign' },
  { id: 'mechanism-1-0', kicker: 'THIRD QUESTION', title: 'Mechanism-1.0: after scores move, what changed inside the parameters?', summary: 'Use TaskVectors and parameter themes for causal interventions rather than descriptive plots alone.', detail: 'Only preregistered direction-specific causal evidence can be fed back into a later OpenEvo step.', outcome: 'The research moves from “how high can it go?” to “can we explain, validate, and control self-improvement?”', state: 'Current primary program', current: true, href: mechanismHref, hrefLabel: 'Open Mechanism-1.0', mapChoice: 'mechanism-1-0' },
];
---
<section data-copy-review class="map-lobby" data-testid="openevo-capability-map-lobby" data-reader-page="lobby" data-ui-audit="contrast layout">
  <ResearchOrientation
    locale={locale}
    eyebrow="OPENEVO × WEBSHOP · CAPABILITY EXPLORATION"
    title={t("模型怎样从购物经验中学习？", "How do models learn from shopping experience?")}
    lede={t("模型在模拟商店里搜索、选规格和购买，目标是买到符合要求的商品。我们研究怎样让它利用经验改善下一次尝试。", "A model searches, chooses options and purchases in a simulated store. We study how experience can improve its next attempt.")}
    question={t("模型能否持续学习，哪些变化真的有效？", "Can the model keep learning, and which changes matter?")}
    why={t("不同实验使用过不同规则，需要分开解释证据。", "Experiments used different rules, so their evidence must be interpreted separately.")}
    start={t("第一轮先检查经验能否带来真实的模型更新。", "The first campaign checks whether experience produces real updates.")}
    finish={t("机制实验检验学到的变化是否有效，再决定是否继续。", "Mechanism experiments test learned changes before deciding whether to continue.")}
    state={t("第一轮是历史记录；新设计与机制实验回答后续问题。", "The first campaign is history; redesign and mechanism studies ask the next questions.")}
    stateTone="authorized"
    actionHref={mechanismHref}
    actionLabel={t("查看参数机制实验", "View parameter-mechanism experiments")}
    terms={terms}
  />


  <ResearchTaskContext locale={locale} />

  <ResearchJourney
    locale={locale}
    eyebrow="THE RESEARCH EVOLVED WITH THE QUESTION"
    title={t("三类研究问题", "Three research questions")}
    intro={t('每一步都保留前一步的证据，但不会把旧轨迹冒充成新实验数据。', 'Each generation keeps the evidence from the previous one without relabeling old trajectories as new experimental data.')}
    steps={steps}
  />

  <aside class="map-lobby__current-ablation" data-current-ablation="gdr-directapply">
    <div><small>{t('CURRENT STAGE2 ABLATION', 'CURRENT STAGE-2 ABLATION')}</small><strong>{t('为什么 44 次 SD-LoRA 尝试只留下 7 次更新？', 'Why did 44 SD-LoRA attempts become only 7 updates?')}</strong><p>{t('GDR-v1 会用 16-task 小考试决定新状态能否继续。DirectApply / No-GDR 正在独立检验：如果只移除这个短期 task-score gate，长期学习路径会怎样？', 'GDR-v1 uses a 16-task probe to decide whether a changed state may continue. DirectApply / No-GDR independently tests what happens when only that short-horizon task-score gate is removed.')}</p></div>
    <a href={gdrDirectApplyHref}>{t('进入 GDR → DirectApply 决策页 →', 'Open the GDR → DirectApply decision page →')}</a>
  </aside>

  <ResearchDepth
    locale={locale}
    kind="method"
    summary={t("学习实验报告、设计过程与 7B 参数专题", "Learning report, design history, and 7B parameter analysis")}
    intro={t("实验报告汇总设置与结果；设计过程解释修改原因；7B 专题检查历史参数变化。", "The report summarizes setup and results; design history explains revisions; the 7B study examines historical parameter changes.")}
  >
    <nav class="map-lobby__deep-links" aria-label={t('专题研究地图', 'Focused research maps')}>
      <a href={gdrDirectApplyHref} data-deep-dive="gdr-directapply"><small>{t('Stage2 · 机制消融', 'STAGE 2 · MECHANISM ABLATION')}</small><strong>{t('为什么 44 次 SD-LoRA 尝试只留下 7 次更新？', 'Why did 44 SD-LoRA attempts become only 7 updates?')}</strong><span>{t('从 GDR-v1 的一步放行规则走到 DirectApply / No-GDR，对照短期 gate 是否截断长期学习路径。', 'Follow the decision from GDR-v1 to DirectApply / No-GDR and test whether a one-step gate truncates longer-horizon learning.')}</span></a>
      <a href={successorExplorationHref} data-deep-dive="successor-exploration"><small>{t('第二代 · 探索版', 'SECOND GENERATION · EXPLORATION')}</small><strong>{t('看假设怎样被证伪、回退和重新冻结', 'See how hypotheses were falsified, backtracked, and refrozen')}</strong><span>{t('适合想知道“为什么最后会变成现在这套 Harness”的读者。', 'Best when you want to know why the current harness ended up this way.')}</span></a>
      <a href={successorReportHref} data-deep-dive="successor-report"><small>{t('第二代 · 报告版', 'SECOND GENERATION · REPORT')}</small><strong>{t("实验设置、结果与结论范围", "Experiment setup, results, and claim scope")}</strong><span>{t('适合汇报、论文讨论和快速核对当前结论。', 'Best for presentations, paper discussion, and fast claim checking.')}</span></a>
      <a href={stage2AnalysisHref} data-deep-dive="stage2-7b-analysis"><small>{t('第一代 · 参数证据', 'FIRST GENERATION · PARAMETER EVIDENCE')}</small><strong>{t("7B 的参数更新、变化方向与容量限制", "7B parameter updates, update directions, and capacity limits")}</strong><span>{t('保留为 Mechanism-1.0 的前序参数证据。', 'Preserved as predecessor parameter evidence for Mechanism-1.0.')}</span></a>
      <a href={stage1EvolutionHref} data-deep-dive="stage1-evolution" class="is-compat"><small>{t('兼容旧入口', 'LEGACY ENTRY')}</small><strong>{t("初始经验的设计过程（旧书签入口）", "Initial-experience design history (legacy bookmark)")}</strong><span>{t("与 3B + 1.7B 设计过程指向同一份研究记录。", "Opens the same research record as the 3B + 1.7B design history.")}</span></a>
    </nav>
  </ResearchDepth>

  <ResearchDepth locale={locale} kind="history" summary={t('旧 Stage1、旧 Stage2、Ceiling-1.0 与 Harness 诊断完整档案', 'Full archive: old Stage 1, old Stage 2, Ceiling-1.0, and harness diagnostics')}>
    <div class="map-lobby__archive"><p>{t("历史档案保存旧实验的购物记录、模型文件、结果和运行修复证据，可按实验与资料类型查阅。", "The historical archive preserves shopping records, model files, results, and runtime-repair evidence, organized by experiment and material type.")}</p><a class="map-lobby__archive-main" href={archiveHref}>{t('打开完整实验档案 →', 'Open the full experiment archive →')}</a><nav aria-label={t('实验档案链接', 'Experiment archive links')}>{archiveLinks.map((item) => <a href={item.href}>{item.label}</a>)}</nav></div>
  </ResearchDepth>
</section>
<style>
.map-lobby{display:contents}.map-lobby__current-ablation{width:min(1120px,calc(100% - 2rem));margin:1rem auto;padding:1rem 1.15rem;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;border:1px solid var(--accent-deep);border-radius:var(--radius-panel);background:var(--surface-muted)}.map-lobby__current-ablation div{min-width:0}.map-lobby__current-ablation small{display:block;color:var(--accent-deep);font:800 .78rem/1.2 var(--font-mono);letter-spacing:.06em}.map-lobby__current-ablation strong{display:block;margin:.28rem 0;font-size:1.08rem;line-height:1.4}.map-lobby__current-ablation p{margin:0;max-width:48rem;color:var(--muted);font-size:.95rem;line-height:1.55}.map-lobby__current-ablation>a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent-deep);font-weight:800;text-underline-offset:.2em}.map-lobby__current-ablation>a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.map-lobby__deep-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.map-lobby__deep-links>a{display:grid;gap:.28rem;padding:.72rem;border-left:2px solid var(--line);background:var(--surface-muted);color:inherit;text-decoration:none}.map-lobby__deep-links>a:hover,.map-lobby__deep-links>a:focus-visible{border-left-color:var(--accent);background:var(--surface)}.map-lobby__deep-links>a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.map-lobby__deep-links>a.is-compat{opacity:.72}.map-lobby__deep-links small{color:var(--accent-deep);font:800 1rem/1.2 var(--font-mono);letter-spacing:.06em}.map-lobby__deep-links strong{font-size:1rem;line-height:1.35}.map-lobby__deep-links span{color:var(--muted);font-size:1rem;line-height:1.45}.map-lobby__archive>p{margin:0;max-width:52rem;color:var(--muted);font-size:1rem;line-height:1.5}.map-lobby__archive-main{display:inline-flex;margin-top:.55rem;color:var(--accent-deep);font-size:1rem;font-weight:800;text-underline-offset:.2em}.map-lobby__archive nav{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin-top:.65rem}.map-lobby__archive nav a{color:var(--accent-deep);font-size:1rem;text-underline-offset:.2em}@media(max-width:760px){.map-lobby__current-ablation{width:min(100% - 1rem,1120px);grid-template-columns:1fr;gap:.5rem}.map-lobby__deep-links{grid-template-columns:1fr}.map-lobby__archive nav{display:grid}}
</style>

