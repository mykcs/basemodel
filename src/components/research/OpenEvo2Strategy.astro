---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { openEvo2TransitionSnapshot as snap } from '../../data/openEvo2TransitionSnapshot';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const ceilingHref = p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/');
const harnessStudyHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/');
const currentCampaignHref = `https://github.com/mykcs/openevo-experiment/blob/${snap.scienceBranch}/configs/experiment/current-campaign.json`;
const changes = [
  { n:'01', title:t('当前页面永远比历史经验优先','The live page always outranks historical experience'), body:t('模型每一步先看当前任务、当前页面和当前允许动作，再从历史经验里补少量真正相关的信息。过去某一页能点什么，不能压过眼前这一步实际能点什么。','At every step the model first sees the current task, page, and allowed actions, then receives only a small amount of relevant historical experience. What was clickable on an old page cannot override what is actually clickable now.') },
  { n:'02', title:t('三份历史经验不再重复写同一套按钮攻略','The three experience sources stop repeating the same UI instructions'), body:t('Text Memory 只记可复用事实和经验，Skill 只写“什么情况下用什么策略”，Agent System 只保留全局原则和冲突时谁优先。三份内容各管一件事，避免 3B 同时收到三套相似但过于具体的历史动作建议。','Text Memory keeps reusable facts, Skill says when a strategy applies, and Agent System keeps only global principles and conflict priority. Each source has one job so 3B no longer receives three overlapping sets of overly specific historical action advice.') },
  { n:'03', title:t('把不同类型的失败分开记','Record different failures separately'), body:t('以后不再把所有失败都叫“invalid”。我们会区分：输出格式写错、动作命令本身不完整、动作格式正确但当前页面根本没有这个选项、以及环境最后真正拒绝。这样第一轮就能看出问题发生在哪一层。','Failures are no longer collapsed into one invalid bucket. We distinguish malformed output, incomplete command semantics, syntactically valid actions unavailable on the current page, and final environment rejection, making the failing layer visible from the first round.') },
  { n:'04', title:t('正式重跑前，先用两组各 128 次的小实验验接口','Check the interface with two fixed 128-attempt cells before formal Stage 2'), body:t('这一步已经完成：同一个 3B 起点，一组不放历史经验，另一组只放 Harness 2.0 整理后的经验；任务、随机种子、采样温度和解析器保持相同。机械接口门过线，但 Harness 组更容易因为非法输出提前结束，所以正式 Stage 2 暂不启动。','This check is now complete: from the same 3B state, one cell received no historical experience and the other received Harness 2.0 experience; tasks, seeds, temperature, and parser stayed matched. The mechanical interface gate passed, but the Harness cell terminated more often on invalid output, so formal Stage 2 remains on hold.') },
] as const;
---
<main class="evo2" data-testid="openevo-2-strategy">
  <OpenEvoStage2StrategyChooser locale={locale} active="openevo2" />

  <header class="evo2__hero">
    <div>
      <p>HARNESS 2.0.1 · {t('机械资格已完成', 'MECHANICAL QUALIFICATION COMPLETE')}</p>
      <h1>{t('Harness 2.0.1 已通过机械资格；正式 3B Stage 2 仍停在 readiness gate', 'Harness 2.0.1 passed mechanical qualification; formal 3B Stage 2 remains at the readiness gate')}</h1>
      <span>{t('Stage 1 不重做，已经收集的 1,440 条学生轨迹和 1,440 条老师分析全部复用。我们现在怀疑的不是“经验有没有用”，而是经验被写得太像具体按钮攻略、又同时从三份文件塞进每一步提示词，可能把 3B 从当前页面真正允许的动作上带偏。Harness 2.0 因此只改经验如何组织、筛选和进入下一步提示词。', 'Stage 1 is not rerun; all 1,440 student trajectories and 1,440 teacher analyses are reused. The concern is no longer whether experience is useful, but whether overly specific UI advice from three simultaneous text sources steers 3B away from the actions actually available on the current page. Harness 2.0 therefore changes only how experience is organized, selected, and delivered into the next prompt.')}</span>
    </div>
    <aside>
      <span>{t('这条新实验线的状态','STATUS')}</span>
      <strong>{t('2.0.1 Mechanical PASS；Scientific closeout = HOLD_FOR_STAGE2_READINESS_AUDIT','2.0.1 Mechanical PASS; scientific closeout = HOLD_FOR_STAGE2_READINESS_AUDIT')}</strong>
      <small>{t('当前记录为 formal_stage2_authorized=false、final_panel_access_authorized=false。下一阶段是 STAGE2_READINESS_AUDIT_AND_DRESS_REHEARSAL，而不是继续等待 2.0.1 qualification。','The current record states formal_stage2_authorized=false and final_panel_access_authorized=false. The next phase is STAGE2_READINESS_AUDIT_AND_DRESS_REHEARSAL, not another wait for 2.0.1 qualification.')}</small>
    </aside>
  </header>

  <section class="evo2__section" aria-labelledby="evo2-lineage-title">
    <p class="kicker">{t('哪些东西不重做', 'WHAT STAYS THE SAME')}</p>
    <h2 id="evo2-lineage-title">{t('Stage 1 的数据完全复用；真正重做的是“经验怎样进入下一步”', 'Stage-1 data is fully reused; the redesign starts with how experience enters the next step')}</h2>
    <p>{t('Ceiling-1.0 和 Harness 2.0 共用同一份 Stage 1：每个模型已经有 1,440 次学生做题，以及 1,440 条任务结束后的老师分析。Harness 2.0 不再花老师预算，也不重新采这批任务。它从这里开始分叉：重新整理 Text Memory、Skill、Agent System 的职责，并改变它们怎样被放进 WebShop 的下一步提示词。', 'Ceiling-1.0 and Harness 2.0 share the same Stage 1: 1,440 student attempts and 1,440 post-task teacher analyses per model. Harness 2.0 spends no extra teacher budget and does not recollect those tasks. The fork begins here by reorganizing Text Memory, Skill, and Agent System responsibilities and changing how they enter the next WebShop prompt.')}</p>

    <figure class="lineage" role="img" aria-label={t('当前 corrected Stage 1 先进入同一个证据池，再分成 Ceiling-1.0 与 OpenEVO 2.0 两条分支','The current corrected Stage 1 enters one evidence pool, then forks into Ceiling-1.0 and OpenEVO 2.0')}>
      <svg viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
        <defs><marker id="evo2-arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 Z" /></marker></defs>
        <path d="M255 210 C330 210 350 210 430 210" />
        <path d="M720 210 C800 210 815 105 900 105" />
        <path d="M720 210 C800 210 815 315 900 315" />
      </svg>
      <article class="lineage__node lineage__stage1"><span>01 · {t('共同数据','SHARED DATA')}</span><strong>Stage 1</strong><small>{t('每个模型 1,440 次任务尝试','1,440 task attempts per model')}</small><p>{t('这部分已经完成，Harness 2.0 不重跑。','This part is already complete and is not rerun for Harness 2.0.')}</p></article>
      <article class="lineage__node lineage__state"><span>02 · {t('从这里开始改','REDESIGN STARTS HERE')}</span><strong>{t('把老师分析整理成下一轮可用经验','Turn teacher analysis into usable next-round experience')}</strong><small>{t('每个模型 1,440 条已封存分析','1,440 sealed analyses per model')}</small><p>{t('参数初始化保持原来的科学含义；重新检查的是 Text Memory、Skill、Agent System 各自应该写什么，以及怎样送进下一步。','Parameter initialization keeps its existing scientific meaning; the redesign targets what Text Memory, Skill, and Agent System should contain and how they reach the next step.')}</p></article>
      <article class="lineage__node lineage__ceiling"><span>03A · {t('已经跑过','EXISTING RUN')}</span><strong>OpenEVO-Ceiling-1.0</strong><p>{t('三份文字经验都会直接进入后续提示词。7B 能继续学习，但 3B 暴露出大量“当前页面没有这个动作”的失败。历史结果全部保留。','All three textual experience sources enter later prompts. 7B continued learning, while 3B showed many failures where the chosen action was unavailable on the current page. All historical evidence is retained.')}</p><a href={ceilingHref}>{t('查看 Ceiling-1.0 →','Open Ceiling-1.0 →')}</a></article>
      <article class="lineage__node lineage__next"><span>03B · HARNESS 2.0 → 2.0.1 · {t('后续资格状态已更新','FOLLOW-UP STATUS UPDATED')}</span><strong>{t('Harness 2.0.1 mechanical qualification 已 PASS','Harness 2.0.1 mechanical qualification is PASS')}</strong><p>{t('第一次 128 + 128 Harness 2.0 结果原样保留。后续 2.0.1 已完成机械资格，但 scientific closeout 为 HOLD_FOR_STAGE2_READINESS_AUDIT；formal Stage 2 仍未授权。','The original paired 128 + 128 Harness 2.0 result remains unchanged. The later 2.0.1 mechanical qualification is complete, but its scientific closeout is HOLD_FOR_STAGE2_READINESS_AUDIT; formal Stage 2 remains unauthorized.')}</p><a href={harnessStudyHref}>{t('查看 Harness 2.0 迷你实验与后续状态 →','Open the Harness 2.0 mini study and follow-up status →')}</a></article>
      <figcaption>{t('所以 Harness 2.0 不是“全部重来”，而是保留已经付过成本的数据，只重做最可能出问题的经验注入接口。','Harness 2.0 is not a full restart. It preserves already-paid-for data and redesigns only the experience-injection interface most likely to be causing the problem.')}</figcaption>
    </figure>
  </section>

  <section class="evo2__section" aria-labelledby="evo2-why-title">
    <p class="kicker">{t('为什么要做 Harness 2.0', 'WHY HARNESS 2.0')}</p>
    <h2 id="evo2-why-title">{t('同一套 Ceiling-1.0，7B 还能继续学，3B 却很快掉到“完全没有成功种子”', 'Under the same Ceiling-1.0 design, 7B kept learning while 3B fell to zero success seeds')}</h2>
    <div class="evo2__evidence">
      <article><span>3B</span><strong>{t(`${snap.ceiling1.threeB.sealedRounds} 轮 / ${snap.ceiling1.threeB.acceptedRollouts.toLocaleString()} 次任务 / 0 个新参数组件`, `${snap.ceiling1.threeB.sealedRounds} rounds / ${snap.ceiling1.threeB.acceptedRollouts.toLocaleString()} attempts / 0 new parameter components`)}</strong><p>{t('复核轨迹后发现，很多失败并不是“模型连动作格式都不会写”，而是动作格式看起来正常，但当前页面根本没有那个按钮或选项。这个现象让我们把注意力转向历史经验怎样进入提示词。','Trajectory review showed that many failures were not malformed actions. The actions looked syntactically valid but referred to buttons or options that did not exist on the current page, shifting attention to how historical experience enters the prompt.')}</p></article>
      <article><span>7B</span><strong>{t(`${snap.ceiling1.sevenB.sealedRounds} 轮 / ${snap.ceiling1.sevenB.acceptedRollouts.toLocaleString()} 次任务 / ${snap.ceiling1.sevenB.sdComponents} 个新参数组件`, `${snap.ceiling1.sevenB.sealedRounds} rounds / ${snap.ceiling1.sevenB.acceptedRollouts.toLocaleString()} attempts / ${snap.ceiling1.sevenB.sdComponents} new parameter components`)}</strong><p>{t('7B 在同一套方案下仍然能产生成功经验和新的参数组件。这说明 Ceiling-1.0 并不是“所有模型都完全不能学”，更像是同样的历史上下文对小模型负担更重。','7B still produced successful experience and new parameter components under the same design. This means Ceiling-1.0 was not universally unable to learn; the same historical context appears more burdensome for the smaller model.')}</p></article>
    </div>
    <p class="evo2__boundary">{t(`这些数字来自 ${snap.observedAt} 的历史快照，不是现在的实时进度，也不是最终能力结论。它们只解释我们为什么把下一步研究重点放到 Harness 2.0。`, `These values come from a historical snapshot at ${snap.observedAt}; they are not live progress or a final capability conclusion. They explain why the next investigation focuses on Harness 2.0.`)}</p>
  </section>

  <section class="evo2__section" aria-labelledby="evo2-changes-title">
    <p class="kicker">{t('这次具体改什么', 'WHAT CHANGES')}</p>
    <h2 id="evo2-changes-title">{t('Harness 2.0 第一版只改四件已经有直接证据的问题', 'Harness 2.0 changes only four problems already supported by evidence')}</h2>
    <div class="evo2__changes">{changes.map((item) => <article><span>{item.n}</span><strong>{item.title}</strong><p>{item.body}</p></article>)}</div>
    <div class="evo2__not-now"><strong>{t('其他变量先不动','WHAT STAYS FIXED')}</strong><p>{t('3B 现在表现差，也不因此临时改采样温度；不改成强制枚举动作；3B 和 7B 仍使用同一套正式规则。先只修已经看到直接证据的“历史经验压过当前页面”问题，避免一次改太多东西后又不知道到底什么起作用。','Poor 3B performance does not justify changing temperature midstream, switching to forced action enumeration, or giving 3B and 7B different formal rules. The first version fixes only the directly observed problem of historical experience overwhelming the live page, so later results remain interpretable.')}</p></div>
    <a class="evo2__mini-study" href={harnessStudyHref}>
      <span>MINI STUDY 01 · 128 + 128</span>
      <strong>{t('第一次 Harness 2.0 资格实验已经做完：机械检查过线，但新的正式 Stage 2 暂不启动','The first Harness 2.0 qualification is complete: mechanical checks passed, but formal Stage 2 remains on hold')}</strong>
      <p>{t('同一个 3B 起点配对比较 no-carrier control 和 Harness 2.0。Harness 组的非法终止更多，所以我们没有把“机械 PASS”当成“科学上应该激活”。','A paired study from the same 3B state compared no-carrier control with Harness 2.0. The Harness cell had more invalid terminations, so a mechanical PASS was not treated as scientific approval to activate.')}</p>
      <b>{t('查看实验设计、结果和 2.0.1 决定 →','Open the design, result, and 2.0.1 decision →')}</b>
    </a>
  </section>

  <section class="evo2__section" aria-labelledby="evo2-transition-title">
    <p class="kicker">{t('怎样从旧实验切到 Harness 2.0', 'HOW THE TRANSITION WORKS')}</p>
    <h2 id="evo2-transition-title">{t('旧实验的结果原样保留；Harness 2.0 从同一份 Stage 1 数据另开一条新实验线', 'Preserve the old results exactly and start Harness 2.0 as a separate line from the same Stage-1 data')}</h2>
    <div class="evo2__transition">
      <article><span>01</span><strong>{t('Ceiling-1.0 已经产生的结果不改写','Do not rewrite Ceiling-1.0 history')}</strong><p>{t('7B 和 3B 已经跑过的任务、成功轨迹和参数状态继续保留。发现 Harness 问题不等于把旧结果删掉或改名。','Tasks, successful traces, and parameter states already produced by 7B and 3B remain preserved. Discovering a harness problem does not delete or rename the old evidence.')}</p></article>
      <article><span>02 · DONE</span><strong>{t('两组各 128 次的小实验已经闭合','The paired 128-attempt checks are complete')}</strong><p>{t('两组都只用了已经消费过的旧训练任务；formal task consumption = 0，final panel access = 0。机械接口门 PASS，但 Harness 组行为更差，因此停在这里。','Both cells used already-consumed training tasks only; formal task consumption = 0 and final-panel access = 0. The mechanical interface gate passed, but Harness behavior was worse, so the route stops here.')}</p></article>
      <article><span>03 · CURRENT GATE</span><strong>{t('Stage2 readiness audit + dress rehearsal','Stage2 readiness audit + dress rehearsal')}</strong><p>{t('2.0.1 mechanical qualification 已经 PASS，但 scientific closeout 仍是 HOLD_FOR_STAGE2_READINESS_AUDIT。当前 formal_stage2_authorized=false、final_panel_access_authorized=false；只有显式 readiness release 才能重新授权 3B Stage 2。','2.0.1 mechanical qualification is already PASS, while scientific closeout remains HOLD_FOR_STAGE2_READINESS_AUDIT. Current state is formal_stage2_authorized=false and final_panel_access_authorized=false; only an explicit readiness release can authorize 3B Stage 2 again.')}</p></article>
    </div>

    <details class="evo2__artifacts">
      <summary>{t('实验记录与归档状态','Experiment records and archive status')}</summary>
      <div><span>{t('Ceiling-1.0 是否已经正式停止','Whether Ceiling-1.0 has a formal stop')}</span><b>{t('这个历史快照里还没有','Not in this historical snapshot')}</b></div>
      <div><span>{t('3B / 7B 已完成与未完成任务数','3B / 7B completed and partial task counts')}</span><b>{t('停止后从不可改写的运行记录确认','Confirm from immutable run records after stop')}</b></div>
      <div><span>{t('成功轨迹与参数更新','Successful traces and parameter updates')}</span><b>{t('停止后固定最终数字','Freeze final counts after stop')}</b></div>
      <div><span>{t('模型、轨迹与运行记录链接','Model, trajectory, and run-record links')}</span><b>{t('等待最终归档','Await final archive')}</b></div>
      <div><span>GitHub / Hugging Face</span><b>{t('等待发布确认','Await publication confirmation')}</b></div>
    </details>
    <p class="evo2__source">{t('这里展示的是研究说明，不是实时控制台。后续真实运行状态以 openevo-experiment 当前实验配置和最新不可改写运行记录为准。', 'This page is research documentation, not a live control console. Later execution state is determined by the current openevo-experiment configuration and the latest immutable run records.')}&nbsp;<a href={currentCampaignHref} target="_blank" rel="noreferrer">current-campaign ↗</a></p>
  </section>
</main>

<style>
.evo2{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}
.evo2__hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:2rem;align-items:end;padding:2rem 0;border-bottom:1px solid var(--color-border)}
.evo2__hero>div>p,.kicker{margin:0 0 .55rem;color:var(--color-accent);font:800 .64rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.evo2__hero h1,.evo2__section h2{margin:0;letter-spacing:-.04em}.evo2__hero h1{font-size:clamp(2.4rem,6vw,5rem)}.evo2__hero>div>span{display:block;margin-top:.8rem;max-width:72ch;color:var(--color-text-muted);line-height:1.7}.evo2__hero aside{display:flex;flex-direction:column;gap:.35rem;padding:1rem;border:1px solid var(--color-border);border-radius:12px;background:color-mix(in srgb,var(--color-accent) 4%,var(--color-bg))}.evo2__hero aside span{color:var(--color-text-muted);font:800 .58rem ui-monospace,SFMono-Regular,Menlo,monospace}.evo2__hero aside strong{font-size:.86rem}.evo2__hero aside small{color:var(--color-text-muted);line-height:1.55}
.evo2__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.evo2__section h2{font-size:clamp(1.45rem,3vw,2.35rem)}.evo2__section>p{max-width:82ch;color:var(--color-text-muted);line-height:1.68}
.lineage{position:relative;display:grid;grid-template-columns:.82fr 1fr 1.08fr;grid-template-rows:1fr 1fr;gap:1rem 2.6rem;min-height:420px;margin:1.2rem 0 0;padding:1.1rem;border:1px solid var(--color-border);border-radius:16px;background:color-mix(in srgb,var(--color-text) 1.5%,transparent)}.lineage>svg{position:absolute;inset:0;width:100%;height:100%;z-index:0;overflow:visible;pointer-events:none}.lineage>svg path{fill:none;stroke:color-mix(in srgb,var(--color-accent) 58%,var(--color-border));stroke-width:2.5;marker-end:url(#evo2-arrow)}.lineage>svg marker path{fill:var(--color-accent);stroke:none}.lineage__node{position:relative;z-index:1;align-self:center;padding:1rem;border:1px solid var(--color-border);border-radius:12px;background:var(--color-bg)}.lineage__node>span{color:var(--color-accent);font:800 .56rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em}.lineage__node strong,.lineage__node small{display:block}.lineage__node strong{margin:.35rem 0;font-size:.92rem}.lineage__node small{color:var(--color-text-muted);font:750 .62rem ui-monospace,SFMono-Regular,Menlo,monospace}.lineage__node p{margin:.55rem 0 0;color:var(--color-text-muted);font-size:.72rem;line-height:1.55}.lineage__node a{display:inline-block;margin-top:.55rem;color:var(--color-accent);font-size:.7rem;font-weight:760}.lineage__stage1{grid-column:1;grid-row:1/3}.lineage__state{grid-column:2;grid-row:1/3}.lineage__ceiling{grid-column:3;grid-row:1;border-style:dashed}.lineage__next{grid-column:3;grid-row:2;border-width:2px;border-color:var(--color-accent)}.lineage figcaption{grid-column:1/-1;align-self:end;color:var(--color-text-muted);font-size:.68rem;line-height:1.5}
