---
import type { Locale } from '../../i18n';

interface Step {
  id: string;
  kicker?: string;
  title: string;
  summary: string;
  detail?: string;
  outcome?: string;
  state?: string;
  current?: boolean;
  href?: string;
  hrefLabel?: string;
  mapChoice?: string;
}
interface Props {
  locale: Locale;
  eyebrow?: string;
  title: string;
  intro?: string;
  steps: Step[];
  compact?: boolean;
}
const { locale, eyebrow, title, intro, steps, compact = false } = Astro.props;
if (steps.length < 3 || steps.length > 6) throw new Error(`ResearchJourney requires 3–6 steps; received ${steps.length}`);
const zh = locale === 'zh';
---
<section class:list={['research-journey', compact && 'is-compact']} data-research-journey aria-label={title}>
  <header>
    {eyebrow && <p>{eyebrow}</p>}
    <h2>{title}</h2>
    {intro && <span>{intro}</span>}
  </header>
  <ol>
    {steps.map((step, index) => (
      <li data-research-step={step.id} data-current={step.current ? 'true' : undefined}>
        <details open={step.current || (!steps.some((item) => item.current) && index === 0)}>
          <summary>
            <span class="research-journey__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="research-journey__summary"><small>{step.kicker}</small><strong>{step.title}</strong><em>{step.summary}</em></span>
            {step.state && <b>{step.state}</b>}
          </summary>
          <div class="research-journey__body">
            {step.detail && <p>{step.detail}</p>}
            {step.outcome && <p class="research-journey__outcome"><strong>{zh ? '这一步之后：' : 'After this step:'}</strong> {step.outcome}</p>}
            {step.href && step.hrefLabel && <a href={step.href} data-map-choice={step.mapChoice}>{step.hrefLabel} →</a>}
          </div>
        </details>
      </li>
    ))}
  </ol>
</section>
<style>
.research-journey{width:min(1120px,calc(100% - 2rem));margin:0 auto;padding:1.2rem 0;border-bottom:1px solid var(--line)}
.research-journey>header{display:grid;grid-template-columns:minmax(220px,.6fr) minmax(0,1.4fr);gap:.4rem 1rem;align-items:end;margin-bottom:.75rem}.research-journey>header>p{grid-column:1/-1;margin:0;color:var(--accent-deep);font:800 .58rem/1.2 var(--font-mono);letter-spacing:.07em}.research-journey>header h2{margin:0;font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.08;letter-spacing:-.035em}.research-journey>header span{color:var(--muted);font-size:.84rem;line-height:1.55}
.research-journey ol{position:relative;display:grid;gap:.45rem;margin:0;padding:0;list-style:none}.research-journey ol::before{content:"";position:absolute;left:1.05rem;top:1.1rem;bottom:1.1rem;width:1px;background:var(--line)}
.research-journey li{position:relative;min-width:0}.research-journey details{border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface)}.research-journey li[data-current="true"] details{border-color:color-mix(in srgb,var(--accent) 70%,var(--line));box-shadow:inset 3px 0 0 var(--accent)}
.research-journey summary{position:relative;display:grid;grid-template-columns:2.1rem minmax(0,1fr) auto;gap:.7rem;align-items:start;padding:.78rem .9rem;cursor:pointer;list-style:none}.research-journey summary::-webkit-details-marker{display:none}.research-journey summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:var(--radius-panel)}
.research-journey__index{z-index:1;display:grid;place-items:center;width:2.1rem;height:2.1rem;border:1px solid var(--line);border-radius:50%;background:var(--surface);font:800 .66rem/1 var(--font-mono);color:var(--accent-deep)}.research-journey__summary{display:grid;gap:.14rem}.research-journey__summary small{color:var(--accent-deep);font:800 .52rem/1.2 var(--font-mono);letter-spacing:.05em}.research-journey__summary strong{font-size:.98rem;line-height:1.3}.research-journey__summary em{color:var(--muted);font-size:.75rem;line-height:1.45;font-style:normal}.research-journey summary>b{padding:.25rem .42rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font:800 .55rem/1.2 var(--font-mono);white-space:nowrap}
.research-journey__body{margin:0 .9rem .8rem 3.7rem;padding:.65rem .75rem;border-left:2px solid var(--line);background:var(--surface-muted);animation:research-reveal .18s ease}.research-journey__body p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.55}.research-journey__body p+p{margin-top:.48rem}.research-journey__outcome strong{color:var(--ink)}.research-journey__body a{display:inline-flex;margin-top:.5rem;color:var(--accent-deep);font-size:.76rem;font-weight:800;text-underline-offset:.2em}
.research-journey.is-compact>header h2{font-size:1.45rem}.research-journey.is-compact summary{padding:.65rem .75rem}
@keyframes research-reveal{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@media(max-width:760px){.research-journey{width:min(100% - 1rem,1120px)}.research-journey>header{grid-template-columns:1fr}.research-journey>header>p{grid-column:auto}.research-journey summary{grid-template-columns:2.1rem minmax(0,1fr)}.research-journey summary>b{grid-column:2;width:max-content;max-width:100%;white-space:normal}.research-journey__body{margin-left:3.2rem}}
@media(prefers-reduced-motion:reduce){.research-journey__body{animation:none}}
</style>
