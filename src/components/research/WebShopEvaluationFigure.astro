---
import ExternalBrandMark from '../common/ExternalBrandMark';
import MathFormula from '../common/MathFormula.astro';
import { type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (cn: string, en: string) => locale === 'zh' ? cn : en;
const rewardUrl = 'https://github.com/princeton-nlp/WebShop/blob/master/web_agent_site/engine/goal.py';
---
<section id="fig-webshop-evaluation" class="canonical-figure webshop-evaluation" aria-labelledby="webshop-evaluation-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">{t('第五步 · EVALUATION', 'STEP 5 · EVALUATION')}</div>
    <h3 id="webshop-evaluation-title">{t('WebShop 的最终评分：任务完成度与精确成功', 'WebShop evaluation: task completion and exact success')}</h3>
    <p>{t('Agent 点击购买后，评测器才对照购物单和最终买到的商品。部分条件满足可以获得部分分数，但只要还有条件没有满足，就不是完整成功。', 'Only after the purchase does the evaluator compare the request against the item and selected options. Partial matches can receive partial credit; incomplete matches are not exact success.')}</p>
  </header>
  <figure class="evaluation-story" aria-labelledby="webshop-evaluation-title">
    <div class="checkout-ledger" aria-label={t('购物要求与最终状态如何进入评分器', 'How goal and final purchase enter evaluation')}>
      <section class="checkout-input" data-ui-audit-item>
        <small>购物目标</small>
        <strong>{t('购物清单', 'Shopping request')}</strong>
        <ul>
          <li>{t('商品类型与商品属性', 'Product type and attributes')}</li>
          <li>{t('尺码、颜色等选项', 'Size, color and other options')}</li>
          <li>{t('价格上限', 'Price limit')}</li>
        </ul>
      </section>
      <section class="checkout-input" data-ui-audit-item>
        <small>实际购买结果</small>
        <strong>{t('实际购买结果', 'Actual purchase')}</strong>
        <ul>
          <li>{t('最后购买的商品', 'Selected product')}</li>
          <li>{t('已选的商品选项', 'Chosen product options')}</li>
          <li>{t('真实标价', 'Actual price')}</li>
        </ul>
      </section>
      <section class="checkout-output" data-ui-audit-item>
        <small>评测 · <code>get_reward(...)</code></small>
        <strong>{t('两份互补的结果', 'Two complementary outputs')}</strong>
        <dl>
          <div>
            <dt>{t('完成度 / Task Score', 'Task Score')}</dt>
            <dd><MathFormula latex={String.raw`\mathrm{task\_score}\in[0,1]`} display={false} label={t('task score 取值范围', 'task score range')} /></dd>
            <p>{t('Score 看完成程度', 'Score measures degree of completion')}</p>
          </div>
          <div>
            <dt>EXACT SUCCESS</dt>
            <dd><MathFormula latex={String.raw`\mathrm{won}\in\{\mathrm{false},\mathrm{true}\}`} display={false} label={t('exact success 布尔取值', 'exact success boolean')} /></dd>
            <p>{t('只有全部要求满足才算完整成功。', 'Exact success requires every goal condition.')}</p>
          </div>
        </dl>
      </section>
    </div>
    <p class="evaluation-interpretation">{t(
      'Score 是对最终条件的部分满足程度评分，Exact Success 是完整成功判断。它们不是按 search → click → option → buy 四个动作依次发分。商品类型匹配系数还可能降低整体分数。',
      'Score evaluates how well the final item matches the goal; Exact Success checks completion. Neither is a per-action payment for search → click → options → buy, and product-type matching can further scale the score.'
    )}</p>
    <details class="evidence">
      <summary>{t('查看官方评分代码与记录边界', 'Inspect official scoring and recording rules')}</summary>
      <div class="evidence-grid">
        <div>
          <strong>WebShop goal.py · {t('官方评分器', 'official evaluator')}</strong>
          <code>get_reward(product, goal, price, options)</code>
          <p>{t('属性、选项与价格条件的匹配结果按 goal 的总要求数归一化，随后乘商品类型匹配系数 r_type。', 'Attribute, option and price matches are normalized by the goal requirements, then multiplied by the product-type factor r_type.')}</p>
          <a href={rewardUrl} target="_blank" rel="noreferrer"><ExternalBrandMark href={rewardUrl} />{t('查看官方 get_reward(...) ↗', 'View official get_reward(...) ↗')}</a>
        </div>
        <div>
          <strong>{t('实验记录合同', 'Experiment recording contract')}</strong>
          <code>task_score + won</code>
          <p>{t('两者需要分别保存。上面的交互是受限的教学案例，不是某一次实验 run 的测量结果。', 'Preserve both outputs. The interactive example above is bounded teaching material, not a measured episode.')}</p>
        </div>
      </div>
    </details>
    <figcaption>{t('对终局购物要求逐项评分，并保留 Task Score 与 Exact Success。公平的 SEED/OpenEvo 比较必须对双方使用同一套 evaluator。', 'Evaluate the terminal purchase against its requirements and preserve Task Score and Exact Success. A fair SEED/OpenEvo comparison must use the same evaluator for both.')}</figcaption>
  </figure>
</section>
<style>
  .webshop-evaluation{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:940px}.figure-label{color:var(--accent);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-heading) var(--font-interface);letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.75rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:var(--type-leading-body)}.evaluation-story{margin:1.5rem 0 0}
  .eval-flow{display:grid;grid-template-columns:minmax(160px,.8fr) auto minmax(170px,.85fr) auto minmax(180px,.9fr) auto minmax(260px,1.35fr);gap:.6rem;align-items:stretch}.eval-node{display:flex;min-width:0;flex-direction:column;padding:.9rem;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}.eval-node small,.eval-output small{display:block;color:var(--muted);font:800 .56rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em}.eval-node strong{display:block;margin:.35rem 0 .55rem;font-size:.9rem}.eval-node ul{display:grid;gap:.35rem;margin:0;padding:0;list-style:none}.eval-node li{padding:.35rem .45rem;border-top:1px solid var(--line);font-size:.66rem;color:var(--muted)}.eval-node code{display:block;margin:.1rem 0 .45rem;padding:.45rem;border-radius:6px;background:var(--surface);font-size:.64rem;overflow-wrap:anywhere}.eval-node>span{margin-top:.1rem;color:var(--muted);font-size:.67rem;line-height:1.45}.eval-node a{display:inline-block;margin-top:auto;padding-top:.65rem;color:var(--accent);font-size:.65rem;font-weight:800}.goal{border-top:4px solid var(--accent)}.terminal{border-top:4px solid var(--line-strong,var(--line))}.evaluator{border-top:4px solid var(--success)}.eval-plus,.eval-arrow{display:grid;place-items:center;color:var(--muted);font-size:1.3rem;font-weight:900}
  .eval-output{display:grid;grid-template-columns:1fr;gap:.55rem;min-width:0}.eval-output article{min-width:0;padding:.85rem;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.eval-output article>strong{display:block;margin:.35rem 0 .55rem;font-size:.82rem;overflow-wrap:anywhere}.eval-output p{margin:.55rem 0 0;color:var(--muted);font-size:.67rem;line-height:1.45}.score-output{border-top:4px solid var(--accent)!important}.exact-output{border-top:4px solid var(--success)!important}.score-scale{padding:.4rem 0}.score-track{height:10px;border:1px solid var(--line);border-radius:999px;background:linear-gradient(to right,var(--surface-muted),color-mix(in srgb,var(--accent) 24%,var(--surface)),color-mix(in srgb,var(--success) 30%,var(--surface)));overflow:hidden}.score-track span{display:block;width:100%;height:100%}.score-ticks{display:flex;justify-content:space-between;margin-top:.35rem;color:var(--muted);font:800 .56rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.exact-symbols{display:grid;grid-template-columns:1fr 1fr;gap:.35rem}.exact-symbols span{display:grid;place-items:center;height:40px;border:1px solid var(--line);border-radius:8px;background:var(--surface-muted);font-size:1rem;font-weight:900}.exact-symbols span:last-child{border-color:color-mix(in srgb,var(--success) 45%,var(--line));background:color-mix(in srgb,var(--success) 8%,var(--surface))}
  .metric-meaning{display:grid;grid-template-columns:minmax(220px,.75fr) minmax(0,1.25fr);gap:1rem;align-items:start;margin-top:1rem;padding:1rem;border-left:4px solid var(--accent);border-radius:0 10px 10px 0;background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.metric-meaning small{display:block;color:var(--muted);font:800 .56rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em}.metric-meaning strong{display:block;margin-top:.28rem;font-size:.85rem}.metric-meaning p{margin:0;color:var(--muted);font-size:.74rem;line-height:1.55}
  .evidence{margin-top:1rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.evidence summary{cursor:pointer;padding:.85rem 1rem;font-weight:var(--type-weight-heading);font-size:var(--type-meta)}.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;padding:0 1rem 1rem}.evidence-grid article{padding:.8rem;border:1px solid var(--line);border-radius:8px;background:var(--surface-muted)}.evidence-grid small{display:block;color:var(--muted);font:800 .56rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.evidence-grid code{display:block;margin:.45rem 0;padding:.5rem;border-radius:6px;background:var(--surface);font-size:var(--type-meta);overflow-wrap:anywhere}.evidence-grid p{margin:0;color:var(--muted);font-size:var(--type-body-small);line-height:var(--type-leading-body)}.evidence-grid a{display:inline-block;margin-top:.55rem;color:var(--accent);font-size:var(--type-meta);font-weight:var(--type-weight-label)}.evaluation-story figcaption{margin-top:.85rem;color:var(--muted);font-size:var(--type-caption);line-height:var(--type-leading-caption)}
  @media(max-width:980px){.eval-flow{grid-template-columns:1fr}.eval-plus,.eval-arrow{min-height:30px;transform:rotate(90deg)}.eval-output{grid-template-columns:1fr}.metric-meaning{grid-template-columns:1fr}}
  @media(max-width:620px){.webshop-evaluation{width:min(100% - 1rem,1120px);padding:1rem}.eval-output,.evidence-grid{grid-template-columns:1fr}}

@container article-figure (max-width:980px){.eval-flow{grid-template-columns:1fr}.eval-plus,.eval-arrow{min-height:30px;transform:rotate(90deg)}.eval-output{grid-template-columns:1fr}.metric-meaning{grid-template-columns:1fr}}
@container article-figure (max-width:620px){.webshop-evaluation{width:min(100% - 1rem,1120px);padding:1rem}.eval-output,.evidence-grid{grid-template-columns:1fr}}
</style>
