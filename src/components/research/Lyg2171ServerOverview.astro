---
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const userStorage = [
  { label: t('用户 1', 'User 1'), home: '92.1 GiB', docker: '10.7 GiB', total: '102.8 GiB', share: '23.6%' },
  { label: t('我们的账户', 'Our account'), home: '72.5 GiB', docker: '11.9 GiB', total: '84.4 GiB', share: '19.4%', ours: true },
  { label: t('用户 2', 'User 2'), home: '13.4 GiB', docker: '5.06 GiB', total: '18.5 GiB', share: '4.2%' },
  { label: t('用户 3', 'User 3'), home: '9.32 GiB', docker: '1.69 GiB', total: '11.0 GiB', share: '2.5%' },
  { label: t('用户 4', 'User 4'), home: '1.36 GiB', docker: '2.97 GiB', total: '4.33 GiB', share: '1.0%' },
  { label: t('用户 5', 'User 5'), home: '0.58 GiB', docker: '0.28 GiB', total: '0.86 GiB', share: '0.2%' },
  { label: t('用户 6', 'User 6'), home: '<0.01 GiB', docker: '<0.01 GiB', total: '<0.01 GiB', share: '<0.1%' },
];

const gpuFacts = [
  { k: t('GPU 数量', 'GPU count'), v: '8 × RTX 5090' },
  { k: t('代际 / 架构', 'Generation / architecture'), v: 'GeForce RTX 50 · Blackwell' },
  { k: t('CUDA 核', 'CUDA cores'), v: '21,760 / GPU · 174,080 total' },
  { k: t('显存', 'VRAM'), v: '32,607 MiB / GPU · ≈ 254.7 GiB total' },
  { k: 'Compute Capability', v: '12.0' },
  { k: t('驱动快照', 'Driver snapshot'), v: '610.57.04' },
];
---
<main class="server-overview" data-locale={locale}>
  <header class="server-hero">
    <div class="server-hero__eyebrow">{t('实验服务器 · lyg2171', 'Experiment server · lyg2171')}</div>
    <h1>{t('lyg2171 服务器简介', 'lyg2171 server overview')}</h1>
    <p>{t('lyg2171 是当前 OpenEvo / WebShop 实验使用的主要训练服务器。配置为 2 × Intel Xeon Platinum 8380、1.0 TiB 内存和 8 × RTX 5090；本次存储快照中，主文件系统只剩约 18.0 GiB 可用空间。', 'lyg2171 is the main training server used for the current OpenEvo / WebShop experiments. It has 2 × Intel Xeon Platinum 8380 CPUs, 1.0 TiB RAM, and 8 × RTX 5090 GPUs; in this storage snapshot, only about 18.0 GiB remains available on the main filesystem.')}</p>
    <div class="snapshot-note">
      <strong>{t('存储快照', 'Storage snapshot')}</strong>
      <span>2026-09-02 09:12 (UTC+8)</span>
      <span>{t('静态快照，不是实时监控面板', 'Static snapshot, not a live monitoring dashboard')}</span>
    </div>
  </header>

  <section class="priority-grid" aria-label={t('关键资源', 'Key resources')}>
    <article class="priority-card priority-card--attention">
      <span>{t('磁盘剩余', 'Disk free')}</span>
      <strong>18.0 GiB</strong>
      <h2>{t('主文件系统可用空间', 'Main filesystem available')}</h2>
      <p>{t('本次存储快照中，df 报告 96% 已使用。大 checkpoint、Docker/容器层或重复实验副本都可能很快把它推满。', 'In this storage snapshot, df reports 96% used. Large checkpoints, container layers, or duplicate experiment copies can fill it quickly.')}</p>
    </article>
    <article class="priority-card">
      <span>GPU</span>
      <strong>8 × 5090</strong>
      <h2>GeForce RTX 50 · Blackwell</h2>
      <p>{t('每张约 31.8 GiB 显存。8 张卡的显存不能自动当成一张 254.7 GiB 的大卡，是否能合并使用取决于并行策略。', 'Each GPU has about 31.8 GiB VRAM. Eight GPUs do not automatically behave like one 254.7 GiB GPU; usable aggregate memory depends on the parallelism strategy.')}</p>
    </article>
    <article class="priority-card">
      <span>CPU</span>
      <strong>80 / 160</strong>
      <h2>{t('80 个物理核 · 160 个逻辑线程', '80 physical cores · 160 logical threads')}</h2>
      <p>2 × Intel Xeon Platinum 8380 @ 2.30 GHz · 40 {t('核/路', 'cores/socket')} · 2 {t('线程/核', 'threads/core')}</p>
    </article>
    <article class="priority-card">
      <span>RAM</span>
      <strong>1.0 TiB</strong>
      <h2>{t('内存容量', 'System memory')}</h2>
      <p>{t('1.0 TiB 是已核验的内存容量；RAM 的瞬时使用量没有在 2026-09-02 的存储审计中重新测量。', '1.0 TiB is the verified memory capacity; momentary RAM usage was not remeasured during the 2026-09-02 storage audit.')}</p>
    </article>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>01</span>
      <div>
        <small>{t('存储', 'Storage')}</small>
        <h2>{t('磁盘使用情况', 'Filesystem usage')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('主文件系统总容量约 436.0 GiB。本次快照已用 395.9 GiB，df 报 96% 使用率，普通写入只剩约 18.0 GiB。能按账户可靠归属的部分单独计算；共享 Docker 镜像和系统占用不强行分摊给任何个人。', 'The main filesystem has about 436.0 GiB of total capacity. This snapshot shows 395.9 GiB used, df at 96%, and only about 18.0 GiB available for ordinary writes. Usage that can be reliably tied to an account is counted separately; shared Docker images and system usage are not forced onto an individual.')}</p>

    <div class="storage-status">
      <div class="storage-status__numbers">
        <div><span>{t('文件系统', 'Filesystem')}</span><strong>436.0 GiB</strong></div>
        <div><span>{t('已用', 'Used')}</span><strong>395.9 GiB</strong></div>
        <div><span>{t('可用', 'Available')}</span><strong>18.0 GiB</strong></div>
        <div><span>df Use%</span><strong>96%</strong></div>
      </div>
      <div class="storage-bar" role="img" aria-label={t('436.0 GiB 主文件系统：可按账户归属的主目录与 Docker 写入层合计 221.8 GiB；无法归属到具体账户的 Docker 写入层 10.5 GiB；其余共享与系统占用 163.5 GiB；可用 18.0 GiB；文件系统保留与舍入 22.2 GiB。', '436.0 GiB main filesystem: 221.8 GiB is attributable to accounts through home directories plus Docker writable layers; 10.5 GiB is Docker writable-layer usage not attributable to a specific account; 163.5 GiB is other shared/system usage; 18.0 GiB is available; 22.2 GiB is filesystem reserve/rounding.') }>
        <span class="storage-bar__users" style="width:50.9%"></span>
        <span class="storage-bar__docker" style="width:2.4%"></span>
        <span class="storage-bar__shared" style="width:37.5%"></span>
        <span class="storage-bar__free" style="width:4.1%"></span>
        <span class="storage-bar__reserved" style="width:5.1%"></span>
      </div>
      <div class="storage-legend">
        <div><i class="legend-swatch legend-swatch--users"></i><span>{t('可按账户归属', 'Account-attributed')}</span><strong>221.8 GiB · 50.9%</strong></div>
        <div><i class="legend-swatch legend-swatch--docker"></i><span>{t('未归属 Docker 写入层', 'Unattributed Docker writable layers')}</span><strong>10.5 GiB · 2.4%</strong></div>
        <div><i class="legend-swatch legend-swatch--shared"></i><span>{t('共享 / 系统占用', 'Shared / system usage')}</span><strong>163.5 GiB · 37.5%</strong></div>
        <div><i class="legend-swatch legend-swatch--free"></i><span>{t('可用空间', 'Available')}</span><strong>18.0 GiB · 4.1%</strong></div>
        <div><i class="legend-swatch legend-swatch--reserved"></i><span>{t('文件系统保留 / 舍入', 'Filesystem reserve / rounding')}</span><strong>22.2 GiB · 5.1%</strong></div>
      </div>
      <p class="fine-print">{t('“可按账户归属”只把主目录和能够通过容器 home 挂载明确关联到该账户的 Docker 写入层相加。共享 Docker 镜像、构建缓存和系统文件不会因为方便统计就分摊给某个用户。所有百分比均以 436.0 GiB 总容量为分母。', '“Account-attributed” adds only home-directory usage and Docker writable layers that can be tied to an account through its home mount. Shared Docker images, build cache, and system files are not assigned to a user just to make the totals look complete. All percentages use 436.0 GiB total capacity as the denominator.')}</p>
      <div class="why-df">
        <strong>{t('为什么 df 显示 96%', 'Why df reports 96%')}</strong>
        <p>{t('df 的 96% 不是简单的 395.9 ÷ 436.0，因为文件系统会保留一部分空间；普通写入当前只剩约 18.0 GiB。', 'The 96% shown by df is not simply 395.9 ÷ 436.0 because the filesystem reserves part of its capacity; only about 18.0 GiB is currently available for ordinary writes.')}</p>
      </div>
      <div class="why-df">
        <strong>{t('共享 Docker 镜像', 'Shared Docker images')}</strong>
        <p>{t('同一次审计里，Docker 汇总报告 159 GB 镜像，其中 93.57 GB 被标记为 reclaimable。这里保留 Docker 的十进制单位；reclaimable 只是清理候选统计，不等于这些内容已获准删除。', 'In the same audit, Docker reported 159 GB of images, with 93.57 GB marked reclaimable. Those figures keep Docker’s decimal units; “reclaimable” is a cleanup-candidate estimate, not permission to delete the data.')}</p>
      </div>
    </div>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>02</span>
      <div>
        <small>{t('账户占用', 'Account usage')}</small>
        <h2>{t('各用户磁盘占用', 'Disk usage by account')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('每个账户的“可归属合计” = 主目录 + 与该账户 home 挂载关联的 Docker 写入层。Docker 写入层是容器内部新增、还没有算进主目录的文件；共享镜像不属于某一个用户。', 'Each account’s “attributable total” equals its home directory plus Docker writable layers tied to that account’s home mount. A writable layer contains files added inside a container that are not part of the home directory; shared images do not belong to one user.')}</p>
    <div class="storage-table-wrap" role="region" aria-label={t('匿名账户磁盘占用表', 'Anonymized account disk-usage table')} tabindex="0">
      <table class="storage-table">
        <thead>
          <tr>
            <th scope="col">{t('账户', 'Account')}</th>
            <th scope="col">{t('主目录', 'Home directory')}</th>
            <th scope="col">{t('Docker 写入层', 'Docker writable layers')}</th>
            <th scope="col">{t('可归属合计', 'Attributable total')}</th>
            <th scope="col">{t('全盘占比', 'Share of filesystem')}</th>
          </tr>
        </thead>
        <tbody>
          {userStorage.map((item) => (
            <tr class:list={{ 'storage-table__ours': item.ours }}>
              <th scope="row">{item.label}</th>
              <td>{item.home}</td>
              <td>{item.docker}</td>
              <td><strong>{item.total}</strong></td>
              <td>{item.share}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine-print">{t('用户 1–6 是 2026-09-02 09:12（UTC+8）快照中其他账户按“可归属合计”从大到小排序后的匿名标签，不是公开身份，也不是永久编号。我们的账户单独标出，但不公开 Unix 用户名。', 'Users 1–6 are anonymous labels for other accounts, sorted by attributable total in the 2026-09-02 09:12 (UTC+8) snapshot. They are not public identities or permanent IDs. Our account is marked separately without publishing its Unix username.')}</p>
    <p class="section-callout">{t('我们的账户可归属约 84.4 GiB：主目录约 72.5 GiB，Docker 写入层约 11.9 GiB；在 2026-09-02 09:12（UTC+8）快照里仅次于用户 1 的约 102.8 GiB。需要释放空间时，只处理我们自己的实验文件和明确属于我们的容器。', 'Our account has about 84.4 GiB of attributable usage: roughly 72.5 GiB in the home directory and 11.9 GiB in Docker writable layers. In the 2026-09-02 09:12 (UTC+8) snapshot it is second to User 1 at about 102.8 GiB. If space must be reclaimed, only our own experiment files and clearly owned containers should be modified.')}</p>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>03</span>
      <div>
        <small>GPU</small>
        <h2>{t('GPU 规格', 'GPU specifications')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('RTX 5090 属于 GeForce RTX 50 系列，采用 Blackwell 架构。单卡 21,760 个 CUDA 核，显存 32,607 MiB，Compute Capability 为 12.0。', 'RTX 5090 belongs to the GeForce RTX 50 series and uses the Blackwell architecture. Each GPU has 21,760 CUDA cores, 32,607 MiB VRAM, and Compute Capability 12.0.')}</p>
    <dl class="gpu-facts">
      {gpuFacts.map((item) => <div><dt>{item.k}</dt><dd>{item.v}</dd></div>)}
    </dl>
    <div class="gpu-note">
      <strong>{t('多卡性能说明', 'Multi-GPU performance note')}</strong>
      <p>{t('8 张卡 × 21,760 CUDA 核可以得到整机 174,080 CUDA 核这个“规格总和”，但训练速度不会简单变成单卡的 8 倍。数据并行、模型并行、通信和显存分配都会决定实际收益。', 'Eight cards × 21,760 CUDA cores gives a hardware-spec total of 174,080 CUDA cores, but training does not automatically become eight times faster. Data/model parallelism, communication, and memory placement determine the real gain.')}</p>
    </div>
  </section>

  <section class="server-section server-section--privacy">
    <div class="section-heading">
      <span>04</span>
      <div>
        <small>{t('隐私边界', 'Privacy boundary')}</small>
        <h2>{t('资源归属与隐私', 'Usage attribution and privacy')}</h2>
      </div>
    </div>
    <div class="privacy-grid">
      <div>
        <strong>{t('公开展示', 'Shown publicly')}</strong>
        <p>{t('总容量、总占用、可用空间、GPU 型号与数量，以及按可归属总量排序的匿名“用户 1–6”、我们的匿名账户汇总、主目录与 Docker 写入层大小。匿名编号只对应 2026-09-02 09:12（UTC+8）快照的排序。', 'Total capacity, total usage, free space, GPU model/count, anonymous “Users 1–6” ranked by attributable total, our own anonymized aggregate, and the home-directory/Docker writable-layer split. Anonymous numbering applies only to the 2026-09-02 09:12 (UTC+8) snapshot.')}</p>
      </div>
      <div>
        <strong>{t('不公开', 'Not shown')}</strong>
        <p>{t('其他人的用户名、容器名、容器 ID、GPU 进程命令、GPU UUID、IP、SSH 别名或任何可反查身份的信息。', 'Other users’ names, container names/IDs, GPU process commands, GPU UUIDs, IPs, SSH aliases, or other identity-revealing details.')}</p>
      </div>
    </div>
  </section>

  <details class="measurement-notes">
    <summary>{t('数据来源', 'Data sources')}</summary>
    <p>{t('主文件系统来自 df -B1 /；七个可识别账户的主目录来自只读 du；Docker 写入层来自容器 size 信息，并通过容器挂载到的 home 目录做匿名归属；无法可靠归属的容器写入层保留为单独一项。Docker system df 只用于汇总共享镜像、容器、卷和 build cache，不把共享镜像强行分摊给个人。CPU / GPU 规格沿用已核验的硬件配置。页面只保存匿名后的容量数字，不保存其他人的用户名、SSH 地址、GPU UUID、容器名或容器 ID。', 'The main filesystem comes from df -B1 /; home-directory sizes for seven identifiable accounts come from read-only du measurements; Docker writable-layer sizes come from container size data and are anonymized by the home directory mounted into each container. Writable layers that cannot be reliably tied to an account remain separate. Docker system df is used only for shared image/container/volume/build-cache totals; shared images are not forced onto individual users. CPU/GPU specifications remain the previously verified hardware configuration. The page stores only anonymized capacity figures, not other users’ names, SSH endpoints, GPU UUIDs, container names, or container IDs.')}</p>
  </details>
</main>

<style>
  .server-overview{color:var(--ink)}
  .server-hero{max-width:930px;padding:clamp(1.4rem,4vw,3rem) 0 1.35rem}
  .server-hero__eyebrow{color:var(--accent-deep);font:800 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}
  .server-hero h1{max-width:18ch;margin:.55rem 0 .8rem;font-size:clamp(2rem,5vw,4.2rem);line-height:.98;letter-spacing:-.055em}
  .server-hero>p{max-width:72ch;margin:0;color:var(--muted);font-size:1.02rem;line-height:1.75}
  .snapshot-note{display:flex;flex-wrap:wrap;gap:.45rem .75rem;align-items:center;margin-top:1rem;color:var(--muted);font-size:.72rem}
  .snapshot-note strong{color:var(--ink)}
  .snapshot-note span+span{padding-left:.75rem;border-left:1px solid var(--line)}

  .priority-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin:1rem 0 3.5rem}
  .priority-card{min-height:220px;padding:1.15rem;border:1px solid var(--line);border-radius:18px;background:var(--surface)}
  .priority-card--attention{border-color:color-mix(in srgb,var(--accent-deep) 48%,var(--line));background:color-mix(in srgb,var(--accent) 8%,var(--surface))}
  .priority-card>span{display:block;color:var(--muted);font:800 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase}
  .priority-card>strong{display:block;margin:.8rem 0 .3rem;font-size:clamp(1.85rem,3vw,3rem);line-height:1;letter-spacing:-.055em}
  .priority-card h2{margin:.2rem 0 .75rem;font-size:.9rem;line-height:1.35}
  .priority-card p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.65}

  .server-section{padding:2.4rem 0;border-top:1px solid var(--line)}
  .section-heading{display:flex;gap:.8rem;align-items:flex-start;margin-bottom:1rem}
  .section-heading>span{padding-top:.2rem;color:var(--accent-deep);font:800 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}
  .section-heading small{display:block;color:var(--muted);font:800 .62rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase}
  .section-heading h2{margin:.24rem 0 0;font-size:clamp(1.35rem,2.7vw,2.2rem);letter-spacing:-.035em}
  .section-lede{max-width:76ch;margin:0 0 1.35rem;color:var(--muted);line-height:1.75}

  .storage-status{padding:1.15rem;border:1px solid var(--line);border-radius:18px;background:var(--surface)}
  .storage-status__numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-bottom:1rem}
  .storage-status__numbers>div{padding:.8rem;border-radius:12px;background:color-mix(in srgb,var(--ink) 3%,transparent)}
  .storage-status__numbers span,.storage-status__numbers strong{display:block}
  .storage-status__numbers span{color:var(--muted);font-size:.7rem}
  .storage-status__numbers strong{margin-top:.2rem;font-size:1.35rem;letter-spacing:-.035em}
  .storage-bar{display:flex;height:30px;overflow:hidden;border:1px solid var(--line);border-radius:9px;background:color-mix(in srgb,var(--ink) 3%,transparent)}
  .storage-bar span{display:block;height:100%}
  .storage-bar__users{background:var(--accent-deep)}
  .storage-bar__docker{background:color-mix(in srgb,var(--accent-deep) 52%,var(--surface))}
  .storage-bar__shared{background:color-mix(in srgb,var(--ink) 48%,var(--surface))}
  .storage-bar__free{background:color-mix(in srgb,var(--accent) 18%,var(--surface))}
  .storage-bar__reserved{background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--ink) 15%,var(--surface)) 0 4px,transparent 4px 8px)}
  .storage-legend{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin-top:.75rem}
  .storage-legend>div{display:grid;grid-template-columns:auto 1fr;gap:.08rem .45rem;align-items:center;padding:.62rem .7rem;border:1px solid var(--line);border-radius:10px}
  .storage-legend span{color:var(--muted);font-size:.68rem}
  .storage-legend strong{grid-column:2;font-size:.82rem}
  .legend-swatch{grid-row:1/3;width:9px;height:9px;border-radius:50%}
  .legend-swatch--users{background:var(--accent-deep)}
  .legend-swatch--docker{background:color-mix(in srgb,var(--accent-deep) 52%,var(--surface))}
  .legend-swatch--shared{background:color-mix(in srgb,var(--ink) 48%,var(--surface))}
  .legend-swatch--free{background:color-mix(in srgb,var(--accent) 38%,var(--surface))}
  .legend-swatch--reserved{border:1px solid var(--muted);background:transparent}
  .fine-print{margin:.85rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.6}
  .why-df{margin-top:1rem;padding:.9rem 1rem;border-left:3px solid var(--accent-deep);background:color-mix(in srgb,var(--accent) 6%,transparent)}
  .why-df strong{font-size:.8rem}
  .why-df p{margin:.25rem 0 0;color:var(--muted);font-size:.76rem;line-height:1.65}

  .storage-table-wrap{max-width:100%;overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
  .storage-table-wrap:focus-visible{outline:2px solid var(--accent-deep);outline-offset:3px}
  .storage-table{width:100%;min-width:720px;border-collapse:collapse;font-size:.78rem;font-variant-numeric:tabular-nums}
  .storage-table th,.storage-table td{padding:.72rem .8rem;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
  .storage-table th:first-child,.storage-table td:first-child{text-align:left}
  .storage-table thead th{color:var(--muted);font-size:.68rem;font-weight:760;background:color-mix(in srgb,var(--ink) 3%,transparent)}
  .storage-table tbody tr:last-child>*{border-bottom:0}
  .storage-table tbody th{font-weight:760}
  .storage-table__ours>*{background:color-mix(in srgb,var(--accent) 7%,var(--surface))}
