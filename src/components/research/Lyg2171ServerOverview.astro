---
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const historicalAttribution = [
  { label: t('用户 1', 'User 1'), total: '107.8 GiB', share: '24.7%', width: '24.7%', tone: 1 },
  { label: t('用户 2', 'User 2'), total: '65.8 GiB', share: '15.1%', width: '15.1%', tone: 2 },
  { label: t('用户 3', 'User 3'), total: '22.2 GiB', share: '5.1%', width: '5.1%', tone: 3 },
  { label: t('用户 4', 'User 4'), total: '15.3 GiB', share: '3.5%', width: '3.5%', tone: 4 },
  { label: t('用户 5', 'User 5'), total: '7.81 GiB', share: '1.8%', width: '1.8%', tone: 5 },
  { label: t('用户 6', 'User 6'), total: '3.14 GiB', share: '0.7%', width: '0.7%', tone: 6 },
  { label: t('用户 7', 'User 7'), total: '<0.01 GiB', share: '<0.1%', width: '0%', tone: 7, tiny: true },
];

const routinePrompt = t(
  `请执行一次“例行服务器维护”。这段 Prompt 只负责启动，不固定 Passport 版本。\n\n第一步先刷新并读取 current authority：mykcs/zju-server、mykcs/openevo-experiment、mykcs/basemodel 的 current main 与根 AGENTS.md。对 OpenEvo 必须读取 current main 的 docs/operations/governance/EXPERIMENT_STANDARD.md、docs/operations/governance/RUN_MANIFEST_CONTRACT.md、docs/experiment-tracking/EXPERIMENT_PASSPORT_REGISTRY_IMPLEMENTATION_PLAN_202609111800.md，以及 current Experiment Registry / Passport schema / CLI/router。若 main 或当前 campaign authority 已正式采用更新的 Passport / DAG / lifecycle 标准，以更新 canonical authority 为准；open Draft PR 只能用于发现重叠或待合入能力，不能单独授权科学复用、删除或改变公开可见性。\n\n然后自动按顺序推进：只读健康扫描 → 对已封存/空闲且归属明确的实验按当前标准补齐 Experiment Passport / Run Manifest / member manifest → 按现行发布规则归档或复用远端 → fresh read/download/restore 验证 → 更新 lifecycle → 生成 exact NOT_AUTHORIZED reclaim proposal。例行、可逆且已有 authority 的步骤不要每一步都问我。\n\n只有遇到这些边界才停下来找我：exact 删除清单批准；任何 private→public 或其他 visibility/license 变化（包括 Hugging Face 私有容量不够）；科学语义/实验身份变化；ownership 不清；canonical authority 缺失或冲突。禁止 broad Docker prune；已有可信 producer digest/receipt 时不要为了整理重新 hash 数百 GiB 大文件。最后用 ELI5 中文告诉我：做了什么、服务器现在怎样、归档还欠多少、哪些对象只是 reclaim proposal、需要我决定什么。`,
  `Run routine server maintenance. This prompt only starts the workflow; it does not pin a Passport version. First refresh current main and root AGENTS.md for mykcs/zju-server, mykcs/openevo-experiment, and mykcs/basemodel. For OpenEvo, read current-main EXPERIMENT_STANDARD.md, RUN_MANIFEST_CONTRACT.md, EXPERIMENT_PASSPORT_REGISTRY_IMPLEMENTATION_PLAN_202609111800.md, and the current Experiment Registry / Passport schema / CLI/router. If main or the current campaign authority has formally adopted a newer Passport/DAG/lifecycle standard, use that newer canonical authority. Open Draft PRs may be inspected for overlap but cannot independently authorize scientific reuse, deletion, or visibility changes. Then continue automatically through read-only health scan, current-standard Passport/Run Manifest/member-manifest closeout for sealed or idle project-owned experiments, remote archive/reuse, fresh read/download/restore verification, lifecycle refresh, and an exact NOT_AUTHORIZED reclaim proposal. Do not stop for routine reversible steps already authorized. Stop only for approval of an exact deletion manifest, any visibility/license change including insufficient private Hugging Face capacity, scientific-identity changes, unresolved ownership, or missing/conflicting canonical authority. Never broad-prune shared Docker, and do not re-hash hundreds of GiB when trustworthy producer digests/receipts already bind the bytes. End with a plain summary of what changed, current server health, remaining archive debt, reclaim proposals, and owner decisions required.`
);

const healthPrompt = t(
  `请按 BaseModel 的 docs/agents/current/server-storage-pressure-audit-sop.md 做一次“服务器健康扫描”。\n\n只读检查持久文件系统 df / inode、当前活跃进程与容器引用、最近新增的大型科研产物和 Passport / lifecycle 覆盖变化。优先使用已知路径与浅层元数据；不要做全盘 checksum，不要跨用户绕权，不要移动或删除任何文件，不要 broad Docker prune。\n\n最后用 ELI5 中文告诉我：现在最占空间的是什么、哪些是活跃工作集、哪些只是待收尾资产、有没有立即需要处理的风险。`,
  `Run a read-only server health scan using docs/agents/current/server-storage-pressure-audit-sop.md. Check the persistent filesystem df/inodes, live process/container references, newly large research artifacts, and Passport/lifecycle coverage changes. Use bounded metadata first; do not run whole-tree checksums, cross user boundaries, move/delete files, or broad-prune Docker. End with a plain summary of the largest storage owners, hot working set, closeout debt, and immediate risk.`
);

const closeoutPrompt = t(
  `请按 BaseModel 的 docs/agents/current/server-artifact-governance-and-reclaim-sop.md 做一次“实验收尾归档”。\n\n目标是把一个已完成或阶段性封存的实验变成可恢复的科研资产：补齐 Run / Artifact Passport，生成 member manifest，按语义发布或复用 GitHub / Hugging Face / GHCR 远端对象，并做 fresh read / download / reload / restore 验证。更新 P0/P1/P2/P3/X 生命周期状态。\n\n本任务不授权删除；最多生成 exact reclaim proposal。Hugging Face 私有空间不足时必须停止并告诉我，公开数据不是自动兜底方案，任何 public visibility 变化都要先让我决定。`,
  `Run campaign closeout using docs/agents/current/server-artifact-governance-and-reclaim-sop.md. Turn a sealed experiment into recoverable research assets: complete Run/Artifact Passports, build member manifests, publish or reuse GitHub/Hugging Face/GHCR objects by semantic role, and perform fresh read/download/reload/restore verification. Refresh P0/P1/P2/P3/X lifecycle state. This does not authorize deletion; stop at an exact reclaim proposal. If private Hugging Face capacity is insufficient, stop and ask before any visibility change.`
);

const reclaimPrompt = t(
  `请基于已经存在的 exact NOT_AUTHORIZED reclaim manifest 做一次“空间回收审批前检查”。\n\n不要扩大或重写删除清单。先重新检查每一项 ownership、当前进程/容器/配置引用、远端 immutable identity 与 restore 证据，再把 exact manifest 版本、文件数、逻辑字节数和风险用 ELI5 中文发给我。\n\n只有我明确批准这一版 exact manifest 后，才能进入 zju-server 的 deletion safety gate 并精确删除；禁止 shared Docker broad prune。`,
  `Review an existing exact NOT_AUTHORIZED reclaim manifest before deletion. Do not expand or rewrite the list. Re-check ownership, live process/container/config references, immutable remote identity, and restore evidence, then report the exact manifest version, item count, logical bytes, and risks. Only after explicit approval of that exact manifest may the zju-server deletion-safety gate perform precise deletion. Never broad-prune shared Docker.`
);

const gpuFacts = [
  { k: t('GPU', 'GPU'), v: '8 × NVIDIA GeForce RTX 5090' },
  { k: t('显存', 'VRAM'), v: '32,607 MiB / GPU' },
  { k: t('CPU', 'CPU'), v: t('80 物理核 · 160 线程', '80 physical cores · 160 threads') },
  { k: t('内存', 'RAM'), v: t('约 1.0 TiB', 'about 1.0 TiB') },
];
---
<main class="server-overview" data-locale={locale} data-storage-responsibility-view="artifact-lifecycle-v3">
  <header class="server-hero" data-reader-primary>
    <p class="server-hero__context">{t('2026-09-15 22:10（UTC+8）· 静态快照，不是实时监控', '2026-09-15 22:10 (UTC+8) · static snapshot, not live monitoring')}</p>
    <h1>{t('项目持久盘还剩约 0.99 TiB', 'About 0.99 TiB remains on the project persistent disk')}</h1>
    <p class="server-hero__status">{t('按这次静态容量快照，目前没有紧急扩容信号；这不代表未来不会增长。先归档大型实验产物并验证可恢复；需要回收空间时，只生成写清对象、字节数和恢复证据的清单，不自动删除。', 'There is no urgent expansion signal. First archive large experiment outputs and verify they can be restored. If space must be reclaimed, generate an exact list only; nothing is deleted automatically.')}</p>

    <dl class="server-hero__facts research-fact-band" style="--research-fact-columns:3" aria-label={t('当前文件系统快照', 'Current filesystem snapshot')}>
      <div><dt>{t('总容量', 'Capacity')}</dt><dd>2.0 TiB</dd></div>
      <div><dt>{t('已用', 'Used')}</dt><dd>≈ 1.01 TiB · 51%</dd></div>
      <div><dt>{t('可用', 'Available')}</dt><dd>≈ 0.99 TiB</dd></div>
    </dl>

    <p class="server-hero__boundary"><strong>{t('安全边界：', 'Safety boundary: ')}</strong>{t('远端可恢复不等于本地可删；任何删除都要单独批准同一版清单，清单写明对象、字节数和恢复证据。私有归档空间不足也不能自动把数据公开；未合并的草稿规则不能替代正式规则。', 'Remote recoverability does not make a local copy deletable; any deletion needs separate approval of the same exact list. Insufficient private archive capacity also cannot make data public automatically, and an unmerged draft cannot replace the formal authority.')}</p>

    <div class="routine-entry">
      <div class="routine-entry__copy">
        <span>{t('默认操作', 'Default operation')}</span>
        <strong>{t('运行一次例行维护', 'Run one routine maintenance pass')}</strong>
        <p>{t('先只读检查空间和活跃引用；再归档已完成实验并验证恢复；最后只生成回收清单。删除、公开可见性、实验身份或归属不清时才停下来请你决定。', 'First check storage and live references read-only, then archive completed experiments and verify restore; finally generate a reclaim list only. Stop for an owner decision on deletion, visibility, experiment identity, or unresolved ownership.')}</p>
      </div>
      <details class="routine-entry__prompt">
        <summary>{t('复制维护指令', 'Copy maintenance instructions')}</summary>
        <pre data-copy-label={t('复制例行服务器维护 Prompt', 'Copy routine-maintenance prompt')}><code>{routinePrompt}</code></pre>
      </details>
    </div>
  </header>

  <nav class="operation-switchboard" aria-label={t('只做其中一个阶段', 'Run one server-artifact stage only')}>
    <a href="#health-scan"><span>01</span><strong>{t('服务器健康扫描', 'Server health scan')}</strong><small>{t('只读看现在有没有压力', 'Read-only current pressure check')}</small></a>
    <a href="#campaign-closeout"><span>02</span><strong>{t('实验收尾归档', 'Campaign closeout')}</strong><small>{t('给科研产物补身份证并验证远端恢复', 'Passport artifacts and verify remote recovery')}</small></a>
    <a href="#reclaim-proposal"><span>03</span><strong>{t('空间回收提案', 'Reclaim proposal')}</strong><small>{t('先列 exact 清单，不自动删除', 'Exact list first; no automatic deletion')}</small></a>
  </nav>

  <section class="server-section" id="health-scan">
    <div class="section-heading">
      <span>01</span>
      <div><h2>{t('服务器健康扫描', 'Server health scan')}</h2></div>
    </div>
    <p class="section-lede">{t('日常扫描只回答“现在有没有空间或活跃引用风险”。它不做全盘深度 hash，也不因为看到大文件就开始搬家。', 'The routine scan answers whether storage or live references are under pressure now. It does not deep-hash the whole server or start moving files merely because they are large.')}</p>

    <dl class="snapshot-facts" aria-label={t('2026-09-15 服务器快照', '2026-09-15 server snapshot')}>
      <div><dt>{t('持久文件系统', 'Persistent filesystem')}</dt><dd>2.0 TiB</dd><p>{t('项目工作区所在文件系统', 'Filesystem backing the project workspace')}</p></div>
      <div><dt>{t('已用', 'Used')}</dt><dd>≈ 1.01 TiB</dd><p>df · 51%</p></div>
      <div class="snapshot-facts__primary"><dt>{t('可用', 'Available')}</dt><dd>≈ 0.99 TiB</dd><p>1,087,523,598,336 bytes</p></div>
      <div><dt>inode</dt><dd>41%</dd><p>{t('约 1,049 万可用', 'about 10.49M available')}</p></div>
    </dl>

    <div class="operation-explainer">
      <h3>{t('一次健康扫描应该留下什么', 'What a health scan should leave behind')}</h3>
      <ol>
        <li><strong>{t('空间', 'Storage')}</strong><span>{t('df / inode 与几个已知大型根目录的变化。', 'df/inode plus bounded changes in known large roots.')}</span></li>
        <li><strong>{t('活跃引用', 'Live references')}</strong><span>{t('哪些 run、checkpoint、容器挂载或进程仍在用。', 'Which runs, checkpoints, mounts, or processes are still in use.')}</span></li>
        <li><strong>{t('资产变化', 'Artifact changes')}</strong><span>{t('新出现的大型产物、Passport 覆盖缺口和待收尾 backlog。', 'New large outputs, Passport coverage gaps, and closeout backlog.')}</span></li>
      </ol>
    </div>

    <details class="operator-detail">
      <summary>{t('复制“健康扫描”入口 Prompt', 'Copy health-scan entry prompt')}</summary>
      <p>{t('Prompt 只是入口，详细规则仍由仓库里的 Markdown SOP 决定。', 'The prompt is only an entry point; the repository Markdown SOP remains authoritative.')}</p>
      <pre data-copy-label={t('复制健康扫描 Prompt', 'Copy health-scan prompt')}><code>{healthPrompt}</code></pre>
    </details>
  </section>

  <section class="server-section" id="campaign-closeout">
    <div class="section-heading">
      <span>02</span>
      <div><h2>{t('实验收尾归档', 'Campaign closeout')}</h2></div>
    </div>
    <p class="section-lede">{t('实验跑完以后，不应该只留下一个越来越大的目录。收尾的目标是让另一个 Agent 不看聊天，也能知道每个重要产物是什么、从哪里来、哪一份远端副本是正式归档版本（canonical copy）、怎样恢复。', 'A completed experiment should not remain merely as an ever-growing directory. Closeout should let another Agent identify every meaningful artifact, its origin, canonical remote copy, and restore path without relying on chat history.')}</p>

    <figure class="lifecycle-flow" aria-labelledby="lifecycle-caption">
      <ol>
        <li><span>1</span><strong>{t('盘点', 'Inventory')}</strong><small>{t('确认对象和归属', 'identify objects and ownership')}</small></li>
        <li><span>2</span><strong>{t('实验身份证', 'Passport')}</strong><small>{t('记录身份、SHA 和科学角色（Passport）', 'record identity, SHA, and scientific role')}</small></li>
        <li><span>3</span><strong>{t('远端归档', 'Archive')}</strong><small>GitHub / HF / GHCR</small></li>
        <li><span>4</span><strong>{t('恢复验证', 'Readback')}</strong><small>{t('重新读取或恢复，确认远端可用', 'read or restore again to verify the remote copy')}</small></li>
        <li><span>5</span><strong>{t('生命周期状态', 'Lifecycle')}</strong><small>{t('内部状态码只用于审计，日常阅读不需要记', 'internal lifecycle codes are audit-only; readers do not need to memorize them')}</small></li>
      </ol>
      <figcaption id="lifecycle-caption">{t('到这里仍然没有删除权限。收尾流程最多把对象推进到“可以提出回收建议”的状态。', 'There is still no deletion authority at this point. Closeout may only advance an object to the point where reclaim can be proposed.')}</figcaption>
    </figure>

    <details class="passport-authority-note">
      <summary>{t('为什么实验身份证必须跟正式规则走？', 'Why must the experiment identity follow formal authority?')}</summary>
      <p>{t('正式 OpenEvo 实验的身份原件始终来自 openevo-experiment current main 的 canonical Experiment Passport / Registry。FROZEN Passport 不原地改写；current-format Run Manifest 必须与 experiment_id + passport_sha256 精确交叉绑定。member manifest、content-addressed DAG 和 lifecycle projection 都只能是绑定到 Passport 的派生层：cache hit 不能自动授权科学复用，远端可恢复也不能自动授权删除。以后 Passport v2 / DAG / lifecycle 正式合入 main 或被当前 campaign authority 采用后，总入口会先解析新 authority 再执行；未合并 Draft 不会自己升级成全项目标准。', 'The identity original for formal OpenEvo experiments always comes from the canonical Experiment Passport / Registry on openevo-experiment current main. A FROZEN Passport is not edited in place; current-format Run Manifests must exactly cross-link experiment_id + passport_sha256. Member manifests, content-addressed DAGs, and lifecycle projections are derived layers bound to the Passport: a cache hit cannot authorize scientific reuse, and remote recoverability cannot authorize deletion. When a Passport v2/DAG/lifecycle successor is formally merged to main or adopted by current campaign authority, the routine entry resolves that newer authority before acting; an unmerged Draft does not promote itself to project-wide standard.')}</p>
    </details>

    <details class="q17-case q17-case-depth">
      <summary>{t('Q17 存储案例：320.9 GiB 里约 304.66 GiB 是 checkpoint', 'Q17 storage example: about 304.66 GiB of 320.9 GiB is checkpoints')}</summary>
      <article class="q17-case__body">
      <div class="q17-case__header">
        <div>
          <p>{t('真实案例 · Q17 1.7B DirectApply', 'Real case · Q17 1.7B DirectApply')}</p>
          <h3>{t('320.9 GiB 里，绝大多数是 checkpoint', 'Most of the 320.9 GiB run is checkpoints')}</h3>
        </div>
        <strong>304.66 GiB</strong>
      </div>
      <div class="q17-storage-bar" role="img" aria-label={t('Q17 run 约 320.9 GiB，其中 checkpoint 约 304.66 GiB，rollout attempts 约 7.23 GiB，其余是 receipts、evidence、archive 副本和少量 replay。', 'The Q17 run is about 320.9 GiB: about 304.66 GiB checkpoints, 7.23 GiB rollout attempts, with the remainder in receipts, evidence, archive copies, and small replay data.')}>
        <span class="q17-storage-bar__checkpoint" style="width:94.9%"></span>
        <span class="q17-storage-bar__rollout" style="width:2.3%"></span>
        <span class="q17-storage-bar__other" style="width:2.8%"></span>
      </div>
      <div class="q17-legend">
        <span><i class="legend-checkpoint"></i>{t('checkpoint · 304.66 GiB', 'checkpoints · 304.66 GiB')}</span>
        <span><i class="legend-rollout"></i>{t('rollout · 7.23 GiB', 'rollouts · 7.23 GiB')}</span>
        <span><i class="legend-other"></i>{t('其他 · 约 9 GiB', 'other · about 9 GiB')}</span>
      </div>
      <dl class="q17-evidence">
        <div><dt>795</dt><dd>{t('795 条产物成员记录；补登记时没有重新计算 304+ GiB 大权重的 hash。', 'member records; backfill did not re-hash 304+ GiB of large weights.')}</dd></div>
        <div><dt>14 / 24 / 28</dt><dd>{t('第 14 / 24 / 28 轮已逐项验证远端副本能够恢复。', 'three early rounds have member-level exact recovery proof.')}</dd></div>
        <div><dt>131</dt><dd>{t('批产物仍待完成远端归档；源数据约 307.03 GiB。', 'deferred archive backlogs still need remote closeout; source data is about 307.03 GiB.')}</dd></div>
        <div><dt>1.69 GiB</dt><dd>{t('第一批 7 个临时/重复文件已列入精确回收提案，但仍未批准删除。', 'the first 7 temporary/duplicate files are in an exact reclaim proposal, but delete_authorized=false.')}</dd></div>
      </dl>
      <p class="q17-case__note">{t('按早期归档包的真实压缩比估算，131 批待归档产物还需要大约 154–184 GiB 的远端传输。这只是容量规划，不是“可以删”的证据。私有 Hugging Face 仍是默认归档目标；如果私有容量不足，流程必须停下来向负责人报告，不能为了省空间自动把数据公开。', 'Based on observed early-bundle compression, the 131 backlogs imply roughly 154–184 GiB of remote transfer. This is capacity planning, not deletion evidence. Private Hugging Face remains the default archive target; if private capacity is insufficient, the workflow must stop and report to the owner rather than making data public automatically.')}</p>
      </article>
    </details>

    <details class="operator-detail">
      <summary>{t('复制“实验收尾归档”入口 Prompt', 'Copy campaign-closeout entry prompt')}</summary>
      <p>{t('这个入口会推进实验身份证（Passport）、远端归档和恢复验证，但不会自动删除本地文件。', 'This entry point advances Passport, remote archive, and restore verification, but never deletes local files automatically.')}</p>
      <pre data-copy-label={t('复制实验收尾 Prompt', 'Copy campaign-closeout prompt')}><code>{closeoutPrompt}</code></pre>
    </details>
  </section>

  <section class="server-section" id="reclaim-proposal">
    <div class="section-heading">
      <span>03</span>
      <div><h2>{t('空间回收提案', 'Reclaim proposal')}</h2></div>
    </div>
    <p class="section-lede">{t('空间回收和“已经备份”是两件事。只有精确回收清单里的对象，经过归属、当前是否仍被使用和恢复证据复查后，才有资格进入人工批准。', 'Space reclaim and “already backed up” are separate facts. Only objects in an exact manifest, after ownership, live-reference, and recovery checks, may reach human approval.')}</p>

    <div class="reclaim-boundary">
      <div><span>{t('当前规则', 'Current rule')}</span><strong>{t('尚未批准删除', 'Deletion not authorized')}</strong><small>NOT_AUTHORIZED</small></div>
      <p>{t('回收提案可以精确列出“删什么、多少字节、为什么可恢复”，但它本身没有删除权限。负责人批准的必须是同一版精确清单；批准后还要在删除前重新检查对象是否仍被使用。', 'A proposal can list exactly what would be removed, how many bytes, and why it is recoverable, but the proposal itself has no deletion authority. The owner must approve that exact manifest version, followed by a fresh liveness check immediately before deletion.')}</p>
    </div>

    <ol class="reclaim-steps">
      <li><strong>{t('精确清单', 'Exact list')}</strong><span>{t('路径/对象、identity、逻辑字节数、remote restore 证据。', 'object identity, logical bytes, and remote restore evidence.')}</span></li>
      <li><strong>{t('人工批准', 'Owner approval')}</strong><span>{t('只批准这一版 manifest，不把批准扩展成 broad cleanup。', 'Approval applies to that manifest only, never to broad cleanup.')}</span></li>
