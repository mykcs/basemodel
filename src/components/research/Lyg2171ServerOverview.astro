---
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const userStorage = [
  { label: t('我', 'Me'), home: '60.4 GiB', docker: '6.88 GiB', total: '67.3 GiB', share: '15.4%', owner: true },
  { label: t('用户一', 'User 1'), home: '97.1 GiB', docker: '10.9 GiB', total: '108.0 GiB', share: '24.8%', owner: false },
  { label: t('用户二', 'User 2'), home: '17.1 GiB', docker: '6.75 GiB', total: '23.9 GiB', share: '5.5%', owner: false },
  { label: t('用户三', 'User 3'), home: '13.6 GiB', docker: '1.69 GiB', total: '15.3 GiB', share: '3.5%', owner: false },
  { label: t('用户四', 'User 4'), home: '4.42 GiB', docker: '3.39 GiB', total: '7.81 GiB', share: '1.8%', owner: false },
  { label: t('用户五', 'User 5'), home: '2.85 GiB', docker: '0.29 GiB', total: '3.14 GiB', share: '0.7%', owner: false },
  { label: t('用户六', 'User 6'), home: '<0.01 GiB', docker: '<0.01 GiB', total: '<0.01 GiB', share: '<0.1%', owner: false },
];

const refreshPrompt = t(
  `请刷新 BaseModel 服务器页面的空间使用快照。

目标页面：https://basemodel-preview.vercel.app/research/seed-openevo/flow/server/
仓库：mykcs/basemodel

请先读取仓库中的 docs/agents/current/server-storage-pressure-audit-sop.md，并按其中流程执行。

要求：
1. 先对共享实验服务器做只读空间审计，不要因为这条 Prompt 自动删除、清理、移动或重下载任何模型、checkpoint、run、缓存、容器或镜像。
2. 读取主文件系统的 total / used / available / Use%，再统计每个可识别账户的主目录占用。
3. 对 Docker 只统计能够通过 home mount 可靠归属到账户的 writable layer；共享镜像、build cache、volume、无法可靠归属的容器层和系统文件必须单独保留，不能按名字或标签强行分摊给某个人。
4. 在授权的私有执行上下文中确认站点 owner 对应的账户后，只在公开页面把它写成“我”；不要公开 owner 的系统用户名。其余账户排除 owner 后，再按“主目录 + 可归属 Docker writable layer”的合计从大到小写成“用户一、用户二……”。不要公开或持久化其他用户的真实用户名、home 路径、容器名/ID、SSH 信息、IP、GPU UUID，也不要保存真实账户与匿名编号的映射。
5. 同时刷新页面上仍然需要的 CPU、RAM、GPU 库存事实；库存事实、实验分配和 GPU 使用授权必须分开。
6. 页面必须显示明确的 UTC+8 快照时间，并说明这是静态快照，不是实时监控。
7. 用本次实测数据更新中文和英文 server 页面及相关测试；不要从旧页面抄“当前”数字。
8. 修改后运行仓库要求的 deterministic Gate、build、overflow 和 UI/browser 验收；开 PR，确认 exact-head Preview 后合并到 main，并检查 Production 页面。

最后请汇报：本次快照时间、磁盘总量/已用/可用、匿名用户可归属总量、未归属 Docker 写入层、共享/系统占用、PR、merge commit 和 Production 验收结果。`,
  `Refresh the BaseModel server storage snapshot.

Target page: https://basemodel-preview.vercel.app/research/seed-openevo/flow/server/
Repository: mykcs/basemodel

Read docs/agents/current/server-storage-pressure-audit-sop.md first and follow that procedure.

Requirements:
1. Start with a read-only audit of the shared experiment server. This prompt does not authorize deleting, cleaning, moving, or redownloading models, checkpoints, runs, caches, containers, or images.
2. Measure total / used / available / Use% for the main filesystem, then measure each identifiable account home directory.
3. For Docker, attribute only writable layers that can be reliably tied to an account through its home mount. Keep shared images, build cache, volumes, unattributed container layers, and system files separate; never assign them to a person from names or labels.
4. After resolving the site owner's account in the authorized private execution context, publish only the relative label “Me” for that account; never publish the owner's system username. Exclude the owner, then sort all remaining accounts by attributable total (home + attributable Docker writable layer) and label them User 1, User 2, and so on. Do not publish or persist other users' usernames, home paths, container names/IDs, SSH details, IPs, GPU UUIDs, or the real-account-to-anonymous-label mapping.
5. Refresh any CPU, RAM, and GPU inventory facts that the page still needs. Keep server inventory, experiment allocation, and GPU authorization distinct.
6. Show an explicit UTC+8 snapshot time and state that this is a static snapshot, not live monitoring.
7. Update both Chinese and English server pages and related tests from the new measurements; do not copy “current” values from the old page.
8. Run the repository-required deterministic Gate, build, overflow, and UI/browser acceptance; open a PR, verify the exact-head Preview, merge to main, and verify Production.

Finally report the snapshot time, filesystem total/used/free, anonymous attributable totals, unattributed Docker writable layers, shared/system usage, PR, merge commit, and Production acceptance result.`
);

const gpuFacts = [
  { k: t('GPU 数量', 'GPU count'), v: '8 × RTX 5090' },
  { k: t('代际 / 架构', 'Generation / architecture'), v: 'GeForce RTX 50 · Blackwell' },
  { k: t('CUDA 核', 'CUDA cores'), v: '21,760 / GPU · 174,080 total' },
  { k: t('显存', 'VRAM'), v: '32,607 MiB / GPU · ≈ 254.7 GiB total' },
  { k: 'Compute Capability', v: '12.0' },
  { k: t('驱动快照', 'Driver snapshot'), v: '610.57.04' },
];
---
<main class="server-overview" data-locale={locale}>
  <header class="server-hero">
    <div class="server-hero__eyebrow">{t('OpenEvo / WebShop · 实验服务器', 'OpenEvo / WebShop · experiment server')}</div>
    <h1>{t('实验服务器简介', 'Experiment server overview')}</h1>
    <p>{t('2026-09-03 的服务器库存快照显示，这台机器有 2 × Intel Xeon Platinum 8380、约 1.0 TiB 内存，并可见 8 × RTX 5090。同期存储快照中，主文件系统约有 29.1 GiB 可用；磁盘空间仍是当前最紧张的资源。', 'The 2026-09-03 server inventory snapshot shows 2 × Intel Xeon Platinum 8380 CPUs, about 1.0 TiB RAM, and 8 visible RTX 5090 GPUs. The storage snapshot from the same check shows about 29.1 GiB free on the main filesystem, so disk capacity remains the tightest resource.')}</p>
    <div class="snapshot-note">
      <strong>{t('数据时间', 'Data timestamp')}</strong>
      <span>2026-09-03 02:09 (UTC+8)</span>
      <span>{t('静态快照，不是实时监控面板', 'Static snapshot, not a live monitoring dashboard')}</span>
    </div>
  </header>

  <section class="priority-grid" aria-label={t('关键资源', 'Key resources')}>
    <article class="priority-card priority-card--attention">
      <span>{t('磁盘剩余', 'Disk free')}</span>
      <strong>29.1 GiB</strong>
      <h2>{t('主文件系统可用空间', 'Main filesystem available')}</h2>
      <p>{t('本次存储快照中，df 报告 93% 已使用。大 checkpoint、共享 Docker/容器层或重复实验副本仍可能很快把它推满。', 'In this storage snapshot, df reports 93% used. Large checkpoints, shared Docker/container layers, or duplicate experiment copies can still fill it quickly.')}</p>
    </article>
    <article class="priority-card">
      <span>GPU</span>
      <strong>8 × 5090</strong>
      <h2>GeForce RTX 50 · Blackwell</h2>
      <p>{t('每张约 31.8 GiB 显存。8 张卡的显存不能自动当成一张 254.7 GiB 的大卡，是否能合并使用取决于并行策略。', 'Each GPU has about 31.8 GiB VRAM. Eight GPUs do not automatically behave like one 254.7 GiB GPU; usable aggregate memory depends on the parallelism strategy.')}</p>
    </article>
    <article class="priority-card">
      <span>CPU</span>
      <strong>80 / 160</strong>
      <h2>{t('80 个物理核 · 160 个逻辑线程', '80 physical cores · 160 logical threads')}</h2>
      <p>2 × Intel Xeon Platinum 8380 @ 2.30 GHz · 40 {t('核/路', 'cores/socket')} · 2 {t('线程/核', 'threads/core')}</p>
    </article>
    <article class="priority-card">
      <span>RAM</span>
      <strong>1.0 TiB</strong>
      <h2>{t('内存容量', 'System memory')}</h2>
      <p>{t('快照时约 64.1 GiB 正在使用，Linux 报告约 928.1 GiB available；RAM 远比磁盘宽裕。', 'At the snapshot, about 64.1 GiB was in use and Linux reported about 928.1 GiB available; RAM is far less constrained than disk.')}</p>
    </article>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>01</span>
      <div>
        <small>{t('存储', 'Storage')}</small>
        <h2>{t('磁盘使用情况', 'Filesystem usage')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('主文件系统总容量约 436.0 GiB。本次快照已用 384.7 GiB，df 报 93% 使用率，普通写入约剩 29.1 GiB。能按账户可靠归属的部分单独计算；共享 Docker 镜像和系统占用不强行分摊给任何个人。', 'The main filesystem has about 436.0 GiB of total capacity. This snapshot shows 384.7 GiB used, df at 93%, and about 29.1 GiB available for ordinary writes. Usage that can be reliably tied to an account is counted separately; shared Docker images and system usage are not forced onto an individual.')}</p>

    <div class="storage-status">
      <div class="storage-status__numbers">
        <div><span>{t('文件系统', 'Filesystem')}</span><strong>436.0 GiB</strong></div>
        <div><span>{t('已用', 'Used')}</span><strong>384.7 GiB</strong></div>
        <div><span>{t('可用', 'Available')}</span><strong>29.1 GiB</strong></div>
        <div><span>df Use%</span><strong>93%</strong></div>
      </div>
      <div class="storage-bar" role="img" aria-label={t('436.0 GiB 主文件系统责任归属：我 67.3 GiB；用户一 108.0 GiB；用户二 23.9 GiB；用户三 15.3 GiB；用户四 7.81 GiB；用户五 3.14 GiB；用户六不足 0.01 GiB；未归属 Docker 写入层 12.15 GiB；共享与系统占用 147.1 GiB；可用 29.1 GiB；文件系统保留与舍入 22.2 GiB。', '436.0 GiB main filesystem responsibility view: Me 67.3 GiB; User 1 108.0 GiB; User 2 23.9 GiB; User 3 15.3 GiB; User 4 7.81 GiB; User 5 3.14 GiB; User 6 under 0.01 GiB; unattributed Docker writable layers 12.15 GiB; shared/system usage 147.1 GiB; available 29.1 GiB; filesystem reserve/rounding 22.2 GiB.') }>
        <span class="storage-bar__mine" style="width:15.4%" title={t('我 · 67.3 GiB', 'Me · 67.3 GiB')}></span>
        <span class="storage-bar__user storage-bar__user--1" style="width:24.8%" title={t('用户一 · 108.0 GiB', 'User 1 · 108.0 GiB')}></span>
        <span class="storage-bar__user storage-bar__user--2" style="width:5.5%" title={t('用户二 · 23.9 GiB', 'User 2 · 23.9 GiB')}></span>
        <span class="storage-bar__user storage-bar__user--3" style="width:3.5%" title={t('用户三 · 15.3 GiB', 'User 3 · 15.3 GiB')}></span>
        <span class="storage-bar__user storage-bar__user--4" style="width:1.8%" title={t('用户四 · 7.81 GiB', 'User 4 · 7.81 GiB')}></span>
        <span class="storage-bar__user storage-bar__user--5" style="width:.7%" title={t('用户五 · 3.14 GiB', 'User 5 · 3.14 GiB')}></span>
        <span class="storage-bar__docker" style="width:2.8%" title={t('未归属 Docker · 12.15 GiB', 'Unattributed Docker · 12.15 GiB')}></span>
        <span class="storage-bar__shared" style="width:33.7%" title={t('共享 / 系统 · 147.1 GiB', 'Shared / system · 147.1 GiB')}></span>
        <span class="storage-bar__free" style="width:6.7%" title={t('可用 · 29.1 GiB', 'Available · 29.1 GiB')}></span>
        <span class="storage-bar__reserved" style="width:5.1%" title={t('文件系统保留 / 舍入 · 22.2 GiB', 'Filesystem reserve / rounding · 22.2 GiB')}></span>
      </div>
      <div class="storage-legend storage-legend--responsibility">
        <div class="storage-legend__mine"><i class="legend-swatch legend-swatch--mine"></i><span>{t('我', 'Me')}</span><strong>67.3 GiB · 15.4%</strong></div>
        <div><i class="legend-swatch legend-swatch--user-1"></i><span>{t('用户一', 'User 1')}</span><strong>108.0 GiB · 24.8%</strong></div>
        <div><i class="legend-swatch legend-swatch--user-2"></i><span>{t('用户二', 'User 2')}</span><strong>23.9 GiB · 5.5%</strong></div>
        <div><i class="legend-swatch legend-swatch--user-3"></i><span>{t('用户三', 'User 3')}</span><strong>15.3 GiB · 3.5%</strong></div>
        <div><i class="legend-swatch legend-swatch--user-4"></i><span>{t('用户四', 'User 4')}</span><strong>7.81 GiB · 1.8%</strong></div>
        <div><i class="legend-swatch legend-swatch--user-5"></i><span>{t('用户五', 'User 5')}</span><strong>3.14 GiB · 0.7%</strong></div>
        <div><i class="legend-swatch legend-swatch--user-6"></i><span>{t('用户六', 'User 6')}</span><strong>&lt;0.01 GiB · &lt;0.1%</strong></div>
        <div><i class="legend-swatch legend-swatch--docker"></i><span>{t('未归属 Docker', 'Unattributed Docker')}</span><strong>12.15 GiB · 2.8%</strong></div>
        <div><i class="legend-swatch legend-swatch--shared"></i><span>{t('共享 / 系统', 'Shared / system')}</span><strong>147.1 GiB · 33.7%</strong></div>
        <div><i class="legend-swatch legend-swatch--free"></i><span>{t('可用空间', 'Available')}</span><strong>29.1 GiB · 6.7%</strong></div>
        <div><i class="legend-swatch legend-swatch--reserved"></i><span>{t('文件系统保留 / 舍入', 'Filesystem reserve / rounding')}</span><strong>22.2 GiB · 5.1%</strong></div>
      </div>
      <p class="fine-print">{t('进度条按“空间责任”展开，而不是把所有用户揉成一个大块。“我”只表示站点 owner 的相对标签，不公开系统用户名；其他账户仍然匿名。所有百分比均以 436.0 GiB 总容量为分母。', 'The bar is expanded by storage responsibility instead of collapsing every account into one block. “Me” is only a relative label for the site owner and does not expose the system username; all other accounts remain anonymous. All percentages use 436.0 GiB total capacity as the denominator.')}</p>
      <div class="attribution-rules">
        <strong>{t('我们怎么判断“这是谁的”', 'How we decide who is responsible for storage')}</strong>
        <div class="attribution-rules__grid">
          <div><span>01</span><h3>{t('主目录归账户', 'Home directory belongs to the account')}</h3><p>{t('文件落在某个账户控制的 home 目录里，就计入该账户。这里说的是空间责任：这个账户负责决定哪些内容继续保留、归档或清理。', 'Bytes under an account-controlled home directory are charged to that account. This is an operational responsibility rule: that account is responsible for deciding what is retained, archived, or cleaned up.')}</p></div>
          <div><span>02</span><h3>{t('容器必须能唯一指向账户', 'A container must map uniquely to one account')}</h3><p>{t('Docker writable layer 只有在容器的 home bind mount 能唯一对应某个账户时才计给它；只看镜像名、容器标签或任务路径不够。', 'A Docker writable layer is charged to an account only when the container home bind mount uniquely identifies that account; image names, container labels, and task paths are not enough.')}</p></div>
          <div><span>03</span><h3>{t('不是“谁亲手写了每个文件”', 'This is not literal byte authorship')}</h3><p>{t('Agent、训练脚本或容器自动生成的内容，只要写进该账户控制的空间，仍由该账户承担空间责任。我们不会声称某个人亲手创建了其中每一个文件。', 'Files produced automatically by Agents, training scripts, or containers still fall under the controlling account when written into its space. We are not claiming that a person literally created every file by hand.')}</p></div>
          <div><span>04</span><h3>{t('共享内容不硬塞给个人', 'Shared storage stays shared')}</h3><p>{t('共享镜像、build cache、共享 volume、系统文件，以及无法唯一归属的 writable layer 都单独列出；不能为了让账看起来完整就随便算到某个人头上。', 'Shared images, build cache, shared volumes, system files, and writable layers without a unique owner stay separate. They are not assigned to a person just to make the accounting look complete.')}</p></div>
        </div>
      </div>
      <div class="why-df">
        <strong>{t('为什么 df 显示 93%', 'Why df reports 93%')}</strong>
        <p>{t('df 的 93% 不是简单的 384.7 ÷ 436.0，因为文件系统会保留一部分空间；普通写入当前约有 29.1 GiB。', 'The 93% shown by df is not simply 384.7 ÷ 436.0 because the filesystem reserves part of its capacity; about 29.1 GiB is currently available for ordinary writes.')}</p>
      </div>
      <div class="why-df">
        <strong>{t('共享 Docker 不能按名字分摊', 'Shared Docker is not assigned by name')}</strong>
        <p>{t('镜像层、build cache 和部分容器层属于共享 daemon。镜像名、容器标签或某次任务路径看起来像某个账户，不代表整份共享镜像都属于该账户。', 'Image layers, build cache, and some container layers belong to the shared daemon. An image name, container label, or task path that looks associated with one account does not make the entire shared image that account’s usage.')}</p>
      </div>
    </div>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>02</span>
      <div>
        <small>{t('账户占用', 'Account usage')}</small>
        <h2>{t('各用户磁盘占用', 'Disk usage by account')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('先单独列出“我”，再把其他账户按可归属合计从大到小匿名排序。可归属合计 = 主目录 + 能通过 home bind mount 唯一指向该账户的 Docker 写入层；这里表达的是谁需要为这部分空间负责，不是逐文件鉴定作者。', 'The site owner is shown first as “Me”; all other accounts are then anonymized and ranked by attributable total. Attributable total = home directory + Docker writable layers whose home bind mount uniquely identifies that account. This expresses operational storage responsibility, not per-file authorship.')}</p>
    <div class="storage-table-wrap" role="region" aria-label={t('账户空间责任表', 'Account storage-responsibility table')} tabindex="0">
      <table class="storage-table">
        <thead>
          <tr>
            <th scope="col">{t('账户', 'Account')}</th>
            <th scope="col">{t('主目录', 'Home directory')}</th>
            <th scope="col">{t('Docker 写入层', 'Docker writable layers')}</th>
            <th scope="col">{t('可归属合计', 'Attributable total')}</th>
            <th scope="col">{t('全盘占比', 'Share of filesystem')}</th>
          </tr>
        </thead>
        <tbody>
          {userStorage.map((item) => (
            <tr class={item.owner ? 'storage-table__owner' : undefined}>
              <th scope="row">{item.label}</th>
              <td>{item.home}</td>
              <td>{item.docker}</td>
              <td><strong>{item.total}</strong></td>
              <td>{item.share}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine-print">{t('“我”只表示站点 owner 的相对标签，网页仍不公开 owner 的系统用户名。其余用户一到六是 2026-09-03 02:09（UTC+8）快照中排除 owner 后，按“可归属合计”从大到小重新生成的临时匿名标签；编号不会跨快照保持，也不保存真实账户与匿名编号之间的对应关系。', '“Me” is only a relative label for the site owner; the page still does not publish the owner’s system username. Users 1–6 are temporary anonymous labels regenerated after excluding the owner and sorting the remaining accounts by attributable total in the 2026-09-03 02:09 (UTC+8) snapshot. The numbering does not persist across snapshots, and the mapping is not stored.')}</p>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>03</span>
      <div>
        <small>GPU</small>
        <h2>{t('GPU 规格', 'GPU specifications')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('RTX 5090 属于 GeForce RTX 50 系列，采用 Blackwell 架构。单卡 21,760 个 CUDA 核，显存 32,607 MiB，Compute Capability 为 12.0。', 'RTX 5090 belongs to the GeForce RTX 50 series and uses the Blackwell architecture. Each GPU has 21,760 CUDA cores, 32,607 MiB VRAM, and Compute Capability 12.0.')}</p>
    <dl class="gpu-facts">
      {gpuFacts.map((item) => <div><dt>{item.k}</dt><dd>{item.v}</dd></div>)}
    </dl>
    <div class="gpu-note">
      <strong>{t('多卡性能说明', 'Multi-GPU performance note')}</strong>
      <p>{t('8 张卡 × 21,760 CUDA 核可以得到整机 174,080 CUDA 核这个“规格总和”，但训练速度不会简单变成单卡的 8 倍。数据并行、模型并行、通信和显存分配都会决定实际收益。', 'Eight cards × 21,760 CUDA cores gives a hardware-spec total of 174,080 CUDA cores, but training does not automatically become eight times faster. Data/model parallelism, communication, and memory placement determine the real gain.')}</p>
    </div>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>04</span>
      <div>
        <small>{t('快捷操作', 'Quick action')}</small>
        <h2>{t('刷新服务器空间快照', 'Refresh the server storage snapshot')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('这个 Prompt 用来把当前页面的刷新流程带到新的 ChatGPT 对话里。复制后直接发送即可；它默认只做只读审计和网页更新，不授权清理服务器文件。', 'This prompt carries the page-refresh workflow into a new ChatGPT conversation. Copy and send it directly; by default it authorizes only a read-only audit and webpage update, not server cleanup.')}</p>
    <div class="refresh-prompt">
      <pre data-copy-label={t('复制刷新 Prompt', 'Copy refresh prompt')}><code>{refreshPrompt}</code></pre>
    </div>
  </section>

  <section class="server-section server-section--privacy">
    <div class="section-heading">
      <span>05</span>
      <div>
        <small>{t('隐私边界', 'Privacy boundary')}</small>
        <h2>{t('资源归属与隐私', 'Usage attribution and privacy')}</h2>
