---
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const ownStorage = [
  { label: t('主要实验工作区', 'Primary experiment workspace'), value: '79.0 GiB', detail: t('训练产出、checkpoint、运行目录等主要都在这里。', 'Most training outputs, checkpoints, and run directories live here.'), pct: 91.4 },
  { label: 'openevo-workspace', value: '6.84 GiB', detail: t('OpenEvo 相关独立工作区。', 'Dedicated OpenEvo workspace.'), pct: 7.9 },
  { label: t('其余我们的文件', 'Other files we own'), value: '0.62 GiB', detail: t('缓存、工具、配置等小项合计。', 'Caches, tools, configuration, and other small items combined.'), pct: 0.7 },
];

const anonymousUserStorage = [
  { label: t('用户 1', 'User 1'), value: '88.2 GiB', pct: 20.2, cls: 'storage-bar__user-1' },
  { label: t('用户 2', 'User 2'), value: '14.2 GiB', pct: 3.2, cls: 'storage-bar__user-2' },
  { label: t('用户 3', 'User 3'), value: '13.6 GiB', pct: 3.1, cls: 'storage-bar__user-3' },
  { label: t('用户 4', 'User 4'), value: '4.14 GiB', pct: 1.0, cls: 'storage-bar__user-4' },
  { label: t('用户 5', 'User 5'), value: '1.88 GiB', pct: 0.4, cls: 'storage-bar__user-5' },
];

const gpuFacts = [
  { k: t('GPU 数量', 'GPU count'), v: '8 × RTX 5090' },
  { k: t('代际 / 架构', 'Generation / architecture'), v: 'GeForce RTX 50 · Blackwell' },
  { k: t('CUDA 核', 'CUDA cores'), v: '21,760 / GPU · 174,080 total' },
  { k: t('显存', 'VRAM'), v: '32,607 MiB / GPU · ≈ 254.7 GiB total' },
  { k: 'Compute Capability', v: '12.0' },
  { k: t('驱动快照', 'Driver snapshot'), v: '610.57.04' },
];
---
<main class="server-overview" data-locale={locale}>
  <header class="server-hero">
    <div class="server-hero__eyebrow">{t('实验服务器 · lyg2171', 'Experiment server · lyg2171')}</div>
    <h1>{t('lyg2171 服务器简介', 'lyg2171 server overview')}</h1>
    <p>{t('lyg2171 是当前 OpenEvo / WebShop 实验使用的主要训练服务器。配置为 2 × Intel Xeon Platinum 8380、1.0 TiB 内存和 8 × RTX 5090；当前主文件系统仅剩约 25.7 GiB。', 'lyg2171 is the main training server used for the current OpenEvo / WebShop experiments. It has 2 × Intel Xeon Platinum 8380 CPUs, 1.0 TiB RAM, and 8 × RTX 5090 GPUs; the main filesystem currently has only about 25.7 GiB free.')}</p>
    <div class="snapshot-note">
      <strong>{t('数据时间', 'Data timestamp')}</strong>
      <span>2026-08-31 11:03 (UTC+8)</span>
      <span>{t('静态快照，不是实时监控面板', 'Static snapshot, not a live monitoring dashboard')}</span>
    </div>
  </header>

  <section class="priority-grid" aria-label={t('关键资源', 'Key resources')}>
    <article class="priority-card priority-card--attention">
      <span>{t('磁盘剩余', 'Disk free')}</span>
      <strong>25.7 GiB</strong>
      <h2>{t('主文件系统可用空间', 'Main filesystem available')}</h2>
      <p>{t('df 当前报告 94% 已使用。大 checkpoint、Docker/容器层或重复实验副本都可能很快把它推满。', 'df currently reports 94% used. Large checkpoints, container layers, or duplicate experiment copies can fill it quickly.')}</p>
    </article>
    <article class="priority-card">
      <span>GPU</span>
      <strong>8 × 5090</strong>
      <h2>GeForce RTX 50 · Blackwell</h2>
      <p>{t('每张约 31.8 GiB 显存。8 张卡的显存不能自动当成一张 254.7 GiB 的大卡，是否能合并使用取决于并行策略。', 'Each GPU has about 31.8 GiB VRAM. Eight GPUs do not automatically behave like one 254.7 GiB GPU; usable aggregate memory depends on the parallelism strategy.')}</p>
    </article>
    <article class="priority-card">
      <span>CPU</span>
      <strong>80 / 160</strong>
      <h2>{t('80 个物理核 · 160 个逻辑线程', '80 physical cores · 160 logical threads')}</h2>
      <p>2 × Intel Xeon Platinum 8380 @ 2.30 GHz · 40 {t('核/路', 'cores/socket')} · 2 {t('线程/核', 'threads/core')}</p>
    </article>
    <article class="priority-card">
      <span>RAM</span>
      <strong>1.0 TiB</strong>
      <h2>{t('内存容量', 'System memory')}</h2>
      <p>{t('快照时约 61 GiB 正在使用，Linux 报告约 940 GiB available；这里比磁盘宽裕得多。', 'At the snapshot, about 61 GiB was in use and Linux reported about 940 GiB available; RAM is far less constrained than disk.')}</p>
    </article>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>01</span>
      <div>
        <small>{t('存储', 'Storage')}</small>
        <h2>{t('磁盘使用情况', 'Filesystem usage')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('实验文件主要写入约 436.0 GiB 的主文件系统（df -h 显示为 437 G）。下面把可以可靠归属的主目录按匿名用户拆开；共享镜像、容器写层和系统开销保留为单独一项，不强行算到任何个人头上。', 'Experiment files are mainly written to an approximately 436.0 GiB main filesystem (shown as 437 G by df -h). Reliably attributable home directories are split by anonymous user below; shared images, container writable layers, and system overhead remain separate instead of being forced onto an individual.')}</p>

    <div class="storage-status">
      <div class="storage-status__numbers">
        <div><span>{t('文件系统', 'Filesystem')}</span><strong>436.0 GiB</strong></div>
        <div><span>{t('已用', 'Used')}</span><strong>388.1 GiB</strong></div>
        <div><span>{t('可用', 'Available')}</span><strong>25.7 GiB</strong></div>
        <div><span>df Use%</span><strong>94%</strong></div>
      </div>
      <div class="storage-bar" role="img" aria-label={t('436.0 GiB 主文件系统：我们的主目录 86.5 GiB；匿名用户 1 到 5 分别为 88.2、14.2、13.6、4.14、1.88 GiB；未按用户归属的占用 179.7 GiB；可用 25.7 GiB；文件系统保留与舍入 22.2 GiB。', '436.0 GiB main filesystem: our home directory is 86.5 GiB; anonymous Users 1 through 5 use 88.2, 14.2, 13.6, 4.14, and 1.88 GiB; 179.7 GiB is not attributed to an individual user; 25.7 GiB is available; 22.2 GiB is filesystem reserve/rounding.') }>
        <span class="storage-bar__ours" style="width:19.8%"></span>
        {anonymousUserStorage.map((item) => <span class={item.cls} style={`width:${item.pct}%`}></span>)}
        <span class="storage-bar__unattributed" style="width:41.2%"></span>
        <span class="storage-bar__free" style="width:5.9%"></span>
        <span class="storage-bar__reserved" style="width:5.1%"></span>
      </div>
      <div class="storage-legend">
        <div><i class="legend-swatch legend-swatch--ours"></i><span>{t('我们的主目录', 'Our home directory')}</span><strong>86.5 GiB · 19.8%</strong></div>
        {anonymousUserStorage.map((item) => (
          <div><i class={`legend-swatch ${item.cls.replace('storage-bar', 'legend-swatch')}`}></i><span>{item.label}</span><strong>{item.value} · {item.pct.toFixed(1)}%</strong></div>
        ))}
        <div><i class="legend-swatch legend-swatch--unattributed"></i><span>{t('未按用户归属', 'Not user-attributed')}</span><strong>179.7 GiB · 41.2%</strong></div>
        <div><i class="legend-swatch legend-swatch--free"></i><span>{t('可用空间', 'Available')}</span><strong>25.7 GiB · 5.9%</strong></div>
        <div><i class="legend-swatch legend-swatch--reserved"></i><span>{t('文件系统保留 / 舍入', 'Filesystem reserve / rounding')}</span><strong>22.2 GiB · 5.1%</strong></div>
      </div>
      <p class="fine-print">{t('用户 1–5 是按本次快照主目录占用从大到小排序的匿名标签，不是公开身份，也不是永久编号。百分比均以 436.0 GiB 文件系统总容量为分母。“未按用户归属”由 df 已用空间减去六个可识别主目录得到，可能包含共享 Docker 镜像、容器写层、构建缓存和系统文件。', 'Users 1–5 are anonymous labels sorted by home-directory usage in this snapshot; they are neither public identities nor permanent IDs. Percentages use the 436.0 GiB filesystem capacity as the denominator. “Not user-attributed” is the df-used remainder after subtracting the six identifiable home directories and may include shared Docker images, container writable layers, build cache, and system files.')}</p>
      <div class="why-df">
        <strong>{t('为什么 df 显示 94%', 'Why df reports 94%')}</strong>
        <p>{t('df 的 94% 不是简单的 388.1 ÷ 436.0，因为文件系统会保留一部分空间；普通写入当前只剩约 25.7 GiB。', 'The 94% shown by df is not simply 388.1 ÷ 436.0 because the filesystem reserves part of its capacity; only about 25.7 GiB is currently available for ordinary writes.')}</p>
      </div>
    </div>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>02</span>
      <div>
        <small>{t('我们的空间', 'Our storage')}</small>
        <h2>{t('我们的磁盘占用', 'Our disk usage')}</h2>
      </div>
    </div>
    <div class="own-storage-list">
      {ownStorage.map((item) => (
        <article>
          <div class="own-storage-list__row"><div><strong>{item.label}</strong><p>{item.detail}</p></div><b>{item.value}</b></div>
          <div class="mini-bar" aria-hidden="true"><span style={`width:${item.pct}%`}></span></div>
        </article>
      ))}
    </div>
    <p class="section-callout">{t('我们的主目录当前约 86.5 GiB，其中主要实验工作区约 79.0 GiB。需要释放空间时先检查我们自己的实验产物；不处理其他用户的容器或目录。', 'Our home directory currently uses about 86.5 GiB, including about 79.0 GiB in the primary experiment workspace. When reclaiming space, start with our own experiment artifacts; do not modify other users’ containers or directories.')}</p>
  </section>

  <section class="server-section">
    <div class="section-heading">
      <span>03</span>
      <div>
        <small>GPU</small>
        <h2>{t('GPU 规格', 'GPU specifications')}</h2>
      </div>
    </div>
    <p class="section-lede">{t('RTX 5090 属于 GeForce RTX 50 系列，采用 Blackwell 架构。单卡 21,760 个 CUDA 核，显存 32,607 MiB，Compute Capability 为 12.0。', 'RTX 5090 belongs to the GeForce RTX 50 series and uses the Blackwell architecture. Each GPU has 21,760 CUDA cores, 32,607 MiB VRAM, and Compute Capability 12.0.')}</p>
    <dl class="gpu-facts">
      {gpuFacts.map((item) => <div><dt>{item.k}</dt><dd>{item.v}</dd></div>)}
    </dl>
    <div class="gpu-note">
      <strong>{t('多卡性能说明', 'Multi-GPU performance note')}</strong>
      <p>{t('8 张卡 × 21,760 CUDA 核可以得到整机 174,080 CUDA 核这个“规格总和”，但训练速度不会简单变成单卡的 8 倍。数据并行、模型并行、通信和显存分配都会决定实际收益。', 'Eight cards × 21,760 CUDA cores gives a hardware-spec total of 174,080 CUDA cores, but training does not automatically become eight times faster. Data/model parallelism, communication, and memory placement determine the real gain.')}</p>
    </div>
  </section>

  <section class="server-section server-section--privacy">
    <div class="section-heading">
      <span>04</span>
      <div>
        <small>{t('隐私边界', 'Privacy boundary')}</small>
        <h2>{t('资源归属与隐私', 'Usage attribution and privacy')}</h2>
      </div>
    </div>
    <div class="privacy-grid">
      <div>
        <strong>{t('公开展示', 'Shown publicly')}</strong>
        <p>{t('总容量、总占用、可用空间、GPU 型号与数量，以及按主目录占用排序的匿名“用户 1–5”。匿名编号只对应这次快照的排序。', 'Total capacity, total usage, free space, GPU model/count, plus anonymous “Users 1–5” ranked by home-directory usage. The anonymous numbers apply only to this snapshot ranking.')}</p>
      </div>
      <div>
        <strong>{t('不公开', 'Not shown')}</strong>
        <p>{t('其他人的用户名、容器名、容器 ID、GPU 进程命令、GPU UUID、IP、SSH 别名或任何可反查身份的信息。', 'Other users’ names, container names/IDs, GPU process commands, GPU UUIDs, IPs, SSH aliases, or other identity-revealing details.')}</p>
      </div>
    </div>
  </section>

  <details class="measurement-notes">
    <summary>{t('数据来源', 'Data sources')}</summary>
    <p>{t('CPU 来自 lscpu；内存来自 free -h；主文件系统来自 df -B1 /；六个可识别用户主目录来自只读 du；GPU 型号、显存、驱动与 Compute Capability 来自 nvidia-smi。“未按用户归属”是 df 已用减去这些主目录后的差额。页面只保存匿名后的容量数字，不保存其他人的用户名、SSH 地址、GPU UUID 或容器身份信息。', 'CPU data comes from lscpu; memory from free -h; the main filesystem from df -B1 /; the six identifiable user home directories come from read-only du measurements; GPU model, VRAM, driver, and Compute Capability come from nvidia-smi. “Not user-attributed” is the remainder after subtracting those home directories from df-used space. The page stores only anonymized capacity numbers, not other users’ names, SSH endpoints, GPU UUIDs, or container identity information.')}</p>
  </details>
</main>

<style>
  .server-overview{color:var(--ink)}
  .server-hero{max-width:930px;padding:clamp(1.4rem,4vw,3rem) 0 1.35rem}
  .server-hero__eyebrow{color:var(--accent-deep);font:800 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}
  .server-hero h1{max-width:18ch;margin:.55rem 0 .8rem;font-size:clamp(2rem,5vw,4.2rem);line-height:.98;letter-spacing:-.055em}
  .server-hero>p{max-width:72ch;margin:0;color:var(--muted);font-size:1.02rem;line-height:1.75}
  .snapshot-note{display:flex;flex-wrap:wrap;gap:.45rem .75rem;align-items:center;margin-top:1rem;color:var(--muted);font-size:.72rem}
  .snapshot-note strong{color:var(--ink)}
  .snapshot-note span+span{padding-left:.75rem;border-left:1px solid var(--line)}

  .priority-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin:1rem 0 3.5rem}
  .priority-card{min-height:220px;padding:1.15rem;border:1px solid var(--line);border-radius:18px;background:var(--surface)}
  .priority-card--attention{border-color:color-mix(in srgb,var(--accent-deep) 48%,var(--line));background:color-mix(in srgb,var(--accent) 8%,var(--surface))}
  .priority-card>span{display:block;color:var(--muted);font:800 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase}
  .priority-card>strong{display:block;margin:.8rem 0 .3rem;font-size:clamp(1.85rem,3vw,3rem);line-height:1;letter-spacing:-.055em}
  .priority-card h2{margin:.2rem 0 .75rem;font-size:.9rem;line-height:1.35}
  .priority-card p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.65}

  .server-section{padding:2.4rem 0;border-top:1px solid var(--line)}
  .section-heading{display:flex;gap:.8rem;align-items:flex-start;margin-bottom:1rem}
  .section-heading>span{padding-top:.2rem;color:var(--accent-deep);font:800 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}
  .section-heading small{display:block;color:var(--muted);font:800 .62rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase}
  .section-heading h2{margin:.24rem 0 0;font-size:clamp(1.35rem,2.7vw,2.2rem);letter-spacing:-.035em}
  .section-lede{max-width:76ch;margin:0 0 1.35rem;color:var(--muted);line-height:1.75}

  .storage-status{padding:1.15rem;border:1px solid var(--line);border-radius:18px;background:var(--surface)}
  .storage-status__numbers{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-bottom:1rem}
  .storage-status__numbers>div{padding:.8rem;border-radius:12px;background:color-mix(in srgb,var(--ink) 3%,transparent)}
  .storage-status__numbers span,.storage-status__numbers strong{display:block}
  .storage-status__numbers span{color:var(--muted);font-size:.7rem}
  .storage-status__numbers strong{margin-top:.2rem;font-size:1.35rem;letter-spacing:-.035em}
  .storage-bar{display:flex;height:30px;overflow:hidden;border:1px solid var(--line);border-radius:9px;background:color-mix(in srgb,var(--ink) 3%,transparent)}
  .storage-bar span{display:block;height:100%}
  .storage-bar__ours{background:var(--accent-deep)}
  .storage-bar__user-1,.legend-swatch__user-1{background:color-mix(in srgb,var(--accent-deep) 76%,var(--surface))}
  .storage-bar__user-2,.legend-swatch__user-2{background:color-mix(in srgb,var(--accent-deep) 62%,var(--surface))}
  .storage-bar__user-3,.legend-swatch__user-3{background:color-mix(in srgb,var(--accent-deep) 50%,var(--surface))}
  .storage-bar__user-4,.legend-swatch__user-4{background:color-mix(in srgb,var(--accent-deep) 38%,var(--surface))}
  .storage-bar__user-5,.legend-swatch__user-5{background:color-mix(in srgb,var(--accent-deep) 26%,var(--surface))}
  .storage-bar__unattributed{background:color-mix(in srgb,var(--ink) 48%,var(--surface))}
  .storage-bar__free{background:color-mix(in srgb,var(--accent) 18%,var(--surface))}
  .storage-bar__reserved{background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--ink) 15%,var(--surface)) 0 4px,transparent 4px 8px)}
  .storage-legend{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin-top:.75rem}
  .storage-legend>div{display:grid;grid-template-columns:auto 1fr;gap:.08rem .45rem;align-items:center;padding:.62rem .7rem;border:1px solid var(--line);border-radius:10px}
  .storage-legend span{color:var(--muted);font-size:.68rem}
  .storage-legend strong{grid-column:2;font-size:.82rem}
  .legend-swatch{grid-row:1/3;width:9px;height:9px;border-radius:50%}
  .legend-swatch--ours{background:var(--accent-deep)}
  .legend-swatch--unattributed{background:color-mix(in srgb,var(--ink) 48%,var(--surface))}
  .legend-swatch--free{background:color-mix(in srgb,var(--accent) 38%,var(--surface))}
  .legend-swatch--reserved{border:1px solid var(--muted);background:transparent}
  .fine-print{margin:.85rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.6}
  .why-df{margin-top:1rem;padding:.9rem 1rem;border-left:3px solid var(--accent-deep);background:color-mix(in srgb,var(--accent) 6%,transparent)}
  .why-df strong{font-size:.8rem}
  .why-df p{margin:.25rem 0 0;color:var(--muted);font-size:.76rem;line-height:1.65}

  .own-storage-list{display:grid;gap:.65rem}
  .own-storage-list article{padding:.9rem 1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
  .own-storage-list__row{display:flex;gap:1rem;justify-content:space-between;align-items:flex-start}
  .own-storage-list__row strong{font-size:.85rem}
  .own-storage-list__row p{max-width:70ch;margin:.2rem 0 0;color:var(--muted);font-size:.75rem;line-height:1.55}
  .own-storage-list__row b{flex:0 0 auto;font-size:.95rem}
  .mini-bar{height:5px;margin-top:.65rem;overflow:hidden;border-radius:999px;background:color-mix(in srgb,var(--ink) 6%,transparent)}
  .mini-bar span{display:block;height:100%;border-radius:inherit;background:var(--accent-deep)}
  .section-callout{margin:1rem 0 0;padding:.85rem 1rem;border-radius:12px;background:color-mix(in srgb,var(--accent) 7%,transparent);font-size:.8rem;line-height:1.65}

  .gpu-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin:1.1rem 0 0}
  .gpu-facts>div{padding:.95rem 1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
  .gpu-facts dt{color:var(--muted);font-size:.68rem}
  .gpu-facts dd{margin:.22rem 0 0;font-size:.9rem;font-weight:760;line-height:1.45}
  .gpu-note{margin-top:.85rem;padding:1rem;border:1px solid var(--line);border-radius:14px}
  .gpu-note strong{font-size:.8rem}
  .gpu-note p{margin:.3rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.65}

  .privacy-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
  .privacy-grid>div{padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
  .privacy-grid strong{font-size:.84rem}
  .privacy-grid p{margin:.35rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.65}
  .measurement-notes{margin:1rem 0 0;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
  .measurement-notes summary{cursor:pointer;font-weight:760;font-size:.82rem}
  .measurement-notes p{margin:.7rem 0 0;color:var(--muted);font-size:.75rem;line-height:1.7}

  @media(max-width:960px){.priority-grid{grid-template-columns:1fr 1fr}.storage-legend,.gpu-facts{grid-template-columns:1fr 1fr}}
  @media(max-width:640px){
    .server-hero h1{max-width:12ch}
    .priority-grid,.storage-status__numbers,.storage-legend,.gpu-facts,.privacy-grid{grid-template-columns:1fr}
    .priority-card{min-height:0}
    .storage-bar{height:24px}
    .snapshot-note span+span{padding-left:0;border-left:0}
  }
</style>