---
import ExternalBrandMark from '../common/ExternalBrandMark';
import type { Locale } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const trackARoot = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19';
const trackAManifest: EvidenceRef = { kind: 'manifest', label: t('纠错后的 128 题任务清单', 'Corrected 128-task manifest'), href: `${trackARoot}/configs/experiment/manifests/webshop-seed-source-faithful-reproduction-v1-panel-v1.json` };
const trackASemanticValidation: EvidenceRef = { kind: 'runtime-receipt', label: t('128/128 运行时语义核对', '128/128 runtime semantic validation'), href: `${trackARoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json` };
const trackAAnalysis: EvidenceRef = { kind: 'machine-result', label: t('正式配对统计 · analysis.json', 'Formal paired statistics · analysis.json'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/server/evidence/analysis.json` };
const trackAReconciliation: EvidenceRef = { kind: 'machine-result', label: t('两臂 128/128 完整性对账', '128/128 per-arm reconciliation'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/server/evidence/reconciliation.json` };
const trackACloseout: EvidenceRef = { kind: 'machine-result', label: t('路线 A 机器可读收尾', 'Track A machine-readable closeout'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/CLOSEOUT.json` };
const trackAEvidenceManifest: EvidenceRef = { kind: 'audit', label: t('逐文件 SHA-256 证据清单', 'Per-file SHA-256 evidence manifest'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/EVIDENCE_MANIFEST.json` };
const trackAGovernance: EvidenceRef = { kind: 'audit', label: t('执行授权顺序治理例外', 'Execution-authority ordering exception'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/GOVERNANCE_EXCEPTION.json` };
const postAdvisorRoot = 'https://github.com/mykcs/openevo-experiment/blob/836fc465f94619ecf81fe24aa1465015a6d8cc66';
const postAdvisorActivation: EvidenceRef = { kind: 'runtime-receipt', label: t('后续计划 activation 状态', 'Follow-on workline activation status'), href: `${postAdvisorRoot}/configs/experiment/activations/post-advisor-unanswered-202609282338.json` };
const postAdvisorCampaign: EvidenceRef = { kind: 'config', label: t('后续计划 current-campaign 快照', 'Follow-on workline current-campaign snapshot'), href: `${postAdvisorRoot}/configs/experiment/current-campaign.json` };
const frozenPanelHref = trackAManifest.href;
---

<section class="current-q7" id="q7" aria-labelledby="current-q7-title" data-testid="current-source-faithful-q7">
  <article class="current-question-card">
    <div class="question-number">07</div>
    <div class="question-copy">
      <div class="question-meta">
        <span class="status-badge"><i aria-hidden="true"></i>{t('已完成 · 未证明稳定提升', 'Complete · no stable improvement established')}</span>
      </div>
      <h3 id="current-q7-title">{t('一轮有效测量仍未证明稳定优势', 'A valid measurement still does not establish a stable advantage')}</h3>
      <p class="conclusion">{t(
        '同一 128 个 WebShop 任务已分别交给基础模型和加载冻结 OpenEvo 学习结果的模型评估，256 个回合全部有效。基础模型的平均任务完成度为 7.17 / 100、完整成功率 5/128；OpenEvo 模型为 8.74 / 100、5/128。平均差 +1.57 的 95% 置信区间 [-3.21, +6.31] 包含 0，所以测量有效，但稳定优势尚未建立。9 月 28 日冻结的五项后续研究计划仍处于正式执行锁定状态；计划不是结果，也没有完成 OpenEvo 与 SEED 的同条件方法比较。',
        'The same 128 WebShop tasks were evaluated with the base model and with the same model plus the frozen OpenEvo learning result; all 256 episodes were valid. The base model scored 7.17/100 mean task progress and 5/128 exact successes; OpenEvo scored 8.74/100 and 5/128. The +1.57 mean difference has a 95% interval of [-3.21, +6.31], which includes zero. The measurement is valid but does not establish a stable advantage. Five follow-on studies frozen on September 28 remain formally locked; a plan is not a result and a matched OpenEvo-versus-SEED outcome is still unavailable.',
      )}</p>

      <div class="manifest-callout" data-testid="frozen-128-task-manifest">
        <div class="manifest-copy">
          <strong>{t('已核对的 128 个验证任务', 'Validated set of 128 tasks')}</strong>
          <span>{t(
            '这个 JSON 是纠错后 128 个验证任务的固定快照。128/128 表示全部任务都通过运行时语义核对，执行时使用的任务内容与这份固定清单一致。但公开信息仍不足以证明它就是论文 89.7 / 78.1% 背后的最终 128 题。',
            'This JSON is the fixed snapshot of the corrected 128 validation tasks. All 128 passed runtime semantic validation and the executed task content matches this fixed manifest. Public information still does not establish that this is the final 128-task denominator behind the paper’s 89.7 / 78.1%.',
          )}</span>
        </div>
        <a class="manifest-link" href={frozenPanelHref}><ExternalBrandMark href={frozenPanelHref} />
          {t('在 GitHub 查看固定的 128 题', 'View the frozen 128 tasks on GitHub')} ↗
        </a>
      </div>

      <details class="evidence-details" id="evidence-q7">
        <summary>{t('展开实验依据', 'Expand experiment evidence')}</summary>
        <div class="evidence-detail-body">
          <table>
            <tbody>
              <tr>
                <th scope="row">{t('任务语义核对', 'Semantic gate')}</th>
                <td><span>{t('128 / 128 个任务槽位全部通过 · 语义不匹配 0 个 · 执行任务与固定清单的内容摘要一致（4e7ace92…）', '128 / 128 PASS · mismatches=0 · executed and frozen panel digests match (4e7ace92…)')}</span><OpenEvoEvidenceRefs locale={locale} sources={[trackASemanticValidation]} compact /></td>
              </tr>
              <tr>
                <th scope="row">{t('正式测量（任务完成度 / 完整成功率）', 'Formal measurement')}</th>
                <td><span>{t('基础模型 7.17 / 3.9% · SD-LoRA 8.74 / 3.9%', 'BASE 7.17 / 3.9% · SD-LoRA 8.74 / 3.9%')}</span><OpenEvoEvidenceRefs locale={locale} sources={[trackAAnalysis, trackAReconciliation]} compact /></td>
              </tr>
              <tr>
                <th scope="row">{t('配对结论', 'Paired result')}</th>
                <td><span>{t('10,000 次同任务配对自助重采样 · 平均差 +1.57 · 95% 置信区间 [-3.21,+6.31] · 包含 0，因此未证明稳定差异', '10,000 paired bootstrap resamples · Δ +1.57 · 95% CI [-3.21,+6.31] · crosses 0')}</span><OpenEvoEvidenceRefs locale={locale} sources={[trackAAnalysis]} compact /></td>
              </tr>
              <tr>
                <th scope="row">{t('证据发布', 'Evidence publication')}</th>
                <td><span>{t('已发布且校验通过 · 256 个原始任务回合 · 文件不一致 0 / 缺失 0', 'PUBLISHED_AND_VERIFIED · 256 raw episodes · mismatch 0 / missing 0')}</span><OpenEvoEvidenceRefs locale={locale} sources={[trackACloseout, trackAEvidenceManifest]} compact /></td>
              </tr>
              <tr>
                <th scope="row">{t('结论边界', 'Claim boundary')}</th>
                <td><span>{t('没有证明稳定提升；不是论文当年最终使用的确切 128 题；也没有复现 SEED 论文模型保存点对应的 89.7 / 78.1%。', 'No stable improvement is established; this is not the paper-final exact 128, and the SEED paper checkpoint / 89.7 / 78.1% have not been reproduced.')}</span><OpenEvoEvidenceRefs locale={locale} sources={[trackACloseout]} compact /></td>
              </tr>
              <tr>
                <th scope="row">{t('治理边界', 'Governance boundary')}</th>
                <td><span>{t('科学合同与运行准备先冻结，但 main / 分支授权顺序没有先于第一个正式回合；历史不能倒写。', 'The scientific contract/readiness was frozen first, but main/branch authority did not precede the first formal episode; history is not rewritten.')}</span><OpenEvoEvidenceRefs locale={locale} sources={[trackAGovernance]} compact /></td>
              </tr>
              <tr>
                <th scope="row">{t('后续计划状态', 'Follow-on plan state')}</th>
                <td><span>{t('PR #609 已冻结五项研究计划并获研究目标授权；activation 仍为 PENDING_ZERO_FORMAL_PREFLIGHT，正式任务尚未解锁。', 'PR #609 freezes five studies and authorizes their research goal; activation remains PENDING_ZERO_FORMAL_PREFLIGHT and formal tasks remain locked.')}</span><OpenEvoEvidenceRefs locale={locale} sources={[postAdvisorCampaign, postAdvisorActivation]} compact /></td>
              </tr>
            </tbody>
          </table>
          <ul class="evidence-links">
            <li><a href={trackACloseout.href}><ExternalBrandMark href={trackACloseout.href} />{trackACloseout.label} ↗</a></li>
            <li><a href={trackAAnalysis.href}><ExternalBrandMark href={trackAAnalysis.href} />{trackAAnalysis.label} ↗</a></li>
            <li><a href={trackAReconciliation.href}><ExternalBrandMark href={trackAReconciliation.href} />{trackAReconciliation.label} ↗</a></li>
            <li><a href={trackASemanticValidation.href}><ExternalBrandMark href={trackASemanticValidation.href} />{trackASemanticValidation.label} ↗</a></li>
            <li><a href={trackAManifest.href}><ExternalBrandMark href={trackAManifest.href} />{trackAManifest.label} ↗</a></li>
            <li><a href={trackAEvidenceManifest.href}><ExternalBrandMark href={trackAEvidenceManifest.href} />{trackAEvidenceManifest.label} ↗</a></li>
            <li><a href={trackAGovernance.href}><ExternalBrandMark href={trackAGovernance.href} />{trackAGovernance.label} ↗</a></li>
          </ul>
        </div>
      </details>
    </div>
  </article>
</section>

<style>
  .current-q7{max-width:1160px;margin:-18px auto 0;padding:0 24px 36px;color:var(--color-text)}
  .current-question-card{display:grid;grid-template-columns:70px minmax(0,1fr);gap:24px;max-width:960px;padding:24px 0 4px;border-top:1px solid var(--color-border)}
  .question-number{padding-top:4px;color:var(--color-text-muted);font:700 .78rem ui-monospace,SFMono-Regular,Menlo,monospace}
  .question-copy{min-width:0}
  .question-meta{margin-bottom:9px}
  .status-badge{display:inline-flex;align-items:center;gap:7px;color:var(--color-text-muted);font-size:.75rem;font-weight:760}
  .status-badge i{width:7px;height:7px;border-radius:999px;background:var(--color-info)}
  h3{margin:0 0 12px;font-size:clamp(1.15rem,2.2vw,1.55rem);letter-spacing:-.025em}
  p{max-width:80ch;line-height:1.72}
  .conclusion{margin:0;color:var(--color-text);font-size:.94rem}
  .manifest-callout{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;max-width:900px;margin-top:16px;padding:15px 16px;border:1px solid var(--color-border);border-left:3px solid var(--color-accent);border-radius:12px;background:color-mix(in srgb,var(--color-accent) 5%,var(--color-bg))}
  .manifest-copy{display:grid;gap:4px;min-width:0}
  .manifest-copy strong{font-size:.84rem}
  .manifest-copy span{max-width:72ch;color:var(--color-text-on-tint);font-size:.76rem;line-height:1.55}
  .manifest-link{display:inline-flex;align-items:center;justify-content:center;padding:9px 12px;border:1px solid var(--color-border);border-radius:9px;color:var(--color-accent);font-size:.78rem;font-weight:760;text-decoration:none;white-space:nowrap;background:var(--color-bg)}
  .manifest-link:hover,.manifest-link:focus-visible{text-decoration:underline}
  .evidence-details{max-width:900px;margin-top:14px;border:1px solid var(--color-border);border-radius:12px;background:var(--color-bg)}
  summary{cursor:pointer;padding:13px 15px;font-size:.82rem;font-weight:760}
  .evidence-detail-body{padding:0 15px 15px;border-top:1px solid var(--color-border)}
  table{width:100%;border-collapse:collapse;font-size:.78rem}
  th,td{padding:10px 8px;border-bottom:1px solid var(--color-border);text-align:left;vertical-align:top;line-height:1.55}
  th{width:150px;color:var(--color-text-muted);font-weight:720}
  code{white-space:normal;overflow-wrap:anywhere}
  .evidence-links{display:grid;gap:7px;margin:14px 0 0;padding-left:18px;font-size:.78rem}
  .evidence-links a{color:var(--color-accent);text-decoration:none}
  .evidence-links a:hover{text-decoration:underline}
  @media(max-width:720px){
    .current-q7{padding-inline:18px;margin-top:-10px}
    .current-question-card{grid-template-columns:1fr;gap:8px}
    .manifest-callout{grid-template-columns:1fr}
    .manifest-link{justify-self:start;white-space:normal}
    th,td{display:block;width:auto;padding-inline:0}
    th{padding-bottom:2px;border-bottom:0}
    td{padding-top:2px}
  }
</style>
