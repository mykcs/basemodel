---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import ResearchTaskContext from './ResearchTaskContext.astro';
import {
  SD_LORA_FIXED_WORKLOAD,
  SD_LORA_K128_REPLICATION,
  SD_LORA_R149_PROFILE,
  SD_LORA_SCALING_FITS,
  SD_LORA_SCALING_POINTS,
  SD_LORA_SCALING_SOURCE,
} from '../../data/sdLoraScaling';

interface Props { locale: Locale; variant?: 'chart-first' | 'diagnosis-first' }
const { locale, variant = 'chart-first' } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const evidenceHref = '/research/seed-openevo/evidence/q17-sd-lora-component-scaling-20260912.json';
const sourceCommitHref = `https://github.com/${SD_LORA_SCALING_SOURCE.repository}/commit/${SD_LORA_SCALING_SOURCE.commit}`;
const vanillaSdLoraHref = p('/research/seed-openevo/study/capability-exploration/vanilla-sd-lora/');
const q17Href = p('/research/seed-openevo/study/capability-exploration/q17-directapply-frontier/');
const mechanismHref = p('/research/seed-openevo/study/capability-exploration/mechanism-1-0/');

const chartLeft = 72;
const chartTop = 24;
const chartWidth = 648;
const chartHeight = 276;
const chartBottom = chartTop + chartHeight;
const xFor = (k: number) => chartLeft + (k / 148) * chartWidth;
const yFor = (seconds: number) => chartBottom - (seconds / 1000) * chartHeight;
const chartPoints = SD_LORA_SCALING_POINTS.map((point) => ({
  ...point,
  x: xFor(point.k),
  y: yFor(point.trainer),
}));
const polyline = chartPoints.map((point) => `${point.x},${point.y}`).join(' ');
const fitStart = { x: xFor(0), y: yFor(SD_LORA_SCALING_FITS.trainer.intercept) };
const fitEndSeconds = SD_LORA_SCALING_FITS.trainer.intercept + SD_LORA_SCALING_FITS.trainer.slope * 148;
const fitEnd = { x: xFor(148), y: yFor(fitEndSeconds) };
const yTicks = [0, 250, 500, 750, 1000];
const forwardShare = SD_LORA_R149_PROFILE.forwardSeconds / SD_LORA_R149_PROFILE.instrumentedTrainerSeconds;
const backwardShare = SD_LORA_R149_PROFILE.backwardSeconds / SD_LORA_R149_PROFILE.instrumentedTrainerSeconds;
const otherShare = Math.max(0, 1 - forwardShare - backwardShare);
const round1 = (value: number) => value.toFixed(1);
const round2 = (value: number) => value.toFixed(2);
const sourceShort = SD_LORA_SCALING_SOURCE.commit.slice(0, 8);
---
<section
  class="sd-scale"
  data-copy-review
  data-sd-lora-scaling
  data-variant={variant}
  data-ui-audit="contrast layout evidence"
>
  <header class="scaling-hero">
    <h1>{t('SD-LoRA 的历史 component 越多，下一次更新越慢', 'More SD-LoRA history makes the next update slower')}</h1>
    <p class="scaling-hero__result">
      {t(
        '这里的 component 是 SD-LoRA 每轮保留下来的一份 rank-8 参数增量。训练数据和 94 个 optimizer steps 完全不变，只把历史 component 从 1 增加到 148：一次更新从 44.05 秒增到 969.17 秒。',
        'A component is one rank-8 parameter increment retained by SD-LoRA from an earlier update. With the training data and all 94 optimizer steps fixed, increasing prior components from 1 to 148 raises one update from 44.05 seconds to 969.17 seconds.',
      )}
    </p>
    <div class="scaling-hero__equation" aria-label={t('更新时间与历史 component 数近似线性增长', 'Update time grows approximately linearly with prior component count')}>
      <strong>{t('更新时间', 'Update time')}</strong>
      <span>≈ 38.07 + 6.15 × K {t('秒', 's')}</span>
      <small>R² = {SD_LORA_SCALING_FITS.trainer.r2.toFixed(4)}</small>
    </div>
    <p class="scaling-hero__boundary">
      {t(
        '这是一组固定 R149 训练工作量下的机制诊断，只解释当前 Vanilla SD-LoRA 为什么会越训越慢；它不是所有 LoRA 的通则，还没有证明哪种替代算法最好，也不能单独证明模型发生了持续学习遗忘。',
        'This is a mechanism diagnostic under one fixed R149 training workload. It explains why the current Vanilla SD-LoRA implementation gets slower as history accumulates; it is not a universal LoRA law and does not establish the best replacement algorithm or prove continual-learning forgetting.',
      )}
    </p>
    <nav class="scaling-hero__links" aria-label={t('本页证据与相关研究', 'Evidence and related research')}>
      <a href={evidenceHref}>{t('公开数据', 'Public data')}</a>
      <a href={vanillaSdLoraHref}>{t('先看：Vanilla SD-LoRA 一轮怎么工作', 'First: how one Vanilla SD-LoRA round works')}</a>
    </nav>
  </header>
  <ResearchTaskContext locale={locale} />
  <p class="sd-scale__purpose" data-reader-purpose>{t('这项诊断只回答计算问题：训练工作量不变时，历史 SD-LoRA component 为什么会让下一次更新越来越慢。', 'This diagnostic asks one compute question: with training workload fixed, why do accumulated SD-LoRA components make the next update progressively slower?')}</p>
  <section class="scaling-evidence" aria-labelledby="component-scaling-title">
    <div class="section-heading">
      <h2 id="component-scaling-title">{t('只有历史 component 数量在变化', 'Only prior component count changes')}</h2>
      <p>{t(
        `五个主点都固定 ${SD_LORA_FIXED_WORKLOAD.model}、47 条当前样本 + 47 条 replay、94 个 optimizer steps、BF16、rank 8/component、q/k/v/o 和 gradient checkpointing。`,
        `All five primary points fix ${SD_LORA_FIXED_WORKLOAD.model}, 47 current + 47 replay examples, 94 optimizer steps, BF16, rank 8/component, q/k/v/o targets, and gradient checkpointing.`,
      )}</p>
    </div>
    <figure class="scaling-chart" aria-labelledby="component-scaling-caption">
      <svg viewBox="0 0 760 350" role="img" aria-labelledby="component-scaling-chart-title component-scaling-chart-desc">
        <title id="component-scaling-chart-title">{t('历史 component 数与单次更新时间', 'Prior component count versus update time')}</title>
        <desc id="component-scaling-chart-desc">{t('从 K=1 的 44.05 秒上升到 K=148 的 969.17 秒，五个点接近一条直线。', 'Five points rise from 44.05 seconds at K=1 to 969.17 seconds at K=148, closely following a straight line.')}</desc>
        {yTicks.map((tick) => <g class="gridline"><line x1={chartLeft} y1={yFor(tick)} x2={chartLeft + chartWidth} y2={yFor(tick)} /><text x={chartLeft - 12} y={yFor(tick) + 4}>{tick}</text></g>)}
        <line class="axis" x1={chartLeft} y1={chartTop} x2={chartLeft} y2={chartBottom} />
        <line class="axis" x1={chartLeft} y1={chartBottom} x2={chartLeft + chartWidth} y2={chartBottom} />
        <line class="fit-line" x1={fitStart.x} y1={fitStart.y} x2={fitEnd.x} y2={fitEnd.y} />
        <polyline class="data-line" points={polyline} fill="none" />
        {chartPoints.map((point) => <g class="data-point"><circle cx={point.x} cy={point.y} r="5" /><text x={point.x} y={chartBottom + 26} text-anchor="middle">{point.k}</text><text class="value" x={point.x} y={point.y - 12} text-anchor="middle">{Math.round(point.trainer)}s</text></g>)}
        <text class="axis-label" x={chartLeft + chartWidth / 2} y="344" text-anchor="middle">{t('历史 component 数 K', 'Prior component count K')}</text>
        <text class="axis-label" transform="translate(18 172) rotate(-90)" text-anchor="middle">{t('单次 trainer 时间（秒）', 'Trainer time per update (s)')}</text>
      </svg>
      <figcaption id="component-scaling-caption">{t(
        `线性拟合为 T(K)=38.07+6.15K 秒，R²=${SD_LORA_SCALING_FITS.trainer.r2.toFixed(4)}。K=128 又在另一张同型号 GPU 上独立复现，trainer 时间只相差 ${round2(SD_LORA_K128_REPLICATION.deltaPercent)}%。`,
        `The linear fit is T(K)=38.07+6.15K seconds with R²=${SD_LORA_SCALING_FITS.trainer.r2.toFixed(4)}. K=128 was independently repeated on another GPU of the same model, with only ${round2(SD_LORA_K128_REPLICATION.deltaPercent)}% trainer-time difference.`,
      )}</figcaption>
    </figure>
    <div class="scaling-table-wrap">
      <table class="scaling-table">
        <thead><tr><th scope="col">K</th><th scope="col">{t('Trainer', 'Trainer')}</th><th scope="col">Forward</th><th scope="col">Backward</th></tr></thead>
        <tbody>
          {SD_LORA_SCALING_POINTS.map((point) => <tr>
            <th scope="row">{point.k}</th>
            <td>{round2(point.trainer)} s</td>
            <td>{round2(point.forward)} s</td>
            <td>{round2(point.backward)} s</td>
          </tr>)}
        </tbody>
      </table>
      <p>{t(
        '这些点使用人为只保留前 K 个历史 component 的诊断版本；它们只用于机制分析，不是历史 checkpoint，也不是新增的正式 Q17 treatment round。主曲线固定在同一张 GPU 上，K=128 又在另一张同型号 GPU 上独立复现。',
        'These points use diagnostic variants that retain only the first K prior components. They are mechanism probes, not historical checkpoints or additional formal Q17 treatment rounds. The primary curve stays on one GPU, and K=128 is independently repeated on another GPU of the same model.',
      )}</p>
    </div>
  </section>

  <section class="profile-evidence" aria-labelledby="profile-title">
    <div class="section-heading">
      <h2 id="profile-title">{t('R149：训练后期一次更新的时间主要花在 forward / backward', 'R149: a late-stage update spends most of its time in forward / backward')}</h2>
      <p>{t(
        '在把最终 adapter、loss、94 steps 和 component 数全部复现一致之后，我们才加入计时。高 component-count 下，训练主循环约占 instrumented trainer 的 95%。',
        'Timing was added only after reproducing the same final adapter, loss, 94 steps, and component count. At high component count, the training loop accounts for about 95% of the instrumented trainer.',
      )}</p>
    </div>
    <div class="profile-bar" role="img" aria-label={t('R149 instrumented trainer 时间分解：forward 241.5 秒，backward 677.7 秒，其他约 49.9 秒', 'R149 instrumented trainer breakdown: 241.5 seconds forward, 677.7 seconds backward, about 49.9 seconds other')}>
      <span class="profile-bar__forward" style={`flex-basis:${forwardShare * 100}%`} aria-hidden="true"></span>
      <span class="profile-bar__backward" style={`flex-basis:${backwardShare * 100}%`} aria-hidden="true"></span>
      <span class="profile-bar__other" style={`flex-basis:${otherShare * 100}%`} aria-hidden="true"></span>
    </div>
    <dl class="profile-legend">
      <div><dt>Forward</dt><dd>{round1(SD_LORA_R149_PROFILE.forwardSeconds)} s</dd></div>
      <div><dt>Backward</dt><dd>{round1(SD_LORA_R149_PROFILE.backwardSeconds)} s</dd></div>
      <div><dt>{t('其他 trainer 阶段', 'Other trainer phases')}</dt><dd>{round1(otherShare * SD_LORA_R149_PROFILE.instrumentedTrainerSeconds)} s</dd></div>
    </dl>
    <p class="profile-note">{t(
      `forward + backward 合计 ${round1(SD_LORA_R149_PROFILE.forwardSeconds + SD_LORA_R149_PROFILE.backwardSeconds)} 秒；prior state 验证、composition、serialization 和 hash 都没有达到这个量级。计时器本身让 GPU2 baseline 变慢约 ${round1(SD_LORA_R149_PROFILE.observerEffectPercent)}%，所以这里用它做阶段占比与机制归因，不把绝对秒数当成零扰动真值。`,
      `Forward + backward total ${round1(SD_LORA_R149_PROFILE.forwardSeconds + SD_LORA_R149_PROFILE.backwardSeconds)} seconds. Prior-state validation, composition, serialization, and hashing are much smaller. Instrumentation slowed the GPU2 baseline by about ${round1(SD_LORA_R149_PROFILE.observerEffectPercent)}%, so the profile supports phase attribution rather than zero-overhead absolute timing.`,
    )}</p>
  </section>

  <section class="diagnosis" aria-labelledby="diagnosis-title">
    <div class="section-heading">
      <h2 id="diagnosis-title">{t('R149 更新耗时来源', 'Where R149 update time comes from')}</h2>
      <p>{t(
        '这次排查不是先假定 SD-LoRA 有问题，而是先把几种可能原因分开，再逐个做控制实验。',
        'The diagnosis did not begin by assuming SD-LoRA was at fault. Competing explanations were separated and tested one by one.',
      )}</p>
    </div>
    <ol class="diagnosis-path">
      <li><strong>{t('外围工程开销', 'Pipeline overhead')}</strong><p>{t('Docker 启动、历史参数文件搬运和外围运行记录是秒到几十秒量级，解释不了 R149 trainer 内部 15.32 分钟。', 'Container startup, moving prior-parameter files, and outer run receipts take seconds to tens of seconds; they do not explain the 15.32 minutes already localized inside the R149 trainer.')}</p><span>{t('排除“主要是搬文件”', 'Weakens the file-movement explanation')}</span></li>
      <li><strong>{t('Trainer 内部计时', 'Trainer timing')}</strong><p>{t('先在 GPU2 不加计时器复现 R149，确认最终 adapter、loss、94 steps 和 component 数全部一致，再加入计时。', 'R149 was first reproduced on GPU2 without the timer; the final adapter, loss, 94 steps, and component count all matched before timing was enabled.')}</p><span>{t('确认 forward / backward 是大头', 'Localizes the dominant cost to forward / backward')}</span></li>
      <li><strong>{t('只改变历史 component 数', 'Vary only prior component count')}</strong><p>{t('数据、94 steps、模型和训练设置全部锁住，只改变 K=1/32/64/128/148。更新时间随 K 近似线性增长。', 'Data, 94 steps, model, and training settings stay fixed while K changes across 1/32/64/128/148. Update time grows approximately linearly with K.')}</p><span>{t('把“越来越慢”定位到 component 累积', 'Links the slowdown to component accumulation')}</span></li>
    </ol>
  </section>
  <section class="mechanism" aria-labelledby="mechanism-title">
    <div class="section-heading">
      <h2 id="mechanism-title">{t('为什么 component 越多，forward / backward 越慢', 'Why more components slow forward / backward')}</h2>
      <p>{t(
        '当前 Vanilla SD-LoRA 不是只在 base model 上挂一个固定大小的 rank-8 LoRA。历史 component 会继续留在 target projection 里，新的训练步需要把这些历史低秩路径一起算进去。',
        'The current Vanilla SD-LoRA does not keep one fixed-size rank-8 LoRA on top of the base model. Historical components remain in the target projections, so later training steps compute through those accumulated low-rank paths as well.',
      )}</p>
    </div>
    <figure class="mechanism-figure" aria-labelledby="mechanism-caption">
      <div class="mechanism-base">{t('Base projection', 'Base projection')}</div>
      <div class="mechanism-plus" aria-hidden="true">+</div>
      <div class="mechanism-components" aria-label={t('累计历史 component', 'Accumulated historical components')}>
        <span>c₁ · rank 8</span><span>c₂ · rank 8</span><span>…</span><span>cₖ · rank 8</span>
      </div>
      <div class="mechanism-arrow" aria-hidden="true">↓</div>
      <div class="mechanism-result"><strong>{t('每个训练 step 都要带着历史一起算', 'Every training step carries the accumulated history')}</strong><p>{t('gradient checkpointing 还会让 backward 重新计算部分 forward，因此 backward 的增长更明显。', 'Gradient checkpointing recomputes part of the forward pass during backward, so backward grows even more strongly.')}</p></div>
      <figcaption id="mechanism-caption">{t(
        `拟合中，每多 1 个历史 component，94-step update 的 forward 平均增加约 ${round2(SD_LORA_SCALING_FITS.forward.slope)} 秒，backward 增加约 ${round2(SD_LORA_SCALING_FITS.backward.slope)} 秒。`,
        `In the fitted 94-step update, each additional prior component adds about ${round2(SD_LORA_SCALING_FITS.forward.slope)} seconds to forward and ${round2(SD_LORA_SCALING_FITS.backward.slope)} seconds to backward.`,
      )}</figcaption>
    </figure>
  </section>

  <section class="conclusion" aria-labelledby="conclusion-title">
    <div class="section-heading">
      <h2 id="conclusion-title">{t('当前证据支持什么', 'What the current evidence supports')}</h2>
    </div>
    <div class="claim-grid">
      <article><strong>{t('已经支持', 'Supported')}</strong><p>{t('在固定 R149 workload 下，当前 Vanilla SD-LoRA 的更新时间会随历史 component 数强烈、近似线性增长，而且主要增长在 forward / backward。', 'Under the fixed R149 workload, current Vanilla SD-LoRA update time grows strongly and approximately linearly with accumulated prior component count, with most growth in forward / backward.')}</p></article>
      <article><strong>{t('还不能推出', 'Not established')}</strong><p>{t('这项实验没有证明哪种替代算法最好，也没有证明 component 累积本身会让 WebShop 能力下降，更不是所有 LoRA / continual-learning 实现的普遍定律。', 'This experiment does not identify the best replacement algorithm, does not show that component accumulation itself reduces WebShop capability, and is not a universal law for all LoRA or continual-learning implementations.')}</p></article>
    </div>
    <p class="next-question">{t('下一步研究问题已经交给独立方法设计：怎样在保持科学语义等价的前提下，避免未来每一次学习都重新承担不断增长的历史计算。', 'The next research question is method design: how to preserve the same scientific semantics without making every future learning step pay an ever-growing historical compute cost.')}</p>
    <nav class="next-links" aria-label={t('相关研究入口', 'Related research routes')}>
      <a href={vanillaSdLoraHref}>{t('机制背景：Vanilla SD-LoRA 一轮', 'Mechanism background: one Vanilla SD-LoRA round')}</a>
      <a href={q17Href}>{t('能力变化：R127 / R128 同题诊断', 'Capability change: R127 / R128 same-task diagnostic')}</a>
      <a href={mechanismHref}>{t('参数变化：机制实验', 'Parameter change: mechanism experiments')}</a>
    </nav>
  </section>
  <details class="evidence-depth">
    <summary>{t('实验依据：固定条件、计时器复现校验与原始证据', 'Experiment evidence: fixed conditions, profiler reproduction check, and raw evidence')}</summary>
    <div class="evidence-depth__grid">
      <div><strong>{t('固定 workload', 'Fixed workload')}</strong><p>{t(`Qwen3-1.7B；47 current + 47 replay；94 optimizer steps；batch 1；BF16；rank ${SD_LORA_FIXED_WORKLOAD.rankPerComponent}/component；q/k/v/o；gradient checkpointing。`, `Qwen3-1.7B; 47 current + 47 replay; 94 optimizer steps; batch 1; BF16; rank ${SD_LORA_FIXED_WORKLOAD.rankPerComponent}/component; q/k/v/o; gradient checkpointing.`)}</p></div>
      <div><strong>{t('计时器资格检查', 'Profiler qualification')}</strong><p>{t('无计时 GPU2 reproduction 与正式 R149 的最终 adapter digest、loss、step 数、component 数和 peak memory 一致；加入计时后这些结果仍一致。', 'The uninstrumented GPU2 reproduction matched formal R149 in final adapter digest, loss, step count, component count, and peak memory; those outputs still matched after timing was enabled.')}</p></div>
      <div><strong>{t('独立 GPU 复现', 'Independent GPU replication')}</strong><p>{t(`K=128 在另一张同型号 GPU 上重复，trainer 时间 ${round2(SD_LORA_K128_REPLICATION.gpu2TrainerSeconds)}s vs ${round2(SD_LORA_K128_REPLICATION.gpu5TrainerSeconds)}s，仅差 ${round2(SD_LORA_K128_REPLICATION.deltaPercent)}%。`, `K=128 was repeated on another GPU of the same model: ${round2(SD_LORA_K128_REPLICATION.gpu2TrainerSeconds)}s vs ${round2(SD_LORA_K128_REPLICATION.gpu5TrainerSeconds)}s, a ${round2(SD_LORA_K128_REPLICATION.deltaPercent)}% difference.`)}</p></div>
      <div><strong>{t('证据身份', 'Evidence identity')}</strong><p>{t(`公开页面使用脱敏摘要；完整实验依据固定在 openevo-experiment@${sourceShort}。`, `The public page uses a redacted summary; full experiment evidence is pinned at openevo-experiment@${sourceShort}.`)}</p></div>
    </div>
    <p class="evidence-depth__links"><a href={evidenceHref}>{t('打开公开 JSON', 'Open public JSON')}</a><a href={sourceCommitHref}><ExternalBrandMark href={sourceCommitHref} />{t('打开实验 commit', 'Open experiment commit')}</a></p>
  </details>
</section>

<style>
.sd-scale{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--ink)}.sd-scale__purpose{max-width:52rem;margin:1.25rem 0 0;padding-left:1rem;border-left:2px solid var(--accent-deep);font-size:1rem;line-height:1.65;color:var(--muted)}
.scaling-hero{padding:clamp(2.4rem,7vw,5.8rem) 0 2.4rem;border-bottom:1px solid var(--line)}
.scaling-hero h1{max-width:18ch;margin:0;font-family:var(--font-editorial);font-size:clamp(2.25rem,6vw,4.9rem);line-height:.98;letter-spacing:-.045em}
.scaling-hero__result{max-width:50rem;margin:1.25rem 0 0;font-size:clamp(1.12rem,2vw,1.45rem);line-height:1.62}
.scaling-hero__equation{display:flex;flex-wrap:wrap;align-items:baseline;gap:.35rem 1rem;margin:1.6rem 0 0;padding:1rem 0;border-block:1px solid var(--line)}
.scaling-hero__equation strong{font-size:1rem}.scaling-hero__equation span{font:700 clamp(1.3rem,3vw,2rem)/1.2 var(--font-mono);color:var(--accent-deep)}.scaling-hero__equation small{color:var(--muted);font:700 1rem/1.25 var(--font-mono)}
.scaling-hero__boundary{max-width:50rem;margin:1.05rem 0 0;color:var(--muted);line-height:1.6}.scaling-hero__links{display:flex;flex-wrap:wrap;gap:.45rem 1.1rem;margin-top:1rem}.scaling-hero__links a,.next-links a,.evidence-depth a{color:var(--accent-deep);font-weight:750;text-underline-offset:.22em}
.scaling-evidence,.profile-evidence,.diagnosis,.mechanism,.conclusion{padding:2.8rem 0;border-bottom:1px solid var(--line)}.section-heading{max-width:50rem}.section-heading h2{margin:0;font-family:var(--font-editorial);font-size:clamp(1.65rem,3.3vw,2.55rem);line-height:1.08;letter-spacing:-.025em}.section-heading p{margin:.75rem 0 0;color:var(--muted);line-height:1.65}
.scaling-chart{margin:1.5rem 0 0}.scaling-chart svg{display:block;width:100%;height:auto;overflow:visible}.gridline line{stroke:var(--line);stroke-width:1}.gridline text,.data-point text,.axis-label{fill:var(--muted);font:700 13px var(--font-mono)}.axis{stroke:var(--ink);stroke-width:1.4}.fit-line{stroke:var(--muted);stroke-width:1.5;stroke-dasharray:7 7}.data-line{stroke:var(--accent-deep);stroke-width:3}.data-point circle{fill:var(--surface);stroke:var(--accent-deep);stroke-width:3}.data-point .value{fill:var(--ink);font-weight:800}.scaling-chart figcaption{max-width:52rem;margin:.75rem 0 0;color:var(--muted);font-size:1rem;line-height:1.55}
