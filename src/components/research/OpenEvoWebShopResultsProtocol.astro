---
import { localePath, type Locale } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const seedRoot = 'https://github.com/jinyangwu/SEED/blob/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const archiveRoot = 'https://github.com/mykcs/openevo-experiment/blob/476039e9ce82767120db803d57f016db3b1414ce';
const heldoutRoot = 'https://github.com/mykcs/openevo-experiment/blob/429faae1acc1132f8bdad4269a4e15864a9cccb0';
const sourceFaithfulRoot = 'https://github.com/mykcs/openevo-experiment/blob/1971fad6602d23d499a5de8bd4bf718947207d86';
const trackARoot = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19';
const rawEpisodeRoot = 'https://github.com/mykcs/openevo-experiment/blob/115062ea0b47ee769a3e1591ffd3d5c89c4a353a';
const sourceFaithfulConfig: EvidenceRef = {
  kind: 'preregistration',
  label: t('源码忠实复现冻结配置', 'Source-faithful frozen preregistration'),
  href: `${sourceFaithfulRoot}/configs/experiment/webshop-seed-source-faithful-reproduction-v1.json`,
};
const seedSplitSource: EvidenceRef = {
  kind: 'official-code',
  label: t('SEED WebShop train / validation 范围', 'SEED WebShop train / validation ranges'),
  href: `${seedRoot}/agent_system/environments/env_package/webshop/envs.py#L115-L145`,
};
const seedValidationSizeSource: EvidenceRef = {
  kind: 'official-code',
  label: t('SEED WebShop launcher：VAL_DATA_SIZE=128', 'SEED WebShop launcher: VAL_DATA_SIZE=128'),
  href: `${seedRoot}/examples/seed_trainer/_common/webshop.sh`,
};
const seedSamplingSource: EvidenceRef = {
  kind: 'official-code',
  label: t('SEED worker seed 与 validation 抽样', 'SEED worker seeds and validation sampling'),
  href: `${seedRoot}/agent_system/environments/env_package/webshop/envs.py#L115-L145`,
};
const h138bEvalManifest: EvidenceRef = { kind: 'manifest', label: t('H1.38B 冻结评估任务', 'H1.38B frozen evaluation manifest'), href: `${archiveRoot}/configs/experiment/manifests/h1.38b-method-control-eval-v1.json` };
const h139EvalManifest: EvidenceRef = { kind: 'manifest', label: t('H1.39 独立新任务组', 'H1.39 independent fresh-task panel'), href: `${archiveRoot}/configs/experiment/manifests/h1.39-mr-independent-panel-v1.json` };
const sourceFaithfulAudit: EvidenceRef = { kind: 'audit', label: t('SEED 公共代码任务语义审计', 'SEED public-code task-semantics audit'), href: `${sourceFaithfulRoot}/docs/experiment-tracking/SEED_WEBSHOP_PUBLIC_CODE_REPRODUCTION_V1.md` };
const trackASemanticValidation: EvidenceRef = { kind: 'runtime-receipt', label: t('纠错后 128/128 运行时语义核对', 'Corrected 128/128 runtime semantic validation'), href: `${trackARoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json` };
const primaryV1RawEpisode: EvidenceRef = { kind: 'raw-episode', label: t('PRIMARY-v1 BASE 原始回合', 'PRIMARY-v1 BASE raw episode'), href: `${rawEpisodeRoot}/docs/evidence/seed-official-heldout-comparison-v1/episodes/primary/base/episodes/webshop_seed0_goal00395-2026082586.json#L42-L53` };
const primaryV2Analysis: EvidenceRef = { kind: 'machine-result', label: t('修复后 PRIMARY-v2 配对分析', 'Repaired PRIMARY-v2 paired analysis'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/analysis-v2.json` };

type TaskRangeCard = { label: string; value: string; body: string; sources: EvidenceRef[] };
const taskRangeCards: TaskRangeCard[] = [
  {
    label: t('训练范围内没有见过的任务', 'Unseen tasks from the training range'),
    value: t('任务 500–6909', 'Tasks 500–6909'),
    body: t('训练经验从这段范围里收集；评测时再挑训练过程中没有出现过的任务。它能回答“学到的东西能不能迁移到没见过的任务”，但它不是 SEED 留作正式验证的那批任务。', 'Training experience is collected from this range, and evaluation then selects tasks that were not used during training. This tests transfer to unseen tasks, but these are not the tasks SEED reserves for formal validation.'),
    sources: [seedSplitSource, sourceFaithfulConfig, h138bEvalManifest, h139EvalManifest],
  },
  {
    label: t('SEED 留作验证的任务', 'Tasks SEED reserves for validation'),
    value: t('任务 0–499', 'Tasks 0–499'),
    body: t('SEED 的公开代码把这段范围留作验证。我们的历史 128 题来自这里，但后续复查发现：只有编号范围相同还不够，抽样方式也必须一致，最后生成的任务内容才会真正对应。', 'SEED’s released code reserves this range for validation. Our historical 128-task panel came from this range, but later checking showed that matching the numbers alone is not enough: the sampling process must also match so that the generated tasks are actually the same.'),
    sources: [seedValidationSizeSource, seedSplitSource, seedSamplingSource, sourceFaithfulAudit, trackASemanticValidation],
  },
];

const metricDefinitions = [
  { term: t('任务完成度（Task Score）', 'Task Score'), body: t('回答“这项购物任务完成了多少”。即使最后没有完整买对，也可能因为满足了一部分条件而得到部分分。', 'How much of the task was satisfied. Partial progress can receive partial credit even without exact task completion.') },
  { term: t('完整成功（Exact Success）', 'Exact Success'), body: t('回答“最后有没有把整个任务完整做对”。它是一个单独的成功 / 不成功判断。', 'Whether the complete task was satisfied. It is a separate yes/no outcome.') },
] as const;
---

<section class="results-protocol" id="protocol" aria-labelledby="protocol-title">
  <header class="section-heading">
    <p>{t('实验边界', 'Protocol boundary')}</p>
    <div>
      <h2 id="protocol-title">{t('训练范围内未见任务与 SEED 验证任务', 'Unseen training-range tasks and SEED validation tasks')}</h2>
      <p class="plain-intro">{t('我们已经看到模型能把训练中学到的东西迁移到没有训练过的 WebShop 任务。但这些任务来自训练使用的 500–6909 号范围，不是 SEED 留作正式验证的 0–499 号任务，因此这项结果不能直接当作 SEED 验证集成绩。', 'We have evidence that the model can transfer what it learned to WebShop tasks it did not train on. Those tasks come from the 500–6909 training range, not the 0–499 tasks SEED reserves for validation, so that result is not a SEED validation-set score.')}</p>
      <p class="range-note">{t('后续按 SEED 公开代码复查时还发现，只对上任务编号也不够：随机抽样方式会改变任务顺序和最终文字。要说“复现了同一批验证任务”，编号范围、抽样方式和实际生成的任务都要对应。', 'A later check against the released SEED code found that matching task numbers is also not enough: random sampling changes task order and the resulting instructions. Reproducing the same validation tasks therefore requires the range, sampling process, and generated tasks to match.')}</p>
    </div>
  </header>

  <div class="task-range-grid" aria-label={t('两类任务范围', 'Two task ranges')}>
    {taskRangeCards.map((card) => (
      <article class="task-range-card">
        <h3>{card.label}</h3>
        <p class="range-value">{card.value}</p>
        <p>{card.body}</p>
        <OpenEvoEvidenceRefs locale={locale} sources={card.sources} compact ariaLabel={t(`“${card.label}”的来源`, `Sources for ${card.label}`)} />
      </article>
    ))}
  </div>

  <div class="metric-defs">
    <div class="metric-defs-heading"><h3>{t('任务完成度与完整成功', 'Task progress and exact success')}</h3><p>{t('“做得更接近目标”不等于“最后完整做对”。因此结果页把任务完成度和完整成功分开报告。', 'Getting closer to the goal is not the same as completing the whole task, so the results page reports task progress and exact success separately.')}</p></div>
    <dl class="metric-def-list">{metricDefinitions.map((item) => <div class="metric-def"><dt>{item.term}</dt><dd>{item.body}</dd></div>)}</dl>
  </div>

  <div class="boundary-strip">
    <h3>{t('测量有效性', 'Measurement validity')}</h3>
    <div>
      <p>{t('第一次主评测出现 0 分，不代表模型被证明“完全不会做”。当时评分链路没有正确读懂模型输出的动作格式；修复读取方式以后，才得到可以解释的本地结果。', 'The first primary evaluation produced zeros, but that did not prove the model had zero capability. The scoring path was not reading the model’s action format correctly; only after repairing that path did we obtain an interpretable local result.')}</p>
      <p class="boundary-context">{t('后来发现的任务抽样问题是另一件事：它影响“是不是同一批任务”，而不是“评分器有没有读懂模型动作”。这两个问题分别核对，避免把测量故障误当成模型能力差异。', 'The later task-sampling issue is different: it affects whether the evaluation used the same tasks, not whether the evaluator could read the model’s action. We check these separately so a measurement failure is not mistaken for a capability difference.')}</p>
      <OpenEvoEvidenceRefs locale={locale} sources={[{ kind: 'official-code', label: t('SEED 动作读取代码', 'SEED action parser'), href: `${seedRoot}/agent_system/environments/env_package/webshop/projection.py#L32-L40` }, primaryV1RawEpisode, primaryV2Analysis, sourceFaithfulAudit]} compact />
    </div>
  </div>

  <div class="canonical-figure-links" aria-label={t('相关背景', 'Related background')}>
    <span>{t('相关背景', 'Related background')}</span>
    <a href={`${localePath(locale, '/research/seed-openevo/flow/webshop/')}#fig-seed-webshop`}>{t('WebShop 与 SEED 的任务划分 →', 'WebShop and SEED task split →')}</a>
    <a href={`${localePath(locale, '/research/seed-openevo/flow/loops/')}#fig-seed-openevo-update-target`}>{t('SEED 与 OpenEvo 分别更新什么 →', 'What SEED and OpenEvo update →')}</a>
  </div>
</section>

<style>
  .results-protocol{max-width:1160px;margin:0 auto;padding:36px 24px 48px;color:var(--color-text)}
  .section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}
  .section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:700;letter-spacing:.06em}
  .section-heading h2{margin:0 0 10px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}
  .section-heading div>p{margin:0;max-width:72ch;font-size:.94rem;line-height:1.7}.plain-intro{color:var(--color-text)}.range-note{margin-top:10px!important;color:var(--color-text-muted);font-size:.86rem!important}
  .task-range-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .task-range-card{padding:20px;border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface)}.task-range-card h3{margin:0;font-size:1rem;line-height:1.45}.task-range-card .range-value{margin:9px 0 8px;color:var(--color-accent);font-size:1.08rem;font-weight:720}.task-range-card>p:not(.range-value){margin:0;color:var(--color-text-muted);font-size:.82rem;line-height:1.65}
  .metric-defs{margin-top:12px;padding:22px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}.metric-defs-heading h3{margin:0;font-size:1.08rem;line-height:1.4;letter-spacing:-.02em}.metric-defs-heading p{margin:8px 0 0;max-width:72ch;color:var(--color-text-muted);font-size:.86rem;line-height:1.65}.metric-def-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:18px 0 0}.metric-def{padding:14px;border:1px solid var(--color-border);border-radius:11px;background:var(--color-surface)}.metric-def dt{font-size:.82rem;font-weight:760;line-height:1.5}.metric-def dd{margin:8px 0 0;color:var(--color-text-muted);font-size:.78rem;line-height:1.58}
  .boundary-strip{display:grid;grid-template-columns:180px minmax(0,1fr);gap:18px;margin-top:12px;padding:18px;border:1px solid var(--color-border);border-radius:11px;background:var(--color-surface)}.boundary-strip>h3{margin:0;font-size:.86rem}.boundary-strip p{margin:0;max-width:80ch;font-size:.8rem;line-height:1.65}.boundary-context{margin-top:8px!important;color:var(--color-text-muted)}
  .canonical-figure-links{display:flex;align-items:center;gap:10px 18px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid var(--color-border);font-size:.78rem}.canonical-figure-links span{color:var(--color-text-muted);font-size:.7rem;font-weight:700;letter-spacing:.05em}.canonical-figure-links a{color:var(--color-accent);font-weight:750;text-decoration:none}.canonical-figure-links a:hover,.canonical-figure-links a:focus-visible{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:720px){.results-protocol{padding-inline:18px}.section-heading{grid-template-columns:1fr;gap:8px}.task-range-grid,.metric-def-list{grid-template-columns:1fr}.boundary-strip{grid-template-columns:1fr;gap:8px}}
</style>
