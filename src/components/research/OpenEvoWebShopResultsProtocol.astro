---
import { localePath, type Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const protocolCards = [
  {
    label: t('主要比较模型', 'Main comparison model'),
    value: 'Qwen2.5-7B-Instruct',
    body: t(
      '单步迁移与 2026-08-25 的保留任务评测都围绕同一个冻结基座模型展开。更早的 H0 成功经验供给实验使用 3B，只作为历史证据。',
      'The one-step transfer results and the 2026-08-25 held-out evaluation use the same frozen 7B base model. The earlier H0 experience-supply study used 3B and remains historical evidence.',
    ),
  },
  {
    label: t('WebShop 任务世界', 'WebShop task world'),
    value: t('1,000 商品 · 6,910 个任务目标', '1,000 products · 6,910 goals'),
    body: t(
      '模型要在网页环境里搜索、点击并完成购买。每个任务最后会得到“完成了多少”和“是否完整成功”两种结果。',
      'The model searches, clicks, and attempts a purchase in the web environment. Each task ends with a partial-completion score and a separate exact-success result.',
    ),
  },
  {
    label: t('训练与内部新任务评估', 'Training and internal fresh-task evaluation'),
    value: 'goal_idx ≥ 500',
    body: t(
      '训练经验来自 500–6909。H1.38B / H1.39 的新任务评估也来自这个范围，但会排除已经用于训练的任务身份。',
      'Training experience comes from 500–6909. The H1.38B / H1.39 fresh-task evaluations also come from this range while excluding task identities already used for training.',
    ),
  },
  {
    label: t('SEED 官方保留任务', 'SEED official held-out tasks'),
    value: 'goal_idx 0–499',
    body: t(
      '2026-08-25 已从这个范围冻结 128 个任务并完成首轮比较。主评测因为动作格式与解析规则不兼容而被判为测量无效，因此还没有可以作为正式主结果报告的分数。',
      'On 2026-08-25, 128 tasks from this range were frozen and used for the first comparison. The primary evaluation was measurement-invalid because the action format and parsing rule were incompatible, so there is not yet a reportable headline score.',
    ),
  },
] as const;

const metricDefinitions = [
  {
    term: t('任务完成度 · Task Score', 'Task Score'),
    body: t('任务完成了多少。即使没有完成购买，也可能得到部分分。', 'How much of the task was completed. Partial progress can earn partial credit even without a completed purchase.'),
  },
  {
    term: t('完整成功 · Exact Success', 'Exact Success'),
    body: t('是否完整满足任务并成功购买。它是“成功 / 不成功”的单独判断。', 'Whether the task was fully satisfied and the purchase completed. It is a separate yes/no outcome.'),
  },
] as const;
---

<section class="results-protocol" id="protocol" aria-labelledby="protocol-title">
  <header class="section-heading">
    <p>PROTOCOL</p>
    <div>
      <h2 id="protocol-title">{t('先记住两个任务范围', 'Two task ranges to keep in mind')}</h2>
      <p>{t(
        '后面的结论最容易混淆在这里：500 之后的任务用于训练和内部新任务评估；0–499 是 SEED 的官方保留任务范围。两者不能当成同一份测试结果。',
        'The most important distinction is simple: tasks from 500 onward feed training and internal fresh-task evaluation, while 0–499 is the SEED official held-out range. Results from the two ranges are not interchangeable.',
      )}</p>
    </div>
  </header>

  <div class="protocol-grid">
    {protocolCards.map((card) => (
      <article class="protocol-card">
        <small>{card.label}</small>
        <strong>{card.value}</strong>
        <p>{card.body}</p>
      </article>
    ))}
  </div>

  <div class="metric-defs">
    <div class="metric-defs-heading">
      <h3>{t('结果里只需要先分清两个分数', 'Two scores are enough to start')}</h3>
      <p>{t(
        '“完成得更多”不一定等于“完整买对了”。因此 Task Score 和 Exact Success 会一直分开报告。',
        'More partial progress does not necessarily mean more completed purchases, so Task Score and Exact Success are always reported separately.',
      )}</p>
    </div>
    <dl class="metric-def-list">
      {metricDefinitions.map((item) => (
        <div class="metric-def">
          <dt>{item.term}</dt>
          <dd>{item.body}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="boundary-strip">
    <strong>{t('测量规则', 'Measurement rule')}</strong>
    <p>{t(
      '如果解析器（parser）把模型动作读错，这次运行先记为“测量无效（measurement-invalid）”，不会把由工具造成的 0 分解释成模型能力。2026-08-25 的首轮官方保留任务评测就是这种情况。',
      'If the parser misreads the model action, the run is classified as measurement-invalid rather than treating a tool-caused zero as model ability. That is what happened in the first 2026-08-25 official-held-out evaluation.',
    )}</p>
  </div>

  <div class="canonical-figure-links" aria-label={t('进一步理解实验设定', 'Further protocol context')}>
    <span>{t('进一步理解', 'Learn more')}</span>
    <a href={`${localePath(locale, '/research/seed-openevo/webshop/')}#fig-seed-webshop`}>{t('WebShop 与 SEED 的任务划分 →', 'WebShop and SEED task split →')}</a>
    <a href={`${localePath(locale, '/research/seed-openevo/loops/')}#fig-seed-openevo-update-target`}>{t('SEED 与 OpenEvo 分别更新什么 →', 'What SEED and OpenEvo update →')}</a>
  </div>
</section>

<style>
  .results-protocol{max-width:1160px;margin:0 auto;padding:36px 24px 48px;color:var(--color-text)}
  .section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}
  .section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.14em}
  .section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}
  .section-heading div>p{margin:0;max-width:66ch;color:var(--color-text-muted);font-size:.94rem;line-height:1.68}
  .protocol-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
  .protocol-card{display:flex;min-height:180px;flex-direction:column;padding:17px;border:1px solid var(--color-border);border-radius:13px;background:var(--color-surface)}
  .protocol-card small{color:var(--color-accent);font-size:.7rem;font-weight:760;line-height:1.5}
  .protocol-card strong{margin:14px 0 8px;font-size:.98rem;line-height:1.4;overflow-wrap:anywhere}
  .protocol-card p{margin:0;color:var(--color-text-muted);font-size:.79rem;line-height:1.62}
  .metric-defs{margin-top:12px;padding:22px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}
  .metric-defs-heading h3{margin:0;font-size:1.08rem;line-height:1.4;letter-spacing:-.02em}
  .metric-defs-heading p{margin:8px 0 0;max-width:72ch;color:var(--color-text-muted);font-size:.86rem;line-height:1.65}
  .metric-def-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:18px 0 0}
  .metric-def{padding:14px;border:1px solid var(--color-border);border-radius:11px;background:var(--color-surface)}
  .metric-def dt{font-size:.82rem;font-weight:760;line-height:1.5}
  .metric-def dd{margin:8px 0 0;color:var(--color-text-muted);font-size:.78rem;line-height:1.58}
  .boundary-strip{display:grid;grid-template-columns:180px minmax(0,1fr);gap:18px;margin-top:12px;padding:14px 16px;border:1px solid var(--color-border);border-radius:11px;background:var(--color-surface)}
  .boundary-strip strong{font-size:.78rem}
  .boundary-strip p{margin:0;max-width:78ch;color:var(--color-text-muted);font-size:.78rem;line-height:1.62}
  .canonical-figure-links{display:flex;align-items:center;gap:10px 18px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid var(--color-border);font-size:.78rem}
  .canonical-figure-links span{color:var(--color-text-muted);font-size:.7rem;font-weight:750;letter-spacing:.08em}
  .canonical-figure-links a{color:var(--color-accent);font-weight:750;text-decoration:none}
  .canonical-figure-links a:hover,.canonical-figure-links a:focus-visible{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:960px){.protocol-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.metric-def-list{grid-template-columns:1fr}}
  @media(max-width:720px){
    .results-protocol{padding-inline:18px}
    .section-heading{grid-template-columns:1fr;gap:8px}
    .protocol-grid{grid-template-columns:1fr}
    .protocol-card{min-height:auto}
    .boundary-strip{grid-template-columns:1fr;gap:7px}
  }
</style>
