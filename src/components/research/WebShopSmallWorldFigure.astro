---
import ExternalBrandMark from '../common/ExternalBrandMark';
import { type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (cn: string, en: string) => locale === 'zh' ? cn : en;
const officialSetupUrl = 'https://github.com/princeton-nlp/WebShop/blob/master/setup.sh';
---
<section id="fig-webshop-small-world" class="canonical-figure webshop-small-world" aria-labelledby="webshop-small-world-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">{t('第二步 · OFFICIAL SMALL MODE', 'STEP 2 · OFFICIAL SMALL MODE')}</div>
    <h3 id="webshop-small-world-title">{t('WebShop 官方 small 模式：商品世界固定为 1,000 个商品', 'WebShop official small mode fixes the product world at 1,000 products')}</h3>
    <p>{t('研究时不用把 118 万件商品都搬进环境。WebShop 官方已经准备好一组 small 数据文件；SEED 的公开代码默认使用它们，不是 SEED 临时随机抽 1,000 个商品。', 'The research environment need not load all 1.18 million items. WebShop provides a prepared small dataset, and the released SEED code defaults to that dataset rather than drawing its own random 1,000-item subset.')}</p>
  </header>
  <figure class="world-story" aria-labelledby="webshop-small-world-title">
    <div class="catalog-choice" role="group" aria-label={t('从原始商品目录改用官方 small 数据文件', 'Switch from full catalog to official small dataset')}>
      <div class="catalog-choice__source" data-ui-audit-item>
        <span>{t('完整商品目录', 'FULL CATALOG')}</span>
        <strong>1,181,436</strong>
        <small>{t('商品记录', 'product records')}</small>
      </div>
      <div class="catalog-choice__action">
        <span>SUBSET · {t('取子集', 'SELECT')}</span>
        <strong>{t('WebShop 官方提供', 'Provided by WebShop')}</strong>
        <span>WebShop small 数据配置</span>
        <small>{t('改为加载预先准备好的文件', 'Use prepared files instead of the full catalog')}</small>
      </div>
      <div class="catalog-choice__selected" data-ui-audit-item>
        <span>{t('运行中的 small 商店', 'SMALL SHOP')}</span>
        <strong>1,000</strong>
        <small>{t('商品记录', 'product records')}</small>
      </div>
    </div>
    <p class="file-proof">{t('具体选择的是', 'The selected assets are')} <code>items_shuffle_1000</code> {t('和', 'and')} <code>items_ins_v2_1000</code>{t('。这描述运行环境里的商品规模，不是训练 goal 的数量。', '. These are product files, not a count of training goals.')}</p>
    <details class="evidence">
      <summary>{t('查看官方代码证据', 'See official source evidence')}</summary>
      <div class="evidence-grid">
        <div>
          <strong>WebShop setup.sh</strong>
          <code>Usage: ./setup.sh -d small|all</code>
          <p>{t('small 模式下载 items_shuffle_1000 与 items_ins_v2_1000。', 'Small mode downloads items_shuffle_1000 and items_ins_v2_1000.')}</p>
          <a href={officialSetupUrl} target="_blank" rel="noreferrer"><ExternalBrandMark href={officialSetupUrl} />{t('官方 setup.sh ↗', 'Official setup.sh ↗')}</a>
        </div>
        <div>
          <strong>SEED WebShop utils.py</strong>
          <code>DEFAULT_FILE_PATH = ...items_shuffle_1000.json</code>
          <p>{t('SEED 的默认文件路径指向这组 1,000-product 数据。', 'The SEED default path points to these 1,000-product files.')}</p>
        </div>
      </div>
    </details>
    <figcaption>{t('这里发生的是官方已有商品文件之间的选择（subset），并没有生成新商品；下一节才是根据商品生成购物任务。', 'This stage selects official existing product files (subset). It does not create new products; generating shopping tasks happens in the next stage.')}</figcaption>
  </figure>
</section>
<style>
  .webshop-small-world{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:900px}.figure-label{color:var(--accent);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-heading) var(--font-interface);letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.6rem,3.7vw,2.9rem);line-height:1.05;letter-spacing:-.045em}.figure-header p{margin:0;color:var(--muted);line-height:var(--type-leading-body)}
  .world-story{display:grid;grid-template-columns:minmax(0,1fr) minmax(190px,.56fr) minmax(0,1fr);gap:1rem;align-items:stretch;margin:1.5rem 0 0}
  .world-panel{padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface-muted)}.panel-kicker{color:var(--muted);font:800 .6rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.world-panel strong{display:block;margin:.8rem 0 .12rem;font-size:clamp(2.1rem,5vw,4.4rem);line-height:.9;letter-spacing:-.06em}.world-panel>span{display:block;color:var(--muted);font-size:.75rem}.world-panel p{margin:.7rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.55}.world-panel.original{border-top:5px solid var(--line-strong,var(--line))}.world-panel.small{border-top:5px solid var(--accent)}
  .warehouse{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;margin-top:1rem;align-content:start}.warehouse span{aspect-ratio:1;border-radius:3px;background:var(--ink);opacity:.46}.warehouse.compact{grid-template-columns:repeat(5,1fr);max-width:180px}.warehouse.compact span{background:var(--accent);opacity:.85}.catalog-continuation{display:flex;align-items:center;justify-content:center;margin:.55rem 0 .1rem;height:22px;border:1px dashed var(--line);border-radius:999px;color:var(--muted);font:800 .9rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.25em}
  .transform{position:relative;display:grid;place-items:center;min-height:270px}.transform-line{position:absolute;left:-.25rem;right:-.25rem;top:50%;height:2px;background:var(--accent)}.transform-line::after{content:'';position:absolute;right:-2px;top:50%;border:7px solid transparent;border-left-color:var(--accent);transform:translateY(-50%)}.transform-card{position:relative;z-index:1;width:100%;padding:.9rem;border:1px solid var(--accent);border-radius:12px;background:var(--surface);text-align:center}.transform-card small,.transform-card>span{display:block}.transform-card small{color:var(--accent);font:800 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.transform-card>strong{display:block;margin:.25rem 0 .6rem;font-size:1rem}.transform-card code{display:block;padding:.48rem;border-radius:7px;background:var(--surface-muted);font-size:.68rem;overflow-wrap:anywhere}.transform-card>span{margin-top:.55rem;color:var(--muted);font-size:.68rem;line-height:1.45}
  .official-row{display:flex;justify-content:center;margin:-1.35rem 0 .75rem}.official-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.27rem .56rem .27rem .32rem;border:1px solid color-mix(in srgb,#1677ff 75%,black);border-radius:999px;background:color-mix(in srgb,#1677ff 10%,var(--surface));box-shadow:0 4px 14px color-mix(in srgb,#1677ff 16%,transparent)}.official-badge b{color:#1467d2;font-size:.62rem;line-height:1.2}.official-mark{display:grid;place-items:center;width:21px;height:21px;clip-path:polygon(50% 0,63% 9%,79% 7%,88% 21%,100% 30%,96% 47%,100% 63%,87% 74%,81% 91%,64% 91%,50% 100%,36% 91%,19% 91%,13% 74%,0 63%,4% 47%,0 30%,12% 21%,21% 7%,37% 9%);background:#1677ff;color:#fff;font:900 .7rem/1 system-ui,sans-serif}.official-link{display:inline-block;margin-top:.7rem;color:#1467d2;font-size:.68rem;font-weight:800;text-underline-offset:3px}.official-link:hover{text-decoration-thickness:2px}
  .evidence{grid-column:1/-1;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.evidence summary{cursor:pointer;padding:.85rem 1rem;font-weight:var(--type-weight-heading);font-size:var(--type-meta)}.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;padding:0 1rem 1rem}.evidence-grid article{padding:.8rem;border:1px solid var(--line);border-radius:8px;background:var(--surface-muted)}.evidence-grid small{display:block;color:var(--muted);font:800 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.evidence-grid code{display:block;margin:.45rem 0;padding:.5rem;border-radius:6px;background:var(--surface);font-size:var(--type-meta);overflow-wrap:anywhere}.evidence-grid p{margin:0;color:var(--muted);font-size:var(--type-body-small);line-height:var(--type-leading-body)}.evidence-grid a{display:inline-block;margin-top:.55rem;color:#1467d2;font-size:var(--type-meta);font-weight:var(--type-weight-heading)}
  .world-story figcaption{grid-column:1/-1;margin:0;padding:.85rem 1rem;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent) 5%,var(--surface));color:var(--muted);font-size:var(--type-caption);line-height:var(--type-leading-caption)}
  @media(max-width:800px){.world-story{grid-template-columns:1fr}.transform{min-height:160px}.transform-line{left:50%;right:auto;top:-.2rem;bottom:-.2rem;width:2px;height:auto;transform:translateX(-50%)}.transform-line::after{right:auto;left:50%;top:auto;bottom:-8px;transform:translateX(-50%);border:7px solid transparent;border-top-color:var(--accent)}.evidence-grid{grid-template-columns:1fr}.webshop-small-world{width:min(100% - 1rem,1120px);padding:1rem}.official-row{margin:-1.1rem 0 .65rem}}

@container article-figure (max-width:800px){.world-story{grid-template-columns:1fr}.transform{min-height:160px}.transform-line{left:50%;right:auto;top:-.2rem;bottom:-.2rem;width:2px;height:auto;transform:translateX(-50%)}.transform-line::after{right:auto;left:50%;top:auto;bottom:-8px;transform:translateX(-50%);border:7px solid transparent;border-top-color:var(--accent)}.evidence-grid{grid-template-columns:1fr}.webshop-small-world{width:min(100% - 1rem,1120px);padding:1rem}.official-row{margin:-1.1rem 0 .65rem}}
</style>
