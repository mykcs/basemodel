---
import {
  ADVISOR_Q03_CUSTOM_PANEL,
  ADVISOR_Q04_CAPACITY,
  ADVISOR_Q05_FROZEN,
} from '../../data/openEvoAdvisorTenQuestions';
import q01Csv from '../../data/research-evidence/advisor-q01-three-way-curve.csv?raw';
import ExternalBrandMark from '../common/ExternalBrandMark';

type Variant = 'q01' | 'q02' | 'q03' | 'q04' | 'q05' | 'q07';
interface Props { variant: Variant }
const { variant } = Astro.props;
// This committed CSV has the exact same Git blob SHA as PR #628's sealed science output.
// Only existing, fixed held-out checkpoint scores are read. No evaluation runs here.
const q01CurveHref = 'https://github.com/mykcs/openevo-experiment/blob/48e1368c7afc260a1745a49e6c7c173bfbb172b2/docs/evidence/advisor-q01-horizon-plateau-20261001/three-way-curve.csv';
const q01ResultHref = 'https://github.com/mykcs/openevo-experiment/blob/48e1368c7afc260a1745a49e6c7c173bfbb172b2/docs/evidence/advisor-q01-horizon-plateau-20261001/Q01_THREE_WAY_RESULT.json';

const q01Data = q01Csv.trim().split('\n').slice(1).map((line) => {
  const columns = line.split(',');
  return { key: columns[0] ?? '', round: Number(columns[2]), actualUpdates: Number(columns[3]), score: Number(columns[4])*100, exact: Number(columns[5]) };
});
const q01Specs = [
  { key:'ordinary_openevo',name:'普通 OpenEVO',takeaway:'第 120 次更新约 60.40 分，第 160 次约 60.11 分；额外训练没有带来明显增分。' },
  { key:'bounded_state',name:'Bounded',takeaway:'第 120 轮约 58.72 分，到第 150 轮约 67.25 分；后段仍有收益。' },
  { key:'delta_beta_family',name:'历史 β/GDR',takeaway:'第 130 轮约 58.16 分，到第 160 轮约 45.24 分；后段下降约 12.93 分。' },
] as const;
const q01Series = q01Specs.map((spec)=>({ ...spec,values:q01Data.filter((item)=>item.key===spec.key) }));
const q01Rounds = q01Series[0]?.values.map((item)=>item.round) ?? [];
if(q01Data.length !== 33 || q01Series.some((series)=>series.values.length!==11 || series.values.some((point,index)=>point.round!==q01Rounds[index] || !Number.isFinite(point.score)))){
  throw new Error('Q01 frozen curve has unexpected source coverage');
}
const q01X = (round:number) => 63 + (round-1)/159*650;
const q01Y = (score:number) => 28 + (100-score)*2.22;
const q01PhoneX = (round:number) => 32 + (round-1)/159*294;
const q01PhoneY = (score:number) => 21 + (100-score)*1.68;
const earlySft = [
  { name: 'SFT · 1 遍', score: 35.53 },
  { name: 'SFT · 2 遍', score: 28.30 },
  { name: 'SFT · 3 遍', score: 24.10 },
];
const notes = [
  'A0 · 3.71 分。旧 Stage1 起点；64 题中没有完整成功。',
  'A40 · 6.43 分。相对 A0 提高约 2.72 分，但尚不能说明稳定改善。',
  'A80 · 0.69 分。相对 A40 下降约 5.74 分；只看 A40 会遗漏这一反转。',
  'A120 · 6.62 分。再次回升约 5.93 分，仍是 0/64 个任务完整成功。',
];
const checkpoints = ADVISOR_Q03_CUSTOM_PANEL.map((point, index) => ({
  ...point,
  x: 88 + index * 156,
  y: 225 - Number(point.score) * 17,
  note: notes[index],
}));
const points = checkpoints.map((point) => String(point.x) + ',' + String(point.y)).join(' ');
const scorePct = (value: string) => Math.min(100, Math.max(0, Number(value))) + '%';
const effectX = (value: number) => 80 + (value + 20) * 18;
---
{variant === 'q01' && (
  <figure class="advisor-viz advisor-viz--q01" data-report-figure="q01-horizon" data-evidence-shape="measured-score-curves" data-paper-figure="true">
    <header class="advisor-viz__heading">
      <strong>训练进度与 WebShop Task Score</strong>
      <span>冻结 64 题 · 每种方法 11 个实际保存点</span>
    </header>
    <div class="advisor-viz__q01-legend" role="group" aria-label="三种方法的线型和点形图例">
      {q01Series.map((item) => (
        <span class={'advisor-viz__q01-legend-item advisor-viz__q01-series--'+item.key}>
          <svg viewBox="0 0 34 14" focusable="false" aria-hidden="true">
            <line class="advisor-viz__q01-curve" x1="2" x2="32" y1="7" y2="7" />
            {item.key === 'ordinary_openevo'
              ? <circle class="advisor-viz__q01-point" cx="17" cy="7" r="3" />
              : item.key === 'bounded_state'
                ? <rect class="advisor-viz__q01-point" x="14" y="4" width="6" height="6" />
                : <polygon class="advisor-viz__q01-point" points="17,3 20.6,10 13.4,10" />}
          </svg>
          <span>{item.name}</span>
        </span>
      ))}
    </div>
    <svg class="advisor-viz__q01-chart advisor-viz__q01-chart--desktop" viewBox="0 0 740 310" role="img" aria-labelledby="advisor-q01-chart-title advisor-q01-chart-desc">
      <title id="advisor-q01-chart-title">三种方法的真实开发集任务成绩随训练进度变化</title>
      <desc id="advisor-q01-chart-desc">每条曲线来自十一个已有检查点，同一组六十四道开发题。普通 OpenEVO 大约在第一百二十次参数更新后进入实用平台；Bounded 在第一百五十轮附近进入平台；历史复杂 beta GDR 在第一百三十轮之后明显下降。纵轴是零到一百的 Task Score。</desc>
      {[0,25,50,75,100].map((tick) => (
        <g>
          {tick > 0 && tick < 100 && <line class="advisor-viz__q01-grid" x1="63" x2="713" y1={q01Y(tick)} y2={q01Y(tick)} />}
          <text class="advisor-viz__q01-axis" x="52" y={q01Y(tick)+4} text-anchor="end">{tick}</text>
        </g>
      ))}
      <path class="advisor-viz__q01-axes" d="M63 28 V250 H713" />
      {[1,40,80,120,160].map((tick) => (
        <g>
          <line class="advisor-viz__q01-tick" x1={q01X(tick)} x2={q01X(tick)} y1="250" y2="254" />
          <text class="advisor-viz__q01-axis" x={q01X(tick)} y="273" text-anchor="middle">{tick}</text>
        </g>
      ))}
      {q01Series.map((item) => (
        <g class={'advisor-viz__q01-series advisor-viz__q01-series--'+item.key} data-q01-line={item.key}>
          <polyline class="advisor-viz__q01-curve" points={item.values.map((v) => q01X(v.round)+','+q01Y(v.score)).join(' ')} />
          {item.values.map((v) => (
            item.key === 'ordinary_openevo'
              ? <circle class="advisor-viz__q01-point" cx={q01X(v.round)} cy={q01Y(v.score)} r="3" />
              : item.key === 'bounded_state'
                ? <rect class="advisor-viz__q01-point" x={q01X(v.round)-2.8} y={q01Y(v.score)-2.8} width="5.6" height="5.6" />
                : <polygon class="advisor-viz__q01-point" points={[q01X(v.round)+','+(q01Y(v.score)-3.5),(q01X(v.round)+3.6)+','+(q01Y(v.score)+3),(q01X(v.round)-3.6)+','+(q01Y(v.score)+3)].join(' ')} />
          ))}
        </g>
      ))}
      <text class="advisor-viz__q01-axis advisor-viz__q01-axis-label" x="63" y="15">Task Score / 100</text>
      <text class="advisor-viz__q01-axis advisor-viz__q01-axis-label" x="713" y="301" text-anchor="end">已完成的训练轮数 / 更新数</text>
    </svg>
    <svg class="advisor-viz__q01-chart advisor-viz__q01-chart--phone" viewBox="0 0 340 232" role="img" aria-labelledby="advisor-q01-phone-title advisor-q01-phone-desc">
      <title id="advisor-q01-phone-title">三条方法的真实训练成绩变化，手机视图</title>
      <desc id="advisor-q01-phone-desc">三组十一点开发集成绩曲线。普通 OpenEVO 在一百二十次更新后已基本达到平台，Bounded 到一百五十轮仍增长，历史 beta GDR 一百三十轮后下降。</desc>
      {[0,25,50,75,100].map((tick) => (
        <g>
          {tick > 0 && tick < 100 && <line class="advisor-viz__q01-grid" x1="32" x2="326" y1={q01PhoneY(tick)} y2={q01PhoneY(tick)} />}
          <text class="advisor-viz__q01-axis" x="26" y={q01PhoneY(tick)+4} text-anchor="end">{tick}</text>
        </g>
      ))}
      <path class="advisor-viz__q01-axes" d="M32 21 V189 H326" />
      {[1,80,120,160].map((tick) => (
        <g>
          <line class="advisor-viz__q01-tick" x1={q01PhoneX(tick)} x2={q01PhoneX(tick)} y1="189" y2="193" />
          <text class="advisor-viz__q01-axis" x={q01PhoneX(tick)} y="208" text-anchor="middle">{tick}</text>
        </g>
      ))}
      {q01Series.map((item) => (
        <g class={'advisor-viz__q01-series advisor-viz__q01-series--'+item.key} data-q01-phone-line={item.key}>
          <polyline class="advisor-viz__q01-curve" points={item.values.map((v) => q01PhoneX(v.round)+','+q01PhoneY(v.score)).join(' ')} />
          {item.values.map((v) => (
            item.key === 'ordinary_openevo'
              ? <circle class="advisor-viz__q01-point" cx={q01PhoneX(v.round)} cy={q01PhoneY(v.score)} r="2.7" />
              : item.key === 'bounded_state'
                ? <rect class="advisor-viz__q01-point" x={q01PhoneX(v.round)-2.6} y={q01PhoneY(v.score)-2.6} width="5.2" height="5.2" />
                : <polygon class="advisor-viz__q01-point" points={[q01PhoneX(v.round)+','+(q01PhoneY(v.score)-3.1),(q01PhoneX(v.round)+3.2)+','+(q01PhoneY(v.score)+2.9),(q01PhoneX(v.round)-3.2)+','+(q01PhoneY(v.score)+2.9)].join(' ')} />
          ))}
        </g>
      ))}
      <text class="advisor-viz__q01-axis advisor-viz__q01-axis-label" x="33" y="12">Task Score / 100</text>
      <text class="advisor-viz__q01-axis advisor-viz__q01-axis-label" x="326" y="227" text-anchor="end">轮次 / 更新数</text>
    </svg>
    <figcaption><strong>图 1.</strong> 三种参数更新方法在同一冻结 64 题上的 Task Score（满分 100）。每条曲线包含 11 个真实保存点，线段只连接已测点。普通 OpenEVO 横轴为已完成的参数更新次数；Bounded 和历史 β/GDR 横轴为已完成的 Stage2 轮数，后两组含少数未实际更新参数的轮次。</figcaption>
    <div class="advisor-viz__q01-reading">
      {q01Series.map((item) => <p><strong>{item.name}：</strong>{item.takeaway}</p>)}
    </div>
    <p class="advisor-viz__q01-source">数据与规则：<a href={q01CurveHref} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={q01CurveHref} />11 个保存点的原始 CSV ↗</a> · <a href={q01ResultHref} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={q01ResultHref} />平台判据及原始结论 ↗</a></p>
    <details class="advisor-viz__details">
      <summary>实用平台如何判断？各保存点是多少分？</summary>
      <p>这次研究使用了预先确定的实用平台判据：找到最早一个已测保存点，此后所有已测保存点的平均 Task Score 均未比它提高超过 2 分，完整成功数也未增加超过 2/64。这是开发集上的保存点选择证据。</p>
      <div class="advisor-viz__table research-booktabs-wrap" tabindex="0">
        <table class="research-booktabs" data-q01-measured-table>
          <caption>同一冻结 64 题；Task Score / 100（仅列出已实际测量的保存点）</caption>
          <thead><tr><th scope="col">轮次或更新数</th><th scope="col" data-numeric>普通 OpenEVO</th><th scope="col" data-numeric>Bounded</th><th scope="col" data-numeric>历史 β/GDR</th></tr></thead>
          <tbody>
            {q01Rounds.map((round) => (
              <tr>
                <th scope="row">{round}</th>
                {q01Series.map((item) => (
                  <td data-numeric>{item.values.find((row) => row.round===round)?.score.toFixed(2)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </figure>
)}
{variant === 'q02' && (
  <figure class="advisor-viz" data-report-visual="q02-early-sft" data-evidence-shape="single-method-bar">
    <header class="advisor-viz__heading"><strong>早期 SFT：增加训练遍数后开发得分下降</strong><span>Task Score / 100</span></header>
    <div class="advisor-viz__bars">
      {earlySft.map((item) => (
        <div class="advisor-viz__bar-row">
          <span class="advisor-viz__name">{item.name}</span>
          <div class="advisor-viz__bar" aria-hidden="true"><i style={'width:' + item.score + '%'}></i></div>
          <strong class="advisor-viz__value">{item.score.toFixed(2)}</strong>
        </div>
      ))}
    </div>
    <figcaption>图中展示早期 SFT 单路线在开发集上训练 1、2、3 遍后的实测分数。另一次 3 个随机设置 × SFT/OPSD 的六格训练已完成，对应配对能力评测仍待封存。</figcaption>
  </figure>
)}
{variant === 'q03' && (
  <figure class="advisor-viz" data-report-figure="q03-custom-curve" data-evidence-shape="four-measured-points" data-protocol="custom-q17-64">
    <header class="advisor-viz__heading"><strong>Q03 · 四次实际测量的 Task Score</strong><span>同一自定义 64 题 · 满分 100</span></header>
    <svg class="advisor-viz__trend" viewBox="0 0 625 285" role="img" aria-labelledby="advisor-q03-title advisor-q03-description">
      <title id="advisor-q03-title">Q03 Stage2 的成绩先上升、再下降、再上升</title>
      <desc id="advisor-q03-description">四个真实保存点：A0 为3.71分，A40为6.43分，A80为0.69分，A120为6.62分；纵轴局部显示零至十分，实际满分一百分，中间轮次未测。</desc>
      {[0, 5, 10].map((tick) => (
        <g><line class="advisor-viz__grid" x1="73" x2="592" y1={225 - tick * 17} y2={225 - tick * 17} />
          <text class="advisor-viz__axis" x="57" y={230 - tick * 17} text-anchor="end">{tick}</text></g>
      ))}
      <polyline class="advisor-viz__polyline" points={points} />
      {checkpoints.map((point, i) => (
        <g data-trend-point={point.update} class:list={{ 'is-active': i === 0 }}>
          <circle class="advisor-viz__halo" cx={point.x} cy={point.y} r="10" />
          <circle class="advisor-viz__point" cx={point.x} cy={point.y} r="5.6" />
          <text class="advisor-viz__number" x={point.x} y={point.y - 17} text-anchor="middle">{point.score}</text>
          <text class="advisor-viz__axis" x={point.x} y="264" text-anchor="middle">{point.update}</text>
        </g>
      ))}
    </svg>
    <p class="advisor-viz__zoom"><strong>纵轴局部放大为 0–10 分</strong>（实际满分 100）。只画四个真实采样点；连线仅表示测量先后，并不代表中间轮次有对应成绩。</p>
    <div class="advisor-viz__steps" data-q03-stage-selector aria-label="查看指定保存点">
      {checkpoints.map((point, i) => (
        <button type="button" data-stage={point.update} data-detail={point.note} aria-pressed={i === 0 ? 'true' : 'false'}>{point.update}</button>
      ))}
    </div>
    <p class="advisor-viz__stage-note" data-stage-detail role="status" aria-live="polite">{checkpoints[0]?.note ?? ''}</p>
    <figcaption>同一自定义 64 题上的四次保存点完整成功均为 0/64。曲线只连接这组可同口径的实测分数；紧接本图的正文说明 SEED 论文原生 128 题与本地协议之间的差异。</figcaption>
    <details class="advisor-viz__details"><summary>查看四个保存点的完整数字</summary>
      <div class="advisor-viz__table research-booktabs-wrap" tabindex="0"><table class="research-booktabs">
        <caption>混合 SEED Q03 · 自定义 64 题上的测量点</caption>
        <thead><tr><th scope="col">Stage2 保存点</th><th scope="col" data-numeric>Task Score / 100</th><th scope="col" data-numeric>完整成功</th><th scope="col">观察</th></tr></thead>
        <tbody>{ADVISOR_Q03_CUSTOM_PANEL.map((point) => (
          <tr><th scope="row">{point.update}</th><td data-numeric>{point.score}</td><td data-numeric>{point.exact}</td><td>{point.note}</td></tr>
        ))}</tbody>
      </table></div>
    </details>
  </figure>
)}
{variant === 'q04' && (
  <figure class="advisor-viz" data-report-figure="q04-capacity" data-evidence-shape="paired-paper-table">
    <div class="advisor-viz__table research-booktabs-wrap" tabindex="0" aria-label="长期状态容量和 WebShop 得分对照表">
      <table class="research-booktabs">
        <caption>表 2｜固定容量与后段任务表现</caption>
        <thead>
          <tr>
            <th scope="col">长期参数状态</th>
            <th scope="col" data-numeric>参数文件（MB）</th>
            <th scope="col" data-numeric>Task Score / 100</th>
            <th scope="col" data-numeric>完整成功率</th>
          </tr>
        </thead>
        <tbody>
          {ADVISOR_Q04_CAPACITY.map((item) => (
            <tr>
              <th scope="row">{item.method}</th>
              <td data-numeric>{item.bytes.replace(' MB', '')}</td>
              <td data-numeric>{item.score}</td>
              <td data-numeric>{item.exact}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <figcaption>两种容量使用第 152–159 轮的 1,024 组同任务、同随机条件配对尝试；参数文件大小测于第 159 轮末。表中的得分和成功率均来自该后段窗口。</figcaption>
  </figure>
)}
{variant === 'q05' && (
  <figure class="advisor-viz" data-report-figure="q05-same-final" data-evidence-shape="matched-panel-bars">
    <header class="advisor-viz__heading"><strong>三条历史路线的冻结终评</strong><span>同一 128 题 · Task Score / 100</span></header>
    <div class="advisor-viz__bars">
      {ADVISOR_Q05_FROZEN.map((item) => (
        <div class="advisor-viz__bar-row">
          <span class="advisor-viz__name">{item.method.replace(" / DirectApply", "")}</span>
          <div class="advisor-viz__bar" aria-hidden="true"><i style={'width:' + scorePct(item.score)}></i></div>
          <strong class="advisor-viz__value">{item.score}</strong>
        </div>
      ))}
    </div>
    <figcaption>三组最终模型接受同一冻结 128 题的评测，表格显示其任务能力差异。普通 OpenEVO 属于较早的历史前驱；归因到具体算法机制，需要进一步对齐训练起点与执行条件。</figcaption>
    <details class="advisor-viz__details"><summary>查看完整成功数</summary>
      <div class="advisor-viz__table research-booktabs-wrap" tabindex="0"><table class="research-booktabs">
        <caption>三条路线的历史冻结 128 题终评</caption>
        <thead><tr><th scope="col">路线</th><th scope="col" data-numeric>Task Score / 100</th><th scope="col" data-numeric>完整成功</th></tr></thead>
        <tbody>{ADVISOR_Q05_FROZEN.map((item) => <tr><th scope="row">{item.method.replace(" / DirectApply", "")}</th><td data-numeric>{item.score}</td><td data-numeric>{item.exact}</td></tr>)}</tbody>
      </table></div>
    </details>
  </figure>
)}
{variant === 'q07' && (
  <figure class="advisor-viz" data-report-visual="q07-confidence-interval" data-evidence-shape="confidence-interval">
    <header class="advisor-viz__heading"><strong>反转第 156 轮更新方向后，分数下降</strong><span>配对 Task Score 变化 · 百分制</span></header>
    <p class="advisor-viz__interval-summary"><strong>−10.06 分</strong><span>95% 配对置信区间：−15.02 至 −5.60 分</span></p>
    <svg class="advisor-viz__trend advisor-viz__trend--ci" viewBox="0 0 625 126" role="img" aria-labelledby="advisor-q07-title advisor-q07-desc">
      <title id="advisor-q07-title">第 156 轮反转更新方向，Task Score 配对差异为负</title>
      <desc id="advisor-q07-desc">平均下降 10.06 分；95%区间为下降 15.02 到 5.60 分。区间全部位于零点左侧。</desc>
      <line class="advisor-viz__baseline" x1={effectX(-20)} x2={effectX(5)} y1="67" y2="67"/>
      {[-20,-10,0].map((v) => <g><line class="advisor-viz__grid" x1={effectX(v)} x2={effectX(v)} y1="25" y2="90"/>
        <text class="advisor-viz__axis" x={effectX(v)} y="114" text-anchor="middle">{v}</text></g>)}
      <line class="advisor-viz__ci" x1={effectX(-15.02)} x2={effectX(-5.60)} y1="67" y2="67"/>
      <line class="advisor-viz__cap" x1={effectX(-15.02)} x2={effectX(-15.02)} y1="58" y2="76"/>
      <line class="advisor-viz__cap" x1={effectX(-5.60)} x2={effectX(-5.60)} y1="58" y2="76"/>
      <circle class="advisor-viz__ci-point" cx={effectX(-10.06)} cy="67" r="6"/>
    </svg>
    <figcaption>横轴 0 是无得分变化的参考点。第 156 轮反向干预的 95% 置信区间位于零点左侧，支持这次操作对任务表现的负向影响。要形成通用方向控制规则，还需要在其他轮次和独立任务流上重复测量。</figcaption>
  </figure>
)}
<style>
.advisor-viz{border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:1rem 0 .8rem;margin:1.4rem 0 1.7rem;max-width:930px;font-variant-numeric:tabular-nums lining-nums}
.advisor-viz__heading{display:flex;flex-wrap:wrap;gap:.2rem 1rem;justify-content:space-between;align-items:baseline;margin-bottom:1.05rem}
.advisor-viz__heading strong{font-size:1.05rem;line-height:1.5;font-weight:700}
.advisor-viz__heading span{font-size:.9rem;line-height:1.5;color:var(--color-text-muted)}
.advisor-viz figcaption{font-size:.91rem;line-height:1.75;color:var(--color-text-muted);margin:.8rem 0 .3rem;max-width:82ch}
.advisor-viz__rows,.advisor-viz__bars{display:grid;gap:.95rem}
.advisor-viz__item{display:grid;grid-template-columns:minmax(9rem,1fr) minmax(8rem,1.4fr) minmax(5rem,.6fr);gap:.3rem .9rem;align-items:center}
.advisor-viz__name{font-size:.91rem;line-height:1.55;font-weight:590;overflow-wrap:anywhere}
.advisor-viz__track{height:1.3rem;position:relative;border-bottom:1px solid var(--color-border);background:repeating-linear-gradient(to right,transparent,transparent calc(25% - 1px),var(--color-border) calc(25% - 1px),var(--color-border) 25%)}
.advisor-viz__marker{position:absolute;top:50%;transform:translate(-50%,-50%);width:.82rem;height:.82rem;border-radius:50%;background:var(--color-text)}
.advisor-viz__item small{grid-column:2/-1;font-size:.84rem;line-height:1.45;color:var(--color-text-muted)}
.advisor-viz__value{text-align:right;font-size:.95rem;font-weight:760;white-space:nowrap}
.advisor-viz__ticks{display:flex;justify-content:space-between;padding-left:36%;padding-right:5rem;margin:.85rem 0 0;color:var(--color-text-muted);font-size:.78rem}
.advisor-viz__bar-row{display:grid;grid-template-columns:minmax(9rem,1fr) minmax(6rem,1.4fr) 4.6rem;align-items:center;gap:.7rem}
.advisor-viz__bar{height:1.05rem;background:var(--color-border);overflow:hidden}
.advisor-viz__bar i{height:100%;background:var(--color-text);display:block;min-width:1px}




.advisor-viz__trend{display:block;width:100%;max-width:680px}
.advisor-viz__grid{stroke:var(--color-border);stroke-width:1}
.advisor-viz__axis{fill:var(--color-text-muted);font-size:14px}
.advisor-viz__polyline{fill:none;stroke:var(--color-text);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.advisor-viz__point{fill:var(--color-text)}
.advisor-viz__halo{fill:transparent;stroke:transparent}
[data-trend-point].is-active .advisor-viz__halo{stroke:var(--color-accent);stroke-width:2.2}
.advisor-viz__number{fill:var(--color-text);font-size:16px;font-weight:710}
.advisor-viz__zoom{margin:.35rem 0 .7rem;color:var(--color-text-muted);font-size:.9rem;line-height:1.65}
.advisor-viz__zoom strong{color:var(--color-text)}
.advisor-viz__steps{display:flex;flex-wrap:wrap;gap:.5rem;margin:.85rem 0 .35rem}
.advisor-viz__steps button{padding:.4rem .85rem;min-height:2.35rem;border:1px solid var(--color-border);background:transparent;color:var(--color-text);border-radius:0;font:inherit;font-size:.89rem;cursor:pointer}
.advisor-viz__steps button[aria-pressed=true]{color:var(--color-bg,#fff);background:var(--color-text);border-color:var(--color-text)}
.advisor-viz__steps button:focus-visible,.advisor-viz__details summary:focus-visible,.advisor-viz__table:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}
.advisor-viz__stage-note{font-size:.95rem;line-height:1.75;margin:.45rem 0}
.advisor-viz__details{margin:.85rem 0 .2rem}
.advisor-viz__details summary{cursor:pointer;text-decoration:underline;text-underline-offset:.18rem;padding:.35rem 0;font-size:.89rem}



.advisor-viz__interval-summary{display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:baseline;margin:0;line-height:1.7}
.advisor-viz__interval-summary strong{font-size:1.4rem}
.advisor-viz__interval-summary span{font-size:.9rem;color:var(--color-text-muted)}
.advisor-viz__trend--ci{max-width:630px}
.advisor-viz__baseline{stroke:var(--color-border);stroke-width:2}
.advisor-viz__ci,.advisor-viz__cap{stroke:var(--color-text);stroke-width:5;stroke-linecap:round}
.advisor-viz__cap{stroke-width:2}
.advisor-viz__ci-point{fill:var(--color-text)}

/* Q01 scientific figure: publication-oriented typesetting, vector geometry,
 * grayscale-safe line/marker combinations, and the same editorial voice as
 * the neighboring research-booktabs tables. No generated image assets.
 */
.advisor-viz--q01{max-width:800px;border:0;padding:0;margin:1.4rem 0 1.8rem;background:transparent;color:var(--color-text)}
.advisor-viz--q01 .advisor-viz__heading{margin-bottom:.6rem;gap:.1rem .8rem}
.advisor-viz--q01 .advisor-viz__heading strong{font:650 1rem/1.45 var(--font-editorial),Georgia,serif}
.advisor-viz--q01 .advisor-viz__heading span{font-size:.8rem;letter-spacing:0}
.advisor-viz__q01-legend{display:flex;flex-wrap:wrap;gap:.35rem 1.2rem;margin:.4rem 0 .25rem;font-family:var(--font-editorial),Georgia,serif;font-size:.82rem;line-height:1.55}
.advisor-viz__q01-legend-item{display:inline-flex;gap:.35rem;align-items:center;white-space:nowrap}
.advisor-viz__q01-legend-item svg{width:34px;height:14px;flex:0 0 34px;overflow:visible}
.advisor-viz__q01-chart{display:block;width:100%;max-width:740px;height:auto;margin:.25rem 0 .1rem;background:#fff;color:#29343b;font-family:Georgia,'Times New Roman','Songti SC','STSong',serif;font-variant-numeric:tabular-nums lining-nums}
.advisor-viz__q01-chart--phone{display:none}
.advisor-viz__q01-grid{stroke:#dededb;stroke-width:.7;stroke-linecap:butt}
.advisor-viz__q01-axes{stroke:#44494c;stroke-width:.95;fill:none}
.advisor-viz__q01-tick{stroke:#51575a;stroke-width:.85}
.advisor-viz__q01-axis{fill:#454b4e;font-size:12px;font-weight:400}
.advisor-viz__q01-axis-label{font-size:12.5px}
.advisor-viz__q01-curve{stroke:currentColor;stroke-width:1.85;stroke-linejoin:round;stroke-linecap:round;fill:none}
.advisor-viz__q01-point{stroke:currentColor;stroke-width:1.2;fill:#fff;stroke-linejoin:round}
.advisor-viz__q01-series--ordinary_openevo{color:#303a41}
.advisor-viz__q01-series--bounded_state{color:#57758a}
.advisor-viz__q01-series--delta_beta_family{color:#98655b}
.advisor-viz__q01-series--bounded_state .advisor-viz__q01-curve{stroke-dasharray:7 4}
.advisor-viz__q01-series--delta_beta_family .advisor-viz__q01-curve{stroke-dasharray:2.5 4}
.advisor-viz--q01 figcaption{max-width:80ch;margin:.55rem 0 .65rem;font:400 .87rem/1.63 var(--font-editorial),Georgia,serif;color:var(--color-text)}
.advisor-viz--q01 figcaption strong{font-weight:700}
.advisor-viz__q01-reading{display:grid;gap:.28rem;margin:.75rem 0 .65rem;max-width:80ch;font-size:.88rem}
.advisor-viz__q01-reading p{margin:0;line-height:1.65}
.advisor-viz__q01-reading strong{font-weight:650}
.advisor-viz__q01-source{margin:.3rem 0 .8rem;font-size:.84rem;line-height:1.65}
.advisor-viz__q01-source a{color:var(--color-text);text-underline-offset:.2rem}
.advisor-viz--q01 .advisor-viz__details{margin-top:.5rem}
@media(max-width:720px){
  .advisor-viz__q01-chart--desktop{display:none}
  .advisor-viz__q01-chart--phone{display:block;max-width:340px}
  .advisor-viz__q01-chart--phone .advisor-viz__q01-axis{font-size:11px}
  .advisor-viz__q01-chart--phone .advisor-viz__q01-axis-label{font-size:11.5px}
  .advisor-viz__q01-chart--phone .advisor-viz__q01-curve{stroke-width:1.6}
  .advisor-viz__q01-legend{gap:.3rem .8rem;font-size:.79rem}
}
@media(max-width:720px){

.advisor-viz__item{grid-template-columns:minmax(0,1fr) minmax(0,1.25fr) minmax(4.6rem,.5fr);gap:.4rem}
.advisor-viz__item small{grid-column:1/-1}
.advisor-viz__ticks{padding-left:0;padding-right:0}
.advisor-viz__bar-row{grid-template-columns:minmax(7rem,1fr) minmax(4rem,1.1fr) 4.4rem;gap:.4rem}
}
@media(max-width:430px){.advisor-viz__name{font-size:.84rem}.advisor-viz__bar-row{grid-template-columns:minmax(6.5rem,1fr) minmax(3rem,.9fr) 4.3rem}.advisor-viz__value{font-size:.84rem}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-report-figure="q03-custom-curve"]').forEach((figure) => {
  const buttons = [...figure.querySelectorAll<HTMLButtonElement>('[data-q03-stage-selector] button')];
  const output = figure.querySelector<HTMLElement>('[data-stage-detail]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
    figure.querySelectorAll<SVGGElement>('[data-trend-point]').forEach((dot) => {
      dot.classList.toggle('is-active', dot.dataset.trendPoint === button.dataset.stage);
    });
    if (output) output.textContent = button.dataset.detail || '';
  }));
});
</script>
