<style>
.advisor-viz{border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:1rem 0 .8rem;margin:1.4rem 0 1.7rem;max-width:930px;font-variant-numeric:tabular-nums lining-nums}
