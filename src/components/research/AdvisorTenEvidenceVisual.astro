---
import {
  ADVISOR_Q03_CUSTOM_PANEL,
  ADVISOR_Q04_CAPACITY,
  ADVISOR_Q05_FROZEN,
} from '../../data/openEvoAdvisorTenQuestions';
import q01Csv from '../../data/research-evidence/advisor-q01-three-way-curve.csv?raw';
import ExternalBrandMark from '../common/ExternalBrandMark';

type Variant = 'q01' | 'q02' | 'q03' | 'q04' | 'q05' | 'q07';
interface Props { variant: Variant }
const { variant } = Astro.props;
// This committed CSV has the exact same Git blob SHA as PR #628's sealed science output.
// Only existing, fixed held-out checkpoint scores are read. No evaluation runs here.
const q01CurveHref = 'https://github.com/mykcs/openevo-experiment/blob/48e1368c7afc260a1745a49e6c7c173bfbb172b2/docs/evidence/advisor-q01-horizon-plateau-20261001/three-way-curve.csv';
const q01ResultHref = 'https://github.com/mykcs/openevo-experiment/blob/48e1368c7afc260a1745a49e6c7c173bfbb172b2/docs/evidence/advisor-q01-horizon-plateau-20261001/Q01_THREE_WAY_RESULT.json';

const q01Data = q01Csv.trim().split('\n').slice(1).map((line) => {
  const columns = line.split(',');
  return { key: columns[0] ?? '', round: Number(columns[2]), actualUpdates: Number(columns[3]), score: Number(columns[4])*100, exact: Number(columns[5]) };
});
const q01Specs = [
  { key:'ordinary_openevo',name:'普通 OpenEVO',takeaway:'第 120 次更新约 60.40 分，第 160 次约 60.11 分；额外训练没有带来明显增分。' },
  { key:'bounded_state',name:'Bounded',takeaway:'第 120 轮约 58.72 分，到第 150 轮约 67.25 分；后段仍有收益。' },
  { key:'delta_beta_family',name:'历史 β/GDR',takeaway:'第 130 轮约 58.16 分，到第 160 轮约 45.24 分；后段下降约 12.93 分。' },
] as const;
const q01Series = q01Specs.map((spec)=>({ ...spec,values:q01Data.filter((item)=>item.key===spec.key) }));
const q01Rounds = q01Series[0]?.values.map((item)=>item.round) ?? [];
if(q01Data.length !== 33 || q01Series.some((series)=>series.values.length!==11 || series.values.some((point,index)=>point.round!==q01Rounds[index] || !Number.isFinite(point.score)))){
  throw new Error('Q01 frozen curve has unexpected source coverage');
}
const q01X = (round:number) => 63 + (round-1)/159*650;
const q01Y = (score:number) => 28 + (100-score)*2.22;
const q01PhoneX = (round:number) => 32 + (round-1)/159*294;
const q01PhoneY = (score:number) => 21 + (100-score)*1.68;
const earlySft = [
  { name: 'SFT · 1 遍', score: 35.53 },
  { name: 'SFT · 2 遍', score: 28.30 },
  { name: 'SFT · 3 遍', score: 24.10 },
];
// Q03: the four observed checkpoints are already sufficient for a static figure.
const checkpoints = ADVISOR_Q03_CUSTOM_PANEL.map((point, index) => ({
  ...point,
  x: 88 + index * 156,
  y: 225 - Number(point.score) * 17,
  xPhone: 50 + index * 90,
  yPhone: 185 - Number(point.score) * 13,
}));
const points = checkpoints.map((point) => String(point.x) + ',' + String(point.y)).join(' ');
const scorePct = (value: string) => Math.min(100, Math.max(0, Number(value))) + '%';
const effectX = (value: number) => 80 + (value + 20) * 18;
---
{variant === 'q01' && (
  <figure class="advisor-viz advisor-viz--q01" data-report-figure="q01-horizon" data-evidence-shape="measured-score-curves">
    <header class="advisor-viz__heading">
      <strong>训练 160 轮会不会太多了？</strong>
      <span>同一冻结 64 题 · 每种方法 11 个已测保存点</span>
    </header>
    <p class="advisor-viz__q01-lead">我们把模型在不同训练时点的购物成绩画出来，看后半段的学习有没有继续带来实际收益。</p>
    <div class="advisor-viz__q01-reading">
      {q01Series.map((item) => (
        <p>
          <span class={'advisor-viz__q01-key advisor-viz__q01-key--'+item.key} aria-hidden="true"></span>
          <strong>{item.name}：</strong>{item.takeaway}
        </p>
      ))}
    </div>
    <svg class="advisor-viz__q01-chart advisor-viz__q01-chart--desktop" viewBox="0 0 740 310" role="img" aria-labelledby="advisor-q01-chart-title advisor-q01-chart-desc">
      <title id="advisor-q01-chart-title">三种方法的真实开发集任务成绩随训练进度变化</title>
      <desc id="advisor-q01-chart-desc">每条曲线来自十一个已有检查点，同一组六十四道开发题。普通 OpenEVO 大约在第一百二十次参数更新后进入实用平台；Bounded 在第一百五十轮附近进入平台；历史复杂 beta GDR 在第一百三十轮之后明显下降。纵轴是零到一百的 Task Score。</desc>
      {[0,25,50,75,100].map((tick) => (
        <g>
          <line class="advisor-viz__q01-grid" x1="63" x2="713" y1={q01Y(tick)} y2={q01Y(tick)} />
          <text class="advisor-viz__q01-axis" x="52" y={q01Y(tick)+4} text-anchor="end">{tick}</text>
        </g>
      ))}
      {[1,40,80,120,160].map((tick) => (
        <text class="advisor-viz__q01-axis" x={q01X(tick)} y="280" text-anchor="middle">{tick}</text>
      ))}
      {q01Series.map((item) => (
        <g class={'advisor-viz__q01-series advisor-viz__q01-series--'+item.key} data-q01-line={item.key}>
          <polyline class="advisor-viz__q01-curve" points={item.values.map((v) => q01X(v.round)+','+q01Y(v.score)).join(' ')} />
          {item.values.map((v) => (
            <circle class="advisor-viz__q01-point" cx={q01X(v.round)} cy={q01Y(v.score)} r="3.6" />
          ))}
        </g>
      ))}
      <text class="advisor-viz__q01-axis" x="63" y="14">Task Score / 100</text>
      <text class="advisor-viz__q01-axis" x="713" y="301" text-anchor="end">已完成的训练轮数 / 更新数</text>
    </svg>
    <svg class="advisor-viz__q01-chart advisor-viz__q01-chart--phone" viewBox="0 0 340 232" role="img" aria-labelledby="advisor-q01-phone-title advisor-q01-phone-desc">
      <title id="advisor-q01-phone-title">三条方法的真实训练成绩变化，手机视图</title>
      <desc id="advisor-q01-phone-desc">三组十一点开发集成绩曲线。普通 OpenEVO 在一百二十次更新后已基本达到平台，Bounded 到一百五十轮仍增长，历史 beta GDR 一百三十轮后下降。</desc>
      {[0,25,50,75,100].map((tick) => (
        <g>
          <line class="advisor-viz__q01-grid" x1="32" x2="326" y1={q01PhoneY(tick)} y2={q01PhoneY(tick)} />
          <text class="advisor-viz__q01-axis" x="26" y={q01PhoneY(tick)+4} text-anchor="end">{tick}</text>
        </g>
      ))}
      {[1,80,120,160].map((tick) => (
        <text class="advisor-viz__q01-axis" x={q01PhoneX(tick)} y="214" text-anchor="middle">{tick}</text>
      ))}
      {q01Series.map((item) => (
        <g class={'advisor-viz__q01-series advisor-viz__q01-series--'+item.key} data-q01-phone-line={item.key}>
          <polyline class="advisor-viz__q01-curve" points={item.values.map((v) => q01PhoneX(v.round)+','+q01PhoneY(v.score)).join(' ')} />
          {item.values.map((v) => (
            <circle class="advisor-viz__q01-point" cx={q01PhoneX(v.round)} cy={q01PhoneY(v.score)} r="2.6" />
          ))}
        </g>
      ))}
      <text class="advisor-viz__q01-axis" x="33" y="12">Task Score / 100</text>
      <text class="advisor-viz__q01-axis" x="326" y="230" text-anchor="end">轮次 / 更新数</text>
    </svg>
    <figcaption>图 1｜同一冻结 64 题上的 Task Score 变化（满分 100）。三种方法各有 11 个真实测量点，连线帮助观察成绩走势。横轴对普通 OpenEVO 表示参数更新次数，对 Bounded、历史 β/GDR 表示已完成的 Stage2 轮数；后两组有少量未更新参数的轮次。</figcaption>
    <p class="advisor-viz__q01-source">数据与规则：<a href={q01CurveHref} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={q01CurveHref} />11 点原始 CSV ↗</a> · <a href={q01ResultHref} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={q01ResultHref} />平台判据及原始结论 ↗</a></p>
    <details class="advisor-viz__details">
      <summary>实用平台如何判断？各保存点是多少分？</summary>
      <p>这次研究使用了预先确定的实用平台判据：找到最早一个已测保存点，此后所有已测保存点的平均 Task Score 均未比它提高超过 2 分，完整成功数也未增加超过 2/64。这是开发集上的保存点选择证据。</p>
      <div class="advisor-viz__table research-booktabs-wrap" tabindex="0">
        <table class="research-booktabs" data-q01-measured-table>
          <caption>同一冻结 64 题；Task Score / 100（仅列出已实际测量的保存点）</caption>
          <thead><tr><th scope="col">轮次或更新数</th><th scope="col" data-numeric>普通 OpenEVO</th><th scope="col" data-numeric>Bounded</th><th scope="col" data-numeric>历史 β/GDR</th></tr></thead>
          <tbody>
            {q01Rounds.map((round) => (
              <tr>
                <th scope="row">{round}</th>
                {q01Series.map((item) => (
                  <td data-numeric>{item.values.find((row) => row.round===round)?.score.toFixed(2)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </figure>
)}
{variant === 'q02' && (
  <figure class="advisor-viz" data-report-visual="q02-early-sft" data-evidence-shape="single-method-bar">
    <header class="advisor-viz__heading"><strong>早期 SFT：增加训练遍数后开发得分下降</strong><span>Task Score / 100</span></header>
    <div class="advisor-viz__bars">
      {earlySft.map((item) => (
        <div class="advisor-viz__bar-row">
          <span class="advisor-viz__name">{item.name}</span>
          <div class="advisor-viz__bar" aria-hidden="true"><i style={'width:' + item.score + '%'}></i></div>
          <strong class="advisor-viz__value">{item.score.toFixed(2)}</strong>
        </div>
      ))}
    </div>
    <figcaption>图中展示早期 SFT 单路线在开发集上训练 1、2、3 遍后的实测分数。另一次 3 个随机设置 × SFT/OPSD 的六格训练已完成，对应配对能力评测仍待封存。</figcaption>
  </figure>
)}
{variant === 'q03' && (
  <figure class="advisor-viz advisor-viz--q03" data-report-figure="q03-custom-curve" data-evidence-shape="paper-static-observations" data-protocol="custom-q17-64">
    <header class="advisor-viz__heading">
      <strong>Q03 · 四个保存点的 Task Score</strong>
      <span>自定义 64 题开发面板 · 0–100 分</span>
    </header>
    <svg class="advisor-viz__trend advisor-viz__q03-chart advisor-viz__q03-chart--desktop" data-q03-desktop-chart viewBox="0 0 625 285" role="img" aria-labelledby="advisor-q03-title advisor-q03-description">
      <title id="advisor-q03-title">Q03 四个已测 Stage2 保存点的成绩先升、再降、再回升</title>
      <desc id="advisor-q03-description">自定义 64 题，不是论文原生 128 题。A0: 3.71，A40: 6.43，A80: 0.69，A120: 6.62 分，满分 100。纵轴仅显示 0–10 分的局部范围，四个保存点完整成功均为 0/64，中间训练轮次没有被测量。</desc>
      <text class="advisor-viz__q03-axis-title" x="75" y="30">Task Score / 100</text>
      {[0, 5, 10].map((tick) => (
        <g>
          <line class="advisor-viz__q03-grid" x1="75" x2="587" y1={225 - tick * 17} y2={225 - tick * 17} />
          <text class="advisor-viz__axis" x="59" y={230 - tick * 17} text-anchor="end">{tick}</text>
        </g>
      ))}
      <line class="advisor-viz__q03-axis-line" x1="75" x2="75" y1="55" y2="225" />
      <line class="advisor-viz__q03-axis-line" x1="75" x2="587" y1="225" y2="225" />
      <polyline class="advisor-viz__q03-connector" points={points} />
      {checkpoints.map((point) => (
        <g data-trend-point={point.update}>
          <circle class="advisor-viz__q03-marker" cx={point.x} cy={point.y} r="4.8" />
          <text class="advisor-viz__q03-score" x={point.x} y={point.y - 15} text-anchor="middle">{point.score}</text>
          <text class="advisor-viz__axis" x={point.x} y="252" text-anchor="middle">{point.update}</text>
        </g>
      ))}
      <text class="advisor-viz__q03-axis-title" x="331" y="280" text-anchor="middle">Stage2 保存点</text>
    </svg>
    <svg class="advisor-viz__trend advisor-viz__q03-chart advisor-viz__q03-chart--phone" data-q03-mobile-chart viewBox="0 0 350 236" role="img" aria-labelledby="advisor-q03-phone-title advisor-q03-phone-description">
      <title id="advisor-q03-phone-title">Q03 四个真实保存点成绩先升、后降、再回升，手机视图</title>
      <desc id="advisor-q03-phone-description">自定义 64 题开发面板，A0 为 3.71，A40 为 6.43，A80 为 0.69，A120 为 6.62；纵轴局部放大到 0–10 分，完整满分为 100。虚线只是连接已测点，中间没有观测。</desc>
      <text class="advisor-viz__q03-axis-title" x="43" y="20">Task Score / 100</text>
      {[0,5,10].map((tick) => (
        <g>
          <line class="advisor-viz__q03-grid" x1="42" x2="335" y1={185-tick*13} y2={185-tick*13} />
          <text class="advisor-viz__axis" x="31" y={190-tick*13} text-anchor="end">{tick}</text>
        </g>
      ))}
      <line class="advisor-viz__q03-axis-line" x1="42" x2="42" y1="55" y2="185" />
      <line class="advisor-viz__q03-axis-line" x1="42" x2="335" y1="185" y2="185" />
      <polyline class="advisor-viz__q03-connector" points={checkpoints.map((point)=>point.xPhone+','+point.yPhone).join(' ')} />
      {checkpoints.map((point) => (
        <g data-trend-point-phone={point.update}>
          <circle class="advisor-viz__q03-marker" cx={point.xPhone} cy={point.yPhone} r="4.1" />
          <text class="advisor-viz__q03-score" x={point.xPhone} y={point.yPhone-13} text-anchor="middle">{point.score}</text>
          <text class="advisor-viz__axis" x={point.xPhone} y="210" text-anchor="middle">{point.update}</text>
        </g>
      ))}
      <text class="advisor-viz__q03-axis-title" x="187" y="231" text-anchor="middle">Stage2 保存点</text>
    </svg>
    <div class="advisor-viz__q03-phone-table research-booktabs-wrap" tabindex="0" aria-label="四个保存点的论文式数据表">
      <table class="research-booktabs">
        <caption>表 Q03｜四个真实保存点 · 自定义 64 题开发面板</caption>
        <thead><tr><th scope="col">保存点</th><th scope="col" data-numeric>得分 / 100</th><th scope="col" data-numeric>完整成功 / 64</th></tr></thead>
        <tbody>{ADVISOR_Q03_CUSTOM_PANEL.map((point) => (
          <tr><th scope="row">{point.update}</th><td data-numeric>{point.score}</td><td data-numeric>{point.exact.replace(' / ', '/')}</td></tr>
        ))}</tbody>
      </table>
    </div>
    <p class="advisor-viz__q03-reading">从 A0 的 <strong>3.71</strong> 分升至 A40 的 <strong>6.43</strong> 分，A80 降至 <strong>0.69</strong> 分，A120 回升至 <strong>6.62</strong> 分。四次完整成功均为 <strong>0/64</strong>。</p>
    <figcaption><strong>图 Q03｜历史 Q03 的四个测量点。</strong>纵轴局部放大至 0–10 分，实际满分 100；细虚线只连接已测点，<strong>没有测量中间轮次</strong>，不能据此推断连续训练曲线。它与公开 SEED 论文的 128 题成绩不属于同一评测协议。<a href="https://github.com/mykcs/openevo-experiment/pull/678" target="_blank" rel="noopener noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment/pull/678" />原始评测记录 ↗</a></figcaption>
  </figure>
)}
{variant === 'q04' && (
  <figure class="advisor-viz" data-report-figure="q04-capacity" data-evidence-shape="paired-paper-table">
    <div class="advisor-viz__table research-booktabs-wrap" tabindex="0" aria-label="长期状态容量和 WebShop 得分对照表">
      <table class="research-booktabs">
        <caption>表 2｜固定容量与后段任务表现</caption>
        <thead>
          <tr>
            <th scope="col">长期参数状态</th>
            <th scope="col" data-numeric>参数文件（MB）</th>
            <th scope="col" data-numeric>Task Score / 100</th>
            <th scope="col" data-numeric>完整成功率</th>
          </tr>
        </thead>
        <tbody>
          {ADVISOR_Q04_CAPACITY.map((item) => (
            <tr>
              <th scope="row">{item.method}</th>
              <td data-numeric>{item.bytes.replace(' MB', '')}</td>
              <td data-numeric>{item.score}</td>
              <td data-numeric>{item.exact}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <figcaption>两种容量使用第 152–159 轮的 1,024 组同任务、同随机条件配对尝试；参数文件大小测于第 159 轮末。表中的得分和成功率均来自该后段窗口。</figcaption>
  </figure>
)}
{variant === 'q05' && (
  <figure class="advisor-viz" data-report-figure="q05-same-final" data-evidence-shape="matched-panel-bars">
    <header class="advisor-viz__heading"><strong>三条历史路线的冻结终评</strong><span>同一 128 题 · Task Score / 100</span></header>
    <div class="advisor-viz__bars">
      {ADVISOR_Q05_FROZEN.map((item) => (
        <div class="advisor-viz__bar-row">
          <span class="advisor-viz__name">{item.method.replace(" / DirectApply", "")}</span>
          <div class="advisor-viz__bar" aria-hidden="true"><i style={'width:' + scorePct(item.score)}></i></div>
          <strong class="advisor-viz__value">{item.score}</strong>
        </div>
      ))}
    </div>
    <figcaption>三组最终模型接受同一冻结 128 题的评测，表格显示其任务能力差异。普通 OpenEVO 属于较早的历史前驱；归因到具体算法机制，需要进一步对齐训练起点与执行条件。</figcaption>
    <details class="advisor-viz__details"><summary>查看完整成功数</summary>
      <div class="advisor-viz__table research-booktabs-wrap" tabindex="0"><table class="research-booktabs">
        <caption>三条路线的历史冻结 128 题终评</caption>
        <thead><tr><th scope="col">路线</th><th scope="col" data-numeric>Task Score / 100</th><th scope="col" data-numeric>完整成功</th></tr></thead>
        <tbody>{ADVISOR_Q05_FROZEN.map((item) => <tr><th scope="row">{item.method.replace(" / DirectApply", "")}</th><td data-numeric>{item.score}</td><td data-numeric>{item.exact}</td></tr>)}</tbody>
      </table></div>
    </details>
  </figure>
)}
{variant === 'q07' && (
  <figure class="advisor-viz" data-report-visual="q07-confidence-interval" data-evidence-shape="confidence-interval">
    <header class="advisor-viz__heading"><strong>反转第 156 轮更新方向后，分数下降</strong><span>配对 Task Score 变化 · 百分制</span></header>
    <p class="advisor-viz__interval-summary"><strong>−10.06 分</strong><span>95% 配对置信区间：−15.02 至 −5.60 分</span></p>
    <svg class="advisor-viz__trend advisor-viz__trend--ci" viewBox="0 0 625 126" role="img" aria-labelledby="advisor-q07-title advisor-q07-desc">
      <title id="advisor-q07-title">第 156 轮反转更新方向，Task Score 配对差异为负</title>
      <desc id="advisor-q07-desc">平均下降 10.06 分；95%区间为下降 15.02 到 5.60 分。区间全部位于零点左侧。</desc>
      <line class="advisor-viz__baseline" x1={effectX(-20)} x2={effectX(5)} y1="67" y2="67"/>
      {[-20,-10,0].map((v) => <g><line class="advisor-viz__grid" x1={effectX(v)} x2={effectX(v)} y1="25" y2="90"/>
        <text class="advisor-viz__axis" x={effectX(v)} y="114" text-anchor="middle">{v}</text></g>)}
      <line class="advisor-viz__ci" x1={effectX(-15.02)} x2={effectX(-5.60)} y1="67" y2="67"/>
      <line class="advisor-viz__cap" x1={effectX(-15.02)} x2={effectX(-15.02)} y1="58" y2="76"/>
      <line class="advisor-viz__cap" x1={effectX(-5.60)} x2={effectX(-5.60)} y1="58" y2="76"/>
      <circle class="advisor-viz__ci-point" cx={effectX(-10.06)} cy="67" r="6"/>
    </svg>
    <figcaption>横轴 0 是无得分变化的参考点。第 156 轮反向干预的 95% 置信区间位于零点左侧，支持这次操作对任务表现的负向影响。要形成通用方向控制规则，还需要在其他轮次和独立任务流上重复测量。</figcaption>
  </figure>
)}
<style>
