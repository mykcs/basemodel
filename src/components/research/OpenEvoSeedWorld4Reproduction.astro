---
import '../../styles/openevo-seed-world4-repro.css';
import ExternalBrandMark from '../common/ExternalBrandMark';

const source = {
  upstream: 'https://arxiv.org/pdf/2607.14777',
  source: 'https://github.com/jinyangwu/SEED',
  experiment: 'https://github.com/mykcs/openevo-experiment/pull/677',
  recovery: 'https://github.com/mykcs/openevo-experiment/pull/704',
  findings: 'https://github.com/mykcs/openevo-experiment/pull/704#issuecomment-6170762809',
  offline: 'https://github.com/mykcs/openevo-experiment/blob/research/seed-minimax-gpu2345-20261014/docs/evidence/seed-public-repro-minimax-20261007/PR704_GEOMETRY3K_OFFLINE_CPU_PREFLIGHT_20261014.md',
  qualification: 'https://github.com/mykcs/openevo-experiment/blob/research/seed-minimax-gpu2345-20261014/docs/evidence/seed-public-repro-minimax-20261007/PR704_WORLD4_OFFLINE_STAGE2_LIVE_20261014.md',
};

const paperPath = [
  { place: 'gpu', label: 'GPU 前向', explanation: '计算并保存反向传播所需的状态' },
  { place: 'gpu', label: 'GPU 反向', explanation: '计算梯度' },
  { place: 'update', label: '更新参数', explanation: '优化器写入新权重' },
];

const engineeringPath = [
  { place: 'gpu', label: 'GPU 前向', explanation: '产生中间张量' },
  { place: 'cpu', label: '搬到 CPU', explanation: '显存暂时释放部分张量' },
  { place: 'cpu', label: 'CPU 压缩', explanation: '按 4 MiB 分块运行 zlib' },
  { place: 'cpu', label: 'CPU 解压', explanation: '反向传播需要张量时还原' },
  { place: 'gpu', label: '搬回 GPU', explanation: '恢复原始形状和数值' },
  { place: 'gpu', label: 'GPU 反向', explanation: '仍须容纳梯度与中间状态' },
];

const efforts = [
  {
    title: '已有数据，先恢复可重复的输入',
    description: '保持原有 Stage1 资产不变。验证 Geometry3K 的本地缓存，断网预处理成功生成工程测试所需的训练与验证文件；没有重新请求 MiniMax。',
    conclusion: '排除了这一次 Stage2 的网络下载障碍。',
  },
  {
    title: '修复运行环境与源码身份',
    description: '最初的 Git worktree 无法在容器内解析父级元数据；改用固定提交的完整 Git 检出，核对代码、容器入口和四张 GPU 的 UUID。',
    conclusion: '容器可以核验实际运行的源码版本。',
  },
  {
    title: '四卡完成基础训练检查',
    description: '四卡合成数据 SFT 工程测试完成 3 个小步骤并导出模型。Stage2 随后完成模型加载、CUDA Graph 捕获、轨迹生成和分析数据落盘。',
    conclusion: '这些是工程资格证据，不等同于正式数据上的三遍 SFT。',
  },
  {
    title: '找到了真正中断的位置',
    description: 'Stage2 v3 和 v4 均进入原生训练，在 loss.backward() 处显存不足。两次都没有完成可验收的优化器更新或原生四卡 checkpoint。',
    conclusion: '推理能运行，不代表完整反向传播也能运行。',
  },
  {
    title: '检查 GPU 异常读数与资源安排',
    description: 'GPU 4、5 曾出现显存约 2 MiB、利用率却为 100% 的异常读数。单卡 CUDA 测试通过后恢复到空闲；未重置 GPU。还核对了 GPU 2/3 与 4/5 分属两个 NUMA 节点。',
    conclusion: '跨 NUMA 带来的额外传输成本仍需定量测量。',
  },
  {
    title: '缩小推理显存预留，再次验证',
    description: '将 vLLM 工程测试的显存预留比例从 0.60 降到 0.50，保持 Stage2 任务和损失设置。v4 依旧在反向传播 OOM。',
    conclusion: '已排除“只调低推理缓存就能解决”的简单方案。',
  },
];

const technicalChecks = [
  '上一轮的 GPU 利用率不能证明 optimizer step 完成：工程测试没有可核验的参数更新或四卡 checkpoint。',
  '当时观察到容器 CPU 使用率约 820%、RAM 约 258 GiB；4 个 Ray worker 的 CPU 时间持续增长。性能瓶颈的逐阶段耗时尚未准确剖析。',
  '此前的物理 chunk=2 优化在 Qwen3 数值对照中没有通过梯度与 AdamW 更新一致性验收，因此不能直接替代正式实现。',
  '六卡 GPU 2–7 是后续 Codex 工程任务。六卡的数据分片、梯度累积、数值对齐与真实 checkpoint 尚待验收。',
  '当时持久实验盘约剩 67 GiB；历史完整输出曾估算需约 414 GiB。容量问题需要独立测量和安全备份方案。',
];
---

<section class="q03-world4" data-seed-world4-case data-evidence-as-of="2026-10-14" aria-labelledby="q03-world4-title">
  <header class="q03-world4__intro">
    <span class="q03-world4__eyebrow">Q03 · 新的公开代码复现（2026 年 10 月 14 日核对）</span>
    <h4 id="q03-world4-title">四张 RTX 5090 跑到了反向传播，却没能完成一次 Stage2 更新</h4>
    <p>前面的 A0–A120 分数来自历史 SEED-derived 路线，使用的是我们自己的 64 道题。为理解它与论文成绩为何不能直接比较，我们另起一条使用公开 SEED 源码的复现路线，固定 Qwen3-1.7B 与已经收集的 MiniMax 教师数据。这次回看的是新路线的<strong>训练可行性</strong>，还没有新的 WebShop 能力分数。</p>
  </header>

  <p class="q03-world4__verdict"><strong>当前已证实：</strong>四卡能加载模型、完成工程数据采集并进入 Stage2；两次原生反向传播都因显存不足退出。<strong>正式 Stage2 更新仍为 0，尚无新的任务能力结论。</strong></p>

  <div class="q03-world4__hardware" aria-label="原论文与本次复现的训练硬件">
    <div><span>SEED 论文报告的训练硬件</span><strong>8 × A800 <small>80 GB/卡</small></strong></div>
    <div><span>这次工程测试的训练硬件</span><strong>4 × RTX 5090 <small>约 32 GB/卡</small></strong></div>
  </div>
  <p class="q03-world4__context">两组硬件的单卡显存和 GPU 数量同时不同。FSDP 可以切分参数，不能把四张卡的显存合成一块供单次反向传播任意使用。论文还使用不同的教师模型及训练轮次；这里的比较说明资源约束，不能替代同协议的任务成绩对照。</p>

  <div class="q03-world4__evidence" aria-labelledby="q03-world4-measured">
    <h5 id="q03-world4-measured">两次实测，都停在 <code>loss.backward()</code></h5>
    <div class="q03-world4__tablewrap" tabindex="0" aria-label="两次四卡 Stage2 显存不足的实际日志对照">
      <table>
        <caption>原生 Stage2 工程测试 · 2026 年 10 月 14 日 · 单卡 GiB</caption>
        <thead><tr><th scope="col">测试</th><th scope="col">待分配显存</th><th scope="col">当时剩余</th><th scope="col">参数更新</th></tr></thead>
        <tbody>
          <tr><th scope="row">v3 · 默认预留</th><td data-label="待分配显存">5.80 GiB</td><td data-label="当时剩余">5.48 GiB</td><td data-label="参数更新">未完成</td></tr>
          <tr><th scope="row">v4 · 预留降至 0.50</th><td data-label="待分配显存">5.93 GiB</td><td data-label="当时剩余">5.11 GiB</td><td data-label="参数更新">未完成</td></tr>
        </tbody>
      </table>
    </div>
    <p class="q03-world4__table-note">“待分配”指报错时 PyTorch 申请的新显存，并非总共缺少这么多显存。两次容器均以错误码 1 退出，尚无成功保存的四卡原生优化器状态。<a href={source.findings} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.findings}/>查看原始失败与代码核查记录 ↗</a></p>
  </div>

  <figure class="q03-world4__flow" data-intelligence-ui data-seed-world4-flow aria-labelledby="q03-world4-flow-title">
    <header class="q03-world4__flow-header">
      <span>Intelligence UI · 训练路径对照</span>
      <h5 id="q03-world4-flow-title">GPU 为什么有时只占显存，却几乎不计算？</h5>
      <p>这次四卡工程方案为了节省显存，把一部分反向传播需要的张量暂存到 CPU。GPU 可能要等这些数据恢复才能继续计算。</p>
    </header>
    <div class="q03-world4__lane q03-world4__lane--paper">
      <div class="q03-world4__lane-heading">
        <strong>大显存条件下的简化路径</strong>
        <span>较少依赖额外的 CPU 压缩环节</span>
      </div>
      <ol class="q03-world4__steps q03-world4__steps--short">
        {paperPath.map((step, i) => (
          <li class:list={{'q03-world4__step': true, 'is-gpu': step.place==='gpu', 'is-update': step.place==='update'}}>
            <span class="q03-world4__step-index">{String(i+1).padStart(2,'0')}</span>
            <strong>{step.label}</strong>
            <small>{step.explanation}</small>
          </li>
        ))}
      </ol>
    </div>
    <div class="q03-world4__lane q03-world4__lane--cpu">
      <div class="q03-world4__lane-heading">
        <strong>本次四卡工程方案的 CPU 绕行</strong>
        <span>中间张量保存 / 恢复</span>
      </div>
      <ol class="q03-world4__steps q03-world4__steps--long">
        {engineeringPath.map((step, i) => (
          <li class:list={{'q03-world4__step': true, 'is-gpu': step.place==='gpu', 'is-cpu': step.place==='cpu'}}>
            <span class="q03-world4__step-index">{String(i+1).padStart(2,'0')}</span>
            <strong>{step.label}</strong>
            <small>{step.explanation}</small>
          </li>
        ))}
      </ol>
    </div>
    <figcaption>两条路径用于解释数据放在哪里、何时需要移动，属于<strong>机制示意</strong>，不代表论文作者的逐条代码追踪。CPU 张量处理与 GPU 等待有明确的实现和运行证据；各阶段耗时占比、跨 NUMA 的影响及 OOM 的完整内存成因仍待进一步剖析。</figcaption>
  </figure>

  <p class="q03-world4__measurement"><strong>现场观察：</strong>四个 Ray 训练 worker 的 CPU 时间持续增长，一次采样中容器 CPU 使用率约 820%、主机内存使用约 258 GiB；同一段训练中，GPU 利用率在 0% 与 100% 之间变化。程序确实做了计算，但尚未顺利完成一轮参数更新。</p>

  <div class="q03-world4__efforts" aria-labelledby="q03-world4-efforts">
    <h5 id="q03-world4-efforts">这次排查具体推进了哪些事情</h5>
    <ol>
      {efforts.map((item) => (
        <li><strong>{item.title}</strong><p>{item.description}</p><p class="q03-world4__effort-result">{item.conclusion}</p></li>
      ))}
    </ol>
  </div>

  <div class="q03-world4__next" aria-labelledby="q03-world4-next">
    <h5 id="q03-world4-next">接下来验证六卡方案，仍需先证明训练真的能更新</h5>
    <p>当前已将 GPU 2–7 六卡恢复任务交给 Codex。下一步需要验证六卡分片、micro-batch 与梯度累积的数值可比性，完成一次真实 Stage2 优化器更新，再检查六卡 checkpoint 保存与恢复。正式长周期训练还受到磁盘空间约束。</p>
    <p><strong>状态边界：</strong>六卡还没有在这份证据快照中通过训练资格；此前四卡失败也不能推断 SEED 算法本身失败。<a href={source.recovery} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.recovery}/>查看持续更新的六卡 / 四卡工程 PR ↗</a></p>
  </div>

  <details class="q03-world4__details" data-seed-world4-detail>
    <summary>展开技术细节、失败边界与原始来源</summary>
    <ul>
      {technicalChecks.map((line) => <li>{line}</li>)}
    </ul>
    <nav aria-label="公开 SEED 四卡复现实验的证据来源">
      <a href={source.upstream} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.upstream}/>SEED 原论文 ↗</a>
      <a href={source.source} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.source}/>作者公开源码 ↗</a>
      <a href={source.experiment} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.experiment}/>公开复现实验 #677 ↗</a>
      <a href={source.offline} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.offline}/>离线缓存核验证据 ↗</a>
      <a href={source.qualification} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.qualification}/>四卡工程阶段记录 ↗</a>
      <a href={source.findings} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={source.findings}/>v3 / v4 失败核对 ↗</a>
    </nav>
  </details>
</section>
