---
import type { Locale } from '../../i18n';
import ResearchGlossary from './ResearchGlossary.astro';

interface Term { term: string; meaning: string }
interface Props {
  locale: Locale;
  eyebrow?: string;
  title: string;
  lede: string;
  question: string;
  why: string;
  start: string;
  finish: string;
  state: string;
  stateTone?: 'planned' | 'authorized' | 'running' | 'sealed' | 'analyzed' | 'historical';
  backHref?: string;
  backLabel?: string;
  actionHref?: string;
  actionLabel?: string;
  terms?: Term[];
  showGlossary?: boolean;
  layout?: 'compact' | 'narrative' | 'focus';
}
const props = Astro.props;
const zh = props.locale === 'zh';
const labels = zh
  ? { question: '研究问题', why: '为什么重要', start: '从哪里开始', finish: '什么时候结束', state: '现在到哪了', details: '实验信息' }
  : { question: 'Question', why: 'Why it matters', start: 'Starts from', finish: 'Finishes when', state: 'Current state', details: 'Experiment details' };
const layout = props.layout ?? 'compact';
const showGlossary = props.showGlossary ?? true;
---
<header class="research-orientation" data-research-orientation data-layout={layout} data-ui-audit="contrast layout" data-locale={props.locale} data-state-tone={props.stateTone ?? 'planned'}>
  {(props.backHref || props.eyebrow) && (
    <div class="research-orientation__meta">
      {props.backHref && <a href={props.backHref}>← {props.backLabel}</a>}
      {props.eyebrow && <span>{props.eyebrow}</span>}
    </div>
  )}
  <div class="research-orientation__intro">
    <h1>{props.title}</h1>
    <p data-reader-purpose>{props.lede}</p>
  </div>
  {layout === 'focus' && props.actionHref && props.actionLabel && (
    <a class="research-orientation__action" href={props.actionHref}>{props.actionLabel} →</a>
  )}
  {layout === 'focus' ? (
    <details class="research-orientation__details">
      <summary>{labels.details}</summary>
      <dl class="research-orientation__fields">
        <div data-orientation-field="question"><dt>{labels.question}</dt><dd data-reader-answer>{props.question}</dd></div>
        <div data-orientation-field="why"><dt>{labels.why}</dt><dd data-reader-answer>{props.why}</dd></div>
        <div data-orientation-field="start"><dt>{labels.start}</dt><dd data-reader-answer>{props.start}</dd></div>
        <div data-orientation-field="finish"><dt>{labels.finish}</dt><dd data-reader-answer>{props.finish}</dd></div>
        <div data-orientation-field="state" class="is-state"><dt>{labels.state}</dt><dd data-reader-answer>{props.state}</dd></div>
      </dl>
    </details>
  ) : (
    <dl class="research-orientation__fields">
      <div data-orientation-field="question"><dt>{labels.question}</dt><dd data-reader-answer>{props.question}</dd></div>
      <div data-orientation-field="why"><dt>{labels.why}</dt><dd data-reader-answer>{props.why}</dd></div>
      {layout === 'narrative' && <div data-orientation-field="state" class="is-state"><dt>{labels.state}</dt><dd data-reader-answer>{props.state}</dd></div>}
      <div data-orientation-field="start"><dt>{labels.start}</dt><dd data-reader-answer>{props.start}</dd></div>
      <div data-orientation-field="finish"><dt>{labels.finish}</dt><dd data-reader-answer>{props.finish}</dd></div>
      {layout !== 'narrative' && <div data-orientation-field="state" class="is-state"><dt>{labels.state}</dt><dd data-reader-answer>{props.state}</dd></div>}
    </dl>
  )}
  {layout !== 'focus' && props.actionHref && props.actionLabel && (
    <a class="research-orientation__action" href={props.actionHref}>{props.actionLabel} →</a>
  )}
</header>
{showGlossary && <ResearchGlossary locale={props.locale} terms={props.terms ?? []} />}
<style>
.research-orientation{width:min(1120px,calc(100% - 2rem));margin:0 auto;padding:1rem 0;border-bottom:1px solid var(--line)}
.research-orientation__meta{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:.7rem;color:var(--muted);font:780 .875rem/1.3 var(--font-mono);letter-spacing:.06em}
.research-orientation__meta a{color:var(--muted);text-decoration:none}.research-orientation__meta a:hover{text-decoration:underline;text-underline-offset:.2em}
.research-orientation__intro{display:grid;grid-template-columns:minmax(0,.9fr) minmax(280px,1.1fr);gap:1.4rem;align-items:end}
.research-orientation h1{margin:0;font-size:clamp(1.8rem,3.2vw,2.5rem);line-height:1.3;letter-spacing:-.05em}
.research-orientation__intro p{margin:0;color:var(--muted);font-size:1rem;line-height:1.68}
.research-orientation__fields{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;margin:1rem 0 0;border-block:1px solid var(--line)}
.research-orientation__fields>div{min-width:0;padding:.72rem .8rem;border-right:1px solid var(--line)}.research-orientation__fields>div:last-child{border-right:0}
.research-orientation dt{color:var(--muted);font:800 .875rem/1.2 var(--font-mono);letter-spacing:.05em}.research-orientation dd{margin:.28rem 0 0;font-size:1rem;line-height:1.7;overflow-wrap:anywhere}
.research-orientation__fields .is-state{background:var(--surface-muted)}.research-orientation[data-state-tone="running"] .is-state,.research-orientation[data-state-tone="authorized"] .is-state{box-shadow:inset 0 -3px 0 var(--accent)}
.research-orientation__action{display:inline-flex;margin-top:.8rem;color:var(--accent-deep);font-size:1rem;font-weight:800;text-underline-offset:.2em}
.research-orientation[data-locale="en"] .research-orientation__intro{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr)}
.research-orientation[data-locale="en"] h1{font-size:clamp(1.8rem,3.2vw,2.5rem);line-height:1.25;letter-spacing:-.02em}
.research-orientation[data-locale="en"] .research-orientation__fields dd{font-size:1rem;line-height:1.6}
.research-orientation[data-layout="focus"]{padding:clamp(1.8rem,4.5vh,3rem) 0 1.2rem;border-bottom:0}
.research-orientation[data-layout="focus"] .research-orientation__meta{margin-bottom:clamp(1.05rem,2.2vh,1.6rem);font-family:inherit;font-weight:650;letter-spacing:0}
.research-orientation[data-layout="focus"] .research-orientation__intro{display:block;max-width:900px}
.research-orientation[data-layout="focus"] h1{max-width:18ch;font-size:clamp(2.55rem,4vw,3rem);line-height:1.03;letter-spacing:-.055em;text-wrap:balance}
.research-orientation[data-layout="focus"] .research-orientation__intro p{max-width:42ch;margin-top:1rem;color:var(--ink);font-size:clamp(1.35rem,2.2vw,1.8rem);line-height:1.35;letter-spacing:-.025em;text-wrap:balance}
.research-orientation[data-layout="focus"] .research-orientation__action{margin-top:1.15rem;font-weight:720}
.research-orientation__details{max-width:760px;margin-top:.9rem;border-top:1px solid var(--line)}
.research-orientation__details>summary{width:max-content;max-width:100%;padding:.75rem 0;color:var(--muted);font-size:.9rem;font-weight:700;cursor:pointer;list-style:none;text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--muted) 40%,transparent);text-underline-offset:.2em}
.research-orientation__details>summary::-webkit-details-marker{display:none}.research-orientation__details>summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.research-orientation__details[open]>summary{color:var(--ink)}
.research-orientation[data-layout="focus"] .research-orientation__fields{grid-template-columns:repeat(2,minmax(0,1fr));margin:.15rem 0 0}
.research-orientation[data-layout="focus"] .research-orientation__fields>div{border-bottom:1px solid var(--line)}
.research-orientation[data-layout="focus"] .research-orientation__fields>div:nth-child(2n){border-right:0}
.research-orientation[data-layout="focus"] .research-orientation__fields>div:last-child{grid-column:1/-1;border-right:0;border-bottom:0}
.research-orientation[data-layout="narrative"]{padding-block:.5rem}
.research-orientation[data-layout="narrative"] .research-orientation__fields{grid-template-columns:repeat(12,minmax(0,1fr))}
.research-orientation[data-layout="narrative"] [data-orientation-field="question"]{grid-column:span 3}
.research-orientation[data-layout="narrative"] [data-orientation-field="why"]{grid-column:span 4}
.research-orientation[data-layout="narrative"] [data-orientation-field="state"]{grid-column:span 5;border-right:0}
.research-orientation[data-layout="narrative"] [data-orientation-field="start"]{grid-column:span 4;border-top:1px solid var(--line)}
.research-orientation[data-layout="narrative"] [data-orientation-field="finish"]{grid-column:span 8;border-top:1px solid var(--line)}
@media(max-width:900px){.research-orientation__fields{grid-template-columns:repeat(2,minmax(0,1fr))}.research-orientation__fields>div{border-bottom:1px solid var(--line)}.research-orientation__fields>div:nth-child(2n){border-right:0}.research-orientation__fields>div:last-child{grid-column:1/-1;border-bottom:0}}
@media(max-width:760px){.research-orientation{width:min(100% - 1rem,1120px);padding-top:1rem}.research-orientation__meta{align-items:flex-start;flex-direction:column}.research-orientation__intro{grid-template-columns:1fr;gap:.65rem}.research-orientation h1{font-size:clamp(1.8rem,7vw,2.3rem)}.research-orientation__intro p{font-size:1rem;line-height:1.58}.research-orientation__fields{grid-template-columns:1fr}.research-orientation__fields>div,.research-orientation__fields>div:nth-child(2n){border-right:0;border-bottom:1px solid var(--line)}.research-orientation__fields>div:last-child{grid-column:auto}.research-orientation[data-layout="focus"]{padding:1.8rem 0 1rem}.research-orientation[data-layout="focus"] h1{font-size:clamp(2.25rem,10vw,2.75rem);line-height:1.02}.research-orientation[data-layout="focus"] .research-orientation__intro p{margin-top:1rem;font-size:clamp(1.2rem,5.3vw,1.45rem);line-height:1.38}.research-orientation[data-layout="focus"] .research-orientation__fields{grid-template-columns:1fr}.research-orientation[data-layout="focus"] .research-orientation__fields>div,.research-orientation[data-layout="focus"] .research-orientation__fields>div:nth-child(2n){border-right:0}.research-orientation[data-layout="focus"] .research-orientation__fields>div:last-child{grid-column:auto}}
@media(max-width:900px){.research-orientation[data-layout="narrative"] .research-orientation__fields{grid-template-columns:1fr}.research-orientation[data-layout="narrative"] .research-orientation__fields>[data-orientation-field]{grid-column:1;border-right:0;border-top:0}.research-orientation[data-layout="narrative"] .research-orientation__fields>[data-orientation-field]:last-child{border-bottom:0}}
</style>
