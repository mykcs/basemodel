---
import { localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (target: string) => localePath(locale, target);

const exact = (target: string) => path === target || path === `${target}/`;
const starts = (target: string) => path.startsWith(`${target}/`);
const relevant = exact('/guide')
  || exact('/guide/openevo-webshop-alfworld')
  || exact('/models')
  || exact('/models/qwen2-5-3b-instruct')
  || exact('/papers/seed')
  || exact('/workspace')
  || exact('/compare');

const active = exact('/models') || exact('/models/qwen2-5-3b-instruct') ? 'model'
  : exact('/papers/seed') ? 'seed'
  : exact('/guide/openevo-webshop-alfworld') ? 'run'
  : exact('/workspace') || exact('/compare') ? 'evidence'
  : exact('/guide') ? 'learn'
  : 'mission';

const steps = [
  { id: 'mission', label: t('研究总览', 'Mission'), href: p('/research/seed-openevo/') },
  { id: 'model', label: 'Base Model', href: p('/research/seed-openevo/base-model/') },
  { id: 'seed', label: 'SEED', href: p('/research/seed-openevo/seed/') },
  { id: 'openevo', label: 'OpenEvo', href: p('/research/seed-openevo/openevo/') },
  { id: 'benchmarks', label: 'ALFWorld / WebShop', href: p('/research/seed-openevo/benchmarks/') },
  { id: 'run', label: t('复现', 'Reproduce'), href: p('/guide/openevo-webshop-alfworld/') },
  { id: 'evidence', label: t('结果 / 改进', 'Results / improve'), href: p('/research/seed-openevo/results/') },
];
---
{relevant && (
  <aside class="mission-ribbon" aria-label={t('当前页面在 SEED × OpenEvo 研究中的位置', 'This page in the SEED × OpenEvo research mission')}>
    <div class="shell mission-ribbon__inner">
      <div class="mission-ribbon__label">
        <small>{t('你正在同一项研究里', 'One connected research mission')}</small>
        <strong>{t('SEED 基准 → OpenEvo 复现与改进', 'SEED benchmarks → OpenEvo reproduction and improvement')}</strong>
      </div>
      <nav>
        {steps.map((step) => <a href={step.href} aria-current={step.id === active ? 'step' : undefined}>{step.label}</a>)}
      </nav>
    </div>
  </aside>
)}

<style>
  .mission-ribbon {
    border-bottom: 1px solid var(--line, #d9d4c8);
    background: color-mix(in srgb, var(--accent, #2457d6) 5%, var(--surface, #fff));
  }

  .mission-ribbon__inner {
    display: grid;
    grid-template-columns: minmax(190px, 0.55fr) minmax(0, 1.45fr);
    gap: 1rem;
    align-items: center;
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }

  .mission-ribbon__label small,
  .mission-ribbon__label strong { display: block; }
  .mission-ribbon__label small { color: var(--accent, #2457d6); font-size: 0.62rem; font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; }
  .mission-ribbon__label strong { margin-top: 0.2rem; font-size: 0.75rem; line-height: 1.35; }

  .mission-ribbon nav { display: flex; gap: 0.25rem; overflow-x: auto; padding: 0.2rem; }
  .mission-ribbon a { flex: 0 0 auto; padding: 0.45rem 0.6rem; border-radius: 999px; color: var(--muted, #5d584f); font-size: 0.66rem; font-weight: 750; text-decoration: none; }
  .mission-ribbon a:hover,
  .mission-ribbon a:focus-visible { color: var(--text, #201c16); background: color-mix(in srgb, var(--accent, #2457d6) 8%, transparent); }
  .mission-ribbon a[aria-current='step'] { color: #fff; background: var(--accent, #2457d6); }

  @media (max-width: 760px) {
    .mission-ribbon__inner { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
