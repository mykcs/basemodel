---
import type { Locale } from '../../i18n';
import SeedOpenEvoResearchNav from './SeedOpenEvoResearchNav.astro';

interface Props {
  locale: Locale;
  path: string;
}

type ResearchPage = 'hub' | 'base-model' | 'seed' | 'openevo' | 'benchmarks' | 'webshop' | 'alfworld' | 'loops' | 'run' | 'results';

const { locale, path } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const exact = (target: string) => path === target || path === `${target}/`;
const relevant = exact('/guide')
  || exact('/research/seed-openevo/study/run')
  || exact('/models')
  || exact('/models/qwen2-5-3b-instruct')
  || exact('/papers/seed')
  || exact('/workspace')
  || exact('/compare');

const page: ResearchPage = exact('/models') || exact('/models/qwen2-5-3b-instruct') ? 'base-model'
  : exact('/papers/seed') ? 'seed'
  : exact('/research/seed-openevo/study/run') ? 'run'
  : exact('/workspace') || exact('/compare') ? 'results'
  : 'hub';
---
{relevant && (
  <aside class="mission-ribbon" aria-label={t('SEED 与 OpenEvo 实验导航', 'SEED and OpenEvo experiment navigation')}>
    <div class="mission-ribbon__inner">
      <SeedOpenEvoResearchNav locale={locale} page={page} />
    </div>
  </aside>
)}

<style>
  .mission-ribbon__inner{
    width:min(1160px,calc(100% - 2rem));
    margin-inline:auto;
  }

  @media(max-width:720px){
    .mission-ribbon__inner{width:min(100% - 1rem,1160px)}
  }
</style>
