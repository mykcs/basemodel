---
/**
 * Publication-quality static vector graphic, generated offline from PGFPlots.
 * Keeps Astro/HTML semantics and real source-bound captions outside the asset.
 * No browser-side TeX engine, canvas renderer or runtime code.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import NativeSvgChartReader from './NativeSvgChartReader.astro';
interface Props {
  id: string;
  src: string;
  alt: string;
  captionId: string;
  loading?: 'eager' | 'lazy';
  widthTier?: 'single' | 'double';
  naturalWidth?: number;
  naturalHeight?: number;
  mobileSrc?: string;
}
const { id, src, alt, captionId, loading = 'lazy', widthTier = 'single', naturalWidth = 340, naturalHeight = 208, mobileSrc } = Astro.props;
if(!id || !src.startsWith('/research/') || !src.endsWith('.svg') || !alt || !captionId || (mobileSrc && (!mobileSrc.startsWith('/research/') || !mobileSrc.endsWith('.svg')))) {
  throw new Error('PublicationPlot needs one vetted local SVG and a meaningful accessible caption');
}
const sourceSvg=readFileSync(resolve('public',src.slice(1)),'utf8');
const intrinsicWidth=Number(sourceSvg.match(/\bviewBox\s*=\s*["']([^"']+)["']/)?.[1]?.trim().split(/\s+/)[2]??naturalWidth);
if(!Number.isFinite(intrinsicWidth)||intrinsicWidth<=0)throw new Error('PublicationPlot needs finite source-native coordinates');
const readingWidth=Math.ceil(intrinsicWidth*1.6);
---
<div class:list={['publication-plot',widthTier==='double' && 'publication-plot--double']} data-publication-plot={id}>
  <NativeSvgChartReader id={`${id}-pgf-native`} label={alt} nativeWidth={readingWidth}>
  <picture>
    {mobileSrc && <source media="(max-width: 720px)" type="image/svg+xml" srcset={mobileSrc} />}
    <img
    src={src}
    alt={alt}
    aria-describedby={captionId}
    data-pgfplot={id}
    width={naturalWidth}
    height={naturalHeight}
    loading={loading}
    decoding="async"
    />
  </picture>
  </NativeSvgChartReader>
  <a class="publication-plot__source" href={src} target="_blank" rel="noreferrer">查看原始矢量图</a>
</div>

<style>
.publication-plot {
  width: min(100%, 27.5rem);
  max-width: 100%;
  margin: 0 auto .45rem;
  padding: 0;
  border: 0;
  background: transparent;
}
.publication-plot--double { width: min(100%, 44rem); }
.publication-plot picture { display: block; width: 100%; }
.publication-plot img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  margin: 0;
  background: #fff; /* the immutable PDF/PGFPlots paper canvas, including dark mode */
  color: #111;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}
.publication-plot__source{display:inline-block;margin-top:.35rem;color:var(--color-text-muted);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-caption) var(--font-interface)}
@media print {
  .publication-plot { break-inside: avoid; }
  .publication-plot img { print-color-adjust: exact; }
}
</style>
