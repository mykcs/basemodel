---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { CAPABILITY_READER_ROUTES, type CapabilityReaderRoute } from '../../data/capabilityReaderRoutes';
import { OPEN_EVO_CANONICAL_ROUTE_OWNERS, OPEN_EVO_EXPERIMENTS, OPEN_EVO_METHOD_BACKGROUND_ROUTE, type OpenEvoExperimentId } from '../../data/openEvoExperimentNavigation';
interface Props { locale: Locale; route: CapabilityReaderRoute; compact?: boolean; experimentId?: OpenEvoExperimentId }
const { locale, route, compact = false, experimentId } = Astro.props;
const resolvedExperimentId = experimentId ?? OPEN_EVO_CANONICAL_ROUTE_OWNERS[route];
const record = CAPABILITY_READER_ROUTES.find((entry) => entry.route === route);
if (!record) throw new Error(`Missing reader role for ${route}`);
const zh = locale === 'zh';
const root = localePath(locale, '/research/seed-openevo/study/capability-exploration/');
const studyRoot = localePath(locale, '/research/seed-openevo/study/');
const experiment = resolvedExperimentId ? OPEN_EVO_EXPERIMENTS.find((item) => item.id === resolvedExperimentId) : undefined;
if (resolvedExperimentId && !experiment) throw new Error(`Missing experiment context for ${resolvedExperimentId}`);
const experimentPrimaryRoute = experiment?.primaryHref
  .replace('/research/seed-openevo/study/capability-exploration/', '')
  .replace(/\/$/, '');
const isExperimentHub = Boolean(experiment && route === experimentPrimaryRoute);
const task = compact
  ? (zh ? 'WebShop：按要求搜索、选规格、购买商品。' : 'WebShop: search, choose options, and buy the requested product.')
  : (zh ? 'WebShop 是模拟购物任务：模型读取页面，选择搜索、选规格或购买等动作。OpenEvo 研究怎样把这些经验用于后续尝试。' : 'WebShop is a simulated shopping task: the model reads pages and chooses actions such as searching, selecting options, or purchasing. OpenEvo studies how that experience can inform later attempts.');
const compactPurpose = route === 'first-run'
  ? (zh ? '第一轮历史记录；不是当前运行。' : 'First-run history; not a live run.')
  : route === 'openevo-2-0'
    ? (zh ? '3B 与 1.7B 使用同一购物规则。' : '3B and 1.7B use the same shopping rules.')
    : route === 'openevo-2-0/report'
      ? (zh ? '实验方法、结果与结论边界。' : 'Methods, results, and claim boundaries.')
      : route === 'sd-lora-scaling'
        ? (zh ? 'DirectApply 派生分析：SD-LoRA 计算扩展性。' : 'DirectApply analysis: SD-LoRA compute scaling.')
        : route === 'q17-directapply-frontier'
          ? (zh ? '这条 1.7B 实验线在候选更新通过工程与数据检查后直接带入下一轮（DirectApply，不再做额外 GDR 小测）。本页后来把进入第 127 / 128 轮的两个模型状态拿到同一组 32 题上重测；这是局部诊断，不是最终测试。' : 'This 1.7B line carries candidates that pass engineering and data checks directly into the next round (DirectApply, with no extra GDR probe). This page later retests the model states entering rounds 127 and 128 on the same 32 tasks; it is a local diagnostic, not the final evaluation.')
          : record.purpose[locale];
const purpose = isExperimentHub && experiment && !compact ? experiment.motivation[locale] : (compact ? compactPurpose : record.purpose[locale]);
const contextExperimentTitle = experiment?.title[locale];
const contextRecordLabel = route === 'q17-directapply-frontier' && compact
  ? (zh ? '相邻两个模型状态 · 32 题同题诊断' : 'Two adjacent model states · 32-task same-task diagnostic')
  : record.label[locale];
const resultLinks = experiment ? experiment.childLinks.filter((link) => link.role === 'result') : [];
const hubResults = experiment && resultLinks.length === 0
  ? [{ role: 'result' as const, label: { zh: '本实验结果与分析', en: 'Experiment result and analysis' }, href: experiment.primaryHref }]
  : resultLinks;
const hubAnalyses = experiment?.childLinks.filter((link) => ['analysis', 'mechanism', 'diagnostic'].includes(link.role)) ?? [];
const hubEvidence = experiment
  ? [...experiment.childLinks.filter((link) => link.role === 'history' || link.role === 'evidence'), experiment.evidenceLink]
      .filter((link, index, links) => links.findIndex((candidate) => candidate.href === link.href) === index)
  : [];
---
<aside class="research-route-context" data-compact={compact ? 'true' : undefined} data-reader-route={route} data-reader-coverage={record.coverage} data-reader-context data-experiment-context={experiment ? 'true' : undefined} data-experiment-hub-context={isExperimentHub ? 'true' : undefined} data-experiment-id={experiment?.id} aria-label={zh ? '任务与研究位置' : 'Task and research context'}>
  <p class="research-route-context__location">
    {experiment ? (
      <>
        <a href={studyRoot}>{zh ? '实验目录' : 'Experiment index'}</a><span aria-hidden="true"> / </span>
        {isExperimentHub ? (
          <strong>{experiment.title[locale]}</strong>
        ) : (
          <><a href={localePath(locale, experiment.primaryHref)}>{contextExperimentTitle}</a><span aria-hidden="true"> / </span><strong>{contextRecordLabel}</strong></>
        )}
      </>
    ) : (
      <><a href={root}>{zh ? '能力探索' : 'Capability exploration'}</a><span aria-hidden="true"> / </span><strong>{record.label[locale]}</strong></>
    )}
  </p>
  <p data-reader-task>{task}</p>
  <p data-reader-purpose>{purpose}</p>
  {isExperimentHub && experiment && (
    <details class="research-route-context__hub" data-experiment-hub>
      <summary>{zh ? '本实验的结果、分析与证据' : 'Results, analysis, and evidence for this experiment'}</summary>
      <p data-hub-motivation><strong>{zh ? '为什么做：' : 'Why this experiment: '}</strong>{experiment.motivation[locale]}</p>
      <dl>
        <div data-hub-group="result"><dt>{zh ? '结果' : 'Result'}</dt><dd>{hubResults.map((link) => <a href={localePath(locale, link.href)}>{link.label[locale]}</a>)}</dd></div>
        <div data-hub-group="analysis"><dt>{zh ? '分析' : 'Analysis'}</dt><dd>{hubAnalyses.map((link) => <a href={localePath(locale, link.href)}>{link.label[locale]}</a>)}</dd></div>
        <div data-hub-group="evidence"><dt>{zh ? '证据 / 历史' : 'Evidence / history'}</dt><dd>{hubEvidence.map((link) => <a href={localePath(locale, link.href)}>{link.label[locale]}</a>)}</dd></div>
      </dl>
      <p class="research-route-context__method" data-hub-method-background><strong>{zh ? '需要先看系统怎么工作？' : 'Need the system/method first?'}</strong> <a href={localePath(locale, OPEN_EVO_METHOD_BACKGROUND_ROUTE.href)}>{OPEN_EVO_METHOD_BACKGROUND_ROUTE.label[locale]} →</a></p>
    </details>
  )}
</aside>
<style>
.research-route-context{width:min(1120px,calc(100% - 2rem));margin:.75rem auto 0;padding:0 0 .55rem;border-bottom:1px solid var(--line);font-size:.95rem;color:var(--ink)}.research-route-context p{max-width:60rem;line-height:1.52;margin:.22rem 0}.research-route-context__location{font-size:.85rem;line-height:1.4}.research-route-context a{color:var(--accent-deep);text-underline-offset:.2em}.research-route-context a:focus-visible{outline:2px solid var(--accent-deep);outline-offset:4px}.research-route-context[data-compact="true"]{display:grid;grid-template-columns:max-content minmax(0,1.25fr) minmax(0,1fr);gap:.25rem .9rem;align-items:baseline;margin-top:.55rem;padding-bottom:.4rem;font-size:.82rem}.research-route-context[data-compact="true"] p{max-width:none;margin:0;color:var(--muted);line-height:1.35}.research-route-context[data-compact="true"] .research-route-context__location{color:var(--ink);font-size:.8rem}@media(max-width:900px){.research-route-context[data-compact="true"]{grid-template-columns:1fr;gap:.12rem;margin-top:.45rem}.research-route-context[data-compact="true"] p{font-size:.78rem}}
.research-route-context__hub{grid-column:1/-1;margin:.35rem 0 0;padding-top:.25rem;border-top:1px solid var(--line)}.research-route-context__hub summary{width:max-content;max-width:100%;min-height:36px;cursor:pointer;color:var(--accent-deep);font-weight:750}.research-route-context__hub [data-hub-motivation]{max-width:60rem;margin:.45rem 0;color:var(--ink);line-height:1.5}.research-route-context__hub dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:.5rem 0 0}.research-route-context__hub dl>div{min-width:0}.research-route-context__hub dt{font-weight:800;color:var(--ink)}.research-route-context__hub dd{display:grid;gap:.25rem;margin:.18rem 0 0}.research-route-context__hub dd a{overflow-wrap:anywhere}.research-route-context__method{max-width:60rem;margin:.6rem 0 0;color:var(--muted);line-height:1.5}.research-route-context__method strong{color:var(--ink)}.research-route-context__hub summary:focus-visible{outline:2px solid var(--accent-deep);outline-offset:3px}.research-route-context[data-compact="true"][data-experiment-hub-context="true"]{grid-template-columns:max-content minmax(0,1.1fr) minmax(0,1fr) max-content}.research-route-context[data-compact="true"][data-experiment-hub-context="true"] .research-route-context__hub{grid-column:auto;margin:0;padding:0;border:0;align-self:baseline;min-width:0}.research-route-context[data-compact="true"][data-experiment-hub-context="true"] .research-route-context__hub[open]{grid-column:1/-1;margin:.35rem 0 0;padding-top:.25rem;border-top:1px solid var(--line)}.research-route-context[data-compact="true"][data-experiment-hub-context="true"] .research-route-context__hub summary{min-height:0;white-space:nowrap}@media(max-width:900px){.research-route-context[data-compact="true"][data-experiment-hub-context="true"]{grid-template-columns:1fr}.research-route-context[data-compact="true"][data-experiment-hub-context="true"] .research-route-context__hub{grid-column:1;margin:.25rem 0 0;padding-top:.25rem;border-top:1px solid var(--line)}}@media(max-width:680px){.research-route-context__hub dl{grid-template-columns:1fr}}
</style>
