---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { CAPABILITY_READER_ROUTES, type CapabilityReaderRoute } from '../../data/capabilityReaderRoutes';
interface Props { locale: Locale; route: CapabilityReaderRoute }
const { locale, route } = Astro.props;
const record = CAPABILITY_READER_ROUTES.find((entry) => entry.route === route);
if (!record) throw new Error(`Missing reader role for ${route}`);
const zh = locale === 'zh';
const root = localePath(locale, '/research/seed-openevo/study/capability-exploration/');
---
<aside class="research-route-context" data-reader-route={route} data-reader-coverage={record.coverage} data-reader-context aria-label={zh ? '任务与研究位置' : 'Task and research context'}>
  <p class="research-route-context__location"><a href={root}>{zh ? '能力探索' : 'Capability exploration'}</a><span aria-hidden="true"> / </span><strong>{record.label[locale]}</strong></p>
  <p data-reader-task>{zh ? 'WebShop 是模拟购物任务：模型读取页面，选择搜索、选规格或购买等动作。OpenEvo 研究怎样把这些经验用于后续尝试。' : 'WebShop is a simulated shopping task: the model reads pages and chooses actions such as searching, selecting options, or purchasing. OpenEvo studies how that experience can inform later attempts.'}</p>
  <p data-reader-purpose>{record.purpose[locale]}</p>
</aside>
<style>
.research-route-context{width:min(1120px,calc(100% - 2rem));margin:.75rem auto 0;padding:0 0 .55rem;border-bottom:1px solid var(--line);font-size:.95rem;color:var(--ink)}.research-route-context p{max-width:60rem;line-height:1.52;margin:.22rem 0}.research-route-context__location{font-size:.85rem;line-height:1.4}.research-route-context a{color:var(--accent-deep);text-underline-offset:.2em}.research-route-context a:focus-visible{outline:2px solid var(--accent-deep);outline-offset:4px}
</style>
