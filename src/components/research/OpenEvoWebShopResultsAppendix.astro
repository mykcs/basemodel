---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import Seed3090ParametricProgress from './Seed3090ParametricProgress.astro';
import {
  openEvoProgramLinks,
  openEvoProgramSource,
  programResultLabels,
  programTimeline,
} from '../../data/openEvoWebShopProgram';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const deepDives = [
  {
    href: p('/research/seed-openevo/results/why-it-kept-failing/'),
    title: t('早期为什么一直没有可靠迁移', 'Why early runs never produced reliable transfer'),
    body: t('继续追 parser（动作解析）、horizon（交互步数）、carrier（经验载体）、标签与执行有效性这些具体诊断。', 'The parser, horizon, carrier, label, and execution-validity diagnostics in detail.'),
  },
  {
    href: p('/research/seed-openevo/results/first-positive-transfer/'),
    title: t('H1.38B：第一次可靠正向迁移', 'H1.38B: the first reliable positive transfer'),
    body: t('查看第一次置信区间完全位于 0 以上的 internal fresh-task transfer（内部新任务迁移）结果。', 'The first internal fresh-task transfer whose confidence interval lay entirely above zero.'),
  },
  {
    href: p('/research/seed-openevo/results/independent-replication/'),
    title: t('H1.39：独立复现', 'H1.39: independent replication'),
    body: t('冻结训练产物、更换新的 task-ID-disjoint panel（任务 ID 不重叠评估组）后再次观察到提升。', 'Frozen artifacts, a fresh task-ID-disjoint panel, and the improvement observed again.'),
  },
  {
    href: p('/research/seed-openevo/results/second-generation/'),
    title: t('H1.40 / H1.41：第二代持续整合边界', 'H1.40 / H1.41: the second-generation integration boundary'),
    body: t('经验供给与第二代参数写入成立，但稳定 acquisition / retention / preservation（新知识获取 / 旧知识保持 / 已有收益保持）尚未建立。', 'Experience supply and the second-generation write hold; stable acquisition / retention / preservation do not.'),
  },
  {
    href: p('/research/seed-openevo/results/current-conclusion/'),
    title: t('完整结论边界', 'The full claim boundary'),
    body: t('逐项核对哪些结论已经 supported（已支持），哪些属于 negative（负结果）、invalid（无效）或 unknown（未知）。', 'Item by item: which claims are supported, negative, invalid, or unknown.'),
  },
] as const;

const legacyLinks = [
  { href: p('/research/seed-openevo/results/webshop-training/'), label: t('WebShop 早期说明', 'Early WebShop note') },
  { href: p('/research/seed-openevo/results/seed-training/'), label: t('SEED 早期说明', 'Early SEED note') },
  { href: p('/research/seed-openevo/results/openevo-training/'), label: t('OpenEvo 早期说明', 'Early OpenEvo note') },
  { href: p('/research/seed-openevo/results/measurement-boundary/'), label: t('H1.42 后续测量笔记', 'H1.42 follow-up measurement note') },
  { href: p('/research/seed-openevo/results/benchmark-first/'), label: t('正式比较设计', 'Formal comparison design') },
  { href: p('/research/seed-openevo/results/seed-faithful-benchmark/'), label: t('SEED 公平比较协议', 'SEED-faithful comparison protocol') },
  { href: p('/research/seed-openevo/results/openevo-benchmark-design/'), label: t('OpenEvo 方法变体设计', 'OpenEvo method-variant design') },
] as const;
---

<section class="results-appendix" id="appendix" aria-labelledby="appendix-title">
  <header class="section-heading">
    <p>APPENDIX</p>
    <div>
      <h2 id="appendix-title">{t('附录：深挖笔记、完整时间线与审计入口', 'Appendix: deep-dive notes, full timeline, and audit trail')}</h2>
      <p>{t(
        '正文只放结论与关键数字；更细的失败诊断、逐实验时间线和历史硬件记录都收在这里。',
        'The main text keeps only conclusions and key numbers; finer failure diagnostics, the experiment-by-experiment timeline, and historical hardware records live here.',
      )}</p>
    </div>
  </header>

  <div class="deep-grid">
    {deepDives.map((item) => (
      <a href={item.href} class="deep-card">
        <strong>{item.title}</strong>
        <span>{item.body}</span>
        <b aria-hidden="true">→</b>
      </a>
    ))}
  </div>

  <details class="legacy-links">
    <summary>{t('较早的实验记录与 H1.42 后续测量', 'Earlier experiment notes and H1.42 follow-up measurement')}</summary>
    <p>{t(
      'H1.41 的结论只使用截止 H1.41 已经产生的证据；H1.42 属于之后的 measurement-boundary（测量边界）工作。较早的实验记录同时保留，方便追溯研究过程。',
      'H1.41 conclusions use only evidence produced by H1.41; H1.42 is later measurement-boundary work. Earlier notes are retained so the research process stays traceable.',
    )}</p>
    <div>
      {legacyLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </details>

  <details class="lineage-appendix" data-testid="lineage-appendix">
    <summary>{t('完整实验时间线（Phase G → H1.42-MV，共 30 条）', 'Full experiment timeline (Phase G → H1.42-MV, 30 entries)')}</summary>
    <p>{t(
      '每一条都标注证据等级：有可用证据、未支持预期、无效或仅诊断、仅协议、目标 / 设计移交。链接指向对应的机器对账或人工报告。',
      'Each entry carries an evidence grade: usable evidence, expected effect not supported, invalid or diagnostic-only, protocol only, or goal/design handoff. Links point at the machine reconciliation or human report.',
    )}</p>
    <ol class="lineage-list">
      {programTimeline.map((item) => (
        <li>
          <span class="lin-cov">{item.coverage.join(' · ')}</span>
          <strong>{item.title[locale]}</strong>
          <span class="lin-summary">{item.summary[locale]}</span>
          <span class:list={['lin-result', `res-${item.result}`]}>{programResultLabels[item.result][locale]}</span>
          <a href={item.evidence} target="_blank" rel="noreferrer">{t('证据 ↗', 'Evidence ↗')}</a>
        </li>
      ))}
    </ol>
  </details>

  <details class="rtx6-appendix" data-testid="rtx6-appendix">
    <summary>{t('历史硬件记录：RTX 6 卡阶段的参数化进展', 'Historical hardware record: parametric progress on the RTX six-GPU stage')}</summary>
    <Seed3090ParametricProgress locale={locale} />
  </details>

  <div class="audit-row">
    <span>{t('审计入口：', 'Audit trail: ')}</span>
    <a href={openEvoProgramLinks.ledger} target="_blank" rel="noreferrer">{t('项目总账（ledger）', 'Program ledger')}</a>
    <a href={openEvoProgramLinks.report} target="_blank" rel="noreferrer">{t('项目报告', 'Program report')}</a>
    <a href={openEvoProgramLinks.campaign} target="_blank" rel="noreferrer">{t('当前 campaign 配置', 'Current campaign config')}</a>
  </div>

  <div class="print-provenance" aria-hidden="true">
    <p>{t('证据来源（打印留存）：', 'Evidence provenance (print record):')}</p>
    <code>{openEvoProgramSource.branch}@{openEvoProgramSource.commit.slice(0, 16)}</code>
    <code>{openEvoProgramSource.campaign}</code>
  </div>
</section>

<style>
  .results-appendix{max-width:1160px;margin:0 auto;padding:0 24px 72px;color:var(--color-text)}
  .section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}
  .section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.14em}
  .section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}
  .section-heading div>p{margin:0;max-width:66ch;color:var(--color-text-muted);font-size:.94rem;line-height:1.68}
  .deep-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .deep-card{display:flex;min-height:142px;flex-direction:column;padding:17px;border:1px solid var(--color-border);border-radius:13px;background:var(--color-surface);color:var(--color-text);text-decoration:none;transition:transform .18s ease,border-color .18s ease}
  .deep-card:hover,.deep-card:focus-visible{transform:translateY(-2px);border-color:var(--color-accent)}
  .deep-card strong{margin-bottom:10px;font-size:.94rem;line-height:1.4}
  .deep-card span{color:var(--color-text-muted);font-size:.79rem;line-height:1.58}
  .deep-card b{margin-top:auto;padding-top:14px;color:var(--color-accent)}
  .legacy-links,.lineage-appendix,.rtx6-appendix{margin-top:12px;padding:16px 0;border-top:1px solid var(--color-border);color:var(--color-text-muted);font-size:.8rem}
  .legacy-links summary,.lineage-appendix summary,.rtx6-appendix summary{cursor:pointer;color:var(--color-text);font-weight:650}
  .legacy-links p,.lineage-appendix p{margin:10px 0 8px;line-height:1.6}
  .legacy-links div{display:flex;gap:12px;flex-wrap:wrap}
  .legacy-links a{color:var(--color-accent)}
  .lineage-list{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:8px}
  .lineage-list li{display:grid;grid-template-columns:150px minmax(0,1fr);gap:4px 14px;padding:12px 14px;border:1px solid var(--color-border);border-radius:11px;background:var(--color-bg)}
  .lin-cov{grid-row:1 / span 3;color:var(--color-accent);font:700 .68rem ui-monospace,SFMono-Regular,Menlo,monospace;line-height:1.5}
  .lineage-list strong{font-size:.82rem;color:var(--color-text);line-height:1.45}
  .lin-summary{font-size:.76rem;line-height:1.55}
  .lin-result{display:inline-block;font-size:.68rem;font-weight:700}
  .res-supported{color:var(--color-positive)}
  .res-negative{color:var(--color-warning)}
  .res-invalid{color:var(--color-danger)}
  .res-protocol{color:var(--color-info)}
  .res-design{color:var(--color-accent)}
  .lineage-list a{color:var(--color-accent);font-size:.72rem;font-weight:650;text-decoration:none}
  .lineage-list a:hover{text-decoration:underline}
  .rtx6-appendix>:not(summary){margin-top:12px}
  .audit-row{display:flex;gap:14px;flex-wrap:wrap;align-items:baseline;margin-top:16px;padding-top:14px;border-top:1px solid var(--color-border);font-size:.78rem}
  .audit-row span{color:var(--color-text-muted)}
  .audit-row a{color:var(--color-accent);font-weight:650;text-decoration:none}
  .audit-row a:hover{text-decoration:underline}
  .print-provenance{display:none}
  @media print{
    .print-provenance{display:block;margin-top:24px;padding-top:12px;border-top:1px solid var(--color-border);font-size:.72rem;color:var(--color-text-muted)}
    .print-provenance code{display:block;margin-top:4px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  }
  @media(max-width:720px){
    .results-appendix{padding-inline:18px}
    .section-heading{grid-template-columns:1fr;gap:8px}
    .deep-grid{grid-template-columns:1fr}
    .lineage-list li{grid-template-columns:1fr}
    .lin-cov{grid-row:auto}
  }
</style>
