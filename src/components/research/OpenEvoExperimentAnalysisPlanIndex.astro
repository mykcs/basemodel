---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---
<section class="analysis-plan-index" aria-labelledby="analysis-plan-index-title">
  <p class="analysis-plan-index__eyebrow">{t('新完成实验 · 分析方案', 'NEWLY COMPLETED EXPERIMENT · ANALYSIS PLANS')}</p>
  <div class="analysis-plan-index__intro">
    <h2 id="analysis-plan-index-title">{t('从最终分数继续追问：为什么会得到这个结果？', 'Go beyond the final score: why did this result happen?')}</h2>
    <p>{t('先把 7B/self 这一次 run 的内部机制吃透，再把 3B / 7B × self / MiniMax 四组放在同一张比较地图里。MiniMax 是 episode 结束后的外部 analyzer，不是 WebShop actor；两页都只列分析方案和资源预算，不会自动启动新的 GPU 训练。','First explain the internal mechanics of the 7B/self run, then place 3B / 7B × self / MiniMax on one comparison map. MiniMax is a post-episode external analyzer, not the WebShop actor. Both pages are analysis plans and resource budgets only; they do not start new GPU training.')}</p>
  </div>
  <ol>
    <li><span>01</span><div><h3>{t('7B / self 单实验分析', '7B / self single-run analysis')}</h3><p>{t('Stage-1 checkpoint、loss、Stage-2 gate、逐题收益、格式与任务能力，以及什么时候才值得继续训练。','Stage-1 checkpoints, loss, the Stage-2 gate, per-task gains, action validity versus task capability, and when more training is actually justified.')}</p><a href={p('/research/seed-openevo/study/results/7b-self-analysis/')}>{t('打开分析方案 →','Open analysis plan →')}</a></div></li>
    <li><span>02</span><div><h3>{t('四组联合分析', 'Four-arm joint analysis')}</h3><p>{t('比较 self 与 MiniMax treatment bundle、模型规模和两者 interaction，并追踪差异究竟发生在 bootstrap、Stage-2 gate、参数更新还是最终评测；不把 bundle 差异误写成纯 MiniMax 因果效应。','Compare self versus MiniMax treatment bundles, model scale, and their interaction, then trace differences through bootstrap, Stage-2 admission, parameter updates, and final evaluation without mislabeling the bundle contrast as a pure MiniMax causal effect.')}</p><a href={p('/research/seed-openevo/study/results/four-arm-analysis/')}>{t('打开四组方案 →','Open four-arm plan →')}</a></div></li>
  </ol>
</section>
<style>
.analysis-plan-index{max-width:1160px;margin:0 auto;padding:38px 24px;border-top:1px solid var(--color-border)}.analysis-plan-index__eyebrow{margin:0;color:var(--color-accent);font:800 .68rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.analysis-plan-index__intro{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:2rem;margin-top:.45rem}.analysis-plan-index h2{margin:0;font-size:clamp(1.45rem,3vw,2.35rem);letter-spacing:-.03em}.analysis-plan-index__intro p{margin:.2rem 0 0;color:var(--color-text-muted);line-height:1.65}.analysis-plan-index ol{list-style:none;margin:1.4rem 0 0;padding:0;border-top:1px solid var(--color-border)}.analysis-plan-index li{display:grid;grid-template-columns:64px minmax(0,1fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-border)}.analysis-plan-index li>span{color:var(--color-accent);font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace}.analysis-plan-index h3{margin:0;font-size:1rem}.analysis-plan-index li p{max-width:76ch;margin:.35rem 0;color:var(--color-text-muted);font-size:.82rem;line-height:1.55}.analysis-plan-index a{color:var(--color-accent);font-size:.8rem;font-weight:760;text-decoration:none}.analysis-plan-index a:hover{text-decoration:underline}@media(max-width:720px){.analysis-plan-index{padding-inline:18px}.analysis-plan-index__intro{grid-template-columns:1fr;gap:.6rem}.analysis-plan-index li{grid-template-columns:44px minmax(0,1fr)}}
</style>
