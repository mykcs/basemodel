---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const pages = [
  { n:'01', title:t('7B / self：主实验与 GPU 训练保存点分析均已完成','7B / self: main run and GPU checkpoint analysis complete'), text:t('固定的 128 个任务已经覆盖初始模型和每次 Stage-1 参数更新后的保存点：训练目标误差（loss）持续下降，但 WebShop 能力会中途回落；第 8 次更新后的最终保存点得分最高，为 25.66，而真正完整成功只从 3/128 增到 4/128。','The full 128-task checkpoint sweep is filled: loss falls continuously while capability is non-monotonic, final increment-07 at 25.66 is best, and exact success only moves from 3/128 to 4/128.'), href:'/research/seed-openevo/study/results/7b-self-analysis/' },
  { n:'02', title:t('3B / self：历史实验已封存','3B / self: historical arm sealed'), text:t('Stage 1 与旧 Stage 2 都没有产生参数更新；旧 Stage 2 完成 20,480 次任务并得到 138 条可训练完整成功轨迹。最终 128 任务已经封存：Task Score ×100 = 1.71，完整成功 1/128，技术有效 121/128。','Stage 1 and the old Stage 2 both made zero parameter updates; old Stage 2 completed 20,480 attempts and produced 138 trainable exact-success traces. The 128-task final is sealed: Task Score ×100 = 1.71, exact success 1/128, valid episodes 121/128.'), href:'/research/seed-openevo/study/results/3b-self-analysis/' },
  { n:'03', title:t('3B / MiniMax：旧方法在 74.58% 时停止','3B / MiniMax: old method stopped at 74.58%'), text:t('MiniMax 只在完整任务结束后回看轨迹。启动训练完成 8 次参数更新；旧 Stage 2 完成 59 个完整批次并保留第 60 批的 171 次 partial 尝试，Stage 2 参数更新仍为 0。final evaluation 明确未运行，不是 Pending，也不是 0 分。','MiniMax analyzes trajectories only after completed episodes. Bootstrap made eight parameter updates; old Stage 2 completed 59 full batches and preserved 171 partial attempts from batch 60, with zero Stage-2 parameter updates. Final evaluation was explicitly not run; it is neither Pending nor a score of zero.'), href:'/research/seed-openevo/study/results/3b-minimax-analysis/' },
  { n:'04', title:t('7B / MiniMax：历史实验已封存','7B / MiniMax: historical arm sealed'), text:t('MiniMax 只在任务结束后回看轨迹。启动训练完成 8 次参数更新；旧 Stage 2 完成 20,480 次任务并得到 592 条可训练完整成功轨迹，但 Stage 2 参数更新为 0。封存 final 为 Task Score ×100 = 16.94、完整成功 0/128、技术有效 116/128。','MiniMax analyzes trajectories only after episodes finish. Bootstrap made eight parameter updates; old Stage 2 completed 20,480 attempts and produced 592 trainable exact-success traces, with zero Stage-2 parameter updates. The sealed final records Task Score ×100 = 16.94, exact success 0/128, and 116/128 valid episodes.'), href:'/research/seed-openevo/study/results/7b-minimax-analysis/' },
  { n:'05', title:t('四组联合：三个 final 已封存，一个明确未运行','Four-arm joint: three sealed finals, one explicitly not run'), text:t('3B/self、7B/self、7B/MiniMax 已有封存 final；3B/MiniMax 在 74.58% 时停止，final 未运行。因此组间页面只计算证据完整的比较，并把缺少 3B/MiniMax final 的对比明确标成不可计算。','3B/self, 7B/self, and 7B/MiniMax have sealed finals; 3B/MiniMax stopped at 74.58% and its final was not run. The cross-arm page therefore computes only evidence-complete comparisons and marks contrasts requiring the missing 3B/MiniMax final as unavailable.'), href:'/research/seed-openevo/study/results/four-arm-analysis/' },
];
---
<section class="analysis-plan-index" aria-labelledby="analysis-plan-index-title">
  <p class="analysis-plan-index__eyebrow">{t('OpenEvo 基础能力探索实验 · 五个页面', 'OPENEVO CAPABILITY EXPLORATION · FIVE PAGES')}</p>
  <div class="analysis-plan-index__intro">
    <h2 id="analysis-plan-index-title">{t('原先预注册的问题保留；已经封口的结果按最终状态展示', 'Keep the preregistered questions; show closed runs in their final states')}</h2>
    <p>{t('四个单实验页面和一个组间页面仍保留原先预注册的问题，但运行状态已经更新：3B/self、7B/self、7B/MiniMax 的 final 已封存；3B/MiniMax 的 final 明确未运行。MiniMax 仍只表示完整任务结束后的外部回看分析者，不是 WebShop actor。','The four arm pages and cross-arm page keep the preregistered questions, but their run states are now updated: 3B/self, 7B/self, and 7B/MiniMax have sealed finals, while the 3B/MiniMax final was explicitly not run. MiniMax remains a post-episode external analyzer, not the WebShop actor.')}</p>
  </div>
  <ol>
    {pages.map((item) => <li><span>{item.n}</span><div><h3>{item.title}</h3><p>{item.text}</p><a href={p(item.href)}>{t('打开结果页 →','Open result page →')}</a></div></li>)}
  </ol>
</section>
<style>
.analysis-plan-index{max-width:1160px;margin:0 auto;padding:38px 24px;border-top:1px solid var(--color-border)}.analysis-plan-index__eyebrow{margin:0;color:var(--color-accent);font:800 .68rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.analysis-plan-index__intro{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:2rem;margin-top:.45rem}.analysis-plan-index h2{margin:0;font-size:clamp(1.45rem,3vw,2.35rem);letter-spacing:-.03em}.analysis-plan-index__intro p{margin:.2rem 0 0;color:var(--color-text-muted);line-height:1.65}.analysis-plan-index ol{list-style:none;margin:1.4rem 0 0;padding:0;border-top:1px solid var(--color-border)}.analysis-plan-index li{display:grid;grid-template-columns:64px minmax(0,1fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-border)}.analysis-plan-index li>span{color:var(--color-accent);font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace}.analysis-plan-index h3{margin:0;font-size:1rem}.analysis-plan-index li p{max-width:76ch;margin:.35rem 0;color:var(--color-text-muted);font-size:.82rem;line-height:1.55}.analysis-plan-index a{color:var(--color-accent);font-size:.8rem;font-weight:760;text-decoration:none}.analysis-plan-index a:hover{text-decoration:underline}@media(max-width:720px){.analysis-plan-index{padding-inline:18px}.analysis-plan-index__intro{grid-template-columns:1fr;gap:.6rem}.analysis-plan-index li{grid-template-columns:44px minmax(0,1fr)}}
</style>
