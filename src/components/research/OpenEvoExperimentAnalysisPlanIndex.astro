---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const pages = [
  { n:'01', title:t('7B / self：主实验与 GPU 训练保存点分析均已完成','7B / self: main run and GPU checkpoint analysis complete'), text:t('固定的 128 个任务已经覆盖初始模型和每次 Stage-1 参数更新后的保存点：训练目标误差（loss）持续下降，但 WebShop 能力会中途回落；第 8 次更新后的最终保存点得分最高，为 25.66，而真正完整成功只从 3/128 增到 4/128。','The full 128-task checkpoint sweep is filled: loss falls continuously while capability is non-monotonic, final increment-07 at 25.66 is best, and exact success only moves from 3/128 to 4/128.'), href:'/research/seed-openevo/study/results/7b-self-analysis/' },
  { n:'02', title:t('3B / self：无外部教师','3B / self: no external teacher'), text:t('先固定 3B 启动学习困难、Stage 2 自主探索、最终评测、动作技术有效性和失败类型的结果位置；实验尚未正式收尾的数字一律写成“尚无最终结果（Pending）”，不能用 0 代替。','Pre-build result slots for 3B bootstrap difficulty, Stage 2, final evaluation, action validity, and failure taxonomy; unfinished numbers remain Pending.'), href:'/research/seed-openevo/study/results/3b-self-analysis/' },
  { n:'03', title:t('3B / MiniMax：有老师（完整任务结束后回看分析）','3B / MiniMax: teacher shorthand, post-episode analysis'), text:t('这里的 MiniMax 是一次完整任务结束后才回看轨迹的外部分析老师，不替学生模型在 WebShop 里行动。页面提前准备“启动训练是否发生、Stage 2 有多少不同任务能重复成功、最终评测表现如何”三个证据位置。','MiniMax is a post-episode hindsight analyzer rather than the WebShop actor. The page pre-builds evidence slots for bootstrap, Stage-2 coverage, and the final result.'), href:'/research/seed-openevo/study/results/3b-minimax-analysis/' },
  { n:'04', title:t('7B / MiniMax：有老师（完整任务结束后回看分析）','7B / MiniMax: teacher shorthand, post-episode analysis'), text:t('7B 不靠外部老师本来就能启动参数学习，因此重点比较“任务后回看监督究竟改变了后续自主探索，还是改变了最终做题能力”。','Because 7B can already self-bootstrap, the page reserves the key comparison: whether external hindsight changes later exploration or final capability.'), href:'/research/seed-openevo/study/results/7b-minimax-analysis/' },
  { n:'05', title:t('四组联合：组间实验','Four-arm joint: cross-arm experiments'), text:t('先把 3B/7B × self/MiniMax 的六个比较问题、结果矩阵和回填规则固定下来；四组没齐之前不计算漂亮但不可靠的差值。','Freeze six cross-arm questions, the result matrix, and fill-in rules for 3B/7B × self/MiniMax; do not compute attractive but unreliable contrasts before all arms are ready.'), href:'/research/seed-openevo/study/results/four-arm-analysis/' },
];
---
<section class="analysis-plan-index" aria-labelledby="analysis-plan-index-title">
  <p class="analysis-plan-index__eyebrow">{t('OpenEvo 基础能力探索实验 · 五个页面', 'OPENEVO CAPABILITY EXPLORATION · FIVE PAGES')}</p>
  <div class="analysis-plan-index__intro">
    <h2 id="analysis-plan-index-title">{t('先固定我们要回答什么，再等服务器把数字送回来', 'Freeze the questions first; let server evidence fill the numbers later')}</h2>
    <p>{t('四个单实验页面和一个组间页面现在共用同一规则：已有结果正常展示；未完成的数字明确写“尚无最终结果（Pending）”，不能填成 0；MiniMax 明确写成“完整任务结束后的外部回看分析老师”；只有正式封存的实验产物或收尾记录里已经确认的最终结果，才能替换这些空位。','Four single-arm pages and one cross-arm page now share one rule: show existing results, mark unfinished numbers as Pending, describe MiniMax precisely as a post-episode external analyzer, and replace empty slots only with sealed artifacts or closeout finals.')}</p>
  </div>
  <ol>
    {pages.map((item) => <li><span>{item.n}</span><div><h3>{item.title}</h3><p>{item.text}</p><a href={p(item.href)}>{t('打开结果页 →','Open result page →')}</a></div></li>)}
  </ol>
</section>
<style>
.analysis-plan-index{max-width:1160px;margin:0 auto;padding:38px 24px;border-top:1px solid var(--color-border)}.analysis-plan-index__eyebrow{margin:0;color:var(--color-accent);font:800 .68rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.analysis-plan-index__intro{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:2rem;margin-top:.45rem}.analysis-plan-index h2{margin:0;font-size:clamp(1.45rem,3vw,2.35rem);letter-spacing:-.03em}.analysis-plan-index__intro p{margin:.2rem 0 0;color:var(--color-text-muted);line-height:1.65}.analysis-plan-index ol{list-style:none;margin:1.4rem 0 0;padding:0;border-top:1px solid var(--color-border)}.analysis-plan-index li{display:grid;grid-template-columns:64px minmax(0,1fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-border)}.analysis-plan-index li>span{color:var(--color-accent);font:800 .72rem ui-monospace,SFMono-Regular,Menlo,monospace}.analysis-plan-index h3{margin:0;font-size:1rem}.analysis-plan-index li p{max-width:76ch;margin:.35rem 0;color:var(--color-text-muted);font-size:.82rem;line-height:1.55}.analysis-plan-index a{color:var(--color-accent);font-size:.8rem;font-weight:760;text-decoration:none}.analysis-plan-index a:hover{text-decoration:underline}@media(max-width:720px){.analysis-plan-index{padding-inline:18px}.analysis-plan-index__intro{grid-template-columns:1fr;gap:.6rem}.analysis-plan-index li{grid-template-columns:44px minmax(0,1fr)}}
</style>
