---
import { type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
---

<section id="fig-webshop-dataset" class="canonical-figure webshop-dataset" aria-labelledby="webshop-dataset-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">FIGURE S1-B · ORIGINAL WEBSHOP DATASET</div>
    <h2 id="webshop-dataset-title">{t('原始 WebShop 数据集有多大？','How large is the original WebShop dataset?')}</h2>
    <p>{t('先只看 WebShop 自己：一个商品世界，以及一组按 Train / Dev / Test 划分的购物任务。','Look only at WebShop itself first: one product world and shopping tasks divided into Train, Dev, and Test.')}</p>
  </header>
  <figure class="dataset-world" aria-labelledby="webshop-dataset-title">
    <article class="product-warehouse" data-ui-audit-item><small>ORIGINAL PRODUCT WORLD</small><strong>1,181,436</strong><span>{t('products · 商品','products')}</span></article>
    <div class="dataset-arrow" aria-hidden="true">→</div>
    <section class="task-world" aria-label={t('WebShop 任务划分','WebShop task splits')}>
      <header><small>WEBSHOP TASKS</small><strong>12,087</strong><span>{t('shopping instructions / tasks','shopping instructions / tasks')}</span></header>
      <div class="task-splits">
        <article data-ui-audit-item><small>TRAIN</small><strong>10,587</strong><span>{t('训练题','training tasks')}</span></article>
        <article data-ui-audit-item><small>DEV</small><strong>1,000</strong><span>{t('开发 / 练习考试','development / practice')}</span></article>
        <article data-ui-audit-item><small>TEST</small><strong>500</strong><span>{t('最终测试','final test')}</span></article>
      </div>
    </section>
    <figcaption>{t('这是 Original WebShop 的规模与官方任务划分；它不描述任何一种训练方法。','These are the Original WebShop scale and official task splits; they do not describe any learning method.')}</figcaption>
  </figure>
</section>

<style>
  .webshop-dataset{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:780px}.figure-label{color:var(--accent);font:800 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.7rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:1.65}
  .dataset-world{display:grid;grid-template-columns:minmax(210px,.7fr) auto minmax(0,1.3fr);gap:1rem;align-items:center;margin:1.45rem 0 0}.product-warehouse,.task-world{padding:clamp(.9rem,2vw,1.35rem);border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}.product-warehouse{border-top:5px solid var(--accent)}.product-warehouse small,.product-warehouse span,.task-world small,.task-world span{display:block;color:var(--muted);font-size:.68rem;line-height:1.45}.product-warehouse strong,.task-world>header strong{display:block;margin:.5rem 0 .18rem;font-size:clamp(2rem,5vw,4rem);line-height:.92;letter-spacing:-.06em}.dataset-arrow{color:var(--accent);font-size:2rem;font-weight:800}.task-world>header{padding-bottom:.95rem;border-bottom:1px solid var(--line)}.task-splits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;padding-top:.8rem}.task-splits article{min-width:0;padding:.65rem;border-left:3px solid var(--line);background:var(--surface)}.task-splits article:first-child{border-color:var(--accent)}.task-splits article:last-child{border-color:var(--success)}.task-splits strong{display:block;margin:.3rem 0;font-size:1.25rem}.dataset-world figcaption{grid-column:1/-1;color:var(--muted);font-size:.78rem;line-height:1.55}
  @media(max-width:700px){.dataset-world{grid-template-columns:1fr}.dataset-arrow{justify-self:center;transform:rotate(90deg)}.task-splits{grid-template-columns:1fr}.webshop-dataset{width:min(100% - 1rem,1120px);padding:1rem}}
</style>
