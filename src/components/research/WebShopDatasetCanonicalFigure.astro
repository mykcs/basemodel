---
import { type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (cn: string, en: string) => locale === 'zh' ? cn : en;
---
<section id="fig-webshop-dataset" class="canonical-figure webshop-dataset" aria-labelledby="webshop-dataset-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">{t('第一步 · 原始 WEBSHOP', 'STEP 1 · ORIGINAL WEBSHOP')}</div>
    <h3 id="webshop-dataset-title">{t('原始 WebShop：1,181,436 个商品与 12,087 条人工购物指令', 'Original WebShop: 1,181,436 products and 12,087 human shopping instructions')}</h3>
    <p>{t('原始 WebShop 同时包含商品资料和人写的购物要求。两者是不同单位；后面 SEED 使用的 small 环境又是另一套任务生成方式。', 'Original WebShop contains both product records and human-written shopping instructions. They are different units; the small environment used later generates tasks differently.')}</p>
  </header>
  <figure class="dataset-world" aria-labelledby="webshop-dataset-title">
    <div class="dataset-columns">
      <section class="product-ledger" aria-label={t('商品目录', 'Product catalog')} data-ui-audit-item>
        <span class="ledger-kicker">{t('商店里的商品资料', 'SHOP INVENTORY')}</span>
        <strong>1,181,436</strong>
        <p>{t('件商品：标题、属性、描述、选项等，可用于搜索和购买。', 'Product records: titles, attributes, descriptions and options used for search and purchase.')}</p>
      </section>
      <div class="dataset-plus" aria-hidden="true">＋</div>
      <section class="instruction-ledger" aria-label={t('人写的购物指令', 'Human-written shopping instructions')} data-ui-audit-item>
        <span class="ledger-kicker">{t('人写给 Agent 的购买要求', 'HUMAN SHOPPING REQUESTS')}</span>
        <strong>12,087</strong>
        <p>{t('条人工购物指令（crowd-sourced text instructions）。它们被整理成训练、开发、测试三组，不是由左侧商品数量直接相乘得来。', 'Crowd-sourced instructions split into training, development and test sets; they are not simply multiplied from the item count.')}</p>
        <dl class="task-splits">
          <div><dt>Train</dt><dd>10,587</dd></div>
          <div><dt>Dev</dt><dd>1,000</dd></div>
          <div><dt>Test</dt><dd>500</dd></div>
        </dl>
      </section>
    </div>
    <figcaption>{t('“商品”和“购物指令”是原始 WebShop 并存的两类数据。＋ 表示同时存在，并不是从 1,181,436 件商品生成 12,087 条人工指令。', 'Products and human shopping instructions are two parallel units in original WebShop. The plus sign means both exist; it is not a generation arrow.')}</figcaption>
  </figure>
</section>
<style>
  .webshop-dataset{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:860px}.figure-label{color:var(--accent);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-heading) var(--font-interface);letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.7rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:var(--type-leading-body)}
  .dataset-world{display:grid;grid-template-columns:minmax(210px,.7fr) auto minmax(0,1.3fr);gap:1rem;align-items:center;margin:1.45rem 0 0}.product-warehouse,.task-world{padding:clamp(.9rem,2vw,1.35rem);border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}.product-warehouse{border-top:5px solid var(--accent)}.product-warehouse small,.product-warehouse span,.task-world small,.task-world span{display:block;color:var(--muted);font-size:.68rem;line-height:1.45}.product-warehouse strong,.task-world>header strong{display:block;margin:.5rem 0 .18rem;font-size:clamp(2rem,5vw,4rem);line-height:.92;letter-spacing:-.06em}.dataset-arrow{color:var(--muted);font-size:1.75rem;font-weight:800}.task-world>header{padding-bottom:.95rem;border-bottom:1px solid var(--line)}.task-splits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;padding-top:.8rem}.task-splits article{min-width:0;padding:.65rem;border-left:3px solid var(--line);background:var(--surface)}.task-splits article:first-child{border-color:var(--accent)}.task-splits article:last-child{border-color:var(--success)}.task-splits strong{display:block;margin:.3rem 0;font-size:1.25rem}.dataset-world figcaption{grid-column:1/-1;color:var(--muted);font-size:var(--type-caption);line-height:var(--type-leading-caption)}
  :global(.evo-approved-reader) .dataset-world{grid-template-columns:minmax(0,1fr)}
  :global(.evo-approved-reader) .dataset-arrow{justify-self:center}
  @media(max-width:700px){.dataset-world{grid-template-columns:1fr}.dataset-arrow{justify-self:center}.task-splits{grid-template-columns:1fr}.webshop-dataset{width:min(100% - 1rem,1120px);padding:1rem}}
</style>
