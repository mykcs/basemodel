---
const root = '/research/seed-openevo/results';

const canonicalReferences = [
  {
    href: '/research/seed-openevo/webshop/',
    label: 'WebShop',
    title: '任务、交互与评分',
    body: 'WebShop 自己负责解释 instruction、网页 observation、search / click / option / buy、Score 与 exact Success。',
  },
  {
    href: '/research/seed-openevo/seed/#fig-seed-webshop',
    label: 'Figure S1',
    title: 'SEED × WebShop：数据、训练与推理',
    body: '正式框架图：官方 split、SEED 实际训练 / 评估子集、Stage 1、Stage 2、🔥 / ❄️ / ⊥ 与 inference boundary。',
  },
  {
    href: '/research/seed-openevo/openevo/',
    label: 'OpenEvo',
    title: '跨任务演化机制',
    body: 'OpenEvo 自己负责解释 task boundary、sealed evidence、evolution carrier、validation 与 successor revision。',
  },
  {
    href: '/research/seed-openevo/loops/#fig-seed-openevo-update-target',
    label: 'Figure C1',
    title: 'SEED 与 OpenEvo：经验最后改了什么',
    body: '跨 benchmark 可复用的正式比较图：SEED 更新 policy；OpenEvo 通过不同 carrier 形成 validated successor state。',
  },
  {
    href: '/papers/seed/',
    label: 'Paper',
    title: 'SEED 论文与来源',
    body: '需要核对原始方法、实验表格或论文来源时，从论文页进入。',
  },
] as const;

const resultArticles = [
  {
    index: '04',
    href: `${root}/why-it-kept-failing/`,
    title: '为什么我们前面一直没有得到可靠的 fresh-task 提升？',
    body: '从 3B 到 7B、从 parser / fallback 到冻结配对面板：把一连串“跑通了但不能下结论”的实验放回同一条证据链。',
    tag: '失败与校准',
  },
  {
    index: '05',
    href: `${root}/first-positive-transfer/`,
    title: '第一次正结果：什么时候第一次看到可迁移收益？',
    body: 'H1.38B continuation 中，SD-LoRA 对 BASE 的 fresh-task delta 为 +0.124，95% CI [0.0326, 0.2194]；这是后续独立复现的起点。',
    tag: '第一次正结果',
  },
  {
    index: '06',
    href: `${root}/independent-replication/`,
    title: '独立复现：换一批全新 WebShop 任务以后，提升还在吗？',
    body: 'H1.39-MR 冻结训练产物后换到独立新任务面板；ordinary 与 SD 两条更新路线都高于同一个 BASE，其中 SD − BASE 为 +0.248845。',
    tag: '最强证据',
  },
  {
    index: '07',
    href: `${root}/second-generation/`,
    title: '第二次连续写入：为什么还不能说“多代自进化”成立？',
    body: '第二轮有足够成功经验，也真实完成了 G2 参数写入，但 acquisition、retention 与上一轮收益 preservation 的上游门没有一起通过。',
    tag: '连续写入',
  },
  {
    index: '08',
    href: `${root}/measurement-boundary/`,
    title: 'H1.42：为什么修完测量器以后，机制比较仍然不能下结论？',
    body: 'Stage A 通过 measurement calibration；Stage B 修正 validator 语义后仍保留两个 parser/runtime-invalid clusters，selector 最终为 MVD0。',
    tag: '测量边界',
  },
  {
    index: '09',
    href: `${root}/current-conclusion/`,
    title: '现在到底能下什么结论？什么还不能说？',
    body: '把 supported、negative、invalid 和 still unknown 分开：当前支持一次可复现跨任务迁移，但不支持已经建立多代 self-evolution。',
    tag: '结论边界',
  },
] as const;

const designArticles = [
  {
    index: '10',
    href: `${root}/benchmark-first/`,
    title: '先跑真正的比赛：为什么 Benchmark 必须回到主线',
    body: '旧 H1 不是废实验，而是 mechanism studies。主线先回答同一个 Qwen2.5-3B 加入 OpenEvo 后，最终未见任务成绩到底有没有提高。',
    tag: '研究重分层',
  },
  {
    index: '11',
    href: `${root}/seed-faithful-benchmark/`,
    title: '一场公平的 WebShop 比赛应该怎么跑？',
    body: '把 500–6909 训练池、0–499 test pool、冻结 128 test、Score / Success、19,200-episode Stage-2 budget 与 test-time no-learning rule 一次钉死。',
    tag: 'Benchmark 协议',
  },
  {
    index: '12',
    href: `${root}/openevo-benchmark-design/`,
    title: 'OpenEvo 到底该进化什么？Native、Param、Sparse 与 Dense 怎么分',
    body: '把 carrier 和 feedback density 拆成两个轴；先做 OpenEvo-Native-Sparse 公平比较，再把 Dense feedback 与参数内化作为可解释扩展。',
    tag: '下一阶段设计',
  },
] as const;
---

<div class="result-index" data-testid="openevo-webshop-result-index">
  <header class="index-hero">
    <p class="eyebrow">OPENEVO × WEBSHOP · EXPERIMENT EVIDENCE</p>
    <h1>实验结果页只讲实验；方法和环境回到各自的正式页面</h1>
    <p class="lede">这里不再重复解释 WebShop、SEED 或 OpenEvo。读实验前需要的概念只保留权威入口；随后直接沿证据链阅读已经完成的结果，再进入下一轮 benchmark 设计。</p>
  </header>

  <nav class="reference-index" aria-labelledby="reference-title">
    <div class="result-section-heading compact-heading">
      <p>REFERENCE</p>
      <div>
        <h2 id="reference-title">先建立共同语言：需要时再打开这些正式说明</h2>
        <p>一个概念只保留一个 canonical explanation；实验文章通过稳定 URL / Figure anchor 引用它，不再复制前景概要。</p>
      </div>
    </div>
    <div class="reference-grid">
      {canonicalReferences.map((item) => (
        <a href={item.href} class="reference-card">
          <small>{item.label}</small>
          <strong>{item.title}</strong>
          <span>{item.body}</span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </nav>

  <section class="index-section" aria-labelledby="results-title">
    <div class="result-section-heading">
      <p>PART I</p>
      <div>
        <h2 id="results-title">按证据链读已经完成的实验</h2>
        <p>不是按实验编号堆日志，而是按“为什么失败 → 第一次正结果 → 独立复现 → 第二代为什么没过 → 测量边界 → 现在能说什么”组织。</p>
      </div>
    </div>

    <div class="article-list">
      {resultArticles.map((article) => (
        <a href={article.href} class="result-card">
          <div class="result-number">{article.index}</div>
          <div class="result-copy">
            <div class="result-meta"><small>{article.tag}</small></div>
            <h3>{article.title}</h3>
            <p>{article.body}</p>
          </div>
          <strong aria-hidden="true">→</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="index-section" aria-labelledby="design-title">
    <div class="result-section-heading">
      <p>PART II</p>
      <div>
        <h2 id="design-title">把主问题重新拉回 Benchmark</h2>
        <p>这三篇不是新的实验结果，而是下一阶段的研究重分层：先跑真正的正式比赛，再用旧 H1 系列解释为什么结果会是这样。</p>
      </div>
    </div>

    <div class="article-list">
      {designArticles.map((article) => (
        <a href={article.href} class="result-card design-card">
          <div class="result-number">{article.index}</div>
          <div class="result-copy">
            <div class="result-meta"><small>{article.tag}</small></div>
            <h3>{article.title}</h3>
            <p>{article.body}</p>
          </div>
          <strong aria-hidden="true">→</strong>
        </a>
      ))}
    </div>
  </section>

  <details class="legacy-primer-links">
    <summary>旧的三篇前景笔记链接</summary>
    <p>这些 URL 为了旧引用继续保留，但内容已经迁移到上面的 canonical 页面。</p>
    <div><a href={`${root}/webshop-training/`}>旧 WebShop 前景笔记</a><a href={`${root}/seed-training/`}>旧 SEED 前景笔记</a><a href={`${root}/openevo-training/`}>旧 OpenEvo 前景笔记</a></div>
  </details>
</div>

<style>
  .result-index{max-width:1180px;margin:0 auto;padding:26px 24px 72px;color:var(--color-text)}
  .index-hero{max-width:920px;padding:34px 0 44px}.eyebrow{margin:0 0 18px;color:var(--color-text-muted);font-size:.75rem;font-weight:700;letter-spacing:.14em}.index-hero h1{margin:0;max-width:900px;font-size:clamp(2.25rem,5vw,4.8rem);line-height:1.02;letter-spacing:-.055em;color:var(--color-text)}.lede{max-width:780px;margin:24px 0 0;color:var(--color-text-muted);font-size:1.04rem;line-height:1.75}
  .reference-index,.index-section{padding:34px 0 42px;border-top:1px solid var(--color-border)}.result-section-heading{display:grid;grid-template-columns:150px minmax(0,720px);gap:28px;margin-bottom:24px;align-items:start;width:100%;min-width:0}.compact-heading{margin-bottom:18px}.result-section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:700;letter-spacing:.14em}.result-section-heading>div{min-width:0}.result-section-heading h2{margin:0 0 8px;max-width:22ch;font-size:clamp(1.55rem,3vw,2.45rem);line-height:1.12;letter-spacing:-.035em;overflow-wrap:normal;word-break:normal}.result-section-heading div>p{margin:0;max-width:62ch;color:var(--color-text-muted);font-size:.94rem;line-height:1.65}
  .reference-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.reference-card{position:relative;display:flex;min-height:190px;flex-direction:column;padding:16px;border:1px solid var(--color-border);border-radius:12px;background:var(--color-surface);color:var(--color-text);text-decoration:none;transition:transform .18s ease,border-color .18s ease}.reference-card:hover,.reference-card:focus-visible,.result-card:hover,.result-card:focus-visible{transform:translateY(-2px);border-color:var(--color-accent)}.reference-card small{color:var(--color-accent);font:700 .7rem ui-monospace,SFMono-Regular,Menlo,monospace}.reference-card strong{margin:16px 0 8px;font-size:.96rem;line-height:1.32}.reference-card span{color:var(--color-text-muted);font-size:.79rem;line-height:1.55}.reference-card b{margin-top:auto;padding-top:14px;color:var(--color-accent)}
  .article-list{display:grid;gap:10px}.result-card{display:grid;grid-template-columns:64px minmax(0,1fr) 28px;gap:20px;align-items:start;padding:22px;border:1px solid var(--color-border);border-radius:14px;background:var(--color-bg);color:var(--color-text);text-decoration:none;transition:transform .18s ease,border-color .18s ease,background .18s ease}.design-card{background:var(--color-surface)}.result-number{color:var(--color-text-muted);font:600 .8rem ui-monospace,SFMono-Regular,Menlo,monospace}.result-meta{margin-bottom:10px}.result-meta small{display:inline-block;padding:4px 8px;border:1px solid var(--color-border);border-radius:999px;color:var(--color-accent);font-size:.72rem}.result-card h3{margin:0 0 12px;color:var(--color-text);font-size:1.22rem;line-height:1.36;letter-spacing:-.02em}.result-card p{margin:0;color:var(--color-text-muted);font-size:.9rem;line-height:1.65}.result-card>strong{align-self:center;color:var(--color-accent);font-size:1.15rem}
  .legacy-primer-links{margin-top:8px;padding:14px 0;border-top:1px solid var(--color-border);color:var(--color-text-muted);font-size:.8rem}.legacy-primer-links summary{cursor:pointer;color:var(--color-text);font-weight:650}.legacy-primer-links p{margin:10px 0 8px}.legacy-primer-links div{display:flex;gap:12px;flex-wrap:wrap}.legacy-primer-links a{color:var(--color-accent)}
  @media(max-width:1080px){.reference-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:760px){.result-section-heading{grid-template-columns:1fr;gap:8px}.result-section-heading h2{max-width:none}.reference-grid{grid-template-columns:1fr}.reference-card{min-height:auto}.result-card{grid-template-columns:42px minmax(0,1fr) 20px;gap:12px}.result-index{padding-inline:18px}.index-hero{padding-top:20px}}
</style>
