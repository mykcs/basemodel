---
const root = '/research/seed-openevo/results';

const references = [
  {
    href: '/research/seed-openevo/openevo/',
    label: 'OpenEvo',
    title: 'OpenEvo 是什么、怎么更新',
    body: '跨任务演化、experience carrier（经验载体）、参数更新与 successor revision（后继版本）统一放在方法页。',
  },
  {
    href: '/research/seed-openevo/webshop/',
    label: 'WebShop',
    title: 'WebShop 环境与 SEED 任务划分',
    body: '1000 products、6910 synthetic goals（合成任务）、0–499 / 500–6909 划分、seed 与评分规则统一放在环境页。',
  },
  {
    href: '/research/seed-openevo/seed/',
    label: 'SEED',
    title: 'SEED 方法与训练循环',
    body: 'SEED 的 hindsight skill、SFT、GRPO 与训练 / 推理边界由 SEED 方法页解释。',
  },
  {
    href: '/research/seed-openevo/experiment/',
    label: 'Experiment',
    title: '实验代码、状态与复现入口',
    body: 'campaign（实验批次）、manifest（任务清单）、运行代码、reconciliation（实验对账）与下一轮协议放在实验入口。',
  },
] as const;

const questions = [
  {
    id: 'q1',
    index: '01',
    question: 'OpenEvo 真的发生了学习吗？',
    answer: '发生了。训练、参数变化、adapter（适配器）保存与重新加载链路都实际工作；但“参数变了”不能直接等价为“WebShop 做得更好”。',
    status: '已建立',
    evidence: 'Phase G / adapter lifecycle（适配器生命周期）与后续冻结评估链路',
    href: `${root}/why-it-kept-failing/`,
  },
  {
    id: 'q2',
    index: '02',
    question: 'OpenEvo 有没有成功经验可以学习？',
    answer: '有。Base model（基础模型）能够自然产生成功轨迹；H0 的正式矩阵中有 128 次尝试、96 次科学有效、28 条 qualified positive（合格正向经验）。',
    status: '已建立',
    evidence: 'H0 / H0.1 natural-success evidence（自然成功证据）',
    href: 'https://github.com/mykcs/openevo-experiment/blob/main/docs/evidence/remote-runs/2026-08-15/h0-final/evidence/h0-final-reconciliation.json',
  },
  {
    id: 'q3',
    index: '03',
    question: '有成功经验以后，OpenEvo 能把它学进去吗？',
    answer: '能学进去，但训练拟合与闭环任务收益不是同一件事。成功监督可以改变训练目标与模型行为，却不保证新的 WebShop episode（完整任务回合）马上变好。',
    status: '部分建立',
    evidence: 'H1.11 / H1.13 等 fit-versus-behavior（拟合与行为）实验',
    href: `${root}/why-it-kept-failing/`,
  },
  {
    id: 'q4',
    index: '04',
    question: '学到的经验能迁移到新的任务吗？',
    answer: '不是自动发生，但可以发生。H1.38B 首次得到可靠正向信号，H1.39 又在独立任务组上复现。这里属于 OpenEvo internal fresh task-ID-disjoint evaluation（OpenEvo 内部新任务、任务 ID 不重叠评估），不是 SEED official held-out evaluation（SEED 官方保留任务评估）。',
    status: '可复现，但有边界',
    evidence: 'H1.38B → H1.39 independent replication（独立复现）',
    href: `${root}/independent-replication/`,
  },
  {
    id: 'q5',
    index: '05',
    question: '第一代能迁移，是否意味着可以一直越学越好？',
    answer: '目前不能这样说。H1.40 里新的成功经验充足，G2 adapter（第二代适配器）也真实建立，但 acquisition（新知识获取）、retention（旧知识保持）与 preservation（已有收益保持）没有一起通过，因此 T2 没有打开。',
    status: '尚未建立',
    evidence: 'H1.40 continual-integration gates（持续整合门槛）',
    href: `${root}/second-generation/`,
  },
  {
    id: 'q6',
    index: '06',
    question: '现在真正可以下什么结论？',
    answer: 'OpenEvo 已经建立“成功经验 → 参数更新 → 特定条件下的第一代新任务迁移”这条链；但稳定多代 self-evolution（自进化）、SEED 官方保留任务结果以及 OpenEvo 优于 SEED，都还不能声称成立。',
    status: '结论边界',
    evidence: 'sealed results（封存结果）+ program ledger（实验总账）',
    href: `${root}/current-conclusion/`,
  },
  {
    id: 'q7',
    index: '07',
    question: '最后还缺哪一个关键实验？',
    answer: '缺一场真正的 SEED-compatible fair comparison（与 SEED 严格兼容的公平比较）：训练仍来自 500–6909，正式评估只使用 0–499，并让 OpenEvo / SEED 在相同任务身份、seed 与评分协议下比较。',
    status: '待补',
    evidence: 'H1.30 正式比较没有启动；formal evaluation denominator（正式评估分母）= 0',
    href: '/research/seed-openevo/experiment/',
  },
] as const;

const deepDives = [
  {
    href: `${root}/why-it-kept-failing/`,
    title: '早期为什么一直没有可靠迁移',
    body: '把 parser（动作解析）、horizon（交互步数）、carrier（经验载体）、标签与执行有效性等诊断压回证据层。',
  },
  {
    href: `${root}/first-positive-transfer/`,
    title: 'H1.38B：第一次可靠正向迁移',
    body: '查看第一次置信区间完全位于 0 以上的 internal fresh-task transfer（内部新任务迁移）结果。',
  },
  {
    href: `${root}/independent-replication/`,
    title: 'H1.39：独立复现',
    body: '冻结训练产物、更换新的 task-ID-disjoint panel（任务 ID 不重叠评估组）后再次观察到提升。',
  },
  {
    href: `${root}/second-generation/`,
    title: 'H1.40 / H1.41：第二代持续整合边界',
    body: '经验供给与第二代参数写入成立，但稳定 acquisition / retention / preservation 尚未建立。',
  },
  {
    href: `${root}/current-conclusion/`,
    title: '完整结论边界',
    body: '把 supported（已支持）、negative（负结果）、invalid（无效）与 unknown（未知）分开。',
  },
] as const;
---

<div class="result-index" data-testid="openevo-webshop-result-index">
  <header class="index-hero">
    <p class="eyebrow">OPENEVO × WEBSHOP · RESEARCH FINDINGS</p>
    <h1>我们真正想知道的，是 OpenEvo 能不能把自己的经验变成后续任务能力</h1>
    <p class="lede">这页不按 H0、H1.1、H1.2……排列实验，而是从最初的研究问题出发：一个正常的科学研究会继续问什么？现有实验已经回答了什么？哪些问题仍然没有答案？</p>
    <div class="cutoff-note">
      <strong>本版报告证据截止：H1.41</strong>
      <span>方法背景与 WebShop / SEED 设定不在这里重复；H1.42 保留为后续历史研究笔记，但不进入本版主结论。</span>
    </div>
  </header>

  <nav class="reference-index" aria-labelledby="reference-title">
    <div class="result-section-heading compact-heading">
      <p>BACKGROUND</p>
      <div>
        <h2 id="reference-title">背景只保留入口，不在实验结果页重新讲一遍</h2>
        <p>遇到 OpenEvo、SEED、WebShop 或实验复现细节时，从下面进入各自的 canonical page（权威说明页）。</p>
      </div>
    </div>
    <div class="reference-grid">
      {references.map((item) => (
        <a href={item.href} class="reference-card">
          <small>{item.label}</small>
          <strong>{item.title}</strong>
          <span>{item.body}</span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </nav>

  <section class="main-question" aria-labelledby="main-question-title">
    <p>最初的问题</p>
    <div>
      <h2 id="main-question-title">把 OpenEvo 放到 SEED 使用的 WebShop setting（SEED WebShop 实验设定）下，它到底会怎样？</h2>
      <p>更具体地说：OpenEvo 能否从自己完成任务的经验中学习，并把这种学习转化成之后没有训练过的任务表现？</p>
    </div>
  </section>

  <section class="question-section" aria-labelledby="question-title">
    <div class="result-section-heading">
      <p>MAINLINE</p>
      <div>
        <h2 id="question-title">七个自然问题，组成今天的研究主线</h2>
        <p>实验编号只作为证据索引，不再决定正文顺序。每个问题先给最短答案，再向下钻到具体实验。</p>
      </div>
    </div>

    <div class="question-list">
      {questions.map((item) => (
        <article class="question-card" id={item.id}>
          <div class="question-number">{item.index}</div>
          <div class="question-copy">
            <div class="question-meta"><span>{item.status}</span></div>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
            <div class="evidence-row">
              <small>证据：{item.evidence}</small>
              <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>查看证据 →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="conclusion-section" aria-labelledby="conclusion-title">
    <div class="result-section-heading">
      <p>TAKEAWAY</p>
      <div>
        <h2 id="conclusion-title">把两周工作压成一句话</h2>
        <p>OpenEvo 会学习，也能在特定条件下把学到的东西用到新的内部任务上；但它还没有证明能够稳定地一代一代持续变好，而且真正的 SEED 官方保留任务公平比较仍未完成。</p>
      </div>
    </div>
    <div class="claim-grid">
      <article>
        <small>可以说</small>
        <strong>第一代内部新任务迁移可以出现，并已独立复现</strong>
        <p>这里的“新任务”是 OpenEvo internal fresh task-ID-disjoint evaluation（OpenEvo 内部新任务、任务 ID 不重叠评估）。</p>
      </article>
      <article>
        <small>不能说</small>
        <strong>OpenEvo 已经在 SEED 官方测试集上证明有效</strong>
        <p>现有正式 positive transfer（正向迁移）任务来自 goal_idx ≥ 500，不是 0–499 的 SEED official held-out tasks（SEED 官方保留任务）。</p>
      </article>
      <article>
        <small>下一步</small>
        <strong>只补一场干净的 SEED-compatible fair comparison</strong>
        <p>不需要把 H0–H1.41 全部重跑；只需要冻结正式 train / held-out boundary（训练 / 保留任务边界）与匹配评估协议。</p>
      </article>
    </div>
  </section>

  <section class="deep-dive-section" aria-labelledby="deep-dive-title">
    <div class="result-section-heading">
      <p>EVIDENCE NOTES</p>
      <div>
        <h2 id="deep-dive-title">需要追问时，再进入具体实验笔记</h2>
        <p>这些页面继续保留，但从“主报告骨架”降为 deep dive / evidence notes（深入实验笔记 / 证据笔记）。</p>
      </div>
    </div>
    <div class="deep-grid">
      {deepDives.map((item) => (
        <a href={item.href} class="deep-card">
          <strong>{item.title}</strong>
          <span>{item.body}</span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </section>

  <details class="legacy-links">
    <summary>历史 URL 与后续研究笔记</summary>
    <p>旧的 WebShop / SEED / OpenEvo 前景笔记只保留 URL 兼容；H1.42 measurement-boundary（测量边界）笔记也保留，但不进入本版 H1.41 截止的主报告。</p>
    <div>
      <a href={`${root}/webshop-training/`}>旧 WebShop 前景笔记</a>
      <a href={`${root}/seed-training/`}>旧 SEED 前景笔记</a>
      <a href={`${root}/openevo-training/`}>旧 OpenEvo 前景笔记</a>
      <a href={`${root}/measurement-boundary/`}>H1.42 后续测量笔记</a>
      <a href={`${root}/benchmark-first/`}>旧 benchmark 重分层笔记</a>
      <a href={`${root}/seed-faithful-benchmark/`}>旧 benchmark 协议笔记</a>
      <a href={`${root}/openevo-benchmark-design/`}>旧方法设计笔记</a>
    </div>
  </details>
</div>

<style>
  .result-index{max-width:1160px;margin:0 auto;padding:28px 24px 72px;color:var(--color-text)}
  .index-hero{max-width:960px;padding:36px 0 46px}.eyebrow{margin:0 0 18px;color:var(--color-text-muted);font-size:.75rem;font-weight:750;letter-spacing:.14em}.index-hero h1{margin:0;max-width:940px;font-size:clamp(2.35rem,5vw,4.9rem);line-height:1.02;letter-spacing:-.055em}.lede{max-width:800px;margin:24px 0 0;color:var(--color-text-muted);font-size:1.04rem;line-height:1.78}.cutoff-note{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid var(--color-border);font-size:.82rem}.cutoff-note strong{color:var(--color-accent)}.cutoff-note span{color:var(--color-text-muted)}
  .reference-index,.question-section,.conclusion-section,.deep-dive-section{padding:36px 0 44px;border-top:1px solid var(--color-border)}.result-section-heading{display:grid;grid-template-columns:145px minmax(0,740px);gap:28px;margin-bottom:24px;align-items:start}.result-section-heading>p,.main-question>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.14em}.result-section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}.result-section-heading div>p{margin:0;max-width:66ch;color:var(--color-text-muted);font-size:.94rem;line-height:1.68}
  .reference-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.reference-card,.deep-card{display:flex;min-height:178px;flex-direction:column;padding:17px;border:1px solid var(--color-border);border-radius:13px;background:var(--color-surface);color:var(--color-text);text-decoration:none;transition:transform .18s ease,border-color .18s ease}.reference-card:hover,.reference-card:focus-visible,.deep-card:hover,.deep-card:focus-visible{transform:translateY(-2px);border-color:var(--color-accent)}.reference-card small{color:var(--color-accent);font:750 .7rem ui-monospace,SFMono-Regular,Menlo,monospace}.reference-card strong{margin:16px 0 8px;font-size:.96rem;line-height:1.35}.reference-card span,.deep-card span{color:var(--color-text-muted);font-size:.79rem;line-height:1.58}.reference-card b,.deep-card b{margin-top:auto;padding-top:14px;color:var(--color-accent)}
  .main-question{display:grid;grid-template-columns:145px minmax(0,820px);gap:28px;padding:42px 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.main-question h2{margin:0;font-size:clamp(1.85rem,3.8vw,3.35rem);line-height:1.08;letter-spacing:-.04em}.main-question div>p{max-width:65ch;margin:16px 0 0;color:var(--color-text-muted);font-size:1rem;line-height:1.7}
  .question-list{display:grid;gap:10px}.question-card{display:grid;grid-template-columns:62px minmax(0,1fr);gap:20px;padding:24px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}.question-number{color:var(--color-text-muted);font:650 .82rem ui-monospace,SFMono-Regular,Menlo,monospace}.question-meta span{display:inline-block;padding:4px 8px;border:1px solid var(--color-border);border-radius:999px;color:var(--color-accent);font-size:.7rem;font-weight:700}.question-card h3{margin:10px 0 10px;font-size:1.35rem;line-height:1.34;letter-spacing:-.025em}.question-card p{max-width:76ch;margin:0;color:var(--color-text-muted);font-size:.92rem;line-height:1.68}.evidence-row{display:flex;justify-content:space-between;gap:18px;align-items:baseline;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid var(--color-border)}.evidence-row small{color:var(--color-text-muted);font-size:.74rem}.evidence-row a{color:var(--color-accent);font-size:.76rem;font-weight:750;text-decoration:none}
  .claim-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.claim-grid article{padding:20px;border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface)}.claim-grid small{color:var(--color-accent);font-size:.72rem;font-weight:750}.claim-grid strong{display:block;margin:12px 0 10px;font-size:1rem;line-height:1.4}.claim-grid p{margin:0;color:var(--color-text-muted);font-size:.8rem;line-height:1.58}
  .deep-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.deep-card{min-height:142px}.deep-card strong{margin-bottom:10px;font-size:.94rem;line-height:1.4}
  .legacy-links{margin-top:8px;padding:16px 0;border-top:1px solid var(--color-border);color:var(--color-text-muted);font-size:.8rem}.legacy-links summary{cursor:pointer;color:var(--color-text);font-weight:650}.legacy-links p{margin:10px 0 8px}.legacy-links div{display:flex;gap:12px;flex-wrap:wrap}.legacy-links a{color:var(--color-accent)}
  @media(max-width:960px){.reference-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.claim-grid{grid-template-columns:1fr}}
  @media(max-width:720px){.result-index{padding-inline:18px}.result-section-heading,.main-question{grid-template-columns:1fr;gap:8px}.reference-grid,.deep-grid{grid-template-columns:1fr}.reference-card{min-height:auto}.question-card{grid-template-columns:40px minmax(0,1fr);gap:12px;padding:18px}.index-hero{padding-top:24px}}
</style>
