---
import { localePath, type Locale } from '../../i18n';
import { openEvoScientificState } from '../../lib/openEvoScientificState';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const reasons = [
  [t('复现基线','Reproduction baseline'),t('SEED 使用 Qwen2.5-3B-Instruct。要先判断框架本身带来什么变化，就要先固定同一模型；这样模型变化不会和框架变化混在一起。这并不表示 3B 被预设为最佳模型。','SEED uses Qwen2.5-3B-Instruct. To isolate what the framework changes, pin the same model first so model changes are not mixed with framework changes. This does not assume that 3B is the best model.')],
  [t('重复次数','Repeat budget'),t('在相同软件栈和硬件条件下，更小的模型通常降低单次推理与训练成本，因此同一预算可以容纳更多 rollout、任务和随机种子；实际重复次数仍应由实测 profiling 决定。','Under the same software stack and hardware, a smaller model typically lowers per-run inference and training cost, leaving room for more rollouts, tasks, and seeds; the actual repeat budget must still come from measured profiling.')],
  [t('保留提升空间','Preserve headroom'),t('如果无演化基线已经把任务做满，OpenEvo 的额外收益会受到天花板限制。因此模型扩展前要先确认 baseline 是否还有提升空间；是否饱和必须由 baseline 运行确认，不能只根据模型规模预设。','If the no-evolution baseline already saturates the task, OpenEvo has little measurable headroom. Check baseline headroom before expanding models; saturation must be established by a baseline run rather than assumed from model size.')],
  [t('开放权重','Open weights'),t('checkpoint、精度、chat template 和推理后端都可以固定并记录，因此后续差异可以回到明确的模型身份与运行条件。','Checkpoint, precision, chat template, and inference backend can all be pinned and recorded, so later differences can be traced to explicit model identities and runtime conditions.')],
] as const;
const lanes = [
  {code:'A',title:t('同家族容量梯度','Same-family capacity ladder'),models:['Qwen2.5-1.5B-Instruct','Qwen2.5-3B-Instruct','Qwen2.5-7B-Instruct'],note:t('固定代际与训练风格，只改变容量。','Keep generation and tuning style fixed; vary capacity only.')},
  {code:'B',title:t('相近规模代际梯度','Nearby-scale generation ladder'),models:['Qwen2.5-3B-Instruct','Qwen3-4B-Instruct-2507','Qwen3.5-4B'],note:t('比较更新一代模型后，OpenEvo 的相对增益是否仍存在。','Test whether OpenEvo relative gain persists on newer generations.')},
  {code:'C',title:t('跨家族鲁棒性','Cross-family robustness'),models:['Qwen2.5-3B-Instruct','Llama-3.2-3B-Instruct','Gemma-3-4B-IT'],note:t('这一层最后做，因为 tokenizer、模板和许可证会增加变量。','Run this last because tokenizers, templates, and licenses add variables.')},
] as const;
const beginner = [
  [t('什么在进化？','What is evolving?'),t('先找更新对象：memory、skill、adapter、参数还是系统行为。','Identify the updated object first: memory, skill, adapter, parameters, or system behavior.')],
  [t('反思等于学习吗？','Is reflection learning?'),t('不一定。要看它是否被保存、加载或蒸馏，并影响后续任务。','Not necessarily. Check whether it is preserved, loaded, or distilled and affects later tasks.')],
  [t('为什么不直接换更强模型？','Why not just use a stronger model?'),t('换模型可以回答系统能力问题，但模型和框架同时变化时，结果差异不能单独归因到 OpenEvo。因此框架因果比较先固定模型，模型扩展再作为后续问题。','A stronger model can answer a system-capability question, but when model and framework change together the difference cannot be attributed to OpenEvo alone. Keep the model fixed for the framework comparison, then study model expansion separately.')],
  [t('怎么判断真的变好？','How do we know it improved?'),t('同时看环境结果、轨迹、多个随机种子和成本，因为单个 reward 既不能说明结果是否稳定，也不能区分行为改善与测量异常。','Use environment outcomes, trajectories, multiple seeds, and cost together, because a single reward cannot establish stability or distinguish behavior improvement from measurement anomalies.')],
] as const;
---
<div class="openevo-extension">
  <section class="oe-section" id="model-choice-experiments" aria-labelledby="model-choice-title">
    <div class="oe-heading"><span>04</span><div><small>{t('模型选择','Model choice')}</small><h2 id="model-choice-title">{t('模型扩展实验','Model expansion experiments')}</h2></div></div>
    <div class="baseline"><div><span>{t('共同基线','Shared baseline')}</span><strong>Qwen2.5-3B-Instruct</strong><p>{t('它用于控制变量，不代表它预先被认定为最佳模型。','It is a controlled baseline, not a declaration that it is the best model.')}</p></div><div><span>{t('实验顺序','Experiment order')}</span><strong>{t('先完成实时 campaign 的科学门槛，再扩模型。','Clear the live campaign’s scientific gate before expanding models.')}</strong><p>{t('如果当前主比较还没有得到可解释结果，先换模型会同时增加新的变量，反而更难判断 OpenEvo 本身发生了什么。因此实验顺序以实际工作 branch 的 current-campaign 与最新 reconciliation/result 为准；历史 H0 与任何已冻结阶段只是带日期的里程碑。','If the current primary comparison is not yet interpretable, changing models adds another variable and makes the OpenEvo effect harder to isolate. Experiment order therefore follows current-campaign and the latest reconciliation/result on the actual working branch; historical H0 and frozen phases are dated milestones.')}</p></div></div>
    <div class="reason-grid">{reasons.map(([title,body],i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{body}</p></article>)}</div>

    <div class="subheading"><span>{t('实验梯度','Experiment ladder')}</span><h3>{t('模型扩展顺序','Model expansion order')}</h3><p>{t('每一层只增加一种新的解释难度；前一层协议稳定后再进入下一层，才能知道新出现的差异来自容量、代际还是模型家族。','Each layer adds one interpretive difficulty. Advance only after the previous protocol is stable so any new difference can be attributed to capacity, generation, or model family rather than several changes at once.')}</p></div>
    <ol class="lane-list">{lanes.map((lane)=><li><b>{lane.code}</b><div><h4>{lane.title}</h4><div>{lane.models.map((model)=><span>{model}</span>)}</div><p>{lane.note}</p></div></li>)}</ol>

    <section class="protocol" aria-labelledby="model-protocol-title"><span>{t('控制变量','Controls')}</span><h3 id="model-protocol-title">{t('配对实验协议','Paired experiment protocol')}</h3><div class="pair"><div><b>B₀</b><strong>{t('同模型无演化基线','Same-model no-evolution baseline')}</strong></div><i>→</i><div><b>O₁</b><strong>{t('同模型 OpenEvo 条件','Same-model OpenEvo condition')}</strong></div><i>→</i><div><b>Δ</b><strong>{t('模型内变化','Within-model change')}</strong></div></div><ul><li>{t('同一任务与 split','Same tasks and split')}</li><li>{t('同一 prompt / parser','Same prompt / parser')}</li><li>{t('同一 token / step / wall-time 预算','Same token / step / wall-time budget')}</li><li>{t('同一随机种子集合','Same seed set')}</li><li>{t('同一 evaluator','Same evaluator')}</li><li>{t('同一演化次数','Same evolution count')}</li></ul></section>
    <p class="state-note">{t(`默认 main 快照（${openEvoScientificState.checkedAt}）：${openEvoScientificState.defaultBranchSnapshot.phase} / ${openEvoScientificState.defaultBranchSnapshot.status}。活跃科学分支可能领先。`,`Default-main snapshot (${openEvoScientificState.checkedAt}): ${openEvoScientificState.defaultBranchSnapshot.phase} / ${openEvoScientificState.defaultBranchSnapshot.status}. An active scientific branch may be ahead.`)}</p>
  </section>

  <section class="oe-section" id="beginner-questions" aria-labelledby="beginner-title">
    <div class="oe-heading"><span>05</span><div><small>{t('入门','Primer')}</small><h2 id="beginner-title">{t('自进化智能体入门','Self-evolving agent primer')}</h2></div></div>
    <div class="question-grid">{beginner.map(([q,a],i)=><details open={i===0}><summary><span>{String(i+1).padStart(2,'0')}</span><strong>{q}</strong></summary><p>{a}</p></details>)}</div>
    <div class="reading"><span>{t('阅读方法','Reading method')}</span><h3>{t('四步阅读法','Four-step reading method')}</h3><ol><li><b>{t('更新对象','Updated object')}</b><span>memory / code / adapter / parameters?</span></li><li><b>{t('循环边界','Loop boundary')}</b><span>{t('变化何时进入下一轮？','When does the change enter the next round?')}</span></li><li><b>artifact</b><span>{t('变化是否真实存在？','Does the change actually exist?')}</span></li><li><b>{t('配对实验','Paired experiment')}</b><span>B₀ ↔ O₁</span></li></ol></div>
    <div class="actions"><a class="button button-primary" href={p('/research/seed-openevo/loops/')}>{t('更新机制 →','Update mechanisms →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/results/')}>{t('实验状态与结果','Experiment state and results')}</a></div>
  </section>
</div>

<style>
  .openevo-extension{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem}.oe-section{padding:1.8rem 0;border-top:1px solid var(--line)}.oe-heading{display:grid;grid-template-columns:2.5rem minmax(0,1fr);gap:.65rem;margin-bottom:1rem}.oe-heading>span{color:var(--accent-deep);font:800 .72rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.oe-heading small{display:block;color:var(--muted);font-size:.68rem}.oe-heading h2{margin:.15rem 0 0}.baseline{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden;border:1px solid var(--line);border-radius:14px}.baseline>div{padding:1rem}.baseline>div+div{border-left:1px solid var(--line)}.baseline span,.baseline strong{display:block}.baseline span{color:var(--muted);font-size:.68rem}.baseline strong{margin:.4rem 0;font-size:.9rem}.baseline p,.reason-grid p,.lane-list p,.subheading p,.state-note{margin:.35rem 0 0;color:var(--muted);font-size:.74rem;line-height:1.5}.state-note{margin-top:.8rem}.reason-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin-top:.6rem}.reason-grid article{padding:.8rem;border:1px solid var(--line);border-radius:12px}.reason-grid article>span{color:var(--accent-deep);font:800 .66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.reason-grid h3{margin:.55rem 0 .3rem}.subheading{margin:2rem 0 .8rem}.subheading>span,.protocol>span,.reading>span{color:var(--accent-deep);font-size:.68rem;font-weight:800}.subheading h3,.protocol h3,.reading h3{margin:.2rem 0}.lane-list{display:grid;gap:.5rem;margin:0;padding:0;list-style:none}.lane-list li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.6rem;padding:.8rem;border:1px solid var(--line);border-radius:12px}.lane-list li>b{color:var(--accent-deep)}.lane-list h4{margin:0 0 .5rem}.lane-list li div div{display:flex;flex-wrap:wrap;gap:.35rem}.lane-list li div div span{padding:.3rem .45rem;border:1px solid var(--line);border-radius:999px;font-size:.66rem}.protocol,.reading{margin-top:1rem;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface-muted)}.pair{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:.5rem;align-items:center}.pair>div{padding:.7rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.pair b,.pair strong{display:block}.pair b{color:var(--accent-deep)}.pair strong{margin-top:.3rem;font-size:.72rem}.pair i{font-style:normal}.protocol ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem;margin:.6rem 0 0;padding:0;list-style:none}.protocol li{padding:.55rem;border:1px dashed var(--line);border-radius:9px;font-size:.68rem}.question-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}.question-grid details{padding:.8rem;border:1px solid var(--line);border-radius:12px}.question-grid summary{display:flex;gap:.5rem;cursor:pointer}.question-grid summary span{color:var(--accent-deep);font:800 .66rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.question-grid summary strong{font-size:.78rem}.question-grid p{margin:.6rem 0 0;color:var(--muted);font-size:.74rem;line-height:1.5}.reading ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.4rem;margin:.6rem 0 0;padding:0;list-style:none}.reading li{padding:.65rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.reading b,.reading span{display:block}.reading b{font-size:.72rem}.reading li span{margin-top:.3rem;color:var(--muted);font-size:.66rem}.actions{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1rem}@media(max-width:800px){.reason-grid,.protocol ul,.reading ol{grid-template-columns:repeat(2,minmax(0,1fr))}.question-grid{grid-template-columns:1fr}}@media(max-width:560px){.openevo-extension{width:min(100% - 1rem,1120px)}.baseline,.reason-grid,.protocol ul,.reading ol{grid-template-columns:1fr}.baseline>div+div{border-top:1px solid var(--line);border-left:0}.pair{grid-template-columns:1fr}.pair i{text-align:center;transform:rotate(90deg)}}
</style>