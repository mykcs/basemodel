---
import { localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const reasons = [
  {
    index: '01',
    title: t('先复现，再扩模型', 'Reproduce first, expand later'),
    body: t('SEED 论文使用这一 checkpoint。OpenEvo 先沿用它，能把“模型变化”和“框架变化”拆开。', 'SEED used this checkpoint. Reusing it in OpenEvo separates model changes from framework changes.'),
  },
  {
    index: '02',
    title: t('小模型允许更多重复', 'A small model buys more repeats'),
    body: t('同一算力下可以覆盖更多 rollout、任务和随机种子，先把方差与失败模式看清楚。', 'Under the same compute, it supports more rollouts, tasks, and random seeds, exposing variance and failure modes.'),
  },
  {
    index: '03',
    title: t('错误仍然看得见', 'Its errors remain visible'),
    body: t('基线不会轻易把任务做满，更容易观察 memory、artifact 和 successor revision 到底改变了什么。', 'The baseline is less likely to saturate the task, making memory, artifacts, and successor-revision effects easier to observe.'),
  },
  {
    index: '04',
    title: t('公开权重便于冻结', 'Open weights can be pinned'),
    body: t('checkpoint、精度、推理后端和 chat template 都能记录；但许可证仍要单独核对。', 'Checkpoint, precision, backend, and chat template can be recorded, while the license still needs its own review.'),
  },
];

const experimentLanes = [
  {
    code: 'A',
    label: t('同家族 · 容量控制', 'Same family · capacity control'),
    title: t('先问：模型变大后，OpenEvo 的相对增益还在吗？', 'First ask: does OpenEvo keep its relative gain as the model gets larger?'),
    models: ['Qwen2.5-1.5B-Instruct', 'Qwen2.5-3B-Instruct', 'Qwen2.5-7B-Instruct'],
    note: t('固定代际与训练风格，只改变容量。', 'Keep generation and tuning style fixed; vary capacity.'),
  },
  {
    code: 'B',
    label: t('相近规模 · 代际控制', 'Nearby scale · generation control'),
    title: t('再问：更新一代模型后，演化机制是否仍有效？', 'Then ask: does the evolution mechanism still work on a newer generation?'),
    models: ['Qwen2.5-3B-Instruct', 'Qwen3-4B-Instruct-2507', 'Qwen3.5-4B'],
    note: t('Qwen3.5 需要固定为 text-only，并明确 thinking / non-thinking 模式。', 'Qwen3.5 must be text-only, with thinking/non-thinking mode explicitly fixed.'),
  },
  {
    code: 'C',
    label: t('跨家族 · 鲁棒性控制', 'Cross family · robustness control'),
    title: t('最后问：效果依赖 Qwen，还是能跨 tokenizer 与 chat template？', 'Finally ask: is the effect Qwen-specific, or robust across tokenizers and chat templates?'),
    models: ['Qwen2.5-3B-Instruct', 'Llama-3.2-3B-Instruct', 'Gemma-3-4B-IT'],
    note: t('这一组放在后面；许可证、模板和后端差异都会引入额外变量。', 'Run this later; licenses, templates, and backends add extra variables.'),
  },
];

const controls = [
  t('同一任务与 split', 'Same tasks and split'),
  t('同一 prompt、动作语法与 parser', 'Same prompt, action grammar, and parser'),
  t('同一步数、token 与 wall-time 预算', 'Same step, token, and wall-time budgets'),
  t('同一 memory carrier 与演化次数', 'Same memory carrier and evolution count'),
  t('同一随机种子集合', 'Same random-seed set'),
  t('同一 evaluator 与成功定义', 'Same evaluator and success definition'),
];

const metrics = [
  {
    symbol: 'B₀',
    title: t('无演化基线', 'No-evolution baseline'),
    body: t('先量出每个模型自己的起点。', 'Measure each model’s own starting point.'),
  },
  {
    symbol: 'Δ',
    title: t('模型内增益', 'Within-model gain'),
    body: t('OpenEvo − 同模型 B₀；不要只比最终分数。', 'OpenEvo minus the same model’s B₀; do not compare final scores alone.'),
  },
  {
    symbol: 'η',
    title: t('单位成本增益', 'Gain per unit cost'),
    body: t('每 GPU-hour、每百万 token 或每次 evolution 的提升。', 'Improvement per GPU-hour, million tokens, or evolution step.'),
  },
  {
    symbol: 'σ',
    title: t('跨种子稳定性', 'Cross-seed stability'),
    body: t('报告分布与失败类型，不只报一个平均数。', 'Report distributions and failure types, not one mean.'),
  },
];

const outcomes = [
  {
    title: t('所有模型都有稳定 Δ', 'Every model shows a stable Δ'),
    meaning: t('支持“方法具有跨模型可迁移性”，再进入更大规模验证。', 'Supports cross-model transferability; proceed to larger-scale validation.'),
  },
  {
    title: t('新模型 B₀ 更高，但 Δ 更小', 'Newer model has higher B₀ but smaller Δ'),
    meaning: t('可能是能力天花板，也可能是现有 carrier 不适合；两者需要额外消融。', 'Could be a capability ceiling or carrier mismatch; distinguish them with ablations.'),
  },
  {
    title: t('只有一个家族获得提升', 'Only one family improves'),
    meaning: t('先检查 chat template、action parser 与 memory 表达，不要直接宣称算法失败。', 'Inspect chat templates, action parsing, and memory representation before calling the method a failure.'),
  },
  {
    title: t('弱模型 Δ 大，但最终仍落后', 'Weaker model gains more but still finishes behind'),
    meaning: t('“更容易被改进”不等于“最终系统更好”；相对增益与绝对能力要同时报告。', '“Easier to improve” is not “best final system”; report relative gain and absolute capability together.'),
  },
];

const beginnerQuestions = [
  {
    number: '01',
    tag: t('先找对象', 'Find the object'),
    question: t('自进化智能体到底在“进化”什么？', 'What exactly is evolving in a self-evolving agent?'),
    answer: t('可能是 prompt、memory、tool policy、工作流、代码、adapter，也可能是模型参数。先写出“更新前对象 → 更新动作 → 更新后对象”。', 'It may be a prompt, memory, tool policy, workflow, code, adapter, or model parameters. Write “object before → update action → object after.”'),
    evidence: t('要看 artifact、revision 或 checkpoint，而不是只看“它反思了”。', 'Look for an artifact, revision, or checkpoint—not merely a claim that it reflected.'),
    href: p('/research/seed-openevo/loops/'),
    link: t('看 SEED × OpenEvo 循环对比', 'See the SEED × OpenEvo loop comparison'),
  },
  {
    number: '02',
    tag: t('区分反思与学习', 'Separate reflection from learning'),
    question: t('模型写了一段反思，就算真的学会了吗？', 'If the model writes a reflection, has it actually learned?'),
    answer: t('不一定。反思可以只是一段文本；只有它被保存、注入、选择或蒸馏，并影响后续任务，才进入学习证据链。', 'Not necessarily. Reflection may be text only; it enters the learning evidence chain only when preserved, injected, selected, or distilled and then affects a later task.'),
    evidence: t('检查反思何时生效，以及同一任务中有没有偷偷改变上下文。', 'Check when reflection activates and whether context changed silently inside the same task.'),
    href: p('/research/seed-openevo/openevo/'),
    link: t('回看 OpenEvo session 边界', 'Review the OpenEvo session boundary'),
  },
  {
    number: '03',
    tag: t('先守住因果', 'Protect causality'),
    question: t('为什么不直接换一个更强的大模型？', 'Why not just replace it with a stronger model?'),
    answer: t('可以换，但那回答的是“哪个系统更强”，不是“OpenEvo 是否带来提升”。先固定模型测 Δ，再做模型扩展实验。', 'You can, but that answers “which system is stronger,” not “did OpenEvo cause the gain?” Fix the model for Δ first, then expand models.'),
    evidence: t('同模型 B₀ 与 OpenEvo 必须成对出现。', 'The same-model B₀ and OpenEvo run must appear as a pair.'),
    href: '#model-choice-experiments',
    link: t('看上面的模型实验阶梯', 'See the model experiment ladder above'),
  },
  {
    number: '04',
    tag: t('理解评分', 'Understand scoring'),
    question: t('智能体怎么知道自己真的做得更好了？', 'How does the agent know it actually improved?'),
    answer: t('依赖环境回报、任务成功、部分完成分数和轨迹诊断。不同 benchmark 的分数含义不能混成一个“总智能分”。', 'It relies on environment reward, task success, partial completion, and trajectory diagnostics. Different benchmarks must not collapse into one “intelligence score.”'),
    evidence: t('保存最终分数，也保存 action、loop、invalid、fallback 与结束原因。', 'Preserve final metrics plus actions, loops, invalids, fallbacks, and termination reasons.'),
    href: p('/research/seed-openevo/benchmarks/'),
    link: t('看 WebShop / ALFWorld 的证据差异', 'See how WebShop and ALFWorld evidence differs'),
  },
  {
    number: '05',
    tag: t('防止骗分', 'Prevent reward hacking'),
    question: t('它会不会学会“骗过评分器”，而不是真的完成任务？', 'Could it learn to game the evaluator without completing the task?'),
    answer: t('会有这种风险。最终结论要同时依赖环境状态、轨迹、held-out 任务和独立成功判定，而不是单一 reward。', 'That risk exists. Conclusions should combine environment state, trajectories, held-out tasks, and an independent success check—not one reward.'),
    evidence: t('把 evaluator 当成实验部件记录版本，并人工抽查高分轨迹。', 'Version the evaluator as an experiment component and manually inspect high-scoring trajectories.'),
    href: p('/research/seed-openevo/results/'),
    link: t('看结果页的证据阶梯', 'See the results evidence ladder'),
  },
  {
    number: '06',
    tag: t('排除伪提升', 'Rule out false gains'),
    question: t('提升会不会只是因为用了更多 token、更多步骤或运气更好？', 'Could the gain come only from more tokens, more steps, or luck?'),
    answer: t('所以要冻结预算、采样参数、随机种子集合与 evaluator。只要其中一个变了，就不能把差异全部归因于演化。', 'That is why budgets, sampling, seed sets, and the evaluator must be frozen. If one changes, the whole difference cannot be attributed to evolution.'),
    evidence: t('至少报告多个随机种子的分布，并把失败类型逐项比较。', 'Report a multi-seed distribution and compare failure types one by one.'),
    href: p('/methodology/'),
    link: t('查看受控证据方法', 'Review the controlled-evidence method'),
  },
  {
    number: '07',
    tag: t('检查迁移', 'Check transfer'),
    question: t('一次任务学到的东西，能带到下一次任务吗？', 'Can what it learned in one task help the next task?'),
    answer: t('这正是 OpenEvo 的关键问题：完成任务后封存证据，形成 successor revision，再由后续任务加载。', 'That is central to OpenEvo: seal evidence after completion, form a successor revision, and let a later task load it.'),
    evidence: t('需要区分同任务重复、同分布新任务和真正 held-out 任务。', 'Separate same-task repeats, new tasks from the same distribution, and genuinely held-out tasks.'),
    href: p('/guide/openevo-webshop-alfworld/'),
    link: t('进入真实复现指南', 'Open the real reproduction guide'),
  },
  {
    number: '08',
    tag: t('知道何时停止', 'Know when to stop'),
    question: t('它要进化多少轮？越多越好吗？', 'How many evolution rounds should it run? Is more always better?'),
    answer: t('不是。停止条件应同时看 held-out 提升、成本、方差、回归和 artifact 膨胀；连续多轮没有可靠增益就应停。', 'No. Stop based on held-out gain, cost, variance, regressions, and artifact growth; stop after repeated rounds without reliable improvement.'),
    evidence: t('预先写停止规则，避免看到结果后再改门槛。', 'Write the stopping rule in advance so the threshold is not moved after seeing results.'),
    href: p('/workspace/?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1'),
    link: t('在工作台写实验卡', 'Write the experiment card in Workspace'),
  },
];

const sources = [
  { label: 'Qwen2.5-3B-Instruct', href: 'https://huggingface.co/Qwen/Qwen2.5-3B-Instruct' },
  { label: 'Qwen3-4B-Instruct-2507', href: 'https://huggingface.co/Qwen/Qwen3-4B-Instruct-2507' },
  { label: 'Qwen3.5-4B', href: 'https://huggingface.co/Qwen/Qwen3.5-4B' },
  { label: 'Llama-3.2-3B-Instruct', href: 'https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct' },
  { label: 'Gemma-3-4B-IT', href: 'https://huggingface.co/google/gemma-3-4b-it' },
];
---
<div class="openevo-extension">
  <section class="oe-section" id="model-choice-experiments" aria-labelledby="model-choice-title">
    <div class="oe-heading">
      <span>04</span>
      <div>
        <small>{t('模型不是固定答案', 'The model is not a fixed answer')}</small>
        <h2 id="model-choice-title">{t('为什么选择 Qwen2.5-3B？我们是不是可以设计一些实验，看看同级或者更先进的模型？', 'Why Qwen2.5-3B—and can we design experiments for peers or newer models?')}</h2>
      </div>
    </div>

    <div class="baseline-hero">
      <div class="baseline-hero__model">
        <span>{t('当前共同基线', 'Current common baseline')}</span>
        <strong>Qwen2.5-3B-Instruct</strong>
        <p>{t('它的价值是让 SEED 复现与 OpenEvo 对比站在同一条起跑线上，不是提前认定它是最好的模型。', 'Its value is giving SEED reproduction and OpenEvo comparison the same starting line—not declaring it the best model in advance.')}</p>
      </div>
      <div class="baseline-hero__verdict">
        <span>{t('研究判断', 'Research judgment')}</span>
        <strong>{t('先用 3B 把机制证明清楚，再扩展模型。', 'Prove the mechanism at 3B first, then expand models.')}</strong>
        <p>{t('第一轮优先降低实验噪声；第二轮才回答“换模型以后还成立吗”。', 'The first round reduces experimental noise; the second asks whether the result survives a model change.')}</p>
      </div>
    </div>

    <div class="reason-grid" aria-label={t('选择 Qwen2.5-3B 的四个理由', 'Four reasons for choosing Qwen2.5-3B')}>
      {reasons.map((reason) => (
        <article>
          <span>{reason.index}</span>
          <h3>{reason.title}</h3>
          <p>{reason.body}</p>
        </article>
      ))}
    </div>

    <div class="oe-subheading">
      <span>{t('分层实验', 'Layered experiment')}</span>
      <h3>{t('不要一次把所有模型混在一起：按三道 Gate 扩展', 'Do not mix every model at once: expand through three gates')}</h3>
      <p>{t('每一道 Gate 只增加一种新的解释难度。前一层协议不稳定，就不进入下一层。', 'Each gate adds only one new interpretive difficulty. Do not advance until the previous protocol is stable.')}</p>
    </div>

    <ol class="experiment-ladder">
      {experimentLanes.map((lane) => (
        <li>
          <div class="experiment-ladder__rail" aria-hidden="true"><b>{lane.code}</b><i></i></div>
          <article>
            <small>{lane.label}</small>
            <h4>{lane.title}</h4>
            <div class="model-chips">
              {lane.models.map((model) => <span>{model}</span>)}
            </div>
            <p>{lane.note}</p>
          </article>
        </li>
      ))}
    </ol>

    <div class="experiment-protocol">
      <div class="experiment-protocol__header">
        <span>{t('唯一可比较协议', 'One comparable protocol')}</span>
        <h3>{t('每个模型都跑同一对：B₀ 无演化 → O₁ OpenEvo', 'Every model runs the same pair: B₀ no evolution → O₁ OpenEvo')}</h3>
      </div>
      <div class="protocol-pair" aria-label={t('基线和 OpenEvo 成对实验', 'Paired baseline and OpenEvo experiment')}>
        <div><b>B₀</b><strong>{t('无 memory / 无 evolution', 'No memory / no evolution')}</strong><span>{t('量出模型自己的起点', 'Measure the model’s own starting point')}</span></div>
        <i aria-hidden="true">→</i>
        <div><b>O₁</b><strong>{t('固定 carrier 的 OpenEvo', 'OpenEvo with a fixed carrier')}</strong><span>{t('只增加演化机制', 'Add only the evolution mechanism')}</span></div>
        <i aria-hidden="true">→</i>
        <div class="protocol-pair__result"><b>Δ</b><strong>{t('同模型内的变化', 'Within-model change')}</strong><span>{t('再与绝对分数一起解释', 'Interpret alongside absolute performance')}</span></div>
      </div>
      <ul class="control-grid">
        {controls.map((control, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{control}</li>)}
      </ul>
    </div>

    <div class="metric-grid">
      {metrics.map((metric) => (
        <article>
          <span>{metric.symbol}</span>
          <h3>{metric.title}</h3>
          <p>{metric.body}</p>
        </article>
      ))}
    </div>

    <div class="outcome-board">
      <div class="outcome-board__intro">
        <small>{t('看到结果以后怎么读', 'How to read the result')}</small>
        <h3>{t('同一个数字，可能对应四种不同机制', 'The same number can imply four different mechanisms')}</h3>
        <p>{t('先写好解释分支，可以减少“看到想要的结果才讲故事”。', 'Pre-writing interpretation branches reduces post-hoc storytelling.')}</p>
      </div>
      <div class="outcome-board__cases">
        {outcomes.map((outcome, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h4>{outcome.title}</h4>
            <p>{outcome.meaning}</p>
          </article>
        ))}
      </div>
    </div>

    <aside class="oe-callout">
      <strong>{t('建议的最低成本顺序', 'Recommended lowest-cost order')}</strong>
      <span>{t('先完成 Qwen2.5-3B 的多随机种子 B₀ / O₁；通过后跑 Qwen2.5 容量梯度；再跑 Qwen3 / Qwen3.5；最后才做跨家族。', 'First complete multi-seed B₀/O₁ on Qwen2.5-3B; then the Qwen2.5 scale ladder; then Qwen3/Qwen3.5; cross-family runs come last.')}</span>
    </aside>

    <div class="model-sources" aria-label={t('候选模型官方模型卡', 'Official model cards for candidate models')}>
      <span>{t('候选模型卡', 'Candidate model cards')}</span>
      <div>
        {sources.map((source) => <a href={source.href} target="_blank" rel="noreferrer">{source.label}<i aria-hidden="true">↗</i></a>)}
      </div>
    </div>
  </section>

  <section class="oe-section" id="beginner-questions" aria-labelledby="beginner-questions-title">
    <div class="oe-heading">
      <span>05</span>
      <div>
        <small>{t('第一次接触自进化智能体', 'First encounter with self-evolving agents')}</small>
        <h2 id="beginner-questions-title">{t('别先背术语：沿着八个小白问题，把“会变”拆成可验证证据', 'Do not memorize terms first: use eight beginner questions to turn “it changes” into testable evidence')}</h2>
      </div>
    </div>

    <div class="guide-dialogue" aria-label={t('新手与研究页面的对话', 'A dialogue between a beginner and the research page')}>
      <div class="guide-dialogue__user"><span>{t('刚入门的我', 'Beginner')}</span><p>{t('它是不是能自己改代码、自己变聪明？', 'Does it rewrite its own code and become smarter by itself?')}</p></div>
      <div class="guide-dialogue__page"><span>{t('研究页面', 'Research page')}</span><p>{t('先别急着相信“自进化”。第一步只问：到底改了哪个对象？', 'Do not trust “self-evolving” yet. First ask: which object actually changed?')}</p></div>
      <div class="guide-dialogue__user"><span>{t('刚入门的我', 'Beginner')}</span><p>{t('那分数变高就能证明吗？', 'Does a higher score prove it?')}</p></div>
      <div class="guide-dialogue__page"><span>{t('研究页面', 'Research page')}</span><p>{t('还不够。你还要看基线、预算、随机种子、轨迹和下一次任务是否真的加载了变化。', 'Not yet. Check the baseline, budget, seeds, trajectory, and whether the next task actually loaded the change.')}</p></div>
    </div>

    <div class="question-deck">
      {beginnerQuestions.map((item, index) => (
        <details open={index === 0}>
          <summary>
            <span>{item.number}</span>
            <div><small>{item.tag}</small><strong>{item.question}</strong></div>
            <i aria-hidden="true"></i>
          </summary>
          <div class="question-deck__answer">
            <p>{item.answer}</p>
            <div><b>{t('你要找的证据', 'Evidence to look for')}</b><span>{item.evidence}</span></div>
            <a href={item.href}>{item.link}<i aria-hidden="true">→</i></a>
          </div>
        </details>
      ))}
    </div>

    <div class="beginner-route">
      <div class="beginner-route__intro">
        <small>{t('十分钟阅读路线', 'Ten-minute reading route')}</small>
        <h3>{t('只做四步，也能判断一篇“自进化”工作在说什么', 'Four steps are enough to understand what a “self-evolving” paper is claiming')}</h3>
      </div>
      <ol>
        <li><span>1</span><b>{t('圈出更新对象', 'Circle the updated object')}</b><p>{t('prompt、memory、代码、adapter 还是参数？', 'Prompt, memory, code, adapter, or parameters?')}</p></li>
        <li><span>2</span><b>{t('画出一次循环', 'Draw one loop')}</b><p>{t('经验从哪里来，变化何时进入下一轮？', 'Where does experience come from, and when does change enter the next round?')}</p></li>
        <li><span>3</span><b>{t('打开一个 artifact', 'Open one artifact')}</b><p>{t('确认变化真实存在，而不是只在论文叙述里。', 'Confirm that the change exists outside the paper’s narrative.')}</p></li>
        <li><span>4</span><b>{t('找一组成对实验', 'Find one paired experiment')}</b><p>{t('同模型、同预算、同任务：B₀ 对 O₁。', 'Same model, budget, and task: B₀ versus O₁.')}</p></li>
      </ol>
    </div>

    <div class="oe-actions">
