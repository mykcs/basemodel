---
import ExternalBrandMark from '../common/ExternalBrandMark';
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const openevoRevision = '8a0e983487310d736b40fa0dbca88f8a65255c79';
const trajectoryRevision = '9bdca2fcb80d3272b5c9c9a32fdc2f3873f03bbc';
const adapterRevision = 'cc64938ac0bbef573b631d2742e3b9f477aff36b';
const reusableRevision = '9bc053ffffa4453bad0a5f6f779c4b8e826ff70a';
const archiveRevision = 'f2d436659f060c6e1cba1fec391b1fbf20cec0dd';
const githubBase = `https://github.com/mykcs/openevo-experiment/blob/${openevoRevision}`;
const artifacts = [
  {kind:'HF · canonical dataset', title:t('旧 Stage 1 trajectory / MiniMax analyzer 主归档','Canonical old Stage-1 trajectories / MiniMax analyzer outputs'), href:`https://huggingface.co/datasets/miyuki17/openevo-webshop-h145-h146-trajectories/tree/${trajectoryRevision}`, rev:trajectoryRevision, note:t('旧轨迹与任务后分析输出的主数据仓；publication closeout 已 fresh-verified。','Primary dataset for old trajectories and post-task analyzer outputs; fresh-verified by publication closeout.')},
  {kind:'HF · canonical model', title:t('旧 Stage 1 / bootstrap adapter 主归档','Canonical old Stage-1 / bootstrap adapters'), href:`https://huggingface.co/miyuki17/openevo-webshop-h145-h146-adapters/tree/${adapterRevision}`, rev:adapterRevision, note:t('保存真实 adapter 与 no-update pointer；不伪造不存在的 Stage-2 权重。','Stores real adapters and no-update pointers; no fabricated Stage-2 weights.')},
  {kind:'HF · compatibility copy', title:t('旧可复用数据兼容副本','Reusable-data compatibility copy'), href:`https://huggingface.co/datasets/miyuki17/openevo-webshop-h145-h146-reusable-data/tree/${reusableRevision}`, rev:reusableRevision, note:t('与 canonical staging 保持兼容；因 retention policy 仍保留。','Compatibility copy retained under the artifact-retention policy.')},
  {kind:'HF · exact cold archive', title:t('H1.45/H1.46 整套历史 run 冷归档','Exact H1.45/H1.46 historical run archive'), href:`https://huggingface.co/datasets/miyuki17/openevo-webshop-superseded-stage2-archive/tree/${archiveRevision}`, rev:archiveRevision, note:t('包含完整历史 run root、manifest、receipt 等；其中后续旧 Stage 2 已明确标为 superseded。','Exact run roots, manifests, and receipts; the downstream old Stage 2 is explicitly marked superseded.')},
] as const;
---
<main class="legacy-s1" data-testid="legacy-stage1-archive">
  <a class="legacy-s1__back" href={p('/research/seed-openevo/study/capability-exploration/#stage1-version-comparison')}>← {t('返回 Stage 1 新旧对比','Back to Stage-1 comparison')}</a>
  <header class="legacy-s1__hero">
    <div>
      <p>STAGE 1 · HISTORICAL REPLICATE · RETAINED</p>
      <h1>{t('旧版 Stage 1：仍然可用的历史产物','Old Stage 1: retained, reusable historical artifacts')}</h1>
      <span>{t('旧版不是“做错了的 Stage 1”。它与新版属于同一种 trajectory-collection 实验：同一批 180 个任务、同一模型 revision、同一 WebShop harness、同样 180×8 次 rollout。新版只是结合后续实际运行，把独立 seed 与 decoding 参数正式定稿；因此今后以新版为准，旧版继续作为历史 replicate 使用。','The old version is not a “wrong Stage 1”. It is the same kind of trajectory-collection experiment as the current version: the same 180 tasks, model revisions, WebShop harness, and 180×8 rollout budget. The current version simply formalizes an independent seed and the decoding settings used by the runtime, so future work uses the current version while the old one remains a reusable historical replicate.')}</span>
    </div>
    <aside><b>{t('一句话定位','ONE-LINE POSITION')}</b><p>{t('性质一样，参数有小幅定稿；旧版能用，新实验以新版为准。','Same scientific role, small parameter finalization; old remains usable, new is authoritative going forward.')}</p></aside>
  </header>

  <section class="legacy-s1__section" aria-labelledby="legacy-s1-assets-title">
    <p class="kicker">{t('旧产物在哪里','WHERE THE OLD ARTIFACTS LIVE')}</p>
    <h2 id="legacy-s1-assets-title">{t('优先打开 canonical Hugging Face 归档；GitHub 保留审计证据','Open canonical Hugging Face artifacts first; use GitHub for audit provenance')}</h2>
    <p class="legacy-s1__intro">{t('这些 HF 仓库目前是 private research assets；网站仍给出固定 revision，避免“链接还在但内容后来变了”。GitHub 证据页记录这些 revision 如何验证、为什么旧 Stage 1 仍可复用。','These HF repositories are currently private research assets. The site links pinned revisions so later edits cannot silently change the cited artifact. GitHub evidence records how those revisions were verified and why old Stage 1 remains reusable.')}</p>
    <div class="legacy-s1__artifacts">
      {artifacts.map((item) => <a href={item.href}><ExternalBrandMark href={item.href} /><span>{item.kind}</span><strong>{item.title}</strong><small>{item.note}</small><code>{item.rev.slice(0,12)}…</code></a>)}
    </div>
  </section>
  <section class="legacy-s1__section legacy-s1__audit" aria-labelledby="legacy-s1-audit-title">
    <div><p class="kicker">GITHUB PROVENANCE</p><h2 id="legacy-s1-audit-title">{t('为什么我们敢说“旧版还能用”','Why we can say the old version is still usable')}</h2></div>
    <div class="legacy-s1__audit-links">
      <a href={`${githubBase}/docs/evidence/server-audits/2026-08-31/superseded-stage2-publication-closeout.json`}><ExternalBrandMark href={`${githubBase}/docs/evidence/server-audits/2026-08-31/superseded-stage2-publication-closeout.json`} /><strong>{t('publication closeout','Publication closeout')}</strong><span>{t('固定 HF revisions、fresh remote-byte verification、runtime digest 与 retention 状态。','Pinned HF revisions, fresh remote-byte verification, runtime digest, and retention state.')}</span></a>
      <a href={`${githubBase}/docs/troubleshooting/experiment-ops/CASE-CEILING1-END-TO-END-SCIENCE-ENGINEERING-RETROSPECTIVE-20260831.md`}><ExternalBrandMark href={`${githubBase}/docs/troubleshooting/experiment-ops/CASE-CEILING1-END-TO-END-SCIENCE-ENGINEERING-RETROSPECTIVE-20260831.md`} /><strong>{t('Stage-1 新旧科学边界','Stage-1 old/new scientific boundary')}</strong><span>{t('明确记录 protocol-equivalent / realization-different / runtime-corrected 三个标签。','Records the protocol-equivalent / realization-different / runtime-corrected distinction.')}</span></a>
      <a href={`${githubBase}/docs/troubleshooting/publication/CASE-HUGGINGFACE-ASSET-GOVERNANCE-20260829.md`}><ExternalBrandMark href={`${githubBase}/docs/troubleshooting/publication/CASE-HUGGINGFACE-ASSET-GOVERNANCE-20260829.md`} /><strong>{t('HF 资产治理证据','HF asset-governance evidence')}</strong><span>{t('证明 canonical 与 compatibility copy 的 LFS 内容关系，而不是只凭文件大小猜重复。','Proves canonical/compatibility relationships using remote LFS hashes rather than file-size guesses.')}</span></a>
    </div>
  </section>

  <section class="legacy-s1__section legacy-s1__meaning" aria-labelledby="legacy-s1-meaning-title">
    <div><p class="kicker">{t('怎么复用','HOW TO REUSE IT')}</p><h2 id="legacy-s1-meaning-title">{t('旧版可以继续分析，但不要冒充新版的 identical corpus','Reuse it for analysis; do not relabel it as the current identical corpus')}</h2></div>
    <ol>
      <li><b>01</b><strong>{t('可以继续读旧 trajectory','Old trajectories remain valid')}</strong><p>{t('它们真实记录了旧 seed + 旧 runtime decoding 下 Qwen 在同一 WebShop 任务上的行为。','They truthfully record Qwen behavior on the same WebShop tasks under the old seed and effective runtime decoding.')}</p></li>
      <li><b>02</b><strong>{t('可以继续用真实 adapter','Real adapters remain reusable')}</strong><p>{t('HF canonical model repo 保存 Stage-1 / bootstrap adapter 与 no-update pointer；后续分析可以按原身份恢复。','The canonical HF model repo preserves Stage-1/bootstrap adapters and no-update pointers for identity-preserving restoration.')}</p></li>
      <li><b>03</b><strong>{t('以后新实验以新版为准','New work uses the current version')}</strong><p>{t('新版把 seed family 和 decoding contract 正式冻结并接入 runtime。比较历史时保留旧版；继续实验与对外主结果使用新版。','The current version freezes the seed family and decoding contract in runtime. Keep the old one for history; use the current version for future experiments and headline reporting.')}</p></li>
    </ol>
  </section>

  <p class="legacy-s1__foot"><strong>{t('边界：','Boundary:')}</strong> {t('旧 Stage 2 的窗口化 hard gate 后来被判定为设计错误，但这不会反向污染已经完成的旧 Stage 1 trajectory、MiniMax analyzer 输出或 Stage-1/bootstrap adapter。','The downstream window-local Stage-2 hard gate was later superseded as a design error, but that does not retroactively invalidate completed old Stage-1 trajectories, MiniMax analyzer outputs, or Stage-1/bootstrap adapters.')}</p>
</main>
<style>
.legacy-s1{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}
.legacy-s1__back{display:inline-flex;margin-top:1rem;color:var(--color-accent);font-size:.76rem;font-weight:760;text-decoration:none}.legacy-s1__back:hover{text-decoration:underline}
.legacy-s1__hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(240px,.65fr);gap:2rem;padding:1.5rem 0 2rem;border-bottom:1px solid var(--color-border)}
.legacy-s1__hero>div>p,.kicker{margin:0 0 .5rem;color:var(--color-accent);font:800 .63rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.legacy-s1__hero h1,.legacy-s1__section h2{margin:0;letter-spacing:-.04em}.legacy-s1__hero h1{font-size:clamp(2rem,5vw,4rem)}
.legacy-s1__hero>div>span{display:block;max-width:78ch;margin-top:.8rem;color:var(--color-text-muted);line-height:1.7}.legacy-s1__hero aside{align-self:end;padding:1rem;border:1px solid var(--color-accent);border-radius:12px;background:color-mix(in srgb,var(--color-accent) 5%,var(--color-bg))}.legacy-s1__hero aside b{font-size:.68rem}.legacy-s1__hero aside p{margin:.45rem 0 0;color:var(--color-text-muted);font-size:.76rem;line-height:1.55}
.legacy-s1__section{padding:2rem 0;border-bottom:1px solid var(--color-border)}.legacy-s1__section h2{font-size:clamp(1.35rem,3vw,2.15rem)}.legacy-s1__intro{max-width:80ch;margin:.75rem 0 0;color:var(--color-text-muted);font-size:.78rem;line-height:1.65}
.legacy-s1__artifacts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin-top:1.1rem}.legacy-s1__artifacts a{display:flex;min-width:0;flex-direction:column;gap:.28rem;padding:1rem;border:1px solid var(--color-border);border-radius:11px;color:var(--color-text);text-decoration:none}.legacy-s1__artifacts a:hover{border-color:var(--color-accent)}.legacy-s1__artifacts span{color:var(--color-accent);font:800 .56rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em}.legacy-s1__artifacts strong{font-size:.86rem}.legacy-s1__artifacts small{color:var(--color-text-muted);font-size:.7rem;line-height:1.5}.legacy-s1__artifacts code{margin-top:auto;padding-top:.4rem;color:var(--color-text-muted);font-size:.62rem;overflow-wrap:anywhere}
</style>
<style>
.legacy-s1__audit{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:1.4rem}.legacy-s1__audit-links{display:grid;gap:.55rem}.legacy-s1__audit-links a{display:flex;flex-direction:column;gap:.2rem;padding:.8rem;border-left:2px solid var(--color-border);color:var(--color-text);text-decoration:none}.legacy-s1__audit-links a:hover{border-color:var(--color-accent)}.legacy-s1__audit-links strong{font-size:.76rem}.legacy-s1__audit-links span{color:var(--color-text-muted);font-size:.7rem;line-height:1.5}
.legacy-s1__meaning{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:1.4rem}.legacy-s1__meaning ol{list-style:none;margin:0;padding:0}.legacy-s1__meaning li{display:grid;grid-template-columns:34px minmax(150px,.65fr) minmax(0,1.35fr);gap:.7rem;padding:.8rem 0;border-bottom:1px solid var(--color-border)}.legacy-s1__meaning li b{color:var(--color-accent);font:800 .6rem ui-monospace,SFMono-Regular,Menlo,monospace}.legacy-s1__meaning li strong{font-size:.78rem}.legacy-s1__meaning li p{margin:0;color:var(--color-text-muted);font-size:.72rem;line-height:1.55}
.legacy-s1__foot{margin:1rem 0 0;padding:1rem;border:1px dashed var(--color-border);border-radius:10px;color:var(--color-text-muted);font-size:.74rem;line-height:1.65}.legacy-s1__foot strong{color:var(--color-text)}
@media(max-width:800px){.legacy-s1__hero,.legacy-s1__audit,.legacy-s1__meaning,.legacy-s1__artifacts{grid-template-columns:1fr}.legacy-s1__meaning li{grid-template-columns:28px 1fr}.legacy-s1__meaning li p{grid-column:2}}
@media(max-width:520px){.legacy-s1{width:min(100% - 1rem,1180px)}.legacy-s1__artifacts a{padding:.85rem}}
</style>