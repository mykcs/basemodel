---
import { localePath, type Locale } from '../../i18n';
import {
  OPEN_EVO_EXPERIMENTS,
  OPEN_EVO_SECONDARY_ROUTES,
  type LocalizedCopy,
  type OpenEvoExperimentChildLink,
} from '../../data/openEvoExperimentNavigation';

interface Props { locale: Locale }

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (copy: LocalizedCopy) => zh ? copy.zh : copy.en;
const p = (path: string) => localePath(locale, path);
const latestExperiment = OPEN_EVO_EXPERIMENTS.at(-1)!;
const readerEntries = [
  {
    label: { zh: '第一次来', en: 'First visit' },
    title: { zh: '先补研究背景', en: 'Start with the research background' },
    body: { zh: '先弄清 Base Model、SEED、OpenEVO、WebShop 和参数更新分别是什么。', en: 'First understand the base model, SEED, OpenEVO, WebShop, and what actually gets updated.' },
    href: p('/research/seed-openevo/flow/'),
  },
  {
    label: { zh: '只想看当前结论', en: 'Current conclusions only' },
    title: { zh: '直接看证据和限制', en: 'Go straight to evidence and limits' },
    body: { zh: 'Results 页维护当前能说什么、还不能说什么；这里不复制会变化的分数。', en: 'Results owns what the evidence supports and what remains unknown; this page does not duplicate moving scores.' },
    href: p('/research/seed-openevo/study/results/'),
  },
  {
    label: { zh: '隔一阵回来', en: 'Returning later' },
    title: { zh: '从最新研究问题接上', en: 'Resume from the latest research question' },
    body: { zh: '直接进入当前最后一项主实验，再按需要向前追溯为什么会走到这里。', en: 'Open the latest main experiment, then trace backward only when you need to recover why the project reached this question.' },
    href: p(latestExperiment.primaryHref),
  },
] as const;

type DirectoryRow =
  | { kind: 'link'; child: OpenEvoExperimentChildLink }
  | { kind: 'group'; label: LocalizedCopy; children: OpenEvoExperimentChildLink[] };

const directoryRowsFor = (children: OpenEvoExperimentChildLink[]): DirectoryRow[] => {
  const rows: DirectoryRow[] = [];
  for (const child of children) {
    if (!child.directoryGroup) {
      rows.push({ kind: 'link', child });
      continue;
    }
    const last = rows.at(-1);
    if (last?.kind === 'group' && last.label.zh === child.directoryGroup.zh && last.label.en === child.directoryGroup.en) {
      last.children.push(child);
    } else {
      rows.push({ kind: 'group', label: child.directoryGroup, children: [child] });
    }
  }
  return rows;
};
---

<main class="experiment-index" data-ui-audit="layout" data-testid="experiment-first-study-index">
  <header class="study-hero">
    <h1>{zh ? 'OpenEVO × WebShop：七次实验的研究演进' : 'OpenEVO × WebShop: seven experiments in one research progression'}</h1>
    <p class="study-hero__lede">{zh
      ? '我们真正想回答的是：固定可比较的任务、评测规则和预算后，OpenEVO 能不能让同一个基础模型更会完成 WebShop 任务；如果表现变化，差异从哪里来？下面七次实验只是这两个问题一步步被缩小的过程。'
      : 'The real question is whether OpenEVO can make the same base model better at WebShop when tasks, evaluation, and budget are made comparable — and, if performance changes, where that difference comes from. The seven experiments below are how those questions were narrowed step by step.'}</p>
    <div id="reader-entry" class="study-reader-entry" data-reader-entry>
      <nav aria-label={zh ? '按阅读目的进入研究' : 'Enter the study by reading goal'}>
        {readerEntries.map((entry) => (
          <a href={entry.href}>
            <small>{t(entry.label)}</small>
            <strong>{t(entry.title)}</strong>
            <span>{t(entry.body)}</span>
          </a>
        ))}
      </nav>
      <p>{zh
        ? '当前结论与限制由 Results 页维护；这里不复制训练期分数，也不把尚未完成的实验写成结果。'
        : 'Results owns current conclusions and limits; this index does not duplicate training-time scores or present unfinished experiments as results.'}</p>
    </div>
    <p class="study-hero__mobile-thread" aria-label={zh ? '七次实验的研究演进' : 'Research progression across seven experiments'}>{zh
      ? '参数没更新 → 长周期更新 → 小模型接口 → 候选准入 → 参数历史 → 固定 State / β → Stage1 学习方式'
      : 'blocked updates → long run → smaller-model interface → candidate admission → parameter history → fixed State / β → Stage-1 learning'}</p>
  </header>
  <section id="experiment-directory" class="experiment-directory-heading" aria-labelledby="experiment-directory-title">
    <span>{zh ? '实验目录' : 'Experiment index'}</span>
    <div>
      <h2 id="experiment-directory-title">{zh ? '七次实验怎样一步步把问题缩小' : 'How seven experiments narrowed the question'}</h2>
      <p>{zh
        ? '每一项都保留“当时的问题 → 改了什么 → 结果边界 → 下一问”。如果你只想找最新一项，可以从上面的“隔一阵回来”直接进入。'
        : 'Every item keeps the chain question → intervention → result boundary → next question. If you only need the latest state, use the Returning later entry above.'}</p>
    </div>
  </section>
  <ol class="experiment-tree" aria-label={zh ? '主要实验目录' : 'Major experiment index'}>
    {OPEN_EVO_EXPERIMENTS.map((experiment) => (
      <li class="experiment-node" data-ui-audit-item>
        <div class="experiment-node__rail" aria-hidden="true"><span>{experiment.number}</span></div>
        <article>
          <a class="experiment-node__main" data-experiment-primary={experiment.id} href={p(experiment.primaryHref)}>
            <strong>{t(experiment.title)}</strong>
            <span aria-hidden="true">→</span>
          </a>
          <div class="experiment-node__progression" data-research-progression={experiment.id}>
            <p data-progression-step="question"><strong>{zh ? '当时的问题' : 'Question'}</strong><span>{t(experiment.researchQuestion)}</span></p>
            <p data-progression-step="intervention"><strong>{zh ? '这次改了什么' : 'Intervention'}</strong><span>{t(experiment.intervention)}</span></p>
            <p data-progression-step="result"><strong>{zh ? '结果边界' : 'Result boundary'}</strong><span>{t(experiment.resultBoundary)}</span></p>
            <p data-progression-step="next"><strong>{zh ? '留下的下一问' : 'Next question'}</strong><span>{t(experiment.nextQuestion)}</span></p>
          </div>
          {experiment.lineageNote && <p class="experiment-node__relation">{t(experiment.lineageNote)}</p>}
          <ul class="experiment-children">
            {directoryRowsFor(experiment.childLinks).map((row) => row.kind === 'link' ? (
              <li><a href={p(row.child.href)}>{t(row.child.label)} <span aria-hidden="true">→</span></a></li>
            ) : (
              <li class="experiment-child-group">
                <strong>{t(row.label)}</strong>
                <ul>
                  {row.children.map((child) => (
                    <li><a href={p(child.href)}>{t(child.label)} <span aria-hidden="true">→</span></a></li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          {directoryRowsFor(experiment.childLinks.filter((child) => child.mobileFeatured)).map((row) => row.kind === 'link' ? (
            <p class="experiment-mobile-featured"><a href={p(row.child.href)}>{t(row.child.label)} <span aria-hidden="true">→</span></a></p>
          ) : (
            <div class="experiment-mobile-featured experiment-mobile-featured--group">
              <strong>{t(row.label)}</strong>
              <div>
                {row.children.map((child) => <a href={p(child.href)}>{t(child.label)} <span aria-hidden="true">→</span></a>)}
              </div>
            </div>
          ))}
        </article>
      </li>
    ))}
  </ol>

  <aside class="secondary-routes" aria-label={zh ? '跨实验入口' : 'Cross-experiment routes'}>
    <strong>{zh ? '跨实验入口' : 'Across experiments'}</strong>
    <nav>
      {OPEN_EVO_SECONDARY_ROUTES.map((item) => <a data-secondary-route={item.id} href={p(item.href)}>{t(item.label)}</a>)}
    </nav>
  </aside>
</main>

<style>
  .experiment-index{width:min(960px,calc(100% - 2rem));margin:0 auto 5rem;color:var(--color-text)}
  .study-hero{padding:2.7rem 0 1.8rem;border-bottom:1px solid var(--color-border)}
  .study-hero h1{max-width:20ch;margin:0;font-size:clamp(2.35rem,5.4vw,4.25rem);line-height:1.02;letter-spacing:-.05em}
  .study-hero__lede{max-width:48rem;margin:1.2rem 0 0;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.7;color:var(--color-text-muted)}
  .study-reader-entry{margin:1.15rem 0 0;padding-top:1rem;border-top:1px solid var(--color-border)}
  .study-reader-entry nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
  .study-reader-entry a{display:grid;align-content:start;gap:.28rem;min-width:0;padding:.85rem 1rem .85rem 0;color:inherit;text-decoration:none}
  .study-reader-entry a+a{padding-left:1rem;border-left:1px solid var(--color-border)}
  .study-reader-entry small{color:var(--color-accent);font-size:.68rem;font-weight:800}
  .study-reader-entry strong{font-size:.9rem;line-height:1.35}
  .study-reader-entry span{color:var(--color-text-muted);font-size:.76rem;line-height:1.5}
  .study-reader-entry>p{max-width:72ch;margin:.7rem 0 0;color:var(--color-text-muted);font-size:.75rem;line-height:1.55}
  .study-reader-entry a:hover strong,.study-reader-entry a:focus-visible strong{color:var(--color-accent)}
  .study-hero__mobile-thread{display:none}
  .experiment-directory-heading{display:grid;grid-template-columns:4.25rem minmax(0,1fr);gap:1.1rem;padding:1.6rem 0 .45rem}
  .experiment-directory-heading>span{padding-top:.35rem;color:var(--color-accent);font:800 .68rem/1.2 var(--font-mono)}
  .experiment-directory-heading h2{max-width:22ch;margin:0;font-size:clamp(1.35rem,2.6vw,2rem);line-height:1.18;letter-spacing:-.025em}
  .experiment-directory-heading p{max-width:48rem;margin:.55rem 0 0;color:var(--color-text-muted);font-size:.84rem;line-height:1.6}
  .experiment-tree{list-style:none;margin:0;padding:0;counter-reset:none}
  .experiment-node{display:grid;grid-template-columns:4.25rem minmax(0,1fr);gap:1.1rem;padding:2rem 0;border-bottom:1px solid var(--color-border)}
  .experiment-node__rail{position:relative;display:flex;justify-content:center}
  .experiment-node__rail::after{content:'';position:absolute;top:2.5rem;bottom:-2rem;width:1px;background:var(--color-border)}
  .experiment-node:last-child .experiment-node__rail::after{display:none}
  .experiment-node__rail span{position:relative;z-index:1;display:grid;place-items:center;width:2.7rem;height:2.7rem;border-radius:50%;border:1px solid var(--color-border);background:var(--color-surface);font:800 .86rem/1 var(--font-mono)}
  .experiment-node article{min-width:0}
  .experiment-node__main{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;color:var(--color-text);text-decoration:none}
  .experiment-node__main strong{font-size:clamp(1.35rem,2.6vw,2rem);line-height:1.2;letter-spacing:-.025em}
  .experiment-node__main>span{font-size:1.35rem;color:var(--color-text-muted)}
  .experiment-node p{max-width:48rem;margin:.65rem 0 0;line-height:1.7;color:var(--color-text-muted)}
  .experiment-node__progression{max-width:50rem;margin:.9rem 0 0;border-top:1px solid var(--color-border)}
  .experiment-node__progression p{display:grid;grid-template-columns:7.2rem minmax(0,1fr);gap:.85rem;margin:0;padding:.58rem 0;border-bottom:1px solid var(--color-border);line-height:1.6}
  .experiment-node__progression strong{font-size:.84rem;line-height:1.45;color:var(--color-text);letter-spacing:.01em}
  .experiment-node__progression span{color:var(--color-text-muted)}
  .experiment-node__progression [data-progression-step="next"] span{color:var(--color-text);font-weight:650}
  .experiment-node__relation{padding-left:.75rem;border-left:2px solid var(--color-warning);color:var(--color-text)}
  .experiment-children{list-style:none;margin:1rem 0 0;padding:0 0 0 1.15rem;border-left:1px solid var(--color-border)}
  .experiment-children li+li{margin-top:.38rem}
  .experiment-children a{display:inline-block;padding:.2rem 0;color:var(--color-text);text-underline-offset:.22em}
  .experiment-children a span{color:var(--color-text-muted)}
  .experiment-child-group>strong{display:block;font-size:.9rem;line-height:1.35}
  .experiment-child-group>ul{list-style:none;margin:.45rem 0 0;padding:0 0 0 1rem;border-left:1px solid var(--color-border)}
  .experiment-child-group>ul li+li{margin-top:.3rem}
  .experiment-mobile-featured{display:none}
  .secondary-routes{display:flex;align-items:flex-start;justify-content:space-between;gap:1.2rem;padding:1.5rem 0;border-bottom:1px solid var(--color-border)}
  .secondary-routes>strong{font-size:.95rem}
  .secondary-routes nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.65rem 1.1rem}
  .secondary-routes a{color:var(--color-text-muted);text-underline-offset:.22em}
  a:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
  @media(max-width:640px){
    .experiment-index{width:calc(100% - 1.25rem)}
    .study-hero{padding:1.25rem 0 .85rem}
    .study-hero h1{font-size:2.15rem;line-height:1.02}
    .study-hero__lede{margin-top:.7rem;font-size:.96rem;line-height:1.45}
    .study-reader-entry{margin-top:.8rem;padding-top:.65rem}
    .study-reader-entry nav{grid-template-columns:1fr}
    .study-reader-entry a,.study-reader-entry a+a{padding:.58rem 0;border-left:0;border-top:1px solid var(--color-border)}
    .study-reader-entry a:first-child{border-top:0}
    .study-reader-entry span{display:none}
    .study-reader-entry>p{margin-top:.4rem}
    .study-hero__mobile-thread{display:block;margin:.5rem 0 0;font-size:.72rem;line-height:1.35;color:var(--color-text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .experiment-directory-heading{grid-template-columns:2.35rem minmax(0,1fr);gap:.6rem;padding:1rem 0 .25rem}
    .experiment-node{grid-template-columns:2.35rem minmax(0,1fr);gap:.6rem;padding:.62rem 0}
    .experiment-node__rail{justify-content:flex-start}
    .experiment-node__rail span{width:2.15rem;height:2.15rem}
    .experiment-node__rail::after{left:1.05rem;top:2.05rem;bottom:-.62rem}
    .experiment-node__main strong{font-size:1.12rem;line-height:1.15}
    .experiment-node__progression,.experiment-node__relation,.experiment-children{display:none}
    .experiment-node .experiment-mobile-featured{display:block;margin:.55rem 0 0;font-size:1rem;line-height:1.45;color:var(--color-text)}
    .experiment-mobile-featured a{color:var(--color-text);text-underline-offset:.2em}
    .experiment-mobile-featured--group{padding-left:.65rem;border-left:1px solid var(--color-border)}
    .experiment-mobile-featured--group>strong{display:block;font-size:.9rem}
    .experiment-mobile-featured--group>div{display:grid;gap:.12rem;margin-top:.2rem}
    .experiment-mobile-featured--group a{display:block;padding:.08rem 0}
    .experiment-tree{min-height:calc(100svh - 14rem)}
    .secondary-routes{display:block}
    .secondary-routes nav{justify-content:flex-start;margin-top:.65rem}
  }
</style>
