    flex-wrap: wrap;
    margin-bottom: .6rem;
  }
  .advisor-method__lane-head h4 {
    margin: 0;
    font-size: var(--type-minor-heading);
    font-weight: var(--type-weight-heading);
    line-height: var(--type-leading-heading);
  }
