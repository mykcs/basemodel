---
import { localePath, type Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
type Copy = { zh: string; en: string };

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (copy: Copy) => zh ? copy.zh : copy.en;
const p = (path: string) => localePath(locale, path);

const seedPaper = 'https://arxiv.org/abs/2607.14777';
const seedSource = 'https://github.com/jinyangwu/SEED/tree/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const sourceRepo = 'https://github.com/mykcs/openevo-experiment';
const currentMain = 'https://github.com/mykcs/openevo-experiment/commit/1ad894cfd76157b4f9ecde7e81351bd7564a1f65';
const seedSuccessor = 'https://github.com/mykcs/openevo-experiment/pull/367';
const trackAEvidence = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json';

const flowOverview = p('/research/seed-openevo/flow/');
const runDetails = p('/research/seed-openevo/study/run/');
const results = p('/research/seed-openevo/study/results/');
const capability = p('/research/seed-openevo/study/capability-exploration/');

const questions = [
  {
    id: 'Q1',
    title: { zh: 'OpenEVO 最终能不能比基线或 SEED 做得更好？', en: 'Can OpenEVO ultimately outperform the baseline or SEED?' },
    body: { zh: '这是主问题。必须在同一批任务、同一评测规则和匹配预算下比较最终冻结模型；训练过程里的高分不能代替这个答案。', en: 'This is the main question. Final frozen models must be compared on the same tasks, evaluation rules, and matched budget; training-time scores cannot substitute for that answer.' },
  },
  {
    id: 'Q2',
    title: { zh: '如果表现不同，差异从哪里来？', en: 'If performance differs, where does the gap come from?' },
    body: { zh: '基础模型、起始经验与 MiniMax 在运行结束后的轨迹分析等因素必须拆开，避免把不同起点误写成学习方法本身的效果。', en: 'Base model, starting experience, and MiniMax analysis performed after each run must be separated so different starting points are not mistaken for method effects.' },
  },
  {
    id: 'Q3',
    title: { zh: '更新筛选是在保护训练，还是挡住了长期有用的更新？', en: 'Does update filtering protect training or block updates that help later?' },
    body: { zh: 'GDR、No-GDR 与 DirectApply 属于机制实验，用来解释训练为什么变化；它们不能直接冒充主实验的最终结论。', en: 'GDR, No-GDR, and DirectApply are mechanism studies used to explain training behavior; they cannot stand in for the main experiment’s final conclusion.' },
  },
] as const;

const routes = [
  { href: flowOverview, title: { zh: '了解实验流程', en: 'Understand the experiment flow' }, body: { zh: 'WebShop、SEED、OpenEVO、训练设计与评测分别是什么。', en: 'What WebShop, SEED, OpenEVO, training design, and evaluation each do.' } },
  { href: results, title: { zh: '查看研究结果', en: 'View the research results' }, body: { zh: '已经封存的测量、统计解释，以及当前仍不能证明的内容。', en: 'Sealed measurements, statistical interpretation, and what remains unproven.' } },
  { href: capability, title: { zh: '理解变化原因', en: 'Understand why performance changes' }, body: { zh: '1.7B / 3B / 7B、GDR、DirectApply、参数更新与轨迹分析。', en: '1.7B / 3B / 7B, GDR, DirectApply, parameter updates, and trajectory analysis.' } },
  { href: runDetails, title: { zh: '复现实验', en: 'Reproduce the experiment' }, body: { zh: '运行条件、证据文件、开始与停止条件，以及执行入口。', en: 'Run conditions, evidence files, start/stop criteria, and execution entry points.' } },
] as const;
---

<main class="study" data-testid="study-overview" data-study-checked="2026-09-07">
  <header class="study-hero" data-study-orientation data-reader-primary>
    <h1>{zh ? 'OpenEVO (Harness) · WebShop 数据集实验' : 'OpenEVO (Harness) · WebShop dataset experiments'}</h1>

    <nav class="source-links" aria-label={zh ? '对照、论文与实验资源' : 'Comparison, paper, and experiment resources'}>
      <span>{zh ? '和 SEED 对照' : 'Compared with SEED'}</span>
      <a href={seedPaper} target="_blank" rel="noreferrer"><ExternalBrandMark href={seedPaper} />{zh ? 'SEED 论文' : 'SEED paper'}</a>
      <a href={sourceRepo} target="_blank" rel="noreferrer"><ExternalBrandMark href={sourceRepo} />GitHub</a>
      <a href={runDetails}>{zh ? '训练资源与运行条件' : 'Training resources and run conditions'}</a>
      <a href={flowOverview}>{zh ? '流程理解图：OpenEVO / SEED / WebShop' : 'Flow explainer: OpenEVO / SEED / WebShop'}</a>
    </nav>

    <div class="tldr" aria-label="TL;DR" data-study-answer>
      <p class="tldr-label">TL;DR</p>
      <div>
        <p class="lead">{zh
          ? '这项研究问一件事：在可比较的 WebShop 任务预算下，OpenEVO harness（实验架构）最终能把模型能力推到哪里。主实验负责回答“最终表现怎样”，机制实验只负责解释“为什么会变好或变差”。'
          : 'This study asks one thing: under a comparable WebShop task budget, how far can the OpenEVO harness ultimately push model capability? The main experiment answers final performance; mechanism studies explain why performance may change.'}</p>
        <p>{zh
          ? '目前同一批 128 个 WebShop 任务上的 7B 测量中，平均 Task Score 从 7.17 提到 8.74，但完整成功仍是 5 / 128，且差异的 95% 区间仍包含“没有提升”。OpenEVO 与 SEED 的同协议最终比较还没有完成，所以现在不能宣布谁最终更强。'
          : 'In the completed 7B measurement on the same 128 WebShop tasks, mean Task Score moved from 7.17 to 8.74, but exact success remained 5 / 128 and the 95% interval still includes no improvement. The final matched-protocol OpenEVO-versus-SEED comparison is not complete, so there is no justified winner yet.'}</p>
      </div>
    </div>
  </header>

  <section aria-labelledby="questions-title">
    <div class="section-heading">
      <span>01</span>
      <div><h2 id="questions-title">{zh ? '三个研究问题' : 'Three research questions'}</h2><p>{zh ? '一个问题判断最终效果，两个问题解释差异来源。' : 'One question establishes final performance; two questions explain where any difference comes from.'}</p></div>
    </div>
    <div class="question-list">
      {questions.map((item) => (
        <article><span>{item.id}</span><div><h3>{t(item.title)}</h3><p>{t(item.body)}</p></div></article>
      ))}
    </div>
  </section>

  <section aria-labelledby="measurement-title">
    <div class="section-heading">
      <span>02</span>
      <div><h2 id="measurement-title">{zh ? '当前可直接比较的 7B 结果' : 'The 7B result that is directly comparable today'}</h2><p>{zh ? '这两个数字来自同一批 128 个 WebShop 任务和同一评测方式。' : 'These two numbers come from the same 128 WebShop tasks and the same evaluation procedure.'}</p></div>
    </div>

    <div class="paired" aria-label={zh ? '7B 同任务比较' : '7B same-task comparison'}>
      <div>
        <p>{zh ? '7B · 基础模型' : '7B · base model'}</p>
        <strong>7.17</strong><span>/ 100</span>
        <small>5 / 128 {zh ? '完整成功' : 'exact successes'}</small>
      </div>
      <div class="delta"><strong>+1.57</strong><small>95% CI [-3.21, +6.31]</small></div>
      <div>
        <p>{zh ? '7B · 使用 OpenEVO 学习结果' : '7B · with OpenEVO learning result'}</p>
        <strong>8.74</strong><span>/ 100</span>
        <small>5 / 128 {zh ? '完整成功' : 'exact successes'}</small>
      </div>
    </div>

    <p class="comparison-boundary">{zh
      ? 'SEED 论文报告的 89.7 / 100 使用不同的模型、训练与评测口径，因此只能作为外部文献参照，不能和上面两个 7B 分数直接比较。'
      : 'SEED paper reports 89.7 / 100 under a different model, training setup, and evaluation protocol. It is an external literature reference and cannot be directly compared with the two 7B scores above.'}</p>
    <details class="depth">
      <summary>{zh ? '查看这组比较的来源与解释边界' : 'Open sources and interpretation boundaries'}</summary>
      <p>{zh ? '平均分出现正向方向，但完整成功数没有增加，且置信区间包含零，因此不能证明稳定优势。训练分、候选更新数量或执行进度也不能当作最终结果。' : 'The mean moved in a positive direction, but exact successes did not increase and the confidence interval includes zero, so this does not establish a stable advantage. Training scores, candidate-update counts, and execution progress also cannot be presented as the final result.'}</p>
      <div class="depth-links">
        <a href={results}>{zh ? '完整结果与统计解释 →' : 'Full results and statistical interpretation →'}</a>
        <a href={trackAEvidence} target="_blank" rel="noreferrer"><ExternalBrandMark href={trackAEvidence} />{zh ? '128 任务语义核对记录' : '128-task semantic-validation record'}</a>
        <a href={seedSource} target="_blank" rel="noreferrer"><ExternalBrandMark href={seedSource} />{zh ? 'SEED 原始仓库' : 'SEED source repository'}</a>
      </div>
    </details>
  </section>

  <section aria-labelledby="routes-title">
    <div class="section-heading">
      <span>03</span>
      <div><h2 id="routes-title">{zh ? '研究入口' : 'Research routes'}</h2><p>{zh ? '流程背景、结果、机制与复现分别放在各自页面，这里只保留入口。' : 'Flow background, results, mechanisms, and reproduction live on their own pages; this overview only keeps the routes.'}</p></div>
    </div>
    <nav class="route-list" aria-label={zh ? '研究详情入口' : 'Research detail routes'}>
      {routes.map((item) => <a href={item.href}><div><strong>{t(item.title)}</strong><span>{t(item.body)}</span></div><b aria-hidden="true">→</b></a>)}
    </nav>
  </section>

  <details class="provenance">
    <summary>{zh ? '当前状态来源与核验边界' : 'Current-state sources and verification boundary'}</summary>
    <div>
      <p>{zh
        ? '核验日期：2026-09-07。科学状态以 openevo-experiment 为准。下一阶段的 SEED 对照方案已经预先登记，但还没有获得正式运行任务的授权；因此本页不会把尚未封存的训练进度写成最终结果。'
        : 'Checked 2026-09-07. Scientific state follows openevo-experiment. The next SEED comparison stage has been preregistered, but formal task execution is not yet authorized; this page therefore does not present unsealed training progress as a final result.'}</p>
      <ul>
        <li><a href={currentMain} target="_blank" rel="noreferrer"><ExternalBrandMark href={currentMain} />openevo-experiment/main @ 1ad894c</a></li>
        <li><a href={seedSuccessor} target="_blank" rel="noreferrer"><ExternalBrandMark href={seedSuccessor} />{zh ? '下一阶段 SEED 对照预登记' : 'Next SEED comparison preregistration'}</a></li>
        <li><a href={sourceRepo} target="_blank" rel="noreferrer"><ExternalBrandMark href={sourceRepo} />{zh ? 'OpenEVO 实验仓库' : 'OpenEVO experiment repository'}</a></li>
      </ul>
    </div>
  </details>
</main>

<style>
  .study{width:min(1080px,calc(100% - 2rem));margin:0 auto 5rem;color:var(--color-text)}
  .study-hero{max-width:980px;min-height:calc(100svh - 4.6rem - var(--research-nav-offset,0rem));padding:2.6rem 0 2.4rem}
  .study-hero h1{margin:0;font-size:clamp(2.6rem,5vw,4.2rem);line-height:1;letter-spacing:-.055em;word-break:keep-all}
  .source-links{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem 1rem;margin:1.05rem 0 0;color:var(--color-text-muted);font-size:.84rem;line-height:1.5}.source-links>span{font-weight:760;color:var(--color-text)}.source-links a{display:inline-flex;align-items:center;gap:.32rem;color:inherit;text-underline-offset:.2em}
  .tldr{display:grid;grid-template-columns:5rem minmax(0,1fr);gap:1rem;margin:2rem 0 0;padding:1.35rem 0;border-block:1px solid var(--color-text)}.tldr-label{margin:.2rem 0 0;color:var(--color-accent);font-size:.76rem;font-weight:800;letter-spacing:.04em}.tldr div{max-width:78ch}.tldr div p{margin:0;font-size:1rem;line-height:1.72}.tldr .lead{font-size:clamp(1.12rem,2vw,1.35rem);line-height:1.55;letter-spacing:-.015em}.tldr div p+p{margin-top:.85rem;color:var(--color-text-muted)}
  section{padding:3rem 0;border-top:1px solid var(--color-border)}.section-heading{display:grid;grid-template-columns:3rem minmax(0,1fr);gap:1rem;max-width:900px;margin-bottom:1.5rem}.section-heading>span{padding-top:.35rem;color:var(--color-accent);font-size:.72rem;font-weight:800}.section-heading h2{margin:0;font-size:clamp(1.65rem,3.5vw,2.7rem);line-height:1.13;letter-spacing:-.04em}.section-heading div>p{max-width:72ch;margin:.6rem 0 0;color:var(--color-text-muted);font-size:.94rem;line-height:1.68}
  .question-list{border-top:1px solid var(--color-border)}.question-list article{display:grid;grid-template-columns:3rem minmax(0,1fr);gap:1rem;padding:1.2rem 0;border-bottom:1px solid var(--color-border)}.question-list article>span{color:var(--color-accent);font-size:.74rem;font-weight:800}.question-list h3{margin:0;font-size:1.04rem;line-height:1.5}.question-list p{max-width:76ch;margin:.42rem 0 0;color:var(--color-text-muted);font-size:.89rem;line-height:1.68}
  .paired{display:grid;grid-template-columns:1fr minmax(150px,.55fr) 1fr;border-block:1px solid var(--color-text)}.paired>div{padding:1.2rem 0}.paired>div:last-child{padding-left:1.2rem;border-left:1px solid var(--color-border)}.paired p{margin:0 0 .8rem;color:var(--color-text-muted);font-size:.8rem}.paired>div>strong{font-size:clamp(2.4rem,5.5vw,4.5rem);line-height:.9;letter-spacing:-.055em;font-variant-numeric:tabular-nums}.paired>div>span{margin-left:.3rem;color:var(--color-text-muted)}.paired small{display:block;margin-top:.7rem;color:var(--color-text-muted)}.paired .delta{display:grid;place-content:center;text-align:center;border-left:1px solid var(--color-border)}.paired .delta strong{font-size:1.45rem;letter-spacing:-.02em}.paired .delta small{margin-top:.35rem}
  .comparison-boundary{max-width:80ch;margin:1rem 0 0;color:var(--color-text-muted);font-size:.88rem;line-height:1.7}.depth,.provenance{margin-top:1rem;border-bottom:1px solid var(--color-border)}.depth summary,.provenance summary{cursor:pointer;padding:.9rem 0;font-weight:760}.depth p,.provenance p{max-width:80ch;margin:0;color:var(--color-text-muted);font-size:.86rem;line-height:1.7}.depth-links{display:flex;flex-wrap:wrap;gap:.5rem 1rem;padding:.7rem 0 1rem}.depth a,.provenance a{display:inline-flex;align-items:center;gap:.32rem;color:var(--color-accent);font-size:.82rem;overflow-wrap:anywhere}.provenance div{padding-bottom:1rem}.provenance ul{margin:.7rem 0 0;padding-left:1.1rem}.provenance li+li{margin-top:.3rem}
  .route-list{border-block:1px solid var(--color-text)}.route-list a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;padding:1.05rem 0;color:var(--color-text);text-decoration:none}.route-list a+a{border-top:1px solid var(--color-border)}.route-list strong{display:block;font-size:.98rem}.route-list span{display:block;max-width:76ch;margin-top:.25rem;color:var(--color-text-muted);font-size:.84rem;line-height:1.58}.route-list b{color:var(--color-accent)}.route-list a:hover strong,.route-list a:focus-visible strong{text-decoration:underline;text-underline-offset:.2em}
  a:focus-visible,summary:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}
  @media(max-width:760px){.study{width:min(100% - 1.25rem,1080px)}.study-hero{min-height:calc(100svh - 3.7rem - var(--research-nav-offset,0rem));padding-top:1.6rem}.section-heading{grid-template-columns:2rem minmax(0,1fr);gap:.6rem}.paired{grid-template-columns:1fr}.paired>div,.paired>div:last-child{padding:1rem 0;border-left:0}.paired .delta{padding:1rem 0;border-block:1px solid var(--color-border);border-left:0}.question-list article{grid-template-columns:2rem minmax(0,1fr)}}
  @media(max-width:430px){.study-hero h1{font-size:clamp(2.45rem,12vw,3.55rem)}.tldr{grid-template-columns:1fr;gap:.55rem}.tldr-label{margin:0}section{padding:2.5rem 0}}
</style>
