---
import { localePath, type Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
type Copy = { zh: string; en: string };
type ResearchQuestion = {
  id: 'Q1' | 'Q2' | 'Q3';
  question: Copy;
  why: Copy;
  experiments: Copy;
  unknown: Copy;
};
type ScoreRow = {
  subject: Copy;
  score: Copy;
  phase: Copy;
  comparison: Copy;
  href: string;
};
type Claim = {
  state: Copy;
  observation: Copy;
  supports: Copy;
  boundary: Copy;
  href: string;
};

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (copy: Copy) => zh ? copy.zh : copy.en;
const p = (path: string) => localePath(locale, path);

const sourceRepo = 'https://github.com/mykcs/openevo-experiment';
const currentMain = 'https://github.com/mykcs/openevo-experiment/commit/1ad894cfd76157b4f9ecde7e81351bd7564a1f65';
const q17ExecutionSnapshot = 'https://github.com/mykcs/openevo-experiment/blob/exec/stage2-shared-final-freeze-202609050041/configs/experiment/campaigns/202609030400/releases/qwen3-1p7b-stage2-vnext.json';
const threeBExecutionSnapshot = 'https://github.com/mykcs/openevo-experiment/blob/exec/stage2-shared-final-freeze-202609050041/configs/experiment/campaigns/202609030400/releases/qwen25-3b-stage2-vnext.json';
const seedSuccessor = 'https://github.com/mykcs/openevo-experiment/pull/367';
const trackAEvidence = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json';
const seedSource = 'https://github.com/jinyangwu/SEED/tree/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const seedPaper = 'https://arxiv.org/abs/2607.14777';
const flowOverview = p('/research/seed-openevo/flow/');
const runDetails = p('/research/seed-openevo/study/run/');

const questions: ResearchQuestion[] = [
  {
    id: 'Q1',
    question: { zh: '在相近的 WebShop 经验预算下，OpenEvo 最终能不能比基线或 SEED 做得更好？', en: 'Under a comparable WebShop experience budget, can OpenEvo ultimately outperform the baseline or SEED?' },
    why: { zh: '这是主问题。训练过程中出现高分、产生很多参数更新，都不能代替同一测试协议下的最终比较。', en: 'This is the main question. High training scores or many parameter updates cannot replace a final comparison under one evaluation protocol.' },
    experiments: { zh: '已经让 7B 基础模型和加载 OpenEVO 后的 7B 模型做过同一批 128 个 WebShop 任务；下一步是在相同任务、评测规则和匹配任务预算下重新比较 OpenEVO 与 SEED。', en: 'We have already run the 7B base model and the 7B model with OpenEVO on the same 128 WebShop tasks; the next step is to rerun OpenEVO and SEED under the same tasks, evaluation rules, and matched task budget.' },
    unknown: { zh: '还没有一组在同一套评测规则下完成并封存的 OpenEVO 与 SEED 最终结果，因此现在不能直接比较谁更强。', en: 'There is not yet a completed and sealed OpenEVO-versus-SEED final result under the same evaluation rules, so we cannot directly compare which is stronger.' },
  },
  {
    id: 'Q2',
    question: { zh: '如果表现不同，差异来自哪里：基础模型、起始经验，还是老师生成的 hindsight skill？', en: 'If performance differs, does the gap come from the base model, initial experience, or teacher-generated hindsight skills?' },
    why: { zh: '不同起点会改变后续训练能看到的成功经验数量与质量；不把它们拆开，就很难解释“为什么学得不一样”。', en: 'Different starting points change the amount and quality of successful experience available later; without separating them, the learning gap is hard to interpret.' },
    experiments: { zh: '1.7B / 3B 使用同一套初始经验收集流程，并用 MiniMax 分析轨迹；另有一个把 MiniMax 作为外部教师的 SEED 对照方案已经预注册。', en: 'The 1.7B and 3B lines use the same initial experience-collection process and MiniMax trajectory analysis; a SEED control using MiniMax as an external teacher has also been preregistered.' },
    unknown: { zh: '老师条件与起始经验对最终保留集成绩的独立因果贡献仍待受控对照。', en: 'The independent causal contribution of teacher condition and initial experience to final held-out performance still needs a controlled contrast.' },
  },
  {
    id: 'Q3',
    question: { zh: '更新筛选机制是在保护训练，还是把短期变差但长期有用的更新挡掉了？', en: 'Does the update filter protect training, or reject updates that look worse locally but help later?' },
    why: { zh: '“生成过候选更新”和“正式应用了更新”是两件事；筛选规则会改变实际进入模型的学习信号。', en: 'Generating a candidate update and actually applying it are different events; the filter changes which learning signals reach the retained model.' },
    experiments: { zh: 'GDR / No-GDR、DirectApply 与历史参数更新诊断属于机制研究；它们解释训练行为，不应直接冒充主 benchmark 结论。', en: 'GDR / No-GDR, DirectApply, and historical parameter-update diagnostics are mechanism studies. They explain training behavior and must not be promoted into the main benchmark conclusion.' },
    unknown: { zh: '局部拒绝是否改善长期泛化仍未形成充分的因果证据。', en: 'Whether local rejection improves long-horizon generalization is not yet causally established.' },
  },
];

const scoreRows: ScoreRow[] = [
  {
    subject: { zh: '7B · 基础模型', en: '7B · base model' },
    score: { zh: '7.17 / 100', en: '7.17 / 100' },
    phase: { zh: '同一批 128 个 WebShop 任务；完整成功 5 / 128。', en: 'The same 128 WebShop tasks; 5 / 128 exact successes.' },
    comparison: { zh: '可以和下一行直接比较。', en: 'Directly comparable with the next row.' },
    href: p('/research/seed-openevo/study/results/'),
  },
  {
    subject: { zh: '7B · 使用 OpenEVO 学习结果', en: '7B · with OpenEVO learning result' },
    score: { zh: '8.74 / 100', en: '8.74 / 100' },
    phase: { zh: '和上面同一批 128 个任务、同一评测方式；完整成功也是 5 / 128。', en: 'The same 128 tasks and evaluation as above; also 5 / 128 exact successes.' },
    comparison: { zh: '可以和上一行直接比较：平均 Task Score 高 1.57，但完整成功数没有增加。', en: 'Directly comparable with the row above: mean Task Score is 1.57 higher, with no increase in exact successes.' },
    href: p('/research/seed-openevo/study/results/'),
  },
  {
    subject: { zh: 'SEED · 论文结果', en: 'SEED · paper result' },
    score: { zh: '89.7 / 100', en: '89.7 / 100' },
    phase: { zh: '论文报告的 WebShop 最终结果，用作外部文献参照。', en: 'Paper-reported final WebShop result, retained as an external literature reference.' },
    comparison: { zh: '模型、训练与评测口径不同，不能和上面两个 7B 分数直接比较。', en: 'Model, training, and evaluation protocols differ; it cannot be directly compared with the two 7B scores above.' },
    href: seedSource,
  },
  {
    subject: { zh: '1.7B / 3B 当前训练与 SEED 对照', en: 'Current 1.7B / 3B training and SEED control' },
    score: { zh: '还没有可发布的最终测试分数', en: 'No publishable final-test score yet' },
    phase: { zh: '1.7B / 3B 的训练结果还没有完成最终封存；SEED 对照方案已经预注册，但还没有获准正式启动。', en: 'The 1.7B / 3B training results are not yet finally sealed; the SEED control is preregistered but has not yet been authorized to start.' },
    comparison: { zh: '训练过程分数和执行进度不能当作最终比较结果。', en: 'Training scores and execution progress are not final comparison results.' },
    href: currentMain,
  },
];

const claims: Claim[] = [
  {
    state: { zh: '已观察 · 历史测量', en: 'Observed · historical measurement' },
    observation: { zh: '在这次“同一批任务、两个 7B 模型”的对比里，OpenEVO 的平均 Task Score 更高，但完整成功数相同；不确定性区间仍包含“没有差异”。', en: 'In this same-task comparison of two 7B models, OpenEVO had a higher mean Task Score, but exact successes were tied; the uncertainty interval still included no difference.' },
    supports: { zh: '支持“这组冻结适配器在该面板上出现正向完成度方向”。', en: 'Supports a positive task-progress direction for this frozen adapter on this panel.' },
    boundary: { zh: '不能证明稳定优势，更不能把它改写成 OpenEvo 已经超过 SEED。', en: 'Does not establish a stable advantage and cannot be rewritten as OpenEvo already outperforming SEED.' },
    href: p('/research/seed-openevo/study/results/'),
  },
  {
    state: { zh: '已观察 · 机制证据', en: 'Observed · mechanism evidence' },
    observation: { zh: '历史能力实验已经证明参数更新可以真实发生；同时也出现过接口错误、更新筛选和分数波动。', en: 'Historical capability studies show that real parameter updates can occur, while also exposing interface errors, update filtering, and score variation.' },
    supports: { zh: '支持把“学习链条有没有动”与“新任务成绩有没有提高”分成两个问题。', en: 'Supports separating “did the learning machinery update?” from “did unseen-task performance improve?”' },
    boundary: { zh: '参数更新次数、候选更新数量和训练分都不是最终测试分，也不是因果收益。', en: 'Counts of applied updates, candidate updates, and training scores are not final-test scores or causal gains.' },
    href: p('/research/seed-openevo/study/capability-exploration/'),
  },
  {
    state: { zh: '待验证 · 当前主问题', en: 'Pending · current main question' },
    observation: { zh: '截至 2026-09-07，一个把 MiniMax 作为外部教师的 SEED Stage 2 对照方案已经预注册，但还没有获准正式启动；最终评测也还没有进行。', en: 'As of 2026-09-07, a SEED Stage 2 control using MiniMax as an external teacher is preregistered but not yet authorized to start; final evaluation has not yet run.' },
    supports: { zh: '下一步应先完成受控训练并封存结果，再按同一套评测规则做最终测试。', en: 'The next step is to finish controlled training, seal the results, and then run the final test under the same evaluation rules.' },
    boundary: { zh: '预注册、开始训练、训练结束、最终结果封存是四个不同状态；现在不能跳到最终结论。', en: 'Preregistration, training started, training completed, and final result sealed are four different states; the evidence does not justify jumping to a final conclusion.' },
    href: seedSuccessor,
  },
];

const deepLinks = [
  { href: p('/research/seed-openevo/flow/#training-design'), title: { zh: '训练设计', en: 'Training design' }, body: { zh: '公平预算、老师角色、参数协议、候选更新与正式应用更新。', en: 'Fair budgets, teacher roles, parameter protocols, candidate updates, and applied updates.' } },
  { href: p('/research/seed-openevo/study/run/'), title: { zh: '运行与复现', en: 'Run and reproduce' }, body: { zh: '执行入口、证据文件、开始与停止条件。', en: 'Execution entry points, evidence files, and start/stop conditions.' } },
  { href: p('/research/seed-openevo/study/capability-exploration/'), title: { zh: '机制与能力实验', en: 'Mechanism and capability studies' }, body: { zh: '1.7B / 3B / 7B、GDR、DirectApply、参数更新与轨迹分析。', en: '1.7B / 3B / 7B, GDR, DirectApply, parameter updates, and trajectory analysis.' } },
  { href: p('/research/seed-openevo/study/results/'), title: { zh: '研究结果', en: 'Research findings' }, body: { zh: '已封存结果、统计解释、证据来源与仍不能证明的内容。', en: 'Sealed results, statistical interpretation, provenance, and what remains unproven.' } },
] as const;
---

<div class="study-overview" data-testid="study-overview" data-study-checked="2026-09-07">
  <header class="study-hero" data-reader-primary>
    <h1>{zh ? 'OpenEVO (Harness) · WebShop 数据集实验' : 'OpenEVO (Harness) · WebShop dataset experiments'}</h1>
    <p class="study-current-finding">{zh
      ? '目前已经观察到真实参数更新；让 7B 基础模型和加载 OpenEVO 后的 7B 模型做同一批 128 个 WebShop 任务时，OpenEVO 的平均 Task Score 更高，但完整成功数没有增加。同一套规则下的 OpenEVO 与 SEED 最终比较还没有完成，所以现在不能宣布谁最终更强。'
      : 'So far we have observed real parameter updates. When the 7B base model and the 7B model with OpenEVO ran the same 128 WebShop tasks, OpenEVO had a higher mean Task Score but no increase in exact successes. A final OpenEVO-versus-SEED comparison under the same rules is still incomplete, so there is no justified final winner yet.'}</p>
    <div class="study-hero__actions">
      <a class="button button-primary" href={p('/research/seed-openevo/study/results/')}>{zh ? '看目前结果 →' : 'See current findings →'}</a>
      <a class="button button-secondary" href="#questions-title">{zh ? '看实验怎么比较' : 'See how the study compares conditions'}</a>
    </div>
    <details class="study-hero__secondary">
      <summary>{zh ? '实验结构与参考资料' : 'Study structure and references'}</summary>
      <p class="study-structure-note">{zh
        ? '实验分成两条线：主 benchmark 用冻结评测比较 OpenEVO harness 与基线 / SEED；机制实验用 1.7B / 3B / 7B、MiniMax hindsight、GDR / DirectApply 等对照解释为什么会变好或变差。'
        : 'The study has two lines: the main benchmark uses frozen evaluation to compare the OpenEVO harness with baselines / SEED, while mechanism studies use 1.7B / 3B / 7B, MiniMax hindsight, GDR / DirectApply, and related controls to explain why performance may improve or degrade.'}</p>
      <div class="hero-meta" aria-label={zh ? '对照、论文与实验资源' : 'Comparison, paper, and experiment resources'}>
        <span>{zh ? '和 SEED 对照' : 'Compared with SEED'}</span>
        <a href={seedPaper} target="_blank" rel="noreferrer">
          <span class="paper-mark" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M4 1.5h5l3 3v10H4zM9 1.5v3h3M6 8h4M6 10.5h4" /></svg></span>
          {zh ? 'SEED 论文' : 'SEED paper'}
        </a>
        <a href={runDetails}>{zh ? '训练资源与运行条件' : 'Training resources and run conditions'}</a>
        <a href={flowOverview}>{zh ? '流程理解图：OpenEVO / SEED / WebShop' : 'Flow explainer: OpenEVO / SEED / WebShop'}</a>
      </div>
    </details>
  </header>

  <section class="study-section" aria-labelledby="questions-title">
    <div class="section-heading">
      <p>01</p>
      <div>
        <h2 id="questions-title">{zh ? '三个研究问题' : 'Three research questions'}</h2>
        <p>{zh ? '一个主问题比较最终表现；两个机制问题解释差异来自哪里。' : 'One main question compares final performance; two mechanism questions explain where any difference comes from.'}</p>
      </div>
    </div>
    <dl class="question-map">
      {questions.map((item) => (
        <div>
          <dt><span>{item.id}</span>{t(item.question)}</dt>
          <dd><p><strong>{zh ? '为什么做：' : 'Why: '}</strong>{t(item.why)}</p><p><strong>{zh ? '对应实验：' : 'Experiments: '}</strong>{t(item.experiments)}</p><p><strong>{zh ? '还不知道：' : 'Unknown: '}</strong>{t(item.unknown)}</p></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="study-section" aria-labelledby="study-flow-title">
    <div class="section-heading">
      <p>02</p>
      <div>
        <h2 id="study-flow-title">{zh ? '实验共同流程' : 'Shared experimental flow'}</h2>
        <p>{zh ? '不同实验改的是不同环节，但开始、学习和最终判断必须分开。' : 'Different experiments change different links, while starting state, learning, and final judgment stay distinct.'}</p>
      </div>
    </div>
    <ol class="process" aria-label={zh ? 'WebShop 研究三阶段' : 'Three stages of the WebShop study'}>
      <li><span>1</span><div><strong>{zh ? '建立起点' : 'Establish the start'}</strong><p>{zh ? '固定模型、任务范围和初始经验；先记录模型学习前能做什么。' : 'Freeze model, task range, and initial experience; record what the model can do before learning.'}</p></div></li>
      <li><span>2</span><div><strong>{zh ? '持续学习' : 'Continue learning'}</strong><p>{zh ? '模型继续做任务并产生训练信号。候选更新可以被筛选；只有被正式应用的更新才改变保留模型。' : 'The model keeps acting and producing learning signals. Candidate updates may be filtered; only applied updates change the retained model.'}</p></div></li>
      <li><span>3</span><div><strong>{zh ? '冻结后评测' : 'Evaluate after freezing'}</strong><p>{zh ? '停止学习，用预先固定的测试任务比较 Task Score 与 Exact Success。训练分不能搬到这里冒充 final。' : 'Stop learning and evaluate on preregistered tasks using Task Score and Exact Success. Training scores cannot be relabeled as final results.'}</p></div></li>
    </ol>
  </section>

  <section class="study-section" aria-labelledby="score-title">
    <div class="section-heading">
      <p>03</p>
      <div>
        <h2 id="score-title">{zh ? '分数与阶段' : 'Scores and phases'}</h2>
        <p>{zh ? '同一张表先标清“这个数字是什么阶段”，再决定能不能比较。' : 'The table labels each number by phase before deciding whether a comparison is valid.'}</p>
      </div>
    </div>
    <div class="table-scroll" tabindex="0" aria-label={zh ? 'OpenEvo 与 SEED 分数口径表，可横向滚动' : 'OpenEvo and SEED score provenance table, horizontally scrollable'}>
      <table>
        <thead><tr><th>{zh ? '对象' : 'Subject'}</th><th>{zh ? '分数' : 'Score'}</th><th>{zh ? '分数阶段' : 'Score phase'}</th><th>{zh ? '可直接比较吗？' : 'Directly comparable?'}</th></tr></thead>
        <tbody>
          {scoreRows.map((row) => (
            <tr>
              <th scope="row"><a href={row.href} target={row.href.startsWith('http') ? '_blank' : undefined} rel={row.href.startsWith('http') ? 'noreferrer' : undefined}>{row.href.startsWith('http') && <ExternalBrandMark href={row.href} />}{t(row.subject)}</a></th>
              <td class="score-cell">{t(row.score)}</td>
              <td>{t(row.phase)}</td>
              <td>{t(row.comparison)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">{zh
      ? '因此这里不会把 8.74 和 89.7 做差，也不会把训练过程分数、更新次数或执行进度写成“最终分数”。'
      : 'Therefore this page does not subtract 8.74 from 89.7, and it does not turn training-time scores, update counts, or execution progress into a final score.'}</p>
  </section>

  <section class="study-section" aria-labelledby="claims-title">
    <div class="section-heading">
      <p>04</p>
      <div>
        <h2 id="claims-title">{zh ? '当前结论' : 'Current findings'}</h2>
        <p>{zh ? '每条结论同时列出观察、能支持什么，以及不能证明什么。' : 'Each finding lists the observation, what it supports, and what it does not prove.'}</p>
      </div>
    </div>
    <div class="claim-list">
      {claims.map((claim) => (
        <article>
          <p class="claim-state">{t(claim.state)}</p>
          <p><strong>{zh ? '观察：' : 'Observation: '}</strong>{t(claim.observation)}</p>
          <p><strong>{zh ? '支持：' : 'Supports: '}</strong>{t(claim.supports)}</p>
          <p><strong>{zh ? '不能证明：' : 'Does not prove: '}</strong>{t(claim.boundary)}</p>
          <a href={claim.href} target={claim.href.startsWith('http') ? '_blank' : undefined} rel={claim.href.startsWith('http') ? 'noreferrer' : undefined}>{claim.href.startsWith('http') && <ExternalBrandMark href={claim.href} />}{zh ? '查看对应证据 →' : 'Open supporting evidence →'}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="study-section next-question" aria-labelledby="next-title">
    <div class="section-heading">
      <p>05</p>
      <div>
        <h2 id="next-title">{zh ? '下一步科学问题' : 'Next scientific question'}</h2>
        <p>{zh
          ? '先让 OpenEVO 和 SEED 在同一套任务、评测规则和匹配任务预算下完成训练与最终测试，再比较谁更强；之后再用 GDR / DirectApply 等机制对照解释差异。'
          : 'First complete OpenEVO and SEED training and final testing on the same tasks, evaluation rules, and matched task budget; then compare which is stronger, and only afterward use GDR / DirectApply-style controls to explain the difference.'}</p>
      </div>
    </div>
    <p class="stop-rule">{zh
      ? '停止条件：训练跑完不等于科学结论成立。只有预先固定的最终测试任务全部完成、结果封存、统计与来源可核对后，这个主问题才可以下结论。'
      : 'Stopping rule: finishing training does not establish the scientific conclusion. The main question becomes answerable only after all predefined final-test tasks complete, results are sealed, and the statistics and provenance are auditable.'}</p>
  </section>

  <nav class="deep-links" aria-label={zh ? '研究详情入口' : 'Research detail routes'}>
    {deepLinks.map((item) => <a href={item.href}><strong>{t(item.title)}</strong><span>{t(item.body)}</span><b aria-hidden="true">→</b></a>)}
  </nav>

  <details class="provenance">
    <summary>{zh ? '当前状态来源与核验边界' : 'Current-state sources and verification boundary'}</summary>
    <div>
      <p>{zh
        ? '核验日期：2026-09-07。科学状态以 openevo-experiment 为权威；默认分支已经合入 MiniMax-teacher SEED Stage2 successor 的预注册。公开执行分支的 1.7B release 标记为需要人工核对当前 external execution-state，3B release 标记为正式 vNext 启动待完成。这里因此不复制聊天记录里的历史 Rxx 进度，也不把任何未封存训练分写成 final。'
        : 'Checked 2026-09-07. openevo-experiment is the scientific authority; default main contains the MiniMax-teacher SEED Stage2 successor preregistration. On the public execution branch, the 1.7B release requires manual reconciliation of the current external execution state and the 3B release marks formal vNext start as pending. This page therefore does not copy historical Rxx counters from chat or relabel unsealed training scores as final.'}</p>
      <ul>
        <li><a href={currentMain} target="_blank" rel="noreferrer"><ExternalBrandMark href={currentMain} />openevo-experiment/main @ 1ad894c</a></li>
