---
import { type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (cn: string, en: string) => locale === 'zh' ? cn : en;
---
<section class="webshop-entry" aria-label={t('模拟购物任务示例', 'Illustrative shopping request')} data-ui-audit="contrast layout overflow">
  <div class="shopping-brief">
    <div class="shopping-brief__copy">
      <span>{t('一张购物清单 · 教学案例', 'A shopping request · illustrative example')}</span>
      <strong>{t('帮我买一双适合雨天、透气、9 码的跑鞋，预算最多 60 美元。', 'Find waterproof, breathable running shoes in size 9 for no more than $60.')}</strong>
      <p>{t('选了哪件商品，就决定了后面有哪些颜色、尺码和价格。', 'An agent has to search, inspect available options and make the purchase. An earlier product choice changes which later actions are possible.')}</p>
    </div>
    <div class="shopping-brief__receipt" aria-label={t('这张购物单的四项要求', 'Four conditions in this shopping request')}>
      <span>{t('待核对 · 购物条件', 'REQUIREMENTS')}</span>
      <ul>
        <li>{t('防水', 'Waterproof')}</li><li>{t('透气', 'Breathable')}</li>
        <li>{t('尺码 9', 'Size 9')}</li><li>{t('价格 ≤ $60', 'Price ≤ $60')}</li>
      </ul>
      <small>{t('这只是教学商品，不是实际数据集记录。', 'This is a teaching example, not a dataset record.')}</small>
    </div>
  </div>
  <a class="shopping-brief__action" href="#webshop-experience">开始这笔模拟购物 <span aria-hidden="true">↓</span></a>
</section>
<style>
  .webshop-entry { min-width: 0; width: 100%; margin: 0 auto 1rem; }
  .shopping-brief { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(240px, .7fr); gap: clamp(1rem, 4vw, 2.4rem); align-items: start; border-top: 1px solid var(--line); padding: 1.1rem 0; }
  .shopping-brief__copy>span, .shopping-brief__receipt>span { color: var(--accent-deep); font: 750 .68rem/1.4 var(--font-mono); }
  .shopping-brief__copy>strong { display: block; max-width: 28ch; margin: .6rem 0 .6rem; color: var(--ink); font-size: clamp(1.15rem, 2.5vw, 1.55rem); line-height: 1.4; font-weight: 780; }
  .shopping-brief__copy p { max-width: 57ch; margin: 0; color: var(--muted); font-size: .86rem; line-height: 1.65; }
  .shopping-brief__receipt { min-width: 0; padding: .75rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--surface); }
  .shopping-brief__receipt ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .4rem .65rem; margin: .55rem 0 .6rem; padding: 0; list-style: none; }
  .shopping-brief__receipt li { padding: .45rem 0; border-bottom: 1px solid var(--line); font-size: .83rem; font-weight: 720; }
  .shopping-brief__receipt small { display: block; margin-top: .25rem; color: var(--muted); font-size: .68rem; line-height: 1.5; }
  .shopping-brief__action { display:inline-flex; gap:.8rem; align-items:center; padding:.45rem 0; border-bottom:1px solid var(--accent-deep); color:var(--accent-deep); font-size:.83rem; font-weight:760; text-decoration:none; }
  .shopping-brief__action:hover, .shopping-brief__action:focus-visible { text-decoration:underline; text-underline-offset:4px; }
  @media(max-width:780px) {
    .shopping-brief { grid-template-columns: 1fr; gap: .9rem; }
    .shopping-brief__receipt { max-width: 500px; }
  }
</style>
