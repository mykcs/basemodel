---
import type { Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import { OPEN_EVO_EVIDENCE_LINKS, OPEN_EVO_HARNESS_FAIRNESS, OPEN_EVO_STAGE1_FREEZE } from '../../data/openEvoSuccessorNarrative';

interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
---
<section class:list={['harness-fairness', compact && 'harness-fairness--compact']} data-testid="openevo-harness-fairness" aria-labelledby="harness-fairness-title">
  <header>
    <p>HARNESS FAIRNESS · CLAIM BOUNDARY</p>
    <h2 id="harness-fairness-title">{t('Harness 只铺环境，不替模型做题', 'The harness sets the interface; it does not solve the task')}</h2>
    <strong>{t('准确说法：strategy-neutral bootstrap harness。不是“零脚手架裸跑”。', 'Precise claim: strategy-neutral bootstrap harness. Not “zero-scaffolding raw model.”')}</strong>
    <span>{t(
      '公平性来自两边使用同一套接口与预算语义，并把 task-solving strategy、learned carriers、外部老师行动和 final-panel 信息挡在 raw Stage 1 之外；同时我们把 hard action envelope 和通用短推理明确列作实验条件。',
      'Fairness comes from one interface and one budget semantics across both arms, while task-solving strategy, learned carriers, external teacher actions, and final-panel information stay outside raw Stage 1. The hard action envelope and generic brief deliberation are disclosed as experimental conditions.'
    )}</span>
  </header>

  <div class="harness-fairness__rows">
    {OPEN_EVO_HARNESS_FAIRNESS.map((row) => (
      <article data-fairness-state={row.state}>
        <div>
          <h3>{zh ? row.label.zh : row.label.en}</h3>
          <b>{zh ? row.value.zh : row.value.en}</b>
        </div>
        <p>{zh ? row.note.zh : row.note.en}</p>
      </article>
    ))}
  </div>

  {!compact && (
    <div class="harness-fairness__contract">
      <div>
        <span>{t('共享 raw Stage 1 合同', 'SHARED RAW STAGE-1 CONTRACT')}</span>
        <strong>{OPEN_EVO_STAGE1_FREEZE.tasks} tasks × {OPEN_EVO_STAGE1_FREEZE.rolloutsPerTask} rollouts = {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} / arm</strong>
        <small>T={OPEN_EVO_STAGE1_FREEZE.temperature} · top_p={OPEN_EVO_STAGE1_FREEZE.topP} · top_k={OPEN_EVO_STAGE1_FREEZE.topK} · max_steps={OPEN_EVO_STAGE1_FREEZE.maxSteps} · history={OPEN_EVO_STAGE1_FREEZE.historyLength}</small>
      </div>
      <div>
        <span>{t('最重要的边界', 'MOST IMPORTANT BOUNDARY')}</span>
        <strong>{t('允许“怎么和环境说话”；禁止“这道题应该怎么做”。', 'Allow “how to speak to the environment”; forbid “how to solve this task.”')}</strong>
        <small>{t('因此 hard admissible-action formatting 是接口帮助，不是 answer policy；但它仍必须被报告。', 'Hard admissible-action formatting is interface assistance rather than an answer policy, but it still must be reported.')}</small>
      </div>
    </div>
  )}

  <footer>
    <a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Pr} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Pr} />PR #270 · shared Stage1 authority</a>
    <a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Design} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Design} />freeze {OPEN_EVO_STAGE1_FREEZE.id} · design.json</a>
  </footer>
</section>

<style>
.harness-fairness{display:grid;grid-template-columns:minmax(230px,.58fr) minmax(0,1.42fr);gap:1rem 1.2rem;padding:1.2rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.harness-fairness>header{display:grid;align-content:start;gap:.38rem}.harness-fairness>header p{margin:0;color:var(--accent-deep);font:800 .57rem/1.3 var(--font-mono);letter-spacing:.07em}.harness-fairness>header h2{margin:0;font-size:1.25rem;line-height:1.12}.harness-fairness>header strong{font-size:.82rem;line-height:1.45}.harness-fairness>header span{color:var(--muted);font-size:.76rem;line-height:1.55}.harness-fairness__rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.48rem}.harness-fairness__rows article{display:grid;gap:.32rem;padding:.68rem .72rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface)}.harness-fairness__rows article[data-fairness-state="declared-scaffold"]{border-left:3px double var(--accent-deep)}.harness-fairness__rows article[data-fairness-state="unknown"]{border-style:dashed}.harness-fairness__rows article>div{display:flex;justify-content:space-between;gap:.65rem;align-items:start}.harness-fairness__rows h3{margin:0;font-size:.72rem;line-height:1.3}.harness-fairness__rows b{flex:0 0 auto;color:var(--accent-deep);font:800 .55rem/1.3 var(--font-mono);letter-spacing:.04em}.harness-fairness__rows p{margin:0;color:var(--muted);font-size:.66rem;line-height:1.48}.harness-fairness__contract{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.harness-fairness__contract>div{display:grid;gap:.2rem;padding:.7rem;border-top:1px solid var(--line);background:var(--surface-muted)}.harness-fairness__contract span{color:var(--muted);font:800 .52rem/1.2 var(--font-mono);letter-spacing:.06em}.harness-fairness__contract strong{font-size:.78rem;line-height:1.4}.harness-fairness__contract small{color:var(--muted);font-size:.64rem;line-height:1.45}.harness-fairness footer{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.45rem 1rem}.harness-fairness footer a{display:inline-flex;align-items:center;gap:.35rem;color:var(--accent-deep);font-size:.68rem;font-weight:750;text-underline-offset:.2em}.harness-fairness--compact{grid-template-columns:1fr}.harness-fairness--compact .harness-fairness__rows{grid-template-columns:repeat(3,minmax(0,1fr))}.harness-fairness--compact footer{grid-column:auto}
@media(max-width:820px){.harness-fairness,.harness-fairness--compact{grid-template-columns:1fr}.harness-fairness__rows,.harness-fairness--compact .harness-fairness__rows{grid-template-columns:1fr}.harness-fairness__contract{grid-template-columns:1fr}.harness-fairness footer{grid-column:auto}}
</style>
