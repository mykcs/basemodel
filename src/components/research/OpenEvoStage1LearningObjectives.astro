---
import type { Locale } from '../../i18n';
import ResearchRouteContext from './ResearchRouteContext.astro';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const objectiveRows = [
  {
    method: 'OPSD',
    learning: t('privileged episode_skill + generalized JSD', 'privileged episode_skill + generalized JSD'),
    budget: '11,198',
    score: '36.01',
    exact: '0 / 32',
    note: t('当前 Stage1 正式 bootstrap；训练后 LoRA 被 merge 进 Stage2 base。', 'Current formal Stage-1 bootstrap; its LoRA is merged into the Stage-2 base.'),
  },
  {
    method: 'SFT · 1 pass',
    learning: t('原始 assistant completion 的交叉熵', 'cross-entropy on the original assistant completion'),
    budget: '11,198',
    score: '34.96',
    exact: '3 / 32',
    note: t('同数据、同 rank8、同 optimizer-step 预算的第一组 objective ablation。', 'The first objective ablation with the same data, rank-8 LoRA, and optimizer-step budget.'),
  },
];

const sftCurve = [
  { step: '4,096', score: '44.72', exact: '1 / 32' },
  { step: '8,192', score: '42.74', exact: '1 / 32' },
  { step: '10,240', score: '32.01', exact: '1 / 32' },
  { step: '11,198 · final', score: '34.96', exact: '3 / 32' },
];

const nextArms = [
  {
    name: 'SFT · 3 epochs',
    state: t('已完成', 'Completed'),
    purpose: t('三轮普通 SFT 的 development Task Score 依次为 0.3553 → 0.2830 → 0.2410；继续增加普通 SFT 预算没有改善。', 'Across three ordinary-SFT epochs, development Task Score falls 0.3553 → 0.2830 → 0.2410; adding more ordinary-SFT budget did not improve the result.'),
  },
  {
    name: 'SEED-style hindsight-skill SFT',
    state: t('已完成 · Stage1 only', 'Completed · Stage 1 only'),
    purpose: t('3 epoch / 486 step 的监督目标学得更好，但固定 64 题 WebShop capability 没有提升；这不是完整 SEED Stage2 的结论。', 'The supervised objective improves over 3 epochs / 486 steps, but capability on the fixed 64-task WebShop panel does not; this is not a conclusion about full SEED Stage 2.'),
  },
];

const seedStyleCurve = [
  { state: 'initial', score: '0.0369', positive: '6 / 64', exact: '0 / 64' },
  { state: 'epoch1 · step162', score: '0.0352', positive: '3 / 64', exact: '0 / 64' },
  { state: 'epoch2 · step324', score: '0.0000', positive: '0 / 64', exact: '0 / 64' },
  { state: 'epoch3 · step486', score: '0.0000', positive: '0 / 64', exact: '0 / 64' },
];
---

<ResearchRouteContext locale={locale} route="stage1-learning-objectives" experimentId="stage1-learning-objectives" compact />

<main
  class="stage1-study"
  data-copy-review
  data-reader-page="stage1-learning-objectives"
  data-ui-audit="contrast layout"
  data-testid="stage1-learning-objectives"
>
  <header class="hero" data-reader-context data-reader-task>
    <p class="eyebrow">{t('实验 07 · Stage1 参数学习', 'Experiment 07 · Stage-1 parameter learning')}</p>
    <h1>{t('监督目标学得更好，WebShop 却没有改善', 'The training target improved; WebShop did not')}</h1>
    <figure class="stage1-contrast" data-stage1-result data-reader-purpose aria-labelledby="stage1-contrast-caption">
      <div class="stage1-measures">
        <section class="stage1-measure" aria-label={t('监督目标拟合', 'Supervised-target fit')}>
          <p class="measure-label">{t('监督目标拟合', 'Supervised-target fit')}</p>
          <p class="measure-value"><span>Train loss</span><strong>2.713 → 0.830</strong></p>
          <p class="measure-note">{t('Validation loss（step 162 / 324 / 486）：1.161 → 1.091 → 1.093，不是逐轮单调下降。', 'Validation loss (steps 162 / 324 / 486): 1.161 → 1.091 → 1.093; it does not decrease monotonically.')}</p>
        </section>
        <section class="stage1-measure" aria-label={t('固定 64 题 WebShop 能力', 'Fixed 64-task WebShop capability')}>
          <p class="measure-label">{t('固定 64 题 WebShop capability', 'Fixed 64-task WebShop capability')}</p>
          <p class="measure-value"><span>Task Score</span><strong>0.0369 → 0.0352 → 0 → 0</strong></p>
          <p class="measure-note">{t('Initial / epoch1 / epoch2 / epoch3；正奖励 6/64 → 3/64 → 0 → 0；Exact Success 全程 0/64。', 'Initial / epochs 1–3; positive reward 6/64 → 3/64 → 0 → 0; exact success stays 0/64.')}</p>
        </section>
      </div>
      <figcaption id="stage1-contrast-caption">
        {t('64 题 Task Score 的 epoch1 差异范围包含 0，epoch2/3 低于 initial。两组指标分开使用各自单位，不共用刻度；完整 Stage2 未测试，final panel 未访问。', 'The epoch1 Task Score interval on the 64-task panel includes zero; epochs 2 and 3 are below initial. The measures keep separate units and scales; full Stage 2 was not tested and the final panel was untouched.')}
      </figcaption>
    </figure>
  </header>

  <section class="section" id="next" data-result-stage="direct-result">
    <div class="section-heading">
      <span>01</span>
      <div>
        <h2>{t('更多 Stage1 训练没有带来 WebShop capability 提升', 'More Stage 1 training did not improve WebShop capability')}</h2>
        <p>{t('这里必须把 optimization 和 capability 分开看：loss 下降只能说明模型更会完成监督目标，不能自动等价成更会做 WebShop。', 'Optimization and capability must stay separate here: lower loss means the model fits the supervised target better, not automatically that it solves WebShop better.')}</p>
      </div>
    </div>
    <div class="next-grid">
      {nextArms.map((arm) => (
        <article>
          <small>{arm.state}</small>
          <strong>{arm.name}</strong>
          <p>{arm.purpose}</p>
        </article>
      ))}
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>{t('SEED-style Stage1 状态', 'SEED-style Stage-1 state')}</th>
            <th>64-task Task Score</th>
            <th>{t('正奖励', 'Positive reward')}</th>
            <th>Exact Success</th>
          </tr>
        </thead>
        <tbody>
          {seedStyleCurve.map((row) => (
            <tr>
              <th scope="row">{row.state}</th>
              <td>{row.score}</td>
              <td>{row.positive}</td>
              <td>{row.exact}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="caption">{t(
      '固定 64 题 outcome-blind development / primary-validation panel。epoch1 − initial 的平均 Task Score 差为 −0.00164，95% CI 跨 0；epoch2 / epoch3 相对 initial 都是 −0.03689，95% CI 均低于 0。final panel 仍未访问。',
      'Fixed 64-task outcome-blind development / primary-validation panel. Mean Task Score difference epoch1 − initial is −0.00164 with a 95% CI crossing zero; epoch2 / epoch3 are both −0.03689 versus initial, with 95% CIs below zero. The final panel remains untouched.'
    )}</p>
    <p class="method-note">{t('该臂使用历史 MiniMax analysis targets 与 full-parameter FSDP：1,296 条训练、144 条验证、3 epochs / 486 steps，learning rate 5e−6、global batch 8。它与早期 rank8 LoRA 的 11,198-step SFT / OPSD 对照是不同实验。', 'This arm used historical MiniMax analysis targets with full-parameter FSDP: 1,296 training and 144 validation examples, 3 epochs / 486 steps, learning rate 5e−6, global batch 8. It is a different experiment from the earlier rank-8 LoRA, 11,198-step SFT / OPSD comparison.')}</p>
    <p class="interpretation">{t(
      'ELI5：模型越来越会完成我们给它的监督训练目标，但没有因此更会逛 WebShop。第一轮基本没变，继续训练后反而更差。这个结果只否定“这套 Stage1 hindsight-skill SFT 单独就能解决 capability ceiling”的简单解释；完整 SEED Stage2 self-evolving / OPD / RL 没有在这里测试。',
      'ELI5: the model gets better at the supervised target we gave it, but not better at WebShop. The first epoch is effectively unchanged, and further training becomes worse. This only argues against the simple claim that this Stage-1 hindsight-skill SFT alone removes the capability ceiling; full SEED Stage-2 self-evolving / OPD / RL was not tested here.'
    )}</p>
  </section>

  <section class="section" id="stage1-stage2" data-result-stage="setup">
    <div class="section-heading">
      <span>02</span>
      <div>
        <h2>{t('先把 Stage1 和 Stage2 拆开', 'Separate Stage 1 from Stage 2 first')}</h2>
        <p>{t('我们之前最容易混淆的地方，是把“怎么先学出一套参数”和“之后怎么持续演变参数”说成同一件事。代码里它们其实完全分开。', 'The main confusion was treating “how to learn one initial parameter set” and “how parameters keep evolving later” as the same problem. The code keeps them separate.')}</p>
      </div>
    </div>

    <div class="stage-grid">
      <article>
        <small>Stage 1 · bootstrap</small>
        <strong>{t('固定经验 → 一套起始参数', 'Fixed experience → one initial parameter set')}</strong>
        <p>{t('当前正式实现用 OPSD：MiniMax 的 episode_skill 只进入 teacher view，student 用 rank8 LoRA；训练结束后把这一个 LoRA merge 进 base，得到 Stage2 的起点。', 'The current formal implementation uses OPSD: MiniMax episode_skill enters only the teacher view, the student uses one rank-8 LoRA, and that LoRA is merged into the base to create the Stage-2 starting point.')}</p>
        <code>base + Stage1 adapter → Stage2 base</code>
      </article>
      <article>
        <small>Stage 2 · continual evolution</small>
        <strong>{t('持续 rollout → SD-LoRA 参数记忆', 'Repeated rollout → SD-LoRA parametric memory')}</strong>
        <p>{t('Stage2 不再跑 OPSD teacher/student JSD。它把当前轨迹与 replay 转成 assistant-token loss，每轮训练新的 rank8 component，再由 DirectApply / Bounded / GDR 决定长期参数状态怎么继续。', 'Stage 2 no longer runs an OPSD teacher/student JSD objective. Current trajectories plus replay are trained with assistant-token loss into a new rank-8 component each round, while DirectApply / Bounded / GDR determine how the long-run parameter state continues.')}</p>
        <code>Stage2 base → 第 0 轮参数更新 → 第 1 轮参数更新 → …</code>
      </article>
    </div>
  </section>

  <section class="section" id="result" data-result-stage="direct-result">
    <div class="section-heading">
      <span>03</span>
      <div>
        <h2>{t('第一组问题：SFT 还是 OPSD？', 'First question: SFT or OPSD?')}</h2>
        <p>{t('先做最干净的一次对照：同一个原始 1.7B、同一个 11,198 action-step 数据集、同样 rank8 LoRA 和 optimizer-step 预算，只换 learning objective。', 'Start with the cleanest contrast: same original 1.7B model, same 11,198 action-step dataset, same rank-8 LoRA and optimizer-step budget; change only the learning objective.')}</p>
      </div>
    </div>

    <div class="result-callout" data-result-status>
      <strong>{t('当前答案：还没有赢家。', 'Current answer: there is no winner yet.')}</strong>
      <p>{t(
        'OPSD 的平均 Task Score 略高；SFT 1-pass 的平均分略低，但出现了 3 / 32 个完整成功，而 OPSD 是 0 / 32。32 题上的平均分差很小，bootstrap 95% 区间跨过 0，因此现在不能宣布 SFT 或 OPSD 整体更好。',
        'OPSD has a slightly higher mean Task Score; SFT 1-pass is slightly lower on mean score but produces 3 / 32 exact successes versus 0 / 32 for OPSD. The mean-score difference on 32 tasks is small and the bootstrap 95% interval crosses zero, so neither objective can yet be declared better overall.'
      )}</p>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>{t('Stage1 方法', 'Stage-1 method')}</th>
            <th>{t('学习信号', 'Learning signal')}</th>
            <th>{t('训练步数', 'Optimizer steps')}</th>
            <th>{t('Dev Task Score', 'Dev Task Score')}</th>
            <th>{t('Exact Success', 'Exact Success')}</th>
          </tr>
        </thead>
        <tbody>
          {objectiveRows.map((row) => (
            <tr>
              <th scope="row"><strong>{row.method}</strong><small>{row.note}</small></th>
              <td>{row.learning}</td>
              <td>{row.budget}</td>
              <td>{row.score} / 100</td>
              <td>{row.exact}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="caption">{t('同一固定 32 题 development panel；final panel 未访问。SFT − OPSD 的平均分差为 −1.05 / 100，bootstrap 95% CI 为 [−16.64, +14.57] / 100。', 'Same fixed 32-task development panel; the final panel is untouched. Mean score difference SFT − OPSD is −1.05 / 100 with bootstrap 95% CI [−16.64, +14.57] / 100.')}</p>
  </section>

  <section class="section" id="validation" data-result-stage="optimization">
    <div class="section-heading">
      <span>04</span>
      <div>
        <h2>{t('第二个发现：SFT 不是训到最后就最好', 'Second finding: the final SFT checkpoint is not automatically the best')}</h2>
        <p>{t('这也是为什么现在必须把 validation 放进训练过程。只看 train loss，会错过中间 checkpoint 在 development panel 上更高的事实。', 'This is why validation has to be part of training. Training loss alone misses that an intermediate checkpoint can score higher on the development panel.')}</p>
      </div>
    </div>

    <div class="curve-list">
      {sftCurve.map((row) => (
        <div>
          <span>{row.step}</span>
          <strong>{row.score} / 100</strong>
          <em>{row.exact} exact</em>
        </div>
      ))}
    </div>
    <p class="interpretation">{t(
      '4096 step 的平均 Task Score 目前最高，但 final 的 exact success 更多。因此“什么时候收敛”不能只由一个指标决定：如果我们优化平均完成度和完整成功率，停止规则要提前预注册。',
      'The 4,096-step checkpoint currently has the highest mean Task Score, while the final checkpoint has more exact successes. “When has training converged?” therefore cannot be answered by one metric alone; stopping rules must be preregistered when both mean completion and exact success matter.'
    )}</p>
  </section>



  <section class="section" id="decision" data-result-stage="synthesis">
    <div class="section-heading">
      <span>05</span>
      <div>
        <h2>{t('这组实验最后要决定什么？', 'What decision should this experiment make?')}</h2>
      </div>
    </div>
    <div class="decision">
      <p><strong>{t('Stage1 的简单答案已经排除。', 'The simple Stage-1 answer is now ruled out.')}</strong> {t('继续堆普通 SFT budget 没有改善；这套 Stage1 SEED-style hindsight-skill 也没有提高固定 64 题 WebShop capability。不同 panel 的绝对分数不能拿来强行排一个跨方法赢家。', 'More ordinary-SFT budget did not help, and this Stage-1 SEED-style hindsight-skill route did not raise capability on the fixed 64-task WebShop panel. Absolute scores from different panels must not be forced into a cross-method winner.')}</p>
      <p><strong>{t('下一步看真正的 credit assignment / self-evolving。', 'Next test the actual credit-assignment / self-evolving mechanism.')}</strong> {t('如果继续 SEED 路线，应该测试这里尚未运行的 Stage2 self-evolving / OPD / RL，而不是继续增加 Stage1 epoch；长期状态容量则交给独立的 rank32 / capacity sweep。', 'If the SEED line continues, test the unrun Stage-2 self-evolving / OPD / RL mechanism rather than adding more Stage-1 epochs; long-term state capacity is handled separately by the rank32 / capacity sweep.')}</p>
      <p><strong>{t('不使用 final panel 调参。', 'Do not tune on the final panel.')}</strong> {t('当前所有选择都只使用冻结 development panel；最终测试继续保持锁定。', 'All current choices use the frozen development panel only; the final test remains locked.')}</p>
    </div>
  </section>

  <section class="section evidence" id="evidence" data-result-stage="evidence">
    <div class="section-heading">
      <span>06</span>
      <div>
        <h2>{t('代码与实验依据', 'Code and experiment evidence')}</h2>
        <p>{t('这里把“Stage1 用 OPSD、Stage2 用 SD-LoRA”落到代码文件，而不是只靠会议记忆。', 'These links ground “Stage 1 uses OPSD, Stage 2 uses SD-LoRA” in code rather than meeting recollection.')}</p>
      </div>
    </div>
    <ul>
      <li><a href="https://github.com/mykcs/openevo-experiment/blob/main/configs/experiment/openevo-ceiling-1.0-opsd-formal-v1.json" target="_blank" rel="noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment/blob/main/configs/experiment/openevo-ceiling-1.0-opsd-formal-v1.json" />Stage1 OPSD recipe ↗</a></li>
      <li><a href="https://github.com/mykcs/openevo-experiment/blob/main/scripts/openevo_webshop/train_ceiling1_opsd.py" target="_blank" rel="noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment/blob/main/scripts/openevo_webshop/train_ceiling1_opsd.py" />Stage1 OPSD trainer ↗</a></li>
      <li><a href="https://github.com/mykcs/openevo-experiment/blob/main/scripts/openevo_webshop/ceiling1_stage2_sd_lora.py" target="_blank" rel="noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment/blob/main/scripts/openevo_webshop/ceiling1_stage2_sd_lora.py" />Stage2 SD-LoRA launcher / method wiring ↗</a></li>
      <li><a href="https://github.com/mykcs/openevo-experiment/blob/experiment/q17-sft-baseline-20260923/docs/experiment-tracking/Q17_SFT_BASELINE_20260923.md" target="_blank" rel="noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment/blob/experiment/q17-sft-baseline-20260923/docs/experiment-tracking/Q17_SFT_BASELINE_20260923.md" />SFT objective-ablation plan ↗</a></li>
      <li><a href="https://github.com/mykcs/openevo-experiment/pull/597" target="_blank" rel="noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment/pull/597" />{t('Post-advisor A/B 最终收口 · PR #597 ↗', 'Post-advisor A/B final closeout · PR #597 ↗')}</a></li>
      <li><a href="/research/seed-openevo/evidence/post-advisor-ab-final-20260928.json" target="_blank" rel="noreferrer">{t('BaseModel 本地证据镜像 ↗', 'BaseModel local evidence mirror ↗')}</a></li>
    </ul>
    <p>{t('当前页同时保留早期 32 题 SFT / OPSD development 证据与新封存的 64 题 SEED-style primary-validation 证据；两个 panel 不能混成同一个跨方法排行榜。完整 SEED Stage2 尚未运行。', 'This page keeps the earlier 32-task SFT / OPSD development evidence alongside the newly sealed 64-task SEED-style primary-validation evidence; the two panels must not be merged into one cross-method ranking. Full SEED Stage 2 remains unrun.')}</p>
  </section>
</main>

<style>
.stage1-study {
  width: min(1040px, calc(100% - 2rem));
  margin: 0 auto 5rem;
  color: var(--ink);
}
.hero {
  padding: 3.1rem 0 2rem;
}
.eyebrow {
  margin: 0 0 .75rem;
  color: var(--accent-deep);
  font: 800 1rem/1.25 var(--font-mono);
  letter-spacing: .06em;
}
.hero h1 {
  max-width: 24ch;
  margin: 0;
  font-size: clamp(2.5rem, 6vw, 4.2rem);
  line-height: 1;
  letter-spacing: -.045em;
}
.section {
  padding: 2.5rem 0;
  border-bottom: 1px solid var(--line);
}
.section-heading {
  display: grid;
  grid-template-columns: 3rem minmax(0, 1fr);
  gap: 1rem;
  margin-bottom: 1.35rem;
}
.section-heading > span {
  color: var(--accent-deep);
  font: 800 1rem/1.3 var(--font-mono);
}
.section-heading h2 {
  margin: 0;
  font-size: clamp(1.65rem, 3.2vw, 2.55rem);
  line-height: 1.08;
  letter-spacing: -.035em;
}
.section-heading p {
  max-width: 54rem;
  margin: .65rem 0 0;
  color: var(--muted);
  line-height: 1.65;
}
.stage1-contrast {
  margin: 1rem 0 0;
  padding: .8rem 0 .7rem;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.stage1-measures {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
}
.stage1-measure { min-width: 0; }
.measure-label {
  margin: 0 0 .5rem;
  color: var(--accent-deep);
  font: 750 .9rem/1.35 var(--font-mono);
}
.measure-value {
  display: grid;
  gap: .25rem;
  margin: 0;
}
.measure-value span { color: var(--muted); font-size: .9rem; }
.measure-value strong {
  font: 750 clamp(1.2rem, 2.2vw, 1.65rem)/1.2 var(--font-mono);
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.measure-note {
  max-width: 38rem;
  margin: .4rem 0 0;
  color: var(--muted);
  font-size: .94rem;
  line-height: 1.45;
}
.stage1-contrast figcaption {
  max-width: 72rem;
  margin-top: .65rem;
  color: var(--muted);
  font-size: .94rem;
  line-height: 1.45;
}
.stage-grid,
.next-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  border: 1px solid var(--line);
  background: var(--line);
}
.stage-grid article,
.next-grid article {
  padding: 1.25rem;
  background: var(--surface);
}
.stage-grid small,
.next-grid small {
  display: block;
  color: var(--accent-deep);
  font: 800 1rem/1.3 var(--font-mono);
  letter-spacing: .04em;
}
.stage-grid strong,
.next-grid strong {
  display: block;
  margin: .35rem 0;
  font-size: 1.15rem;
  line-height: 1.35;
}
.stage-grid p,
.next-grid p {
  margin: .45rem 0 0;
  color: var(--muted);
  line-height: 1.62;
}
.stage-grid code {
  display: block;
  margin-top: .85rem;
  padding: .55rem .7rem;
  border-left: 2px solid var(--accent-deep);
  background: var(--surface-muted);
  overflow-wrap: anywhere;
}
.result-callout {
  padding: 1.1rem 1.2rem;
  border-left: 3px solid var(--accent-deep);
  background: var(--surface-muted);
}
.result-callout strong { font-size: 1.18rem; }
.result-callout p {
  max-width: 58rem;
  margin: .45rem 0 0;
  line-height: 1.65;
}
.table-wrap {
  margin-top: 1.2rem;
  overflow-x: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 1rem;
}
th,
td {
  padding: .8rem .75rem;
  border-bottom: 1px solid var(--line);
  text-align: left;
