---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoExperimentDesignCatalog from './OpenEvoExperimentDesignCatalog.astro';
import OpenEvoHarnessFairnessPanel from './OpenEvoHarnessFairnessPanel.astro';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchDepth from './ResearchDepth.astro';
import { OPEN_EVO_CEILING_PRINCIPLE, OPEN_EVO_STAGE1_FREEZE, OPEN_EVO_STAGE1_METRICS } from '../../data/openEvoSuccessorNarrative';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  firstRun: p('/research/seed-openevo/study/capability-exploration/first-run/'),
  exploration: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/exploration/'),
  report: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/report/'),
};
const principle = zh ? OPEN_EVO_CEILING_PRINCIPLE.zh : OPEN_EVO_CEILING_PRINCIPLE.en;
const terms = zh ? [
  { term: 'successor', meaning: '第一轮实验之后重新冻结的一套 3B + 1.7B 设计；它不是旧实验简单续跑。' },
  { term: 'strategy-neutral Harness', meaning: '两种模型共享同一环境接口；接口允许合法动作，但不告诉模型应该搜索什么、买什么。' },
  { term: 'canonical Stage1', meaning: '每个模型各自完整采 180×8=1,440 条的正式起跑语料。' },
] : [
  { term: 'successor', meaning: 'The 3B + 1.7B design refrozen after the first campaign; it is not a simple continuation of the old run.' },
  { term: 'strategy-neutral harness', meaning: 'One shared environment interface for both models. It enables legal actions without teaching what to search for or buy.' },
  { term: 'canonical Stage 1', meaning: 'The formal starting corpus: 180×8=1,440 trajectories collected independently for each model.' },
];
---
<main class="successor-gateway" data-testid="openevo-successor-gateway">
  <ResearchOrientation
    locale={locale}
    eyebrow="OPENEVO SUCCESSOR · QWEN2.5-3B + QWEN3-1.7B"
    title={t('同一个实验，两种读法', 'One experiment, two ways to read it')}
    lede={t('探索版保留我们怎样发现问题、证伪假设和回退；报告版只保留最终可辩护的设计、数字与结论边界。它们不是两个实验，也不会拥有两套不同的数字；两边消费同一组事实。', 'Report = final design and claim boundaries. Exploration = how failed hypotheses changed that design. They are two readings of the same evidence, not two experiments.')}
    question={t('在不为某个模型偷偷加 WebShop 解题策略的前提下，3B 和 1.7B 各自能从什么起跑线开始自进化？', 'Without giving either model a private WebShop-solving strategy, where can 3B and 1.7B start their self-evolution?')}
    why={t('第一轮暴露了 action interface 和 Harness 会影响轨迹；所以新版必须共享同一套 strategy-neutral 接口，才能把模型差异和接口差异分开。', 'The first campaign showed that the interface can change trajectories, so both models need one shared strategy-neutral harness.')}
    start={t(`从 shared Stage1 freeze ${OPEN_EVO_STAGE1_FREEZE.id} 开始：两个模型共享 Harness，各自独立采 180×8 条。`, `Start from shared Stage-1 freeze ${OPEN_EVO_STAGE1_FREEZE.id}: one harness, 180×8 trajectories collected independently per model.`)}
    finish={t('Stage1 corpus 各自封存，MiniMax 只做 post-hoc 分析；Stage2 需要独立授权，不因“准备完成”自动开始。', 'Seal both Stage-1 corpora; MiniMax is post hoc; Stage 2 needs separate authorization.')}
    state={t('两种读法都已形成；1.7B 后续 Stage2 已完成 final closeout，3B 仍未到同一收口阶段。', 'Both readings are established; 1.7B later closed Stage 2, while 3B has not.')}
    stateTone="sealed"
    backHref={links.lobby}
    backLabel={t('OpenEvo 能力探索', 'OpenEvo capability exploration')}
    terms={terms}
  />

  <blockquote class="successor-gateway__principle" data-principle>
    <span>{t('这一代实验的固定原则', 'FIXED PRINCIPLE')}</span>
    <strong>{principle}</strong>
    <small>{t('“SEED-aligned”只指 task / rollout / evaluation envelope 对齐，不声称 runtime compute 完全相同。', '“SEED-aligned” refers to the task / rollout / evaluation envelope, not identical runtime compute.')}</small>
  </blockquote>

  <nav class="successor-gateway__choices" data-reading-choice aria-label={t('选择 successor 读法', 'Choose how to read the successor')}>
    <a href={links.report} data-successor-mode="report">
      <span>{t('第一次看 / 汇报 / 写论文', 'NEW READER / PRESENTATION / PAPER')}</span>
      <h2>{t('先看报告版', 'Start with the report')}</h2>
      <strong>{t('你会得到：最终设计、关键数字、支持什么、不能说什么', 'You get: final design, key numbers, supported claims, and claim boundaries')}</strong>
      <p>{t('如果你只是想快速理解这次 successor 做了什么，选这个。正文按一条科学论证线走，不要求你先知道所有失败尝试。', 'Choose this if you want to understand what the successor ultimately did. The page follows one scientific argument without requiring the full history of failed attempts.')}</p>
      <b>{t('进入报告与论文版 →', 'Open report / paper view →')}</b>
    </a>
    <a href={links.exploration} data-successor-mode="exploration">
      <span>{t('想追研究推理 / 排查历史', 'RESEARCH REASONING / DIAGNOSTIC HISTORY')}</span>
      <h2>{t('再看探索版', 'Then read the exploration')}</h2>
      <strong>{t('你会得到：哪些假设失败了，以及这些失败怎样改变下一步设计', 'You get: which hypotheses failed and how each failure changed the next design decision')}</strong>
      <p>{t('从 3B 太弱开始，沿 horizon、sampling、history、自我推理、action serialization 和容量问题走到 shared Harness。适合需要复盘研究决策的人。', 'Start from weak 3B behavior and follow horizon, sampling, history, self-deliberation, action serialization, and capacity questions into the shared harness. Best for reconstructing research decisions.')}</p>
      <b>{t('进入探索版 →', 'Open exploration view →')}</b>
    </a>
  </nav>
  <section class="successor-gateway__snapshot" aria-labelledby="successor-snapshot-title">
    <header>
      <p>CANONICAL RAW STAGE 1 · {OPEN_EVO_STAGE1_FREEZE.id}</p>
      <h2 id="successor-snapshot-title">{t('无论选哪种读法，这两个起跑线数字都不会变', 'Whichever reading mode you choose, these starting-point numbers stay the same')}</h2>
      <span>{t('这里的 reward 是行为结果，不是 raw corpus PASS gate。', 'Reward is an observed behavior outcome, not the raw-corpus PASS gate.')}</span>
    </header>
    <div>
      {OPEN_EVO_STAGE1_METRICS.map((arm) => (
        <article data-arm={arm.id}>
          <span>{arm.model}</span>
          <strong>{arm.exact} / {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong>
          <b>{arm.exactRate} exact success</b>
          <small>{arm.positive} positive trajectories · {arm.exactTaskIdentities} {t('个不同任务出现 exact success', 'distinct tasks with exact success')}</small>
        </article>
      ))}
    </div>
    <aside>{t('1.7B 在 raw Stage1 起跑更高；这是 baseline difference，不是 Stage2 学习增益，也不能单凭这一项推出“1.7B 普遍强于 3B”。', 'The 1.7B arm starts higher in raw Stage 1. This is a baseline difference, not a Stage-2 learning gain or proof that 1.7B is generally stronger than 3B.')}</aside>
  </section>

  <ResearchDepth
    locale={locale}
    kind="method"
    summary={t('共享 Harness 的公平性边界：哪些接口信息允许，哪些会变成“教题”', 'Shared-harness fairness: which interface information is allowed and which would become task-solving help')}
  >
    <OpenEvoHarnessFairnessPanel locale={locale} compact />
  </ResearchDepth>

  <ResearchDepth
    locale={locale}
    kind="history"
    summary={t('七个设计族与第一轮 predecessor evidence', 'Seven design families and predecessor evidence from the first campaign')}
    intro={t('这部分用于研究者追踪完整设计空间。它不再承担“第一次看 successor 应该先理解什么”的职责。', 'This section preserves the full design space for researchers. It no longer owns the first-time reading path.')}
  >
    <div class="successor-gateway__history"><strong>{t('第一轮 7B / 3B 实验仍保留为 predecessor evidence。', 'The first 7B / 3B campaign remains predecessor evidence.')}</strong><a href={links.firstRun}>{t('回看第一轮实验 →', 'Review the first experiment →')}</a></div>
    <OpenEvoExperimentDesignCatalog locale={locale} />
  </ResearchDepth>
</main>
<style>
.successor-gateway{display:contents}.successor-gateway__principle,.successor-gateway__choices,.successor-gateway__snapshot{width:min(1120px,calc(100% - 2rem));margin-left:auto;margin-right:auto}.successor-gateway__principle{display:grid;gap:.25rem;margin-top:.85rem;margin-bottom:.7rem;padding:.7rem .85rem;border:0;border-left:3px solid var(--accent-deep);background:var(--surface-muted)}.successor-gateway__principle span{color:var(--accent-deep);font:800 .55rem/1.2 var(--font-mono);letter-spacing:.06em}.successor-gateway__principle strong{font-size:.92rem;line-height:1.45}.successor-gateway__principle small{color:var(--muted);font-size:.68rem;line-height:1.42}
.successor-gateway__choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;padding:.25rem 0 1rem}.successor-gateway__choices>a{display:grid;gap:.45rem;padding:.9rem 1rem;border-top:3px solid var(--line);background:var(--surface-muted);color:inherit;text-decoration:none}.successor-gateway__choices>a:first-child{border-top-color:var(--accent)}.successor-gateway__choices>a:hover,.successor-gateway__choices>a:focus-visible{background:var(--surface);border-top-color:var(--accent)}.successor-gateway__choices>a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.successor-gateway__choices span{color:var(--accent-deep);font:800 .54rem/1.2 var(--font-mono);letter-spacing:.06em}.successor-gateway__choices h2{margin:0;font-size:1.55rem;line-height:1.05}.successor-gateway__choices strong{font-size:.82rem;line-height:1.4}.successor-gateway__choices p{margin:0;color:var(--muted);font-size:.75rem;line-height:1.52}.successor-gateway__choices b{color:var(--accent-deep);font-size:.76rem}
.successor-gateway__snapshot{display:grid;grid-template-columns:minmax(230px,.55fr) minmax(0,1.45fr);gap:.7rem 1rem;padding:1rem 0;border-block:1px solid var(--line)}.successor-gateway__snapshot header{display:grid;align-content:start;gap:.28rem}.successor-gateway__snapshot header p{margin:0;color:var(--accent-deep);font:800 .54rem/1.2 var(--font-mono)}.successor-gateway__snapshot h2{margin:0;font-size:1.1rem;line-height:1.2}.successor-gateway__snapshot header span{color:var(--muted);font-size:.7rem;line-height:1.45}.successor-gateway__snapshot>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}.successor-gateway__snapshot article{display:grid;gap:.15rem;padding:.7rem;border-left:2px solid var(--line);background:var(--surface-muted)}.successor-gateway__snapshot article span{color:var(--muted);font:800 .55rem/1.2 var(--font-mono)}.successor-gateway__snapshot article strong{font-size:1.55rem}.successor-gateway__snapshot article b{font-size:.72rem}.successor-gateway__snapshot article small{color:var(--muted);font-size:.64rem;line-height:1.4}.successor-gateway__snapshot aside{grid-column:2;padding:.55rem .7rem;border-left:2px solid var(--line);color:var(--muted);font-size:.7rem;line-height:1.5}.successor-gateway__history{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:.65rem;padding:.55rem .65rem;border-left:2px solid var(--line);background:var(--surface-muted)}.successor-gateway__history strong{font-size:.74rem}.successor-gateway__history a{color:var(--accent-deep);font-size:.72rem;font-weight:800;text-underline-offset:.2em}
@media(max-width:760px){.successor-gateway__principle,.successor-gateway__choices,.successor-gateway__snapshot{width:min(100% - 1rem,1120px)}.successor-gateway__choices,.successor-gateway__snapshot,.successor-gateway__snapshot>div{grid-template-columns:1fr}.successor-gateway__snapshot aside{grid-column:auto}.successor-gateway__history{align-items:flex-start;flex-direction:column}}
</style>
