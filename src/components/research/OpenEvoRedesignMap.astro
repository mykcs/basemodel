---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoExperimentDesignCatalog from './OpenEvoExperimentDesignCatalog.astro';
import OpenEvoHarnessFairnessPanel from './OpenEvoHarnessFairnessPanel.astro';
import { OPEN_EVO_CEILING_PRINCIPLE, OPEN_EVO_STAGE1_FREEZE, OPEN_EVO_STAGE1_METRICS } from '../../data/openEvoSuccessorNarrative';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  firstRun: p('/research/seed-openevo/study/capability-exploration/first-run/'),
  exploration: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/exploration/'),
  report: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/report/'),
};
const principle = zh ? OPEN_EVO_CEILING_PRINCIPLE.zh : OPEN_EVO_CEILING_PRINCIPLE.en;
---
<main class="successor-gateway" data-testid="openevo-successor-gateway">
  <header class="successor-gateway__head">
    <a href={links.lobby}>{t('← OpenEvo 能力探索', '← OpenEvo capability exploration')}</a>
    <p>OPENEVO SUCCESSOR · QWEN2.5-3B + QWEN3-1.7B</p>
    <h1>{t('同一个实验，两种读法', 'One successor, two ways to read it')}</h1>
    <strong>{t(
      '探索版保留真实研究过程里的绕路、证伪和回退；报告与论文版把同一组事实压成一条可以直接检查 claim 的直线。它们不是两个实验，也不会拥有两套不同的数字。',
      'The exploration view preserves the real detours, falsified hypotheses, and backtracking. The report view compresses the same evidence into a linear claim-bearing story. They are not two experiments and do not own separate sets of numbers.'
    )}</strong>
    <span>{t(
      `当前 shared Stage 1 freeze 是 ${OPEN_EVO_STAGE1_FREEZE.id}：两个 arm 使用同一套 strategy-neutral Harness、同一 180×8 预算，各自独立 seal。`,
      `The current shared Stage-1 freeze is ${OPEN_EVO_STAGE1_FREEZE.id}: both arms use one strategy-neutral harness and the same 180×8 budget, while sealing independently.`
    )}</span>
  </header>

  <blockquote class="successor-gateway__principle" data-principle>
    <span>{t('固定设计哲学', 'FIXED DESIGN PRINCIPLE')}</span>
    <strong>{principle}</strong>
    <small>{t('“SEED-aligned”指 task / rollout / evaluation envelope 对齐，不等于声称 runtime compute 完全相同。', '“SEED-aligned” refers to the task / rollout / evaluation envelope; it is not a claim that runtime compute is identical.')}</small>
  </blockquote>

  <nav class="successor-gateway__choices" aria-label={t('选择 successor 叙事', 'Choose a successor narrative')}>
    <a href={links.exploration} data-successor-mode="exploration">
      <span>01 · ROGUELIKE / CHRONOLOGY</span>
      <h2>{t('探索版', 'Exploration')}</h2>
      <strong>{t('我们当时到底是怎么走到这里的？', 'How did we actually get here?')}</strong>
      <p>{t(
        '从 3B 行为太差开始，经过 horizon、sampling、history、自我推理、action serialization、工程 readback、小模型成对实验，再到 shared Harness freeze；之后继续保留 Text Memory 4096 失败与 bounded 10+10 的折返。',
        'Start from the weak 3B behavior and follow horizon, sampling, history, self-deliberation, action serialization, engineering readback, paired small-model diagnostics, and the shared-harness freeze; then keep the Text-Memory 4096 failure and bounded 10+10 backtrack.'
      )}</p>
      <b>{t('进入复杂探索地图 →', 'Open the exploration map →')}</b>
    </a>
    <a href={links.report} data-successor-mode="report">
      <span>02 · REPORT / PAPER</span>
      <h2>{t('报告与论文版', 'Report / paper')}</h2>
      <strong>{t('我们最终做了什么，证据支持到哪里？', 'What did we ultimately do, and what do the data support?')}</strong>
      <p>{t(
        '先给 shared Harness、canonical 1,440×2 和 raw bootstrap 结果，再线性解释 MiniMax、bounded carriers 与 PRE_STAGE2_READY。每一段按 What / Why / Evidence / Boundary 写。',
        'Lead with the shared harness, canonical 1,440×2 corpora, and raw bootstrap results, then explain MiniMax, bounded carriers, and PRE_STAGE2_READY linearly. Each stage is organized as What / Why / Evidence / Boundary.'
      )}</p>
      <b>{t('进入报告地图 →', 'Open the report map →')}</b>
    </a>
  </nav>

  <section class="successor-gateway__snapshot" aria-labelledby="successor-snapshot-title">
    <header>
      <p>CANONICAL RAW STAGE 1 · {OPEN_EVO_STAGE1_FREEZE.id}</p>
      <h2 id="successor-snapshot-title">{t('两种读法共享的第一组事实', 'The first facts shared by both views')}</h2>
      <span>{t('这里的 reward 是行为结果，不是 raw corpus PASS gate。', 'Reward is an observed behavior outcome, not the raw-corpus PASS gate.')}</span>
    </header>
    <div>
      {OPEN_EVO_STAGE1_METRICS.map((arm) => (
        <article data-arm={arm.id}>
          <span>{arm.model}</span>
          <strong>{arm.exact} / {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong>
          <b>{arm.exactRate} exact success</b>
          <small>{arm.positive} positive trajectories · {arm.exactTaskIdentities} {t('个不同任务出现 exact success', 'distinct tasks with exact success')}</small>
        </article>
      ))}
    </div>
    <aside>{t('1.7B 在 raw Stage1 的起跑线更高；这是 baseline difference，不是 Stage2 学习结论，也不能单凭这一项推出“1.7B 普遍强于 3B”。', 'The 1.7B arm starts higher in raw Stage 1. That is a baseline difference, not a Stage-2 learning result, and it does not by itself establish that 1.7B is generally stronger than 3B.')}</aside>
  </section>

  <OpenEvoHarnessFairnessPanel locale={locale} compact />

  <section class="successor-gateway__history">
    <div>
      <span>{t('历史来源', 'HISTORICAL ORIGIN')}</span>
      <strong>{t('第一轮 7B / 3B 实验仍然保留为 predecessor evidence。', 'The first 7B / 3B campaign remains predecessor evidence.')}</strong>
    </div>
    <a href={links.firstRun}>{t('回看第一轮实验 →', 'Review the first experiment →')}</a>
  </section>

  <OpenEvoExperimentDesignCatalog locale={locale} />
</main>

<style>
.successor-gateway{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem}.successor-gateway__head{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:.55rem 1.6rem;align-items:end;padding:1.35rem 0 1.4rem;border-bottom:1px solid var(--line)}.successor-gateway__head>a{grid-column:1/-1;width:max-content;color:var(--muted);font-size:.8rem;text-decoration:none}.successor-gateway__head>p{grid-column:1/-1;margin:.2rem 0;color:var(--accent-deep);font:800 .64rem/1.3 var(--font-mono);letter-spacing:.09em}.successor-gateway__head h1{grid-column:1;margin:0;font-size:clamp(2.45rem,5.9vw,5rem);line-height:.94;letter-spacing:-.055em}.successor-gateway__head strong,.successor-gateway__head span{grid-column:2;display:block}.successor-gateway__head strong{font-size:1.04rem;line-height:1.55}.successor-gateway__head span{color:var(--muted);font-size:.9rem;line-height:1.65}.successor-gateway__principle{display:grid;gap:.28rem;margin:1rem 0;padding:.9rem 1rem;border:0;border-left:4px double var(--accent-deep);background:var(--surface-muted)}.successor-gateway__principle span{color:var(--accent-deep);font:800 .55rem/1.2 var(--font-mono);letter-spacing:.07em}.successor-gateway__principle strong{font-size:1.05rem;line-height:1.5}.successor-gateway__principle small{color:var(--muted);font-size:.7rem;line-height:1.45}.successor-gateway__choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;padding:.3rem 0 1.2rem}.successor-gateway__choices>a{display:grid;align-content:start;gap:.5rem;min-height:17rem;padding:1.05rem;border:1px solid var(--line);border-radius:var(--radius-feature);background:var(--surface);color:inherit;text-decoration:none}.successor-gateway__choices>a:hover,.successor-gateway__choices>a:focus-visible{border-color:var(--accent);background:var(--surface-muted)}.successor-gateway__choices>a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.successor-gateway__choices span{color:var(--accent-deep);font:800 .55rem/1.2 var(--font-mono);letter-spacing:.07em}.successor-gateway__choices h2{margin:0;font-size:2rem;line-height:1}.successor-gateway__choices strong{font-size:.88rem}.successor-gateway__choices p{margin:0;color:var(--muted);font-size:.8rem;line-height:1.58}.successor-gateway__choices b{align-self:end;margin-top:auto;color:var(--accent-deep);font-size:.78rem}.successor-gateway__snapshot{display:grid;grid-template-columns:minmax(210px,.48fr) minmax(0,1.52fr);gap:.8rem 1rem;padding:1rem 0;border-top:1px solid var(--line)}.successor-gateway__snapshot header{display:grid;align-content:start;gap:.3rem}.successor-gateway__snapshot header p{margin:0;color:var(--accent-deep);font:800 .55rem/1.2 var(--font-mono);letter-spacing:.06em}.successor-gateway__snapshot h2{margin:0;font-size:1.12rem}.successor-gateway__snapshot header span{color:var(--muted);font-size:.72rem;line-height:1.45}.successor-gateway__snapshot>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.successor-gateway__snapshot article{display:grid;gap:.18rem;padding:.78rem;border:1px solid var(--line);border-radius:var(--radius-panel)}.successor-gateway__snapshot article span{color:var(--muted);font:800 .56rem/1.2 var(--font-mono)}.successor-gateway__snapshot article strong{font-size:1.65rem;line-height:1}.successor-gateway__snapshot article b{font-size:.72rem}.successor-gateway__snapshot article small{color:var(--muted);font-size:.65rem;line-height:1.42}.successor-gateway__snapshot aside{grid-column:2;padding:.6rem .75rem;border-left:3px solid var(--line);color:var(--muted);font-size:.72rem;line-height:1.5}.successor-gateway__history{display:flex;justify-content:space-between;align-items:end;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.successor-gateway__history>div{display:grid;gap:.2rem}.successor-gateway__history span{color:var(--muted);font:800 .52rem/1.2 var(--font-mono);letter-spacing:.06em}.successor-gateway__history strong{font-size:.78rem}.successor-gateway__history a{color:var(--accent-deep);font-size:.75rem;font-weight:750;text-underline-offset:.2em}
@media(max-width:760px){.successor-gateway{width:min(100% - 1rem,1120px)}.successor-gateway__head{grid-template-columns:1fr;gap:.55rem;padding:1rem 0}.successor-gateway__head>a,.successor-gateway__head>p,.successor-gateway__head h1,.successor-gateway__head strong,.successor-gateway__head span{grid-column:auto}.successor-gateway__head h1{font-size:clamp(2.35rem,12vw,3.55rem)}.successor-gateway__choices{grid-template-columns:1fr}.successor-gateway__choices>a{min-height:0}.successor-gateway__snapshot{grid-template-columns:1fr}.successor-gateway__snapshot>div{grid-template-columns:1fr}.successor-gateway__snapshot aside{grid-column:auto}.successor-gateway__history{align-items:start;flex-direction:column}}
</style>
