---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  firstRun: p('/research/seed-openevo/study/capability-exploration/first-run/'),
  harness: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/'),
  archive: p('/research/seed-openevo/study/capability-exploration/archive/'),
};
---
<main class="redesign" data-redesign-map data-testid="openevo-redesign-map">
  <header class="redesign__head">
    <a href={links.lobby} class="redesign__back">{t('← OpenEvo 能力探索', '← OpenEvo capability exploration')}</a>
    <p>OPENEVO 2.0 · CURRENT SUCCESSOR MAP</p>
    <h1>{t('重新设计 OpenEvo', 'Redesigning OpenEvo')}</h1>
    <strong>{t(
      '第一轮实验告诉我们，真正需要重做的不只是 Stage 2 门槛，而是模型“怎么把想法变成环境动作”这一层。新的 Harness 会改变模型真正走出来的轨迹，所以这条 successor 从 Stage 1 重新开始。',
      'The first experiment showed that the problem was not only a Stage-2 threshold. The interface that turns model reasoning into environment actions also had to change. Because that changes the trajectories the model actually produces, this successor restarts from Stage 1.'
    )}</strong>
    <span>{t(
      '`Stage1-202609021800` 冻结的是 Qwen2.5-3B 与 Qwen3-1.7B 共用的 strategy-neutral Harness201.1 采集合同；两个模型的实际 collection、seal 与后续 lineage 仍分别验收。',
      '`Stage1-202609021800` freezes the shared strategy-neutral Harness201.1 collection contract for Qwen2.5-3B and Qwen3-1.7B, while each model’s actual collection, seal, and downstream lineage are verified separately.'
    )}</span>
  </header>

  <aside class="redesign__origin">
    <div>
      <span>{t('来自第一张地图', 'FROM MAP ONE')}</span>
      <strong>{t('旧 3B lineage 停在 Harness diagnosis；它提供“为什么要改”的证据，但不把旧 checkpoint / trajectory 接进新版。', 'The old 3B lineage stops at harness diagnosis. It explains why the redesign exists, but its checkpoint and trajectories are not spliced into the successor.')}</strong>
    </div>
    <a href={links.firstRun}>{t('回看第一轮实验 →', 'Review the first experiment →')}</a>
  </aside>

  <section class="redesign-track" aria-label={t('重新设计 OpenEvo 主路线', 'OpenEvo redesign mainline')}>
    <article class="redesign-node redesign-node--amendment" data-node-kind="scientific-amendment" data-node-state="current">
      <div class="redesign-node__status"><span>{t('已通过资格检查', 'QUALIFICATION PASSED')}</span><b>01</b></div>
      <div>
        <p>HARNESS201.1 · NEW SCIENTIFIC BOUNDARY</p>
        <h2>{t('想法可以自由表达，真正执行动作必须合法', 'Reasoning stays flexible; executed actions must be valid')}</h2>
        <strong>{t('reasoning soft · action hard', 'reasoning soft · action hard')}</strong>
        <span>{t('进入 `<action>` 后，只能从当前 WebShop 允许的动态动作集合里生成；不再依赖 fuzzy repair 猜模型想做什么。', 'After `<action>`, decoding is constrained to the current dynamic set of WebShop actions; fuzzy repair no longer guesses what the model intended.')}</span>
      </div>
      <button type="button" data-redesign-detail="harness" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>

    <div class="redesign-branch" aria-label={t('并行模型分支', 'Parallel model branch')}>
      <span class="redesign-branch__stem" aria-hidden="true"></span>
      <article data-node-kind="branch" data-node-state="current">
        <span>PARALLEL ARM</span>
        <strong>Qwen3-1.7B</strong>
        <small>{t('同一套 strategy-neutral Harness201.1 qualification 已 PASS；后续数据与 carrier 独立生成。', 'The same strategy-neutral Harness201.1 qualification passed; downstream data and carriers remain model-specific.')}</small>
        <button type="button" data-redesign-detail="qwen3" aria-expanded="false">+ {t('查看', 'Open')}</button>
      </article>
    </div>

    <span class="redesign-connector" aria-hidden="true"></span>

    <article class="redesign-node redesign-node--mainline" data-node-kind="mainline" data-node-state="current">
      <div class="redesign-node__status"><span>{t('已冻结 · 202609021800', 'FROZEN · 202609021800')}</span><b>02</b></div>
      <div>
        <p>FLOOR 1 · FRESH STAGE 1</p>
        <h2>{t('重新采集 Stage 1，而不是给旧轨迹换名字', 'Recollect Stage 1 instead of relabeling old trajectories')}</h2>
        <strong>{t('180 个任务 × 每任务 8 次 = 1,440 条新 trajectory', '180 tasks × 8 rollouts each = 1,440 fresh trajectories')}</strong>
        <span>{t('Stage 1 只带新的通用行动接口，不注入旧 Memory、Skill、Agent 或 SD adapter。freeze 为两个 arm 固定同一份 180×8 采集合同，但不会把“合同已冻结”冒充成“两个 arm 都已经完成并 seal 了 1,440 条”。', 'Stage 1 carries only the new universal action interface, with no old Memory, Skill, Agent, or SD adapter injected. The freeze gives both arms the same 180×8 collection contract, but a frozen contract is not evidence that both arms have already completed and sealed all 1,440 rows.')}</span>
      </div>
      <button type="button" data-redesign-detail="fresh-stage1" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>

    <span class="redesign-connector" aria-hidden="true"></span>

    <article class="redesign-node redesign-node--mainline" data-node-kind="mainline" data-node-state="current">
      <div class="redesign-node__status"><span>{t('分析合同已冻结 · 202609022300', 'ANALYSIS CONTRACT FROZEN · 202609022300')}</span><b>03</b></div>
      <div>
        <p>MINIMAX ANALYSIS</p>
        <h2>{t('MiniMax 只分析已经发生的新轨迹', 'MiniMax analyzes the new trajectories after they happen')}</h2>
        <strong>{t('老师批改作业，不替学生继续做题', 'The teacher reviews the work; it does not take over the task')}</strong>
        <span>{t('MiniMax 不生成 WebShop action。`202609022300` authority 把这一步标为 analysis-authorized：只有 parse_ok=true 才算完成，失败行必须重试，429 尊重 Retry-After；它没有宣告 MiniMax 已经 1,440/1,440 完成。', 'MiniMax does not generate WebShop actions. The `202609022300` authority marks this step analysis-authorized: only parse_ok=true counts as complete, failed rows must be retried, and 429 respects Retry-After; it does not declare MiniMax 1,440/1,440 complete.')}</span>
      </div>
      <button type="button" data-redesign-detail="minimax" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>

    <span class="redesign-connector" aria-hidden="true"></span>

    <article class="redesign-node redesign-node--seal redesign-node--future" data-node-kind="mainline" data-node-state="future">
      <div class="redesign-node__status"><span>{t('下一道 seal · 尚未宣告完成', 'NEXT SEAL · NOT YET DECLARED COMPLETE')}</span><b>04</b></div>
      <div>
        <p>TEACHER EVIDENCE POOL SEAL</p>
        <h2>{t('等 1,440 条 parse_ok 分析完成后，再封一次性的老师证据池', 'After 1,440 parse_ok analyses complete, seal the one-time teacher evidence pool')}</h2>
        <strong>{t('从这里往后：external teacher calls = 0', 'From here onward: external teacher calls = 0')}</strong>
        <span>{t('如果 Memory、Skill、Agent 或 Stage 2 后来遇到问题，不能把 MiniMax 再叫回来救场；否则研究问题会变。', 'If Memory, Skill, Agent, or Stage 2 later runs into trouble, MiniMax cannot be called back to rescue it; doing so would change the research question.')}</span>
      </div>
      <button type="button" data-redesign-detail="teacher-seal" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>

    <span class="redesign-connector" aria-hidden="true"></span>

    <section class="downstream downstream--future" aria-labelledby="downstream-title" data-node-state="future">
      <header>
        <p>STAGE 1 DOWNSTREAM</p>
        <h2 id="downstream-title">{t('MiniMax corpus seal 以后，才冻结新的 Stage 1 downstream', 'Freeze the fresh Stage-1 downstream only after the MiniMax corpus seal')}</h2>
        <span>{t('`202609021800` 只冻结 Stage 1；更新后的 `202609022300` MiniMax authority 也明确写着 OPSD、Text Memory、Skill、Agent、Stage 2 不在这里获准。下面只展示计划结构，不能把更早 successor 的产物冒充当前 fresh corpus 的完成状态。', '`202609021800` freezes Stage 1 only, and the updated `202609022300` MiniMax authority also explicitly leaves OPSD, Text Memory, Skill, Agent, and Stage 2 unauthorized here. The cards below show planned structure only; artifacts from an earlier successor cannot be relabeled as completed state for the current fresh corpus.')}</span>
      </header>
      <div class="downstream__grid">
        <article class="downstream-card" data-node-kind="mainline" data-node-state="future">
          <span>{t('等待新 corpus seal', 'WAITING FOR NEW CORPUS SEAL')}</span>
          <h3>OPSD</h3>
          <p>{t('从新 trajectory / teacher evidence 重新生成参数初始化 adapter，不复用旧 OPSD。', 'Regenerate the parameter-initialization adapter from the fresh trajectory / teacher evidence instead of reusing the old OPSD.')}</p>
          <button type="button" data-redesign-detail="opsd" aria-expanded="false">+ {t('查看', 'Open')}</button>
        </article>
        <article class="downstream-card downstream-card--amendment" data-node-kind="scientific-amendment" data-node-state="future">
          <span>{t('历史经验：A2 必须显式触发', 'HISTORICAL LESSON: A2 REQUIRES AN EXPLICIT TRIGGER')}</span>
          <h3>Text Memory</h3>
          <p>{t('更早的 3B successor 曾用真实 A1 saturation 触发 bounded A2；这条经验保留为设计约束，但当前 `202609021800` fresh corpus 还没有因此自动获得 Text Memory A2 activation。', 'An earlier 3B successor used real A1 saturation to trigger bounded A2. That remains a design constraint, but it does not automatically activate Text Memory A2 for the current `202609021800` fresh corpus.')}</p>
          <button type="button" data-redesign-detail="memory" aria-expanded="false">+ {t('查看', 'Open')}</button>
        </article>
        <article class="downstream-card" data-node-kind="mainline" data-node-state="future">
          <span>{t('等待新 corpus seal', 'WAITING FOR NEW CORPUS SEAL')}</span>
          <h3>Skill Bundle</h3>
          <p>{t('只从新版 Stage1 teacher evidence 和新的 OPSD 起点构建，不继承旧 Skill。', 'Build from the fresh Stage1 teacher evidence and new OPSD origin; do not inherit the old Skill bundle.')}</p>
          <button type="button" data-redesign-detail="skill" aria-expanded="false">+ {t('查看', 'Open')}</button>
        </article>
        <article class="downstream-card" data-node-kind="mainline" data-node-state="future">
          <span>{t('等待新 corpus seal', 'WAITING FOR NEW CORPUS SEAL')}</span>
          <h3>Agent System</h3>
          <p>{t('绑定新的 Memory / Skill，再生成新版 Agent System；Stage1 采集时本身不允许把它提前注入。', 'Bind the fresh Memory / Skill before generating the new Agent System; it is not allowed to leak backward into Stage1 collection.')}</p>
          <button type="button" data-redesign-detail="agent" aria-expanded="false">+ {t('查看', 'Open')}</button>
        </article>
      </div>
    </section>

    <span class="redesign-connector redesign-connector--future" aria-hidden="true"></span>

    <article class="redesign-node redesign-node--future" data-node-kind="mainline" data-node-state="future">
      <div class="redesign-node__status"><span>{t('尚未放行', 'NOT YET RELEASED')}</span><b>05</b></div>
      <div>
        <p>STAGE 2 ORIGIN SEAL</p>
        <h2>{t('先证明新的 Stage 1 起点真的完整可加载', 'First prove the fresh Stage-1 origin is complete and loadable')}</h2>
        <strong>{t('OPSD + Memory + Skill + Agent + provenance 全部对齐后，才能成为新 Stage 2 的起点。', 'Only a fully aligned OPSD + Memory + Skill + Agent + provenance bundle can become the new Stage-2 origin.')}</strong>
        <span>{t('这一步没有完成之前，网站不把旧 Stage2 checkpoint、旧 Harness state 或旧 3B premature rollout 接进来。', 'Until this step is complete, the site does not splice in an old Stage-2 checkpoint, old harness state, or premature 3B rollout history.')}</span>
      </div>
      <button type="button" data-redesign-detail="origin" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>

    <span class="redesign-connector redesign-connector--future" aria-hidden="true"></span>

    <article class="redesign-node redesign-node--future" data-node-kind="mainline" data-node-state="future">
      <div class="redesign-node__status"><span>{t('第二层 · 尚未开始', 'FLOOR 2 · NOT STARTED')}</span><b>06</b></div>
      <div>
        <p>NEW STAGE 2</p>
        <h2>{t('让模型在没有外部老师的情况下继续自我进化', 'Let the model continue self-evolving without an external teacher')}</h2>
        <strong>{t('有 clean exact success → 可以参数更新；没有 → 合法 NOOP', 'Clean exact success → parameter update is allowed; none → legitimate NOOP')}</strong>
        <span>{t('旧 7-vs-8 和 256-window 不再回到主规则里。新版 Stage2 的真正启动、selector 和 interlock 必须由这条 fresh lineage 的新 activation 冻结。', 'The old 7-vs-8 and 256-window rules do not return. The actual launch, selector, and interlock for the new Stage 2 must be frozen by a new activation for this fresh lineage.')}</span>
      </div>
      <button type="button" data-redesign-detail="stage2" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>

    <span class="redesign-connector redesign-connector--future" aria-hidden="true"></span>

    <article class="redesign-node redesign-node--future redesign-node--ending" data-node-kind="mainline" data-node-state="future">
      <div class="redesign-node__status"><span>{t('结局尚未揭晓', 'ENDING LOCKED')}</span><b>07</b></div>
      <div>
        <p>FINAL EVALUATION</p>
        <h2>{t('等 Stage 2 自己走完，再打开 final panel', 'Open the final panel only after Stage 2 completes')}</h2>
        <span>{t('最终评测不能提前变成调参信号；它只回答这条 successor 到终点后究竟学到了多少。', 'The final evaluation cannot become an early tuning signal; it only measures what this successor has learned once the route reaches its endpoint.')}</span>
      </div>
      <button type="button" data-redesign-detail="final" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
    </article>
  </section>

  <aside class="redesign-snapshot" aria-labelledby="snapshot-title">
    <p>AUTHORITY SNAPSHOT · 2026-09-03 00:26 SGT</p>
    <h2 id="snapshot-title">{t('现在这条新路线走到哪里？', 'How far has this successor reached?')}</h2>
    <div>
      <span><b>✓</b>{t('Stage1-202609021800 已冻结：3B 与 Qwen3-1.7B 共用 strategy-neutral Harness201.1 合同', 'Stage1-202609021800 is frozen: 3B and Qwen3-1.7B share the strategy-neutral Harness201.1 contract')}</span>
      <span><b>✓</b>{t('MiniMax successor authority 202609022300 已冻结；closeout 仍要求 1,440 条 source identity 全部 parse_ok', 'MiniMax successor authority 202609022300 is frozen; closeout still requires all 1,440 source identities to be parse_ok')}</span>
      <span><b>→</b>{t('current campaign = analysis-authorized；Qwen3-1.7B 已有 sealed Stage1 receipt，3B 仍需先通过自己的 Stage1 mechanical seal；没有 authority 宣告 MiniMax 1,440/1,440 COMPLETE', 'current campaign = analysis-authorized; Qwen3-1.7B has a sealed Stage1 receipt, while 3B must still pass its own Stage1 mechanical seal; no authority declares MiniMax 1,440/1,440 COMPLETE')}</span>
      <span><b>○</b>{t('OPSD / Memory / Skill / Agent / Stage 2 均被 202609022300 authority 明确列为 downstream_not_authorized_here，继续保持 future / locked', 'OPSD / Memory / Skill / Agent / Stage 2 are explicitly listed as downstream_not_authorized_here by the 202609022300 authority and remain future / locked')}</span>
    </div>
    <small>{t('这是网站同步用的 authority snapshot，不替代实验仓库的 live state / receipt。', 'This is a website synchronization snapshot, not a substitute for the experiment repository’s live state / receipts.')}</small>
  </aside>

  <div class="redesign-detail-layer" data-redesign-detail-layer hidden>
    <button class="redesign-detail-layer__backdrop" type="button" data-redesign-detail-close aria-label={t('关闭关卡说明', 'Close stage notes')}></button>
    <aside class="redesign-detail" data-redesign-detail-card role="dialog" aria-modal="false" aria-labelledby="redesign-detail-title" tabindex="-1">
      <button class="redesign-detail__close" type="button" data-redesign-detail-close aria-label={t('关闭', 'Close')}>×</button>
      <p>{t('关卡说明', 'STAGE NOTES')}</p>
      <h2 id="redesign-detail-title" data-redesign-detail-title></h2>
      <div data-redesign-detail-content></div>
    </aside>
  </div>

  <template data-redesign-detail-template="harness">
    <p>{t('Harness201.1 不是给模型“提示怎么做题”。它只规定接口：思考文字不是 action validity gate；一旦进入 `<action>`，token-prefix constraint 只能走当前 Allowed Actions。', 'Harness201.1 does not teach the model how to solve the task. It only defines the interface: reasoning text is not an action-validity gate, and once `<action>` begins, a token-prefix constraint permits only current Allowed Actions.')}</p>
    <dl><div><dt>Qwen2.5-3B qualification64</dt><dd>{t('invalid termination 5/64，冻结门槛最多 11；parser repair=0，constraint escape=0。', 'invalid termination 5/64 against a frozen maximum of 11; parser repair=0 and constraint escape=0.')}</dd></div><div><dt>step seed</dt><dd>injective-v1</dd></div><div><dt>{t('策略泄漏', 'Strategy leakage')}</dt><dd>{t('qualification profile 是 strategy-neutral；Stage1 不注入 learned carriers / SD adapter。', 'The qualification profile is strategy-neutral; Stage1 injects no learned carriers or SD adapter.')}</dd></div></dl>
    <a href={links.harness}>{t('查看旧 Harness 诊断页 →', 'Open the old harness diagnostic page →')}</a>
  </template>
  <template data-redesign-detail-template="qwen3">
    <p>{t('Qwen3-1.7B 是现代小模型平行 arm，不是用来偷偷替换 Qwen2.5-3B。它用同一个 strategy-neutral Harness201.1 接口做 qualification，但自己的 Stage1、MiniMax、OPSD 和 carrier 必须独立生成。', 'Qwen3-1.7B is a parallel modern-small-model arm, not a silent replacement for Qwen2.5-3B. It qualifies under the same strategy-neutral Harness201.1 interface while generating its own Stage1, MiniMax, OPSD, and carriers.')}</p>
    <strong>{t('共享 qualification：invalid termination 0/64，冻结门槛最多 29。', 'Shared qualification: invalid termination 0/64 against a frozen maximum of 29.')}</strong>
  </template>
  <template data-redesign-detail-template="fresh-stage1">
    <p>{t('旧 3B Stage1 轨迹不能复用，因为 on-policy action channel 已经改变。formal successor 从 fresh position 1 开始，qualification rows 也不能直接算进正式 1,440。', 'Old 3B Stage1 trajectories cannot be reused because the on-policy action channel changed. The formal successor starts from fresh position 1, and qualification rows cannot be counted inside the formal 1,440.')}</p>
    <ul><li>{t('temperature=0.4，max_steps=15。', 'temperature=0.4, max_steps=15.')}</li><li>{t('不带旧 Memory / Skill / Agent。', 'No old Memory / Skill / Agent.')}</li><li>{t('不带旧 OPSD / Stage2 state。', 'No old OPSD / Stage2 state.')}</li><li>{t('final panel 仍锁住。', 'The final panel remains locked.')}</li></ul>
  </template>
  <template data-redesign-detail-template="minimax">
    <p>{t('MiniMax 是 post-hoc analyzer：只有某个 arm 的 Stage1 source 已合法 seal，才允许按同一 trajectory identity 做分析；当前 closeout 合同要求 1,440 条 source identity 全部 parse_ok。服务器或 Kaggle 只是执行环境，不自动变成科学分支。', 'MiniMax is a post-hoc analyzer: an arm can enter analysis only after its Stage1 source is validly sealed, and the current closeout contract requires all 1,440 source identities to be parse_ok. Server versus Kaggle is an execution environment, not automatically a scientific branch.')}</p>
    <small>{t('429、Retry-After、resume 只认 parse_ok=true 等属于工程可靠性，放进实验档案而不是主路线。', '429 handling, Retry-After, and resume-counts-only-parse_ok=true are engineering reliability details and belong in the archive rather than the mainline.')}</small>
    <a href={links.archive}>{t('打开 MiniMax / execution 档案 →', 'Open the MiniMax / execution archive →')}</a>
  </template>
  <template data-redesign-detail-template="teacher-seal">
    <p>{t('Teacher Evidence Pool 把“老师能看到什么”冻结下来。后续 OPSD / Memory / Skill / Agent 都绑定同一份 analysis corpus；Stage2 不允许再扩大 teacher budget。', 'The Teacher Evidence Pool freezes what the teacher was allowed to see. OPSD / Memory / Skill / Agent all bind to that same analysis corpus, and Stage2 cannot expand the teacher budget later.')}</p>
  </template>
  <template data-redesign-detail-template="opsd">
    <p>{t('当前 `202609022300` MiniMax authority 明确把 OPSD 放在 downstream_not_authorized_here。新的 OPSD 必须等当前 MiniMax corpus 完成并单独授权；更早 successor 的 adapter / action-step records 不能直接搬过来。', 'The current `202609022300` MiniMax authority explicitly lists OPSD under downstream_not_authorized_here. A new OPSD must wait for the current MiniMax corpus and a separate authorization; adapter / action-step artifacts from an earlier successor cannot be carried over silently.')}</p>
  </template>
  <template data-redesign-detail-template="memory">
    <p>{t('A2 不是“看到 A1 不顺就随便拆 batch”。更早 3B successor 的 bounded A2 要求同一个 20-input node 的 primary 和 same-20 repair 都 saturation，并绑定 exact trigger receipt；当前 fresh corpus 若未来需要 A2，也必须重新产生自己的合法 trigger，不能继承旧 trigger。', 'A2 is not “split the batch whenever A1 feels inconvenient.” In the earlier 3B successor, bounded A2 required primary and same-20 repair saturation on the same 20-input node and an exact trigger receipt. If the current fresh corpus ever needs A2, it must produce its own valid trigger rather than inheriting the old one.')}</p>
  </template>
  <template data-redesign-detail-template="skill">
    <p>{t('Skill Bundle 是行为策略 carrier。它属于 Stage1 downstream preparation；如果只是容量问题，可以按冻结的 deterministic capacity rule 处理，但不能按 reward / outcome 偷偷改变 input topology。', 'Skill Bundle is a behavioral-strategy carrier. It belongs to Stage1 downstream preparation; capacity handling may follow the frozen deterministic rule, but input topology cannot be changed opportunistically based on reward or outcome.')}</p>
  </template>
  <template data-redesign-detail-template="agent">
    <p>{t('Agent System 依赖这条 successor 的 Memory / Skill。关键因果边界是：它只能在 Stage1 轨迹已经采完后生成，不能反向注入 Stage1，否则会形成信息泄漏 / 循环依赖。', 'Agent System depends on this successor’s Memory / Skill. The key causal boundary is that it is generated only after Stage1 trajectory collection; injecting it backward into Stage1 would create information leakage / circular dependence.')}</p>
  </template>
  <template data-redesign-detail-template="origin">
    <p>{t('Stage2 origin seal 是“把所有 Stage1 产物装进同一辆车并确认能启动”的步骤。它要验证新 OPSD adapter、Memory、Skill、Agent、模型 revision、execution source 和 provenance 都是同一 lineage。', 'The Stage2 origin seal is the step where all Stage1 products are assembled into one coherent starting state and proven loadable. It verifies that the fresh OPSD adapter, Memory, Skill, Agent, model revision, execution source, and provenance all belong to one lineage.')}</p>
  </template>
  <template data-redesign-detail-template="stage2">
    <p>{t('新版 Stage2 的方向已经明确，但 formal activation 仍必须独立冻结。长期核心是：每轮收集新 rollout；0 clean exact success 可以 NOOP；出现 clean exact success 才允许 parametric update；teacher 不再回来。', 'The redesign direction is clear, but the formal Stage2 activation still needs an independent freeze. The long-term core is: collect fresh rollouts each round; zero clean exact success can legitimately NOOP; clean exact success is required before a parametric update; the teacher does not return.')}</p>
    <strong>{t('旧 7-vs-8、16-success gate、256-rollout parametric cadence 都不回到 current rule。', 'The old 7-vs-8 rule, 16-success gate, and 256-rollout parametric cadence do not return to the current rule.')}</strong>
  </template>
  <template data-redesign-detail-template="final">
    <p>{t('Final Evaluation 只在自己的 Stage2 seal 后解锁。它不能提前参与 selector、threshold 或 checkpoint 选择，否则 final panel 会从“考试”变成“练习题”。', 'Final Evaluation unlocks only after its own Stage2 seal. It cannot participate early in selector, threshold, or checkpoint choice, or the final panel stops being an exam and becomes training material.')}</p>
  </template>
</main>

<script>
  document.querySelectorAll<HTMLElement>('[data-redesign-map]').forEach((root) => {
    const all = <T extends Element>(selector: string) => [...root.querySelectorAll<T>(selector)];
    const one = <T extends Element>(selector: string) => root.querySelector<T>(selector);
    const layer = one<HTMLElement>('[data-redesign-detail-layer]');
    const card = one<HTMLElement>('[data-redesign-detail-card]');
    const title = one<HTMLElement>('[data-redesign-detail-title]');
    const content = one<HTMLElement>('[data-redesign-detail-content]');
    let active: HTMLButtonElement | null = null;
    let bodyOverflow = '';
    const isMobile = () => window.matchMedia('(max-width: 720px)').matches;

    const close = (restore = true) => {
      if (!layer || layer.hidden) return;
      layer.hidden = true;
      all<HTMLButtonElement>('[data-redesign-detail]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
      card?.style.removeProperty('left'); card?.style.removeProperty('top'); card?.setAttribute('aria-modal', 'false');
      document.body.style.overflow = bodyOverflow;
      const trigger = active; active = null; if (restore) trigger?.focus();
    };
    const position = (trigger: HTMLButtonElement) => {
      if (!card) return;
      if (isMobile()) { card.style.removeProperty('left'); card.style.removeProperty('top'); return; }
      const node = trigger.closest<HTMLElement>('.redesign-node, .downstream-card, .redesign-branch article');
      if (!node) return;
      const parent = root.getBoundingClientRect(); const anchor = node.getBoundingClientRect(); const box = card.getBoundingClientRect();
      let left = anchor.right - parent.left + 14;
      if (left + box.width > parent.width) left = Math.max(0, anchor.left - parent.left - box.width - 14);
      const top = Math.max(0, anchor.top - parent.top + anchor.height / 2 - box.height / 2);
      card.style.left = `${left}px`; card.style.top = `${top}px`;
    };
    const open = (trigger: HTMLButtonElement) => {
      if (!layer || !card || !title || !content) return;
      const key = trigger.dataset.redesignDetail || '';
      const template = one<HTMLTemplateElement>(`[data-redesign-detail-template="${key}"]`); if (!template) return;
      if (!layer.hidden && active === trigger) { close(); return; }
      all<HTMLButtonElement>('[data-redesign-detail]').forEach((button) => button.setAttribute('aria-expanded', String(button === trigger)));
      active = trigger;
      title.textContent = trigger.closest<HTMLElement>('.redesign-node, .downstream-card, .redesign-branch article')?.querySelector('h2, h3, strong')?.textContent?.trim() || '';
      content.replaceChildren(template.content.cloneNode(true)); layer.hidden = false;
      if (isMobile()) { bodyOverflow = document.body.style.overflow; document.body.style.overflow = 'hidden'; card.setAttribute('aria-modal', 'true'); }
      requestAnimationFrame(() => { position(trigger); card.focus(); });
    };
    all<HTMLButtonElement>('[data-redesign-detail]').forEach((button) => button.addEventListener('click', () => open(button)));
    all<HTMLButtonElement>('[data-redesign-detail-close]').forEach((button) => button.addEventListener('click', () => close()));
    window.addEventListener('resize', () => { if (active && layer && !layer.hidden) position(active); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && layer && !layer.hidden) close(); });
  });
</script>

