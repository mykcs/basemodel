---
type Kind = 'methods' | 'results' | 'questions' | 'osa';
interface Props { current: Kind }
const { current } = Astro.props;
const pages = [
  { id: 'methods', number:'01', title:'OpenEVO 的参数记忆方法', path:'/research/seed-openevo/study/openevo-methods/' },
  { id: 'questions', number:'02', title:'学长十问：问题与背景', path:'/research/seed-openevo/study/advisor-questions/' },
  { id: 'osa', number:'＋', title:'独立探索：OSA 正交化记忆', path:'/research/seed-openevo/study/osa-memory/' },
  { id: 'results', number:'03', title:'我们的回应实验', path:'/research/seed-openevo/study/parameter-memory-results/' },
] as const;
---
<nav class="evo-article__siblings" aria-label="OpenEVO 研究文章">
  <p>三篇研究文章与一项独立探索</p>
  <ol>
    {pages.map((item) => (
      <li>
        {current===item.id ? (
          <span class="evo-current" aria-current="page"><span class="evo-number">{item.number}</span>{item.title}</span>
        ) : (
          <a href={item.path}><span class="evo-number">{item.number}</span>{item.title}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
