---
import { localePath, type Locale } from '../../i18n';
import { openEvoScientificState } from '../../lib/openEvoScientificState';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const chain = [
  { eyebrow:t('模型','Model'), title:'Qwen2.5-3B-Instruct', body:t('固定同一份模型参数版本（checkpoint）、数值精度和运行设置。','Pin the same model-parameter version (checkpoint), numeric precision, and runtime settings.'), href:p('/models/qwen2-5-3b-instruct/#experiment-setup') },
  { eyebrow:t('方法','Methods'), title:'SEED / OpenEvo', body:t('比较“学到的东西”被存在哪里：模型参数、适配器或可复用经验状态。','Compare where learned information is stored: model parameters, adapters, or reusable experience state.'), href:p('/research/seed-openevo/flow/loops/') },
  { eyebrow:t('环境','Environments'), title:'ALFWorld / WebShop', body:t('任务、能做的动作和评分规则都由环境决定；环境不同，分数不能直接混在一起。','The environment defines the task, allowed actions, and scoring; scores from different environments are not directly interchangeable.'), href:p('/research/seed-openevo/flow/benchmarks/') },
  { eyebrow:t('实验记录','Experiment record'), title:'openevo-experiment', body:t('每个结果都要能追溯到实际工作分支、实验总表（campaign）和实验对账（reconciliation）。','Every result must trace back to the working branch, experiment ledger (campaign), and reconciliation.'), href:p('/research/seed-openevo/study/results/') },
] as const;
---
<section class:list={['mission-hero',compact&&'mission-hero--compact']} aria-labelledby="mission-title" data-reader-primary>
  <div class="mission-hero__copy">
    <h1 id="mission-title">{t('SEED 与 OpenEvo 的 ALFWorld / WebShop 对照实验', 'SEED and OpenEvo on matched ALFWorld / WebShop tasks')}</h1>
    <p class="mission-hero__lede">{t('SEED 把任务后的成功经验继续写进模型参数；OpenEvo 先封存任务证据，在后续 Stage 2 中分别检查文字记忆、技能、行为规则和 LoRA 参数更新，只有被当前规则采用的状态才带到下一批任务。这里固定同一个 Qwen2.5-3B-Instruct、同一批 ALFWorld（文本具身任务）与 WebShop（网页购物任务）、同一评分规则和训练预算；条件没对齐，分数差异就不能归因于方法。','SEED writes successful post-task experience back into model parameters. OpenEvo first seals task evidence; in later Stage 2, text memory, reusable skills, behavior rules, and LoRA parameter updates are checked separately, and only the state adopted by the current rules is carried into the next task batch. Here we keep the same Qwen2.5-3B-Instruct, the same ALFWorld (text-based embodied tasks) and WebShop (web-shopping tasks), scoring rules, and training budget aligned; otherwise score differences cannot be attributed to the method.')}</p>
    {compact && <p class="mission-hero__boundary"><strong>{t('这是实验设计与流程，不是结果。', 'This is the experiment design and flow, not a results page.')}</strong> {t('下面用 WebShop 展开两阶段训练；ALFWorld 有自己的交互与评分，两个环境的分数不能直接混比。完整系统对照只能说明两套系统总体表现；若要把差异归因到 Stage 2 学习器，两边还必须共享 Stage 1 轨迹、任务后复盘、训练配方和同一个起点模型。', 'The two-stage training flow below uses WebShop as the concrete example. ALFWorld has its own interaction and scoring contract, so scores from the two environments are not directly interchangeable. A full-system comparison only supports an overall system comparison; attributing a difference to the Stage-2 learner additionally requires shared Stage-1 traces, post-task review, training recipe, and starting model.')}</p>}
    {!compact && <div class="mission-hero__actions"><a class="button button-primary mission-hero__briefing-cta" href={p('/research/seed-openevo/study/briefing/')}>{t('OpenEVO 阶段汇报 →','OpenEVO progress briefing →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/flow/')}>{t('研究总览','Research overview')}</a></div>}
  </div>

  <details class="mission-hero__secondary">
    <summary>{t('实验记录与当前状态', 'Experiment records and current state')}</summary>
    <dl class="mission-status">
      <div><dt>{t('科学事实的总账（source of truth）','Scientific source of truth')}</dt><dd>openevo-experiment</dd></div>
      <div><dt>{t('最近核验的默认分支（main snapshot）','Last checked default branch (main snapshot)')}</dt><dd>{openEvoScientificState.defaultBranchSnapshot.phase} · {openEvoScientificState.checkedAt}</dd></div>
      <div><dt>{t('当前实验状态（live state）','Live experiment state')}</dt><dd>{t('工作分支 → 实验总表（campaign）→ 实验对账（reconciliation）','working branch → experiment ledger (campaign) → reconciliation')}</dd></div>
      <div><dt>{t('当前默认 main 的 GPU 权限','GPU permission on checked main')}</dt><dd>{openEvoScientificState.defaultBranchSnapshot.gpuAllocationAllowed ? t('已授权；启动前仍要现场核验','Authorized; live checks are still required before launch') : t('未授权；恢复训练需要新的执行许可','Not authorized; training resumption needs new execution approval')}</dd></div>
    </dl>

    <figure class="mission-chain" aria-labelledby="mission-chain-caption">
      <figcaption id="mission-chain-caption"><span>{t('研究里的四种东西','Four things in the study')}</span><strong>{t('模型、学习方法、任务环境和实验记录是四个不同变量。把它们混在一起，就会把“模型变了”“任务变了”和“测量方式变了”误当成同一种变化。','Model, learning method, task environment, and experiment record are different variables. Mixing them can make a model change, a task change, and a measurement change look like the same thing.')}</strong><span class="mission-chain__swipe-hint">{t('横向滑动查看完整实验步骤','Swipe horizontally to inspect all experiment steps')}</span></figcaption>
      <ol>{chain.map((node,index)=><li><a href={node.href}><span>{String(index+1).padStart(2,'0')}</span><small>{node.eyebrow}</small><strong>{node.title}</strong><p>{node.body}</p></a></li>)}</ol>
      <p class="mission-history">{t(`seed3090 与 openevo-webshop 保存历史证据；当前实验总账是 openevo-experiment。本站最近一次核验默认 main 的日期是 ${openEvoScientificState.checkedAt}。如果实际工作分支比 main 更靠前，当前阶段必须从那个分支的实验总表（campaign）和实验对账（reconciliation）重新读取。`,`seed3090 and openevo-webshop preserve historical evidence; openevo-experiment is the current experiment source of truth. This site last checked default main on ${openEvoScientificState.checkedAt}. If the working branch is ahead of main, resolve the current phase again from that branch's experiment ledger (campaign) and reconciliation.`)}</p>
    </figure>
  </details>
</section>

<style>
  .mission-hero{width:min(1180px,calc(100% - 2rem));margin:1.2rem auto 2.5rem}.mission-hero__copy,.mission-chain{border:1px solid var(--line);border-radius:20px;background:var(--surface)}.mission-hero__copy{box-sizing:border-box;min-height:calc(100svh - 80px);padding:clamp(1.4rem,3vw,2.5rem);display:flex;flex-direction:column;justify-content:center}.mission-hero h1{margin:0 0 .75rem}.mission-hero__lede{max-width:64ch;margin:0;color:var(--muted);line-height:1.7}.mission-hero__actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.1rem}.mission-hero__secondary{margin-top:.75rem;border-top:1px solid var(--line)}.mission-hero__secondary>summary{width:max-content;max-width:100%;padding:.8rem 0;color:var(--muted);font-size:.86rem;font-weight:720;cursor:pointer;list-style:none;text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--muted) 38%,transparent);text-underline-offset:.2em}.mission-hero__secondary>summary::-webkit-details-marker{display:none}.mission-hero__secondary[open]>summary{color:var(--ink)}.mission-status{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin:.2rem 0 1rem}.mission-status div{padding:.65rem;border-top:1px solid var(--line)}.mission-status dt{color:var(--muted);font-size:.72rem;line-height:1.45}.mission-status dd{margin:.3rem 0 0;font-size:.8rem;font-weight:750;line-height:1.45}.mission-chain{margin:0;padding:1rem}.mission-chain figcaption span,.mission-chain figcaption strong{display:block}.mission-chain figcaption span{color:var(--accent-deep);font-size:.74rem;font-weight:800}.mission-chain figcaption strong{margin-top:.3rem;font-size:.9rem;line-height:1.5}.mission-chain ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}.mission-chain a{display:flex;height:100%;min-height:155px;flex-direction:column;padding:.85rem;border:1px solid var(--line);border-radius:13px;color:inherit;text-decoration:none}.mission-chain a>span{color:var(--accent-deep);font:800 .72rem/1 var(--font-mono)}.mission-chain small{margin-top:auto;color:var(--muted);font-size:.72rem}.mission-chain strong{margin-top:.25rem;font-size:.86rem}.mission-chain p{margin:.4rem 0 0;color:var(--muted);font-size:.76rem;line-height:1.5}.mission-chain .mission-history{margin:.8rem 0 0;padding:.8rem .7rem;border-top:1px solid var(--line);font-size:.76rem;line-height:1.55}.mission-hero.mission-hero--compact{width:min(1120px,calc(100% - 2rem));margin:1.35rem auto 1.8rem}.mission-hero.mission-hero--compact .mission-hero__copy{min-height:0;padding:clamp(1.6rem,3vw,2.4rem) 0 1.3rem;border:0;border-radius:0;background:transparent;justify-content:flex-start}.mission-hero.mission-hero--compact .mission-hero__lede{max-width:68ch;color:var(--ink);font-size:clamp(1rem,1.5vw,1.12rem);line-height:1.65}.mission-hero__boundary{max-width:72ch;margin:.72rem 0 0;padding-top:.62rem;border-top:1px solid var(--line);color:var(--muted);font-size:.84rem;line-height:1.55}.mission-hero__boundary strong{color:var(--ink)}@media(max-width:920px){.mission-chain ol{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.mission-hero{width:min(100% - 1rem,1180px)}.mission-hero__copy{min-height:calc(100svh - 64px)}.mission-chain ol,.mission-status{grid-template-columns:1fr}.mission-chain a{min-height:115px}}

  .mission-chain figcaption .mission-chain__swipe-hint{display:none}
  .mission-chain li,.mission-chain li>a{position:relative}
  .mission-chain li:not(:last-child)::after{content:'';top:50%;right:-.55rem;bottom:auto;width:.55rem;height:2px;border-radius:999px;background:color-mix(in srgb,var(--accent) 62%,var(--line));transform:translateY(-50%)}
  .mission-chain li:not(:last-child)>a::after{content:'';position:absolute;z-index:3;top:50%;right:-.37rem;width:6px;height:6px;border:1.5px solid var(--accent);border-radius:50%;background:var(--surface);transform:translateY(-50%)}
  @media(max-width:1020px){
    .mission-chain{overflow:hidden}
    .mission-chain figcaption .mission-chain__swipe-hint{display:block;width:fit-content;margin-top:.65rem;margin-bottom:0;padding:.3rem .55rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.72rem;font-weight:700;line-height:1.4;letter-spacing:normal}
    .mission-chain ol{display:grid;grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(220px,min(76vw,300px));gap:.65rem;max-width:100%;box-sizing:border-box;margin-inline:0;padding:.15rem .15rem .9rem;overflow-x:auto;overscroll-behavior-inline:contain;scroll-padding-inline:.15rem;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .mission-chain ol::-webkit-scrollbar{display:none}
    .mission-chain li{scroll-snap-align:start}
    .mission-chain li a{min-height:176px}
    .mission-chain li:not(:last-child)::after{top:50%;right:2px;bottom:auto;width:.65rem;height:2px;transform:translateY(-50%)}
    .mission-chain li:not(:last-child)>a::after{right:8px}
  }
  @media(max-width:640px){
    .mission-hero.mission-hero--compact{margin-bottom:2rem}
    .mission-hero.mission-hero--compact .mission-hero__copy{padding-left:12px;padding-right:12px}
    .mission-chain{padding:14px 0 12px;border:1px solid color-mix(in srgb,var(--line) 86%,transparent);border-radius:var(--mobile-radius-lg);background:color-mix(in srgb,var(--surface) 76%,transparent)}
    .mission-chain figcaption{padding:2px 16px 12px}
    .mission-chain figcaption span{margin-bottom:4px;line-height:1.2;letter-spacing:.035em}
    .mission-chain figcaption strong{max-width:32em;letter-spacing:-.006em}
    .mission-chain li small{margin-bottom:3px;line-height:1.25;letter-spacing:.025em}
    .mission-chain li strong{line-height:1.28;letter-spacing:-.01em}
    .mission-chain ol{grid-auto-columns:minmax(218px,82vw)}
    .mission-chain figcaption .mission-chain__swipe-hint{margin-bottom:0;line-height:1.4;letter-spacing:normal}
  }
</style>