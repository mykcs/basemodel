---
import { localePath, type Locale } from '../../i18n';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const chain = [
  { eyebrow:t('模型','Model'), title:'Qwen2.5-3B-Instruct', body:t('固定 checkpoint、精度和运行设置。','Pin checkpoint, precision, and runtime settings.'), href:p('/research/seed-openevo/base-model/') },
  { eyebrow:t('方法','Methods'), title:'SEED / OpenEvo', body:t('区分参数更新与跨任务演化。','Separate parameter updates from cross-task evolution.'), href:p('/research/seed-openevo/loops/') },
  { eyebrow:t('环境','Environments'), title:'ALFWorld / WebShop', body:t('先对照任务与评分，再进入各自的交互讲解。','Compare tasks and metrics, then open each dedicated interactive explainer.'), href:p('/research/seed-openevo/benchmarks/') },
  { eyebrow:t('实验','Experiment'), title:'openevo-experiment', body:t('当前 WebShop 正式实验 source of truth。','Current source of truth for formal WebShop experiments.'), href:p('/research/seed-openevo/results/') },
] as const;
---
<section class:list={['mission-hero',compact&&'mission-hero--compact']} aria-labelledby="mission-title">
  <div class="mission-hero__copy">
    <p class="mission-hero__eyebrow">SEED × OpenEvo</p>
    <h1 id="mission-title">{t('ALFWorld 与 WebShop 研究', 'ALFWorld and WebShop research')}</h1>
    <p class="mission-hero__lede">{t('理解 SEED 与 OpenEvo 的更新机制，在相同模型和评测协议下运行实验，并用轨迹、分数和失败模式设计下一步。','Understand the update mechanisms in SEED and OpenEvo, run experiments under shared model and evaluation protocols, and use trajectories, scores, and failure modes to plan the next step.')}</p>
    <div class="mission-hero__actions"><a class="button button-primary" href={p('/research/seed-openevo/')}>{t('研究总览 →','Research overview →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/results/')}>{t('实验结果','Experiment results')}</a></div>
    <dl class="mission-status">
      <div><dt>{t('当前仓库','Current repo')}</dt><dd>openevo-experiment</dd></div>
      <div><dt>{t('当前阶段','Current phase')}</dt><dd>Phase H0</dd></div>
      <div><dt>{t('当前实验分配','Current allocation')}</dt><dd>5× RTX 5090</dd></div>
      <div><dt>{t('历史平台','Historical platform')}</dt><dd>RTX6 · 4× RTX 3090</dd></div>
    </dl>
  </div>

  <figure class="mission-chain" aria-labelledby="mission-chain-caption">
    <figcaption id="mission-chain-caption"><span>{t('研究对象','Research objects')}</span><strong>{t('模型、方法、环境与当前实验使用同一套可追溯记录。','Model, method, environment, and current experiments share one traceable record.')}</strong></figcaption>
    <ol>{chain.map((node,index)=><li><a href={node.href}><span>{String(index+1).padStart(2,'0')}</span><small>{node.eyebrow}</small><strong>{node.title}</strong><p>{node.body}</p></a></li>)}</ol>
    <p class="mission-history">{t('seed3090 与 openevo-webshop 继续作为历史证据与迁移来源，不再代表当前实验状态。','seed3090 and openevo-webshop remain historical evidence and migration sources; they no longer represent current experiment status.')}</p>
  </figure>
</section>

<style>
  .mission-hero{width:min(1180px,calc(100% - 2rem));margin:1.2rem auto 2.5rem;display:grid;grid-template-columns:minmax(0,.9fr) minmax(460px,1.1fr);gap:1rem;align-items:stretch}.mission-hero__copy,.mission-chain{border:1px solid var(--line);border-radius:20px;background:var(--surface)}.mission-hero__copy{padding:clamp(1.4rem,3vw,2.5rem);display:flex;flex-direction:column;justify-content:center}.mission-hero__eyebrow{margin:0;color:var(--accent-deep);font-size:.72rem;font-weight:800}.mission-hero h1{margin:.55rem 0 .75rem}.mission-hero__lede{max-width:64ch;margin:0;color:var(--muted);line-height:1.7}.mission-hero__actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.1rem}.mission-status{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin:1.2rem 0 0}.mission-status div{padding:.6rem;border-top:1px solid var(--line)}.mission-status dt{color:var(--muted);font-size:.64rem}.mission-status dd{margin:.25rem 0 0;font-size:.76rem;font-weight:750}.mission-chain{margin:0;padding:1rem}.mission-chain figcaption span,.mission-chain figcaption strong{display:block}.mission-chain figcaption span{color:var(--accent-deep);font-size:.68rem;font-weight:800}.mission-chain figcaption strong{margin-top:.3rem;font-size:.84rem;line-height:1.45}.mission-chain ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}.mission-chain a{display:flex;height:100%;min-height:155px;flex-direction:column;padding:.8rem;border:1px solid var(--line);border-radius:13px;color:inherit;text-decoration:none}.mission-chain a>span{color:var(--accent-deep);font:800 .66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.mission-chain small{margin-top:auto;color:var(--muted);font-size:.62rem}.mission-chain strong{margin-top:.25rem;font-size:.82rem}.mission-chain p{margin:.4rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.4}.mission-chain .mission-history{margin:.7rem 0 0;padding:.7rem;border-top:1px solid var(--line);font-size:.7rem}.mission-hero--compact{grid-template-columns:1fr}.mission-hero--compact .mission-hero__copy{display:none}@media(max-width:920px){.mission-hero{grid-template-columns:1fr}.mission-chain ol{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.mission-hero{width:min(100% - 1rem,1180px)}.mission-chain ol,.mission-status{grid-template-columns:1fr}.mission-chain a{min-height:115px}}
</style>
