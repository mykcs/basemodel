---
import { localePath, type Locale } from '../../i18n';
import { openEvoScientificState } from '../../lib/openEvoScientificState';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const chain = [
  { eyebrow:t('模型','Model'), title:'Qwen2.5-3B-Instruct', body:t('固定模型版本（checkpoint）、精度和运行设置。','Pin checkpoint, precision, and runtime settings.'), href:p('/research/seed-openevo/flow/base-model/') },
  { eyebrow:t('方法','Methods'), title:'SEED / OpenEvo', body:t('比较两种学习与更新方法分别改变什么。','Compare what the two learning and update methods actually change.'), href:p('/research/seed-openevo/flow/loops/') },
  { eyebrow:t('环境','Environments'), title:'ALFWorld / WebShop', body:t('两个环境的任务结构、交互方式和评分规则不同。','ALFWorld and WebShop use different task structures, interactions, and scoring rules.'), href:p('/research/seed-openevo/flow/benchmarks/') },
  { eyebrow:t('实验','Experiment'), title:'openevo-experiment', body:t('最新科学状态以实际工作分支、实验配置和实验对账记录为准。','Live scientific state is resolved from the actual working branch, campaign, and reconciliation.'), href:p('/research/seed-openevo/study/results/') },
] as const;
---
<section class:list={['mission-hero',compact&&'mission-hero--compact']} aria-labelledby="mission-title">
  <div class="mission-hero__copy">
    <p class="mission-hero__eyebrow">SEED × OpenEvo</p>
    <h1 id="mission-title">{t('ALFWorld 与 WebShop 研究', 'ALFWorld and WebShop research')}</h1>
    <p class="mission-hero__lede">{t('这组研究想回答一个很直接的问题：在尽量相同的模型、任务和评测条件下，OpenEvo 学到了什么、哪些提升是真的、哪些结果还不能和 SEED 公平比较。下面先讲研究对象，再逐层展开专业细节和实验依据。','This research asks a direct question: under closely matched models, tasks, and evaluation conditions, what does OpenEvo learn, which gains are real, and which results are not yet fairly comparable with SEED. The page starts with the research objects and then layers in technical details and evidence.')}</p>
    <div class="mission-hero__actions"><a class="button button-primary" href={p('/research/seed-openevo/flow/')}>{t('研究总览 →','Research overview →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/study/results/')}>{t('研究结果','Research findings')}</a></div>
    <dl class="mission-status">
      <div><dt>{t('科学事实来源（source of truth）','Scientific source of truth')}</dt><dd>openevo-experiment</dd></div>
      <div><dt>{t('默认分支快照（default-branch snapshot）','Default-branch snapshot')}</dt><dd>{openEvoScientificState.defaultBranchSnapshot.phase} · {openEvoScientificState.checkedAt}</dd></div>
      <div><dt>{t('实时状态（live state）','Live state')}</dt><dd>{t('实际工作分支 → 实验配置（campaign）→ 实验对账（reconciliation）','actual branch → campaign → reconciliation')}</dd></div>
      <div><dt>{t('GPU 使用条件','GPU use')}</dt><dd>{t('实验预注册（preregistration）+ 已授权 GPU UUID','preregistration + authorized UUIDs')}</dd></div>
    </dl>
  </div>

  <figure class="mission-chain" aria-labelledby="mission-chain-caption">
    <figcaption id="mission-chain-caption"><span>{t('研究对象','Research objects')}</span><strong>{t('先把模型、方法、环境和实验记录分开看，后面就不容易把“模型变了”“任务变了”和“测量方式变了”混成一件事。','Separating model, method, environment, and experiment records first makes it easier to distinguish model changes, task changes, and measurement changes later.')}</strong></figcaption>
    <ol>{chain.map((node,index)=><li><a href={node.href}><span>{String(index+1).padStart(2,'0')}</span><small>{node.eyebrow}</small><strong>{node.title}</strong><p>{node.body}</p></a></li>)}</ol>
    <p class="mission-history">{t(`历史证据主要来自 seed3090 与 openevo-webshop。默认分支快照核验于 ${openEvoScientificState.checkedAt}；真正的最新实验阶段和 GPU 分配，以 openevo-experiment 实际工作分支里的实验配置（campaign）、实验预注册（preregistration）和实验对账（reconciliation）为准。`,`Historical evidence comes mainly from seed3090 and openevo-webshop. The default-branch snapshot was checked on ${openEvoScientificState.checkedAt}; the latest experiment phase and GPU allocation are resolved from the campaign, preregistration, and reconciliation on the openevo-experiment branch actually in use.`)}</p>
  </figure>
</section>

<style>
  .mission-hero{width:min(1180px,calc(100% - 2rem));margin:1.2rem auto 2.5rem;display:grid;grid-template-columns:minmax(0,.9fr) minmax(460px,1.1fr);gap:1rem;align-items:stretch}.mission-hero__copy,.mission-chain{border:1px solid var(--line);border-radius:20px;background:var(--surface)}.mission-hero__copy{padding:clamp(1.4rem,3vw,2.5rem);display:flex;flex-direction:column;justify-content:center}.mission-hero__eyebrow{margin:0;color:var(--accent-deep);font-size:.72rem;font-weight:800}.mission-hero h1{margin:.55rem 0 .75rem}.mission-hero__lede{max-width:64ch;margin:0;color:var(--muted);line-height:1.7}.mission-hero__actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.1rem}.mission-status{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin:1.2rem 0 0}.mission-status div{padding:.6rem;border-top:1px solid var(--line)}.mission-status dt{color:var(--muted);font-size:.64rem}.mission-status dd{margin:.25rem 0 0;font-size:.76rem;font-weight:750}.mission-chain{margin:0;padding:1rem}.mission-chain figcaption span,.mission-chain figcaption strong{display:block}.mission-chain figcaption span{color:var(--accent-deep);font-size:.68rem;font-weight:800}.mission-chain figcaption strong{margin-top:.3rem;font-size:.84rem;line-height:1.45}.mission-chain ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}.mission-chain a{display:flex;height:100%;min-height:155px;flex-direction:column;padding:.8rem;border:1px solid var(--line);border-radius:13px;color:inherit;text-decoration:none}.mission-chain a>span{color:var(--accent-deep);font:800 .66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.mission-chain small{margin-top:auto;color:var(--muted);font-size:.62rem}.mission-chain strong{margin-top:.25rem;font-size:.82rem}.mission-chain p{margin:.4rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.4}.mission-chain .mission-history{margin:.7rem 0 0;padding:.7rem;border-top:1px solid var(--line);font-size:.7rem}.mission-hero--compact{grid-template-columns:1fr}.mission-hero--compact .mission-hero__copy{display:none}@media(max-width:920px){.mission-hero{grid-template-columns:1fr}.mission-chain ol{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.mission-hero{width:min(100% - 1rem,1180px)}.mission-chain ol,.mission-status{grid-template-columns:1fr}.mission-chain a{min-height:115px}}
</style>
