---
import { localePath, type Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const fullRunHref = localePath(locale, '/research/seed-openevo/study/capability-exploration/q17-directapply-analysis/');
const evidenceHref = '/research/seed-openevo/evidence/q17-advisor-diagnostics-20260911.json';
const sourceHref = 'https://github.com/mykcs/openevo-experiment/blob/38223bf7f07aa2c2978c8583bcfb12097e9ee052/docs/evidence/q17-advisor-diagnostics-20260911/README.md';
const replicationHref = 'https://github.com/mykcs/openevo-experiment/blob/f6fa4d05b7433685088ac59b1b488eecb42c781e/docs/evidence/q17-advisor-diagnostics-20260911/gpu2-replication-20260911/README.md';

const rows = [
  [t('WebShop 平均分', 'Average WebShop score'), '63.58', '59.41', '−4.18', t('用常见的 95% 统计范围看，真实差值可能在 −17.13 ～ +8.00；这个范围里包含“没有差别”，所以还不能确定整体真的下降。', 'The 95% uncertainty range runs from −17.13 to +8.00. It includes “no difference,” so we cannot tell whether the overall score really dropped.')],
  [t('32 题里完全做对', 'Tasks fully solved'), '10 / 32 (31.25%)', '8 / 32 (25.00%)', t('少 2 题', '2 fewer tasks'), t('用同样的 95% 统计范围看，成功率变化可能在 −18.75 ～ +6.25 个百分点之间；里面同样包含“没有差别”。', 'The same 95% uncertainty range puts the success-rate change between −18.75 and +6.25 percentage points; it also includes “no difference.”')],
  [t('32 题里拿到正奖励（部分完成也可能算）', 'Tasks with a positive reward (partial completion can count)'), '27 / 32 (84.38%)', '25 / 32 (78.13%)', t('少 2 题', '2 fewer tasks'), ''],
  [t('平均每题走几步', 'Average steps per task'), '7.41', '7.53', '+0.13', ''],
  [t('每一步平均输出长度', 'Average output length per step'), '24.49 token', '24.95 token', '+0.47 token', ''],
  [t('生成概率分散度（entropy，越低越集中）', 'Next-token probability spread (entropy; lower means more concentrated)'), '0.392', '0.343', '−0.050', t('数值越低，说明模型把概率更集中在少数选择上。', 'Lower means the model put more probability on a smaller set of choices.')],
] as const;
---

<section class="advisor-diagnostics" data-q17-advisor-diagnostics data-reader-primary aria-labelledby="advisor-diagnostics-title">
  <header class="result-hero">
    <p class="eyebrow">{t('局部诊断 · 2026-09-11', 'Local diagnostic · 2026-09-11')}</p>
    <h1 id="advisor-diagnostics-title">{t('同样 32 道题上，后一版平均分低 4.18，但还不能判定模型退步', 'On the same 32 tasks, the later state averaged 4.18 points lower, but this does not establish a regression')}</h1>
    <p class="lede">{t('原训练曲线的 76.1 → 48.9 来自不同题，不能直接横比。固定成同样 32 题后，平均分是 63.58 → 59.41，完整做对 10 题 → 8 题；原来的大跌混入了抽题差异。', 'The live 76.1 → 48.9 scores came from different tasks and are not directly comparable. On the same 32 tasks, the averages were 63.58 → 59.41 and exact solves 10 → 8, showing that task sampling contributed to the larger live-round swing.')}</p>
    <p class="result-hero__method">{t('方法背景：WebShop 是网页购物任务。第一阶段由 Qwen 自己完成任务，MiniMax 只在任务结束后回看保存的轨迹；持续学习阶段再更新参数。DirectApply 指候选参数通过工程和数据检查后直接进入下一轮。进入第 127 / 128 轮时加载的两个相邻参数状态，下面简称 R127 / R128；本页只比较这两个状态。', 'Method context: Qwen first completes WebShop tasks and MiniMax reviews saved traces only after each task; continual learning then updates parameters. DirectApply means a candidate enters the next round after engineering and data checks pass. Below, R127/R128 name the adjacent parameter states loaded when rounds 127 and 128 began; this page compares only those states.')}</p>
    <p class="result-hero__boundary"><strong>{t('点估计 −4.18 分；95% 统计范围 −17.13 ～ +8.00，包含“没有差别”。', 'Point estimate: −4.18; the 95% interval is −17.13 to +8.00 and includes no difference.')}</strong>{t('这是局部诊断，不是最终测试：32 题来自训练/开发范围、看结果前已固定，与锁定的最终 128 题不重合；不能外推到后续训练或最终结果。', 'This is a local diagnostic, not the final evaluation: the 32 tasks came from the train/development range, were frozen before results were inspected, and do not overlap with the locked final 128 tasks. The result cannot be extrapolated to later training or the final outcome.')}</p>
  </header>

  <section class="result-section" aria-label={t('相邻两个模型状态的同题结果', 'Same-task results for the two adjacent model states')}>
    <dl class="same-task-facts research-fact-band" style="--research-fact-columns:3" aria-label={t('训练曲线与同题重测的三个关键数字', 'Three key numbers from the live curve and same-task retest')}>
      <div><dt>{t('训练轮 · 题不同', 'Live rounds · different tasks')}</dt><dd>76.1 → 48.9</dd></div>
      <div><dt>{t('同样 32 题', 'Same 32 tasks')}</dt><dd>63.58 → 59.41</dd></div>
      <div><dt>{t('95% 范围 · 包含无差别', '95% interval · includes no difference')}</dt><dd>−17.13 ～ +8.00</dd></div>
    </dl>

    <div class="table-wrap" role="region" aria-label={t('R127 与 R128 同题重测结果', 'R127 versus R128 on the same tasks')} tabindex="0">
      <table>
        <thead><tr><th>{t('看什么', 'What we measured')}</th><th>R127</th><th>R128</th><th>{t('相差', 'Difference')}</th><th>{t('怎么理解', 'What it means')}</th></tr></thead>
        <tbody>{rows.map(([label, left, right, delta, note]) => <tr><th scope="row">{label}</th><td>{left}</td><td>{right}</td><td>{delta}</td><td>{note || '—'}</td></tr>)}</tbody>
      </table>
    </div>

    <dl class="transition-line">
      <div><dt>{t('两次都做对', 'Solved both times')}</dt><dd>7</dd></div>
      <div><dt>{t('R127 对，R128 错', 'R127 solved, R128 failed')}</dt><dd>3</dd></div>
      <div><dt>{t('R127 错，R128 对', 'R127 failed, R128 solved')}</dt><dd>1</dd></div>
      <div><dt>{t('两次都没做对', 'Failed both times')}</dt><dd>21</dd></div>
    </dl>

    <nav class="evidence-links" aria-label={t('这组同题诊断的实验记录', 'Experiment records for this same-task diagnostic')}>
      <a href={evidenceHref}>{t('数字摘要', 'Data summary')}</a>
      <a href={sourceHref}><ExternalBrandMark href={sourceHref} />{t('完整实验记录', 'Full experiment record')}</a>
    </nav>
  </section>

  <section class="result-section reasoning" aria-labelledby="what-it-means">
    <h2 id="what-it-means">{t('购物动作没有报错；第二个模型状态的生成概率更集中', 'Shopping actions had no execution errors; the second model state had more concentrated token probabilities')}</h2>
    <div class="reasoning-line">
      <article>
        <h3>{t('购物动作都能正常执行', 'The shopping actions still executed')}</h3>
        <p>{t('两次 32 题测试里，都没有出现动作格式坏掉、需要修复，或者动作被规则拦下的情况。正式 R127 / R128 日志里这些计数也都是 0。所以 R127 到 R128 的掉分不像是“模型本来想对了，但接口把动作弄坏了”。', 'Across both 32-task runs, there were no broken action formats, repair events, or actions rejected by the constraint. The formal R127/R128 logs also show zeros for those counts. So the drop does not look like a case where the model chose the right thing but the interface broke the action.')}</p>
      </article>
      <article>
        <h3>{t('模型的生成选择反而更集中', 'The model’s choices became more concentrated')}</h3>
        <p>{t('我们记录了模型生成下一步时，概率分在多少不同选择上（entropy）。R127 是 0.392，R128 是 0.343。数值变低，表示概率更集中，所以 R128 并不是“更拿不定主意”。它更像是更坚定地偏向了某些选择。', 'We measured how spread out the model’s probabilities were when generating the next step (entropy). R127 was 0.392 and R128 was 0.343. Lower means the probabilities were more concentrated, so R128 was not simply more unsure; it was more strongly favoring some choices.')}</p>
      </article>
    </div>
    <aside class="claim-boundary">
      <strong>{t('32 题不足以证明模型整体退步。', 'These 32 tasks do not show an overall regression.')}</strong>
      <p>{t('R128 在这 32 题上稍差：3 题从做对变成做错，1 题从做错变成做对；目前也不知道是哪一次参数更新造成了这些变化。', 'R128 was a little worse on these 32 tasks: three tasks went from solved to failed and one went the other way. We also do not know which parameter update, if any, caused those changes.')}</p>
    </aside>
  </section>

  <section class="result-section" aria-labelledby="next-question">
    <h2 id="next-question">{t('这组诊断只回答相邻两个模型状态的局部变化', 'This diagnostic only answers the local change between two adjacent model states')}</h2>
    <p>{t('这组诊断没有改变正式训练规则；DirectApply（候选更新检查通过后直接采用）后来按原先固定的实验规则完整跑完 160 轮，并单独完成了一次冻结 128 题最终测试（final）。这里仍只回答 R127→R128 的局部变化：我们没有在 R159 再跑同一套 32 题，所以不能把这组诊断外推成“后面一直如此”。最终 128 题回答的是整条 DirectApply 线最后表现怎样，不负责定位是哪一次参数更新造成了哪道题的变化。', 'This diagnostic did not change the formal treatment. DirectApply later completed all 160 rounds under the same contract and then ran one separate frozen 128-task final. This page still answers only the local R127→R128 question: we did not rerun these same 32 tasks at R159, so the pattern cannot be extrapolated through the rest of training. The final 128 tasks measure the completed DirectApply endpoint; they do not identify which individual update changed which task.')}</p>
    <p class="q17-complete-link"><a href={fullRunHref}>{t('查看 DirectApply 160 轮完整曲线与冻结 final →', 'View the full 160-round DirectApply curve and frozen final →')}</a></p>
  </section>

  <details class="method-depth">
    <summary>{t('实验细节：32 道题的来源和 entropy 记录方法', 'Experiment details: where the 32 tasks came from and how entropy was measured')}</summary>
    <div class="method-grid">
      <div><strong>{t('32 道题怎么选', 'Where the 32 tasks came from')}</strong><p>{t('它们来自训练 / 开发用的任务范围，而且在看 R127 / R128 的结果前就已经固定。它们和锁住的最终 128 题没有重合。', 'They came from the train/development task range and were frozen before we looked at the R127/R128 result. They do not overlap with the locked final 128 tasks.')}</p></div>
      <div><strong>{t('两边除了参数状态都一样', 'Everything else was held fixed')}</strong><p>{t('两边用了同样的题、同样的生成 seed、同样的 Harness201.1、Text Memory、Skill 和 Agent System。只换了进入 R127 与进入 R128 时加载的 SD-LoRA 参数。', 'Both runs used the same tasks, generation seeds, Harness201.1, Text Memory, Skill, and Agent System. The only changed model state was the SD-LoRA adapter entering R127 versus R128.')}</p></div>
      <div><strong>{t('entropy 是什么', 'What entropy means')}</strong><p>{t('模型每生成下一个 token，都会给很多候选分配概率。entropy 表示这些概率有多分散：越低越集中。这里记录的是实际动作规则已经生效后的数值。我们先用 4 道题做了“开记录 / 不开记录”的对照，输出、动作和得分 4 / 4 完全一样，所以记录 entropy 本身没有改变模型行为。', 'For every next token, the model assigns probabilities to many possible choices. Entropy measures how spread out those probabilities are: lower means more concentrated. The value here is measured after the real action rules are applied. Before the 32-task run, a four-task instrumentation on/off check reproduced outputs, actions, and scores exactly 4/4, so recording entropy did not change behavior.')}</p></div>
      <div><strong>{t('这次诊断当时没有碰最终测试', 'This diagnostic did not touch the final panel at the time')}</strong><p>{t('2026-09-11 做这 32 题诊断时，最终 128 题仍完全锁住，也没有增加正式 final 消耗或外部 teacher 调用。后来 Stage2 全部结束后，冻结的最终测试（final）才单独打开一次；这不改变本页 32 题诊断的样本和结论边界。', 'When this 32-task diagnostic ran on September 11, the final 128 tasks were still completely locked and no formal-final or external-teacher budget was consumed. The final was opened once only after Stage 2 ended; that later event does not change the sample or claim boundary of this 32-task diagnostic.')}</p></div>
      <div><strong>{t('为什么还不能怪某一次参数更新', 'Why we cannot blame one update yet')}</strong><p>{t('把 R127 变成 R128 的那次 SD-LoRA 更新，和前一轮更新方向有些相反（adjacent cosine = −0.135）。但 R120–R134 之间还有更负的更新，而且它们不都对应掉分，所以这个数值现在只能当线索。', 'The SD-LoRA update that produced the R128 state pointed somewhat against the previous update (adjacent cosine = −0.135). But there were even more negative updates between R120 and R134, and they did not all line up with score drops, so this number is only a clue for now.')}</p></div>
      <div><strong>{t('另一张 GPU 又跑了一遍', 'The result was rerun on another GPU')}</strong><p>{t('后来我们在服务器 GPU2 上把同样 32 道题完整重跑。R127、R128 的逐题结果和两两比较都与 GPU0 完全一样，所以这组结果可以重复得到；但样本仍然只有这 32 题，结论边界没有变。', 'We later reran the same 32 tasks on server GPU2. Every R127 row, R128 row, and paired comparison matched the GPU0 run exactly. That shows the result is reproducible, but it is still the same 32-task sample, so the claim boundary does not change.')} <a href={replicationHref}><ExternalBrandMark href={replicationHref} />{t('查看复跑记录', 'View the replication record')}</a></p></div>
    </div>
  </details>
</section>
<style>
.advisor-diagnostics{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--ink)}
.result-hero{box-sizing:border-box;padding:1rem 0 1.1rem;border-bottom:1px solid var(--line)}
.eyebrow{margin:0 0 .45rem;font:800 .78rem/1.25 var(--font-mono);letter-spacing:.045em;color:var(--accent-deep)}
.result-hero h1{max-width:980px;margin:0;font-size:clamp(2.05rem,4vw,3.55rem);line-height:.99;letter-spacing:-.055em}
.lede{max-width:900px;margin:.45rem 0 0;color:var(--ink);font-size:.98rem;line-height:1.5}.result-hero__method{max-width:860px;margin:.4rem 0 0;color:var(--muted);font-size:.86rem;line-height:1.48}.result-hero__boundary{max-width:900px;margin:.5rem 0 0;padding:.5rem 0 .5rem .8rem;border-left:3px solid var(--accent-deep);color:var(--muted);font-size:.87rem;line-height:1.45}.result-hero__boundary strong{color:var(--ink)}
.evidence-links{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.15rem}.evidence-links a,.q17-complete-link a{border-bottom:1px solid var(--line);padding:.35rem 0;color:var(--accent-deep);text-decoration:none;margin-right:1rem}.q17-complete-link{margin-top:.9rem}
.result-section{padding:2.8rem 0;border-bottom:1px solid var(--line)}.result-section h2{max-width:900px;margin:0 0 1rem;font-size:clamp(1.65rem,3.2vw,2.8rem);line-height:1.08;letter-spacing:-.045em}.result-section>p,.reasoning-line p,.claim-boundary p,.method-grid p{max-width:900px;color:var(--muted);line-height:1.65}
.table-wrap{overflow-x:auto;margin-top:1.5rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}table{width:100%;border-collapse:collapse;min-width:760px}th,td{padding:.85rem .7rem;text-align:left;border-bottom:1px solid color-mix(in srgb,var(--line) 75%,transparent);vertical-align:top}thead th{font-size:.8rem;color:var(--muted);letter-spacing:.04em}tbody th{font-weight:700}td:nth-child(2),td:nth-child(3),td:nth-child(4){font-family:var(--font-mono);font-weight:700}
.transition-line{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:1.5rem 0 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.transition-line div{padding:1rem;border-right:1px solid var(--line)}.transition-line div:last-child{border-right:0}.transition-line dt{color:var(--muted);font-size:.88rem}.transition-line dd{margin:.3rem 0 0;font:850 1.8rem/1 var(--font-mono)}
.reasoning-line{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;margin-top:1.5rem}.reasoning-line article{padding-top:1rem;border-top:2px solid var(--accent-deep)}.reasoning-line h3{margin:0;font-size:1.25rem}.claim-boundary{margin-top:1.8rem;padding:1rem 0 0;border-top:1px solid var(--warning)}.claim-boundary strong{font-size:1.05rem}.claim-boundary p{margin:.55rem 0 0}
.method-depth{margin-top:2rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:1rem 0}.method-depth summary{cursor:pointer;font-weight:750;color:var(--accent-deep)}.method-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem 2rem;padding:1.2rem 0 .4rem}.method-grid p{margin:.35rem 0 0;font-size:.94rem}
.same-task-facts{margin-top:1.25rem}
@media(max-width:820px){.result-hero{padding-top:1.15rem}.result-hero h1{font-size:clamp(1.95rem,8.4vw,2.8rem);line-height:1.02}.reasoning-line,.method-grid,.transition-line{grid-template-columns:1fr}.transition-line div{border-right:0;border-bottom:1px solid var(--line)}.transition-line div:last-child{border-bottom:0}.table-wrap{overflow:visible}.table-wrap table{display:block;min-width:0}.table-wrap thead{display:none}.table-wrap tbody{display:grid;gap:.8rem}.table-wrap tr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:.75rem 0;border-bottom:1px solid var(--line)}.table-wrap th,.table-wrap td{display:block;padding:.2rem .35rem;border:0}.table-wrap th[scope="row"]{grid-column:1/-1;padding-bottom:.45rem;font-size:.9rem}.table-wrap td:nth-child(2)::before{content:'R127 · ';color:var(--muted);font-family:var(--font-interface);font-size:.7rem}.table-wrap td:nth-child(3)::before{content:'R128 · ';color:var(--muted);font-family:var(--font-interface);font-size:.7rem}.table-wrap td:nth-child(4)::before{content:'Δ · ';color:var(--muted);font-family:var(--font-interface);font-size:.7rem}.table-wrap td:nth-child(5){grid-column:1/-1;margin-top:.35rem;padding-top:.5rem;border-top:1px solid color-mix(in srgb,var(--line) 70%,transparent);color:var(--muted);font-family:var(--font-interface);font-weight:400}.table-wrap td:nth-child(5):empty{display:none}}
</style>
