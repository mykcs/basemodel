            <tr><td>R1–R159 exact success</td><td>{(finalResult.exactSuccess.off * 100).toFixed(2)}%</td><td>{(finalResult.exactSuccess.on * 100).toFixed(2)}%</td><td>{(finalResult.exactSuccess.delta * 100).toFixed(2)} pp</td></tr>
            <tr><td>95% moving-block bootstrap CI</td><td colspan="2">{finalResult.uncertainty.low.toFixed(4)} → +{finalResult.uncertainty.high.toFixed(4)}</td><td>{t('跨 0', 'crosses 0')}</td></tr>
          </tbody>
