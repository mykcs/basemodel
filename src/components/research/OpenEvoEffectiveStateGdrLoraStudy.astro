---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import MathFormula from '../common/MathFormula.astro';
import WandbEvidencePanel from './WandbEvidencePanel.astro';
import { EFFECTIVE_STATE_GDR_LORA_STUDY as study } from '../../data/effectiveStateGdrLoraStudy';
import type { EffectiveStateFormalResult } from '../../data/effectiveStateGdrLoraStudy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const cap = '/research/seed-openevo/study/capability-exploration';
const directApplyHref = p(`${cap}/q17-directapply-analysis/`);
const boundedHref = p(`${cap}/sd-lora-bounded-state/`);
const gatedHref = p(`${cap}/gated-delta-sd-lora/`);
const scalingHref = p(`${cap}/sd-lora-scaling/`);
const gdrPaperHref = 'https://arxiv.org/abs/2412.06464';

const wandbReportUrl = 'https://wandb.ai/zju-openevo-wangrui/zju-openevo-experiments/reports/OpenEVO-1.7B-%C2%B7-%E4%B8%89%E7%BB%84%E5%AE%9E%E9%AA%8C%E5%88%86%E6%9E%90--VmlldzoxNzk2ODUyMg==';
const wandbWorkspaceUrl = study.posthocAnalysis.wandbWorkspace;
const panelHref = (panelDisplayName: string, panelSectionName: string) => {
  const join = wandbWorkspaceUrl.includes('?') ? '&' : '?';
  return `${wandbWorkspaceUrl}${join}panelDisplayName=${encodeURIComponent(panelDisplayName)}&panelSectionName=${encodeURIComponent(panelSectionName)}`;
};
const wandbPanels = [
  { label: t('Task Score 原生曲线', 'Native Task Score panel'), href: panelHref('Task Score', '01 Overview · 三条路线') },
  { label: t('Task Vector · Frobenius', 'Task Vector · Frobenius'), href: panelHref('Task Vector · Frobenius', '01 Overview · 三条路线') },
  { label: t('ON/OFF 更新方向 cosine', 'ON/OFF update-direction cosine'), href: panelHref('ON/OFF 更新方向 cosine', '05 方向与幅度') },
  { label: t('每一步输出长度', 'Output tokens per step'), href: panelHref('每一步输出长度', '06 输出长度与任务路径') },
];
const wandbSnapshots = [
  { title: t('Task Score · 160轮', 'Task Score · 160 rounds'), src: '/research/seed-openevo/evidence/wandb-threeway/task-score.svg', href: panelHref('Task Score', '01 Overview · 三条路线'), alt: t('三组 OpenEVO 的 160 轮 WebShop Task Score 静态曲线', 'Static 160-round WebShop Task Score curves for the three OpenEVO methods') },
  { title: 'Task Vector · Frobenius', src: '/research/seed-openevo/evidence/wandb-threeway/task-vector-frobenius.svg', href: panelHref('Task Vector · Frobenius', '01 Overview · 三条路线'), alt: t('三组实验的 Task Vector Frobenius norm 静态曲线', 'Static Task Vector Frobenius norm curves for the three experiments') },
  { title: t('平均任务步数', 'Steps per episode'), src: '/research/seed-openevo/evidence/wandb-threeway/steps-per-episode.svg', href: panelHref('每个 Episode 的步骤数', '06 输出长度与任务路径'), alt: t('三组实验每个 episode 的平均任务步数静态曲线', 'Static steps-per-episode curves for the three experiments') },
];
const math = {
  history: String.raw`W_t = W_0 + \sum_{i=1}^{t} \Delta W_i`,
  bounded: String.raw`S_t = \operatorname{Compress}_{128}\!\left(S_{t-1}+\Delta_t\right)`,
  gdr: String.raw`S_t = \alpha_t S_{t-1}\left(I-\beta_t k_t k_t^{\top}\right)+\beta_t v_t k_t^{\top}`,
  residual: String.raw`\begin{aligned}\widetilde S_{t-1} &= \alpha_t S_{t-1} \\ r_t &= v_t-\widetilde S_{t-1}k_t \\ S_t &= \widetilde S_{t-1}+\beta_t r_t k_t^{\top}\end{aligned}`,
  gauge: String.raw`\Delta W = C A^{\top},\qquad A\mapsto sA,\quad C\mapsto C/s\quad\Longrightarrow\quad \Delta W\;\text{unchanged}`,
  beta: String.raw`\beta_t=f_{\theta}(x_t),\qquad x_t\in\mathbb{R}^{${study.posthocAnalysis.gdr.betaControllerFeatures}}`,
  effective: String.raw`S_t^{\mathrm{GDR}}=\operatorname{Compress}_{128}\!\left(S_{t-1}+\operatorname{Gate}_{\beta_t}(\Delta_t)\right)`,
};

const result = study.formalResult as EffectiveStateFormalResult;
const finalResult = result.status === 'sealed' ? result : null;

const names = {
  baseline: t('普通 OpenEVO', 'OpenEVO'),
  bounded: t('OpenEVO + Bounded Online Recurrence', 'OpenEVO + Bounded Online Recurrence'),
  gdr: t('OpenEVO + Bounded Online Recurrence + GDR', 'OpenEVO + Bounded Online Recurrence + GDR'),
};

const scoreChart = { left: 44, right: 716, top: 18, bottom: 238, maxRound: 159, maxScore: 100 };
const sx = (round: number) => scoreChart.left + (round / scoreChart.maxRound) * (scoreChart.right - scoreChart.left);
const sy = (score: number) => scoreChart.bottom - (score / scoreChart.maxScore) * (scoreChart.bottom - scoreChart.top);
const moving = (rows: readonly { round: number; score: number }[]) => rows.map((point, index) => {
  const window = rows.slice(Math.max(0, index - 11), index + 1);
  return { round: point.round, score: window.reduce((sum, row) => sum + row.score, 0) / window.length };
});
const points = (rows: readonly { round: number; score: number }[]) =>
  rows.map((d) => `${sx(d.round).toFixed(1)},${sy(d.score).toFixed(1)}`).join(' ');
const offScoreRaw = finalResult ? points(finalResult.trajectory.off) : '';
const onScoreRaw = finalResult ? points(finalResult.trajectory.on) : '';
const offScoreTrend = finalResult ? points(moving(finalResult.trajectory.off)) : '';
const onScoreTrend = finalResult ? points(moving(finalResult.trajectory.on)) : '';
---

<article class="paper" data-effective-state-gdr-page data-copy-review data-reader-page="research-explainer">
  <header class="paper__hero esg__hero" data-reader-context id="top">
    <p class="paper__kicker">Qwen3-1.7B · WebShop · 160 {t('轮', 'rounds')}</p>
    <h1>{t('三个 OpenEVO 实验', 'Three OpenEVO experiments')}</h1>

    <div class="paper-table-wrap paper-table-wrap--hero" aria-label={t('三组实验消融表', 'Three-experiment ablation table')}>
      <table class="paper-table paper-table--ablation">
        <thead>
          <tr>
            <th>{t('实验', 'Experiment')}</th>
            <th>Bounded Online Recurrence</th>
            <th>GDR</th>
            <th>Task Score</th>
            <th>{t('完整做对', 'Exact success')}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>{names.baseline}</strong></td>
            <td class="paper-table__mark">—</td>
            <td class="paper-table__mark">—</td>
            <td><strong>{study.threeWayFinal.directApply.score.toFixed(2)}</strong></td>
            <td>{study.threeWayFinal.directApply.exactCount}/128</td>
          </tr>
          <tr>
            <td><strong>{names.bounded}</strong></td>
            <td class="paper-table__mark" aria-label={t('使用', 'enabled')}>✓</td>
            <td class="paper-table__mark">—</td>
            <td><strong>{study.threeWayFinal.off.score.toFixed(2)}</strong></td>
            <td>{study.threeWayFinal.off.exactCount}/128</td>
          </tr>
          <tr>
            <td><strong>{names.gdr}</strong></td>
            <td class="paper-table__mark" aria-label={t('使用', 'enabled')}>✓</td>
            <td class="paper-table__mark" aria-label={t('使用', 'enabled')}>✓</td>
            <td><strong>{study.threeWayFinal.on.score.toFixed(2)}</strong></td>
            <td>{study.threeWayFinal.on.exactCount}/128</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="paper__lede esg__lede" data-reader-task data-reader-purpose>{t(
      '普通 OpenEVO 暴露出 SD-LoRA 历史越积越多、参数更新越来越慢的问题；Bounded Online Recurrence 把历史压成固定大小的参数 State，GDR 再控制新经验写入。三组最终模型都做了同一份冻结 128 题。',
      'Ordinary OpenEVO exposes a growing SD-LoRA history and increasingly expensive parameter updates. Bounded Online Recurrence compresses the history into a fixed-size parameter State, and GDR then controls new writes. All three final models use the same frozen 128-task panel.',
    )}</p>
    <p class="paper__boundary">{t(
      '三次冻结终评使用完全相同的 128 题，所以可以并排看。真正属于同一次预注册正式对照的是后两组；普通 OpenEVO 是更早独立完成的实验，不能把三行都当成同一次三组对照。',
      'The three finals use the exact same frozen panel and can be shown side by side descriptively. The last two rows form the matched formal campaign; ordinary OpenEVO is an earlier independent run, not a third arm of the preregistered matched contrast between the latter two rows.',
    )}</p>
  </header>

  <section class="paper__section" id="motivation" aria-labelledby="motivation-title">
    <p class="paper__section-number">1</p>
    <h2 id="motivation-title">{t('动机：SD-LoRA 越训练越慢', 'Motivation: SD-LoRA gets slower as history grows')}</h2>
    <p>{t(
      '普通 OpenEVO 的参数通道会把过去每一轮的 SD-LoRA component 留在后续模型里。这样做保留了历史，但 component 数量会跟轮数一起增长；到了后期，每一轮训练都要反复经过越来越多的低秩路径。',
      'Ordinary OpenEVO carries each historical SD-LoRA component into later model states. This preserves history, but the number of components grows with rounds, so late training repeatedly traverses more low-rank paths.',
    )}</p>
    <MathFormula latex={math.history} label={t('普通 OpenEVO 的累计参数历史', 'Accumulating parameter history in ordinary OpenEVO')} />
    <p class="paper__math-caption">{t('历史 component 随 t 增长。', 'Historical components grow with t.')}</p>
    <p>{t(
      `这不是一个小的实现常数：普通 OpenEVO 的 159 次 SD-LoRA trainer 累计约 ${study.timingComparison.directApply.trainerHours.toFixed(2)} 小时。我们因此先问一个更基础的问题：能不能把“越来越长的历史”折成一个固定大小的参数状态，同时继续学习下一轮？`,
      `This is not a small implementation constant: the 159 SD-LoRA trainer updates in ordinary OpenEVO total about ${study.timingComparison.directApply.trainerHours.toFixed(2)} hours. We therefore ask a more basic question: can the growing history be folded into a fixed-size parameter state while learning continues?`,
    )}</p>
    <p class="paper__links"><a href={scalingHref}>{t('SD-LoRA 计算扩展性证据 →', 'SD-LoRA scaling evidence →')}</a></p>
  </section>

  <section class="paper__section" id="method" aria-labelledby="method-title">
    <p class="paper__section-number">2</p>
    <h2 id="method-title">{t('方法：Bounded Online Recurrence 与 GDR', 'Method: Bounded Online Recurrence and GDR')}</h2>

    <h3>2.1 {t('Bounded Online Recurrence：把无限增长的历史压成固定 rank128 State', 'Bounded Online Recurrence: compress growing history into a fixed rank128 State')}</h3>
    <p>{t(
      '每一轮仍然先得到一个 rank8 的当前更新 Δt，但不再把所有旧 component 永久并排保存。我们把“上一轮的 rank128 状态 + 当前更新”重新压回 rank128，作为下一轮唯一的参数历史。',
      'Each round still produces a rank-8 current update Δt, but old components are no longer kept side by side forever. The previous rank-128 state plus the current update is compressed back to rank128 and becomes the only parameter history for the next round.',
    )}</p>
    <MathFormula latex={math.bounded} label={t('Bounded Online Recurrence 的状态更新', 'Bounded Online Recurrence state update')} />
    <p class="paper__math-caption"><span class="paper__math-symbol">Sₜ₋₁</span> = {t('历史参数 State', 'historical parameter State')} · <span class="paper__math-symbol">Δₜ</span> = {t('当前轮 rank8 更新', 'current rank-8 update')}</p>
    <p>{t(
      `这样，参数历史的物理 rank 不再随轮数增长。工程上，Bounded Online Recurrence 的参数 transition 累计约 ${study.timingComparison.off.transitionHours.toFixed(2)} 小时，而普通 OpenEVO 的 trainer 累计约 ${study.timingComparison.directApply.trainerHours.toFixed(2)} 小时。`,
      `The physical rank of parameter history no longer grows with rounds. In this implementation, Bounded Online Recurrence totals about ${study.timingComparison.off.transitionHours.toFixed(2)} hours of parameter transition time, versus ${study.timingComparison.directApply.trainerHours.toFixed(2)} trainer hours for ordinary OpenEVO.`,
    )}</p>

    <h3>2.2 {t('GDR：从 linear attention 的“记忆写入”借一个规则', 'GDR: borrow a memory-write rule from linear attention')}</h3>
    <p>{t(
      'Gated Delta Rule 的核心不是“线性 attention 更快”这件事，而是它怎样更新一个持续存在的 State：先保留或衰减旧 State，再读出已有内容，最后只把没有解释掉的 residual 按 β 写回。',
      'The useful idea from the Gated Delta Rule is not simply that linear attention is fast. It is the recurrent state update: retain or decay the old state, read what is already stored, then write back only the unexplained residual with strength β.',
    )}</p>
    <MathFormula latex={math.gdr} label={t('Gated Delta Rule 原始状态更新公式', 'Original Gated Delta Rule state update')} />
    <p class="paper__math-caption">{t('论文原式：α 控制旧 State 的保留 / 衰减，β 控制 delta write 的强度。', 'Paper form: α controls retention / decay of the old State, while β controls delta-write strength.')}</p>
    <p>{t(
      '把论文原式按 residual 展开，会得到下面完全等价、也更容易和我们的参数写入过程对照的形式。这里 State 的约定是 dᵥ × dₖ，所以 residual 必须放在左边：rₜkₜᵀ，而不是 kₜrₜᵀ。',
      'Rewriting the paper equation in residual form gives the exactly equivalent expression below, which is easier to compare with our parameter-write process. Under the paper’s d_v × d_k State convention, the residual is on the left: r_t k_t^T, not k_t r_t^T.',
    )}</p>
    <MathFormula latex={math.residual} label={t('Gated Delta Rule 的等价 residual 形式', 'Equivalent residual form of the Gated Delta Rule')} />
    <p class="paper__links"><a href={gdrPaperHref} target="_blank" rel="noreferrer"><ExternalBrandMark href={gdrPaperHref} />Gated Delta Networks · ICLR 2025</a> · <a href={gatedHref}>{t('我们前一版 Gated-Delta 推导 →', 'Our earlier Gated-Delta derivation →')}</a></p>

    <h3>2.3 {t('从 sequence State 映射到 OpenEVO 的参数 State', 'Mapping sequence State to OpenEVO parameter State')}</h3>
    <p>{t(
      '我们没有把 linear attention 的 k、v 张量硬塞进 LoRA。保留的是“持续状态 + residual write + 自适应写入强度”这层数学角色，再逐个决定 OpenEVO 里谁来承担这些角色。',
      'We do not literally insert linear-attention k and v tensors into LoRA. We preserve the mathematical roles—persistent state, residual write, and adaptive write strength—and then identify which OpenEVO objects play those roles.',
    )}</p>
    <div class="paper-table-wrap">
      <table class="paper-table paper-table--mapping">
        <thead><tr><th>{t('Gated Delta 里的对象', 'Gated Delta object')}</th><th>{t('在我们这里对应什么', 'OpenEVO counterpart')}</th><th>{t('本版选择', 'Choice')}</th></tr></thead>
        <tbody>
          <tr><td>State S</td><td>{t('固定 rank128 的长期参数状态', 'fixed-rank128 long-term parameter state')}</td><td>{t('跨轮保留', 'persistent across rounds')}</td></tr>
          <tr><td>residual write</td><td>{t('当前训练真正想写进 LoRA 的有效更新', 'effective LoRA write proposed by current training')}</td><td>{t('由 AdamW / LoRA 当前更新产生', 'from the current AdamW / LoRA update')}</td></tr>
          <tr><td>β</td><td>{t('这一小步允许写多强', 'how strongly this step may write')}</td><td>{t('本实验真正启用的动态控制量', 'the dynamic control actually enabled in this study')}</td></tr>
          <tr><td>α / g</td><td>{t('旧参数状态保留多少', 'how much prior state is retained')}</td><td>{t('本实验固定 g = 0，因此 α = 1：不额外衰减旧 State', 'this study fixes g = 0, hence α = 1: no extra decay of the prior State')}</td></tr>
          <tr><td>k / v</td><td>{t('保留“读旧状态 / 写 residual”的语义', 'retain the read-state / residual-write semantics')}</td><td>{t('不把 sequence 张量逐字映射成参数张量', 'not a literal tensor-to-tensor mapping')}</td></tr>
        </tbody>
      </table>
    </div>

    <p>{t(
      '因此，我们并不是把完整的 Gated DeltaNet 原封不动搬到参数空间。第一版正式实验保留“长期 State + residual write + 动态 β”这三件事，但把 α 固定为 1；这让实验只回答“控制新经验写入强度有没有帮助”，而不同时引入“主动遗忘旧参数状态”这个第二变量。',
      'We therefore do not transplant the full Gated DeltaNet into parameter space. The first formal study keeps persistent State, residual write, and dynamic β, while fixing α=1. This isolates the question of controlling new-write strength without simultaneously introducing active forgetting of the old parameter State.',
    )}</p>

    <h3>2.4 {t('为什么不能直接在 LoRA 的 A / C 因子上做约束', 'Why the gate cannot operate directly on raw LoRA factors')}</h3>
    <p>{t(
      '同一个 LoRA 有效更新可以用很多组 A / C 数值表示。只要 A 乘 s、C 除以 s，真正加到模型上的矩阵完全不变。也就是说，A / C 的数值大小带着“坐标选择”，不是我们真正想控制的学习量。',
      'The same effective LoRA update can be represented by many A/C factor values. Multiplying A by s and dividing C by s leaves the actual matrix update unchanged, so raw factor magnitudes contain coordinate choice rather than only learning content.',
    )}</p>
    <MathFormula latex={math.gauge} label={t('LoRA 因子缩放不改变有效更新', 'LoRA factor rescaling leaves the effective update unchanged')} />
    <p>{t(
      `这也是为什么第一版“直接控制 LoRA 因子”的映射会失败：空历史起点的 C 侧检查给出 β=${study.derivation.firstGenerationFactorFailure.betaC.toFixed(3)}，已经跑出合法区间；只修映射但继续沿用旧 β 控制器时，真实轨迹上甚至得到 β_eff=${study.derivation.mappingOnlyControllerFailure.betaEffective.toFixed(3)}。所以最终方法控制的是不受 LoRA 因子缩放方式影响的有效参数写入 ΔW，而不是 A / C 因子本身的位移。`,
      `This is why the first factor-space mapping failed: at the empty-history start, the C-side check produced β=${study.derivation.firstGenerationFactorFailure.betaC.toFixed(3)}, outside the legal range; after fixing only the mapping but keeping the old controller, the real trajectory produced β_eff=${study.derivation.mappingOnlyControllerFailure.betaEffective.toFixed(3)}. The final treatment therefore controls a gauge-invariant effective write rather than raw A/C displacement.`,
    )}</p>
    <MathFormula latex={math.beta} label={t('动态 beta 控制器', 'Dynamic beta controller')} compact />
    <p class="paper__math-caption">{t('冻结 controller · 只看局部参数 / 梯度 / Adam 状态，不看 reward、Task Score、Task Vector。', 'Frozen controller · local parameter / gradient / Adam state only; no reward, Task Score, or Task Vector.')}</p>
    <MathFormula latex={math.effective} label={t('GDR 映射到参数 State 后的概念式', 'Conceptual GDR update after mapping to parameter State')} compact />
    <p class="paper__math-caption">{t('这是参数空间里的概念式；实际 runtime 先写 C 得到真实 C1，再基于 C1 写 A。', 'Conceptual parameter-space form; runtime writes C first to obtain the actual C1, then writes A conditioned on C1.')}</p>
  </section>

  <section class="paper__section" id="formal-design" aria-labelledby="experiment-title">
    <p class="paper__section-number">3</p>
    <h2 id="experiment-title">{t('实验设置：Qwen3-1.7B × WebShop', 'Experiments: Qwen3-1.7B × WebShop')}</h2>
    <p>{t(
      '三条线都属于这批 Qwen3-1.7B OpenEVO 实验。Stage 2 都跑 160 轮；Bounded Online Recurrence 与 Bounded Online Recurrence + GDR 是正式匹配对照，每轮 128 个 rollout，任务、seed、sampling、horizon、replay 和 optimizer recipe 对齐。',
      'All three lines belong to this Qwen3-1.7B OpenEVO study family. Stage 2 runs for 160 rounds. Bounded Online Recurrence and Bounded Online Recurrence + GDR form the formal matched pair with 128 rollouts per round and matched tasks, seeds, sampling, horizon, replay, and optimizer recipe.',
    )}</p>
    <dl class="paper__setup">
      <div><dt>{t('模型', 'Model')}</dt><dd>Qwen3-1.7B</dd></div>
      <div><dt>{t('环境', 'Environment')}</dt><dd>WebShop</dd></div>
      <div><dt>Stage 2</dt><dd>160 × 128 = 每组 20,480 次任务尝试</dd></div>
      <div><dt>{t('历史状态', 'History state')}</dt><dd>rank128 Bounded State</dd></div>
      <div><dt>{t('当前参数更新', 'Current update')}</dt><dd>rank8 SD-LoRA</dd></div>
      <div><dt>{t('冻结终评', 'Frozen final')}</dt><dd>128 tasks</dd></div>
    </dl>
    <p>{t(
      `这批 1.7B OpenEVO 的 Stage 2 起点来自 Stage 1 的 OPSD 参数学习；Qwen3-1.7B 的 Stage 1 OPSD 实际记录为 ${study.posthocAnalysis.stage1.qwen3OneP7bOpsdOptimizerSteps.toLocaleString('en-US')} 个优化器更新步。它不是 SEED 的 hindsight-skill SFT，所以这三组实验本身不能回答“SFT 起点和 OPSD 起点谁更好”。`,
      `The Stage-2 origin for this 1.7B OpenEVO lineage comes from the Stage-1 OPSD parameter bootstrap, which records ${study.posthocAnalysis.stage1.qwen3OneP7bOpsdOptimizerSteps.toLocaleString('en-US')} optimizer steps for Qwen3-1.7B. This is not SEED hindsight-skill SFT, so these three runs do not answer whether SFT or OPSD is the better warm start.`,
    )}</p>
  </section>

  <section class="paper__section esg__results" id="formal-result" aria-labelledby="result-title">
    <p class="paper__section-number">4</p>
    <h2 id="result-title">{t('结果：Bounded 把参数训练变快了，但最终分数下降；再加 GDR 下降更多', 'Results: Bounded speeds parameter training, but final score drops; adding GDR drops further')}</h2>

    <h3>4.1 {t('同一冻结 128 题的最终结果', 'Final results on the same frozen 128 tasks')}</h3>
    <p>{t(
      `普通 OpenEVO 是 ${study.threeWayFinal.directApply.score.toFixed(2)} / 100，Bounded Online Recurrence 是 ${study.threeWayFinal.off.score.toFixed(2)}，Bounded Online Recurrence + GDR 是 ${study.threeWayFinal.on.score.toFixed(2)}。完整做对分别是 ${study.threeWayFinal.directApply.exactCount}、${study.threeWayFinal.off.exactCount}、${study.threeWayFinal.on.exactCount} / 128。`,
      `Ordinary OpenEVO scores ${study.threeWayFinal.directApply.score.toFixed(2)} / 100, Bounded Online Recurrence ${study.threeWayFinal.off.score.toFixed(2)}, and Bounded Online Recurrence + GDR ${study.threeWayFinal.on.score.toFixed(2)}. Exact successes are ${study.threeWayFinal.directApply.exactCount}, ${study.threeWayFinal.off.exactCount}, and ${study.threeWayFinal.on.exactCount} / 128.`,
    )}</p>

    {finalResult ? (
      <>
        <h3>4.2 {t('训练过程里，GDR 只有短暂优势，没有形成稳定长期优势', 'During training, GDR shows only a transient advantage, not a stable long-horizon one')}</h3>
        <div class="paper__trajectory">
          <figure>
            <figcaption><strong>{t('每轮 WebShop Score', 'WebShop Score by round')}</strong><span>{t('细线=原始轮次 · 粗线=12轮移动平均', 'thin=raw · thick=12-round moving average')}</span></figcaption>
            <svg viewBox="0 0 760 270" role="img" aria-label={t('Bounded Online Recurrence 与 +GDR 的 R0 到 R159 WebShop Score', 'Bounded Online Recurrence and +GDR WebShop Score from R0 to R159')}>
              <line x1="44" y1="238" x2="716" y2="238" class="axis"/><line x1="44" y1="128" x2="716" y2="128" class="grid"/><line x1="44" y1="18" x2="716" y2="18" class="grid"/>
              <text x="18" y="242">0</text><text x="12" y="132">50</text><text x="12" y="22">100</text><text x="44" y="260">R0</text><text x="365" y="260">R80</text><text x="684" y="260">R159</text>
              <polyline points={offScoreRaw} class="score-raw bounded"/><polyline points={onScoreRaw} class="score-raw gdr"/>
              <polyline points={offScoreTrend} class="score-trend bounded"/><polyline points={onScoreTrend} class="score-trend gdr"/>
            </svg>
            <div class="paper__legend"><span><i class="bounded"></i>{names.bounded}</span><span><i class="gdr"></i>{names.gdr}</span></div>
          </figure>
        </div>
        <div class="paper-table-wrap">
          <table class="paper-table">
            <thead><tr><th>{t('正式指标', 'Formal metric')}</th><th>{names.bounded}</th><th>{names.gdr}</th><th>{t('差值', 'Delta')}</th></tr></thead>
            <tbody>
              <tr><td>R1–R159 mean reward</td><td>{finalResult.pooledReward.off.toFixed(4)}</td><td>{finalResult.pooledReward.on.toFixed(4)}</td><td>+{finalResult.pooledReward.delta.toFixed(4)}</td></tr>
              <tr><td>R1–R159 exact success</td><td>{(finalResult.exactSuccess.off * 100).toFixed(2)}%</td><td>{(finalResult.exactSuccess.on * 100).toFixed(2)}%</td><td>{(finalResult.exactSuccess.delta * 100).toFixed(2)} pp</td></tr>
              <tr><td>95% moving-block bootstrap CI</td><td colspan="2">{finalResult.uncertainty.low.toFixed(4)} → +{finalResult.uncertainty.high.toFixed(4)}</td><td>{t('跨 0', 'crosses 0')}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="paper__boundary">{t(
          '所以训练期平均 reward 的 +0.025 只能说明中间出现过一段正向信号；置信区间跨 0，完整成功率还更低。按预注册规则，这只能算“短暂信号，没有形成长期稳定优势”（内部分类码：LONG_HORIZON_TRANSIENT_ONLY）。',
          'The +0.025 mean-reward difference shows a transient positive signal only; the interval crosses zero and exact success is lower. The preregistered classification is LONG_HORIZON_TRANSIENT_ONLY, not a stable long-horizon GDR win.',
        )}</p>
      </>
    ) : <p>{t('正式结果尚未封存。', 'Formal result is not sealed.')}</p>}

    <div id="compute">
      <h3>4.3 {t('计算代价：真正的大幅加速发生在参数更新阶段', 'Compute: the large speedup is in parameter updates')}</h3>
      <div class="paper-table-wrap">
        <table class="paper-table">
          <thead><tr><th>{t('时间口径', 'Timing')}</th><th>{names.baseline}</th><th>{names.bounded}</th><th>{names.gdr}</th></tr></thead>
          <tbody>
            <tr><td>{t('参数 trainer / transition 累计', 'parameter trainer / transition total')}</td><td>{study.timingComparison.directApply.trainerHours.toFixed(2)} h</td><td>{study.timingComparison.off.transitionHours.toFixed(2)} h</td><td>{study.timingComparison.on.transitionHours.toFixed(2)} h</td></tr>
            <tr><td>{t('相对普通 OpenEVO', 'relative to ordinary OpenEVO')}</td><td>1×</td><td>{(study.timingComparison.directApply.trainerHours / study.timingComparison.off.transitionHours).toFixed(1)}×</td><td>{(study.timingComparison.directApply.trainerHours / study.timingComparison.on.transitionHours).toFixed(1)}×</td></tr>
            <tr><td>Stage2 wall clock</td><td>{study.timingComparison.directApply.wallClockHours.toFixed(2)} h</td><td>{study.timingComparison.off.wallClockHours.toFixed(2)} h</td><td>{study.timingComparison.on.wallClockHours.toFixed(2)} h</td></tr>
          </tbody>
        </table>
      </div>
      <p class="paper__boundary">{t('13–15× 是参数更新阶段的工程加速，不是整个 Stage2 同倍数加速。', 'The 13–15× figure is an engineering speedup for parameter updates, not the whole Stage2 run.')}</p>
    </div>
  </section>

  <section class="paper__section" id="analysis" aria-labelledby="analysis-title">
    <p class="paper__section-number">5</p>
    <h2 id="analysis-title">{t('Analysis：为什么 GDR 后期会掉下来？', 'Analysis: why does the GDR line fall late?')}</h2>

    <div id="parameters">
      <h3>5.1 {t('Task Vector、范数和谱：没有一个指标能直接解释分数', 'Task Vector, norms, and spectra: no single metric directly explains score')}</h3>
      <p>{t(
        `普通 OpenEVO 里，直接算相关性时，state Frobenius 和 Task Score 的 Spearman ρ=${study.posthocAnalysis.parameterScore.stateFroSpearmanRaw.toFixed(2)}，Task Vector Frobenius 也有 ρ=${study.posthocAnalysis.parameterScore.taskVectorSpearmanRaw.toFixed(2)}。但把每 20 轮里共同的“越训越后”趋势去掉后，相关分别只剩 ${study.posthocAnalysis.parameterScore.stateFroWithin20Pearson.toFixed(3)} 和 +${study.posthocAnalysis.parameterScore.taskVectorWithin20Pearson.toFixed(3)}。`,
        `In ordinary OpenEVO, raw correlations look substantial: state Frobenius vs Task Score has Spearman ρ=${study.posthocAnalysis.parameterScore.stateFroSpearmanRaw.toFixed(2)}, and Task Vector Frobenius reaches ρ=${study.posthocAnalysis.parameterScore.taskVectorSpearmanRaw.toFixed(2)}. After removing the common within-20-round training trend, the correlations shrink to ${study.posthocAnalysis.parameterScore.stateFroWithin20Pearson.toFixed(3)} and +${study.posthocAnalysis.parameterScore.taskVectorWithin20Pearson.toFixed(3)}.`,
      )}</p>
      <p>{t(
        `用当前 Task Vector 预测后 5 轮分数时，95% block-bootstrap 区间仍是 ${study.posthocAnalysis.parameterScore.taskVectorFuture5Ci95[0].toFixed(3)} → +${study.posthocAnalysis.parameterScore.taskVectorFuture5Ci95[1].toFixed(3)}，跨过 0。现在不能说“Task Vector / norm 越大，WebShop 就越好”。`,
        `For a five-round-ahead prediction from the current Task Vector, the 95% block-bootstrap interval remains ${study.posthocAnalysis.parameterScore.taskVectorFuture5Ci95[0].toFixed(3)} → +${study.posthocAnalysis.parameterScore.taskVectorFuture5Ci95[1].toFixed(3)}, crossing zero. We cannot say that a larger Task Vector or norm is intrinsically better for WebShop.`,
      )}</p>
    </div>

    <div id="posthoc">
      <h3>5.2 {t('后期差异不只是“更新被压小”，更新方向也变了', 'The late difference is not only smaller updates; direction changes too')}</h3>
      <p>{t(
        `R159 时，Bounded Online Recurrence + GDR 的这轮更新大小约为不加 GDR 的 Bounded Online Recurrence 的 ${(study.posthocAnalysis.directionMagnitudeR159.updateNormRatioOnOff * 100).toFixed(1)}%，只小约 11%；但两边更新方向的 cosine 已经是 ${study.posthocAnalysis.directionMagnitudeR159.updateCosineOnOff.toFixed(3)}。第 19–27 层平均 cosine 进一步到 ${study.posthocAnalysis.directionMagnitudeR159.lateLayerUpdateCosineMean.toFixed(3)}。`,
        `At R159, the GDR update is about ${(study.posthocAnalysis.directionMagnitudeR159.updateNormRatioOnOff * 100).toFixed(1)}% the size of Bounded Online Recurrence without GDR, only about 11% smaller, while the update-direction cosine is already ${study.posthocAnalysis.directionMagnitudeR159.updateCosineOnOff.toFixed(3)}. Across layers 19–27, the mean cosine falls further to ${study.posthocAnalysis.directionMagnitudeR159.lateLayerUpdateCosineMean.toFixed(3)}.`,
      )}</p>
      <p class="paper__boundary">{t(
        `这说明 GDR 后期不是简单把同一个更新缩短；两条线在往不同方向走。不过方向差异本身还没有被证明是掉分原因：目前只有 ${study.posthocAnalysis.exploratoryAssociation.anchorCount} 个锚点，最强的状态大小比趋势 exact permutation p=${study.posthocAnalysis.exploratoryAssociation.exactPermutationP.toFixed(3)}，仍未显著。`,
        `This shows that late GDR is not simply shortening the same update; the two lines move in different directions. But direction divergence itself is not yet proven to cause the score drop: there are only ${study.posthocAnalysis.exploratoryAssociation.anchorCount} anchors, and the strongest state-size-ratio trend has exact permutation p=${study.posthocAnalysis.exploratoryAssociation.exactPermutationP.toFixed(3)}.`,
      )}</p>

      <h3>5.3 {t('输出长度和步数：后期不是更啰嗦，而是要走更多步', 'Output length and steps: late behavior is not more verbose, but takes more steps')}</h3>
      <div class="paper-table-wrap">
        <table class="paper-table">
          <thead><tr><th>{t('窗口', 'Window')}</th><th>{t('每步输出', 'tokens / step')}</th><th>{t('平均步骤', 'steps / episode')}</th><th>Task Score</th></tr></thead>
          <tbody>
            <tr><td>{names.baseline} · R0–31</td><td>{study.posthocAnalysis.outputLength.ordinary.earlyStepTokens.toFixed(1)}</td><td>{study.posthocAnalysis.outputLength.ordinary.earlySteps.toFixed(2)}</td><td>0.377</td></tr>
            <tr><td>{names.baseline} · R128–159</td><td>{study.posthocAnalysis.outputLength.ordinary.lateStepTokens.toFixed(1)}</td><td>{study.posthocAnalysis.outputLength.ordinary.lateSteps.toFixed(2)}</td><td>0.641</td></tr>
            <tr><td>{names.gdr} · R96–127</td><td>{study.posthocAnalysis.outputLength.linearConstraint.midStepTokens.toFixed(1)}</td><td>{study.posthocAnalysis.outputLength.linearConstraint.midSteps.toFixed(2)}</td><td>{study.posthocAnalysis.outputLength.linearConstraint.midScore.toFixed(3)}</td></tr>
            <tr><td>{names.gdr} · R128–159</td><td>{study.posthocAnalysis.outputLength.linearConstraint.lateStepTokens.toFixed(1)}</td><td>{study.posthocAnalysis.outputLength.linearConstraint.lateSteps.toFixed(2)}</td><td>{study.posthocAnalysis.outputLength.linearConstraint.lateScore.toFixed(3)}</td></tr>
          </tbody>
        </table>
      </div>
      <p>{t(
        '普通 OpenEVO 后期每一步更短、完成任务的步骤也更少；GDR 线最后一段每步输出仍然很短，但平均步骤从 7.91 回升到 8.60，同时 Task Score 从 0.601 降到 0.568。最直接的行为变化不是“模型变啰嗦”，而是任务路径变长。',
        'Ordinary OpenEVO becomes shorter per step and needs fewer steps late in training. In the GDR line, per-step output stays short, but mean steps rise from 7.91 to 8.60 while Task Score falls from 0.601 to 0.568. The direct behavioral change is a longer task path, not more verbose individual outputs.',
      )}</p>

      <h3>5.4 Entropy：{t('能算行为熵，不能补造 token entropy', 'behavior entropy is available; token entropy is not')}</h3>
      <p>{t(
        '正式三线 rollout 没有保存逐 token logits / logprobs，所以真正的 predictive token entropy 不能只凭文本事后恢复。可以从已有动作记录计算 search / click 等 action family 的分布熵，但它回答的是“行为类型有多集中”，不是模型每个 token 有多不确定。',
        'The formal three-way rollouts did not persist per-token logits/logprobs, so true predictive token entropy cannot be reconstructed from text alone. Action-family entropy can be computed from saved search/click behavior, but it measures how concentrated action types are, not token-level uncertainty.',
      )}</p>
      {study.posthocAnalysis.behaviorEntropy ? (
        <div class="paper-table-wrap">
          <table class="paper-table">
            <thead><tr><th>{t('方法', 'Method')}</th><th>R0–31</th><th>R128–159</th></tr></thead>
            <tbody>
              <tr><td>{names.baseline}</td><td>{study.posthocAnalysis.behaviorEntropy.ordinaryEarly.toFixed(3)}</td><td>{study.posthocAnalysis.behaviorEntropy.ordinaryLate.toFixed(3)}</td></tr>
              <tr><td>{names.bounded}</td><td>{study.posthocAnalysis.behaviorEntropy.boundedEarly.toFixed(3)}</td><td>{study.posthocAnalysis.behaviorEntropy.boundedLate.toFixed(3)}</td></tr>
              <tr><td>{names.gdr}</td><td>{study.posthocAnalysis.behaviorEntropy.gdrEarly.toFixed(3)}</td><td>{study.posthocAnalysis.behaviorEntropy.gdrLate.toFixed(3)}</td></tr>
            </tbody>
          </table>
        </div>
      ) : null}

      <h3>5.5 {t('学长提出的下一问：约束要不要更 adaptive？', 'Next question: should the constraint become more adaptive?')}</h3>
      <p>{t(
        `现在的 β 已经不是固定系数：冻结 controller 每一步读取 ${study.posthocAnalysis.gdr.betaControllerFeatures} 个局部特征，再决定写多强。但它只知道局部参数、梯度和 Adam 状态，不知道 WebShop reward、Task Score 或 Task Vector。`,
        `Beta is already dynamic rather than fixed: the frozen controller reads ${study.posthocAnalysis.gdr.betaControllerFeatures} local features at each step and chooses write strength. But it only knows local parameters, gradients, and Adam state; it does not see WebShop reward, Task Score, or Task Vector.`,
      )}</p>
      <p>{t(
        '所以下一步真正的问题不是“固定 β 还是动态 β”，而是“动态 β 还应该知道什么”。一个干净的下一实验可以前瞻加入 layer / round / 历史更新方向等信息，看它能不能区分该压的噪声和应该保留的有效更新；不能拿已经看到的 Final 回头调当前实验。',
        'The real next question is not fixed versus dynamic beta, but what information the dynamic beta should know. A clean prospective experiment could add layer, round, or historical update-direction information and test whether it better separates noise from useful updates; the completed final cannot be used to tune this finished study retrospectively.',
      )}</p>
    </div>

  </section>

  <section class="paper__section" id="wandb" aria-labelledby="wandb-title">
    <p class="paper__section-number">6</p>
    <h2 id="wandb-title">{t('W&B：把曲线直接放进网页里', 'W&B: interactive curves inside the page')}</h2>
    <p>{t('这次不再只放一个 W&B 链接。网页先直接展示三张关键曲线；点击任意图可以回到 W&B 原生 panel。完整 Report 里还保留了原生曲线、run 表和比较器。', 'This page no longer exposes only one W&B link. Three key curves are visible directly here; each image links back to its native W&B panel. The full Report also keeps native curves, the run table, and the comparer.')}</p>
    <WandbEvidencePanel reportUrl={wandbReportUrl} workspaceUrl={wandbWorkspaceUrl} panelLinks={wandbPanels} snapshots={wandbSnapshots} />
    <p class="paper__boundary">{t('当前 W&B 原项目没有对未登录访客开放，所以公开网页不能诚实地把 Report 伪装成可交互 iframe。静态图与链接不改变封存科学结论；如果以后单独发布只含这些公开曲线的 W&B mirror，再把这一层换成 iframe 即可。', 'The current W&B source project is not open to logged-out visitors, so this public page does not pretend that the Report is an embeddable interactive iframe. Static snapshots and links do not change the sealed scientific conclusions; a separate public mirror could replace this layer with an iframe later.')}</p>
  </section>

  <section class="paper__section" id="evidence" aria-labelledby="evidence-title">
    <p class="paper__section-number">7</p>
    <h2 id="evidence-title">{t('证据与复现身份', 'Evidence and reproducibility identity')}</h2>
    <p>{t(
      '正文统一使用“普通 OpenEVO / Bounded Online Recurrence / Bounded Online Recurrence + GDR”这三个公共名称。为了审计，底层正式身份仍原样保留：普通 OpenEVO 对应历史 DirectApply / No-GDR；后两组的正式实验标识分别是 BOUNDED_OFF 与 EFFECTIVE_STATE_GDR_LORA_V1。',
      'The main text uses one public naming system: ordinary OpenEVO, Bounded Online Recurrence, and Bounded Online Recurrence + GDR. For auditability, the underlying formal identities remain unchanged: ordinary OpenEVO maps to the historical DirectApply / No-GDR run, and the matched arms are BOUNDED_OFF and EFFECTIVE_STATE_GDR_LORA_V1.',
    )}</p>
    <details class="paper__details" open>
      <summary>{t('正式结果与同题 Final', 'Formal results and same-panel final')}</summary>
      <ul>
        <li><a href={study.evidence.finalComparison}><ExternalBrandMark href={study.evidence.finalComparison} />{t('三组同题冻结终评 / Bounded Online Recurrence 与 +GDR 正式比较', 'three-way same-panel final / formal Bounded Online Recurrence vs +GDR comparison')}</a></li>
        <li><a href={study.evidence.longHorizon}><ExternalBrandMark href={study.evidence.longHorizon} />{t('长期统计与 bootstrap', 'long-horizon statistics and bootstrap')}</a></li>
        <li><a href={study.evidence.publicSnapshot}>{t('公开机器可读结果快照', 'public machine-readable snapshot')}</a></li>
        <li><a href={study.posthocAnalysis.snapshot}>{t('只读后分析快照', 'read-only post-hoc snapshot')}</a></li>
      </ul>
    </details>
    <details class="paper__details">
      <summary>{t('方法实现与资格证据', 'Method implementation and qualification evidence')}</summary>
      <ul>
        <li><a href={study.evidence.gaugeInvariantPolicy}><ExternalBrandMark href={study.evidence.gaugeInvariantPolicy} />gauge-invariant β policy</a></li>
        <li><a href={study.evidence.stepTrace}><ExternalBrandMark href={study.evidence.stepTrace} />exact per-step trace</a></li>
        <li><a href={study.evidence.finalCloseout}><ExternalBrandMark href={study.evidence.finalCloseout} />{t('最终收口记录', 'final closeout')}</a></li>
        <li><a href={directApplyHref}>{t('普通 OpenEVO 独立实验页', 'ordinary OpenEVO experiment')}</a></li>
        <li><a href={boundedHref}>{t('Bounded State 早期研究页', 'Bounded State research page')}</a></li>
      </ul>
    </details>
  </section>
