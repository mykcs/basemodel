          <tr><td>Final Task Vector · Frobenius</td><td>{study.parameterAnalysis.off.finalTaskVectorFrobenius.toFixed(3)}</td><td>{study.parameterAnalysis.on.finalTaskVectorFrobenius.toFixed(3)}</td></tr>
          <tr><td>{t('R159 update norm · β-gating / Bounded', 'R159 update norm · β-gating / Bounded')}</td><td>1.000×</td><td><strong>{study.posthocAnalysis.directionMagnitudeR159.updateNormRatioOnOff.toFixed(3)}×</strong></td></tr>
        </tbody>
