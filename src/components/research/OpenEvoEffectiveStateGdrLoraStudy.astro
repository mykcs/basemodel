          <tr><td>{names.bounded}</td><td><strong>{study.threeWayFinal.off.score.toFixed(2)}</strong></td><td>{study.threeWayFinal.off.exactCount}/128</td></tr>
          <tr><td>{names.gdr}</td><td><strong>{study.threeWayFinal.on.score.toFixed(2)}</strong></td><td>{study.threeWayFinal.on.exactCount}/128</td></tr>
