          <tr><td>{names.gdr}</td><td><strong>{study.posthocAnalysis.behaviorEntropy.gdrEarly.toFixed(4)}</strong></td><td><strong>{study.posthocAnalysis.behaviorEntropy.gdrLate.toFixed(4)}</strong></td><td><strong>{study.posthocAnalysis.behaviorEntropy.r159.gdr.entropy.toFixed(4)}</strong></td><td>{(study.posthocAnalysis.behaviorEntropy.r159.gdr.search / study.posthocAnalysis.behaviorEntropy.r159.gdr.total * 100).toFixed(1)}%</td><td><strong>{(study.posthocAnalysis.behaviorEntropy.r159.gdr.click / study.posthocAnalysis.behaviorEntropy.r159.gdr.total * 100).toFixed(1)}%</strong></td></tr>
        </tbody>
