---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import MathFormula from '../common/MathFormula.astro';
import MetricEvidenceFigure from './MetricEvidenceFigure.astro';
import { readFileSync } from 'node:fs';
import { EFFECTIVE_STATE_GDR_LORA_STUDY as study } from '../../data/effectiveStateGdrLoraStudy';
import type { EffectiveStateFormalResult } from '../../data/effectiveStateGdrLoraStudy';
import { OPEN_EVO_DIRECT_APPLY_LIVE_DYNAMICS as directApplyDynamics } from '../../data/openEvoDirectApplyLiveDynamics';
import { OPEN_EVO_EXPERIMENTS } from '../../data/openEvoExperimentNavigation';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const cap = '/research/seed-openevo/study/capability-exploration';
const directApplyHref = p(`${cap}/q17-directapply-analysis/`);
const boundedHref = p(`${cap}/sd-lora-bounded-state/`);
const gatedHref = p(`${cap}/gated-delta-sd-lora/`);
const scalingHref = p(`${cap}/sd-lora-scaling/`);
const gdrPaperHref = 'https://arxiv.org/abs/2412.06464';
const q17GeometryHref = 'https://github.com/mykcs/openevo-experiment/blob/main/docs/evidence/q17-final-closeout-20260912/D1_GEOMETRY.json';
const boundedManifestHref = 'https://github.com/mykcs/openevo-experiment/blob/c5e012814bb9509deb0e2cbc8d57a63e2b56889f/docs/evidence/bounded-recurrence-gdr-20260915/treatment-manifest-202609150100.json';
const betaControllerSourceHref = 'https://github.com/mykcs/openevo-experiment/blob/c5e012814bb9509deb0e2cbc8d57a63e2b56889f/scripts/analysis/gated_delta_gauge_invariant_beta_policy_v2_202609151320.py';
const betaRuntimeSourceHref = 'https://github.com/mykcs/openevo-experiment/blob/c5e012814bb9509deb0e2cbc8d57a63e2b56889f/scripts/analysis/gated_delta_lora_effective_state_runtime_v1_202609151345.py';

const wandbReportUrl = 'https://wandb.ai/zju-openevo-wangrui/zju-openevo-experiments/reports/OpenEVO-1.7B-%C2%B7-%E4%B8%89%E7%BB%84%E5%AE%9E%E9%AA%8C%E5%88%86%E6%9E%90--VmlldzoxNzk2ODUyMg==';
const wandbWorkspaceUrl = study.posthocAnalysis.wandbWorkspace;
const panelHref = (panelDisplayName: string, panelSectionName: string) => {
  const join = wandbWorkspaceUrl.includes('?') ? '&' : '?';
  return `${wandbWorkspaceUrl}${join}panelDisplayName=${encodeURIComponent(panelDisplayName)}&panelSectionName=${encodeURIComponent(panelSectionName)}`;
};
const metricCharts = {
  taskScore: {
    title: t('WebShop Task Score · 160轮', 'WebShop Task Score · 160 rounds'),
    src: '/research/seed-openevo/evidence/wandb-threeway/task-score.svg',
    href: wandbReportUrl,
    linkText: t('打开 W&B Report ↗', 'Open W&B Report ↗'),
    alt: t('三组 OpenEVO 的 WebShop Task Score 160 轮静态曲线', 'Static 160-round WebShop Task Score curves for the three OpenEVO methods'),
  },
  loss: {
    title: t('SD-LoRA training loss · 累计 rollout', 'SD-LoRA training loss · cumulative rollout'),
    src: '/research/seed-openevo/evidence/wandb-threeway/loss-vs-rollout.svg',
    href: wandbReportUrl,
    linkText: t('打开 W&B Report ↗', 'Open W&B Report ↗'),
    alt: t('三组 OpenEVO 的 SD-LoRA training loss 随累计 rollout 变化的静态曲线', 'Static SD-LoRA training-loss curves against cumulative rollouts for the three OpenEVO methods'),
  },
  taskVector: {
    title: 'Task Vector · Frobenius',
    src: '/research/seed-openevo/evidence/wandb-threeway/task-vector-frobenius.svg',
    href: panelHref('Task Vector · Frobenius', '01 Overview · 三条路线'),
    alt: t('三组实验的 Task Vector Frobenius norm 静态曲线', 'Static Task Vector Frobenius norm curves for the three experiments'),
  },
  outputLength: {
    title: t('每一步输出长度 · 160轮', 'Tokens per step · 160 rounds'),
    src: '/research/seed-openevo/evidence/wandb-threeway/tokens-per-step.svg',
    href: panelHref('每一步输出长度', '06 输出长度与任务路径'),
    alt: t('三组实验每一步 raw-completion token 数的 160 轮静态曲线', 'Static 160-round raw-completion tokens-per-step curves for the three experiments'),
  },
  steps: {
    title: t('平均任务步数', 'Steps per episode'),
    src: '/research/seed-openevo/evidence/wandb-threeway/steps-per-episode.svg',
    href: panelHref('每个 Episode 的步骤数', '06 输出长度与任务路径'),
    alt: t('三组实验每个 episode 的平均任务步数静态曲线', 'Static steps-per-episode curves for the three experiments'),
  },
  entropy: {
    title: t('行为 entropy · 160轮', 'Action-family entropy · 160 rounds'),
    src: '/research/seed-openevo/evidence/wandb-threeway/action-family-entropy.svg',
    href: panelHref('Action-family entropy', '06 输出长度与任务路径'),
    alt: t('三组实验 160 轮 action-family Shannon entropy 静态曲线', 'Static 160-round action-family Shannon entropy curves for the three experiments'),
  },
};

type LossRow = {
  round: number;
  ordinary_openevo_loss: number | null;
  bounded_loss: number | null;
  bounded_gdr_loss: number | null;
};
const lossEvidence = JSON.parse(
  readFileSync(new URL('../../../public/research/seed-openevo/evidence/wandb-threeway/loss-vs-rollout.json', import.meta.url), 'utf8'),
) as { rows: LossRow[]; missing_loss_points: { ordinary_openevo: number; bounded: number; bounded_gdr: number } };
const lossFirst = lossEvidence.rows[0]!;
const lossLast = lossEvidence.rows.at(-1)!;

const math = {
  history: String.raw`W_t = W_0 + \sum_{i=1}^{t} \Delta W_i`,
  bounded: String.raw`S_t = \operatorname{Compress}_{128}\!\left(S_{t-1}+\Delta_t\right)`,
  deltaFromRegression: String.raw`\mathcal{L}_t(S)=\frac12\lVert S k_t-v_t\rVert_2^2
  \quad\Longrightarrow\quad
  S_t=S_{t-1}+\beta_t\left(v_t-S_{t-1}k_t\right)k_t^{\top}`,
  gdr: String.raw`S_t = \alpha_t S_{t-1}\left(I-\beta_t k_t k_t^{\top}\right)+\beta_t v_t k_t^{\top}`,
  residual: String.raw`\begin{aligned}\widetilde S_{t-1} &= \alpha_t S_{t-1} \\ r_t &= v_t-\widetilde S_{t-1}k_t \\ S_t &= \widetilde S_{t-1}+\beta_t r_t k_t^{\top}\end{aligned}`,
  gauge: String.raw`\Delta W = C A^{\top},\qquad A\mapsto sA,\quad C\mapsto C/s\quad\Longrightarrow\quad \Delta W\;\text{unchanged}`,
  gZero: String.raw`g=0`,
  alphaOne: String.raw`\alpha=1`,
  factorFailureBeta: String.raw`\beta=${study.derivation.firstGenerationFactorFailure.betaC.toFixed(3)}`,
  mappingFailureBeta: String.raw`\beta_{\mathrm{eff}}=${study.derivation.mappingOnlyControllerFailure.betaEffective.toFixed(3)}`,
  beta: String.raw`\beta_t=f_{\theta}(x_t),\qquad x_t\in\mathbb{R}^{${study.posthocAnalysis.gdr.betaControllerFeatures}}`,
  effective: String.raw`S_t^{(\alpha=1,\,\beta\text{-gate})}=\operatorname{Compress}_{128}\!\left(S_{t-1}+\operatorname{Gate}_{\beta_t}(\Delta_t)\right)`,
};

const result = study.formalResult as EffectiveStateFormalResult;
const finalResult = result.status === 'sealed' ? result : null;

const names = {
  baseline: t('普通 OpenEVO', 'OpenEVO'),
  bounded: t('OpenEVO + Bounded Online Recurrence', 'OpenEVO + Bounded Online Recurrence'),
  gdr: t('OpenEVO + Bounded Online Recurrence + β-gating（α 固定为 1）', 'OpenEVO + Bounded Online Recurrence + β-gating (α fixed at 1)'),
  dynamicAlphaBeta: t('OpenEVO + Bounded Online Recurrence + 动态 α + 动态 β（未做）', 'OpenEVO + Bounded Online Recurrence + dynamic α + dynamic β (not run)'),
};

const experiment = OPEN_EVO_EXPERIMENTS.find((item) => item.id === 'bounded-effective-state-1p7b');
if (!experiment) throw new Error('Missing bounded-effective-state-1p7b experiment navigation');
const hubResults = experiment.childLinks.filter((link) => link.role === 'result');
const hubAnalyses = experiment.childLinks.filter((link) => ['analysis', 'mechanism', 'diagnostic'].includes(link.role));
const hubEvidence = [...experiment.childLinks.filter((link) => ['history', 'evidence'].includes(link.role)), experiment.evidenceLink]
  .filter((link, index, links) => links.findIndex((candidate) => candidate.href === link.href) === index);

const meanScore = (rows: readonly { score: number }[]) =>
  rows.reduce((sum, row) => sum + row.score, 0) / rows.length;
const directApplyLast20Score = meanScore(directApplyDynamics.score.slice(-20));
const boundedLast20Score = finalResult ? meanScore(finalResult.trajectory.off.slice(-20)) : null;
const gdrLast20Score = finalResult ? meanScore(finalResult.trajectory.on.slice(-20)) : null;
const seedPaperWebShopScore = 87.1;
const seedPaperWebShopSuccess = 77.3;
const seedPaperHref = 'https://arxiv.org/abs/2607.14777';
const twentyRoundScoreWindows = finalResult
  ? Array.from({ length: 8 }, (_, index) => {
      const start = index * 20;
      const end = start + 20;
      return {
        label: `R${start}–${end - 1}`,
        baseline: meanScore(directApplyDynamics.score.slice(start, end)),
        bounded: meanScore(finalResult.trajectory.off.slice(start, end)),
        gdr: meanScore(finalResult.trajectory.on.slice(start, end)),
      };
    })
  : [];
---

<article class="paper" data-effective-state-gdr-page data-copy-review data-reader-page="research-explainer" data-experiment-id={experiment.id}>
  <header class="paper__hero esg__hero" data-reader-context id="top">
    <h1>{t('OpenEVO 参数演变：Bounded State 与 β 组件', 'OpenEVO parameter evolution: Bounded State and the β component')}</h1>

    <figure class="paper-table-figure paper-table-figure--hero" data-result-stage="direct-result">
      <div class="paper-table-wrap paper-table-wrap--hero" aria-label={t('三组已完成实验、一个未做实验位置，以及 SEED 论文参考', 'Three completed experiments, one unrun slot, and a SEED paper reference')}>
        <table class="paper-table paper-table--ablation" aria-describedby="ablation-table-caption">
          <thead>
            <tr>
              <th>{t('实验', 'Experiment')}</th>
              <th>Bounded</th>
              <th>{t('动态 β', 'Dynamic β')}</th>
              <th>{t('动态 α', 'Dynamic α')}</th>
              <th>{t('最后 20 轮平均 Task Score', 'Mean Task Score over the last 20 rounds')}</th>
              <th>{t('WebShop 评测', 'WebShop evaluation')}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="paper-table__reference-row">
              <td><strong><a href={seedPaperHref}><ExternalBrandMark href={seedPaperHref} />SEED {t('（论文，Qwen3-1.7B）', '(paper, Qwen3-1.7B)')}</a></strong></td>
              <td class="paper-table__mark">—</td>
              <td class="paper-table__mark">—</td>
              <td class="paper-table__mark">—</td>
              <td>—</td>
              <td><strong>{seedPaperWebShopScore.toFixed(1)}</strong> / 100<br/><span class="paper-table__metric-detail">{seedPaperWebShopSuccess.toFixed(1)}% Succ.</span></td>
            </tr>
            <tr>
              <td><strong>{names.baseline}</strong></td>
              <td class="paper-table__mark">—</td>
              <td class="paper-table__mark">—</td>
              <td class="paper-table__mark">—</td>
              <td><strong>{directApplyLast20Score.toFixed(2)}</strong></td>
              <td><strong>{study.threeWayFinal.directApply.score.toFixed(2)}</strong> / 100<br/><span class="paper-table__metric-detail">{t('同题 ', 'same-panel ')}{study.threeWayFinal.directApply.exactCount}/128 {t('完整做对', 'exact')}</span></td>
            </tr>
            <tr>
              <td><strong>{names.bounded}</strong></td>
              <td class="paper-table__mark" aria-label={t('使用', 'enabled')}>✓</td>
              <td class="paper-table__mark">—</td>
              <td class="paper-table__mark">—</td>
              <td><strong>{boundedLast20Score?.toFixed(2) ?? '—'}</strong></td>
              <td><strong>{study.threeWayFinal.off.score.toFixed(2)}</strong> / 100<br/><span class="paper-table__metric-detail">{t('同题 ', 'same-panel ')}{study.threeWayFinal.off.exactCount}/128 {t('完整做对', 'exact')}</span></td>
            </tr>
            <tr>
              <td><strong>{names.gdr}</strong></td>
              <td class="paper-table__mark" aria-label={t('使用', 'enabled')}>✓</td>
              <td class="paper-table__mark" aria-label={t('使用', 'enabled')}>✓</td>
              <td class="paper-table__mark">—</td>
              <td><strong>{gdrLast20Score?.toFixed(2) ?? '—'}</strong></td>
              <td><strong>{study.threeWayFinal.on.score.toFixed(2)}</strong> / 100<br/><span class="paper-table__metric-detail">{t('同题 ', 'same-panel ')}{study.threeWayFinal.on.exactCount}/128 {t('完整做对', 'exact')}</span></td>
            </tr>
            <tr>
              <td><strong>{names.dynamicAlphaBeta}</strong></td>
              <td class="paper-table__mark">✓</td>
              <td class="paper-table__mark">✓</td>
              <td class="paper-table__mark">✓</td>
              <td>—</td>
              <td>—</td>
            </tr>
          </tbody>
        </table>
      </div>
      <figcaption id="ablation-table-caption" class="paper-table__caption">
        <strong>{t('表 1.', 'Table 1.')}</strong>{' '}
        {t(
          '消融设置与结果。SEED（论文，Qwen3-1.7B）是外部参考：原论文 Table 1 在 WebShop 上报告 Score 87.1、Success 77.3%。它使用论文自己的 128 个 validation tasks，不是我们三条 OpenEVO 最终模型共用的同一冻结 128 题，因此只能作为论文参考，不能把数值差直接解释成严格同题消融收益。普通 OpenEVO 是原始 DirectApply：每轮 rank8 SD-LoRA 更新继续累积；+ Bounded 把累计参数历史压回固定 rank128 State；+ β-gating（α 固定为 1）在 Bounded 上再用动态 β 控制新经验写入长期参数 State 的强度；动态 α + 动态 β 是尚未运行的方法空间空位，因此结果保持为空且不参与统计比较，但它不代表当前下一实验的第一优先级。',
          'Ablation settings and results. SEED (paper, Qwen3-1.7B) is an external reference: Table 1 of the paper reports WebShop Score 87.1 and Success 77.3%. It uses the paper’s own 128 validation tasks rather than the same frozen 128-task panel shared by our three OpenEVO final models, so it is a paper reference rather than a strict same-panel ablation. OpenEVO is the original DirectApply, where each rank-8 SD-LoRA update continues to accumulate; + Bounded compresses accumulated parameter history back to a fixed rank-128 State; + β-gating (α fixed at 1) adds dynamic β on top of Bounded to control how strongly new experience is written into the long-term parameter State; dynamic α + dynamic β remains an unrun method-space slot, so its results remain blank and it is excluded from statistical comparisons, but it is not presented as the current first-priority next experiment.',
        )}
      </figcaption>
    </figure>

    <div class="paper__metric-context">
      <p class="paper__lede esg__lede" data-reader-task data-reader-purpose>{t(
        '三条已完成路线现在形成了一个很清楚的结果：Bounded 把参数更新累计耗时从 31.09 小时降到 2.02 小时，但同题终评从 60.72 降到 45.98；继续加入 β 组件后，终评进一步降到 20.77。接下来的核心问题是：固定容量到底应该多大、Bounded 为什么没有完全保持能力，以及 β 为什么后期掉分。',
        'The three completed lines now form a clear result: Bounded reduces cumulative parameter-update time from 31.09 hours to 2.02 hours, but the same-panel final drops from 60.72 to 45.98; adding the β component lowers it further to 20.77. The central open questions are the required fixed-state capacity, why Bounded does not fully preserve capability, and why β-gating degrades late.',
      )}</p>
      <p>{t(
        'Task Score 是 WebShop 每个任务结束时给出的 0–1 连续分数的平均值 × 100。商品属性只完成一部分时也可能得到部分分；“完整做对”则要求任务真正成功且 task_score = 1.0。因此 60.72 / 100 和 50/128 不是同一个指标。',
        'Task Score is the mean terminal WebShop task_score in [0,1], multiplied by 100. Partial satisfaction can receive partial credit; “exact success” requires the task to be completed successfully with task_score = 1.0. So 60.72/100 and 50/128 are different metrics.',
      )}</p>
      <p>{t(
        '固定终评的 128 题在训练开始前就选好：从 WebShop held-out 的 goal_idx 0–499 中先排除上一套 final 的 128 题，再按固定的 SHA256 排序取前 128；选择过程不读取 reward 或 success。三组最终模型都用了完全相同、顺序也相同的这 128 题，而且 Stage 2 训练期间不能看到题单。',
        'The 128 final tasks were selected before training: start from WebShop held-out goal_idx 0–499, exclude the previous final panel, sort the remaining indices by a fixed SHA256 rule, and take the first 128. Selection does not read reward or success. All three final models use exactly the same ordered 128 tasks, and Stage 2 training cannot see the panel contents.',
      )}</p>
      <p class="paper__boundary">{t(
        '这仍然只是一套固定的 128 题，不是“全面能力分数”。最后 20 轮平均也不是固定题考试：每轮抽到的任务会变化，它更适合描述训练后期的典型水平和趋势。真正属于同一次预注册正式对照的是后两组；普通 OpenEVO 是更早独立完成的前序实验。',
        'This is still one fixed set of 128 tasks, not a comprehensive capability score. The last-20-round mean is not a fixed-panel exam either: the sampled tasks vary by round, so it is better read as a description of typical late-training behavior and trajectory. Only the latter two rows belong to the same preregistered matched campaign; ordinary OpenEVO is an earlier predecessor run.',
      )}</p>
    </div>
  </header>

  <section class="paper__section" id="motivation" aria-labelledby="motivation-title">
    <p class="paper__section-number">1</p>
    <h2 id="motivation-title">{t('我们先解决 SD-LoRA 越训练越慢', 'We first address SD-LoRA slowing down as history grows')}</h2>
    <p>{t(
      '普通 OpenEVO 的参数更新方式是：每轮训练得到一个新的 SD-LoRA component，并把过去的 component 一起保留到后续模型。这样参数历史会随轮数持续变长；到了后期，每一轮训练都要经过越来越多的低秩路径，所以参数更新越来越慢。',
      'Ordinary OpenEVO updates parameters by producing a new SD-LoRA component each round and retaining the earlier components in later model states. The parameter history therefore grows with round count, so late training must traverse more and more low-rank paths and parameter updates become slower.',
    )}</p>
    <p>{t(
      '从 OpenEVO 的整体设计看，这条 SD-LoRA 线也可以理解成一种“参数化长期记忆”：Text Memory、Skill Bundle、Agent System 把经验保存在 prompt 可见的文字状态里，参数 State 则把更慢、更持久的变化写进模型参数。当前这页先把问题收窄到 WebShop：一套参数 / 一个长期 LoRA State 能不能持续吸收经验、保持能力，同时不让历史无限增长。更大的 continual learning、meta-learning 或多种 Memory 协同问题先不混进来。',
      'Within OpenEVO, this SD-LoRA line can also be viewed as parameterized long-term memory. Text Memory, Skill Bundle, and Agent System keep experience in prompt-visible textual state, while parameter State writes slower, persistent change into model parameters. This page keeps the near-term question narrow: on WebShop, can one parameter set / one long-term LoRA State keep absorbing experience and preserving capability without unbounded history? Broader continual-learning, meta-learning, and multi-memory questions remain outside this first step.',
    )}</p>
    <MathFormula latex={math.history} label={t('普通 OpenEVO 的累计参数历史', 'Accumulating parameter history in ordinary OpenEVO')} />
    <p class="paper__math-caption">{t('历史 component 随 t 增长。', 'Historical components grow with t.')}</p>
    <p>{t(
      `这不是一个小的实现常数：普通 OpenEVO 的 159 次 SD-LoRA trainer 累计约 ${study.timingComparison.directApply.trainerHours.toFixed(2)} 小时。我们因此先问一个更基础的问题：能不能把“越来越长的历史”折成一个固定大小的参数状态，同时继续学习下一轮？`,
      `This is not a small implementation constant: the 159 SD-LoRA trainer updates in ordinary OpenEVO total about ${study.timingComparison.directApply.trainerHours.toFixed(2)} hours. We therefore ask a more basic question: can the growing history be folded into a fixed-size parameter state while learning continues?`,
    )}</p>
    <p class="paper__links"><a href={scalingHref}>{t('SD-LoRA 计算扩展性证据 →', 'SD-LoRA scaling evidence →')}</a></p>
  </section>

  <section class="paper__section" id="method" aria-labelledby="method-title">
    <p class="paper__section-number">2</p>
    <h2 id="method-title">{t('Bounded State 与 β 组件：固定容量与写入强度控制', 'Bounded State and the β component: fixed capacity and write-strength control')}</h2>

    <h3>2.1 {t('我们把长期参数历史固定在 rank128', 'We keep the long-term parameter history at rank128')}</h3>
    <p>{t(
      '每一轮仍然先得到一个 rank8 的当前更新 Δt，但不再把所有旧 component 永久并排保存。我们把“上一轮的 rank128 状态 + 当前更新”重新压回 rank128，作为下一轮唯一的参数历史。',
      'Each round still produces a rank-8 current update Δt, but old components are no longer kept side by side forever. The previous rank-128 state plus the current update is compressed back to rank128 and becomes the only parameter history for the next round.',
    )}</p>
    <MathFormula latex={math.bounded} label={t('Bounded Online Recurrence 的状态更新', 'Bounded Online Recurrence state update')} />
    <p class="paper__math-caption"><span class="paper__math-symbol">Sₜ₋₁</span> = {t('历史参数 State', 'historical parameter State')} · <span class="paper__math-symbol">Δₜ</span> = {t('当前轮 rank8 更新', 'current rank-8 update')}</p>
    <p>{t(
      `这样，参数历史的物理 rank 不再随轮数增长。工程上，Bounded Online Recurrence 的参数 transition 累计约 ${study.timingComparison.off.transitionHours.toFixed(2)} 小时，而普通 OpenEVO 的 trainer 累计约 ${study.timingComparison.directApply.trainerHours.toFixed(2)} 小时，只看参数更新部分约快 ${(study.timingComparison.directApply.trainerHours / study.timingComparison.off.transitionHours).toFixed(2)}×。`,
      `The physical rank of parameter history no longer grows with rounds. In this implementation, Bounded Online Recurrence totals about ${study.timingComparison.off.transitionHours.toFixed(2)} hours of parameter transition time, versus ${study.timingComparison.directApply.trainerHours.toFixed(2)} trainer hours for ordinary OpenEVO, a ${(study.timingComparison.directApply.trainerHours / study.timingComparison.off.transitionHours).toFixed(2)}× speedup for the parameter-update component.`,
    )}</p>
    <p>{t(
