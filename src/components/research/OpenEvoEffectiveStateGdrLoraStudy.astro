      <thead><tr><th>{t('实验', 'Experiment')}</th><th>{t('最后 20 轮平均 Task Score', 'Mean Task Score, last 20 rounds')}</th><th>{t('这列在测什么', 'What this measures')}</th></tr></thead>
      <tbody>
        <tr><td>{names.baseline}</td><td><strong>{directApplyLast20Score.toFixed(2)}</strong></td><td>{t('R140–R159 每轮不同抽样任务的平均', 'mean over R140–R159 with different sampled tasks each round')}</td></tr>
        <tr><td>{names.bounded}</td><td><strong>{boundedLast20Score?.toFixed(2) ?? '—'}</strong></td><td>{t('R140–R159 每轮不同抽样任务的平均', 'mean over R140–R159 with different sampled tasks each round')}</td></tr>
        <tr><td>{names.gdr}</td><td><strong>{gdrLast20Score?.toFixed(2) ?? '—'}</strong></td><td>{t('R140–R159 每轮不同抽样任务的平均', 'mean over R140–R159 with different sampled tasks each round')}</td></tr>
