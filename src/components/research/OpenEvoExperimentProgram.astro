---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const seedRoot = 'https://github.com/mykcs/seed3090/blob/main';
const bridgeRoot = 'https://github.com/mykcs/openevo-webshop/blob/main';
const activeRoot = 'https://github.com/mykcs/openevo-experiment/blob/main';

const repositories = [
  {
    state: t('已退休 · 历史证据', 'Retired · historical evidence'),
    name: 'seed3090',
    role: t('4×RTX3090 时代的大型实验与调试档案', 'The large 4×RTX3090 experiment and debugging archive'),
    text: t(
      '保存 WebShop / ALFWorld bring-up、旧服务器假设、失败尝试、RTX6 artifact 和参数进化诊断。现在不再承担新实验开发。',
      'Preserves WebShop / ALFWorld bring-up, old-server assumptions, failed attempts, RTX6 artifacts, and parametric-evolution diagnosis. It no longer owns new experiment development.',
    ),
    href: `${seedRoot}/README.md`,
  },
  {
    state: t('已退休 · 迁移桥梁', 'Retired · migration bridge'),
    name: 'openevo-webshop',
    role: t('把 WebShop 参数进化从大仓库里单独抽出来', 'Isolated the WebShop parametric-evolution line from the larger workspace'),
    text: t(
      '沉淀 dataset adapter、SD-LoRA smoke / rollout、任务合同与“成功经验获取不足”的诊断；有用代码和结论已经迁入正式实验仓库。',
      'Curated the dataset adapter, SD-LoRA smoke / rollout path, task contracts, and the “insufficient successful experience” diagnosis; useful code and findings were migrated forward.',
    ),
    href: `${bridgeRoot}/README.md`,
  },
  {
    state: t('当前 · 唯一主线', 'Current · source of truth'),
    name: 'openevo-experiment',
    role: t('RTX 5090 上的正式 OpenEvo 实验仓库', 'The active OpenEvo experiment repository on RTX 5090'),
    text: t(
      '当前代码、任务 / prompt / parser 合同、Run Manifest、W&B tracking、实验 campaign 和后续结果都在这里继续。',
      'Current code, task / prompt / parser contracts, Run Manifests, W&B tracking, campaigns, and future results continue here.',
    ),
    href: `${activeRoot}/configs/experiment/current-campaign.json`,
  },
] as const;

const verified = [
  {
    label: t('真实模型', 'Real model'),
    title: 'Qwen2.5-3B-Instruct',
    text: t('RTX 5090 上完成真实 BF16 CUDA generation，固定模型 revision。', 'Real BF16 CUDA generation passed on RTX 5090 with the model revision pinned.'),
  },
  {
    label: t('真实参数变化', 'Real parameter change'),
    title: 'SD-LoRA optimizer steps',
    text: t('官方参数路径完成 forward / backward / optimizer.step；逻辑 trainable-state digest 发生变化。', 'The official parametric path completed forward/backward/optimizer.step and changed the logical trainable-state digest.'),
  },
  {
    label: t('真实累计状态', 'Real cumulative state'),
    title: t('2 components · effective rank 8', '2 components · effective rank 8'),
    text: t('prior adapter 被完整保留，第二个组件加入后可以 fresh reload，更新后的 digest 一致。', 'The prior adapter was preserved, a second component was added, and fresh reload reproduced the updated digest.'),
  },
  {
    label: t('模型行为确实变了', 'Model output really changed'),
    title: t('nonzero logit delta', 'nonzero logit delta'),
    text: t('held-out prompt 上出现有限非零 logit delta，至少一次 deterministic generation 在加载 adapter 后改变。', 'Held-out prompts showed finite nonzero logit deltas, and at least one deterministic generation changed after adapter load.'),
  },
] as const;

const phaseGArms = [
  {
    id: 'A',
    name: t('冻结 Base', 'Frozen base'),
    code: 'base',
    text: t('不加载 SD-LoRA adapter，作为同合同下的基线。', 'No SD-LoRA adapter loaded; this is the baseline under the same contract.'),
  },
  {
    id: 'B',
    name: t('单组件 Adapter', 'One-component adapter'),
    code: 'adapter1x',
    text: t('加载已经验证过的一代参数状态。', 'Loads the verified one-generation adapted state.'),
  },
  {
    id: 'C',
    name: t('累计 Adapter', 'Cumulative adapter'),
    code: 'cumulative',
    text: t('加载保留 prior component 后继续演化得到的累计状态。', 'Loads the cumulative state that preserves the prior component and continues evolution.'),
  },
] as const;
---

<section id="openevo-experiment-program" class="program" aria-labelledby="program-title" data-testid="openevo-experiment-program">
  <header class="program__header">
    <div>
      <p class="eyebrow">
        {t('OpenEvo × WebShop · 当前实验主线', 'OpenEvo × WebShop · current experiment mainline')}
        <span aria-hidden="true">·</span>
        <time datetime="2026-08-14">2026-08-14</time>
      </p>
      <h2 id="program-title">{t('实验已经从旧 3090 证据迁移到 RTX 5090；现在卡在 Phase G 正式比较之前', 'The experiment has moved from the old 3090 evidence base to RTX 5090; the current gate is just before formal Phase G comparison')}</h2>
      <p class="lede">{t('下面把 seed3090、openevo-webshop 和 openevo-experiment 放在同一条时间线上。重点不是“又多了一个仓库”，而是看研究问题怎样从工程闭环，推进到真正比较 base 与 adapter 的 WebShop 任务结果。', 'The three repositories belong on one timeline. The important change is not another repository: the research question has advanced from engineering closure to a real WebShop comparison of base and adapted states.')}</p>
    </div>
    <aside class="program__verdict" aria-label={t('当前状态', 'Current status')}>
      <span>{t('当前 campaign', 'Current campaign')}</span>
      <strong>Phase G · preflight</strong>
      <p>{t('正式任务消耗：尚未允许', 'Formal task consumption: not yet allowed')}</p>
    </aside>
  </header>

  <section class="lineage" aria-labelledby="lineage-title">
    <div class="section-heading">
      <span>01</span>
      <div>
        <small>{t('先看仓库为什么变了', 'First: why the repository changed')}</small>
        <h3 id="lineage-title">{t('三个仓库不是三条并行实验，而是一条逐步收敛的研究链', 'These are not three parallel experiments; they are one research line being consolidated')}</h3>
      </div>
    </div>
    <ol class="repo-track">
      {repositories.map((repo) => (
        <li>
          <span class="repo-state">{repo.state}</span>
          <code>{repo.name}</code>
          <strong>{repo.role}</strong>
          <p>{repo.text}</p>
          <a href={repo.href} target="_blank" rel="noreferrer">{t('查看来源', 'Open source')} <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ol>
    <aside class="archive-note">
      <strong>{t('阅读规则：退休 ≠ 失败，也 ≠ 删除', 'Reading rule: retired ≠ failed, and retired ≠ deleted')}</strong>
      <p>{t('旧仓库继续负责 provenance。新结论以 openevo-experiment 为准；旧 SHA、raw attempts 和失败轨迹仍然可以用于追溯，但不要从旧仓库重新启动实验。', 'Retired repositories remain provenance sources. New claims are governed by openevo-experiment; old SHAs, raw attempts, and failure traces remain traceable, but new experiments should not restart there.')}</p>
    </aside>
  </section>

  <section class="verified" aria-labelledby="verified-title">
    <div class="section-heading">
      <span>02</span>
      <div>
        <small>{t('RTX 5090 上已经确认了什么', 'What is already verified on RTX 5090')}</small>
        <h3 id="verified-title">{t('Phase D–F 已经证明 adapter 不是“保存了个文件而已”', 'Phase D–F shows the adapter is more than a file that happened to save')}</h3>
      </div>
    </div>
    <div class="verified-grid">
      {verified.map((item) => (
        <article>
          <span>{item.label}</span>
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
    <div class="claim-split">
      <article>
        <span aria-hidden="true">✓</span>
        <div>
          <strong>{t('机制证据已经够强', 'Mechanism evidence is strong')}</strong>
          <p>{t('真实 Qwen 推理、真实 optimizer steps、参数 digest 改变、fresh reload、累计 component 和 adapter-effect probe 都已经通过。', 'Real Qwen inference, optimizer steps, changed parameter digests, fresh reload, cumulative components, and an adapter-effect probe have all passed.')}</p>
        </div>
      </article>
      <article>
        <span aria-hidden="true">×</span>
        <div>
          <strong>{t('但还没有 WebShop 效果结论', 'But there is still no WebShop efficacy result')}</strong>
          <p>{t('这些证据不证明 reward 提升、held-out success、多 seed 稳定性、泛化、抗遗忘，更不证明 OpenEvo 优于 SEED。', 'None of this proves reward improvement, held-out success, multi-seed stability, generalization, retention, or superiority over SEED.')}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="bottleneck" aria-labelledby="bottleneck-title">
    <div class="section-heading">
      <span>03</span>
      <div>
        <small>{t('旧 WebShop 仓库留下的关键诊断', 'The key diagnosis inherited from the retired WebShop repository')}</small>
        <h3 id="bottleneck-title">{t('真正的历史瓶颈不是 parser，而是自采样几乎拿不到成功经验', 'The historical bottleneck was not mainly the parser; self-rollout rarely acquired successful experience')}</h3>
      </div>
    </div>
    <div class="attempts" role="group" aria-label={t('三轮 30 次尝试诊断', 'Three 30-attempt diagnostics')}>
      <article><span>{t('初始采样', 'Initial harvest')}</span><strong>0 / 30</strong><p>{t('正 reward 轨迹', 'positive trajectories')}</p><small>26 complete-zero · 4 fallback</small></article>
      <article><span>{t('首步 prefix ablation', 'First-step prefix ablation')}</span><strong>0 / 30</strong><p>{t('正 reward 轨迹', 'positive trajectories')}</p><small>25 complete-zero · 5 fallback</small></article>
      <article><span>{t('parser-safe retry', 'parser-safe retry')}</span><strong>0 / 30</strong><p>{t('正 reward 轨迹', 'positive trajectories')}</p><small>29 complete-zero · 1 fallback</small></article>
    </div>
    <p class="bottleneck__meaning">{t('parser-safe retry 明显减少了 malformed action，但仍没有得到正 reward。因此“parser reliability 是次要问题；当前 self-acquired rollout 缺少成功经验”是历史上更强的诊断。这个结论只针对当时的自采样路线，不能自动外推到 teacher-trajectory 训练，也不能当作当前 Phase G 的负结果。', 'Parser-safe retry reduced malformed actions but still produced no positive reward. The stronger historical diagnosis is therefore that parser reliability was secondary and the self-acquired rollout route lacked successful experience. That finding is scoped to the old self-rollout route; it does not automatically apply to teacher-trajectory training and is not a negative Phase G result.')}</p>
  </section>

  <section class="phase-g" aria-labelledby="phase-g-title">
    <div class="section-heading">
      <span>04</span>
      <div>
        <small>{t('现在真正要比较什么', 'What the current experiment will actually compare')}</small>
        <h3 id="phase-g-title">{t('Phase G：同一 WebShop 合同下比较三种模型状态', 'Phase G: compare three model states under one frozen WebShop contract')}</h3>
      </div>
    </div>

    <div class="phase-g__contract">
      <div><span>{t('split', 'split')}</span><strong>promotion-dev</strong></div>
      <div><span>{t('环境 seed', 'environment seed')}</span><strong>2026</strong></div>
      <div><span>{t('goal indices', 'goal indices')}</span><strong>6680 · 2590</strong></div>
      <div><span>{t('generation seeds', 'generation seeds')}</span><strong>202652 · 202653</strong></div>
    </div>

    <ol class="arm-track">
      {phaseGArms.map((arm) => (
        <li>
          <b>{arm.id}</b>
          <div><span>{arm.name}</span><code>{arm.code}</code><p>{arm.text}</p></div>
        </li>
      ))}
    </ol>

    <div class="matrix">
      <div>
        <span>{t('冻结矩阵', 'Frozen matrix')}</span>
        <strong>2 goals × 2 generation seeds × 3 arms</strong>
      </div>
      <div class="matrix__count">
        <strong>12</strong>
        <span>{t('正式 episodes', 'formal episodes')}</span>
      </div>
    </div>

    <aside class="gate">
      <span>{t('当前门槛', 'Current gate')}</span>
      <strong>{t('formal_task_consumption_allowed = false', 'formal_task_consumption_allowed = false')}</strong>
      <p>{t('先完成 G0：冻结真实 WebShop evaluation contract；再完成 G1：冻结 exact base / adapter identities。两项都通过以后，才允许消费这 12 个 promotion-dev episodes。', 'First pass G0 by reconciling and freezing the real WebShop evaluation contract; then pass G1 by freezing exact base/adapter identities. Only after both pass may the 12 promotion-dev episodes be consumed.')}</p>
    </aside>
  </section>

  <section class="tracking" aria-labelledby="tracking-title">
    <div class="section-heading">
      <span>05</span>
      <div>
        <small>{t('可复现与可观察，但不能污染科学变量', 'Observable and reproducible without contaminating scientific variables')}</small>
        <h3 id="tracking-title">{t('W&B 在线 host gate 已通过；它负责看实验，不负责改变实验', 'The live W&B host gate passed; tracking observes the experiment, it does not define the experiment')}</h3>
      </div>
    </div>
    <div class="tracking-grid">
      <article><span>{t('campaign / W&B group', 'campaign / W&B group')}</span><code>20260814-1431-phaseg-base-vs-adapters</code></article>
      <article><span>{t('验证版本', 'Validated SDK')}</span><code>wandb==0.26.1</code></article>
      <article><span>{t('live smoke', 'live smoke')}</span><strong>2 optimizer steps · PASS</strong></article>
      <article><span>{t('正式 Phase G tasks', 'formal Phase G tasks')}</span><strong>{t('0 个被消费', '0 consumed')}</strong></article>
    </div>
    <p class="tracking__rule">{t('Run Manifest / 本地 JSON evidence 仍是权威 provenance。W&B 不允许改变 task、prompt、parser、evaluator、seed、SD-LoRA objective、训练数据或 optimizer 设置；runtime/tracking failure 也不能被解释成科学负结果。', 'Run Manifests and local JSON evidence remain canonical provenance. W&B must not change tasks, prompts, parser, evaluator, seeds, the SD-LoRA objective, training data, or optimizer settings; runtime/tracking failures are not scientific negative results.')}</p>
  </section>

  <aside class="history-boundary">
    <div>
      <span>{t('下面为什么还保留 seed3090 的旧结果？', 'Why keep the older seed3090 results below?')}</span>
      <strong>{t('因为它们回答的是“我们怎么走到这里”，不是“今天的实验跑到哪里”。', 'Because they explain how we got here, not where today’s live experiment currently stands.')}</strong>
    </div>
    <p>{t('下面的 0 → 0.429 → 0、gen2 回退和早期 SD-LoRA 诊断继续作为历史证据保留；当前状态以本区的 openevo-experiment Phase G campaign 为准。', 'The older 0 → 0.429 → 0 sequence, gen2 regression, and early SD-LoRA diagnosis remain useful historical evidence. Current status is governed by the openevo-experiment Phase G campaign above.')}</p>
  </aside>

  <footer class="sources">
    <div>
      <strong>{t('三层来源', 'Three-layer sources')}</strong>
      <p>{t('旧仓库负责 provenance；当前 campaign、运行合同和新结论以 openevo-experiment 为准。', 'Retired repositories preserve provenance; the current campaign, runtime contract, and new claims are governed by openevo-experiment.')}</p>
    </div>
    <nav aria-label={t('OpenEvo 实验来源', 'OpenEvo experiment sources')}>
      <a href={`${seedRoot}/README.md`} target="_blank" rel="noreferrer">seed3090 <span aria-hidden="true">↗</span></a>
      <a href={`${bridgeRoot}/docs/CURRENT_FINDINGS.md`} target="_blank" rel="noreferrer">openevo-webshop <span aria-hidden="true">↗</span></a>
      <a href={`${activeRoot}/docs/evidence/RTX5090_PHASE_D_F_2026-08-14.md`} target="_blank" rel="noreferrer">Phase D–F <span aria-hidden="true">↗</span></a>
      <a href={`${activeRoot}/configs/experiment/current-campaign.json`} target="_blank" rel="noreferrer">Phase G campaign <span aria-hidden="true">↗</span></a>
      <a href={`${activeRoot}/docs/evidence/WANDB_LIVE_INTEGRATION_2026-08-14.md`} target="_blank" rel="noreferrer">W&B gate <span aria-hidden="true">↗</span></a>
    </nav>
  </footer>
</section>

<style>
  .program { width: min(1180px, calc(100% - 2rem)); margin: 4rem auto 6rem; }
  .program__header { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(240px, .5fr); gap: 2rem; align-items: end; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .eyebrow, .section-heading small, .program__verdict span, .repo-state, .verified-grid span, .phase-g__contract span, .matrix span, .gate > span, .tracking-grid span, .history-boundary span { color: var(--muted); font-size: .76rem; font-weight: 820; letter-spacing: .055em; }
  h2 { max-width: 18ch; margin: .7rem 0 1rem; font-size: clamp(2.2rem, 5vw, 4.7rem); line-height: 1.02; letter-spacing: -.045em; }
  .lede { max-width: 72ch; margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.75; }
  .program__verdict { padding: 1.25rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .program__verdict strong { display: block; margin: .5rem 0; font-size: 1.35rem; }
  .program__verdict p { margin: 0; color: var(--muted); line-height: 1.55; }
  .lineage, .verified, .bottleneck, .phase-g, .tracking { margin-top: 4.5rem; }
  .section-heading { display: grid; grid-template-columns: 2rem minmax(0,1fr); gap: 1rem; align-items: start; margin-bottom: 1.5rem; }
  .section-heading > span { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--line); border-radius: 50%; font-size: .75rem; font-weight: 850; }
  .section-heading h3 { max-width: 28ch; margin: .3rem 0 0; font-size: clamp(1.65rem, 3vw, 2.65rem); line-height: 1.12; letter-spacing: -.025em; }
  .repo-track { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; padding: 0; margin: 0; }
  .repo-track li { position: relative; display: flex; flex-direction: column; min-height: 260px; padding: 1.25rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .repo-track li:not(:last-child)::after { content: ''; position: absolute; z-index: 2; top: 50%; right: -1.05rem; width: 1.1rem; height: 1px; background: var(--line); }
  .repo-track li:not(:last-child)::before { content: ''; position: absolute; z-index: 3; top: calc(50% - 3px); right: -1.05rem; width: 6px; height: 6px; border-top: 1px solid var(--muted); border-right: 1px solid var(--muted); transform: rotate(45deg); }
  .repo-track code { display: inline-block; width: fit-content; margin: .65rem 0 .8rem; font-size: .9rem; }
  .repo-track strong { font-size: 1.08rem; line-height: 1.35; }
  .repo-track p { flex: 1; color: var(--muted); line-height: 1.65; }
  .repo-track a, .sources a { width: fit-content; font-weight: 760; text-decoration: none; }
  .archive-note, .gate, .history-boundary { margin-top: 1rem; padding: 1.2rem 1.35rem; border: 1px solid var(--line); border-radius: 18px; background: color-mix(in srgb, var(--surface) 80%, transparent); }
  .archive-note p, .gate p, .history-boundary p, .tracking__rule, .bottleneck__meaning { margin-bottom: 0; color: var(--muted); line-height: 1.7; }
  .verified-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1rem; }
  .verified-grid article, .attempts article, .tracking-grid article { padding: 1.2rem; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .verified-grid strong { display: block; margin: .55rem 0; font-size: 1.05rem; }
  .verified-grid p { margin: 0; color: var(--muted); line-height: 1.6; }
  .claim-split { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .claim-split article { display: grid; grid-template-columns: auto 1fr; gap: .9rem; padding: 1.15rem; border-top: 2px solid var(--line); background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .claim-split article > span { font-size: 1.15rem; font-weight: 900; }
  .claim-split p { margin: .35rem 0 0; color: var(--muted); line-height: 1.62; }
  .attempts { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  .attempts strong { display: block; margin: .55rem 0 .15rem; font-size: clamp(2rem, 5vw, 3.4rem); letter-spacing: -.05em; }
  .attempts p { margin: 0; font-weight: 750; }
  .attempts small { display: block; margin-top: .7rem; color: var(--muted); }
  .phase-g__contract { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: .75rem; margin-bottom: 1rem; }
  .phase-g__contract div { padding: .9rem 1rem; border-top: 1px solid var(--line); }
  .phase-g__contract strong { display: block; margin-top: .35rem; }
  .arm-track { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; padding: 0; margin: 0; }
  .arm-track li { display: grid; grid-template-columns: 2.2rem 1fr; gap: .85rem; padding: 1.2rem; border: 1px solid var(--line); border-radius: 18px; }
  .arm-track b { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--surface); }
  .arm-track span { display: block; font-weight: 820; }
  .arm-track code { display: inline-block; margin-top: .35rem; }
  .arm-track p { margin: .7rem 0 0; color: var(--muted); line-height: 1.6; }
  .matrix { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; margin-top: 1rem; padding: 1.25rem 1.4rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .matrix > div:first-child strong { display: block; margin-top: .35rem; font-size: 1.15rem; }
  .matrix__count { text-align: right; }
  .matrix__count strong { display: block; font-size: 2.4rem; line-height: 1; }
  .gate strong { display: block; margin: .45rem 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; overflow-wrap: anywhere; }
  .tracking-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: .75rem; }
  .tracking-grid code, .tracking-grid strong { display: block; margin-top: .5rem; overflow-wrap: anywhere; }
  .history-boundary { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 1.5rem; margin-top: 4.5rem; }
  .history-boundary strong { display: block; margin-top: .4rem; font-size: 1.2rem; line-height: 1.4; }
  .history-boundary p { margin: 0; }
