---
import { localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  context?: 'benchmark' | 'reproduction';
}

type TurnRole = 'task' | 'environment' | 'agent' | 'evaluator';

interface Turn {
  role: TurnRole;
  title: string;
  body: string;
  code?: string;
  note?: string;
}

interface Scenario {
  id: 'webshop' | 'alfworld';
  index: string;
  name: string;
  kind: string;
  goal: string;
  turns: Turn[];
}

const { locale, context = 'benchmark' } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const roleLabels: Record<TurnRole, string> = {
  task: t('任务', 'Task'),
  environment: t('环境', 'Environment'),
  agent: t('模型', 'Model'),
  evaluator: t('评分', 'Evaluator'),
};

const scenarios: Scenario[] = [
  {
    id: 'webshop',
    index: '01',
    name: 'WebShop',
    kind: t('网页购物任务', 'Web-shopping task'),
    goal: t('把商品要求变成搜索、点击和选项选择。', 'Turn product constraints into search, clicks, and option selection.'),
    turns: [
      {
        role: 'task',
        title: t('收到购物要求', 'Receive the shopping request'),
        body: t('寻找男款黑色防水徒步鞋，尺码 10，价格不超过 100 美元。', 'Find a men’s black waterproof hiking shoe in size 10 for no more than $100.'),
        note: t('交互示意，不是 benchmark 实测结果。', 'Illustrative interaction, not a measured benchmark result.'),
      },
      {
        role: 'environment',
        title: t('首页返回搜索框', 'The home page returns a search box'),
        body: t('此时还没有商品信息，模型只能先根据要求生成搜索词。', 'No product evidence exists yet, so the model must form a search query first.'),
      },
      {
        role: 'agent',
        title: t('模型生成搜索动作', 'The model emits a search action'),
        body: t('真实运行必须同时保存原始输出、解析后的动作和 fallback 标记。', 'A real run must preserve the raw output, parsed action, and fallback flag.'),
        code: 'search[men black waterproof hiking shoes size 10 under 100]',
      },
      {
        role: 'environment',
        title: t('搜索结果返回候选商品', 'Search results return candidate products'),
        body: t('页面显示不同价格和属性的商品；模型需要排除超预算或缺少防水属性的候选。', 'The page shows products with different prices and attributes; the model must reject over-budget or non-waterproof candidates.'),
      },
      {
        role: 'agent',
        title: t('模型打开商品并选择颜色与尺码', 'The model opens a product and selects color and size'),
        body: t('每次点击都会产生新的页面状态，下一步动作必须使用最新观察。', 'Every click creates a new page state, and the next action must use the latest observation.'),
        code: 'click[TrailGuard Mid] · click[Black] · click[Size 10] · click[Buy Now]',
      },
      {
        role: 'evaluator',
        title: t('评分器检查所有要求', 'The evaluator checks every requirement'),
        body: t('全部属性一致才算 exact success；部分满足只进入 normalized score。', 'All attributes must match for exact success; partial matches contribute only to normalized score.'),
        note: t('同时保存错误点击、循环、fallback 和步骤数，才能解释分数。', 'Save wrong clicks, loops, fallbacks, and step count so the score remains explainable.'),
      },
    ],
  },
  {
    id: 'alfworld',
    index: '02',
    name: 'ALFWorld',
    kind: t('文本化具身任务', 'Text-based embodied task'),
    goal: t('记住物体状态和前置条件，按正确顺序完成多步动作。', 'Track object state and prerequisites through a correct multi-step action sequence.'),
    turns: [
      {
        role: 'task',
        title: t('收到具身任务', 'Receive the embodied task'),
        body: t('把苹果加热，然后放到餐桌上。', 'Heat the apple, then place it on the dining table.'),
        note: t('交互示意，不是 benchmark 实测结果。', 'Illustrative interaction, not a measured benchmark result.'),
      },
      {
        role: 'environment',
        title: t('环境描述厨房状态', 'The environment describes the kitchen state'),
        body: t('冰箱关闭，微波炉和餐桌可见，苹果尚不可见。', 'The refrigerator is closed, the microwave and table are visible, and the apple is not yet visible.'),
      },
      {
        role: 'agent',
        title: t('模型先打开冰箱', 'The model opens the refrigerator first'),
        body: t('如果容器没有打开，直接拿苹果会成为无效动作。', 'Taking the apple before opening the receptacle would be invalid.'),
        code: 'open fridge 1',
      },
      {
        role: 'environment',
        title: t('新观察显示苹果可拿取', 'The new observation shows that the apple can be taken'),
        body: t('环境状态变化后，可执行动作也发生变化。', 'As the environment state changes, the valid action set changes too.'),
      },
      {
        role: 'agent',
        title: t('模型依次拿取、加热并放置苹果', 'The model picks up, heats, and places the apple in order'),
        body: t('模型需要持续记住苹果位置、是否已加热，以及微波炉是否可用。', 'The model must retain the apple location, whether it is heated, and whether the microwave is usable.'),
        code: 'take apple 1 from fridge 1 · heat apple 1 with microwave 1 · put apple 1 on diningtable 1',
      },
      {
        role: 'evaluator',
        title: t('评分器检查最终环境状态', 'The evaluator checks the final environment state'),
        body: t('苹果已加热且位于餐桌上时才算成功；循环、状态遗漏、无效动作和超步数单独记录。', 'Success requires the apple to be heated and placed on the table; loops, missed state, invalid actions, and step exhaustion are recorded separately.'),
        note: t('按任务家族报告成功率，再计算不加权宏平均。', 'Report success by task family, then compute an unweighted macro-average.'),
      },
    ],
  },
];

const engineFlows = [
  {
    id: 'seed',
    name: 'SEED',
    when: t('训练轮内', 'Within a training round'),
    title: t('从完整轨迹生成 skill，再更新模型参数', 'Generate a skill from a completed trajectory, then update model parameters'),
    updated: t('更新对象：policy 参数', 'Updated object: policy parameters'),
    activation: t('生效边界：下一次 policy update 后', 'Activation boundary: after the next policy update'),
    steps: [
      t('当前 policy 收集 on-policy 轨迹', 'The current policy collects an on-policy trajectory'),
      t('同一 checkpoint 总结 hindsight skill', 'The same checkpoint summarizes a hindsight skill'),
      t('固定原动作并在普通 / skill context 下重打分', 'Keep the sampled actions fixed and re-score ordinary / skill contexts'),
      t('GRPO 与 OPD 联合优化新的 policy', 'GRPO and OPD jointly optimize the new policy'),
    ],
  },
  {
    id: 'openevo',
    name: 'OpenEvo',
    when: t('任务结束后', 'After task completion'),
    title: t('保存任务证据，生成下一次任务要加载的版本', 'Save task evidence and create the version loaded by a later task'),
    updated: t('更新对象：memory / skill / agent-system artifact / revision', 'Updated object: memory / skill / agent-system artifact / revision'),
    activation: t('生效边界：后续任务加载 successor revision 时', 'Activation boundary: when a later task loads the successor revision'),
    steps: [
      t('在固定 Project Head 下完成 episode / session', 'Complete the episode/session under a pinned Project Head'),
      t('封存 transcript、分数和失败记录', 'Seal the transcript, score, and failure record'),
      t('运行明确的 evolution method 并保存版本化 artifact', 'Run an identified evolution method and save a versioned artifact'),
      t('验证 successor revision，并让后续任务加载', 'Validate the successor revision and let a later task load it'),
    ],
  },
];

const intro = context === 'reproduction'
  ? {
      label: t('运行前先看一条完整过程', 'Read one complete run before executing it'),
      title: t('逐步查看 WebShop 与 ALFWorld 如何接收动作并返回结果', 'See how WebShop and ALFWorld receive actions and return results, step by step'),
      body: t('每条示意过程都分开显示任务、环境观察、模型动作和评分。真实复现还必须保存原始模型输出、解析动作、fallback、reward、结束原因和更新文件。', 'Each illustration separates the task, environment observation, model action, and evaluation. A real reproduction must also save raw model output, parsed action, fallback, reward, termination reason, and update files.'),
    }
  : {
      label: t('两个环境怎样运行', 'How the two environments run'),
      title: t('逐步查看任务、环境观察、模型动作和评分', 'See the task, environment observation, model action, and evaluation step by step'),
      body: t('下面两条过程只解释交互结构，不代表已经得到实验结果。', 'The two sequences below explain the interaction structure and do not claim completed experiment results.'),
    };
---

<section class:list={['trajectory-lab', `trajectory-lab--${context}`]} aria-labelledby={`trajectory-title-${context}`} data-agent-trajectory>
  <header class="trajectory-lab__header">
    <div>
      <span>{intro.label}</span>
      <h2 id={`trajectory-title-${context}`}>{intro.title}</h2>
      <p>{intro.body}</p>
    </div>
    <aside aria-label={t('内容状态', 'Content status')}>
      <strong>{t('交互示意', 'Illustrative interaction')}</strong>
      <small>{t('不是 benchmark 实测结果', 'Not a measured benchmark result')}</small>
    </aside>
  </header>

  <div class="trajectory-scenarios">
    {scenarios.map((scenario, index) => (
      <details class="trajectory-scenario" open={index === 0}>
        <summary>
          <span>{scenario.index}</span>
          <div><small>{scenario.kind}</small><strong>{scenario.name}</strong></div>
          <p>{scenario.goal}</p>
          <i aria-hidden="true"></i>
        </summary>
        <div class="trajectory-scenario__body">
          <ol class="trajectory-dialogue">
            {scenario.turns.map((turn, turnIndex) => (
              <li class:list={['trajectory-turn', `trajectory-turn--${turn.role}`]}>
                <div class="trajectory-turn__meta"><span>{String(turnIndex + 1).padStart(2, '0')}</span><strong>{roleLabels[turn.role]}</strong></div>
                <article>
                  <h3>{turn.title}</h3>
                  <p>{turn.body}</p>
                  {turn.code && <code>{turn.code}</code>}
                  {turn.note && <small>{turn.note}</small>}
                </article>
              </li>
            ))}
          </ol>
        </div>
      </details>
    ))}
  </div>

  <section class="evolution-bridge" aria-labelledby={`evolution-bridge-title-${context}`}>
    <header>
      <span>{t('同一条任务记录，两种更新方式', 'One task record, two update methods')}</span>
      <h3 id={`evolution-bridge-title-${context}`}>{t('比较 SEED 更新模型参数与 OpenEvo 更新外部载体', 'Compare SEED parameter updates with OpenEvo external-carrier updates')}</h3>
      <p>{t('只有新对象被创建、验证，并在规定时间被下一轮或下一次任务加载，才能证明更新真正生效。', 'An update is proven only when the new object is created, validated, and loaded at the defined next round or later task.')}</p>
    </header>
    <div class="evolution-bridge__grid">
      {engineFlows.map((flow) => (
        <article class:list={['evolution-flow', `evolution-flow--${flow.id}`]}>
          <header><div><span>{flow.when}</span><strong>{flow.name}</strong></div><h4>{flow.title}</h4></header>
          <ol>{flow.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}</ol>
          <dl><div><dt>{t('改变什么', 'What changes')}</dt><dd>{flow.updated}</dd></div><div><dt>{t('何时生效', 'When it activates')}</dt><dd>{flow.activation}</dd></div></dl>
        </article>
      ))}
    </div>
  </section>

  <footer class="trajectory-lab__footer">
    <div><strong>{t('真实运行要保存的材料', 'Artifacts to save from a real run')}</strong><span>{t('observation、raw model output、parsed action、fallback、reward、termination、evolution input/output 和激活 revision。', 'observation, raw model output, parsed action, fallback, reward, termination, evolution input/output, and activated revision.')}</span></div>
    <nav aria-label={t('下一步', 'Next steps')}><a href={p('/guide/openevo-webshop-alfworld/')}>{t('开始复现', 'Start reproduction')}</a><a href={p('/research/seed-openevo/loops/')}>{t('比较更新方式', 'Compare update methods')}</a><a href={p('/research/seed-openevo/results/')}>{t('查看结果要求', 'View result requirements')}</a></nav>
  </footer>
</section>

<style>
  .trajectory-lab{--a:var(--accent-deep,var(--accent));width:min(1180px,calc(100% - 2rem));margin:clamp(2rem,5vw,4.5rem) auto;padding:clamp(1rem,2.5vw,2rem);border:1px solid var(--line);border-radius:22px;background:var(--surface)}
  .trajectory-lab__header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;padding:.5rem .25rem 1.5rem}.trajectory-lab__header>div>span,.evolution-bridge>header>span{color:var(--a);font-size:.72rem;font-weight:800}.trajectory-lab__header h2{max-width:22ch;margin:.6rem 0 .7rem;font-size:clamp(1.65rem,3.3vw,3rem);line-height:1.08}.trajectory-lab__header p,.evolution-bridge>header p{max-width:72ch;margin:0;color:var(--muted);line-height:1.7}.trajectory-lab__header aside{display:grid;gap:.2rem;min-width:210px;padding:.8rem 1rem;border:1px solid var(--line);border-radius:12px}.trajectory-lab__header aside strong{font-size:.82rem}.trajectory-lab__header aside small{color:var(--muted);font-size:.7rem}
  .trajectory-scenarios{display:grid;gap:.7rem}.trajectory-scenario{overflow:hidden;border:1px solid var(--line);border-radius:15px;background:color-mix(in srgb,var(--surface) 95%,var(--bg))}.trajectory-scenario summary{display:grid;grid-template-columns:auto minmax(130px,.55fr) minmax(0,1.45fr) 24px;gap:1rem;align-items:center;min-height:72px;padding:.9rem 1rem;cursor:pointer;list-style:none}.trajectory-scenario summary::-webkit-details-marker{display:none}.trajectory-scenario[open] summary{border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--a) 5%,transparent)}.trajectory-scenario summary>span{color:var(--a);font:800 .7rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.trajectory-scenario summary small,.trajectory-scenario summary strong{display:block}.trajectory-scenario summary small{color:var(--muted);font-size:.68rem}.trajectory-scenario summary strong{margin-top:.15rem}.trajectory-scenario summary p{margin:0;font-size:.82rem;line-height:1.5}.trajectory-scenario summary i{position:relative;width:20px;height:20px}.trajectory-scenario summary i:before,.trajectory-scenario summary i:after{content:'';position:absolute;top:50%;left:50%;width:11px;height:1.5px;background:var(--a);transform:translate(-50%,-50%)}.trajectory-scenario summary i:after{transform:translate(-50%,-50%) rotate(90deg)}.trajectory-scenario[open] summary i:after{transform:translate(-50%,-50%)}
  .trajectory-scenario__body{padding:1rem}.trajectory-dialogue{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.trajectory-turn{display:grid;grid-template-columns:82px minmax(0,1fr);gap:.8rem}.trajectory-turn__meta{display:grid;align-content:start;gap:.25rem;padding-top:.65rem}.trajectory-turn__meta span{color:var(--a);font:800 .64rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.trajectory-turn__meta strong{font-size:.7rem}.trajectory-turn article{padding:.8rem .9rem;border:1px solid var(--line);border-radius:12px}.trajectory-turn h3{margin:0;font-size:.88rem}.trajectory-turn p{margin:.4rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.58}.trajectory-turn code{display:block;margin-top:.65rem;padding:.65rem;border-radius:8px;background:var(--surface-muted);overflow-wrap:anywhere}.trajectory-turn article>small{display:block;margin-top:.55rem;color:var(--warning);font-size:.7rem;line-height:1.5}
  .evolution-bridge{margin-top:2.2rem;padding-top:2rem;border-top:1px solid var(--line)}.evolution-bridge>header h3{max-width:28ch;margin:.55rem 0 .65rem;font-size:clamp(1.4rem,2.7vw,2.35rem);line-height:1.12}.evolution-bridge__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:1rem}.evolution-flow{padding:1rem;border:1px solid var(--line);border-radius:15px}.evolution-flow header>div{display:flex;justify-content:space-between;gap:1rem}.evolution-flow header span{color:var(--muted);font-size:.7rem}.evolution-flow h4{margin:.65rem 0;font-size:1rem}.evolution-flow ol{display:grid;gap:.4rem;margin:0;padding:0;list-style:none}.evolution-flow li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:.5rem;padding:.5rem 0;border-top:1px solid var(--line)}.evolution-flow li span{color:var(--a);font:800 .62rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.evolution-flow li p{margin:0;font-size:.76rem;line-height:1.5}.evolution-flow dl{display:grid;gap:.5rem;margin:1rem 0 0}.evolution-flow dl div{padding:.65rem;border-radius:9px;background:var(--surface-muted)}.evolution-flow dt{color:var(--muted);font-size:.66rem}.evolution-flow dd{margin:.25rem 0 0;font-size:.74rem;line-height:1.5}
  .trajectory-lab__footer{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end;margin-top:1.4rem;padding-top:1.2rem;border-top:1px solid var(--line)}.trajectory-lab__footer strong,.trajectory-lab__footer span{display:block}.trajectory-lab__footer span{margin-top:.3rem;color:var(--muted);font-size:.75rem;line-height:1.55}.trajectory-lab__footer nav{display:flex;flex-wrap:wrap;gap:.5rem}.trajectory-lab__footer a{padding:.55rem .7rem;border:1px solid var(--line);border-radius:9px;color:inherit;font-size:.72rem;font-weight:700;text-decoration:none}
  @media(max-width:760px){.trajectory-lab{width:min(100% - 1rem,1180px);border-radius:16px}.trajectory-lab__header,.trajectory-lab__footer{grid-template-columns:1fr}.trajectory-lab__header aside{min-width:0}.trajectory-scenario summary{grid-template-columns:auto minmax(0,1fr) 22px}.trajectory-scenario summary>p{grid-column:2}.trajectory-turn{grid-template-columns:1fr;gap:.2rem}.trajectory-turn__meta{display:flex;padding-top:.3rem}.evolution-bridge__grid{grid-template-columns:1fr}}
</style>
