---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const flows = [
  { name:'SEED', tag:t('参数学习','Parameter learning'), update:t('policy 参数','policy parameters'), steps:[t('on-policy trajectory','on-policy trajectory'),t('hindsight skill','hindsight skill'),t('re-score','re-score'),t('GRPO + OPD','GRPO + OPD'),t('new checkpoint','new checkpoint')] },
  { name:'OpenEvo', tag:t('跨任务演化','Cross-task evolution'), update:t('artifact / adapter / revision','artifact / adapter / revision'), steps:[t('completed task','completed task'),t('sealed evidence','sealed evidence'),t('evolution method','evolution method'),t('validation','validation'),t('successor revision','successor revision')] },
] as const;
---
<section class="mechanism-dialogues" aria-labelledby="mechanism-dialogues-title">
  <header><span>{t('数据流','Data flow')}</span><h2 id="mechanism-dialogues-title">{t('SEED 与 OpenEvo 数据流','SEED and OpenEvo data flow')}</h2><p>{t('先看输入、加工步骤、更新对象和生效边界，再进入实现细节。','Read inputs, processing stages, updated objects, and activation boundaries before implementation details.')}</p></header>
  <div class="flow-grid">{flows.map((flow)=><article><div class="flow-title"><span>{flow.tag}</span><strong>{flow.name}</strong></div><ol>{flow.steps.map((step,index)=><li><b>{String(index+1).padStart(2,'0')}</b><span>{step}</span>{index < flow.steps.length - 1 ? <i aria-hidden="true">↓</i> : null}</li>)}</ol><footer><span>{t('更新对象','Updated object')}</span><strong>{flow.update}</strong></footer></article>)}</div>
  <div class="read-grid"><article><strong>{t('什么在流动','What flows')}</strong><p>{t('任务、观察、动作、轨迹、训练信号与 artifact。','Tasks, observations, actions, trajectories, training signals, and artifacts.')}</p></article><article><strong>{t('什么被更新','What changes')}</strong><p>{t('SEED 更新 policy 参数；OpenEvo 依据 carrier 更新可跨任务复用的状态。','SEED updates policy parameters; OpenEvo updates reusable cross-task state according to the carrier.')}</p></article><article><strong>{t('何时生效','When it activates')}</strong><p>{t('都在明确完成边界之后进入下一轮，不在同一任务中途偷偷切换。','Both activate only after an explicit completion boundary, not by silently switching state mid-task.')}</p></article></div>
</section>
<style>
.mechanism-dialogues{width:min(1120px,calc(100% - 2rem));margin:2rem auto;padding:1rem;border:1px solid var(--line);border-radius:16px}.mechanism-dialogues>header{max-width:800px}.mechanism-dialogues>header>span{color:var(--accent-deep);font-size:.68rem;font-weight:800}.mechanism-dialogues h2{margin:.25rem 0 .45rem}.mechanism-dialogues>header p{margin:0;color:var(--muted);font-size:.76rem;line-height:1.5}.flow-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:1rem}.flow-grid>article{padding:.8rem;border:1px solid var(--line);border-radius:12px}.flow-title{display:flex;justify-content:space-between;gap:.5rem}.flow-title span{color:var(--muted);font-size:.66rem}.flow-title strong{color:var(--accent-deep);font-size:.76rem}.flow-grid ol{display:grid;gap:.25rem;margin:.7rem 0;padding:0;list-style:none}.flow-grid li{position:relative;display:grid;grid-template-columns:1.7rem 1fr;gap:.5rem;padding:.5rem;border:1px solid var(--line);border-radius:9px}.flow-grid li b{color:var(--accent-deep);font:800 .62rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.flow-grid li span{font-size:.7rem}.flow-grid li i{position:absolute;right:.55rem;bottom:-.38rem;color:var(--accent-deep);font-style:normal}.flow-grid footer{padding-top:.55rem;border-top:1px solid var(--line)}.flow-grid footer span,.flow-grid footer strong{display:block}.flow-grid footer span{color:var(--muted);font-size:.62rem}.flow-grid footer strong{margin-top:.25rem;font-size:.7rem}.read-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin-top:.6rem}.read-grid article{padding:.7rem;border-left:2px solid var(--accent-deep);background:var(--surface-muted)}.read-grid strong{font-size:.72rem}.read-grid p{margin:.3rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.45}@media(max-width:700px){.mechanism-dialogues{width:min(100% - 1rem,1120px)}.flow-grid,.read-grid{grid-template-columns:1fr}}
</style>
