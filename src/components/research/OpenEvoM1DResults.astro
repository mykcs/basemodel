---
import type { Locale } from '../../i18n';
import { OPEN_EVO_M1D_RESULTS } from '../../data/openEvoM1DResults';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const contract = OPEN_EVO_M1D_RESULTS.stage1;
---

<section class="m1d-results" data-testid="openevo-m1d-results" aria-labelledby="m1d-results-title">
  <header class="m1d-results__header">
    <div>
      <p>M1-D · RESULTS</p>
      <h2 id="m1d-results-title">{t('结果区已经就位，但在封存之前不展示分数', 'The results surface is ready, but scores stay hidden until the seals exist')}</h2>
    </div>
    <span class="m1d-results__state">{t('结果未封存', 'RESULTS UNSEALED')}</span>
  </header>

  <div class="m1d-results__notice" role="status">
    <strong>{t('为什么现在看不到分数？', 'Why are there no scores yet?')}</strong>
    <p>{t(
      'M1-D 的正式 Stage1 相位已经获得执行权，但网站只接受封存结果。1,440 条轨迹的 completion receipt 与 corpus SHA 出现之前，exact、平均分、invalid 等指标全部保持隐藏；MiniMax 也必须完成 1,440 / 1,440 parse_ok seal 后，才允许做 OpenEVO 3B 对比。',
      'The formal M1-D Stage1 phase is authorized, but the website accepts sealed outcomes only. Exact success, mean score, invalid rate, and related metrics remain hidden until the 1,440-trajectory completion receipt and corpus SHA exist. The OpenEVO 3B comparison is also blocked until MiniMax reaches a 1,440 / 1,440 parse_ok seal.'
    )}</p>
  </div>

  <section class="m1d-results__contract" aria-labelledby="m1d-contract-title">
    <header>
      <p>FROZEN CONTRACT</p>
      <h3 id="m1d-contract-title">{t('这块结果以后只能回答这一道题', 'This result block is allowed to answer one frozen question')}</h3>
    </header>
    <dl>
      <div><dt>{t('任务', 'Tasks')}</dt><dd>{contract.taskCount}</dd></div>
      <div><dt>{t('每题 rollout', 'Rollouts / task')}</dt><dd>× {contract.rolloutsPerTask}</dd></div>
      <div><dt>{t('总轨迹', 'Trajectories')}</dt><dd>{contract.trajectoryTarget}</dd></div>
      <div><dt>{t('最大步数', 'Max steps')}</dt><dd>{contract.maxSteps}</dd></div>
      <div><dt>History</dt><dd>{contract.historyLength}</dd></div>
      <div><dt>{t('世界 seed', 'World seed')}</dt><dd>{contract.worldSeed}</dd></div>
      <div><dt>SEED T</dt><dd>{contract.policyTemperature}</dd></div>
      <div><dt>SEED Stage2</dt><dd>{contract.stage2Budget}</dd></div>
    </dl>
    <p class="m1d-results__world">{t(
      `Matched WebShop world · ${contract.numProducts} products · ${contract.luceneIndex} · request-level sampling seed = none`,
      `Matched WebShop world · ${contract.numProducts} products · ${contract.luceneIndex} · request-level sampling seed = none`
    )}</p>
  </section>

  <section class="m1d-results__metrics" aria-labelledby="m1d-metrics-title">
    <header>
      <p>RESULT FIELDS</p>
      <h3 id="m1d-metrics-title">{t('封存后，这五项会首先出现', 'These five fields will appear first after sealing')}</h3>
    </header>
    <ul>
      {OPEN_EVO_M1D_RESULTS.resultMetrics.map((metric) => (
        <li>
          <span>{zh ? metric.zh : metric.en}</span>
          <strong>{t('等待 seal', 'AWAITING SEAL')}</strong>
        </li>
      ))}
    </ul>
  </section>

  <section class="m1d-results__gates" aria-labelledby="m1d-gates-title">
    <header>
      <p>PUBLICATION GATE</p>
      <h3 id="m1d-gates-title">{t('四道门全部通过，结果才会上站', 'All four gates must pass before results go public')}</h3>
    </header>
    <ol>
      {OPEN_EVO_M1D_RESULTS.publicationGates.map((gate, index) => (
        <li data-gate={gate.id}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{zh ? gate.zh : gate.en}</p>
        </li>
      ))}
    </ol>
  </section>

  <footer class="m1d-results__footer">
    <code>{OPEN_EVO_M1D_RESULTS.publicationState}</code>
    <span>{t('authority', 'authority')} · {OPEN_EVO_M1D_RESULTS.authorityCommit.slice(0, 8)} · release {OPEN_EVO_M1D_RESULTS.activationRelease}</span>
  </footer>
</section>

<style>
.m1d-results{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem;padding:1.35rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface);display:grid;gap:1.2rem}.m1d-results p{margin:0}.m1d-results__header{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.m1d-results__header>div>p,.m1d-results__contract header>p,.m1d-results__metrics header>p,.m1d-results__gates header>p{color:var(--accent-deep);font:800 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.m1d-results h2{max-width:820px;margin:.35rem 0 0;font-size:clamp(1.65rem,3.4vw,2.6rem);line-height:1.05;letter-spacing:-.04em}.m1d-results h3{margin:.3rem 0 0;font-size:1.15rem;line-height:1.3}.m1d-results__state{flex:none;padding:.4rem .6rem;border:1px solid var(--line);border-radius:999px;font:800 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.m1d-results__notice{padding:1rem;border-left:3px solid var(--accent);background:var(--surface-muted);display:grid;gap:.35rem}.m1d-results__notice p{max-width:920px;color:var(--muted);line-height:1.65}.m1d-results__contract,.m1d-results__metrics,.m1d-results__gates{display:grid;gap:.85rem;padding-top:1rem;border-top:1px solid var(--line)}.m1d-results__contract dl{margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem}.m1d-results__contract dl div{padding:.75rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface-muted)}.m1d-results__contract dt{color:var(--muted);font-size:.72rem;font-weight:800}.m1d-results__contract dd{margin:.2rem 0 0;font:800 1rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.m1d-results__world{color:var(--muted);font-size:.82rem;line-height:1.5}.m1d-results__metrics ul{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.55rem}.m1d-results__metrics li{min-width:0;padding:.8rem;border:1px solid var(--line);border-radius:var(--radius-panel);display:grid;gap:.45rem}.m1d-results__metrics li span{font-size:.82rem;line-height:1.35}.m1d-results__metrics li strong{color:var(--muted);font:750 .64rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}.m1d-results__gates ol{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.m1d-results__gates li{padding:.85rem;border:1px solid var(--line);border-radius:var(--radius-panel);display:grid;grid-template-columns:auto 1fr;gap:.7rem;align-items:start}.m1d-results__gates li>span{color:var(--accent-deep);font:800 .72rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.m1d-results__gates li p{color:var(--muted);font-size:.86rem;line-height:1.55}.m1d-results__footer{padding-top:.85rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:1rem;align-items:center}.m1d-results__footer code{font-size:.65rem;overflow-wrap:anywhere}.m1d-results__footer span{color:var(--muted);font:700 .7rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;text-align:right}@media(max-width:820px){.m1d-results__contract dl{grid-template-columns:repeat(2,minmax(0,1fr))}.m1d-results__metrics ul{grid-template-columns:repeat(2,minmax(0,1fr))}.m1d-results__metrics li:last-child{grid-column:1/-1}.m1d-results__gates ol{grid-template-columns:1fr}}@media(max-width:560px){.m1d-results{width:min(100% - 1rem,1120px);padding:1rem}.m1d-results__header,.m1d-results__footer{display:grid}.m1d-results__state{width:max-content}.m1d-results__footer span{text-align:left}.m1d-results__contract dl,.m1d-results__metrics ul{grid-template-columns:1fr}.m1d-results__metrics li:last-child{grid-column:auto}}
</style>
