---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);

const links = {
  oldStage1: p('/research/seed-openevo/study/capability-exploration/stage1-previous/'),
  stage1Compare: '#stage1-version-comparison',
  old3bSelf: p('/research/seed-openevo/study/results/3b-self-analysis/'),
  old7bSelf: p('/research/seed-openevo/study/results/7b-self-analysis/'),
  old3bMinimax: p('/research/seed-openevo/study/results/3b-minimax-analysis/'),
  old7bMinimax: p('/research/seed-openevo/study/results/7b-minimax-analysis/'),
  minimax: p('/research/seed-openevo/study/minimax-teacher/'),
  legacyStage2: p('/research/seed-openevo/study/capability-exploration/stage2-256-window/'),
  ceiling: p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/'),
  evo2: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/'),
  harness2: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/'),
};
const stories = [
  {
    id: 'old-3b-self',
    eyebrow: t('历史结局 · 3B / self','HISTORICAL OUTCOME · 3B / SELF'),
    title: t('3B 只靠自己：旧 Stage 2 完成了，但没有继续更新参数','3B on self experience: old Stage 2 completed without further parameter updates'),
    summary: t('Stage 1 没跨过当时的启动条件；旧 Stage 2 后来虽然出现成功轨迹，逐个 256 窗口判断仍然让更新次数保持为 0。','Stage 1 did not cross the historical start gate. Old Stage 2 later produced successful trajectories, but per-window gating still kept parameter updates at zero.'),
    facts: [t('Stage 1：4 条可训练成功轨迹，只来自 1 个重复成功任务','Stage 1: 4 trainable successes from only 1 repeatedly successful task'), t('旧 Stage 2：最好一批只有 2 / 8 个重复成功任务；20,480 次尝试、138 条可训练完整成功，仍是 0 次更新','Old Stage 2: the best batch reached only 2 / 8 repeatedly successful tasks; 20,480 attempts and 138 trainable exact successes still produced 0 updates'), t('最终 128 题：Task Score ×100 = 1.71；完整成功 1/128','Final 128 tasks: Task Score ×100 = 1.71; exact success 1/128')],
    href: links.old3bSelf,
  },
  {
    id: 'old-7b-self',
    eyebrow: t('历史结局 · 7B / self','HISTORICAL OUTCOME · 7B / SELF'),
    title: t('7B 只靠自己：Stage 1 学到了东西，旧 Stage 2 却停在原地','7B on self experience: Stage 1 learned, while old Stage 2 stayed frozen'),
    summary: t('Stage 1 实际做了 8 次 SD-LoRA 更新；旧 Stage 2 又收集了大量成功轨迹，但 256-window 门槛让后续参数更新仍然为 0。','Stage 1 made eight real SD-LoRA updates. Old Stage 2 then collected many successful trajectories, but the 256-window rule still yielded zero further parameter updates.'),
    facts: [t('Stage 1：8 次参数更新','Stage 1: 8 parameter updates'), t('旧 Stage 2：最好一批只有 7 / 8 个重复成功任务；20,480 次尝试、797 条可训练完整成功，仍是 0 次更新','Old Stage 2: the best batch reached only 7 / 8 repeatedly successful tasks; 20,480 attempts and 797 trainable exact successes still produced 0 updates'), t('固定 128 题平均分：13.33 → 25.66；完整成功 3 → 4','Fixed 128-task mean score: 13.33 → 25.66; exact success 3 → 4')],
    href: links.old7bSelf,
  },
  {
    id: 'old-3b-minimax',
    eyebrow: t('历史结局 · 3B / MiniMax','HISTORICAL OUTCOME · 3B / MINIMAX'),
    title: t('3B + MiniMax：启动训练做了 8 次更新，但旧 Stage 2 在 74.58% 时停止','3B + MiniMax: eight bootstrap updates, then the old Stage 2 stopped at 74.58%'),
    summary: t('MiniMax 的任务后分析帮助 3B 完成了启动训练；进入旧 Stage 2 后仍然难以在单个 256 窗口里凑齐旧门槛，实验后来主动停止。','Post-episode MiniMax analysis helped 3B complete bootstrap training. In the old Stage 2, the model still rarely met the historical per-window gate, and the run was explicitly stopped.'),
    facts: [t('启动训练：8 次参数更新','Bootstrap training: 8 parameter updates'), t('旧 Stage 2：最好一批只有 1 / 8 个重复成功任务；59 个完整批次全部 0 次更新，第 60 批跑到 171 条时停止','Old Stage 2: the best batch reached only 1 / 8 repeatedly successful tasks; all 59 complete batches had 0 updates, and batch 60 stopped after 171 attempts'), t('没有封存 final eval，不能把“未运行”写成 0 分','No sealed final evaluation; “not run” must not be reported as zero')],
    href: links.old3bMinimax,
  },
  {
    id: 'old-7b-minimax',
    eyebrow: t('历史结局 · 7B / MiniMax','HISTORICAL OUTCOME · 7B / MINIMAX'),
    title: t('7B + MiniMax：启动训练完成 8 次更新，旧 Stage 2 仍然 0 次更新','7B + MiniMax: eight bootstrap updates, but zero updates in the old Stage 2'),
    summary: t('旧 Stage 2 完整跑完 80 个批次；成功轨迹存在，但旧的逐批门槛始终没有让模型继续更新。','The old Stage 2 completed all 80 batches. Successful trajectories existed, but the historical per-batch gate never allowed another update.'),
    facts: [t('启动训练：8 次参数更新','Bootstrap training: 8 parameter updates'), t('旧 Stage 2：最好一批只有 7 / 8 个重复成功任务；20,480 次尝试、592 条可训练完整成功，仍是 0 次更新','Old Stage 2: the best batch reached only 7 / 8 repeatedly successful tasks; 20,480 attempts and 592 trainable exact successes still produced 0 updates'), t('最终 128 题：Task Score ×100 = 16.94；完整成功 0/128','Final 128 tasks: Task Score ×100 = 16.94; exact success 0/128')],
    href: links.old7bMinimax,
  },
  {
    id: 'ceiling',
    eyebrow: t('当前结局 · Ceiling-1.0','CURRENT OUTCOME · CEILING-1.0'),
    title: t('Ceiling-1.0：保留 corrected Stage 1，把 Stage 2 改成按轮更新','Ceiling-1.0: keep corrected Stage 1 and redesign Stage 2 around round-level evidence'),
    summary: t('Ceiling-1.0 每轮把同一批 128 次任务记录交给 SD-LoRA、Text Memory、Skill Bundle、Agent System 分别判断是否更新，再合并成下一轮状态。','Each Ceiling-1.0 round gives the same 128 task records to SD-LoRA, Text Memory, Skill Bundle, and Agent System so each can decide whether to update before the next-round state is composed.'),
    facts: [t('Stage 1：fresh corrected 1,440 条轨迹','Stage 1: fresh corrected 1,440 trajectories'), t('分析：1,440 条 MiniMax 任务后分析；外部老师预算在这里封口','Analysis: 1,440 post-episode MiniMax analyses; external-teacher budget seals here'), t('Stage 2：128 rollouts / round；3B 与 7B 独立推进','Stage 2: 128 rollouts per round; 3B and 7B advance independently')],
    href: links.ceiling,
  },
  {
    id: 'evo2',
    eyebrow: t('当前结局 · OpenEVO 2.0','CURRENT OUTCOME · OPENEVO 2.0'),
    title: t('OpenEVO 2.0：Harness 2.0.1 机械资格已通过，正式 Stage 2 仍等待 readiness audit','OpenEVO 2.0: Harness 2.0.1 mechanical qualification passed, while formal Stage 2 still awaits the readiness audit'),
    summary: t('OpenEVO 2.0 复用 Stage 1，不重新采集。第一次 Harness 2.0 的 128+128 结果原样保留；Harness 2.0.1 mechanical qualification 已 PASS，但 scientific closeout 为 HOLD_FOR_STAGE2_READINESS_AUDIT，因此正式 3B Stage 2 尚未授权。','OpenEVO 2.0 reuses Stage 1 rather than collecting it again. The first paired 128+128 Harness 2.0 result remains unchanged; Harness 2.0.1 mechanical qualification is PASS, but scientific closeout is HOLD_FOR_STAGE2_READINESS_AUDIT, so formal 3B Stage 2 remains unauthorized.'),
    facts: [t('Harness 2.0 v1：Control 128/128；candidate 128/128','Harness 2.0 v1: Control 128/128; candidate 128/128'), t('v1 非法终止 episode：31.25% → 42.19%','v1 invalid-terminated episodes: 31.25% → 42.19%'), t('Harness 2.0.1：Mechanical PASS；Scientific closeout HOLD_FOR_STAGE2_READINESS_AUDIT；formal Stage2 未授权','Harness 2.0.1: Mechanical PASS; scientific closeout HOLD_FOR_STAGE2_READINESS_AUDIT; formal Stage 2 unauthorized')],
    href: links.harness2,
  },
] as const;
---
<section class="exp-tree" data-testid="openevo-capability-experiment-tree" data-experiment-tree data-empty-path={t('先从 Stage 1 开始。','Start with Stage 1.')} aria-labelledby="exp-tree-title">
  <header class="exp-tree__head">
    <p>EXPERIMENT TREE</p>
    <h2 id="exp-tree-title">{t('先走一条实验路线，再看它走到了什么结局','Choose an experiment path first, then reveal where it ended')}</h2>
    <span>{t('这里不跳转页面。你先选 Stage 1、分析方式和 Stage 2；走到最后以后，再点“查看这个结局”，完整故事会直接在天赋树下面展开。','Nothing here navigates away. Choose Stage 1, the analysis path, and Stage 2 first. At the end, open the outcome and the full story expands directly below the tree.')}</span>
  </header>

  <div class="rogue-run" aria-label={t('OpenEvo 肉鸽式实验路线选择器','OpenEvo roguelike experiment route chooser')}>
    <section class="floor floor--active" data-floor="stage1">
      <header class="floor__header">
        <div><span>{t('第 1 层','FLOOR 1')}</span><strong>Stage 1</strong></div>
        <p>{t('先决定从哪次轨迹采集出发，再选择这批经验怎么被分析。走到出口后，才会进入 Stage 2 地图。','Choose the trajectory collection, then how that experience is analyzed. Only after reaching the exit does the Stage-2 map open.')}</p>
      </header>
      <div class="floor__map floor__map--stage1">
        <div class="map-column">
          <span class="map-column__label">01 · {t('轨迹采集','COLLECTION')}</span>
          <button class="rogue-node" type="button" data-stage1="old" aria-pressed="false"><i>◇</i><b>{t('历史 Stage 1','Historical Stage 1')}</b><small>{t('旧版 1,440 条轨迹','Previous 1,440 trajectories')}</small></button>
          <button class="rogue-node rogue-node--current" type="button" data-stage1="current" aria-pressed="false"><i>◇</i><b>{t('corrected Stage 1','Corrected Stage 1')}</b><small>{t('Ceiling / OpenEVO 2.0 的新起点','New starting point for Ceiling / OpenEVO 2.0')}</small></button>
        </div>
        <div class="map-connector" aria-hidden="true">→</div>
        <div class="map-column" data-step="analysis" hidden data-route-preview>
          <span class="map-column__label">02 · {t('经验分析','ANALYSIS')}</span>
          <div data-analysis-branch="old" hidden data-route-preview-branch>
            <div class="node-stack node-stack--grid">
              <button class="rogue-node" type="button" data-analysis="old-3b-self" aria-pressed="false"><i>◇</i><b>3B / self</b><small>{t('自己总结','Self analysis')}</small></button>
              <button class="rogue-node" type="button" data-analysis="old-7b-self" aria-pressed="false"><i>◇</i><b>7B / self</b><small>{t('自己总结','Self analysis')}</small></button>
              <button class="rogue-node" type="button" data-analysis="old-3b-minimax" aria-pressed="false"><i>◇</i><b>3B / MiniMax</b><small>{t('任务后分析','Post-episode analysis')}</small></button>
              <button class="rogue-node" type="button" data-analysis="old-7b-minimax" aria-pressed="false"><i>◇</i><b>7B / MiniMax</b><small>{t('任务后分析','Post-episode analysis')}</small></button>
            </div>
          </div>
          <div data-analysis-branch="current" hidden data-route-preview-branch>
            <button class="rogue-node rogue-node--current" type="button" data-analysis="current-state" aria-pressed="false"><i>◇</i><b>{t('1,440 条 MiniMax 分析','1,440 MiniMax analyses')}</b><small>OPSD · Text Memory · Skill Bundle · Agent System</small></button>
          </div>
        </div>
        <div class="map-connector" aria-hidden="true">→</div>
        <div class="map-column map-column--exit" data-step="floor-exit" hidden data-route-preview>
          <span class="map-column__label">03 · {t('出口','EXIT')}</span>
          <button class="rogue-node rogue-node--exit" type="button" data-enter-stage2><i>↓</i><b>{t('进入第 2 层 · Stage 2','Enter Floor 2 · Stage 2')}</b><small>{t('换地图','Change map')}</small></button>
        </div>
      </div>
    </section>

    <section class="floor" data-floor="stage2" hidden>
      <header class="floor__header">
        <div><span>{t('第 2 层','FLOOR 2')}</span><strong>Stage 2</strong></div>
        <p>{t('这里展示训练设计如何演进。红色 Bug 节点不是旁支：它会封路，只有解决以后，后面的 successor 才能解锁。','This map shows how the training design evolved. Red Bug nodes are not optional side quests: they block the route until resolved.')}</p>
      </header>
      <div class="floor__map floor__map--stage2">
        <div class="map-column" data-stage2-branch="old" hidden>
          <span class="map-column__label">01 · Stage 2 v1</span>
          <button class="rogue-node" type="button" data-stage2="legacy" aria-pressed="false"><i>◇</i><b>{t('历史 256-window','Historical 256-window')}</b><small>{t('每 256 条独立判断旧门槛','Gate reset every 256 attempts')}</small></button>
        </div>
        <div class="map-connector" data-old-map-arrow hidden data-route-preview-arrow aria-hidden="true">→</div>
        <div class="map-column" data-bug-branch="old" hidden data-route-preview>
          <span class="map-column__label map-column__label--bug">02 · {t('历史结局 · 被自己的门槛卡住','HISTORICAL OUTCOME · BLOCKED BY OUR OWN GATE')}</span>
          <button class="rogue-node rogue-node--bug" type="button" data-bug="legacy-gate" aria-pressed="false"><i>!</i><b>{t('我们要求至少 8 个重复成功任务；四条历史路线里最好一块也只有 7 个','We required at least 8 repeatedly successful tasks; across the four historical routes the best block still had only 7')}</b><small>{t('每个 256 次任务尝试的数据块都重新统计；7 < 8 时，这一块就不允许更新参数。','Each 256-attempt block was counted from scratch; when 7 < 8, that block was not allowed to update parameters.')}</small><em>{t('结果：旧 Stage 2 没有任何完整数据块触发参数更新','Outcome: no complete block in the old Stage 2 triggered a parameter update')}</em></button>
          <button class="rogue-node rogue-node--ending" type="button" data-ending-from-old><i>◎</i><b>{t('查看这条 arm 的 Stage-2 0-update 结局','Open this arm’s Stage-2 zero-update outcome')}</b><small>{t('下面展开 3B / 7B、self / MiniMax 的具体成功数、7/8（或更低）与 0 次更新','Expand the exact 3B / 7B, self / MiniMax counts, 7/8 (or lower), and zero updates below')}</small></button>
        </div>
        <div class="map-connector" data-old-map-arrow hidden data-route-preview-arrow aria-hidden="true">→</div>
        <div class="map-column" data-old-successor hidden data-route-preview>
          <span class="map-column__label">03 · {t('要继续，必须先改规则','TO CONTINUE, REPAIR THE RULE')}</span>
          <button class="rogue-node rogue-node--repair" type="button" data-repair="legacy-gate"><i>✓</i><b>{t('修正学习合同，只解锁新的 successor 路线','Repair the learning contract to unlock a new successor line')}</b><small>{t('旧 run 的 0-update 结局原样保留；Ceiling-1.0 / OpenEVO 2.0 是从 corrected Stage 1 重新分出的新路线，不是旧 run 自动接着跑。','The old zero-update outcome stays intact; Ceiling-1.0 / OpenEVO 2.0 fork again from corrected Stage 1 rather than automatically continuing this old run.')}</small></button>
        </div>

        <div class="current-route-board" data-stage2-branch="current" hidden>
          <div class="current-route-head" aria-hidden="true">
            <span class="map-column__label">01 · {t('选择 Stage 2','CHOOSE STAGE 2')}</span>
            <span class="map-column__label">02 · {t('各自进入不同的后续节点','EACH ROUTE HAS ITS OWN NEXT NODE')}</span>
          </div>
          <div class="current-route-row current-route-row--ceiling" data-current-route="ceiling">
            <button class="rogue-node rogue-node--current" type="button" data-stage2="ceiling" aria-pressed="false" data-node-type="mainline" data-node-state="current"><i>◇</i><b>Ceiling-1.0</b><small>{t('每 128 次任务整理一轮经验','One learning round per 128 task attempts')}</small></button>
            <span class="map-connector current-route-arrow" data-current-map-arrow="ceiling" hidden data-route-preview-arrow aria-hidden="true">→</span>
            <div class="current-route-outcome current-route-outcome--ceiling" data-current-outcome-slot="ceiling" hidden data-route-preview-outcome>
              <div class="ceiling-lineage" data-ceiling-lineage>
                <div class="ceiling-lineage__spine" aria-label={t('Ceiling-1.0 当前主线','Current Ceiling-1.0 mainline')}>
                  <div class="lineage-node lineage-node--amendment" data-node-type="scientific-amendment" data-node-state="current">
                    <strong>{t('放宽参数更新次数','Allow more parameter updates')}</strong>
                    <small>{t('不再固定最多 64 次','No longer capped at 64 updates')}</small>
                    <button class="lineage-node__expand" type="button" data-lineage-detail="amendment" aria-expanded="false" aria-label={t('了解“放宽参数更新次数”','Learn about allowing more parameter updates')}>+</button>
                  </div>
                  <span class="lineage-spine" aria-hidden="true"></span>
                  <div class="ceiling-lineage__run-stack">
                    <div class="lineage-node lineage-node--mainline" data-node-type="mainline" data-node-state="current">
                      <strong>{t('继续 7B 训练','Continue 7B training')}</strong>
                      <small>{t('沿用同一实验和预算','Same experiment and budget continue')}</small>
                      <button class="lineage-node__expand" type="button" data-lineage-detail="run" aria-expanded="false" aria-label={t('了解“继续 7B 训练”','Learn about continuing 7B training')}>+</button>
                    </div>
                    <div class="lineage-node lineage-node--fix" data-node-type="engineering-fix" data-node-state="resolved">
                      <strong>{t('修复训练运行问题','Fix training-run issues')}</strong>
                      <small>{t('修运行问题，不改实验规则','Fix runtime issues without changing experiment rules')}</small>
                      <button class="lineage-node__expand" type="button" data-lineage-detail="fixes" aria-expanded="false" aria-label={t('了解“修复训练运行问题”','Learn about the training-run fixes')}>+</button>
                    </div>
                  </div>
                  <span class="lineage-spine" aria-hidden="true"></span>
                  <div class="lineage-node lineage-node--result" data-node-type="mainline" data-node-state="current">
                    <strong>{t('7B 当前进度','Current 7B progress')}</strong>
                    <small>{t('训练仍在继续','Training is still continuing')}</small>
                    <button class="lineage-node__expand" type="button" data-lineage-detail="result" aria-expanded="false" aria-label={t('了解“7B 当前进度”','Learn about current 7B progress')}>+</button>
                  </div>
                  <span class="lineage-spine lineage-spine--future" aria-hidden="true"></span>
                  <div class="lineage-node lineage-node--future" data-node-type="scientific-amendment" data-node-state="future">
                    <strong>{t('以后可能压缩已积累的参数更新','Accumulated parameter updates may be compressed later')}</strong>
                    <small>{t('目前没有启用','Not active now')}</small>
                    <button class="lineage-node__expand" type="button" data-lineage-detail="future" aria-expanded="false" aria-label={t('了解“以后可能压缩已积累的参数更新”','Learn about possible future compression of accumulated parameter updates')}>+</button>
                  </div>
                </div>

                <div class="lineage-detail-layer" data-lineage-detail-layer hidden>
                  <button class="lineage-detail__backdrop" type="button" data-lineage-detail-close aria-label={t('关闭关卡说明','Close stage details')}></button>
                  <aside class="lineage-detail__card" data-lineage-detail-card role="dialog" aria-modal="false" aria-labelledby="ceiling-lineage-detail-title" tabindex="-1">
                    <button class="lineage-detail__close" type="button" data-lineage-detail-close aria-label={t('关闭','Close')}>×</button>
                    <p>{t('关卡说明','STAGE NOTES')}</p>
                    <h3 id="ceiling-lineage-detail-title" data-lineage-detail-title></h3>
                    <div class="lineage-detail__content" data-lineage-detail-content></div>
                  </aside>
                </div>

                <template data-lineage-detail-template="amendment">
                  <p>{t('OpenEvo 原来最多允许这条 SD-LoRA 连续训练发生 64 次新的参数更新；每次更新都会新增一个 component。7B 完成第 64 次更新后仍有剩余训练预算，所以我们取消了这条独立的“最多 64 次”停止规则。','OpenEvo originally allowed at most 64 new SD-LoRA parameter updates in this continual stream; each formal update adds one component. The 7B run completed the 64th update with training budget still remaining, so we removed that independent “at most 64 updates” stop.')}</p>
                  <dl><div><dt>{t('改变了什么','Changed')}</dt><dd>{t('参数更新不再固定最多 64 次；是否还能继续由总容量保护决定。','Parameter updates are no longer fixed at a maximum of 64; the remaining capacity guards decide whether another update is allowed.')}</dd></div><div><dt>{t('没有改变','Unchanged')}</dt><dd>{t('effective rank 仍不超过 4096；replay_capacity 仍是 64；总 rollout 预算、rank=8、任务与评测规则不变。','Effective rank still stays at or below 4096; replay_capacity remains 64; the rollout budget, rank=8, tasks, and evaluation rules stay unchanged.')}</dd></div></dl>
                  <small>{t('技术记录：Scientific amendment · independent component stop removed.','Technical record: Scientific amendment · independent component stop removed.')}</small>
                </template>
                <template data-lineage-detail-template="run">
                  <p>{t('这是同一条 Ceiling-1.0 7B 实验线继续训练，不是重新开一个实验。放宽参数更新次数以后，已经产生的轨迹和 checkpoint 都继续留在同一条 lineage 里。','This is the same Ceiling-1.0 7B lineage continuing forward, not a new experiment. After relaxing the parameter-update count limit, the existing trajectories and checkpoints remain in the same lineage.')}</p>
                  <dl><div><dt>{t('继续什么','Continues')}</dt><dd>{t('同一个 20,480 次 Stage 2 任务预算。','The same 20,480-attempt Stage-2 budget.')}</dd></div><div><dt>{t('怎么保护','Guardrails')}</dt><dd>{t('effective rank、显存、磁盘和产物增长仍会在训练前检查。','Effective rank, VRAM, disk, and artifact growth are still checked before training.')}</dd></div></dl>
                </template>
                <template data-lineage-detail-template="fixes">
                  <p>{t('这些不是新的实验阶段。它们只是让已经确定的实验路线能正确继续，并保证以后还能查清每一步从哪里来。','These are not new experiment stages. They keep the already-defined route running correctly and preserve enough history to audit what happened later.')}</p>
                  <ul><li><b>{t('用对训练代码','Use the right training code')}</b><span>{t('内层训练进程一度读到了旧版代码；现在固定到正确版本。','The inner trainer once loaded an older code path; it is now pinned to the intended version.')}</span></li><li><b>{t('中断后还能接着跑','Resume after an interruption')}</b><span>{t('恢复检查不再只认某一个旧轮次。','Recovery checks no longer assume one hard-coded old round.')}</span></li><li><b>{t('把来历记完整','Keep the lineage complete')}</b><span>{t('旧执行版本也会进入最终记录，不会跑到最后才发现缺一段。','Earlier execution versions are included in the final provenance instead of failing only at the end.')}</span></li><li><b>{t('归档以后仍然认得','Recognize archived checkpoints')}</b><span>{t('已经安全搬到 Hugging Face 的旧 checkpoint，不会被误判成“文件丢了”。','Older checkpoints safely moved to Hugging Face are no longer mistaken for missing files.')}</span></li></ul>
                  <small>{t('技术记录：trainer source · restart validator · execution provenance · HF cold archive。','Technical record: trainer source · restart validator · execution provenance · HF cold archive.')}</small>
                </template>
                <template data-lineage-detail-template="result">
                  <p>{t('7B 训练已经成功完成第 65 次这种参数更新，跨过原来“最多 64 次”的停止线，并继续向后运行。地图不冻结实时轮次和分数，避免过几小时就变成旧数据。','7B training has completed the 65th such parameter update, crossed the old 64-update stop, and continues forward. The map does not freeze live round counts or scores that would become stale within hours.')}</p>
                  <button class="lineage-detail__action" type="button" data-open-ceiling-story>{t('在下面看这条线的结果与证据 →','Open this lineage result and evidence below →')}</button>
                </template>
                <template data-lineage-detail-template="future">
                  <p>{t('以后可以研究把累积的低秩组件压得更紧，但这一步现在没有启用。它如果真的加入，会再次改变参数容量合同，所以必须单独讨论、单独验证。','A later study may compress accumulated low-rank components, but that is not active now. If introduced, it would change the parameter-capacity contract again and therefore needs its own discussion and qualification.')}</p>
                  <small>{t('技术记录：rank reduction / compression · future scientific amendment。','Technical record: rank reduction / compression · future scientific amendment.')}</small>
                </template>
              </div>
            </div>
          </div>
          <div class="current-route-row" data-current-route="evo2">
            <button class="rogue-node rogue-node--current" type="button" data-stage2="evo2" aria-pressed="false"><i>◇</i><b>OpenEVO 2.0</b><small>{t('重做 experience harness','Redesign the experience harness')}</small></button>
            <span class="map-connector current-route-arrow" data-current-map-arrow="evo2" hidden data-route-preview-arrow aria-hidden="true">→</span>
            <div class="current-route-outcome" data-current-outcome-slot="evo2" data-evo2-gate hidden data-route-preview-outcome>
              <button class="rogue-node rogue-node--bug rogue-node--bug-open" type="button" data-ending="evo2"><i>!</i><b>{t('Harness 2.0 Mini Study：v1 接口问题','Harness 2.0 Mini Study: v1 interface issue')}</b><small>{t('v1 Mechanical PASS，但 formal activation HOLD','v1 Mechanical PASS, but formal activation HOLD')}</small><em>{t('v1 在这里停下；Harness 2.0.1 已完成机械资格','v1 stops here; Harness 2.0.1 has completed mechanical qualification')}</em></button>
              <div class="rogue-node rogue-node--repair rogue-node--resolved" data-harness201-status><i>✓</i><b>Harness 2.0.1 · Mechanical PASS</b><small>{t('Scientific closeout = HOLD_FOR_STAGE2_READINESS_AUDIT','Scientific closeout = HOLD_FOR_STAGE2_READINESS_AUDIT')}</small></div>
              <button class="rogue-node rogue-node--locked" type="button" data-readiness-gate disabled><i>🔒</i><b>{t('Stage2 readiness audit + dress rehearsal','Stage2 readiness audit + dress rehearsal')}</b><small>{t('formal_stage2_authorized=false · final_panel_access_authorized=false · 3B BLOCKED_HARNESS_READINESS','formal_stage2_authorized=false · final_panel_access_authorized=false · 3B BLOCKED_HARNESS_READINESS')}</small></button>
            </div>
          </div>
        </div>
      </div>
      <button class="floor-back" type="button" data-back-stage1>← {t('返回第 1 层重新选路线','Return to Floor 1 and choose another route')}</button>
    </section>
  </div>

  <div class="selected-path" data-selected-path aria-live="polite">
    <span>{t('你的路线','Your route')}</span>
    <b data-selected-path-text>{t('还没有选择。先从 Stage 1 开始。','No route selected yet. Start with Stage 1.')}</b>
  </div>

  <section class="story-zone" data-story-zone aria-live="polite">
    <div class="story-placeholder" data-story-placeholder>
      <strong>{t('完整故事会出现在这里','The full story will appear here')}</strong>
      <span>{t('上面选完路线并打开结局后，这里会按 Stage 1 → 分析 → Stage 2 → 结果的顺序讲清楚，不需要离开这个首页。','Finish a route above and open its outcome. This area will explain Stage 1 → analysis → Stage 2 → result without leaving this page.')}</span>
    </div>
    {stories.map((story) => (
      <article class="story-panel" data-story={story.id} hidden tabindex="-1">
        <header><p>{story.eyebrow}</p><h3>{story.title}</h3><span>{story.summary}</span></header>
        <div class="story-panel__facts">{story.facts.map((fact, index) => <div><b>0{index + 1}</b><span>{fact}</span></div>)}</div>
        <a href={story.href}>{t('继续看这条线的完整实验页与证据 →','Open the full experiment page and evidence →')}</a>
      </article>
    ))}
  </section>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-experiment-tree]').forEach((root) => {
    const state = { stage1: '', analysis: '', stage2: '', bugResolved: false };
    const one = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector);
    const all = <T extends HTMLElement>(selector: string) => [...root.querySelectorAll<T>(selector)];
    const pressed = (selector: string, active: HTMLElement | null) => all<HTMLElement>(selector).forEach((el) => el.setAttribute('aria-pressed', el === active ? 'true' : 'false'));
    const hideStories = () => {
      all<HTMLElement>('[data-story]').forEach((panel) => panel.hidden = true);
      const placeholder = one<HTMLElement>('[data-story-placeholder]');
      if (placeholder) placeholder.hidden = false;
    };
    const showStory = (id: string) => {
      const placeholder = one<HTMLElement>('[data-story-placeholder]');
      if (placeholder) placeholder.hidden = true;
      all<HTMLElement>('[data-story]').forEach((panel) => panel.hidden = panel.dataset.story !== id);
      one<HTMLElement>(`[data-story="${id}"]`)?.scrollIntoView({ behavior: 'auto', block: 'start' });
    };
    const label = (selector: string, value: string, attr: string) => one<HTMLElement>(`${selector}[${attr}="${value}"] b`)?.textContent?.trim() || '';
    const updatePath = () => {
      const parts: string[] = [];
      if (state.stage1) parts.push(label('[data-stage1]', state.stage1, 'data-stage1'));
      if (state.analysis) parts.push(label('[data-analysis]', state.analysis, 'data-analysis'));
      if (state.stage2) parts.push(label('[data-stage2]', state.stage2, 'data-stage2'));
      const target = one<HTMLElement>('[data-selected-path-text]');
      if (target) target.textContent = parts.join(' → ') || root.dataset.emptyPath || '';
    };
    let activeLineageTrigger: HTMLButtonElement | null = null;
    let bodyOverflowBeforeDialog = '';
    const lineageLayer = one<HTMLElement>('[data-lineage-detail-layer]');
    const lineageCard = one<HTMLElement>('[data-lineage-detail-card]');
    const lineageTitle = one<HTMLElement>('[data-lineage-detail-title]');
    const lineageContent = one<HTMLElement>('[data-lineage-detail-content]');
    const lineageIsMobile = () => window.matchMedia('(max-width: 700px)').matches;
    const closeLineageDetail = (restoreFocus = true) => {
      if (!lineageLayer || lineageLayer.hidden) return;
      lineageLayer.hidden = true;
      all<HTMLButtonElement>('[data-lineage-detail]').forEach((button) => button.setAttribute('aria-expanded','false'));
      if (lineageCard) { lineageCard.style.removeProperty('left'); lineageCard.style.removeProperty('top'); lineageCard.setAttribute('aria-modal','false'); }
      document.body.style.overflow = bodyOverflowBeforeDialog;
      const trigger = activeLineageTrigger; activeLineageTrigger = null;
      if (restoreFocus) trigger?.focus();
    };
    const positionLineageDetail = (trigger: HTMLButtonElement) => {
      if (!lineageLayer || !lineageCard) return;
      if (lineageIsMobile()) {
        lineageCard.style.removeProperty('left'); lineageCard.style.removeProperty('top');
        lineageCard.setAttribute('aria-modal','true');
        return;
      }
      lineageCard.setAttribute('aria-modal','false');
      const lineage = one<HTMLElement>('[data-ceiling-lineage]');
      const node = trigger.closest<HTMLElement>('.lineage-node');
      if (!lineage || !node) return;
      const parent = lineage.getBoundingClientRect(); const anchor = node.getBoundingClientRect(); const card = lineageCard.getBoundingClientRect();
      const gap = 12; let left = anchor.right - parent.left + gap;
      if (left + card.width > parent.width) left = Math.max(0, anchor.left - parent.left - card.width - gap);
      const top = Math.max(0, anchor.top - parent.top + anchor.height / 2 - card.height / 2);
      lineageCard.style.left = `${left}px`; lineageCard.style.top = `${top}px`;
    };
    const openLineageDetail = (trigger: HTMLButtonElement) => {
      if (!lineageLayer || !lineageCard || !lineageTitle || !lineageContent) return;
      const key = trigger.dataset.lineageDetail || ''; const template = one<HTMLTemplateElement>(`[data-lineage-detail-template="${key}"]`);
      const node = trigger.closest<HTMLElement>('.lineage-node'); const title = node?.querySelector('strong')?.textContent?.trim() || '';
      if (!template) return;
      if (!lineageLayer.hidden && activeLineageTrigger === trigger) { closeLineageDetail(); return; }
      all<HTMLButtonElement>('[data-lineage-detail]').forEach((button) => button.setAttribute('aria-expanded', button === trigger ? 'true' : 'false'));
      activeLineageTrigger = trigger; lineageTitle.textContent = title; lineageContent.replaceChildren(template.content.cloneNode(true)); lineageLayer.hidden = false;
      if (lineageIsMobile()) { bodyOverflowBeforeDialog = document.body.style.overflow; document.body.style.overflow = 'hidden'; }
      requestAnimationFrame(() => { positionLineageDetail(trigger); lineageCard.focus(); });
    };
    const resetStage2Map = () => {
      closeLineageDetail(false);
      state.stage2 = ''; state.bugResolved = false;
      pressed('[data-stage2]', null); pressed('[data-bug]', null);
      all<HTMLElement>('[data-bug-branch],[data-old-successor],[data-current-outcome-slot],[data-current-map-arrow],[data-old-map-arrow]').forEach((el) => el.hidden = true);
      all<HTMLElement>('[data-repair="legacy-gate"]').forEach((el) => el.classList.remove('rogue-node--resolved'));
      hideStories(); updatePath();
    };

    all<HTMLButtonElement>('[data-stage1]').forEach((button) => button.addEventListener('click', () => {
      state.stage1 = button.dataset.stage1 || ''; state.analysis = '';
      pressed('[data-stage1]', button); pressed('[data-analysis]', null);
      const analysis = one<HTMLElement>('[data-step="analysis"]'); if (analysis) analysis.hidden = false;
      all<HTMLElement>('[data-analysis-branch]').forEach((branch) => branch.hidden = branch.dataset.analysisBranch !== state.stage1);
      const exit = one<HTMLElement>('[data-step="floor-exit"]'); if (exit) exit.hidden = true;
      resetStage2Map(); updatePath();
    }));

    all<HTMLButtonElement>('[data-analysis]').forEach((button) => button.addEventListener('click', () => {
      state.analysis = button.dataset.analysis || ''; pressed('[data-analysis]', button);
      const exit = one<HTMLElement>('[data-step="floor-exit"]'); if (exit) exit.hidden = false;
      hideStories(); updatePath();
    }));

    one<HTMLButtonElement>('[data-enter-stage2]')?.addEventListener('click', () => {
      if (!state.stage1 || !state.analysis) return;
      const floor1 = one<HTMLElement>('[data-floor="stage1"]'); const floor2 = one<HTMLElement>('[data-floor="stage2"]');
      if (floor1) { floor1.hidden = true; floor1.classList.remove('floor--active'); }
      if (floor2) { floor2.hidden = false; floor2.classList.add('floor--active'); floor2.dataset.route = state.stage1; }
      all<HTMLElement>('[data-stage2-branch]').forEach((branch) => branch.hidden = branch.dataset.stage2Branch !== state.stage1);
      resetStage2Map();
      floor2?.scrollIntoView({ behavior: 'auto', block: 'start' });
    });

    all<HTMLButtonElement>('[data-stage2]').forEach((button) => button.addEventListener('click', () => {
      state.stage2 = button.dataset.stage2 || ''; pressed('[data-stage2]', button); hideStories(); updatePath();
      if (state.stage2 === 'legacy') {
        all<HTMLElement>('[data-old-map-arrow]').forEach((el) => el.hidden = false);
        const bug = one<HTMLElement>('[data-bug-branch="old"]'); if (bug) bug.hidden = false;
        const successor = one<HTMLElement>('[data-old-successor]'); if (successor) successor.hidden = true;
      } else {
        all<HTMLElement>('[data-current-map-arrow],[data-current-outcome-slot]').forEach((el) => el.hidden = true);
        const arrow = one<HTMLElement>(`[data-current-map-arrow="${state.stage2}"]`); if (arrow) arrow.hidden = false;
        const outcome = one<HTMLElement>(`[data-current-outcome-slot="${state.stage2}"]`); if (outcome) outcome.hidden = false;
      }
    }));

    all<HTMLButtonElement>('[data-lineage-detail]').forEach((button) => button.addEventListener('click', (event) => { event.stopPropagation(); openLineageDetail(button); }));
    all<HTMLButtonElement>('[data-lineage-detail-close]').forEach((button) => button.addEventListener('click', () => closeLineageDetail()));
    lineageContent?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('[data-open-ceiling-story]')) { closeLineageDetail(false); showStory('ceiling'); }
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && lineageLayer && !lineageLayer.hidden) { event.preventDefault(); closeLineageDetail(); } });
    window.addEventListener('resize', () => { if (activeLineageTrigger && lineageLayer && !lineageLayer.hidden) positionLineageDetail(activeLineageTrigger); });

    one<HTMLButtonElement>('[data-bug="legacy-gate"]')?.addEventListener('click', (event) => {
      state.bugResolved = false; pressed('[data-bug]', event.currentTarget as HTMLElement);
      const successor = one<HTMLElement>('[data-old-successor]'); if (successor) successor.hidden = false;
    });

    one<HTMLButtonElement>('[data-repair="legacy-gate"]')?.addEventListener('click', (event) => {
      state.bugResolved = true; (event.currentTarget as HTMLElement).classList.add('rogue-node--resolved');
    });

    one<HTMLButtonElement>('[data-ending-from-old]')?.addEventListener('click', () => { if (state.analysis) showStory(state.analysis); });
    all<HTMLButtonElement>('[data-ending]').forEach((button) => button.addEventListener('click', () => { const id = button.dataset.ending || ''; if (id) showStory(id); }));

    one<HTMLButtonElement>('[data-back-stage1]')?.addEventListener('click', () => {
      const floor1 = one<HTMLElement>('[data-floor="stage1"]'); const floor2 = one<HTMLElement>('[data-floor="stage2"]');
      if (floor2) { floor2.hidden = true; floor2.classList.remove('floor--active'); delete floor2.dataset.route; }
      if (floor1) { floor1.hidden = false; floor1.classList.add('floor--active'); floor1.scrollIntoView({ behavior: 'auto', block: 'start' }); }
      resetStage2Map();
    });
  });
</script>

<style>
.exp-tree{margin:0 0 1.4rem;padding:1.1rem;border:1px solid var(--color-border);border-radius:var(--radius-feature);background:color-mix(in srgb,var(--color-text) 1.4%,transparent)}
.exp-tree__head{display:grid;grid-template-columns:minmax(190px,.52fr) minmax(0,1fr);gap:.55rem 1.2rem;padding:.15rem .15rem 1rem;border-bottom:1px solid var(--color-border)}
.exp-tree__head>p{grid-column:1/-1;margin:0;color:var(--color-accent);font:800 .62rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}
.exp-tree__head h2{margin:0;font-size:clamp(1.25rem,2.7vw,1.85rem);letter-spacing:-.035em}
.exp-tree__head>span{color:var(--color-text-muted);font-size:.8rem;line-height:1.65}
.tree-builder{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.9rem;padding:1rem 0 .85rem}
.choice-step{position:relative;min-width:0;padding:.8rem;border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-bg)}
.choice-step:not(:first-child)::before{content:'→';position:absolute;left:-.72rem;top:50%;translate:-50% -50%;display:grid;place-items:center;width:1.35rem;height:1.35rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-bg);color:var(--color-text-muted);font-size:.7rem;z-index:2}
.choice-step__title{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.55rem;align-items:center;margin-bottom:.7rem}
.choice-step__title>span{display:grid;place-items:center;width:2rem;height:2rem;border-radius:999px;background:color-mix(in srgb,var(--color-accent) 10%,var(--color-bg));color:var(--color-accent);font:800 .62rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}
.choice-step__title>div{display:flex;min-width:0;flex-direction:column;gap:.08rem}.choice-step__title strong{font-size:.82rem}.choice-step__title small{color:var(--color-text-muted);font-size:.67rem;line-height:1.35}
.choice-grid{display:grid;gap:.45rem}.choice-grid--two{grid-template-columns:repeat(2,minmax(0,1fr))}.choice-grid--arms{grid-template-columns:repeat(2,minmax(0,1fr))}
.choice-grid button,.ending-stack button{width:100%;min-height:52px;padding:.68rem;border:1px solid var(--color-border);border-radius:var(--radius-panel);background:color-mix(in srgb,var(--color-text) 1.5%,var(--color-bg));color:var(--color-text);text-align:left;cursor:pointer;transition:border-color .15s ease,background .15s ease,transform .15s ease}
.choice-grid button:hover,.choice-grid button:focus-visible,.ending-stack button:hover,.ending-stack button:focus-visible{border-color:var(--color-accent);outline:none;transform:translateY(-1px)}
.choice-grid button[aria-pressed="true"],.ending-stack button[aria-pressed="true"]{border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 9%,var(--color-bg));box-shadow:inset 0 0 0 1px var(--color-accent)}
.choice-grid b,.choice-grid small,.ending-stack b,.ending-stack small,.ending-stack span{display:block}.choice-grid b{font-size:.76rem;line-height:1.35}.choice-grid small{margin-top:.16rem;color:var(--color-text-muted);font-size:.65rem;line-height:1.35}
.choice-step--ending{border-color:color-mix(in srgb,var(--color-accent) 58%,var(--color-border));background:color-mix(in srgb,var(--color-accent) 3.5%,var(--color-bg))}
.ending-stack button span{color:var(--color-accent);font:800 .55rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.ending-stack button b{margin-top:.28rem;font-size:.76rem;line-height:1.4}.ending-stack button small{margin-top:.35rem;color:var(--color-text-muted);font-size:.64rem}
.selected-path{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.6rem;align-items:center;padding:.65rem .75rem;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}
.selected-path>span{color:var(--color-text-muted);font:800 .57rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.selected-path>b{font-size:.72rem;line-height:1.45}
.story-zone{padding-top:.85rem}.story-placeholder{display:flex;flex-direction:column;gap:.22rem;padding:1rem;border:1px dashed var(--color-border);border-radius:var(--radius-panel);color:var(--color-text-muted)}.story-placeholder strong{color:var(--color-text);font-size:.85rem}.story-placeholder span{font-size:.72rem;line-height:1.55}
.story-panel{padding:1rem;border:1px solid color-mix(in srgb,var(--color-accent) 55%,var(--color-border));border-radius:var(--radius-feature);background:color-mix(in srgb,var(--color-accent) 3%,var(--color-bg))}.story-panel header{display:grid;grid-template-columns:minmax(170px,.42fr) minmax(0,1fr);gap:.4rem 1rem;align-items:start}.story-panel header p{grid-column:1/-1;margin:0;color:var(--color-accent);font:800 .58rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em}.story-panel h3{margin:0;font-size:clamp(1.1rem,2.2vw,1.55rem);line-height:1.15;letter-spacing:-.03em}.story-panel header>span{color:var(--color-text-muted);font-size:.78rem;line-height:1.6}
.story-panel__facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin-top:.9rem}
.story-panel__facts>div{display:grid;grid-template-columns:1.8rem minmax(0,1fr);gap:.45rem;padding:.7rem;border-top:1px solid var(--color-border)}
.story-panel__facts b{color:var(--color-accent);font:800 .58rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace}
.story-panel__facts span{font-size:.72rem;line-height:1.5}
.story-panel>a{display:inline-flex;margin-top:.85rem;min-height:44px;align-items:center;padding:.62rem .78rem;border:1px solid var(--color-border);border-radius:var(--radius-panel);color:var(--color-text);font-size:.72rem;font-weight:760;text-decoration:none}
.story-panel>a:hover,.story-panel>a:focus-visible{border-color:var(--color-accent);outline:none}
@media(max-width:980px){
  .tree-builder{grid-template-columns:repeat(2,minmax(0,1fr))}
  .choice-step:not(:first-child)::before{display:none}
}
@media(max-width:700px){
  .exp-tree{padding:.78rem;border-radius:var(--radius-feature)}
  .exp-tree__head{grid-template-columns:1fr;gap:.38rem;padding:.05rem .05rem .72rem}
  .exp-tree__head>p{grid-column:auto}
  .exp-tree__head h2{font-size:1.18rem;line-height:1.16}
  .exp-tree__head>span{font-size:.77rem;line-height:1.52}
  .tree-builder{grid-template-columns:1fr;gap:.62rem;padding:.75rem 0}
  .choice-step{padding:.72rem;border-radius:var(--radius-panel)}
  .choice-step__title{margin-bottom:.58rem}
  .choice-step__title strong{font-size:.86rem}.choice-step__title small{font-size:.7rem}
  .choice-grid--two,.choice-grid--arms{grid-template-columns:1fr}
  .choice-grid button,.ending-stack button{min-height:56px;padding:.72rem .78rem}
  .choice-grid b,.ending-stack button b{font-size:.82rem}.choice-grid small,.ending-stack button small{font-size:.71rem}
  .selected-path{grid-template-columns:1fr;gap:.18rem;padding:.62rem .12rem}
  .selected-path>b{font-size:.76rem}
  .story-zone{padding-top:.7rem}.story-panel{padding:.82rem}
  .story-panel header{grid-template-columns:1fr;gap:.38rem}.story-panel header p{grid-column:auto}
  .story-panel h3{font-size:1.14rem}.story-panel header>span{font-size:.78rem}
