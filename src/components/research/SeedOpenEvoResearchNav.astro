---
import { localePath, type Locale } from '../../i18n';

type ResearchPage = 'hub' | 'experiment' | 'design' | 'capability' | 'briefing' | 'server' | 'seed' | 'openevo' | 'benchmarks' | 'webshop' | 'alfworld' | 'loops' | 'sdlora' | 'run' | 'results';
type ResearchTrack = 'flow' | 'study';

interface Props {
  locale: Locale;
  page: ResearchPage;
}

const { locale, page } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

// The site header defines two primary journeys. This local navigation is the
// child navigation for whichever journey the reader is currently inside; it
// should never flatten both journeys back into one unrelated row.
const flowPages = [
  { id: 'hub', label: t('流程总览', 'Flow overview'), href: p('/research/seed-openevo/flow/') },
  { id: 'training-design', label: t('训练设计', 'Training design'), href: p('/research/seed-openevo/flow/#training-design') },
  { id: 'server', label: t('实验服务器', 'Experiment server'), href: p('/research/seed-openevo/flow/server/') },
  { id: 'seed', label: t('SEED 方法', 'SEED method'), href: p('/research/seed-openevo/flow/seed/') },
  { id: 'openevo', label: t('OpenEVO 方法', 'OpenEVO method'), href: p('/research/seed-openevo/flow/openevo/') },
  { id: 'benchmarks', label: t('环境总览', 'Environment overview'), href: p('/research/seed-openevo/flow/benchmarks/') },
  { id: 'webshop', label: t('WebShop 环境', 'WebShop environment'), href: p('/research/seed-openevo/flow/webshop/') },
  { id: 'alfworld', label: t('ALFWorld 环境', 'ALFWorld environment'), href: p('/research/seed-openevo/flow/alfworld/') },
  { id: 'loops', label: t('更新机制', 'Update mechanisms'), href: p('/research/seed-openevo/flow/loops/') },
  { id: 'sdlora', label: t('SD-LoRA 参数机制', 'SD-LoRA parameters'), href: p('/research/seed-openevo/flow/sd-lora/') },
] as const;

const studyPages = [
  { id: 'experiment', label: t('实验目录', 'Experiment index'), href: p('/research/seed-openevo/study/') },
  { id: 'run', label: t('运行实验', 'Run experiment'), href: p('/research/seed-openevo/study/run/') },
  { id: 'capability', label: t('OpenEVO 基础能力探索实验', 'OpenEVO capability exploration'), href: p('/research/seed-openevo/study/capability-exploration/') },
  { id: 'briefing', label: t('阶段汇报', 'Progress briefing'), href: p('/research/seed-openevo/study/briefing/') },
  { id: 'results', label: t('研究结果', 'Research findings'), href: p('/research/seed-openevo/study/results/') },
] as const;

const studyPageIds: ResearchPage[] = ['experiment', 'design', 'run', 'capability', 'briefing', 'results'];
const currentTrack: ResearchTrack = studyPageIds.includes(page) ? 'study' : 'flow';
const pages = currentTrack === 'flow' ? flowPages : studyPages;
const currentItem = pages.find((item) => item.id === page) ?? pages[0];
const identity = currentTrack === 'flow'
  ? {
      index: '01',
      label: t('流程理解图', 'Flow map'),
      meta: t('服务器 · 方法 · 环境 · 训练设计 · 更新机制 · SD-LoRA', 'server · methods · environments · training design · update loop · SD-LoRA'),
      aria: t('流程理解图子导航', 'Flow map subnavigation'),
    }
  : {
      index: '02',
      label: t('OpenEVO 购物实验 · WebShop', 'OpenEVO experiments · WebShop'),
      meta: t('实验目录 · 运行 · 基础能力探索 · 阶段汇报 · 研究结果', 'index · execution · capability exploration · briefing · findings'),
      aria: t('OpenEVO Harness · WebShop 研究子导航', 'OpenEVO Harness · WebShop study subnavigation'),
    };
---
<div class="research-navigation" data-research-navigation data-research-track={currentTrack}>
  <div class="research-navigation__identity">
    <span class="research-navigation__index" aria-hidden="true">{identity.index}</span>
    <div>
      <strong>{identity.label}</strong>
      <span>{identity.meta}</span>
    </div>
  </div>
  <nav class="research-navigation__links" aria-label={identity.aria}>
    {pages.map((item) => (
      <a href={item.href} aria-current={item.id === page ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <details class="research-navigation__mobile">
    <summary><span>{currentItem.label}</span><small>{t('相关页面', 'Related pages')}</small></summary>
    <nav aria-label={identity.aria}>
      {pages.map((item) => (
        <a href={item.href} aria-current={item.id === page ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</div>

<style>
  .research-navigation{
    position:sticky;
    z-index:12;
    top:calc(var(--site-header-height) + .5rem);
    display:grid;
    grid-template-columns:auto minmax(0,1fr);
    gap:.28rem;
    align-items:center;
    margin:.35rem 0 1rem;
    padding:.14rem 0;
    border-bottom:1px solid color-mix(in srgb,var(--line) 72%,transparent);
    background:color-mix(in srgb,var(--surface) 97%,transparent);
  }
  .research-navigation__identity{
    display:flex;
    min-width:max-content;
    align-items:center;
    padding:.1rem .42rem .1rem .12rem;
  }
  .research-navigation__index,
  .research-navigation__identity div>span{display:none}
  .research-navigation__identity strong{
    max-width:11rem;
    overflow:hidden;
    color:var(--muted);
    font-size:.62rem;
    font-weight:720;
    line-height:1.3;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .research-navigation__links{
    display:flex;
    gap:.28rem;
    min-width:0;
    overflow-x:auto;
    padding:.05rem;
    scrollbar-width:thin;
  }
  .research-navigation__links a{
    flex:0 0 auto;
    padding:.43rem .55rem;
    border-radius:var(--radius-panel);
    color:var(--muted);
    font-size:.72rem;
    font-weight:680;
    text-decoration:none;
    white-space:nowrap;
  }
  .research-navigation__links a:hover,
  .research-navigation__links a:focus-visible{
    color:var(--ink);
    background:color-mix(in srgb,var(--accent) 5%,transparent);
  }
  .research-navigation__links a:focus-visible{
    outline:3px solid var(--accent-deep);
    outline-offset:2px;
  }
  .research-navigation__links a[aria-current='page']{
    color:var(--accent-deep);
    background:transparent;
    box-shadow:inset 0 -2px var(--accent-deep);
  }
  .research-navigation__mobile{display:none}
  @media(max-width:720px){
    .research-navigation{display:block;margin:0;padding:.18rem 0}
    .research-navigation__identity,.research-navigation__links{display:none}
    .research-navigation__mobile{display:block}
    .research-navigation__mobile>summary{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:.75rem;padding:.35rem .25rem;cursor:pointer;list-style:none;color:var(--ink)}
    .research-navigation__mobile>summary::-webkit-details-marker{display:none}
    .research-navigation__mobile>summary span{font-size:.76rem;font-weight:760}
    .research-navigation__mobile>summary small{color:var(--muted);font-size:.68rem}
    .research-navigation__mobile>summary::after{content:'＋';color:var(--accent-deep);font-size:.9rem}
    .research-navigation__mobile[open]>summary::after{content:'−'}
    .research-navigation__mobile nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.2rem .5rem;padding:.25rem 0 .6rem;border-top:1px solid var(--line)}
    .research-navigation__mobile nav a{min-height:44px;padding:.55rem .25rem;color:var(--muted);font-size:.72rem;font-weight:680;text-decoration:none}
    .research-navigation__mobile nav a[aria-current='page']{color:var(--accent-deep);font-weight:780}
    .research-navigation__mobile summary:focus-visible,.research-navigation__mobile a:focus-visible{outline:3px solid var(--accent-deep);outline-offset:2px}
  }
  @media(max-width:430px){.research-navigation__mobile nav{grid-template-columns:1fr}}
</style>