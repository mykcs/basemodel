---
import { localePath, type Locale } from '../../i18n';

type ResearchPage = 'hub' | 'experiment' | 'design' | 'capability' | 'server' | 'base-model' | 'seed' | 'openevo' | 'benchmarks' | 'webshop' | 'alfworld' | 'loops' | 'run' | 'results';
type ResearchTrack = 'flow' | 'study';

interface Props {
  locale: Locale;
  page: ResearchPage;
}

const { locale, page } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

// The site header defines two primary journeys. This local navigation is the
// child navigation for whichever journey the reader is currently inside; it
// should never flatten both journeys back into one unrelated row.
const flowPages = [
  { id: 'hub', label: t('流程总览', 'Flow overview'), href: p('/research/seed-openevo/flow/') },
  { id: 'server', label: 'lyg2171', href: p('/research/seed-openevo/flow/server/') },
  { id: 'base-model', label: t('模型', 'Model'), href: p('/research/seed-openevo/flow/base-model/') },
  { id: 'seed', label: 'SEED', href: p('/research/seed-openevo/flow/seed/') },
  { id: 'openevo', label: 'OpenEvo', href: p('/research/seed-openevo/flow/openevo/') },
  { id: 'benchmarks', label: t('环境总览', 'Environment overview'), href: p('/research/seed-openevo/flow/benchmarks/') },
  { id: 'webshop', label: 'WebShop', href: p('/research/seed-openevo/flow/webshop/') },
  { id: 'alfworld', label: 'ALFWorld', href: p('/research/seed-openevo/flow/alfworld/') },
  { id: 'loops', label: t('更新机制', 'Update mechanisms'), href: p('/research/seed-openevo/flow/loops/') },
] as const;

const studyPages = [
  { id: 'experiment', label: t('实验流程', 'Experiment workflow'), href: p('/research/seed-openevo/study/') },
  { id: 'design', label: t('训练设计', 'Training design'), href: p('/research/seed-openevo/study/design/') },
  { id: 'run', label: t('运行实验', 'Run experiment'), href: p('/research/seed-openevo/study/run/') },
  { id: 'capability', label: t('OpenEvo 基础能力探索实验', 'OpenEvo capability exploration'), href: p('/research/seed-openevo/study/capability-exploration/') },
  { id: 'results', label: t('研究结果', 'Research findings'), href: p('/research/seed-openevo/study/results/') },
] as const;

const studyPageIds: ResearchPage[] = ['experiment', 'design', 'run', 'capability', 'results'];
const currentTrack: ResearchTrack = studyPageIds.includes(page) ? 'study' : 'flow';
const pages = currentTrack === 'flow' ? flowPages : studyPages;
const identity = currentTrack === 'flow'
  ? {
      index: '01',
      label: t('流程理解图', 'Flow map'),
      meta: t('服务器 · 模型 · 方法 · 环境 · 更新机制', 'server · model · methods · environments · update loop'),
      aria: t('流程理解图子导航', 'Flow map subnavigation'),
    }
  : {
      index: '02',
      label: t('OpenEVO Harness · WebShop', 'OpenEVO Harness · WebShop'),
      meta: t('实验流程 · 训练设计 · 运行 · 基础能力探索 · 研究结果', 'workflow · training design · execution · capability exploration · findings'),
      aria: t('OpenEVO Harness · WebShop 研究子导航', 'OpenEVO Harness · WebShop study subnavigation'),
    };
---
<div class="research-navigation" data-research-navigation data-research-track={currentTrack}>
  <div class="research-navigation__identity">
    <span class="research-navigation__index" aria-hidden="true">{identity.index}</span>
    <div>
      <strong>{identity.label}</strong>
      <span>{identity.meta}</span>
    </div>
  </div>
  <nav class="research-navigation__links" aria-label={identity.aria}>
    {pages.map((item) => (
      <a href={item.href} aria-current={item.id === page ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</div>

<style>
  .research-navigation{
    position:sticky;
    z-index:12;
    top:.5rem;
    display:grid;
    grid-template-columns:auto minmax(0,1fr);
    gap:.55rem;
    align-items:center;
    margin:1rem 0 2rem;
    padding:.45rem;
    border:1px solid var(--line);
    border-radius:14px;
    background:color-mix(in srgb,var(--surface) 92%,transparent);
    backdrop-filter:blur(16px);
  }
  .research-navigation__identity{
    display:flex;
    min-width:max-content;
    align-items:center;
    gap:.5rem;
    padding:.12rem .65rem .12rem .5rem;
    border-right:1px solid var(--line);
  }
  .research-navigation__index{
    color:var(--accent-deep);
    font:800 .58rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  .research-navigation__identity strong,
  .research-navigation__identity div>span{display:block}
  .research-navigation__identity strong{
    max-width:18rem;
    overflow:hidden;
    color:var(--ink);
    font-size:.68rem;
    font-weight:800;
    line-height:1.3;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .research-navigation__identity div>span{
    margin-top:.08rem;
    color:var(--muted);
    font-size:.58rem;
    line-height:1.35;
  }
  .research-navigation__links{
    display:flex;
    gap:.28rem;
    min-width:0;
    overflow-x:auto;
    padding:.05rem;
    scrollbar-width:thin;
  }
  .research-navigation__links a{
    flex:0 0 auto;
    padding:.58rem .76rem;
    border-radius:10px;
    color:var(--muted);
    font-size:.75rem;
    font-weight:720;
    text-decoration:none;
    white-space:nowrap;
  }
  .research-navigation__links a:hover,
  .research-navigation__links a:focus-visible{
    color:var(--ink);
    background:color-mix(in srgb,var(--accent) 7%,transparent);
  }
  .research-navigation__links a:focus-visible{
    outline:3px solid var(--accent-deep);
    outline-offset:2px;
  }
  .research-navigation__links a[aria-current='page']{
    color:var(--accent-on-fill);
    background:var(--accent-deep);
  }
  @media(max-width:720px){
    .research-navigation{
      grid-template-columns:1fr;
      gap:.3rem;
      margin:.6rem 0 1.2rem;
      padding:.4rem;
    }
    .research-navigation__identity{
      gap:.4rem;
      padding:.2rem .4rem .05rem;
      border-right:0;
    }
    .research-navigation__identity div>span{margin-top:0}
    .research-navigation__links a{padding:.54rem .68rem;font-size:.72rem}
  }
  @media(max-width:430px){
    .research-navigation__identity div>span{display:none}
  }
</style>