---
interface Props {
  summary: string;
  eyebrow?: string;
  description?: string;
}

const { summary, eyebrow = 'REPRODUCTION DETAIL', description } = Astro.props;
---

<details class="research-technical-disclosure">
  <summary>
    <span class="summary-copy">
      <small>{eyebrow}</small>
      <strong>{summary}</strong>
      {description && <span>{description}</span>}
    </span>
    <span class="toggle" aria-hidden="true">+</span>
  </summary>
  <div class="detail-body">
    <slot />
  </div>
</details>

<style>
  .research-technical-disclosure{
    border-block:1px solid var(--color-border,var(--line,#ded8ce));
    background:color-mix(in srgb,var(--color-text,currentColor) 2.5%,transparent);
  }
  summary{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:1rem;
    align-items:center;
    padding:1rem 0;
    cursor:pointer;
    list-style:none;
  }
  summary::-webkit-details-marker{display:none}
  .summary-copy{display:block;min-width:0}
  .summary-copy small,.summary-copy strong,.summary-copy>span{display:block}
  .summary-copy small{
    color:var(--color-accent,var(--accent-deep,var(--accent)));
    font:800 .58rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;
    letter-spacing:.08em;
  }
  .summary-copy strong{margin-top:.28rem;font-size:.88rem;line-height:1.4}
  .summary-copy>span{
    max-width:72ch;
    margin-top:.22rem;
    color:var(--color-text-muted,var(--muted));
    font-size:.7rem;
    line-height:1.55;
  }
  .toggle{
    display:grid;
    place-items:center;
    width:1.75rem;
    height:1.75rem;
    border:1px solid var(--color-border,var(--line,#ded8ce));
    border-radius:6px;
    color:var(--color-text-muted,var(--muted));
    font:700 1rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  details[open] .toggle{transform:rotate(45deg)}
  .detail-body{
    padding:1rem 0 1.2rem;
    border-top:1px dashed var(--color-border,var(--line,#ded8ce));
  }
  summary:focus-visible{
    outline:2px solid var(--color-accent,var(--accent-deep,var(--accent)));
    outline-offset:4px;
    border-radius:6px;
  }
  @media(max-width:640px){
    summary{gap:.7rem}
    .detail-body{padding-bottom:1rem}
  }
</style>
