---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="seed-framework" aria-labelledby="seed-framework-title">
  <header class="diagram-head"><span>SEED · METHOD</span><h2 id="seed-framework-title">{t('SEED 自进化训练框架','SEED self-evolving training framework')}</h2><p>{t('核心不是简单“轨迹 → 微调”，而是让同一个 policy checkpoint 同时扮演行动者与 hindsight analyzer，把技能带来的动作概率变化蒸馏回 policy 参数。','SEED does more than trajectory-to-finetuning: the same policy checkpoint acts as both actor and hindsight analyzer, and the skill-induced action-probability shift is distilled back into policy parameters.')}</p></header>
  <div class="stage-band sft-band"><div class="stage-label"><b>STAGE 1</b><strong>Hindsight-skill SFT</strong></div><div class="stage-flow"><article class="node n-task"><small>{t('普通任务','Tasks')}</small><strong>trajectories</strong></article><div class="arrow"><span></span><i></i></div><article class="node n-skill"><small>{t('回看完整轨迹','Analyze')}</small><strong>hindsight skill</strong></article><div class="arrow"><span></span><i></i></div><article class="node n-sft"><small>{t('监督微调','SFT')}</small><strong>{t('具备分析能力的 policy','analyzer-capable policy')}</strong></article></div></div>
  <div class="stage-band rl-band"><div class="stage-label"><b>STAGE 2</b><strong>Self-evolving OPD + GRPO</strong></div><div class="seed-loop">
    <article class="node n-policy"><small>{t('当前策略','Current policy')}</small><strong>policy θ_t</strong><span>{t('同一 checkpoint','same checkpoint')}</span></article><div class="arrow"><span></span><i></i></div><article class="node n-rollout"><small>ON-POLICY</small><strong>{t('环境 rollout','environment rollout')}</strong><span>{t('动作 + observation + reward','actions + observations + rewards')}</span></article><div class="split-connector" aria-hidden="true"><span class="main"></span><span class="branch"></span><i class="main-head"></i><i class="branch-head"></i></div><article class="node n-analyzer"><small>{t('同一模型回看','Same-model analyzer')}</small><strong>hindsight skill</strong><span>{t('根据完整 episode 生成技能','skill from the completed episode')}</span></article><article class="node n-rescore"><small>{t('同一动作，两种上下文','Same actions, two contexts')}</small><strong>dual-context re-score</strong><div class="mini-pair"><span>{t('普通上下文','plain')}</span><span>skill-augmented</span></div></article><div class="arrow"><span></span><i></i></div><article class="node n-loss"><small>{t('联合训练信号','Joint signal')}</small><strong>GRPO + OPD</strong><span>{t('结果 RL + 稠密蒸馏','outcome RL + dense distillation')}</span></article><div class="arrow"><span></span><i></i></div><article class="node n-update"><small>OPTIMIZER</small><strong>policy θ_t+1</strong><span>{t('技能效果内化进参数','skill effect internalized in parameters')}</span></article><div class="return-line" aria-hidden="true"><span></span><i></i></div>
  </div></div>
  <div class="seed-takeaway"><article><small>{t('训练时','Training')}</small><strong>{t('使用 analyzer / hindsight skill / OPD','uses analyzer + hindsight skill + OPD')}</strong></article><article><small>{t('推理时','Inference')}</small><strong>{t('只保留更新后的 policy','only the updated policy is required')}</strong></article><article><small>{t('真正被更新','Updated object')}</small><strong>{t('模型参数 / checkpoint','model parameters / checkpoint')}</strong></article></div>
</section>
<style>
.seed-framework{--policy:#7c3aed;--env:#2563eb;--skill:#d97706;--loss:#dc2626;--out:#059669;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:0 20px 60px color-mix(in srgb,#000 7%,transparent)}.diagram-head{max-width:900px}.diagram-head>span{color:var(--policy);font-size:.7rem;font-weight:850;letter-spacing:.08em}.diagram-head h2{margin:.35rem 0 .5rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.65}.stage-band{margin-top:1rem;padding:1rem;border:1px solid var(--line);border-radius:17px}.sft-band{background:color-mix(in srgb,var(--skill) 6%,var(--surface))}.rl-band{background:color-mix(in srgb,var(--policy) 6%,var(--surface))}.stage-label{display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem}.stage-label b{padding:.28rem .45rem;border-radius:6px;background:var(--surface);color:var(--muted);font:850 .6rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.stage-label strong{font-size:.78rem}.stage-flow{display:grid;grid-template-columns:1fr 50px 1fr 50px 1fr;align-items:center;gap:.35rem}.node{min-height:105px;padding:.75rem;border:1.5px solid;border-radius:13px;background:var(--surface);box-shadow:0 9px 20px color-mix(in srgb,#000 5%,transparent)}.node small,.node strong,.node>span{display:block}.node small{color:var(--muted);font-size:.56rem;letter-spacing:.05em;text-transform:uppercase}.node strong{margin:.32rem 0;color:var(--text);font-size:.73rem;line-height:1.3}.node>span{color:var(--muted);font-size:.59rem;line-height:1.38}.n-task,.n-rollout{border-color:color-mix(in srgb,var(--env) 60%,var(--line));border-top:4px solid var(--env)}.n-skill,.n-analyzer{border-color:color-mix(in srgb,var(--skill) 60%,var(--line));border-top:4px solid var(--skill)}.n-sft,.n-policy{border-color:color-mix(in srgb,var(--policy) 60%,var(--line));border-top:4px solid var(--policy)}.n-rescore{border-color:color-mix(in srgb,#0f766e 60%,var(--line));border-top:4px solid #0f766e}.n-loss{border-color:color-mix(in srgb,var(--loss) 60%,var(--line));border-top:4px solid var(--loss)}.n-update{border-color:color-mix(in srgb,var(--out) 60%,var(--line));border-top:4px solid var(--out)}.arrow{position:relative;height:30px}.arrow span{position:absolute;left:0;right:9px;top:13px;height:3px;border-radius:99px;background:var(--muted)}.arrow i{position:absolute;right:0;top:7px;border-top:8px solid transparent;border-bottom:8px solid transparent;border-left:10px solid var(--muted)}.seed-loop{position:relative;display:grid;grid-template-columns:1fr 44px 1fr 68px 1fr 1fr 44px 1fr 44px 1fr;align-items:center;gap:.3rem;padding-bottom:54px}.split-connector{position:relative;min-height:100px}.split-connector .main{position:absolute;left:0;right:9px;top:31px;height:3px;background:#0f766e}.split-connector .branch{position:absolute;left:28px;top:31px;width:3px;height:52px;background:var(--skill)}.split-connector i.main-head{position:absolute;right:0;top:25px;border-top:8px solid transparent;border-bottom:8px solid transparent;border-left:10px solid #0f766e}.split-connector i.branch-head{position:absolute;left:22px;bottom:5px;border-left:8px solid transparent;border-right:8px solid transparent;border-top:10px solid var(--skill)}.mini-pair{display:grid;grid-template-columns:1fr 1fr;gap:.28rem;margin-top:.5rem}.mini-pair span{padding:.25rem;border-radius:6px;background:var(--surface-muted);text-align:center;font-size:.52rem;color:var(--text)}.return-line{position:absolute;left:4%;right:4%;bottom:8px;height:38px;border-left:3px solid var(--out);border-bottom:3px solid var(--out);border-right:3px solid var(--out);border-radius:0 0 13px 13px}.return-line i{position:absolute;left:-8px;top:-2px;border-left:7px solid transparent;border-right:7px solid transparent;border-bottom:10px solid var(--out)}.seed-takeaway{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin-top:.7rem}.seed-takeaway article{padding:.7rem;border-radius:10px;background:var(--surface-muted);border-left:4px solid var(--policy)}.seed-takeaway article:nth-child(2){border-left-color:var(--out)}.seed-takeaway article:nth-child(3){border-left-color:var(--loss)}.seed-takeaway small,.seed-takeaway strong{display:block}.seed-takeaway small{font-size:.58rem;color:var(--muted)}.seed-takeaway strong{margin-top:.2rem;font-size:.67rem;line-height:1.4}@media(max-width:1050px){.stage-flow,.seed-loop{grid-template-columns:1fr}.arrow,.split-connector{height:34px;min-height:34px}.arrow span,.split-connector .main{left:50%;right:auto;top:0;bottom:9px;width:3px;height:auto}.arrow i,.split-connector i.main-head{left:calc(50% - 7px);right:auto;top:auto;bottom:0;border-left:7px solid transparent;border-right:7px solid transparent;border-top:10px solid var(--muted);border-bottom:0}.split-connector .branch,.split-connector i.branch-head{display:none}.seed-loop{padding-bottom:0}.return-line{display:none}.seed-takeaway{grid-template-columns:1fr}}@media(max-width:560px){.seed-framework{width:min(100% - 1rem,1180px);padding:.8rem}}
</style>
