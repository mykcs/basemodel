---
export type ResearchPrimerMovedId = 'webshop-training' | 'seed-training' | 'openevo-training';
interface Props { note: ResearchPrimerMovedId }
const { note } = Astro.props;
const root = '/research/seed-openevo/study/results';
const destinations: Record<ResearchPrimerMovedId, { eyebrow: string; title: string; description: string; href: string; target: string; secondary?: { href: string; label: string } }> = {
  'webshop-training': {
    eyebrow: 'WEBSHOP · ENVIRONMENT',
    title: '想确认 WebShop 的任务与评测规则？',
    description: '任务结构包括页面观察（observation）、模型动作（action）、环境奖励（reward）、官方数据、小型商品配置（small）、任务目标生成、任务划分与最终评分。',
    href: '/research/seed-openevo/flow/webshop/',
    target: '打开 WebShop 任务与评测 →',
  },
  'seed-training': {
    eyebrow: 'SEED · WEBSHOP',
    title: '想确认 SEED 在 WebShop 上到底用了哪套场地？',
    description: 'SEED 使用 WebShop 的小型商品环境（small）和特定任务目标划分；公平比较需要使用相同的任务范围。SEED 自身的训练与推理机制见论文页。',
    href: '/research/seed-openevo/flow/webshop/#fig-seed-webshop',
    target: '打开图 S1 · SEED × WebShop →',
    secondary: { href: '/papers/seed/', label: '查看 SEED 论文页 →' },
  },
  'openevo-training': {
    eyebrow: 'OPENEVO · MECHANISM',
    title: '想确认 OpenEvo 是怎么从经验更新自己的？',
    description: 'OpenEvo 的更新链包括任务从哪里开始和结束、哪些证据被正式封存、经验怎样被带到下一版模型、怎样验证更新是否有效，以及更新后的后继模型版本。图 C1 给出与 SEED 的并排比较。',
    href: '/research/seed-openevo/flow/openevo/',
    target: '打开 OpenEvo 演化流程 →',
    secondary: { href: '/research/seed-openevo/flow/loops/#fig-seed-openevo-update-target', label: '查看图 C1 · SEED vs OpenEvo →' },
  },
};
const current = destinations[note];
---

<main class="moved-primer" data-ui-audit="contrast layout overflow">
  <a class="back" href={`${root}/`}>← 返回研究结果</a>
  <article>
    <p class="eyebrow">{current.eyebrow}</p>
    <h1>{current.title}</h1>
    <p>{current.description}</p>
    <div class="actions">
      <a class="primary" href={current.href}>{current.target}</a>
      {current.secondary && <a href={current.secondary.href}>{current.secondary.label}</a>}
    </div>
  </article>
</main>

<style>
.moved-primer{width:min(880px,calc(100% - 2rem));margin:2rem auto 5rem}.back{display:inline-block;margin-bottom:2rem;color:var(--color-text-muted);font-size:.82rem;text-decoration:none}.moved-primer article{padding:clamp(1.2rem,4vw,2.5rem);border:1px solid var(--color-border);border-radius:18px;background:var(--color-surface)}.eyebrow{margin:0 0 .8rem;color:var(--color-accent);font:750 .7rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.moved-primer h1{margin:0;max-width:760px;font-size:clamp(1.8rem,4vw,3.3rem);line-height:1.08;letter-spacing:-.045em}.moved-primer article>p:not(.eyebrow){max-width:720px;margin:1rem 0 0;color:var(--color-text-muted);font-size:1rem;line-height:1.72}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.5rem}.actions a{padding:.62rem .82rem;border:1px solid var(--color-border);border-radius:9px;color:var(--color-text);font-size:.84rem;text-decoration:none}.actions .primary{border-color:var(--color-accent);background:var(--color-accent);color:var(--color-on-accent,#fff)}@media(max-width:600px){.moved-primer{width:min(100% - 1rem,880px);margin-top:1rem}.actions a{width:100%}}
</style>
