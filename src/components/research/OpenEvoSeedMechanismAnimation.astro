---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="mechanism-section" id="openevo-seed-mechanisms" aria-labelledby="mechanism-title">
  <header class="mechanism-heading"><span>06</span><div><small>{t('机制','Mechanisms')}</small><h2 id="mechanism-title">{t('OpenEvo 与 SEED 机制图','OpenEvo and SEED mechanism map')}</h2><p>{t('两条方法都从任务轨迹出发，但更新对象与生效边界不同。Qwen2.5-3B-Instruct 作为实验基础模型，不与方法本身并列。','Both methods start from task trajectories, but they update different objects and activate changes at different boundaries. Qwen2.5-3B-Instruct is the experimental base model, not a third method.')}</p></div></header>

  <div class="shared-input"><span>{t('共同输入','Shared input')}</span><strong>trajectory · actions · observations · reward</strong><small>Qwen2.5-3B-Instruct + ALFWorld / WebShop</small></div>

  <div class="machines">
    <article class="machine">
      <header><span>OpenEvo</span><h3>{t('跨任务演化','Cross-task evolution')}</h3></header>
      <ol><li><b>01</b><div><strong>{t('完成任务','Complete task')}</strong><p>{t('固定 Project Head 产生真实 trajectory 与结果。','A pinned Project Head produces a real trajectory and outcome.')}</p></div></li><li><b>02</b><div><strong>{t('封存证据','Seal evidence')}</strong><p>{t('任务完成后把 transcript、trajectory、score 与 metadata 封存。','Seal transcript, trajectory, score, and metadata after completion.')}</p></div></li><li><b>03</b><div><strong>{t('运行演化方法','Run evolution method')}</strong><p>{t('生成 memory、skill、agent-system artifact 或 adapter。','Generate memory, skills, agent-system artifacts, or adapters.')}</p></div></li><li><b>04</b><div><strong>{t('验证并发布','Validate and publish')}</strong><p>{t('接受的状态组成 successor revision。','Accepted state forms a successor revision.')}</p></div></li><li><b>05</b><div><strong>{t('后续任务加载','Load in a later task')}</strong><p>{t('变化从后续任务开始生效。','The change activates on a later task.')}</p></div></li></ol>
      <footer><span>{t('更新对象','Updated object')}</span><strong>{t('artifact / adapter / successor revision','artifact / adapter / successor revision')}</strong></footer>
    </article>

    <article class="machine">
      <header><span>SEED</span><h3>{t('参数更新','Parameter update')}</h3></header>
      <ol><li><b>01</b><div><strong>on-policy rollout</strong><p>{t('当前 policy 自己采样动作并完成 trajectory。','The current policy samples actions and completes trajectories.')}</p></div></li><li><b>02</b><div><strong>hindsight skill</strong><p>{t('同一模型回看完整轨迹并生成技能。','The same model reviews completed trajectories and generates skills.')}</p></div></li><li><b>03</b><div><strong>dual-context re-score</strong><p>{t('固定原动作，在普通与 skill context 下重新计算概率。','Re-score the same sampled actions under ordinary and skill contexts.')}</p></div></li><li><b>04</b><div><strong>GRPO + OPD</strong><p>{t('联合构造强化学习与蒸馏训练信号。','Combine reinforcement-learning and distillation signals.')}</p></div></li><li><b>05</b><div><strong>policy θt+1</strong><p>{t('optimizer 更新 policy 参数，下一轮 rollout 使用新 checkpoint。','The optimizer updates policy parameters and the next rollout uses the new checkpoint.')}</p></div></li></ol>
      <footer><span>{t('更新对象','Updated object')}</span><strong>{t('policy 参数 / checkpoint','policy parameters / checkpoint')}</strong></footer>
    </article>
  </div>

  <aside class="mechanism-note"><strong>{t('比较重点','Comparison focus')}</strong><p>{t('公平比较先固定模型、任务、预算、parser 和 evaluator，再分别证明两条更新链真实生效。之后才比较任务结果。','A fair comparison first pins the model, tasks, budget, parser, and evaluator; then it establishes that each update chain actually activates before comparing task outcomes.')}</p></aside>
</section>

<style>
  .mechanism-section{width:min(1120px,calc(100% - 2rem));margin:2rem auto 4rem;padding:1.2rem;border:1px solid var(--line);border-radius:18px;background:var(--surface)}.mechanism-heading{display:grid;grid-template-columns:2.4rem minmax(0,1fr);gap:.65rem}.mechanism-heading>span{color:var(--accent-deep);font:800 .72rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.mechanism-heading small{display:block;color:var(--muted);font-size:.68rem}.mechanism-heading h2{margin:.15rem 0 .5rem}.mechanism-heading p{max-width:78ch;margin:0;color:var(--muted);line-height:1.6}.shared-input{display:grid;grid-template-columns:auto 1fr auto;gap:.6rem;align-items:center;margin:1rem 0;padding:.75rem;border:1px solid var(--line);border-radius:11px;background:var(--surface-muted)}.shared-input span,.shared-input small{color:var(--muted);font-size:.68rem}.shared-input strong{font:750 .75rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace}.machines{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.machine{padding:.9rem;border:1px solid var(--line);border-radius:14px}.machine>header span{color:var(--accent-deep);font:800 .7rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.machine>header h3{margin:.35rem 0 .8rem}.machine ol{display:grid;gap:.4rem;margin:0;padding:0;list-style:none}.machine li{display:grid;grid-template-columns:1.7rem minmax(0,1fr);gap:.55rem;padding:.65rem;border:1px solid var(--line);border-radius:10px}.machine li>b{color:var(--accent-deep);font:800 .65rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.machine li strong{font-size:.76rem}.machine li p{margin:.25rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.45}.machine footer{margin-top:.6rem;padding:.7rem;border-left:2px solid var(--accent-deep);background:var(--surface-muted)}.machine footer span,.machine footer strong{display:block}.machine footer span{color:var(--muted);font-size:.64rem}.machine footer strong{margin-top:.25rem;font-size:.72rem}.mechanism-note{display:grid;grid-template-columns:8rem 1fr;gap:.7rem;margin-top:.8rem;padding:.75rem;border-top:1px solid var(--line)}.mechanism-note strong{font-size:.74rem}.mechanism-note p{margin:0;color:var(--muted);font-size:.7rem;line-height:1.5}@media(max-width:760px){.mechanism-section{width:min(100% - 1rem,1120px)}.shared-input{grid-template-columns:1fr}.machines{grid-template-columns:1fr}.mechanism-note{grid-template-columns:1fr}}
</style>
