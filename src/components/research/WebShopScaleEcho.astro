---
import { localePath, type Locale } from '../../i18n';
interface Props { locale: Locale; side: 'webshop' | 'seed' }
const { locale, side } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---

<section id="fig-webshop-scale-echo" class="canonical-figure webshop-scale-echo" aria-labelledby="webshop-scale-echo-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">{t('图 S1-D · 关系对照','FIGURE S1-D · RELATIONSHIP MAP')}</div>
    <h2 id="webshop-scale-echo-title">{t('这些数字之间，不是同一种“缩小”关系','These numbers are not all the same kind of “shrink”')}</h2>
    <p>{side === 'webshop'
      ? t('把真正发生的操作拆开：商品世界是取子集，商品到 goals 是生成；评估部分则必须保留论文与 released code 之间尚未钉死的边界。','Separate the actual operations: the product world is subset selection, products-to-goals is generation, and evaluation must preserve the still-unpinned boundary between the paper and released code.')
      : t('进入 SEED 训练细节之前，先固定场地关系：哪些是取子集，哪些是任务生成，哪些仍然只是论文与 released code 之间的评估边界。','Before SEED training details, fix the arena relationships: what is subset selection, what is task generation, and what remains only an evaluation boundary between the paper and released code.')}
    </p>
    <div class="figure-actions">
      {side === 'webshop' ? (
        <a href={p('/research/seed-openevo/seed/#fig-webshop-scale-echo')}>{t('SEED 方法页上的同一关系图 →','Same relationship map on the SEED page →')}</a>
      ) : (
        <>
          <a href={p('/research/seed-openevo/webshop/#fig-webshop-small-world')}>{t('商品世界来源 →','Product-world provenance →')}</a>
          <a href={p('/research/seed-openevo/webshop/#fig-webshop-goal-generation')}>{t('任务生成过程 →','Goal-generation process →')}</a>
        </>
      )}
    </div>
  </header>

  <figure class="relation-rows" aria-labelledby="webshop-scale-echo-title">
    <section class="relation-row" aria-label={t('商品世界取子集','Product-world subset')}>
      <header class="relation-dim"><small>01</small><strong>{t('商品世界','Product world')}</strong></header>
      <article class="relation-card" data-ui-audit-item>
        <small>{t('完整 WEBSHOP','FULL WEBSHOP')}</small>
        <strong>1,181,436</strong>
        <span>{t('商品（products）','products')}</span>
      </article>
      <div class="operation subset">
        <b>{t('SUBSET · 取子集','SUBSET')}</b>
        <span>{t('WebShop 官方 small 配置','WebShop official small configuration')}</span>
        <i aria-hidden="true">→</i>
      </div>
      <article class="relation-card accent" data-ui-audit-item>
        <small>{t('SMALL WEBSHOP','SMALL WEBSHOP')}</small>
        <strong>1,000</strong>
        <span>{t('商品（products）','products')}</span>
      </article>
    </section>

    <section class="relation-row" aria-label={t('商品生成 goals','Products generate goals')}>
      <header class="relation-dim"><small>02</small><strong>{t('任务生成','Goal generation')}</strong></header>
      <article class="relation-card accent" data-ui-audit-item>
        <small>{t('SMALL WEBSHOP','SMALL WEBSHOP')}</small>
        <strong>1,000</strong>
        <span>{t('商品（products）','products')}</span>
      </article>
      <div class="operation generate">
        <b>{t('GENERATE · 生成','GENERATE')}</b>
        <span>get_synthetic_goals(...)</span>
        <i aria-hidden="true">→</i>
      </div>
      <article class="relation-card accent" data-ui-audit-item>
        <small>{t('SMALL ENV OUTPUT','SMALL ENV OUTPUT')}</small>
        <strong>6,910</strong>
        <span>{t('goals（可执行购物任务）','goals (executable shopping tasks)')}</span>
      </article>
    </section>

    <section class="relation-row boundary-row" aria-label={t('评估边界','Evaluation boundary')}>
      <header class="relation-dim"><small>03</small><strong>{t('评估边界','Evaluation boundary')}</strong></header>
      <article class="relation-card" data-ui-audit-item>
        <small>{t('RELEASED CODE','RELEASED CODE')}</small>
        <strong>500</strong>
        <span>{t('goal 0–499 held-out slots','goal 0–499 held-out slots')}</span>
      </article>
      <div class="operation unknown">
        <b>{t('EXACT MAPPING 未钉死','EXACT MAPPING UNPINNED')}</b>
        <span>{t('不能画成确定的抽样箭头','Do not draw this as a confirmed sampling arrow')}</span>
        <i aria-hidden="true">⋯</i>
      </div>
      <article class="relation-card paper" data-ui-audit-item>
        <small>{t('SEED PAPER REPORTED','SEED PAPER REPORTED')}</small>
        <strong>128</strong>
        <span>{t('test samples（exact IDs 未公开钉死）','test samples (exact IDs not publicly pinned)')}</span>
      </article>
    </section>

    <aside class="anti-shortcut" role="note">
      <strong>{t('不要再这样读','Do not read it this way')}</strong>
      <code>12,087 → 6,910 = “缩小 43%”</code>
      <span>{t('12,087 是原始人类文本指令统计；6,910 是 small 环境生成的 goals。它们不是同一单位，所以不做缩减百分比。','12,087 counts original human text instructions; 6,910 counts goals generated in the small environment. They are not the same unit, so no reduction percentage is meaningful.')}</span>
    </aside>

    <figcaption>{t('正确的视觉语法是：1,181,436 → 1,000 表示 subset（取子集）；1,000 → 6,910 表示 generate（生成）；500 与论文报告的 128 之间只标记评估边界，exact 128-goal manifest 未钉死。','The correct visual grammar is: 1,181,436 → 1,000 means subset selection; 1,000 → 6,910 means generation; between the 500 released-code held-out slots and the paper-reported 128, show only an evaluation boundary because the exact 128-goal manifest is not pinned.')}</figcaption>
  </figure>
</section>

<style>
  .webshop-scale-echo{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:880px}.figure-label{color:var(--accent);font:800 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.7rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:1.65}.figure-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.figure-actions a{padding:.45rem .65rem;border:1px solid var(--line);border-radius:6px;color:var(--ink);font-weight:750;text-decoration:none}.figure-actions a:hover,.figure-actions a:focus-visible{border-color:var(--accent);color:var(--accent)}
  .relation-rows{display:grid;gap:.72rem;margin:1.45rem 0 0}.relation-row{display:grid;grid-template-columns:minmax(90px,.42fr) minmax(0,1fr) minmax(170px,.65fr) minmax(0,1fr);gap:.6rem;align-items:stretch;padding:.72rem;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}
  .relation-dim{align-self:center}.relation-dim small{display:block;color:var(--accent);font:800 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.relation-dim strong{display:block;margin-top:.28rem;font-size:.93rem}.relation-card{min-width:0;padding:.82rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.relation-card small{display:block;color:var(--muted);font:800 .56rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em}.relation-card strong{display:block;margin:.38rem 0 .15rem;font-size:clamp(1.45rem,2.7vw,2.2rem);line-height:1;letter-spacing:-.035em}.relation-card span{display:block;color:var(--muted);font-size:.68rem;line-height:1.45}.relation-card.accent{border-top:4px solid var(--accent)}.relation-card.paper{border-top:4px solid var(--success)}
  .operation{position:relative;display:grid;place-items:center;align-content:center;gap:.3rem;text-align:center;padding:.65rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.operation b{padding:.27rem .48rem;border-radius:999px;font:850 .62rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap}.operation span{color:var(--muted);font-size:.63rem;line-height:1.35}.operation i{color:var(--accent);font-size:1.2rem;font-style:normal;font-weight:900}.operation.subset b{background:color-mix(in srgb,var(--accent) 10%,var(--surface));color:var(--accent)}.operation.generate b{background:color-mix(in srgb,var(--success) 12%,var(--surface));color:var(--success)}.operation.unknown{border-style:dashed}.operation.unknown b{background:var(--surface-muted);color:var(--muted)}.operation.unknown i{color:var(--muted);letter-spacing:.15em}
  .anti-shortcut{display:grid;grid-template-columns:auto auto 1fr;gap:.75rem;align-items:center;padding:.9rem 1rem;border:1px solid #b84a4a;border-radius:11px;background:color-mix(in srgb,#b84a4a 5%,var(--surface))}.anti-shortcut strong{color:#b84a4a;font-size:.72rem}.anti-shortcut code{padding:.38rem .48rem;border-radius:6px;background:var(--surface);font-size:.68rem;text-decoration:line-through;text-decoration-thickness:2px}.anti-shortcut span{color:var(--muted);font-size:.7rem;line-height:1.45}.relation-rows figcaption{color:var(--muted);font-size:.76rem;line-height:1.6}
  @media(max-width:800px){.webshop-scale-echo{width:min(100% - 1rem,1120px);padding:1rem}.relation-row{grid-template-columns:1fr}.operation{min-height:110px}.operation i{transform:rotate(90deg)}.operation.unknown i{transform:none}.anti-shortcut{grid-template-columns:1fr}.anti-shortcut code{overflow-wrap:anywhere}}
</style>
