---
import { localePath, type Locale } from '../../i18n';
interface Props { locale: Locale; side: 'webshop' | 'seed' }
const { locale, side } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---

<section id="fig-webshop-scale-echo" class="canonical-figure webshop-scale-echo" aria-labelledby="webshop-scale-echo-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">{t('图 S1-D · 规模呼应','FIGURE S1-D · SCALE ECHO')}</div>
    <h2 id="webshop-scale-echo-title">{t('规模对照','Scale correspondence')}</h2>
    {side === 'webshop' ? (
      <p>{t('把图 S1-B 的原始规模和图 S1-C 的 SEED 场地放到同一把尺上：同一维度，左边是原始 WebShop，右边是 SEED 论文语境下实际进入的场地。同一幅对照也镜像挂在 SEED 方法页。','Place Figure S1-B’s original scale and Figure S1-C’s SEED setting on the same ruler: same dimension, original WebShop on the left, the arena actually entered in the SEED paper context on the right. The same correspondence mirrors on the SEED page.')}</p>
    ) : (
      <p>{t('进入训练细节之前，先看场地本身：SEED 没有使用完整的原始 WebShop，而是进入公开代码默认启用的 small WebShop，三个维度逐项缩小。同一幅对照也镜像挂在 WebShop 环境页。','Before the training details, look at the arena itself: SEED does not use the full original WebShop; it enters the small WebShop that the released code enables by default, and all three dimensions shrink. The same correspondence mirrors on the WebShop page.')}</p>
    )}
    <div class="figure-actions">
      {side === 'webshop' ? (
        <a href={p('/research/seed-openevo/seed/#fig-webshop-scale-echo')}>{t('SEED 方法页上的同一对照 →','Same correspondence on the SEED page →')}</a>
      ) : (
        <>
          <a href={p('/research/seed-openevo/webshop/#fig-webshop-dataset')}>{t('原始数据集 S1-B →','Original dataset S1-B →')}</a>
          <a href={p('/research/seed-openevo/webshop/#fig-seed-webshop')}>{t('公平场地 S1-C →','Fair setting S1-C →')}</a>
        </>
      )}
    </div>
  </header>

  <figure class="echo-rows" aria-labelledby="webshop-scale-echo-title">
    <section class="echo-row" aria-label={t('商品世界规模','Product world scale')}>
      <header class="echo-dim"><small>{t('维度 1','DIMENSION 1')}</small><strong>{t('商品世界','Product world')}</strong></header>
      <article class="echo-card original" data-ui-audit-item>
        <small>{t('原始 WEBSHOP','ORIGINAL WEBSHOP')}</small>
        <strong>1,181,436</strong>
        <span>{t('商品（products）','products')}</span>
      </article>
      <div class="echo-connector" aria-hidden="true"><span class="bar"></span><b>÷1,181</b><em>{t('缩到 0.08%','to 0.08%')}</em></div>
      <article class="echo-card seed" data-ui-audit-item>
        <small>{t('SEED 场地 · RELEASED CODE','SEED ARENA · RELEASED CODE')}</small>
        <strong>1,000</strong>
        <span>{t('small WebShop 商品','small WebShop products')}</span>
      </article>
    </section>

    <section class="echo-row" aria-label={t('任务池规模','Task pool scale')}>
      <header class="echo-dim"><small>{t('维度 2','DIMENSION 2')}</small><strong>{t('任务池','Task pool')}</strong></header>
      <article class="echo-card original" data-ui-audit-item>
        <small>{t('原始 WEBSHOP','ORIGINAL WEBSHOP')}</small>
        <strong>12,087</strong>
        <span>{t('购物指令（instructions）','shopping instructions')}</span>
      </article>
      <div class="echo-connector" aria-hidden="true"><span class="bar"></span><b>÷1.7</b><em>{t('缩到 57%','to 57%')}</em></div>
      <article class="echo-card seed" data-ui-audit-item>
        <small>{t('SEED 场地 · RELEASED CODE','SEED ARENA · RELEASED CODE')}</small>
        <strong>6,910</strong>
        <span>{t('small-env goals','small-env goals')}</span>
      </article>
    </section>

    <section class="echo-row" aria-label={t('最终考试规模','Final test scale')}>
      <header class="echo-dim"><small>{t('维度 3','DIMENSION 3')}</small><strong>{t('最终考试','Final test')}</strong></header>
      <article class="echo-card original" data-ui-audit-item>
        <small>{t('原始 WEBSHOP · TEST','ORIGINAL WEBSHOP · TEST')}</small>
        <strong>500</strong>
        <span>{t('官方测试任务','official test tasks')}</span>
      </article>
      <div class="echo-connector" aria-hidden="true"><span class="bar"></span><b>÷3.9</b><em>{t('缩到 26%','to 26%')}</em></div>
      <article class="echo-card seed paper" data-ui-audit-item>
        <small>{t('SEED 论文报告 · PAPER REPORTED','SEED PAPER · PAPER REPORTED')}</small>
        <strong>128</strong>
        <span>{t('论文 test samples（exact IDs 未钉死）','paper test samples (exact IDs not pinned)')}</span>
      </article>
    </section>

    <figcaption>{t('原始规模来自图 S1-B；1,000 商品与 6,910 goals 来自 released code 默认启用的 small WebShop；128 为 SEED 论文报告的 test samples，exact 128-goal manifest 仍未公开钉死。任务池一行的单位随环境定义变化：原始购物指令与 small-env goals 不是同一计量单位。','Original scale comes from Figure S1-B; the 1,000 products and 6,910 goals come from the small WebShop enabled by default in the released code; 128 is the SEED paper’s reported test samples and the exact 128-goal manifest is still not publicly pinned. Units on the task-pool row follow each environment’s definition: original shopping instructions are not the same unit as small-env goals.')}</figcaption>
  </figure>
</section>

<style>
  .webshop-scale-echo{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:820px}.figure-label{color:var(--accent);font:800 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.7rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:1.65}.figure-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.figure-actions a{padding:.45rem .65rem;border:1px solid var(--line);border-radius:6px;color:var(--ink);font-weight:750;text-decoration:none}.figure-actions a:hover,.figure-actions a:focus-visible{border-color:var(--accent);color:var(--accent)}
  .echo-rows{display:grid;gap:.7rem;margin:1.45rem 0 0}
  .echo-row{display:grid;grid-template-columns:minmax(96px,.5fr) minmax(0,1fr) minmax(96px,.36fr) minmax(0,1fr);gap:.6rem;align-items:stretch;padding:.7rem;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}
  .echo-dim{align-self:center}.echo-dim small{display:block;color:var(--muted);font:800 .56rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.echo-dim strong{display:block;margin-top:.3rem;font-size:.95rem}
  .echo-card{min-width:0;padding:.8rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.echo-card small{display:block;color:var(--muted);font:800 .56rem/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em}.echo-card strong{display:block;margin:.38rem 0 .16rem;font-size:clamp(1.4rem,2.6vw,2.15rem);line-height:1;letter-spacing:-.03em}.echo-card span{display:block;color:var(--muted);font-size:.68rem;line-height:1.45}.echo-card.original{border-top:4px solid var(--accent)}.echo-card.seed{border-top:4px solid var(--accent)}.echo-card.seed.paper{border-top-color:var(--success)}
  .echo-connector{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.22rem}.echo-connector .bar{position:absolute;left:0;right:0;top:50%;height:2px;background:var(--accent);transform:translateY(-50%)}.echo-connector .bar::after{content:'';position:absolute;right:-1px;top:50%;border:5px solid transparent;border-left-color:var(--accent);transform:translateY(-50%)}.echo-connector b{position:relative;z-index:1;padding:.3rem .48rem;border:1px solid var(--accent);border-radius:999px;background:var(--surface);color:var(--accent);font:800 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap}.echo-connector em{position:relative;z-index:1;color:var(--muted);font:700 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;font-style:normal;white-space:nowrap}
  .echo-rows figcaption{margin-top:.85rem;max-width:90ch;color:var(--muted);font-size:.76rem;line-height:1.6}
  @media(max-width:760px){
    .webshop-scale-echo{width:min(100% - 1rem,1120px);padding:1rem}
    .echo-row{grid-template-columns:1fr;gap:.55rem}
    .echo-connector{padding:1.05rem 0}
    .echo-connector .bar{left:50%;right:auto;top:0;bottom:0;width:2px;height:auto;transform:translateX(-50%)}
    .echo-connector .bar::after{right:auto;left:50%;top:auto;bottom:-1px;transform:translateX(-50%);border:5px solid transparent;border-top-color:var(--accent)}
  }
</style>
