---
import { type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const seedEnvUrl = 'https://github.com/jinyangwu/SEED/blob/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c/agent_system/environments/env_package/webshop/envs.py';
const originalEnvUrl = 'https://github.com/princeton-nlp/WebShop/blob/master/baseline_models/env.py';
---

<section id="fig-webshop-seed-split" class="canonical-figure webshop-seed-split" aria-labelledby="webshop-seed-split-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">{t('第四步 · SEED 重新定义 GOAL SPLIT','STEP 4 · SEED REDEFINES THE GOAL SPLIT')}</div>
    <h2 id="webshop-seed-split-title">{t('原始 WebShop 有 train / eval / test，为什么 SEED 这里只剩两块？','Original WebShop has train / eval / test. Why does SEED show only two pools?')}</h2>
    <p>{t('关键是分清两个层次：原始 benchmark 的人工指令有 train / dev / test；而这里讨论的是 wrapper 如何从环境 goal 列表里选 goal index。SEED released code 没有沿用原始三段式 goal-index wrapper，而是启用了两段式规则。','The key is to separate two levels: the original benchmark has train / dev / test splits for human instructions, while this figure is about how a wrapper selects goal indices from the environment goal list. The released SEED code does not keep the original three-way goal-index wrapper; it activates a two-way rule instead.')}</p>
  </header>

  <figure class="split-story" aria-labelledby="webshop-seed-split-title">
    <aside class="two-levels" role="note">
      <div class="level-label">
        <small>{t('先分清两个“split”','FIRST: TWO DIFFERENT SPLITS')}</small>
        <strong>{t('名字看起来相似，但数的不是同一种对象','They sound similar, but they count different objects')}</strong>
      </div>
      <div class="level-row benchmark-level">
        <div class="level-name">
          <b>{t('原始 benchmark','Original benchmark')}</b>
          <span>{t('12,087 human instructions（人工指令）','12,087 human instructions')}</span>
        </div>
        <div class="mini-splits" aria-label={t('原始 benchmark 人工指令划分','Original benchmark human-instruction split')}>
          <span><b>10,587</b>{t('Train','Train')}</span>
          <span><b>1,000</b>{t('Dev','Dev')}</span>
          <span><b>500</b>{t('Test','Test')}</span>
        </div>
        <a href="#fig-webshop-dataset">{t('回看前面的原始数据图 ↑','See the earlier dataset figure ↑')}</a>
      </div>
      <div class="level-separator" aria-hidden="true">≠</div>
      <div class="level-row goal-level">
        <div class="level-name">
          <b>{t('这一张讨论的对象','What this figure discusses')}</b>
          <span>{t('environment goals 的 index（环境任务索引）','environment-goal indices')}</span>
        </div>
        <p>{t('下面的 0、499、500、1499、1500……都是 goal 列表的索引边界，不是上面 12,087 条人工指令的 train/dev/test ID。','The 0, 499, 500, 1499, 1500… values below are boundaries in the environment goal list, not train/dev/test IDs from the 12,087 human instructions above.')}</p>
      </div>
    </aside>

    <section class="before-after" aria-label={t('原始 WebShop 与 SEED wrapper 划分对照','Original WebShop versus SEED wrapper split')}>
      <article class="wrapper original-wrapper" data-ui-audit-item>
        <header>
          <small>{t('原始 WEBSHOP BASELINE WRAPPER','ORIGINAL WEBSHOP BASELINE WRAPPER')}</small>
          <strong>{t('三段式 goal-index split','Three-way goal-index split')}</strong>
          <span>{t('原始 baseline env.py 的 full/default 路径（args.num is None）','Full/default path in the original baseline env.py (args.num is None)')}</span>
        </header>
        <div class="original-bar" role="img" aria-label={t('原始 wrapper: test 0 到 499, eval 500 到 1499, train 1500 到最后','Original wrapper: test 0–499, eval 500–1499, train 1500 onward')}>
          <div class="orig-test"><b>TEST</b><span>0–499</span></div>
          <div class="orig-eval"><b>EVAL</b><span>500–1499</span></div>
          <div class="orig-train"><b>TRAIN</b><span>1500–…</span></div>
        </div>
        <div class="code-lines">
          <code>test → range(500)</code>
          <code>eval → range(500, 1500)</code>
          <code>train → range(1500, len(goals))</code>
        </div>
        <a href={originalEnvUrl} target="_blank" rel="noreferrer">{t('查看 WebShop 官方 baseline env.py ↗','View official WebShop baseline env.py ↗')}</a>
      </article>

      <div class="rewrite" role="note">
        <span class="rewrite-arrow" aria-hidden="true">→</span>
        <strong>{t('SEED 改了 wrapper 规则','SEED CHANGES THE WRAPPER RULE')}</strong>
        <p>{t('SEED 文件里保留了原始三段代码作为注释，但真正执行的是下面的两段式 if/else。','The SEED file keeps the original three-way block as comments, but the active code is the two-way if/else shown below.')}</p>
      </div>

      <article class="wrapper seed-wrapper" data-ui-audit-item>
        <header>
          <small>{t('SEED RELEASED CODE','SEED RELEASED CODE')}</small>
          <strong>{t('两段式：non-train / train','Two-way: non-train / train')}</strong>
          <span>{t('不再单独保留 eval bucket','No separate eval bucket remains')}</span>
        </header>
        <div class="seed-bar" role="img" aria-label={t('SEED wrapper: non-train 0 到 499, train 从 500 到最后','SEED wrapper: non-train 0–499, train from 500 onward')}>
          <div class="seed-heldout"><b>NON-TRAIN</b><span>0–499</span></div>
          <div class="seed-train"><b>TRAIN</b><span>500–…</span></div>
        </div>
        <div class="code-lines">
          <code>not is_train → range(500)</code>
          <code>is_train → range(500, len(goals))</code>
        </div>
        <div class="eval-change">
          <span>500–1499</span>
          <p>{t('在原始 wrapper 里叫 EVAL；在 SEED 当前启用规则里，它已经落进 training candidate pool。','This range was EVAL in the original wrapper; under SEED’s active rule it now falls inside the training candidate pool.')}</p>
        </div>
        <a href={seedEnvUrl} target="_blank" rel="noreferrer">{t('查看 SEED 固定 commit 的 envs.py ↗','View SEED envs.py at the pinned commit ↗')}</a>
      </article>
    </section>

    <aside class="takeaway" role="note">
      <strong>{t('所以为什么从三块变成两块？','So why did three pools become two?')}</strong>
      <p>{t('不是因为 WebShop 从此没有验证集概念，而是因为 SEED 的 WebShop wrapper 没有继续使用原始 baseline 的 test / eval / train 三段式 goal-index 选择；它把运行接口简化成 is_train = false 与 is_train = true 两种状态。','It is not because WebShop stopped having a validation concept. The reason is that SEED’s WebShop wrapper no longer uses the original baseline’s three-way test / eval / train goal-index selection; its active interface is simplified to two states: is_train = false and is_train = true.')}</p>
    </aside>

    <section class="total" aria-label={t('SEED small WebShop 的全部 goals','All goals in SEED small WebShop')}>
      <small>{t('现在把这条规则应用到 SMALL WEBSHOP','NOW APPLY THAT RULE TO SMALL WEBSHOP')}</small>
      <strong>6,910 goals</strong>
      <span>{t('goal ID 0–6909','goal IDs 0–6909')}</span>
    </section>

    <div class="ruler-wrap" aria-label={t('SEED goal ID 横向标尺','SEED goal ID ruler')}>
      <div class="axis-labels" aria-hidden="true">
        <span class="axis-start">0</span>
        <span class="axis-boundary"><b>499</b><i></i><b>500</b></span>
        <span class="axis-end">6909</span>
      </div>

      <div class="ruler" role="img" aria-label={t('goal 0 到 499 是 500 个 held-out goals；goal 500 到 6909 是 6410 个 training candidate goals','goals 0 through 499 are 500 held-out goals; goals 500 through 6909 are 6,410 training candidate goals')}>
        <div class="segment heldout">
          <span>{t('HELD-OUT','HELD-OUT')}</span>
        </div>
        <div class="segment train">
          <span>{t('TRAIN CANDIDATE POOL','TRAIN CANDIDATE POOL')}</span>
        </div>
        <div class="boundary-line" aria-hidden="true"></div>
      </div>

      <div class="boundary-caption">
        <span></span>
        <strong>{t('边界 = 500','BOUNDARY = 500')}</strong>
        <p>{t('左边到 goal 499 为止；右边从 goal 500 开始。','The left side ends at goal 499; the right side starts at goal 500.')}</p>
      </div>
    </div>

    <section class="pool-cards" aria-label={t('两个 goal pool','Two goal pools')}>
      <article class="pool heldout-card" data-ui-audit-item>
        <small>{t('RELEASED-CODE EXPLICIT','RELEASED-CODE EXPLICIT')}</small>
        <strong>goal 0–499</strong>
        <span>{t('500 goals','500 goals')}</span>
        <p>{t('当 is_train = false，SEED wrapper 使用 range(500)。','When is_train = false, the SEED wrapper uses range(500).')}</p>
      </article>
      <article class="pool train-card" data-ui-audit-item>
        <small>{t('RELEASED-CODE EXPLICIT','RELEASED-CODE EXPLICIT')}</small>
        <strong>goal 500–6909</strong>
        <span>{t('6,410 goals','6,410 goals')}</span>
        <p>{t('当 is_train = true，SEED wrapper 使用 range(500, len(goals))。','When is_train = true, the SEED wrapper uses range(500, len(goals)).')}</p>
      </article>
    </section>

    <aside class="not-128" role="note">
      <div class="note-symbol" aria-hidden="true">!</div>
      <div>
        <strong>{t('这一张为什么仍然不画 128？','Why is 128 still not drawn on this ruler?')}</strong>
        <p>{t('因为 128 是 SEED 论文报告的 test samples；目前没有公开证据把 exact 128 goal IDs 钉死到 0–499 中的具体位置。这里不把未知关系画成确定抽样。','Because 128 is the SEED paper’s reported test-sample count; public evidence does not currently pin the exact 128 goal IDs to specific positions inside 0–499. This figure does not turn an unknown mapping into a confirmed sampling path.')}</p>
      </div>
    </aside>

    <details class="evidence">
      <summary>{t('查看原始 WebShop 与 SEED 的代码对照','Compare original WebShop and SEED code')}</summary>
      <div class="evidence-grid">
        <article>
          <small>{t('WebShop baseline env.py · OFFICIAL','WebShop baseline env.py · OFFICIAL')}</small>
          <pre><code>if split == 'test':
    goal_idxs = range(500)
elif split == 'eval':
    goal_idxs = range(500, 1500)
elif split == 'train':
    goal_idxs = range(1500, len(goals))</code></pre>
          <p>{t('注意：原始代码把这组三段式逻辑放在 args.num is None 的分支里。','Note: the original code places this three-way logic inside the args.num is None branch.')}</p>
          <a href={originalEnvUrl} target="_blank" rel="noreferrer">{t('打开 WebShop 官方代码 ↗','Open official WebShop code ↗')}</a>
        </article>
        <article>
          <small>{t('SEED envs.py · RELEASED CODE','SEED envs.py · RELEASED CODE')}</small>
          <pre><code># original three-way block is commented out
if not self.is_train:
    self.goal_idxs = range(500)
else:
    self.goal_idxs = range(500, len(goals))</code></pre>
          <p>{t('SEED 源文件里可以直接看到：原始三段式块被注释，下面两段式代码才是实际执行路径。','The SEED source makes this directly visible: the original three-way block is commented out, and the two-way block below is the active path.')}</p>
          <a href={seedEnvUrl} target="_blank" rel="noreferrer">{t('打开 SEED 固定 commit ↗','Open pinned SEED commit ↗')}</a>
        </article>
        <article>
          <small>{t('本图的计算','DERIVATION IN THIS FIGURE')}</small>
          <code>500–6909 → 6910 - 500 = 6410</code>
          <p>{t('6,410 是由 SEED active range 与 small 环境的 6,910 goals 直接计算得到。goal ID 只是列表索引，不是商品编号。','6,410 is directly derived from the active SEED range and the small environment’s 6,910 goals. A goal ID is only a list index, not a product ID.')}</p>
        </article>
      </div>
    </details>

    <figcaption>{t('结论：原始 WebShop 的 benchmark 数据有 train / dev / test；原始 baseline wrapper 也定义过 test / eval / train 三段 goal-index 逻辑。但 SEED released wrapper 实际启用的是两段式：goal 0–499 为 non-train / held-out，goal 500–6909 为 training candidates。','Conclusion: the original WebShop benchmark has train / dev / test data splits, and the original baseline wrapper also defines a three-way test / eval / train goal-index path. The released SEED wrapper, however, actively uses two pools: goals 0–499 as non-train / held-out and goals 500–6909 as training candidates.')}</figcaption>
  </figure>
</section>

<style>
  .webshop-seed-split{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:930px}.figure-label{color:var(--accent);font:800 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.75rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:1.65}
  .split-story{--heldout:7.2359%;margin:1.55rem 0 0}
  .two-levels{display:grid;grid-template-columns:minmax(170px,.55fr) 1fr auto 1fr;gap:.7rem;align-items:stretch;padding:1rem;border:1px solid var(--line);border-radius:13px;background:var(--surface-muted)}.level-label{align-self:center}.level-label small{display:block;color:var(--accent);font:800 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.level-label strong{display:block;margin-top:.35rem;font-size:.82rem;line-height:1.4}.level-row{min-width:0;padding:.8rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.level-name b,.level-name span{display:block}.level-name b{font-size:.76rem}.level-name span{margin-top:.2rem;color:var(--muted);font-size:.66rem;line-height:1.35}.mini-splits{display:grid;grid-template-columns:2.1fr .72fr .45fr;gap:.3rem;margin-top:.65rem}.mini-splits span{display:flex;min-width:0;flex-direction:column;justify-content:center;padding:.48rem;border:1px solid var(--line);border-radius:7px;font-size:.58rem}.mini-splits b{font-size:.72rem}.benchmark-level a{display:inline-block;margin-top:.55rem;color:var(--accent);font-size:.64rem;font-weight:800}.level-separator{align-self:center;color:var(--muted);font-size:1.4rem;font-weight:900}.goal-level p{margin:.65rem 0 0;color:var(--muted);font-size:.68rem;line-height:1.5}
  .before-after{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,.42fr) minmax(0,1fr);gap:.75rem;margin-top:.85rem}.wrapper{display:flex;min-width:0;flex-direction:column;padding:1rem;border:1px solid var(--line);border-radius:13px;background:var(--surface-muted)}.wrapper header small{display:block;color:var(--muted);font:800 .57rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em}.wrapper header strong{display:block;margin:.35rem 0 .15rem;font-size:1rem}.wrapper header span{display:block;color:var(--muted);font-size:.66rem;line-height:1.4}.wrapper>a{display:inline-block;margin-top:auto;padding-top:.7rem;color:var(--accent);font-size:.67rem;font-weight:800}.original-bar,.seed-bar{display:flex;height:68px;margin-top:.85rem;overflow:hidden;border:1px solid var(--line);border-radius:9px}.original-bar>div,.seed-bar>div{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;padding:.4rem;border-right:1px solid var(--line);text-align:center}.original-bar>div:last-child,.seed-bar>div:last-child{border-right:0}.original-bar b,.seed-bar b{font:850 .58rem/1.1 ui-monospace,SFMono-Regular,Menlo,monospace}.original-bar span,.seed-bar span{margin-top:.2rem;color:var(--muted);font-size:.58rem}.orig-test{flex:1;background:color-mix(in srgb,var(--accent) 10%,var(--surface))}.orig-eval{flex:2;background:color-mix(in srgb,var(--ink) 5%,var(--surface))}.orig-train{flex:4;background:color-mix(in srgb,var(--success) 8%,var(--surface))}.seed-heldout{flex:1;background:color-mix(in srgb,var(--accent) 13%,var(--surface))}.seed-train{flex:6;background:color-mix(in srgb,var(--success) 11%,var(--surface))}.code-lines{display:grid;gap:.3rem;margin-top:.7rem}.code-lines code{display:block;padding:.38rem .45rem;border-radius:6px;background:var(--surface);font-size:.61rem;overflow-wrap:anywhere}.rewrite{display:grid;place-items:center;align-content:center;gap:.4rem;padding:.75rem;border:1px dashed var(--line);border-radius:13px;text-align:center}.rewrite-arrow{color:var(--accent);font-size:1.6rem;font-weight:900}.rewrite strong{font:900 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.rewrite p{margin:0;color:var(--muted);font-size:.66rem;line-height:1.45}.eval-change{display:grid;grid-template-columns:auto 1fr;gap:.55rem;align-items:start;margin-top:.65rem;padding:.55rem;border:1px dashed var(--line);border-radius:8px;background:var(--surface)}.eval-change span{padding:.25rem .35rem;border-radius:5px;background:var(--surface-muted);font:800 .61rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.eval-change p{margin:0;color:var(--muted);font-size:.64rem;line-height:1.4}
  .takeaway{margin-top:.8rem;padding:.85rem 1rem;border-left:4px solid var(--accent);border-radius:8px;background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.takeaway strong{font-size:.8rem}.takeaway p{margin:.3rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}
  .total{display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-top:1.2rem;padding:.75rem 0 1rem;border-bottom:1px solid var(--line)}.total small{color:var(--muted);font:800 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.total strong{font-size:1.35rem;letter-spacing:-.03em}.total span{color:var(--muted);font-size:.72rem}
  .ruler-wrap{position:relative;margin:2.2rem 0 1rem;padding:1.45rem 0 0}.axis-labels{position:relative;height:1.5rem;color:var(--muted);font:800 .66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.axis-start{position:absolute;left:0}.axis-end{position:absolute;right:0}.axis-boundary{position:absolute;left:var(--heldout);display:flex;gap:.38rem;align-items:center;transform:translateX(-50%)}.axis-boundary i{width:1px;height:.8rem;background:var(--line)}
  .ruler{position:relative;display:flex;height:78px;overflow:hidden;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}.segment{display:flex;align-items:center;justify-content:center;min-width:0}.segment span{font:850 .62rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.04em;text-align:center}.heldout{width:var(--heldout);background:color-mix(in srgb,var(--accent) 14%,var(--surface))}.heldout span{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.55rem}.train{flex:1;background:color-mix(in srgb,var(--success) 12%,var(--surface))}.train span{color:var(--ink)}.boundary-line{position:absolute;left:var(--heldout);top:0;bottom:0;width:3px;background:var(--ink);transform:translateX(-1px)}
  .boundary-caption{position:relative;display:grid;grid-template-columns:var(--heldout) auto 1fr;align-items:start;margin-top:.65rem}.boundary-caption>span{grid-column:1;height:1px}.boundary-caption strong{grid-column:2;padding:.28rem .45rem;border-radius:999px;background:var(--ink);color:var(--surface);font:850 .61rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap;transform:translateX(-50%)}.boundary-caption p{grid-column:3;margin:.1rem 0 0 .4rem;color:var(--muted);font-size:.68rem;line-height:1.4}
  .pool-cards{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:.75rem;margin-top:1rem}.pool{padding:1rem;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}.pool small{display:block;color:var(--muted);font:800 .57rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em}.pool strong{display:block;margin:.45rem 0 .18rem;font-size:1.25rem;letter-spacing:-.025em}.pool span{display:block;font-weight:800}.pool p{margin:.5rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}.heldout-card{border-top:4px solid var(--accent)}.train-card{border-top:4px solid var(--success)}
  .not-128{display:grid;grid-template-columns:auto 1fr;gap:.8rem;align-items:start;margin-top:.8rem;padding:.9rem 1rem;border:1px dashed var(--line);border-radius:11px;background:var(--surface)}.note-symbol{display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--line);border-radius:50%;font-weight:900}.not-128 strong{display:block;font-size:.78rem}.not-128 p{margin:.28rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}
