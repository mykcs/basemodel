---
import type { Locale } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import { localePath } from '../../i18n';
import { openEvoHarness2Qualification as q } from '../../data/openEvoHarness2Qualification';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const parentHref = p('/research/seed-openevo/study/capability-exploration/openevo-2-0/');
const controlInvalidPct = q.control.invalidTerminatedRate * 100;
const candidateInvalidPct = q.candidate.invalidTerminatedRate * 100;
const formatDeltaPp = (q.candidate.formatInvalidRate - q.control.formatInvalidRate) * 100;
const stateDeltaPp = (q.candidate.stateInadmissibleRate - q.control.stateInadmissibleRate) * 100;
const semanticDeltaPp = (q.candidate.semanticInvalidRate - q.control.semanticInvalidRate) * 100;
---

<main data-copy-review class="h2study" data-testid="harness2-mini-study">
  <nav class="h2study__back" aria-label={t('OpenEVO 2.0 研究导航','OpenEVO 2.0 research navigation')}>
    <a href={parentHref}>← {t('返回 OpenEVO 2.0','Back to OpenEVO 2.0')}</a>
  </nav>

  <header class="h2study__hero">
    <div>
      <p>{t("购物接口检查 · Mini Study 01", "INTERFACE CHECK · MINI STUDY 01")}</p>
      <h1>{t("购物接口的历史对照实验", "Historical shopping-interface comparison")}</h1>
      <strong>{t("历史对照中，新接口让更多购物尝试因无效动作提前结束，因此当时没有启用正式训练。", "In this historical comparison, the new interface increased attempts ending early on invalid actions, so formal training was not activated.")}</strong>
      <span>{t("购物接口（Harness）把模型回答转换成搜索、点击等操作。实验从同一个 3B 模型出发，让两组各完成 128 次相同的购物尝试：对照组不加入经验提示，候选组加入经过检查的记忆、技能和行为规则。任务、随机设置与动作步数限制保持一致。", "The harness turns model responses into searches and clicks. Starting from the same 3B model, two groups made 128 matched shopping attempts each. The control received no learned experience prompts; the candidate received checked memory, skills, and behavior rules. Tasks, randomness, and action limits were held constant.")}</span>
    </div>
    <aside aria-label={t('实验结论','Study decision')}>
      <span>{t("预设接口检查", "PRESET INTERFACE CHECK")}</span>
      <strong>{q.mechanicalStatus === "PASS" ? t("通过", "Passed") : q.mechanicalStatus}</strong>
      <small>{t('预注册的接口健康检查全部过线','All preregistered interface-health checks passed')}</small>
      <span>{t("第一版正式训练", "V1 FORMAL TRAINING")}</span>
      <strong>{t("暂停启用", "Held")}</strong>
      <small>{t("第一版当时暂停正式启用；后来的接口检查结果另行记录。", "The first version was held at the time; later interface-check outcomes are recorded separately.")}</small>
      <span>{t("2.0.1 后续检查 · 历史记录", "2.0.1 FOLLOW-UP · HISTORICAL")}</span>
      <strong>{t("接口检查通过", "Interface checks passed")}</strong>
      <small>{t("接口检查通过；当时仍待训练准备审查，尚未授权正式训练。", "Interface checks passed; training-readiness review and formal authorization were still pending.")}</small>
    </aside>
  </header>

  <section class="h2study__section" aria-labelledby="question-title">
    <p class="kicker">{t("研究问题", "RESEARCH QUESTION")}</p>
    <h2 id="question-title">{t("经验提示与无效动作", "Experience prompts and invalid actions")}</h2>
    <p>{t("早期 3B 实验没有完整成功的购物记录，而且许多尝试因接口无法执行动作而提前结束。一个待检验的解释是：每一步都加入的文字记忆、技能和系统规则，可能让模型使用历史中的动作，而忽略当前页面。改版先分清各类提示的职责、限制上下文并记录动作错误，再用这个对照检查行为。", "The early 3B experiment had no exact-success shopping traces, and many attempts ended because the interface could not execute the action. One hypothesis was that memory, skills, and system rules injected at every step encouraged historical actions over the current page. The revision separated prompt roles, constrained context, and logged action errors before this comparison.")}</p>

    <figure class="h2study__flow" aria-label={t('同一 3B 起点分成 control 与 Harness 2.0 两个配对实验','The same 3B starting point branches into control and Harness 2.0 paired cells')}>
      <svg viewBox="0 0 1000 330" preserveAspectRatio="none" aria-hidden="true">
        <defs><marker id="h2-arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 Z" /></marker></defs>
        <path d="M245 165 C330 165 340 82 430 82" />
        <path d="M245 165 C330 165 340 248 430 248" />
      </svg>
      <article class="h2study__flow-node h2study__flow-source"><span>{t("共同起点", "SHARED START")}</span><strong>{t("同一份初始训练后的 3B 模型", "Same 3B model after initial training")}</strong><small>{t(`训练位置 ${q.window} · temperature ${q.temperature}`,`training positions ${q.window} · temperature ${q.temperature}`)}</small></article>
      <article class="h2study__flow-node h2study__flow-control"><span>{t("对照组", "CONTROL")}</span><strong>{t("不加入经验提示", "No learned experience prompts")}</strong><small>128 / 128</small><p>{t("动作解析规则、购物任务、随机种子、最大步数和采样设置相同。", "Same action parser, tasks, random seeds, action limit, and sampling settings.")}</p></article>
      <article class="h2study__flow-node h2study__flow-candidate"><span>{t("候选组", "CANDIDATE")}</span><strong>Harness 2.0</strong><small>128 / 128</small><p>{t("加入经过格式检查、已区分职责的记忆、技能和行为规则。", "Add memory, skills, and behavior rules after format and role-separation checks.")}</p></article>
      <figcaption>{t(`两组新增正式任务消耗均为 ${q.formalTaskConsumption}，最终测试题访问均为 ${q.finalPanelAccess}。这次复用了训练已经做过的任务位置，没有查看最终测试题。`, `Both groups consumed ${q.formalTaskConsumption} new formal tasks and accessed ${q.finalPanelAccess} final-test tasks. The comparison reused positions already consumed in training and did not inspect the final test.`)}</figcaption>
    </figure>
  </section>

  <section class="h2study__section" aria-labelledby="result-title">
    <p class="kicker">{t("配对结果", "PAIRED RESULT")}</p>
    <h2 id="result-title">{t("接口检查与实际购物结果", "Interface checks and shopping outcomes")}</h2>
    <p>{t("预先规定的接口检查允许一定幅度的退化，候选组没有超过这条容忍线。但实际因无效动作提前结束的尝试从 40/128 增加到 54/128，即 31.25% 上升到 42.19%。通过检查只说明未超过预设容忍线，不能证明行为改善；实验因此暂停正式启用。", "The candidate stayed within the preregistered tolerance for interface regression. Yet attempts ending on invalid actions increased from 40/128 to 54/128, or 31.25% to 42.19%. Passing that check established only that tolerance was not exceeded, not that behavior improved; formal activation was held.")}</p>

    <div class="h2study__bars" role="img" aria-label={t('Control 与 Harness 2.0 非法终止比例比较','Invalid-termination comparison for Control and Harness 2.0')}>
      <div><span>{t("对照组", "Control")}</span><div><i style={`width:${controlInvalidPct}%`}></i></div><b>{controlInvalidPct.toFixed(2)}%</b></div>
      <div><span>Harness 2.0</span><div><i style={`width:${candidateInvalidPct}%`}></i></div><b>{candidateInvalidPct.toFixed(2)}%</b></div>
    </div>

    <div class="h2study__table-wrap">
      <table>
        <thead><tr><th>{t('指标','Metric')}</th><th>{t("对照组", "Control")}</th><th>Harness 2.0</th><th>{t('变化','Delta')}</th></tr></thead>
        <tbody>
          <tr><th>{t("因无效动作提前结束的尝试", "Attempts ending on invalid actions")}</th><td>40 / 128 · 31.25%</td><td>54 / 128 · 42.19%</td><td>+10.94 {t("个百分点", "pp")}</td></tr>
          <tr><th>{t("输出格式错误的动作", "Actions with invalid output format")}</th><td>28 / 1621 · 1.73%</td><td>37 / 1479 · 2.50%</td><td>+{formatDeltaPp.toFixed(2)} {t("个百分点", "pp")}</td></tr>
          <tr><th>{t("命令含义不合法的动作", "Actions with invalid command semantics")}</th><td>10 / 1621 · 0.62%</td><td>4 / 1479 · 0.27%</td><td>{semanticDeltaPp.toFixed(2)} {t("个百分点", "pp")}</td></tr>
          <tr><th>{t("当前页面无法执行的动作", "Actions unavailable on the current page")}</th><td>2 / 1621 · 0.12%</td><td>13 / 1479 · 0.88%</td><td>+{stateDeltaPp.toFixed(2)} {t("个百分点", "pp")}</td></tr>
          <tr><th>{t("获得正分的购物尝试", "Shopping attempts with a positive score")}</th><td>2 / 128</td><td>0 / 128</td><td>−2</td></tr>
          <tr><th>{t('完整成功','Exact success')}</th><td>0 / 128</td><td>0 / 128</td><td>0</td></tr>
          <tr><th>{t("平均任务完成度（0–1）", "Mean task score (0–1)")}</th><td>{q.control.meanScore.toFixed(5)}</td><td>{q.candidate.meanScore.toFixed(5)}</td><td>−{q.control.meanScore.toFixed(5)}</td></tr>
        </tbody>
      </table>
    </div>

    <div class="h2study__paired">
      <article><span>{q.paired.bothInvalid}</span><strong>{t('两边都非法终止','invalid in both')}</strong></article>
      <article><span>{q.paired.controlOnlyInvalid}</span><strong>{t("仅对照组因无效动作终止", "Invalid termination in control only")}</strong></article>
      <article class="warn"><span>{q.paired.candidateOnlyInvalid}</span><strong>{t("仅候选组因无效动作终止", "Invalid termination in candidate only")}</strong></article>
      <article><span>{q.paired.neitherInvalid}</span><strong>{t('两边都没有非法终止','invalid in neither')}</strong></article>
    </div>
    <p class="h2study__boundary">{t("这 128 对尝试中，候选组更常因无效动作终止，足以支持暂停与修复。它不能证明所有任务批次都会更差，也不足以支持永久放弃这个方向。", "Across these 128 matched attempts, the candidate terminated on invalid actions more often, supporting a hold and repair. This does not establish worse behavior in every task window or justify abandoning the direction permanently.")}</p>
  </section>

  <section class="h2study__section" aria-labelledby="mechanism-title">
    <p class="kicker">{t("诊断证据", "DIAGNOSTIC EVIDENCE")}</p>
    <h2 id="mechanism-title">{t('三组诊断信号','Three diagnostic signals appeared together')}</h2>
    <div class="h2study__mechanisms">
      <article>
        <span>01</span><strong>{t("提示语言与动作解析规则", "Prompt language and action-parsing rules")}</strong>
        <p>{t(`对照组的 ${q.mechanisms.chineseFormatInvalid.control} 个格式错误、候选组的 ${q.mechanisms.chineseFormatInvalid.candidate} 个格式错误都包含中文。动作解析程序拒绝中文，而提示没有明确要求用英文输出。候选组错误更多，但对照组也存在同一处规则冲突。`, `All ${q.mechanisms.chineseFormatInvalid.control} control format errors and all ${q.mechanisms.chineseFormatInvalid.candidate} candidate format errors contained Chinese. The action parser rejected Chinese, while the prompt did not explicitly require English. Errors were more frequent in the candidate, but the control shared the same rule mismatch.`)}</p>
      </article>
      <article>
        <span>02</span><strong>{t("被当成按钮名的动作词", "Action terms mistaken for button names")}</strong>
        <p>{t('我们删除了历史按钮字面量，但保留了 pagination、return-to-search 这类动作名；轨迹里随后出现 click[pagination] 等伪动作。这与“抽象动作词可能被模型重新当成可点击目标”的解释一致，但这里没有单独做词汇消融，所以不能把它写成已经证实的因果原因。','Historical button literals were removed, but action-like nouns such as pagination and return-to-search remained; the traces then included pseudo-actions such as click[pagination]. That is consistent with the hypothesis that action-like abstractions can be reinterpreted as clickable targets, but vocabulary was not isolated in its own ablation, so this is not a proven causal explanation.')}</p>
        <code>{q.mechanisms.pseudoActions.slice(0,2).join(' · ')}</code>
      </article>
      <article>
        <span>03</span><strong>{t("未按计划减少的经验提示", "Experience prompts were not reduced as planned")}</strong>
        <p>{t(`第一次动作前，对照组平均收到 ${q.control.step0MeanInputTokens.toFixed(2)} 个文本单元（token），候选组收到 ${q.candidate.step0MeanInputTokens.toFixed(2)} 个，多出 ${q.mechanisms.step0TokenDelta} 个。候选组的 1,479 步仍然每步同时加入记忆、技能和系统规则，未实现只选择少量相关经验的设计。输入变长证明该设计未落实，不能单独证明无效动作因此增加。`, `Before the first action, the control received ${q.control.step0MeanInputTokens.toFixed(2)} tokens on average and the candidate ${q.candidate.step0MeanInputTokens.toFixed(2)}, a difference of ${q.mechanisms.step0TokenDelta}. All 1,479 candidate steps still received memory, skills, and system rules together. This shows that selective, smaller context was not implemented; it does not isolate the cause of additional invalid actions.`)}</p>
      </article>
    </div>
  </section>

  <section class="h2study__section" aria-labelledby="decision-title">
    <p class="kicker">{t("实验决定", "DECISION")}</p>
    <h2 id="decision-title">{t("历史启用决定", "Historical activation decision")}</h2>
    <div class="h2study__decision">
      <article class="pass"><span>{t("接口检查", "INTERFACE CHECK")}</span><strong>{t("通过", "Passed")}</strong><p>{t("两组各完成 128 次尝试，没有工程原因导致的无效记录；提示检查、角色分离、预算、回读核对和预设接口容忍线均通过。", "Both groups completed 128 attempts with no engineering-invalid records; prompt checks, role separation, budget, readback, and preset interface tolerances passed.")}</p></article>
      <article class="hold"><span>{t("正式训练", "FORMAL TRAINING")}</span><strong>{t("暂停启用", "Held")}</strong><p>{t("候选组独有的无效动作终止更多，没有表现改善的证据。因此当时暂停正式训练，检查通过没有转化为执行授权。", "Invalid terminations unique to the candidate were more common, with no evidence of behavioral improvement. Formal training was held; passing the checks did not grant execution authority.")}</p></article>
    </div>
    <p>{t("对照组本身也有 31.25% 的尝试因无效动作结束，完整成功为 0/128。因此经验提示不能单独解释全部失败。共享提示、动作解析规则、模型原有行为及其相互影响仍需分别检查，这个对照没有单独检验模型规模的作用。", "The control itself had 31.25% invalid terminations and 0/128 exact successes, so experience prompts alone cannot explain every failure. Shared prompts, parsing rules, the base policy, and their interactions remain candidates; this control did not isolate model size.")}</p>
  </section>

  <section class="h2study__section" aria-labelledby="next-title">
    <p class="kicker">HARNESS 2.0.1 · FOLLOW-UP</p>
    <h2 id="next-title">{t("后续接口修订的历史计划", "Historical plan for the next interface revision")}</h2>
    <p>{t("第一版对照结果保持原样。后来的 2.0.1 修订通过了接口检查，但当时仍在等待后续学习的准备审查，没有正式训练授权。再往后的 Harness201.1 与重新采集初始经验属于新实验记录，不能倒写成第一版已经完成的工作。", "The first comparison remains unchanged. The later 2.0.1 revision passed interface checks but was still awaiting a training-readiness audit, without formal training authority. Harness201.1 and fresh initial experience belong to later experiment records and must not be backfilled into the first comparison.")}</p>
    <ol class="h2study__next">
      <li><span>01</span><div><strong>{t("共同提示明确要求英文输出", "Require English output in the shared prompt")}</strong><p>{t("对照组和候选组一起修改；动作解析规则保持不变。", "Change both groups while preserving the action-parsing rules.")}</p></div></li>
      <li><span>02</span><div><strong>{t("按需减少经验提示", "Select and reduce experience prompts")}</strong><p>{t("保留少量全局行为规则；每一步只加入相关经验，避免总是同时加入记忆、技能和系统规则。", "Keep a small set of global behavior rules and select relevant experience instead of injecting memory, skills, and system rules at every step.")}</p></div></li>
      <li><span>03</span><div><strong>{t("去除容易误认的按钮词", "Remove terms easily mistaken for buttons")}</strong><p>{t('不仅禁具体按钮，也不直接暴露 pagination / return-to-search 这类容易被 3B 当作按钮名的词。','Ban not only literal buttons but also pseudo-action nouns such as pagination and return-to-search that 3B may reinterpret as button names.')}</p></div></li>
      <li><span>04</span><div><strong>{t("使用另一批训练任务作检查", "Use a different training window for the check")}</strong><p>{t(`位置 ${q.window} 的结果已经被查看，不能继续用于选择 2.0.1。后续检查需提前固定另一批不重叠、且正式训练已经做过的任务位置。`, `Results from positions ${q.window} had already been inspected and could not select 2.0.1. The next check needed a prespecified, non-overlapping window already consumed by formal training.`)}</p></div></li>
    </ol>
  </section>

  <details class="h2study__evidence">
    <summary>{t('证据与复现边界','Evidence and reproduction boundary')}</summary>
    <div class="h2study__evidence-grid">
      <div><span>{t("原始检查记录", "Original check receipt")}</span><a href={q.evidence.receipt} target="_blank" rel="noreferrer"><ExternalBrandMark href={q.evidence.receipt} />qualification-receipt.json ↗</a></div>
      <div><span>{t("实验结论记录", "Study closeout")}</span><a href={q.evidence.closeout} target="_blank" rel="noreferrer"><ExternalBrandMark href={q.evidence.closeout} />Harness 2.0 preformal closeout ↗</a></div>
      <div><span>{t('实验代码快照','Experiment code snapshot')}</span><a href={q.evidence.commit} target="_blank" rel="noreferrer"><ExternalBrandMark href={q.evidence.commit} />openevo-experiment@{q.evidenceCommit.slice(0,8)} ↗</a></div>
      <div><span>Receipt SHA256</span><code>{q.receiptSha256}</code></div>
      <div><span>{t('分析代码 SHA','Analysis code SHA')}</span><code>{q.analysisGitSha}</code></div>
      <div><span>{t('选择边界','Selection boundary')}</span><strong>{t('reward / success 不参与机械 PASS/FAIL；final panel 未访问','reward / success did not select mechanical PASS/FAIL; final panel stayed locked')}</strong></div>
    </div>
  </details>
</main>

<style>
.h2study{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}
.h2study__back{padding:1rem 0 .25rem}.h2study__back a{color:var(--color-accent);font-size:1rem;font-weight:760;text-decoration:none}.h2study__back a:hover{text-decoration:underline}
.h2study__hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);gap:1.5rem;align-items:end;padding:1.4rem 0 2rem;border-bottom:1px solid var(--color-border)}.h2study__hero>div>p,.kicker{margin:0 0 .55rem;color:var(--color-accent);font:800 1rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.h2study__hero h1{margin:0;font-size:clamp(1.9rem,3.5vw,2.8rem);line-height:1.3;letter-spacing:-.025em}.h2study__hero>div>strong{display:block;margin-top:.9rem;font-size:clamp(1rem,2vw,1.28rem)}.h2study__hero>div>span{display:block;margin-top:.55rem;max-width:76ch;color:var(--color-text-muted);line-height:1.72}.h2study__hero aside{display:grid;grid-template-columns:auto 1fr;gap:.35rem .7rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-panel);background:color-mix(in srgb,var(--color-accent) 4%,var(--color-bg))}.h2study__hero aside span{color:var(--color-text-muted);font:800 1rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.h2study__hero aside strong{font-size:1rem}.h2study__hero aside small{grid-column:2;color:var(--color-text-muted);font-size:1rem;line-height:1.45}
.h2study__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.h2study__section h2{margin:0;font-size:clamp(1.4rem,3vw,2.35rem);letter-spacing:-.04em}.h2study__section>p{max-width:84ch;color:var(--color-text-muted);line-height:1.7}.h2study__boundary{font-size:1rem}
.h2study__flow{position:relative;display:grid;grid-template-columns:minmax(210px,.8fr) minmax(0,1.2fr);grid-template-rows:1fr 1fr;gap:.8rem 3rem;min-height:330px;margin:1.2rem 0 0;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-feature);background:color-mix(in srgb,var(--color-text) 1.4%,transparent)}.h2study__flow svg{position:absolute;inset:0;width:100%;height:100%;z-index:0}.h2study__flow svg path{fill:none;stroke:color-mix(in srgb,var(--color-accent) 58%,var(--color-border));stroke-width:2.4;marker-end:url(#h2-arrow)}.h2study__flow svg marker path{fill:var(--color-accent);stroke:none}.h2study__flow-node{position:relative;z-index:1;align-self:center;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-bg)}.h2study__flow-node span,.h2study__flow-node strong,.h2study__flow-node small{display:block}.h2study__flow-node span{color:var(--color-accent);font:800 1rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em}.h2study__flow-node strong{margin:.3rem 0;font-size:1rem}.h2study__flow-node small{color:var(--color-text-muted);font-size:1rem}.h2study__flow-node p{margin:.5rem 0 0;color:var(--color-text-muted);font-size:1rem;line-height:1.5}.h2study__flow-source{grid-row:1/3}.h2study__flow-candidate{border-width:2px;border-color:var(--color-accent)}.h2study__flow figcaption{grid-column:1/-1;position:relative;z-index:1;color:var(--color-text-muted);font-size:1rem;line-height:1.5}
