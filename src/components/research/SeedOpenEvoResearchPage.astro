---
import type { Locale } from '../../i18n';
import SeedOpenEvoResearchHub from './SeedOpenEvoResearchHub.astro';
import SeedOpenEvoResearchDetail from './SeedOpenEvoResearchDetail.astro';

export type MissionPage = 'hub' | 'base-model' | 'seed' | 'openevo' | 'benchmarks' | 'loops' | 'results';

interface Props {
  locale: Locale;
  page: MissionPage;
}

const { locale, page } = Astro.props;
type DetailPage = Exclude<MissionPage, 'hub'>;
const detailPage = page as DetailPage;
---
{page === 'hub'
  ? <SeedOpenEvoResearchHub locale={locale} />
  : <SeedOpenEvoResearchDetail locale={locale} page={detailPage}><slot /></SeedOpenEvoResearchDetail>}
