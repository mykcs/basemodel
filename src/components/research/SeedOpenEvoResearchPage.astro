---
import { localePath, type Locale } from '../../i18n';
import SeedOpenEvoMissionHero from './SeedOpenEvoMissionHero.astro';

export type MissionPage = 'hub' | 'base-model' | 'seed' | 'openevo' | 'benchmarks' | 'loops' | 'results';

interface Props {
  locale: Locale;
  page: MissionPage;
}

const { locale, page } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const pages = [
  { id: 'hub', label: t('研究总览', 'Research map'), href: p('/research/seed-openevo/') },
  { id: 'base-model', label: 'Base Model', href: p('/research/seed-openevo/base-model/') },
  { id: 'seed', label: 'SEED', href: p('/research/seed-openevo/seed/') },
  { id: 'openevo', label: 'OpenEvo', href: p('/research/seed-openevo/openevo/') },
  { id: 'benchmarks', label: t('数据集 / 基准', 'Benchmarks'), href: p('/research/seed-openevo/benchmarks/') },
  { id: 'loops', label: t('循环对比', 'Loop comparison'), href: p('/research/seed-openevo/loops/') },
  { id: 'results', label: t('结果与证据', 'Results & evidence'), href: p('/research/seed-openevo/results/') },
] as const;

const titles: Record<MissionPage, { eyebrow: string; title: string; lede: string }> = {
  hub: {
    eyebrow: t('研究任务总览', 'Research mission overview'),
    title: t('从 Base Model 到框架改进：一条完整研究链', 'From Base Model to framework improvement: one complete research chain'),
    lede: t('先理解模型、SEED、OpenEvo 和两个基准，再完成复现、受控对比与证据沉淀。每个页面只负责回答一个明确问题。', 'Understand the model, SEED, OpenEvo, and both benchmarks first; then reproduce, compare under control, and preserve evidence. Each page answers one explicit question.'),
  },
  'base-model': {
    eyebrow: t('问题 01 · 模型是什么', 'Question 01 · What is the model?'),
    title: t('先解码 checkpoint，再谈它能不能进入实验', 'Decode the checkpoint before asking whether it belongs in the experiment'),
    lede: t('Qwen2.5-3B-Instruct 不是一个品牌词，而是一组会影响复现、显存、推理和训练的实验条件。', 'Qwen2.5-3B-Instruct is not a brand label; it is a set of experimental conditions affecting reproducibility, memory, inference, and training.'),
  },
  seed: {
    eyebrow: t('问题 02 + 05 · SEED 如何工作', 'Questions 02 + 05 · How SEED works'),
    title: t('SEED 把完整轨迹里的 hindsight 变成参数内的学习信号', 'SEED turns hindsight from completed trajectories into a learning signal inside the policy'),
    lede: t('它不只在推理时给模型多一段提示，而是让当前策略同时行动、分析轨迹，并把 skill 产生的概率变化联合蒸馏进策略。', 'It does not merely add a prompt at inference time. The current policy acts, analyzes trajectories, and distills the skill-induced probability shift back into the policy.'),
  },
  openevo: {
    eyebrow: t('问题 03 + 06 · OpenEvo 如何工作', 'Questions 03 + 06 · How OpenEvo works'),
    title: t('OpenEvo 把完成任务后的证据转成下一次任务可用的演化载体', 'OpenEvo turns completed-task evidence into evolution carriers for a later task'),
    lede: t('它以任务/session 为边界，封存数据，运行选定的演化方法，发布 artifact，并让接受的 successor revision 在后续任务生效。', 'It uses the task/session as a boundary, seals data, runs selected evolution methods, publishes artifacts, and activates the accepted successor revision for a later task.'),
  },
  benchmarks: {
    eyebrow: t('问题 04 · 什么算好', 'Question 04 · What counts as good'),
    title: t('ALFWorld 和 WebShop 测的是两种不同的长程 Agent 能力', 'ALFWorld and WebShop measure different long-horizon agent capabilities'),
    lede: t('成功率、宏平均、归一化任务分数和精确成功率不能混成一个总分；循环、无效动作和 fallback 也应作为独立证据。', 'Success rate, macro average, normalized task score, and exact success must not collapse into one number; loops, invalid actions, and fallback behavior are separate evidence.'),
  },
  loops: {
    eyebrow: t('问题 05 + 06 · 两个循环差在哪里', 'Questions 05 + 06 · How the loops differ'),
    title: t('SEED 与 OpenEvo 都“自进化”，但它们更新的对象不同', 'SEED and OpenEvo are both “self-evolving,” but they update different objects'),
    lede: t('公平比较的第一步不是看最终数字，而是画清楚每一步的输入、输出、更新对象和下一轮何时生效。', 'The first step in a fair comparison is not the final score. It is making every input, output, update object, and activation boundary explicit.'),
  },
  results: {
    eyebrow: t('问题 07 · 证据如何变成改进', 'Question 07 · How evidence becomes improvement'),
    title: t('结果页不是成功公告，而是一条可复核证据链', 'The results page is not a success banner; it is an auditable evidence chain'),
    lede: t('这里区分历史 notebook、当前 RTX6 artifact、真实动作、真实演化、可比 benchmark 结果和已验证的框架改进。', 'This page separates historical notebooks, current RTX6 artifacts, real actions, real evolution, comparable benchmark results, and validated framework improvements.'),
  },
};

const current = titles[page];
---
<div class="mission-page">
  {page === 'hub' ? <SeedOpenEvoMissionHero locale={locale} compact /> : (
    <header class="mission-page__header">
      <div class="mission-page__eyebrow">{current.eyebrow}</div>
      <h1>{current.title}</h1>
      <p>{current.lede}</p>
    </header>
  )}

  <nav class="mission-tabs" aria-label={t('SEED × OpenEvo 研究地图', 'SEED × OpenEvo research map')}>
    {pages.map((item) => (
      <a href={item.href} aria-current={item.id === page ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  {page === 'hub' && (
    <>
      <section class="mission-section" id="questions">
        <div class="mission-section__heading">
          <span>01</span>
          <div><small>{t('先把问题排好顺序', 'Put the questions in order')}</small><h2>{t('七个问题，组成一条研究路线', 'Seven questions form one research route')}</h2></div>
        </div>
        <ol class="question-map">
          <li><a href={p('/research/seed-openevo/base-model/')}><b>1</b><strong>{t('Base Model 是什么？', 'What is the Base Model?')}</strong><span>{t('名称、参数、精度、checkpoint 与资源边界', 'Names, parameters, precision, checkpoint, resources')}</span></a></li>
          <li><a href={p('/research/seed-openevo/seed/')}><b>2</b><strong>{t('SEED 原理是什么？', 'How does SEED work?')}</strong><span>{t('hindsight skill、OPD、GRPO 与参数更新', 'hindsight skills, OPD, GRPO, parameter updates')}</span></a></li>
          <li><a href={p('/research/seed-openevo/openevo/')}><b>3</b><strong>{t('OpenEvo 原理是什么？', 'How does OpenEvo work?')}</strong><span>{t('session、dataset、method、artifact 与 successor revision', 'sessions, datasets, methods, artifacts, successor revisions')}</span></a></li>
          <li><a href={p('/research/seed-openevo/benchmarks/')}><b>4</b><strong>{t('两个数据集测什么？', 'What do the benchmarks measure?')}</strong><span>{t('任务、动作空间、分数、成功与失败模式', 'tasks, action spaces, scores, success, failure modes')}</span></a></li>
          <li><a href={p('/research/seed-openevo/seed/')}><b>5</b><strong>{t('SEED 在里面怎么循环？', 'How does SEED loop on them?')}</strong><span>{t('rollout → skill → re-score → joint update', 'rollout → skill → re-score → joint update')}</span></a></li>
          <li><a href={p('/research/seed-openevo/openevo/')}><b>6</b><strong>{t('OpenEvo 在里面怎么循环？', 'How does OpenEvo loop on them?')}</strong><span>{t('episode → sealed evidence → evolution → next revision', 'episode → sealed evidence → evolution → next revision')}</span></a></li>
          <li><a href={p('/research/seed-openevo/results/')}><b>7</b><strong>{t('怎么复现、比较、改进？', 'How do we reproduce, compare, improve?')}</strong><span>{t('受控变量、artifact、结果与设计假设', 'controls, artifacts, results, design hypotheses')}</span></a></li>
        </ol>
      </section>

      <section class="mission-section" id="site-map">
        <div class="mission-section__heading">
          <span>02</span>
          <div><small>{t('网页职责', 'Page responsibilities')}</small><h2>{t('学习、执行和比较共用同一套对象', 'Learn, run, and compare the same underlying objects')}</h2></div>
        </div>
        <div class="mode-columns">
          <article>
            <div class="mode-columns__tag">{t('学习线', 'Learn')}</div>
            <h3>{t('先建立共同语言', 'Build a shared language')}</h3>
            <ol><li>Base Model</li><li>SEED</li><li>OpenEvo</li><li>ALFWorld / WebShop</li><li>{t('循环对比', 'Loop comparison')}</li></ol>
          </article>
          <article>
            <div class="mode-columns__tag">{t('执行线', 'Run')}</div>
            <h3>{t('再产生真实证据', 'Produce real evidence')}</h3>
            <ol><li>{t('环境与硬件', 'Environment & hardware')}</li><li>{t('固定代码和资产', 'Pin code & assets')}</li><li>{t('真实 CUDA action', 'Real CUDA action')}</li><li>{t('真实 evolution', 'Real evolution')}</li><li>{t('结果 artifact', 'Result artifacts')}</li></ol>
            <a href={p('/guide/openevo-webshop-alfworld/')}>{t('打开复现指南 →', 'Open the reproduction guide →')}</a>
          </article>
          <article>
            <div class="mode-columns__tag">{t('研究线', 'Compare')}</div>
            <h3>{t('最后形成框架改进', 'Form a framework improvement')}</h3>
            <ol><li>{t('对齐协议', 'Align protocols')}</li><li>{t('冻结变量', 'Freeze variables')}</li><li>{t('定位失败模式', 'Locate failure modes')}</li><li>{t('提出设计假设', 'Propose a design hypothesis')}</li><li>{t('重新验证', 'Re-validate')}</li></ol>
          </article>
        </div>
      </section>

      <section class="mission-section" id="evidence">
        <div class="mission-section__heading">
          <span>03</span>
          <div><small>{t('证据阶梯', 'Evidence ladder')}</small><h2>{t('越往右，能做的结论越强', 'Claims become stronger as evidence advances')}</h2></div>
        </div>
        <ol class="evidence-track">
          <li><b>{t('环境可用', 'Environment ready')}</b><span>{t('reset / import / index 通过', 'reset / import / index pass')}</span><small>{t('不证明模型真的行动', 'Does not prove a real model action')}</small></li>
          <li><b>{t('真实动作', 'Real action')}</b><span>{t('CUDA 模型产生 non-fallback action', 'CUDA model produces a non-fallback action')}</span><small>{t('不证明发生演化', 'Does not prove evolution')}</small></li>
          <li><b>{t('真实演化', 'Real evolution')}</b><span>{t('完成轨迹被分析，artifact / skill 生效', 'Completed trajectory is analyzed and artifact / skill takes effect')}</span><small>{t('不证明公平对比', 'Does not prove fair comparison')}</small></li>
          <li><b>{t('可比结果', 'Comparable result')}</b><span>{t('模型、任务、预算、评测协议已对齐', 'Model, tasks, budget, and evaluation protocol are aligned')}</span><small>{t('不证明改进具有因果性', 'Does not prove causal improvement')}</small></li>
          <li class="strong"><b>{t('框架改进', 'Framework improvement')}</b><span>{t('设计变化后，在相同条件下重新验证', 'A design change is re-tested under the same conditions')}</span><small>{t('允许形成有限、可复核的结论', 'Supports a bounded, auditable conclusion')}</small></li>
        </ol>
      </section>
    </>
  )}

  {page === 'base-model' && (
    <>
      <section class="mission-section">
        <div class="mission-section__heading"><span>01</span><div><small>{t('解码模型名', 'Decode the name')}</small><h2>Qwen2.5-3B-Instruct</h2></div></div>
        <div class="model-name-diagram" aria-label={t('模型名称组成', 'Model name anatomy')}>
          <div><strong>Qwen</strong><span>{t('家族 / 技术谱系', 'family / technical lineage')}</span></div>
          <div><strong>2.5</strong><span>{t('厂商定义的代际标签', 'vendor-defined generation label')}</span></div>
          <div><strong>3B</strong><span>{t('约 30 亿参数的规模标签', 'roughly three-billion-parameter scale label')}</span></div>
          <div><strong>Instruct</strong><span>{t('经过指令对齐的 checkpoint', 'instruction-aligned checkpoint')}</span></div>
        </div>
        <aside class="mission-callout">{t('模型名不是完整实验规格。还需要具体 revision、精度、量化、上下文、推理引擎、prompt/action 格式和是否更新权重。', 'A model name is not a complete experiment specification. You still need the exact revision, precision, quantization, context, inference engine, prompt/action format, and whether weights are updated.')}</aside>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>02</span><div><small>{t('最小字段字典', 'Minimum field dictionary')}</small><h2>{t('这些词分别控制什么', 'What each field controls')}</h2></div></div>
        <dl class="term-grid">
          <div><dt>Base / Instruct</dt><dd>{t('Base 更接近预训练基座；Instruct 经过指令对齐。二者不是可随意替换的同一个 checkpoint。', 'Base is closer to the pretrained foundation; Instruct is instruction-aligned. They are not interchangeable checkpoints.')}</dd></div>
          <div><dt>Parameters</dt><dd>{t('模型规模标签，影响存储、显存与计算，但不等于任务表现。MoE 还要区分总参数与激活参数。', 'A scale label affecting storage, memory, and compute, but not equivalent to task performance. MoE also separates total and active parameters.')}</dd></div>
          <div><dt>Context</dt><dd>{t('一次推理可处理的 token 窗口；它不等于 Agent 能有效记住整个任务。', 'The token window available to one inference call; it is not the same as effective agent memory.')}</dd></div>
          <div><dt>FP16 / BF16 / INT4</dt><dd>{t('数值精度或量化状态，会改变显存、吞吐和数值行为。', 'Precision or quantization state that changes memory, throughput, and numerical behavior.')}</dd></div>
          <div><dt>SFT / LoRA / RL</dt><dd>{t('不同的更新方式：全量或监督微调、低秩适配、基于奖励的策略更新。', 'Different update modes: supervised/full tuning, low-rank adaptation, and reward-based policy updates.')}</dd></div>
          <div><dt>Checkpoint / revision</dt><dd>{t('真正可复现的模型状态。家族名或 API 产品名不能替代精确 revision。', 'The actual reproducible model state. A family or API product name cannot replace an exact revision.')}</dd></div>
        </dl>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>03</span><div><small>{t('对本实验的影响', 'Impact on this experiment')}</small><h2>{t('哪些变化会破坏可比性', 'Which changes threaten comparability')}</h2></div></div>
        <table class="mission-table"><thead><tr><th>{t('变量', 'Variable')}</th><th>{t('可能影响', 'Possible impact')}</th><th>{t('处理方式', 'Treatment')}</th></tr></thead><tbody>
          <tr><td>{t('模型 checkpoint', 'Model checkpoint')}</td><td>{t('动作质量、反思能力、token 分布', 'action quality, reflection capability, token distribution')}</td><td>{t('严格复现先保留论文 checkpoint；现代化重跑另立实验', 'Keep the paper checkpoint for strict reproduction; treat a modern rerun separately')}</td></tr>
          <tr><td>{t('精度 / 量化', 'Precision / quantization')}</td><td>{t('显存、吞吐、采样稳定性', 'memory, throughput, sampling stability')}</td><td>{t('记录并在对比中固定', 'Record and hold fixed in comparisons')}</td></tr>
          <tr><td>{t('推理后端', 'Inference backend')}</td><td>{t('采样、批处理、上下文与性能', 'sampling, batching, context, performance')}</td><td>{t('先用 Transformers 验证科学链，再单独验证 vLLM 服务链', 'Validate the scientific chain with Transformers first; validate the vLLM service chain separately')}</td></tr>
          <tr><td>{t('prompt / action parser', 'Prompt / action parser')}</td><td>{t('环境可接受动作和 fallback 比例', 'valid environment actions and fallback rate')}</td><td>{t('作为协议的一部分冻结', 'Freeze as part of the protocol')}</td></tr>
        </tbody></table>
        <div class="section-actions"><a class="button button-primary" href={p('/models/qwen2-5-3b-instruct/')}>{t('查看实际 checkpoint 记录 →', 'Inspect the actual checkpoint record →')}</a><a class="button button-secondary" href={p('/models/')}>{t('打开模型目录', 'Open model explorer')}</a></div>
      </section>
    </>
  )}

  {page === 'seed' && (
    <>
      <section class="mission-section">
        <div class="mission-section__heading"><span>01</span><div><small>{t('为什么需要 SEED', 'Why SEED exists')}</small><h2>{t('终局奖励太稀疏，无法告诉策略中间哪一步做对了', 'A terminal reward is too sparse to explain which intermediate decisions were right')}</h2></div></div>
        <div class="problem-bridge"><div><b>{t('完整轨迹', 'Completed trajectory')}</b><span>{t('包含成功步骤、无效绕路、关键观察和失败原因', 'contains useful steps, detours, decisive observations, and failure causes')}</span></div><i>→</i><div><b>{t('hindsight skill', 'hindsight skill')}</b><span>{t('把轨迹级经验表达成可复用的自然语言指导', 'expresses trajectory-level experience as reusable natural-language guidance')}</span></div><i>→</i><div><b>{t('token 级 OPD 信号', 'token-level OPD signal')}</b><span>{t('把 skill 导致的动作概率变化蒸馏回策略', 'distills the skill-induced action-probability shift into the policy')}</span></div></div>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>02</span><div><small>{t('两个训练阶段', 'Two training stages')}</small><h2>{t('先学会分析轨迹，再进入自进化 on-policy 循环', 'Learn to analyze trajectories first, then enter the self-evolving on-policy loop')}</h2></div></div>
        <div class="stage-grid">
          <article><span>Stage 1</span><h3>{t('Hindsight-skill SFT', 'Hindsight-skill SFT')}</h3><ol><li>{t('普通策略收集离线轨迹', 'Base policy collects offline trajectories')}</li><li>{t('外部 analyzer 标注 hindsight skill', 'External analyzer annotates hindsight skills')}</li><li>{t('模型学习从完整轨迹生成 skill', 'The model learns to generate skills from completed trajectories')}</li></ol><small>{t('目的：让同一个模型具备 trajectory analyzer 能力。', 'Purpose: equip the same model with trajectory-analysis capability.')}</small></article>
          <article><span>Stage 2</span><h3>{t('Self-evolving OPD + RL', 'Self-evolving OPD + RL')}</h3><ol><li>{t('当前 policy 收集 on-policy 轨迹', 'Current policy collects on-policy trajectories')}</li><li>{t('同一 checkpoint 分析轨迹并生成 skill', 'The same checkpoint analyzes trajectories and generates skills')}</li><li>{t('固定原动作，在普通/skill context 下重新打分', 'Keep sampled actions fixed and re-score them under ordinary/skill contexts')}</li><li>{t('联合优化 RL 与 OPD loss', 'Jointly optimize RL and OPD losses')}</li></ol><small>{t('更新后，actor 与 analyzer 一起刷新。', 'After the update, actor and analyzer refresh together.')}</small></article>
        </div>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>03</span><div><small>{t('双时间尺度', 'Two time scales')}</small><h2>{t('一次 episode 的 Agent 循环，外面还有一次训练更新循环', 'The agent loop inside one episode sits inside a training-update loop')}</h2></div></div>
        <figure class="loop-figure"><div class="loop-figure__inner"><b>{t('Episode / rollout', 'Episode / rollout')}</b><ol><li>{t('观察', 'Observation')}</li><li>{t('策略生成动作', 'Policy produces action')}</li><li>{t('环境返回新观察', 'Environment returns next observation')}</li><li>{t('重复直到终止', 'Repeat until termination')}</li></ol></div><div class="loop-figure__outer"><b>{t('Policy update', 'Policy update')}</b><ol><li>{t('收集一组轨迹', 'Collect a group of trajectories')}</li><li>{t('生成 hindsight skills', 'Generate hindsight skills')}</li><li>{t('计算 reward / advantage / OPD', 'Compute reward / advantage / OPD')}</li><li>{t('更新 checkpoint', 'Update checkpoint')}</li><li>{t('下一轮 actor + analyzer 一起刷新', 'Refresh actor + analyzer for the next round')}</li></ol></div></figure>
        <aside class="mission-callout">{t('推理时不需要携带 analyzer 或 skill prompt；SEED 的目标是把行为影响内化进 policy 参数。', 'Inference does not require the analyzer or skill prompt; SEED aims to internalize the behavioral effect into policy parameters.')}</aside>
        <div class="section-actions"><a class="button button-primary" href={p('/papers/seed/')}>{t('打开 SEED 论文页 →', 'Open the SEED paper page →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/loops/')}>{t('与 OpenEvo 对比', 'Compare with OpenEvo')}</a></div>
      </section>
    </>
  )}

  {page === 'openevo' && (
    <>
      <section class="mission-section">
        <div class="mission-section__heading"><span>01</span><div><small>{t('核心边界', 'Core boundary')}</small><h2>{t('OpenEvo 的演化发生在完成任务之后，并在后续任务生效', 'OpenEvo evolves after task completion and activates the result for a later task')}</h2></div></div>
        <ol class="session-flow"><li><b>{t('固定当前 Project Head', 'Pin the current Project Head')}</b><span>{t('任务开始时固定 context / model / adapter revision', 'Pin the context / model / adapter revision at task admission')}</span></li><li><b>{t('运行真实任务', 'Run the real task')}</b><span>{t('harness 与环境产生 transcript、timeline、trajectory 和输出', 'The harness and environment produce transcript, timeline, trajectory, and outputs')}</span></li><li><b>{t('封存完成任务数据', 'Seal the completed-task data')}</b><span>{t('演化不读取未完成的中间状态', 'Evolution does not consume partial in-session state')}</span></li><li><b>{t('运行选定演化方法', 'Run selected evolution methods')}</b><span>{t('方法读取有序输入并产生声明的 artifact 类型', 'Methods consume ordered inputs and produce declared artifact types')}</span></li><li><b>{t('验证并发布 artifact', 'Validate and publish artifacts')}</b><span>{t('artifact 进入版本化存储与证据链', 'Artifacts enter versioned storage and the evidence chain')}</span></li><li><b>{t('形成 successor revision', 'Form a successor revision')}</b><span>{t('接受的演化载体在下一任务统一激活', 'Accepted carriers activate together for the next task')}</span></li></ol>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>02</span><div><small>{t('可演化载体', 'Evolution carriers')}</small><h2>{t('OpenEvo 不只等于一段 memory', 'OpenEvo is more than one memory string')}</h2></div></div>
        <div class="carrier-grid">
          <article><span>text_memory</span><h3>{t('文本记忆', 'Text memory')}</h3><p>{t('把完成任务后的经验压缩成后续任务可读的文本上下文。', 'Compress completed-task experience into textual context for later tasks.')}</p></article>
          <article><span>skill_bundle</span><h3>{t('技能包', 'Skill bundle')}</h3><p>{t('保存可复用代码、文件、规则或工具化技能。', 'Preserve reusable code, files, rules, or tool-oriented skills.')}</p></article>
          <article><span>agent_system</span><h3>{t('Agent 系统指令', 'Agent-system instructions')}</h3><p>{t('演化系统级行为指导，并通过版本化 materializer 注入后续任务。', 'Evolve system-level behavior guidance and inject it into later tasks through a versioned materializer.')}</p></article>
          <article><span>parametric_memory</span><h3>{t('参数化记忆（内部）', 'Parametric memory (internal)')}</h3><p>{t('面向 adapter / 参数载体的内部契约；不能仅因服务器有 trainer 就宣称可用。', 'An internal contract for adapter/parameter carriers; trainer availability alone does not make it runnable.')}</p></article>
        </div>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>03</span><div><small>{t('基准接入边界', 'Benchmark adapter boundary')}</small><h2>{t('WebShop / ALFWorld 需要把环境契约翻译成 OpenEvo 可消费的任务证据', 'WebShop / ALFWorld must translate environment contracts into task evidence OpenEvo can consume')}</h2></div></div>
        <table class="mission-table"><thead><tr><th>{t('层', 'Layer')}</th><th>{t('必须提供', 'Must provide')}</th><th>{t('不能伪造', 'Must not fake')}</th></tr></thead><tbody>
          <tr><td>{t('环境', 'Environment')}</td><td>reset / observation / valid action / termination</td><td>{t('用 stub 完成冒充真实环境', 'A stub completion presented as a real environment')}</td></tr>
          <tr><td>{t('轨迹', 'Trajectory')}</td><td>{t('动作、观察、分数、结束原因、模型证据', 'actions, observations, score, termination reason, model evidence')}</td><td>{t('fallback action 冒充模型动作', 'A fallback action presented as a model action')}</td></tr>
          <tr><td>{t('评测', 'Evaluation')}</td><td>{t('连续分数、精确成功、步骤与失败类型', 'continuous score, exact success, steps, failure types')}</td><td>{t('只用进程退出码判断成功', 'Using process exit code as task success')}</td></tr>
          <tr><td>{t('演化', 'Evolution')}</td><td>{t('输入 artifact、方法身份、输出 artifact、激活 revision', 'input artifacts, method identity, output artifacts, activated revision')}</td><td>{t('同一任务中途偷偷切换上下文', 'Silently switching context midway through the same task')}</td></tr>
        </tbody></table>
        <aside class="mission-callout">{t('Desktop / Daemon 产品和 standalone benchmark automation 共用 Core 概念，但不是同一个用户执行面。研究页面必须明确这条边界。', 'The Desktop/Daemon product and standalone benchmark automation share Core concepts, but they are not the same user execution surface. The research page must keep that boundary explicit.')}</aside>
        <div class="section-actions"><a class="button button-primary" href={p('/guide/openevo-webshop-alfworld/')}>{t('进入 OpenEvo 复现指南 →', 'Open the OpenEvo reproduction guide →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/loops/')}>{t('与 SEED 循环对比', 'Compare with the SEED loop')}</a></div>
      </section>
    </>
  )}

  {page === 'benchmarks' && (
    <>
      <section class="mission-section">
        <div class="mission-section__heading"><span>01</span><div><small>{t('先区分两种 benchmark 的交互契约', 'Separate the interaction contracts first')}</small><h2>{t('ALFWorld 与 WebShop 使用不同的交互结构、动作空间和评测信号', 'ALFWorld and WebShop use different interaction structures, action spaces, and evaluation signals')}</h2></div></div>
        <div class="benchmark-grid">
          <article><div class="benchmark-grid__name"><span>A</span><h3>ALFWorld</h3></div><p>{t('文本化具身任务。Agent 根据观察执行高层动作，在房间、物体和任务约束中完成多步计划。', 'Text-based embodied tasks. The agent executes high-level actions from observations and completes multi-step plans over rooms, objects, and task constraints.')}</p><dl><div><dt>{t('主要证据', 'Primary evidence')}</dt><dd>{t('每个任务家族的 success rate + 不加权 macro-average', 'success rate per task family + unweighted macro-average')}</dd></div><div><dt>{t('常见失败', 'Common failures')}</dt><dd>{t('搜索循环、状态遗漏、前置条件错误、无效动作、超步数', 'search loops, missed state, prerequisite errors, invalid actions, step-budget exhaustion')}</dd></div></dl></article>
          <article><div class="benchmark-grid__name"><span>W</span><h3>WebShop</h3></div><p>{t('网页购物导航任务。Agent 需要搜索商品、理解属性约束、打开页面并选择符合要求的商品和选项。', 'A web-shopping navigation task. The agent searches products, interprets attribute constraints, opens pages, and selects matching products and options.')}</p><dl><div><dt>{t('主要证据', 'Primary evidence')}</dt><dd>{t('mean normalized task-completion score + exact success rate', 'mean normalized task-completion score + exact success rate')}</dd></div><div><dt>{t('常见失败', 'Common failures')}</dt><dd>{t('搜索词错误、属性匹配不全、页面导航循环、错误选项、fallback action', 'bad queries, incomplete attribute matching, navigation loops, wrong options, fallback actions')}</dd></div></dl></article>
        </div>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>02</span><div><small>{t('什么算好', 'What counts as good')}</small><h2>{t('指标高只是结果，过程证据告诉我们为什么', 'A high metric is the outcome; process evidence explains why')}</h2></div></div>
        <table class="mission-table"><thead><tr><th>{t('证据', 'Evidence')}</th><th>ALFWorld</th><th>WebShop</th><th>{t('研究用途', 'Research use')}</th></tr></thead><tbody>
          <tr><td>{t('最终成功', 'Final success')}</td><td>{t('任务是否完成', 'task completed or not')}</td><td>{t('exact success', 'exact success')}</td><td>{t('核心可比结果', 'core comparable outcome')}</td></tr>
          <tr><td>{t('部分完成', 'Partial completion')}</td><td>{t('通常不提供连续部分分', 'usually not a continuous partial score')}</td><td>{t('normalized task-completion score', 'normalized task-completion score')}</td><td>{t('区分完全失败与接近正确', 'separates complete failure from near success')}</td></tr>
          <tr><td>{t('宏平均', 'Macro average')}</td><td>{t('任务家族不加权平均', 'unweighted average across task families')}</td><td>—</td><td>{t('避免大类样本量主导结论', 'prevents large families from dominating the conclusion')}</td></tr>
          <tr><td>{t('轨迹行为', 'Trajectory behavior')}</td><td>{t('步骤、循环、无效动作', 'steps, loops, invalid actions')}</td><td>{t('query、点击、属性选择、fallback', 'queries, clicks, attribute choices, fallback')}</td><td>{t('定位框架应该改什么', 'locates what the framework should improve')}</td></tr>
        </tbody></table>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>03</span><div><small>{t('公平比较', 'Fair comparison')}</small><h2>{t('先冻结协议，再比较框架', 'Freeze the protocol before comparing frameworks')}</h2></div></div>
        <ul class="control-list"><li>{t('同一模型 checkpoint / revision', 'Same model checkpoint / revision')}</li><li>{t('同一任务集与 split', 'Same task set and split')}</li><li>{t('同一 prompt、action grammar 与 parser', 'Same prompt, action grammar, and parser')}</li><li>{t('同一步数、rollout 数和 sampling 参数', 'Same step, rollout, and sampling budgets')}</li><li>{t('同一 evaluator 与 score 定义', 'Same evaluator and score definition')}</li><li>{t('同一推理精度和后端，或明确记录替代', 'Same precision and backend, or an explicit substitution record')}</li></ul>
        <aside class="mission-callout">{t('ALFWorld 与 WebShop 的结果不能合成一个“Agent 总分”。它们暴露不同的环境结构和错误模式，应该分别分析。', 'ALFWorld and WebShop must not collapse into one “agent score.” They expose different environment structures and failure modes and should be analyzed separately.')}</aside>
      </section>
    </>
  )}

  {page === 'loops' && (
    <>
      <section class="mission-section">
        <div class="mission-section__heading"><span>01</span><div><small>{t('并排看循环', 'Compare the loops')}</small><h2>{t('共享的是“经验 → 改变 → 下一轮”，不同的是改变对象', 'Both follow “experience → change → next round,” but the changed object differs')}</h2></div></div>
        <div class="loop-compare">
          <article><header><span>SEED</span><h3>{t('参数内化的训练循环', 'Parameter-internalizing training loop')}</h3></header><ol><li>{t('当前 policy 收集 on-policy trajectories', 'Current policy collects on-policy trajectories')}</li><li>{t('同一 checkpoint 生成 hindsight skills', 'The same checkpoint generates hindsight skills')}</li><li>{t('固定原动作，普通/skill context 重打分', 'Keep actions fixed; re-score ordinary/skill contexts')}</li><li>{t('GRPO + OPD 联合更新参数', 'Joint GRPO + OPD parameter update')}</li><li>{t('更新后的 actor/analyzer 进入下一轮', 'Updated actor/analyzer enters the next round')}</li></ol><dl><div><dt>{t('更新对象', 'Updated object')}</dt><dd>{t('policy 参数', 'policy parameters')}</dd></div><div><dt>{t('生效时间', 'Activation')}</dt><dd>{t('下一次 policy update 后', 'after the next policy update')}</dd></div><div><dt>{t('推理额外结构', 'Extra inference structure')}</dt><dd>{t('目标是无需 skill prompt / analyzer', 'aims to require no skill prompt/analyzer')}</dd></div></dl></article>
          <article><header><span>OpenEvo</span><h3>{t('跨 session 的 artifact / revision 循环', 'Cross-session artifact / revision loop')}</h3></header><ol><li>{t('固定 Project Head 运行任务', 'Run a task under a pinned Project Head')}</li><li>{t('完成后封存 dataset / transcript / evidence', 'Seal dataset/transcript/evidence after completion')}</li><li>{t('选定 method 生成 evolution artifacts', 'Selected methods generate evolution artifacts')}</li><li>{t('验证并形成 successor revision', 'Validate and form a successor revision')}</li><li>{t('后续任务加载接受的 revision', 'A later task loads the accepted revision')}</li></ol><dl><div><dt>{t('更新对象', 'Updated object')}</dt><dd>{t('memory / skills / agent system / internal adapter carrier', 'memory / skills / agent system / internal adapter carrier')}</dd></div><div><dt>{t('生效时间', 'Activation')}</dt><dd>{t('完成任务之后的后续任务', 'a later task after completion')}</dd></div><div><dt>{t('推理额外结构', 'Extra inference structure')}</dt><dd>{t('依赖被激活的 context / artifacts', 'uses the activated context/artifacts')}</dd></div></dl></article>
        </div>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>02</span><div><small>{t('按更新对象建立可比边界', 'Define comparability through the updated object')}</small><h2>{t('“self-evolving” 是共同研究主题；SEED 与 OpenEvo 使用不同算法接口', '“Self-evolving” is the shared research theme; SEED and OpenEvo use different algorithmic interfaces')}</h2></div></div>
        <table class="mission-table"><thead><tr><th>{t('维度', 'Dimension')}</th><th>SEED</th><th>OpenEvo</th></tr></thead><tbody>
          <tr><td>{t('经验来源', 'Experience source')}</td><td>{t('当前 policy 的 on-policy trajectories', 'on-policy trajectories from the current policy')}</td><td>{t('完成 task/session 的封存数据与 artifact history', 'sealed completed-task/session data and artifact history')}</td></tr>
          <tr><td>{t('反思输出', 'Reflection output')}</td><td>{t('自然语言 hindsight skill', 'natural-language hindsight skill')}</td><td>{t('由目标/方法定义的版本化 artifact', 'versioned artifacts defined by target/method')}</td></tr>
          <tr><td>{t('学习/演化动作', 'Learning/evolution action')}</td><td>{t('对原动作重打分并优化 policy loss', 're-score sampled actions and optimize policy loss')}</td><td>{t('运行 method、注册 artifact、materialize successor revision', 'run methods, register artifacts, materialize successor revision')}</td></tr>
          <tr><td>{t('主要实验问题', 'Primary research question')}</td><td>{t('dense on-policy hindsight 是否改善 credit assignment', 'whether dense on-policy hindsight improves credit assignment')}</td><td>{t('哪些跨 session 载体与方法能提高后续任务表现', 'which cross-session carriers and methods improve later-task performance')}</td></tr>
        </tbody></table>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>03</span><div><small>{t('受控比较路线', 'Controlled comparison route')}</small><h2>{t('先得到机制证据，再谈最终表现差异', 'Establish mechanism evidence before final performance differences')}</h2></div></div>
        <ol class="comparison-route"><li><b>{t('同一普通 policy baseline', 'Same ordinary-policy baseline')}</b><span>{t('确认没有 skill / memory / evolution augmentation', 'Confirm no skill/memory/evolution augmentation')}</span></li><li><b>{t('分别验证机制真的生效', 'Verify each mechanism actually activates')}</b><span>{t('SEED: OPD / parameter update；OpenEvo: artifact / successor revision', 'SEED: OPD/parameter update; OpenEvo: artifact/successor revision')}</span></li><li><b>{t('对齐 benchmark 协议', 'Align benchmark protocol')}</b><span>{t('任务、模型、预算、parser、evaluator', 'tasks, model, budget, parser, evaluator')}</span></li><li><b>{t('比较结果与失败分布', 'Compare outcomes and failure distributions')}</b><span>{t('最终分数 + loops / invalid / fallback / step count', 'final metrics + loops / invalid / fallback / step count')}</span></li><li><b>{t('提出最小设计变化', 'Propose the smallest design change')}</b><span>{t('只改变一个可解释变量，并在相同协议下重跑', 'Change one interpretable variable and rerun under the same protocol')}</span></li></ol>
        <div class="section-actions"><a class="button button-primary" href={p('/guide/openevo-webshop-alfworld/')}>{t('开始真实复现 →', 'Start the real reproduction →')}</a><a class="button button-secondary" href={p('/research/seed-openevo/results/')}>{t('查看证据结构', 'View the evidence structure')}</a></div>
      </section>
    </>
  )}

  {page === 'results' && (
    <>
      <section class="mission-section">
        <div class="mission-section__heading"><span>01</span><div><small>{t('当前声明边界', 'Current claim boundary')}</small><h2>{t('把“曾经成功”“当前准备好”“现在测得结果”分开', 'Separate “worked historically,” “ready now,” and “measured now”')}</h2></div></div>
        <div class="status-board">
          <article class="status-board__historical"><span>{t('历史证据', 'Historical evidence')}</span><h3>{t('2026-07-29 WebShop + Transformers + CUDA + evolution', '2026-07-29 WebShop + Transformers + CUDA + evolution')}</h3><p>{t('可用作 golden environment 和机制参考；不能自动代表当前 RTX6 已完成。', 'Useful as a golden-environment and mechanism reference; it does not automatically prove current RTX6 completion.')}</p></article>
          <article class="status-board__active"><span>{t('当前工作', 'Current work')}</span><h3>{t('RTX6 上恢复真实 WebShop / OpenEvo 链', 'Restore the real WebShop / OpenEvo chain on RTX6')}</h3><p>{t('每一级必须由当前 result directory、日志和 machine verifier 证明。', 'Every stage must be supported by the current result directory, logs, and machine verifier.')}</p></article>
          <article class="status-board__pending"><span>{t('仍待验证', 'Still pending')}</span><h3>{t('可比的 ALFWorld / WebShop 结果与框架改进', 'Comparable ALFWorld / WebShop results and framework improvement')}</h3><p>{t('没有同条件重跑与 artifact 之前，不发布“OpenEvo 优于/劣于 SEED”的结论。', 'Do not publish “OpenEvo beats/loses to SEED” without same-condition reruns and artifacts.')}</p></article>
        </div>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>02</span><div><small>{t('每次运行要保存什么', 'What every run must preserve')}</small><h2>{t('结果 artifact 清单', 'Result artifact checklist')}</h2></div></div>
        <ul class="artifact-list"><li><code>STATUS</code><span>{t('阶段状态与第一个 blocker', 'stage status and first blocker')}</span></li><li><code>pipeline.log</code><span>{t('按 gate 排序的完整主日志', 'complete gate-ordered pipeline log')}</span></li><li><code>env-prepare.log</code><span>{t('Python / CUDA / overlay / import 证据', 'Python / CUDA / overlay / import evidence')}</span></li><li><code>contract-tests.log</code><span>{t('adapter / evaluator 契约', 'adapter / evaluator contracts')}</span></li><li><code>probe.json</code><span>{t('真实 action、观察、score、termination 与 backend', 'real actions, observations, score, termination, backend')}</span></li><li><code>evolution_summary.json</code><span>{t('反思、注入、gen0/gen1 与 artifact 证据', 'reflection, injection, gen0/gen1, and artifact evidence')}</span></li><li><code>config + commit SHAs</code><span>{t('模型、代码、任务、预算与运行条件', 'model, code, tasks, budgets, and runtime conditions')}</span></li></ul>
      </section>

      <section class="mission-section">
        <div class="mission-section__heading"><span>03</span><div><small>{t('从失败到设计', 'From failure to design')}</small><h2>{t('框架改进假设必须能被下一次实验证伪', 'A framework-improvement hypothesis must be falsifiable by the next experiment')}</h2></div></div>
        <div class="hypothesis-template">
          <div><span>1</span><b>{t('观察', 'Observation')}</b><p>{t('哪个 benchmark、哪种任务、哪类 trajectory 反复失败？', 'Which benchmark, task type, and trajectory pattern repeatedly fails?')}</p></div>
          <div><span>2</span><b>{t('机制判断', 'Mechanism diagnosis')}</b><p>{t('失败来自模型、环境、parser、memory、skill、agent-system 还是激活时机？', 'Does the failure come from the model, environment, parser, memory, skill, agent system, or activation timing?')}</p></div>
          <div><span>3</span><b>{t('最小改动', 'Minimal change')}</b><p>{t('只改变一个 carrier、method、输入绑定或评测规则。', 'Change one carrier, method, input binding, or evaluation rule.')}</p></div>
          <div><span>4</span><b>{t('反事实预测', 'Counterfactual prediction')}</b><p>{t('如果假设正确，哪个可观察指标应怎样变化？', 'If the hypothesis is right, which observable metric should change and how?')}</p></div>
          <div><span>5</span><b>{t('同条件重跑', 'Same-condition rerun')}</b><p>{t('固定其余变量，比较分数、成功率和失败分布。', 'Hold other variables fixed and compare metrics and failure distributions.')}</p></div>
        </div>
        <div class="section-actions"><a class="button button-primary" href={p('/workspace/?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1')}>{t('在工作台建立实验任务 →', 'Build the experiment task in Workspace →')}</a><a class="button button-secondary" href={p('/methodology/')}>{t('查看证据方法', 'Read the evidence methodology')}</a></div>
      </section>
    </>
  )}
</div>

