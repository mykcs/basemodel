---
import type { Locale } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const experimentRoot = 'https://github.com/mykcs/openevo-experiment/blob/115062ea0b47ee769a3e1591ffd3d5c89c4a353a';
const heldoutRoot = 'https://github.com/mykcs/openevo-experiment/blob/429faae1acc1132f8bdad4269a4e15864a9cccb0';
const h136ParserCommit = 'https://github.com/mykcs/openevo-experiment/commit/8e526e42de82e3fb417eb6dc4d892e068d73ef1f';
const seedRoot = 'https://github.com/jinyangwu/SEED/blob/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const rawEpisode = `${experimentRoot}/docs/evidence/seed-official-heldout-comparison-v1/episodes/primary/base/episodes/webshop_seed0_goal00395-2026082586.json`;
const heldoutComparisonConfig = `${heldoutRoot}/configs/experiment/webshop-seed-official-heldout-comparison-v1.json`;
const h138bConfig = `${heldoutRoot}/configs/experiment/h1.38b-method-control-v1.json`;

type Step = { when: string; title: string; body: string; links: EvidenceRef[] };
const steps: Step[] = [
  {
    when: t('官方合同', 'Released contract'),
    title: t('SEED 的动作格式：<action>...</action>', 'SEED action format: <action>...</action>'),
    body: t('SEED 公开的 WebShop Prompt 明确要求动作放进 <action>...</action>。它的解析器（webshop_projection）也只按这对标签抽取里面的动作；找不到时，会退化成输出最后 20 个字符。因此这里不能写成“SEED parser 有 bug”：官方代码是在执行它自己公开的接口合同。', 'The released SEED WebShop prompt explicitly requires actions inside <action>...</action>. Its parser (webshop_projection) extracts actions only from that tag pair; when the pair is absent, it falls back to the final 20 characters. This is therefore not a SEED-parser bug: the released code is enforcing its published interface contract.'),
    links: [
      { kind: 'official-code', label: t('SEED WebShop Prompt · 精确行', 'SEED WebShop prompt · exact lines'), href: `${seedRoot}/agent_system/environments/prompts/webshop.py#L25-L27` },
      { kind: 'official-code', label: t('SEED webshop_projection · 精确行', 'SEED webshop_projection · exact lines'), href: `${seedRoot}/agent_system/environments/env_package/webshop/projection.py#L32-L40` },
    ],
  },
  {
    when: t('我们的 Prompt', 'Our prompt'),
    title: t('我们的 Prompt 同样要求 <action>，没有要求 [action]', 'Our prompt also requires <action>, not [action]'),
    body: t('保存下来的 BASE 原始回合里，实际送给模型的 Prompt 同样写着 “present it within <action> </action> tags”。所以 [action] 不是 OpenEvo 在 Prompt 里规定给模型的动作格式。', 'The saved BASE episode shows that the actual prompt sent to the model likewise says “present it within <action> </action> tags”. So [action] was not an action format that OpenEvo instructed the model to use in the prompt.'),
    links: [
      { kind: 'raw-episode', label: t('BASE step 0 Prompt', 'BASE step-0 prompt'), href: `${rawEpisode}#L42-L43` },
      { kind: 'code', label: t('OpenEvo WebShop Prompt / action contract', 'OpenEvo WebShop prompt / action contract'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L12-L18` },
    ],
  },
  {
    when: t('模型生成', 'Model generation'),
    title: t('模型本来就会偶发写错动作外层格式', 'The model already occasionally drifts on the outer action format'),
    body: t('模型这边发生的事很简单：我们一步都没训练，BASE 就已经会偶发把 <action> 写成 [action]。同一个原始 episode 记录 adapter_loaded=false，step 0 写出 [action] search[...]，下一步又自己恢复成 <action>...</action>。推理后端在 model.generate 之后只是 decode 新 token 并返回，没有把尖括号改成方括号。所以这种格式漂移是模型原始输出里就存在的行为；训练会不会改变它出现的频率，要另外测。', 'The model-side behavior is simple: before we trained the adapter at all, BASE already occasionally wrote [action] instead of <action>. The same raw episode records adapter_loaded=false; step 0 emits [action] search[...], and the next step returns to <action>...</action>. After model.generate, the inference backend only decodes new tokens and returns them; it does not rewrite angle brackets into square brackets. The format drift therefore already exists in raw model output. Whether training changes how often it happens is a separate question to measure.'),
    links: [
      { kind: 'config', label: t('PRIMARY-v1 冻结比较：7B BASE vs H1.38B final SD-LoRA · 128×2', 'PRIMARY-v1 frozen comparison: 7B BASE vs H1.38B final SD-LoRA · 128×2'), href: heldoutComparisonConfig },
      { kind: 'config', label: t('H1.38B 训练流：16 records · 8 tasks · 8 increments', 'H1.38B training stream: 16 records · 8 tasks · 8 increments'), href: h138bConfig },
      { kind: 'raw-episode', label: t('BASE adapter receipt · adapter_loaded=false', 'BASE adapter receipt · adapter_loaded=false'), href: `${rawEpisode}#L2-L12` },
      { kind: 'raw-episode', label: t('[action] → <action> 原始输出', '[action] → <action> raw completions'), href: `${rawEpisode}#L42-L53` },
      { kind: 'code', label: t('Transformers generate → decode → return', 'Transformers generate → decode → return'), href: `${experimentRoot}/vendor/openevo-webshop/src/openevo_webshop/inference.py#L227-L232` },
    ],
  },
  {
    when: '2026-08-18 · H1.36',
    title: t('H1.36 已经发现并修过这个兼容性问题', 'H1.36 had already found and repaired this compatibility problem'),
    body: t('H1.36 时仓库已经记录：7B BASE 会在 [action]cmd、=search[...]、<click[...]> 等外层写法之间漂移，并把它定性为 harness / measurement mismatch。随后提交 8e526e42 做了 strict-first 修复：先按严格 <action> 合同解析；只有失败时，才从 </think> 之后恢复一个完整的 search[...] / click[...] command。', 'During H1.36 the repository already recorded that the 7B BASE model drifted among wrapper forms such as [action]cmd, =search[...], and <click[...]>, and classified this as a harness / measurement mismatch. Commit 8e526e42 then added a strict-first repair: try the strict <action> contract first, and only on failure recover one complete search[...] / click[...] command after </think>.'),
    links: [
      { kind: 'historical-record', label: t('H1.36 同时期收口报告', 'Contemporaneous H1.36 closeout report'), href: `${experimentRoot}/docs/evidence/remote-runs/2026-08-18/h1.36/REPORT.md` },
      { kind: 'commit', label: t('commit 8e526e42 · parser compatibility', 'commit 8e526e42 · parser compatibility'), href: h136ParserCommit },
      { kind: 'code', label: t('strict-first action-command 修复', 'strict-first action-command repair'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
  {
    when: t('训练数据', 'Training data'),
    title: t('解析失败的轨迹不会进入自进化监督', 'Parser-failed traces were excluded from self-evolution supervision'),
    body: t('H1.36 的自进化数据构建器只接收成功、身份完整、没有 parser/fallback failure 的轨迹；每一步还必须 action_valid=true、used_fallback=false、parser_failure=false。harvest 默认使用 strict-v1 <action> 合同。也就是说，strict parser 读不懂的 malformed wrapper 会在进入训练集之前被排除。这里的作用是补充训练链路的边界，不是替代前一条更强的起源证据：BASE 在训练前已经会写出 [action]。', 'The H1.36 self-evolution dataset builder accepts only successful, identity-complete traces with no parser/fallback failure; every step must also have action_valid=true, used_fallback=false, and parser_failure=false. Harvest defaults to the strict-v1 <action> contract, so malformed wrappers rejected by the strict parser are filtered before entering training. This supports the training-path boundary rather than replacing the stronger evidence above: BASE already emits [action] before adapter training.'),
    links: [
      { kind: 'code', label: t('自进化数据筛选条件 · 精确行', 'Self-evolution dataset filters · exact lines'), href: `${experimentRoot}/scripts/openevo_webshop/build_self_evolution_dataset.py#L67-L90` },
      { kind: 'code', label: t('H1.36 launcher · strict-v1 默认合同', 'H1.36 launcher · strict-v1 default contract'), href: `${experimentRoot}/scripts/openevo_webshop/launch_h136_qwen7b_self_evolution.sh#L53-L69` },
    ],
  },
  {
    when: '2026-08-25 · PRIMARY-v1',
    title: t('已知问题没有在正式评测前被拦住', 'The known problem was not stopped before formal evaluation'),
    body: t('PRIMARY-v1 这次测量失效，责任在我们的实验集成层。H1.36 已经发现过 7B 的 wrapper 漂移，但正式 SEED-strict 评测前，我们没有拿真实模型输出验证 SEED projection 能不能稳定恢复完整 command。于是一个已知兼容性风险被带进正式评测：完整的 search[...] / click[...] 被投影成尾部碎片并送进环境，制造出两边全 0 的测量假象。模型触发了这个边界，但把已知边界带进正式测量，是 harness / integration 的责任。', 'The PRIMARY-v1 measurement failure is our experiment-integration responsibility. H1.36 had already exposed 7B wrapper drift, but before the formal SEED-strict evaluation we did not test real model outputs against the released SEED projection to verify that complete commands could be recovered reliably. A known compatibility risk therefore entered the formal evaluation: complete search[...] / click[...] commands were projected into tail fragments and sent to the environment, producing an apparent all-zero panel. The model triggered the boundary; allowing a known boundary into formal measurement was a harness / integration failure.'),
    links: [
      { kind: 'raw-episode', label: t('当时冻结的 BASE 原始回合', 'Frozen BASE raw episode from the run'), href: `${rawEpisode}#L42-L53` },
      { kind: 'human-report', label: t('PRIMARY-v1 根因与修复记录', 'PRIMARY-v1 root-cause and repair record'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/RESULTS.md` },
    ],
  },
  {
    when: t('PRIMARY-v2 修复', 'PRIMARY-v2 repair'),
    title: t('PRIMARY-v2 只修测量接口，并对两边使用同一规则', 'PRIMARY-v2 repaired only measurement and used the same rule for both arms'),
    body: t('修复后的 PRIMARY-v2 只改变动作 wrapper 的识别方式，并对 BASE 与 SD-LoRA 使用同一合同；任务面板和比较边界保持不变。这个修复解决的是“评测器能不能读懂动作”，不是给 OpenEvo 一边额外能力。', 'Repaired PRIMARY-v2 changed only action-wrapper recognition and applied the same contract to BASE and SD-LoRA; the task panel and comparison boundary stayed the same. The repair addresses whether the evaluator can read the action, not whether one arm gets extra capability.'),
    links: [
      { kind: 'machine-result', label: t('PRIMARY-v2 配对分析', 'PRIMARY-v2 paired analysis'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/analysis-v2.json` },
      { kind: 'machine-result', label: t('PRIMARY-v2 覆盖与身份对账', 'PRIMARY-v2 coverage and identity reconciliation'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/reconciliation-v2.json` },
      { kind: 'code', label: t('parser compatibility 代码', 'Parser compatibility code'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
];
---

<details class="wrapper-attribution" id="action-wrapper-attribution" data-ui-audit="layout overflow contrast">
  <summary>
    <span>
      <small>{t('发生了什么 · 为什么发生 · 如何修复', 'WHAT HAPPENED · WHY · REPAIR')}</small>
      <strong>{t('动作格式错误：<action>...</action> 被写成 [action]...', 'Action-format error: <action>...</action> was written as [action]...')}</strong>
    </span>
    <i aria-hidden="true"></i>
  </summary>

  <div class="wrapper-attribution__body">
    <p class="wrapper-attribution__lead wrapper-attribution__lead--context">{t('我们在用 WebShop 检验 OpenEvo 的参数更新能否让 Qwen2.5-7B-Instruct 从自己成功的任务轨迹里学到可迁移经验。流程是：先收集成功轨迹，把它们训练成一个小的参数 adapter（这里用的是 SD-LoRA）；再把没有加载 adapter 的 BASE 和加载 adapter 的模型放到同一批任务上比较。PRIMARY-v1 是这条流程的一次正式评测，不是一次新的训练。', 'We use WebShop to test whether an OpenEvo parameter update lets Qwen2.5-7B-Instruct learn transferable experience from its own successful trajectories. The pipeline first collects successful trajectories and trains them into a small parameter adapter (SD-LoRA here), then compares BASE with no adapter against the same model with the adapter on the same tasks. PRIMARY-v1 is a formal evaluation in that pipeline, not a new training run.')}</p>

    <p class="wrapper-attribution__incident">
      {t('模型生成的 search[...] / click[...] 命令本身是完整的，', 'The generated search[...] / click[...] command itself was complete, ')}
      <strong>{t('但有些输出把外层 <action>...</action> 写成了 [action]...。', 'but some outputs wrote the outer <action>...</action> wrapper as [action]....')}</strong>
      {t('SEED parser 因此没有读到完整动作，这直接造成了 PRIMARY-v1 的测量失效。', 'The SEED parser therefore failed to recover the complete action, directly invalidating the PRIMARY-v1 measurement.')}
    </p>

    <p class="wrapper-attribution__responsibility"><strong>{t('责任在我们的实验集成层。', 'The responsibility lies with our experiment integration layer.')}</strong>{t('模型会偶发写错动作外层格式，这个风险我们在 H1.36 已经见过，也修过一次；但 PRIMARY-v1 正式评测前，我们没有把真实模型输出接到 SEED parser 上做兼容性预检。模型触发了问题，但把已知问题带进正式评测，是我们的责任。', 'The model occasionally drifts on the outer action format; we had already seen and repaired this once in H1.36. But before PRIMARY-v1 we did not run a compatibility preflight that connected real model outputs to the SEED parser. The model triggered the problem; allowing a known problem into formal evaluation was our responsibility.')}</p>

    <dl class="wrapper-attribution__facts" aria-label={t('判断原因前需要知道的实验规模', 'Experiment scale relevant to the incident')}>
      <div><dt>{t('正式评测', 'Formal evaluation')}</dt><dd><strong>128 × 2 = 256</strong> {t('个 episode；两边都是冻结模型，现场没有重新训练。', 'episodes; both arms were frozen and no retraining happened during evaluation.')}</dd></div>
      <div><dt>{t('这次训练有多大', 'Training scale')}</dt><dd><strong>16</strong> {t('条成功 rollout，覆盖 8 个任务 × 每个任务 2 条独立成功轨迹；8 次连续增量，1 epoch，每个增量最多 16 个 optimizer steps，因此累计 optimizer-step 上限是 ≤128；final effective rank 32。', 'successful rollouts across 8 tasks × 2 independent successes per task; 8 sequential increments, 1 epoch, at most 16 optimizer steps per increment, so the cumulative optimizer-step upper bound is ≤128; final effective rank 32.')}</dd></div>
      <div><dt>{t('训练前就出现了', 'Already present before training')}</dt><dd><strong>{t('我们一步都没训练，BASE 就已经写出了 [action]。', 'Before we trained the adapter at all, BASE was already emitting [action].')}</strong>{t('原始 episode 明确记录 adapter_loaded=false。', 'The raw episode explicitly records adapter_loaded=false.')}</dd></div>
    </dl>

    <div class="wrapper-attribution__timeline">
      {steps.map((step, index) => (
        <article>
          <div class="wrapper-attribution__index"><span>{String(index + 1).padStart(2, '0')}</span><small>{step.when}</small></div>
          <div class="wrapper-attribution__copy">
            <h4>{step.title}</h4><p>{step.body}</p>
            <OpenEvoEvidenceRefs locale={locale} sources={step.links} compact ariaLabel={t(`“${step.title}”的证据`, `Evidence for ${step.title}`)} />
          </div>
        </article>
      ))}
    </div>

    <section class="wrapper-attribution__lessons" aria-labelledby="action-wrapper-lessons-title">
      <h4 id="action-wrapper-lessons-title">{t('这次事故留下的经验', 'What this incident teaches us')}</h4>
      <div class="wrapper-attribution__lesson-grid">
        <article>
          <h5>{t('对模型训练', 'For model training')}</h5>
          <p><strong>{t('不要把“格式错”直接当成“模型不会做任务”，也不要把“多训几步”当成默认修法。', 'Do not equate a format error with task incapability, and do not default to “train a few more steps.”')}</strong>{t('这次 BASE 能生成完整的 search[...] / click[...]，只是外层 wrapper 会漂。以后训练应该把任务分数、command 是否合法、wrapper 是否合规分开记录；如果真的要提高格式稳定性，就单独做 format-conformance 数据或训练对照，直接比较训练前后的格式错误频率，而不是从任务分数反推。', 'Here BASE can generate a complete search[...] / click[...] command while the outer wrapper drifts. Future training should track task score, command validity, and wrapper compliance separately. If we want to improve format stability, use dedicated format-conformance data or a controlled training comparison and measure the before/after error rate directly instead of inferring it from task score.')}</p>
        </article>
        <article>
          <h5>{t('对下一步实验', 'For the next experiment')}</h5>
          <p><strong>{t('正式跑分前，先证明“模型输出 → parser → 环境动作”这条链是通的。', 'Before formal scoring, prove that model output → parser → environment action works end to end.')}</strong>{t('以后正式消耗 held-out 任务之前，要先在非正式 / dev 样本上用真实模型输出做 round-trip preflight：parser 必须能把模型想做的完整 search[...] / click[...] 恢复出来，再送进环境。invalid action 一旦异常升高就应该立刻停，不要等 128 题整轮跑完才发现测量接口坏了。parser 如果改动，要把它当成执行语义变化并重跑相关评测，而不是只“重新算一次分”。', 'Before consuming formal held-out tasks, run a round-trip preflight on non-formal/dev examples using real model outputs: the parser must recover the model’s complete intended search[...] / click[...] command before it reaches the environment. If invalid actions spike, stop immediately rather than discovering a broken measurement interface after all 128 tasks have run. A parser change should be treated as an execution-semantics change that requires the affected evaluation to be rerun, not merely rescored.')}</p>
        </article>
      </div>
    </section>

    <p class="wrapper-attribution__boundary"><strong>{t('证据边界：', 'Evidence boundary: ')}</strong>{t('现有证据能确认三件事：Prompt 没有要求 [action]，推理后端没有改写括号，BASE 在训练前就会出现这种格式漂移。但我们无法继续追到 Qwen2.5-7B-Instruct 的哪一条预训练 / SFT 数据，所以对模型行为的起源归因到这里为止；也不能据此断言训练永远不会改变这种格式漂移的频率。', 'The current evidence establishes three things: the prompt did not request [action], the inference backend did not rewrite brackets, and BASE already shows this format drift before adapter training. We cannot trace the model behavior further to a specific Qwen2.5-7B-Instruct pretraining/SFT example, so attribution of the model behavior stops there. This also does not establish that training can never change how often the drift occurs.')}</p>
  </div>
</details>

<style>
  .wrapper-attribution{max-width:1112px;margin:12px auto 42px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);color:var(--color-text)}
