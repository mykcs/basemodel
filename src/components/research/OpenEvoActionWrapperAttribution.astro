---
import type { Locale } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const experimentRoot = 'https://github.com/mykcs/openevo-experiment/blob/115062ea0b47ee769a3e1591ffd3d5c89c4a353a';
const heldoutRoot = 'https://github.com/mykcs/openevo-experiment/blob/429faae1acc1132f8bdad4269a4e15864a9cccb0';
const h136ParserCommit = 'https://github.com/mykcs/openevo-experiment/commit/8e526e42de82e3fb417eb6dc4d892e068d73ef1f';
const seedRoot = 'https://github.com/jinyangwu/SEED/blob/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const rawEpisode = `${experimentRoot}/docs/evidence/seed-official-heldout-comparison-v1/episodes/primary/base/episodes/webshop_seed0_goal00395-2026082586.json`;
const wrapperAuditRoot = 'https://github.com/mykcs/openevo-experiment/blob/e1229db492504bc9f7b795ca0a5184d5e1cadf1a';

type Step = { when: string; title: string; body: string; links: EvidenceRef[] };
const steps: Step[] = [
  {
    when: t('官方合同', 'Released contract'),
    title: t('先看规则：SEED 要求 <action>...</action>', 'Start with the rule: SEED requires <action>...</action>'),
    body: t('SEED 公开的 WebShop Prompt 明确要求动作放进 <action>...</action>。它的解析器（webshop_projection）也只按这对标签抽取里面的动作；找不到时，会退化成输出最后 20 个字符。因此这里不能写成“SEED parser 有 bug”：官方代码是在执行它自己公开的接口合同。', 'The released SEED WebShop prompt explicitly requires actions inside <action>...</action>. Its parser (webshop_projection) extracts actions only from that tag pair; when the pair is absent, it falls back to the final 20 characters. This is therefore not a SEED-parser bug: the released code is enforcing its published interface contract.'),
    links: [
      { kind: 'official-code', label: t('SEED WebShop Prompt · 精确行', 'SEED WebShop prompt · exact lines'), href: `${seedRoot}/agent_system/environments/prompts/webshop.py#L25-L27` },
      { kind: 'official-code', label: t('SEED webshop_projection · 精确行', 'SEED webshop_projection · exact lines'), href: `${seedRoot}/agent_system/environments/env_package/webshop/projection.py#L32-L40` },
    ],
  },
  {
    when: t('我们的 Prompt', 'Our prompt'),
    title: t('我们的 Prompt 也要求 <action>，没有要求 [action]', 'Our prompt also asks for <action>, not [action]'),
    body: t('保存下来的 BASE 原始回合里，实际送给模型的 Prompt 同样写着 “present it within <action> </action> tags”。所以 [action] 不是 OpenEvo 在 Prompt 里规定给模型的动作格式。', 'The saved BASE episode shows that the actual prompt sent to the model likewise says “present it within <action> </action> tags”. So [action] was not an action format that OpenEvo instructed the model to use in the prompt.'),
    links: [
      { kind: 'raw-episode', label: t('BASE step 0 Prompt', 'BASE step-0 prompt'), href: `${rawEpisode}#L42-L43` },
      { kind: 'code', label: t('OpenEvo WebShop Prompt / action contract', 'OpenEvo WebShop prompt / action contract'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L12-L18` },
    ],
  },
  {
    when: t('模型生成', 'Model generation'),
    title: t('偏差出现在 BASE 原始生成里，不是 adapter 或 backend 改写', 'The drift appears in raw BASE generation, not an adapter or backend rewrite'),
    body: t('同一个 BASE episode 明确记录 adapter_loaded=false，但 step 0 的 raw_completion 仍然出现 [action] search[...]；下一步又自己写回 <action>...</action>。推理后端在 model.generate 之后只是 decode 新 token 并直接返回，没有把尖括号改成方括号。现有仓库证据因此最多只能定到：Qwen2.5-7B-Instruct 在这套 Prompt + chat-template 路径下会发生外层动作标签（wrapper）漂移。', 'That same BASE episode records adapter_loaded=false, yet its step-0 raw_completion still contains [action] search[...]; on the next step it returns to <action>...</action>. After model.generate, the inference backend only decodes the new tokens and returns them; it does not rewrite angle brackets into square brackets. The deepest repository-supported attribution is therefore wrapper drift from Qwen2.5-7B-Instruct under this prompt + chat-template path.'),
    links: [
      { kind: 'raw-episode', label: t('BASE adapter receipt · adapter_loaded=false', 'BASE adapter receipt · adapter_loaded=false'), href: `${rawEpisode}#L2-L12` },
      { kind: 'raw-episode', label: t('[action] → <action> 原始输出', '[action] → <action> raw completions'), href: `${rawEpisode}#L42-L53` },
      { kind: 'code', label: t('Transformers generate → decode → return', 'Transformers generate → decode → return'), href: `${experimentRoot}/vendor/openevo-webshop/src/openevo_webshop/inference.py#L227-L232` },
    ],
  },
  {
    when: '2026-08-18 · H1.36',
    title: t('到 H1.36，我们已经知道这种格式会漂', 'By H1.36, this formatting drift was already known'),
    body: t('H1.36 时仓库已经记录：7B BASE 会在 [action]cmd、=search[...]、<click[...]> 等外层写法之间漂移，并把它定性为 harness / measurement mismatch。随后提交 8e526e42 做了 strict-first 修复：先按严格 <action> 合同解析；只有失败时，才从 </think> 之后恢复一个完整的 search[...] / click[...] command。', 'During H1.36 the repository already recorded that the 7B BASE model drifted among wrapper forms such as [action]cmd, =search[...], and <click[...]>, and classified this as a harness / measurement mismatch. Commit 8e526e42 then added a strict-first repair: try the strict <action> contract first, and only on failure recover one complete search[...] / click[...] command after </think>.'),
    links: [
      { kind: 'historical-record', label: t('H1.36 同时期收口报告', 'Contemporaneous H1.36 closeout report'), href: `${experimentRoot}/docs/evidence/remote-runs/2026-08-18/h1.36/REPORT.md` },
      { kind: 'commit', label: t('commit 8e526e42 · parser compatibility', 'commit 8e526e42 · parser compatibility'), href: h136ParserCommit },
      { kind: 'code', label: t('strict-first action-command 修复', 'strict-first action-command repair'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
  {
    when: t('H1.36 训练数据', 'H1.36 training data'),
    title: t('训练数据没有把这类解析失败轨迹当成监督', 'Parser-failed traces were not admitted as self-evolution supervision'),
    body: t('H1.36 的自进化数据构建器只接收成功、身份完整、没有 parser/fallback failure 的轨迹；每一步还必须 action_valid=true、used_fallback=false、parser_failure=false。harvest 默认使用 strict-v1 <action> 合同。也就是说，strict parser 读不懂的 malformed wrapper 会在进入训练集之前被排除。SD-LoRA 可能改变某种格式出现的频率，但现有证据不支持“它创造了 [action] 这个习惯”。', 'The H1.36 self-evolution dataset builder accepts only successful, identity-complete traces with no parser/fallback failure; every step must also have action_valid=true, used_fallback=false, and parser_failure=false. Harvest defaults to the strict-v1 <action> contract. In other words, malformed wrappers rejected by that strict parser are filtered before entering training. SD-LoRA could affect how often a format appears, but the evidence does not support the claim that it created the [action] habit.'),
    links: [
      { kind: 'code', label: t('自进化数据筛选条件 · 精确行', 'Self-evolution dataset filters · exact lines'), href: `${experimentRoot}/scripts/openevo_webshop/build_self_evolution_dataset.py#L67-L90` },
      { kind: 'code', label: t('H1.36 launcher · strict-v1 默认合同', 'H1.36 launcher · strict-v1 default contract'), href: `${experimentRoot}/scripts/openevo_webshop/launch_h136_qwen7b_self_evolution.sh#L53-L69` },
    ],
  },
  {
    when: '2026-08-25 · PRIMARY-v1',
    title: t('真正漏掉的是正式评测前的兼容性预检', 'What was missing was a compatibility preflight before formal evaluation'),
    body: t('第一次 SEED-strict PRIMARY-v1 仍把 SEED 官方 projection 直接接在这类模型输出后面，却没有先拿真实模型输出验证“projection 能不能稳定读出完整 command”。于是 wrapper 不匹配时，本来完整的 search[...] / click[...] command 被读成尾部碎片并送进环境，最终制造出两臂 0 分的测量假象。一句话定责：模型自身有已知 wrapper 漂移，而我们的正式集成没有提前做兼容性预检。更完整地说，模型产生了已知格式漂移；我们的实验 harness 没有在正式 SEED 集成前处理这个已知漂移。', 'The first SEED-strict PRIMARY-v1 run still placed the released SEED projection directly after this kind of model output without first checking, on real model outputs, that the projection could reliably recover the complete command. When wrappers did not match, otherwise complete search[...] / click[...] commands were projected into tail fragments and sent to the environment, producing the apparent all-zero result. In one sentence: the model had known wrapper drift, and our formal integration did not run the compatibility preflight before evaluation. More fully, the model produced known formatting drift and our experiment harness did not handle it before formal SEED integration.'),
    links: [
      { kind: 'raw-episode', label: t('当时冻结的 BASE 原始回合', 'Frozen BASE raw episode from the run'), href: `${rawEpisode}#L42-L53` },
      { kind: 'human-report', label: t('PRIMARY-v1 根因与修复记录', 'PRIMARY-v1 root-cause and repair record'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/RESULTS.md` },
    ],
  },
  {
    when: t('PRIMARY-v2 修复', 'PRIMARY-v2 repair'),
    title: t('PRIMARY-v2 修的是测量接口，而且两边用同一规则', 'PRIMARY-v2 repaired measurement and used the same rule for both arms'),
    body: t('修复后的 PRIMARY-v2 只改变动作 wrapper 的识别方式，并对 BASE 与 SD-LoRA 使用同一合同；任务面板和比较边界保持不变。这个修复解决的是“评测器能不能读懂动作”，不是给 OpenEvo 一边额外能力。', 'Repaired PRIMARY-v2 changed only action-wrapper recognition and applied the same contract to BASE and SD-LoRA; the task panel and comparison boundary stayed the same. The repair addresses whether the evaluator can read the action, not whether one arm gets extra capability.'),
    links: [
      { kind: 'machine-result', label: t('PRIMARY-v2 配对分析', 'PRIMARY-v2 paired analysis'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/analysis-v2.json` },
      { kind: 'machine-result', label: t('PRIMARY-v2 覆盖与身份对账', 'PRIMARY-v2 coverage and identity reconciliation'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/reconciliation-v2.json` },
      { kind: 'code', label: t('parser compatibility 代码', 'Parser compatibility code'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
  {
    when: t('Track A 正式审计', 'Formal Track A audit'),
    title: t('真实正式运行再次证明：模型还会漂，但测量没有再次被污染', 'The formal run confirms drift persisted without re-polluting the measurement'),
    body: t('我们现在不再只靠几个样例说这件事。对 Track A 已发布的 256 个 raw episode、共 3,672 个模型动作步骤做了可重复审计：300 步严格 <action> 直接通过，3,253 步由两臂共用的冻结 v3 compatibility projection 恢复，119 步仍无法恢复并作为 environment-invalid action fail closed（BASE 77、SD-LoRA 42）。这 119 步与保存的 invalid_action_steps 和 environment-invalid 计数逐项对齐，没有被偷偷换成一个合法动作；同时 256/256 formal episodes 仍然有效、parser-invalid=0。也就是说，“模型 wrapper 漂移”“一次 agent 动作失败”和“整条测量失效”确实是三件不同的事。', 'This is no longer based on a few examples. A reproducible audit over all 256 published Track A raw episodes and 3,672 model-action steps finds 300 strict <action> parses, 3,253 recoveries through the frozen v3 compatibility projection shared by both arms, and 119 still-unrecoverable steps that fail closed as environment-invalid actions (BASE 77, SD-LoRA 42). Those 119 exactly match the saved invalid_action_steps and environment-invalid counts; none were silently substituted with a legal action. At the same time, all 256 formal episodes remain valid and parser-invalid=0. Model wrapper drift, one fail-closed agent action, and a measurement-invalid episode are therefore distinct events.'),
    links: [
      { kind: 'audit', label: t('Track A wrapper 审计 · 机器可读', 'Track A wrapper audit · machine-readable'), href: `${wrapperAuditRoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/WRAPPER_AUDIT.json` },
      { kind: 'human-report', label: t('Track A wrapper 审计 · 解释', 'Track A wrapper audit · interpretation'), href: `${wrapperAuditRoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/WRAPPER_AUDIT.md` },
      { kind: 'code', label: t('可重复审计器', 'Reproducible auditor'), href: `${wrapperAuditRoot}/scripts/openevo_webshop/audit_seedcmp_wrapper_drift.py` },
    ],
  },
];
---

<details class="wrapper-attribution" id="action-wrapper-attribution" data-ui-audit="layout overflow contrast">
  <summary>
    <span><small>{t('技术回溯 · 默认折叠', 'TECHNICAL TRACE · COLLAPSED BY DEFAULT')}</small><strong>{t('动作包装格式：官方怎么规定、模型怎么漂、我们的集成责任在哪里', 'Action wrapper: released contract, model drift, and our integration responsibility')}</strong></span>
    <i aria-hidden="true"></i>
  </summary>

  <div class="wrapper-attribution__body">
    <p class="wrapper-attribution__lead">{t('先把两个东西分开：search[...] / click[...] 是 WebShop 真正要执行的动作命令；<action>...</action> 或 [action]... 是包住命令、让解析器定位动作的外层标签（wrapper）。这次事故发生在外层标签，不是动作命令本身。下面按“官方规则 → 我们的 Prompt → BASE 原始输出 → 已知问题 → 训练数据 → PRIMARY-v1 → PRIMARY-v2 → Track A 正式审计”追下去。主结论不变：[action] 不是 OpenEvo Prompt 规定的格式，SEED parser 也不是在违反自己的合同。正式审计进一步证明：模型仍会 wrapper 漂移，但 repaired harness 能把可恢复命令与 fail-closed agent action failure 分开，且没有把这两类现象重新变成 parser-invalid measurement。', 'First separate two things: search[...] / click[...] are the action commands WebShop actually executes; <action>...</action> or [action]... are outer wrapper labels that let the parser locate the command. This incident happened at the wrapper layer, not in the command itself. The trace below follows the chain from released rule → our prompt → raw BASE output → known issue → training data → PRIMARY-v1 → PRIMARY-v2 → formal Track A audit. The conclusion is unchanged: [action] was not an OpenEvo prompt convention and the SEED parser was enforcing its own contract. The formal audit adds a stronger result: wrapper drift still occurs, while the repaired harness separates recoverable commands from fail-closed agent-action failures without turning either category back into parser-invalid measurement.')}</p>

    <div class="wrapper-attribution__timeline">
      {steps.map((step, index) => (
        <article>
          <div class="wrapper-attribution__index"><span>{String(index + 1).padStart(2, '0')}</span><small>{step.when}</small></div>
          <div class="wrapper-attribution__copy">
            <h4>{step.title}</h4><p>{step.body}</p>
            <OpenEvoEvidenceRefs locale={locale} sources={step.links} compact ariaLabel={t(`“${step.title}”的证据`, `Evidence for ${step.title}`)} />
          </div>
        </article>
      ))}
    </div>

    <p class="wrapper-attribution__boundary"><strong>{t('证据边界：', 'Evidence boundary: ')}</strong>{t('仓库证据可以排除“Prompt 明确要求 [action]”“推理后端把尖括号改成方括号”“H1.36 malformed 训练样本把它教进去”这三种解释，但不能继续定位到 Qwen2.5-7B-Instruct 的哪一条预训练 / SFT 数据。因此这里不再把责任推给某个未知的上游样本或个人，也不声称 SD-LoRA 绝不可能改变 wrapper frequency。Track A 的 3,672-step 审计只证明当前冻结合同下没有 measurement pollution；它不等于模型从此不会生成坏格式。', 'Repository evidence rules out three explanations — a prompt explicitly requesting [action], inference-backend bracket rewriting, and malformed H1.36 supervision teaching the habit — but cannot identify which Qwen2.5-7B-Instruct pretraining/SFT example caused it. Attribution therefore stops here rather than naming an unknown upstream sample or person, and it does not claim SD-LoRA could never affect wrapper frequency. The 3,672-step Track A audit establishes no measurement pollution under this frozen contract; it does not mean the model will never emit malformed formatting again.')}</p>
  </div>
</details>

<style>
  .wrapper-attribution{max-width:1112px;margin:12px auto 42px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);color:var(--color-text)}
  .wrapper-attribution>summary{display:flex;align-items:center;justify-content:space-between;gap:18px;cursor:pointer;padding:18px 0;list-style:none}.wrapper-attribution>summary::-webkit-details-marker{display:none}.wrapper-attribution>summary span{display:grid;gap:5px;min-width:0}.wrapper-attribution>summary small{color:var(--color-text-muted);font-size:.67rem;font-weight:800;letter-spacing:.08em}.wrapper-attribution>summary strong{font-size:.92rem;line-height:1.45}.wrapper-attribution>summary i{position:relative;width:16px;height:16px;flex:0 0 16px}.wrapper-attribution>summary i::before,.wrapper-attribution>summary i::after{content:'';position:absolute;left:2px;right:2px;top:7px;height:1px;background:var(--color-text-muted)}.wrapper-attribution>summary i::after{transform:rotate(90deg);transition:transform .18s ease}.wrapper-attribution[open]>summary i::after{transform:rotate(0)}
  .wrapper-attribution__body{padding:2px 0 20px}.wrapper-attribution__lead,.wrapper-attribution__boundary{max-width:86ch;margin:0;color:var(--color-text-muted);font-size:.79rem;line-height:1.68}.wrapper-attribution__timeline{margin-top:14px;border-top:1px solid var(--color-border)}.wrapper-attribution__timeline article{display:grid;grid-template-columns:132px minmax(0,1fr);gap:22px;padding:18px 0;border-bottom:1px solid var(--color-border)}.wrapper-attribution__index{display:grid;align-content:start;gap:5px}.wrapper-attribution__index span{color:var(--color-accent);font:700 .7rem ui-monospace,SFMono-Regular,Menlo,monospace}.wrapper-attribution__index small{color:var(--color-text-muted);font-size:.67rem;line-height:1.4}.wrapper-attribution__copy h4{margin:0 0 7px;font-size:.9rem;line-height:1.45}.wrapper-attribution__copy>p{margin:0;max-width:83ch;color:var(--color-text-muted);font-size:.78rem;line-height:1.68}.wrapper-attribution__boundary{margin-top:16px}.wrapper-attribution__boundary strong{color:var(--color-text)}
  @media(max-width:720px){.wrapper-attribution{margin-inline:18px}.wrapper-attribution__timeline article{grid-template-columns:1fr;gap:8px}.wrapper-attribution>summary{align-items:flex-start}}
</style>