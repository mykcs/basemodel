---
import type { Locale } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const experimentRoot = 'https://github.com/mykcs/openevo-experiment/blob/115062ea0b47ee769a3e1591ffd3d5c89c4a353a';
const heldoutRoot = 'https://github.com/mykcs/openevo-experiment/blob/429faae1acc1132f8bdad4269a4e15864a9cccb0';
const h136ParserCommit = 'https://github.com/mykcs/openevo-experiment/commit/8e526e42de82e3fb417eb6dc4d892e068d73ef1f';
const seedRoot = 'https://github.com/jinyangwu/SEED/blob/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const rawEpisode = `${experimentRoot}/docs/evidence/seed-official-heldout-comparison-v1/episodes/primary/base/episodes/webshop_seed0_goal00395-2026082586.json`;
const heldoutComparisonConfig = `${heldoutRoot}/configs/experiment/webshop-seed-official-heldout-comparison-v1.json`;
const h138bConfig = `${heldoutRoot}/configs/experiment/h1.38b-method-control-v1.json`;

type Step = { when: string; title: string; body: string; links: EvidenceRef[] };
const steps: Step[] = [
  {
    when: t('官方合同', 'Released contract'),
    title: t('先看规则：SEED 要求 <action>...</action>', 'Start with the rule: SEED requires <action>...</action>'),
    body: t('SEED 公开的 WebShop Prompt 明确要求动作放进 <action>...</action>。它的解析器（webshop_projection）也只按这对标签抽取里面的动作；找不到时，会退化成输出最后 20 个字符。因此这里不能写成“SEED parser 有 bug”：官方代码是在执行它自己公开的接口合同。', 'The released SEED WebShop prompt explicitly requires actions inside <action>...</action>. Its parser (webshop_projection) extracts actions only from that tag pair; when the pair is absent, it falls back to the final 20 characters. This is therefore not a SEED-parser bug: the released code is enforcing its published interface contract.'),
    links: [
      { kind: 'official-code', label: t('SEED WebShop Prompt · 精确行', 'SEED WebShop prompt · exact lines'), href: `${seedRoot}/agent_system/environments/prompts/webshop.py#L25-L27` },
      { kind: 'official-code', label: t('SEED webshop_projection · 精确行', 'SEED webshop_projection · exact lines'), href: `${seedRoot}/agent_system/environments/env_package/webshop/projection.py#L32-L40` },
    ],
  },
  {
    when: t('我们的 Prompt', 'Our prompt'),
    title: t('我们的 Prompt 也要求 <action>，没有要求 [action]', 'Our prompt also asks for <action>, not [action]'),
    body: t('保存下来的 BASE 原始回合里，实际送给模型的 Prompt 同样写着 “present it within <action> </action> tags”。所以 [action] 不是 OpenEvo 在 Prompt 里规定给模型的动作格式。', 'The saved BASE episode shows that the actual prompt sent to the model likewise says “present it within <action> </action> tags”. So [action] was not an action format that OpenEvo instructed the model to use in the prompt.'),
    links: [
      { kind: 'raw-episode', label: t('BASE step 0 Prompt', 'BASE step-0 prompt'), href: `${rawEpisode}#L42-L43` },
      { kind: 'code', label: t('OpenEvo WebShop Prompt / action contract', 'OpenEvo WebShop prompt / action contract'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L12-L18` },
    ],
  },
  {
    when: t('模型生成', 'Model generation'),
    title: t('偏差出现在 BASE 原始生成里，不是 adapter 或 backend 改写', 'The drift appears in raw BASE generation, not an adapter or backend rewrite'),
    body: t('先把这轮实验设置摆出来。PRIMARY-v1 不是在现场重新训练模型，而是在同一套 128 个 SEED-compatible WebShop 保留任务上比较两份冻结的 Qwen2.5-7B-Instruct：BASE 完全不加载 adapter；另一边加载此前 H1.38B 训练完成的 final SD-LoRA。每个任务、每个模型只跑 1 次，所以 PRIMARY 主比较一共是 128 × 2 = 256 个 episode。这个 SD-LoRA 的训练本身也不是大规模预训练：封存训练流只有 16 条成功 rollout 记录，覆盖 8 个不同任务、每个任务 2 条独立成功轨迹；它们按 8 个连续增量训练，1 epoch，每个增量最多 16 个 optimizer steps，最终 effective rank 32。知道这个规模以后，一个自然怀疑会是“是不是模型不够强，或者这点训练把格式教坏了”。但这次责任判断不需要靠猜：同一个 BASE episode 明确记录 adapter_loaded=false，step 0 的 raw_completion 仍然出现 [action] search[...]；下一步又自己写回 <action>...</action>。推理后端在 model.generate 之后只是 decode 新 token 并直接返回，没有把尖括号改成方括号。因此现有证据至少能确定：这种 [action] 漂移在没有 OpenEvo adapter 的 Qwen2.5-7B-Instruct 上已经存在；不能把它的起源归给这次 SD-LoRA 训练。训练可能改变某种格式出现的频率，但这是另一条需要单独测量的 claim。', 'First put the experiment scale on the table. PRIMARY-v1 did not retrain a model on the spot; it compared two frozen Qwen2.5-7B-Instruct variants on the same 128 SEED-compatible held-out WebShop tasks: BASE with no adapter at all, and the previously trained H1.38B final SD-LoRA. Each model ran one rollout per task, so the primary comparison contained 128 × 2 = 256 episodes. The SD-LoRA update itself was also a small controlled post-training run rather than large-scale pretraining: its sealed training stream contained 16 successful rollout records from 8 task identities, two independent successful trajectories per task, processed as eight sequential increments, one epoch, with at most 16 optimizer steps per increment, ending at effective rank 32. Given that scale, a natural hypothesis is that the model was too weak or that the small amount of training taught the bad format. But attribution does not need to rely on that guess: the same BASE episode records adapter_loaded=false, yet step 0 raw_completion still contains [action] search[...], and the next step returns to <action>...</action>. After model.generate, the inference backend only decodes the new tokens and returns them; it does not rewrite angle brackets into square brackets. The repository evidence therefore establishes at least this much: [action] drift already occurs in Qwen2.5-7B-Instruct without the OpenEvo adapter, so its origin cannot be attributed to this SD-LoRA training. Training could still change the frequency of a format, which is a separate claim that would need its own measurement.'),
    links: [
      { kind: 'config', label: t('PRIMARY-v1 冻结比较：7B BASE vs H1.38B final SD-LoRA · 128×2', 'PRIMARY-v1 frozen comparison: 7B BASE vs H1.38B final SD-LoRA · 128×2'), href: heldoutComparisonConfig },
      { kind: 'config', label: t('H1.38B 训练流：16 records · 8 tasks · 8 increments', 'H1.38B training stream: 16 records · 8 tasks · 8 increments'), href: h138bConfig },
      { kind: 'raw-episode', label: t('BASE adapter receipt · adapter_loaded=false', 'BASE adapter receipt · adapter_loaded=false'), href: `${rawEpisode}#L2-L12` },
      { kind: 'raw-episode', label: t('[action] → <action> 原始输出', '[action] → <action> raw completions'), href: `${rawEpisode}#L42-L53` },
      { kind: 'code', label: t('Transformers generate → decode → return', 'Transformers generate → decode → return'), href: `${experimentRoot}/vendor/openevo-webshop/src/openevo_webshop/inference.py#L227-L232` },
    ],
  },
  {
    when: '2026-08-18 · H1.36',
    title: t('到 H1.36，我们已经知道这种格式会漂', 'By H1.36, this formatting drift was already known'),
    body: t('H1.36 时仓库已经记录：7B BASE 会在 [action]cmd、=search[...]、<click[...]> 等外层写法之间漂移，并把它定性为 harness / measurement mismatch。随后提交 8e526e42 做了 strict-first 修复：先按严格 <action> 合同解析；只有失败时，才从 </think> 之后恢复一个完整的 search[...] / click[...] command。', 'During H1.36 the repository already recorded that the 7B BASE model drifted among wrapper forms such as [action]cmd, =search[...], and <click[...]>, and classified this as a harness / measurement mismatch. Commit 8e526e42 then added a strict-first repair: try the strict <action> contract first, and only on failure recover one complete search[...] / click[...] command after </think>.'),
    links: [
      { kind: 'historical-record', label: t('H1.36 同时期收口报告', 'Contemporaneous H1.36 closeout report'), href: `${experimentRoot}/docs/evidence/remote-runs/2026-08-18/h1.36/REPORT.md` },
      { kind: 'commit', label: t('commit 8e526e42 · parser compatibility', 'commit 8e526e42 · parser compatibility'), href: h136ParserCommit },
      { kind: 'code', label: t('strict-first action-command 修复', 'strict-first action-command repair'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
  {
    when: t('H1.36 训练数据', 'H1.36 training data'),
    title: t('训练数据没有把这类解析失败轨迹当成监督', 'Parser-failed traces were not admitted as self-evolution supervision'),
    body: t('H1.36 的自进化数据构建器只接收成功、身份完整、没有 parser/fallback failure 的轨迹；每一步还必须 action_valid=true、used_fallback=false、parser_failure=false。harvest 默认使用 strict-v1 <action> 合同。也就是说，strict parser 读不懂的 malformed wrapper 会在进入训练集之前被排除。这里的作用是补充训练链路的边界，不是替代前一条更强的起源证据：BASE 在 adapter_loaded=false 时已经会写出 [action]。因此现有证据不支持“SD-LoRA 创造了 [action] 这个习惯”，但也不声称训练绝不可能改变某种 wrapper 的出现频率。', 'The H1.36 self-evolution dataset builder accepts only successful, identity-complete traces with no parser/fallback failure; every step must also have action_valid=true, used_fallback=false, and parser_failure=false. Harvest defaults to the strict-v1 <action> contract, so malformed wrappers rejected by the strict parser are filtered before entering training. This is supporting evidence about the training path, not a substitute for the stronger origin evidence above: BASE already emits [action] with adapter_loaded=false. The evidence therefore does not support the claim that SD-LoRA created the [action] habit, while still avoiding the stronger claim that training could never change wrapper frequency.'),
    links: [
      { kind: 'code', label: t('自进化数据筛选条件 · 精确行', 'Self-evolution dataset filters · exact lines'), href: `${experimentRoot}/scripts/openevo_webshop/build_self_evolution_dataset.py#L67-L90` },
      { kind: 'code', label: t('H1.36 launcher · strict-v1 默认合同', 'H1.36 launcher · strict-v1 default contract'), href: `${experimentRoot}/scripts/openevo_webshop/launch_h136_qwen7b_self_evolution.sh#L53-L69` },
    ],
  },
  {
    when: '2026-08-25 · PRIMARY-v1',
    title: t('真正漏掉的是正式评测前的兼容性预检', 'What was missing was a compatibility preflight before formal evaluation'),
    body: t('第一次 SEED-strict PRIMARY-v1 仍把 SEED 官方 projection 直接接在这类模型输出后面，却没有先拿真实模型输出验证“projection 能不能稳定读出完整 command”。于是 wrapper 不匹配时，本来完整的 search[...] / click[...] command 被读成尾部碎片并送进环境，最终制造出两臂 0 分的测量假象。更准确的定责是：模型产生了已知格式漂移；我们的实验 harness 没有在正式 SEED 集成前处理这个已知漂移。用技术术语概括就是：模型自身有已知 wrapper 漂移，而我们的正式集成没有提前做兼容性预检。', 'The first SEED-strict PRIMARY-v1 run still placed the released SEED projection directly after this kind of model output without first checking, on real model outputs, that the projection could reliably recover the complete command. When wrappers did not match, otherwise complete search[...] / click[...] commands were projected into tail fragments and sent to the environment, producing the apparent all-zero result. The precise attribution is: the model produced known formatting drift, and our experiment harness did not handle that known drift before formal SEED integration.'),
    links: [
      { kind: 'raw-episode', label: t('当时冻结的 BASE 原始回合', 'Frozen BASE raw episode from the run'), href: `${rawEpisode}#L42-L53` },
      { kind: 'human-report', label: t('PRIMARY-v1 根因与修复记录', 'PRIMARY-v1 root-cause and repair record'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/RESULTS.md` },
    ],
  },
  {
    when: t('PRIMARY-v2 修复', 'PRIMARY-v2 repair'),
    title: t('PRIMARY-v2 修的是测量接口，而且两边用同一规则', 'PRIMARY-v2 repaired measurement and used the same rule for both arms'),
    body: t('修复后的 PRIMARY-v2 只改变动作 wrapper 的识别方式，并对 BASE 与 SD-LoRA 使用同一合同；任务面板和比较边界保持不变。这个修复解决的是“评测器能不能读懂动作”，不是给 OpenEvo 一边额外能力。', 'Repaired PRIMARY-v2 changed only action-wrapper recognition and applied the same contract to BASE and SD-LoRA; the task panel and comparison boundary stayed the same. The repair addresses whether the evaluator can read the action, not whether one arm gets extra capability.'),
    links: [
      { kind: 'machine-result', label: t('PRIMARY-v2 配对分析', 'PRIMARY-v2 paired analysis'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/analysis-v2.json` },
      { kind: 'machine-result', label: t('PRIMARY-v2 覆盖与身份对账', 'PRIMARY-v2 coverage and identity reconciliation'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/reconciliation-v2.json` },
      { kind: 'code', label: t('parser compatibility 代码', 'Parser compatibility code'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
];
---

<details class="wrapper-attribution" id="action-wrapper-attribution" data-ui-audit="layout overflow contrast">
  <summary>
    <span><small>{t('一次实验格式错误 · 默认折叠', 'FORMAT-ERROR INCIDENT · COLLAPSED BY DEFAULT')}</small><strong>{t('实验里出现了一次动作格式错误：发生了什么，为什么会发生，我们怎么修复', 'A formatting error occurred in the experiment: what happened, why it happened, and how we fixed it')}</strong></span>
    <i aria-hidden="true"></i>
  </summary>

  <div class="wrapper-attribution__body">
    <p class="wrapper-attribution__lead wrapper-attribution__lead--context">{t('如果你第一次打开这一页，可以先把我们在做的事理解成这样：我们想知道 OpenEvo 的“让模型从自己做成功的 WebShop 任务里再学一点”到底有没有用。这里的模型是 Qwen2.5-7B-Instruct。我们先让模型在一个模拟购物网站里根据文字要求搜索商品、点击选项并尝试完成购买；再把一小批模型自己做成功的轨迹训练成一个 SD-LoRA adapter；最后把“完全没加 adapter 的原始 BASE”和“加载这个 adapter 的模型”放到同一批 WebShop 任务上比较。PRIMARY-v1 就是这条流程中的一次正式评测，不是一次新的训练。', 'If this is your first time on the page, start with the experiment itself: we want to know whether OpenEvo’s idea of letting a model learn a little more from WebShop tasks it solved successfully actually helps. The model here is Qwen2.5-7B-Instruct. We first let it act in a simulated shopping site by searching, clicking, choosing products, and trying to complete purchases; then we turn a small set of its own successful trajectories into an SD-LoRA adapter; finally we compare the untouched BASE model with the same model plus that adapter on the same WebShop tasks. PRIMARY-v1 is one formal evaluation in that pipeline, not a new training run.')}</p>
    <p class="wrapper-attribution__lead">{t('这次评测里发生了一个很具体的问题：PRIMARY-v1 正式评测里，模型本来生成了合法的 search[...] / click[...] 命令，但有些输出把外层 <action>...</action> 写成了 [action]...，SEED 的解析器因此没有读到完整动作。下面我们依次分析：正确格式是什么、错误实际长什么样、它在哪里产生、模型和训练规模是否足以解释它、我们为什么没有在正式评测前拦住、它有没有进入训练数据，以及后来怎样修复。', 'A concrete problem occurred in that evaluation: during PRIMARY-v1, the model generated valid search[...] / click[...] commands, but some outputs used [action]... instead of the expected outer <action>...</action> tags, so the SEED parser did not recover the complete action. The analysis below asks, in order: what the correct format was, what the error looked like, where it came from, whether model scale or training scale explains it, why we did not catch it before formal evaluation, whether it entered training data, and how it was repaired.')}</p>

    <div class="wrapper-attribution__timeline">
      {steps.map((step, index) => (
        <article>
          <div class="wrapper-attribution__index"><span>{String(index + 1).padStart(2, '0')}</span><small>{step.when}</small></div>
          <div class="wrapper-attribution__copy">
            <h4>{step.title}</h4><p>{step.body}</p>
            <OpenEvoEvidenceRefs locale={locale} sources={step.links} compact ariaLabel={t(`“${step.title}”的证据`, `Evidence for ${step.title}`)} />
          </div>
        </article>
      ))}
    </div>

    <p class="wrapper-attribution__boundary"><strong>{t('证据边界：', 'Evidence boundary: ')}</strong>{t('仓库证据可以排除“Prompt 明确要求 [action]”“推理后端把尖括号改成方括号”“必须由 SD-LoRA 训练才会出现 [action]”这三种解释，但不能继续定位到 Qwen2.5-7B-Instruct 的哪一条预训练 / SFT 数据。因此这里不再把责任推给某个未知的上游样本或个人，也不声称 SD-LoRA 绝不可能改变 wrapper frequency。', 'Repository evidence rules out three explanations — a prompt explicitly requesting [action], inference-backend bracket rewriting, and the idea that [action] requires SD-LoRA training to appear — but it cannot identify which Qwen2.5-7B-Instruct pretraining/SFT example caused the behavior. Attribution therefore stops here rather than naming an unknown upstream sample or person, and it does not claim SD-LoRA could never affect wrapper frequency.')}</p>
  </div>
</details>

<style>
  .wrapper-attribution{max-width:1112px;margin:12px auto 42px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);color:var(--color-text)}
  .wrapper-attribution>summary{display:flex;align-items:center;justify-content:space-between;gap:18px;cursor:pointer;padding:18px 0;list-style:none}.wrapper-attribution>summary::-webkit-details-marker{display:none}.wrapper-attribution>summary span{display:grid;gap:5px;min-width:0}.wrapper-attribution>summary small{color:var(--color-text-muted);font-size:.67rem;font-weight:800;letter-spacing:.08em}.wrapper-attribution>summary strong{font-size:.92rem;line-height:1.45}.wrapper-attribution>summary i{position:relative;width:16px;height:16px;flex:0 0 16px}.wrapper-attribution>summary i::before,.wrapper-attribution>summary i::after{content:'';position:absolute;left:2px;right:2px;top:7px;height:1px;background:var(--color-text-muted)}.wrapper-attribution>summary i::after{transform:rotate(90deg);transition:transform .18s ease}.wrapper-attribution[open]>summary i::after{transform:rotate(0)}
  .wrapper-attribution__body{padding:2px 0 20px}.wrapper-attribution__lead,.wrapper-attribution__boundary{max-width:86ch;margin:0;color:var(--color-text-muted);font-size:.79rem;line-height:1.68}.wrapper-attribution__lead+.wrapper-attribution__lead{margin-top:10px}.wrapper-attribution__lead--context{color:var(--color-text)}.wrapper-attribution__timeline{margin-top:14px;border-top:1px solid var(--color-border)}.wrapper-attribution__timeline article{display:grid;grid-template-columns:132px minmax(0,1fr);gap:22px;padding:18px 0;border-bottom:1px solid var(--color-border)}.wrapper-attribution__index{display:grid;align-content:start;gap:5px}.wrapper-attribution__index span{color:var(--color-accent);font:700 .7rem ui-monospace,SFMono-Regular,Menlo,monospace}.wrapper-attribution__index small{color:var(--color-text-muted);font-size:.67rem;line-height:1.4}.wrapper-attribution__copy h4{margin:0 0 7px;font-size:.9rem;line-height:1.45}.wrapper-attribution__copy>p{margin:0;max-width:83ch;color:var(--color-text-muted);font-size:.78rem;line-height:1.68}.wrapper-attribution__boundary{margin-top:16px}.wrapper-attribution__boundary strong{color:var(--color-text)}
  @media(max-width:720px){.wrapper-attribution{margin-inline:18px}.wrapper-attribution__timeline article{grid-template-columns:1fr;gap:8px}.wrapper-attribution>summary{align-items:flex-start}}
</style>