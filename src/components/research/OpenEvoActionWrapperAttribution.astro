---
import type { Locale } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const experimentRoot = 'https://github.com/mykcs/openevo-experiment/blob/115062ea0b47ee769a3e1591ffd3d5c89c4a353a';
const heldoutRoot = 'https://github.com/mykcs/openevo-experiment/blob/429faae1acc1132f8bdad4269a4e15864a9cccb0';
const h136ParserCommit = 'https://github.com/mykcs/openevo-experiment/commit/8e526e42de82e3fb417eb6dc4d892e068d73ef1f';
const seedRoot = 'https://github.com/jinyangwu/SEED/blob/2cf2fadca3c5aba28da68e8e1405182ba8d90e6c';
const rawEpisode = `${experimentRoot}/docs/evidence/seed-official-heldout-comparison-v1/episodes/primary/base/episodes/webshop_seed0_goal00395-2026082586.json`;
const heldoutComparisonConfig = `${heldoutRoot}/configs/experiment/webshop-seed-official-heldout-comparison-v1.json`;
const h138bConfig = `${heldoutRoot}/configs/experiment/h1.38b-method-control-v1.json`;

type Step = { when: string; title: string; body: string; links: EvidenceRef[] };
const steps: Step[] = [
  {
    when: t('官方合同', 'Released contract'),
    title: t('SEED 的动作格式：<action>...</action>', 'SEED action format: <action>...</action>'),
    body: t('SEED 公开的 WebShop Prompt 明确要求动作放进 <action>...</action>。它的解析器（webshop_projection）也只按这对标签抽取里面的动作；找不到时，会退化成输出最后 20 个字符。因此这里不能写成“SEED parser 有 bug”：官方代码是在执行它自己公开的接口合同。', 'The released SEED WebShop prompt explicitly requires actions inside <action>...</action>. Its parser (webshop_projection) extracts actions only from that tag pair; when the pair is absent, it falls back to the final 20 characters. This is therefore not a SEED-parser bug: the released code is enforcing its published interface contract.'),
    links: [
      { kind: 'official-code', label: t('SEED WebShop Prompt · 精确行', 'SEED WebShop prompt · exact lines'), href: `${seedRoot}/agent_system/environments/prompts/webshop.py#L25-L27` },
      { kind: 'official-code', label: t('SEED webshop_projection · 精确行', 'SEED webshop_projection · exact lines'), href: `${seedRoot}/agent_system/environments/env_package/webshop/projection.py#L32-L40` },
    ],
  },
  {
    when: t('我们的 Prompt', 'Our prompt'),
    title: t('我们的 Prompt 同样要求 <action>，没有要求 [action]', 'Our prompt also requires <action>, not [action]'),
    body: t('保存下来的 BASE 原始回合里，实际送给模型的 Prompt 同样写着 “present it within <action> </action> tags”。所以 [action] 不是 OpenEvo 在 Prompt 里规定给模型的动作格式。', 'The saved BASE episode shows that the actual prompt sent to the model likewise says “present it within <action> </action> tags”. So [action] was not an action format that OpenEvo instructed the model to use in the prompt.'),
    links: [
      { kind: 'raw-episode', label: t('BASE step 0 Prompt', 'BASE step-0 prompt'), href: `${rawEpisode}#L42-L43` },
      { kind: 'code', label: t('OpenEvo WebShop Prompt / action contract', 'OpenEvo WebShop prompt / action contract'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L12-L18` },
    ],
  },
  {
    when: t('模型生成', 'Model generation'),
    title: t('格式漂移在未加载 adapter 的 BASE 上已经出现', 'The drift already appears in BASE with no adapter loaded'),
    body: t('结论先行：这次 [action] 的起源不能归给 SD-LoRA 训练。同一个 BASE episode 明确记录 adapter_loaded=false，step 0 的 raw_completion 仍然出现 [action] search[...]；下一步又自己写回 <action>...</action>。推理后端在 model.generate 之后只是 decode 新 token 并直接返回，没有把尖括号改成方括号。训练可能改变某种 wrapper 的出现频率，但这是另一条需要单独测量的 claim。', 'Conclusion first: the origin of this [action] form cannot be attributed to SD-LoRA training. The same BASE episode explicitly records adapter_loaded=false, yet its step-0 raw_completion contains [action] search[...]; the next step returns to <action>...</action>. After model.generate, the inference backend only decodes new tokens and returns them; it does not rewrite angle brackets into square brackets. Training could still change wrapper frequency, which is a separate claim requiring its own measurement.'),
    links: [
      { kind: 'config', label: t('PRIMARY-v1 冻结比较：7B BASE vs H1.38B final SD-LoRA · 128×2', 'PRIMARY-v1 frozen comparison: 7B BASE vs H1.38B final SD-LoRA · 128×2'), href: heldoutComparisonConfig },
      { kind: 'config', label: t('H1.38B 训练流：16 records · 8 tasks · 8 increments', 'H1.38B training stream: 16 records · 8 tasks · 8 increments'), href: h138bConfig },
      { kind: 'raw-episode', label: t('BASE adapter receipt · adapter_loaded=false', 'BASE adapter receipt · adapter_loaded=false'), href: `${rawEpisode}#L2-L12` },
      { kind: 'raw-episode', label: t('[action] → <action> 原始输出', '[action] → <action> raw completions'), href: `${rawEpisode}#L42-L53` },
      { kind: 'code', label: t('Transformers generate → decode → return', 'Transformers generate → decode → return'), href: `${experimentRoot}/vendor/openevo-webshop/src/openevo_webshop/inference.py#L227-L232` },
    ],
  },
  {
    when: '2026-08-18 · H1.36',
    title: t('H1.36 已记录这种 wrapper 漂移', 'H1.36 had already recorded this wrapper drift'),
    body: t('H1.36 时仓库已经记录：7B BASE 会在 [action]cmd、=search[...]、<click[...]> 等外层写法之间漂移，并把它定性为 harness / measurement mismatch。随后提交 8e526e42 做了 strict-first 修复：先按严格 <action> 合同解析；只有失败时，才从 </think> 之后恢复一个完整的 search[...] / click[...] command。', 'During H1.36 the repository already recorded that the 7B BASE model drifted among wrapper forms such as [action]cmd, =search[...], and <click[...]>, and classified this as a harness / measurement mismatch. Commit 8e526e42 then added a strict-first repair: try the strict <action> contract first, and only on failure recover one complete search[...] / click[...] command after </think>.'),
    links: [
      { kind: 'historical-record', label: t('H1.36 同时期收口报告', 'Contemporaneous H1.36 closeout report'), href: `${experimentRoot}/docs/evidence/remote-runs/2026-08-18/h1.36/REPORT.md` },
      { kind: 'commit', label: t('commit 8e526e42 · parser compatibility', 'commit 8e526e42 · parser compatibility'), href: h136ParserCommit },
      { kind: 'code', label: t('strict-first action-command 修复', 'strict-first action-command repair'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
  {
    when: t('H1.36 训练数据', 'H1.36 training data'),
    title: t('解析失败的轨迹不会进入自进化监督', 'Parser-failed traces were excluded from self-evolution supervision'),
    body: t('H1.36 的自进化数据构建器只接收成功、身份完整、没有 parser/fallback failure 的轨迹；每一步还必须 action_valid=true、used_fallback=false、parser_failure=false。harvest 默认使用 strict-v1 <action> 合同。也就是说，strict parser 读不懂的 malformed wrapper 会在进入训练集之前被排除。这里的作用是补充训练链路的边界，不是替代前一条更强的起源证据：BASE 在 adapter_loaded=false 时已经会写出 [action]。因此现有证据不支持“SD-LoRA 创造了 [action] 这个习惯”，但也不声称训练绝不可能改变某种 wrapper 的出现频率。', 'The H1.36 self-evolution dataset builder accepts only successful, identity-complete traces with no parser/fallback failure; every step must also have action_valid=true, used_fallback=false, and parser_failure=false. Harvest defaults to the strict-v1 <action> contract, so malformed wrappers rejected by the strict parser are filtered before entering training. This supports the training-path boundary rather than replacing the stronger origin evidence above: BASE already emits [action] with adapter_loaded=false. The evidence therefore does not support the claim that SD-LoRA created the [action] habit, while still avoiding the stronger claim that training could never change wrapper frequency.'),
    links: [
      { kind: 'code', label: t('自进化数据筛选条件 · 精确行', 'Self-evolution dataset filters · exact lines'), href: `${experimentRoot}/scripts/openevo_webshop/build_self_evolution_dataset.py#L67-L90` },
      { kind: 'code', label: t('H1.36 launcher · strict-v1 默认合同', 'H1.36 launcher · strict-v1 default contract'), href: `${experimentRoot}/scripts/openevo_webshop/launch_h136_qwen7b_self_evolution.sh#L53-L69` },
    ],
  },
  {
    when: '2026-08-25 · PRIMARY-v1',
    title: t('正式评测前缺了真实输出兼容性预检', 'The formal evaluation lacked a real-output compatibility preflight'),
    body: t('第一次 SEED-strict PRIMARY-v1 仍把 SEED 官方 projection 直接接在这类模型输出后面，却没有先拿真实模型输出验证“projection 能不能稳定读出完整 command”。于是 wrapper 不匹配时，本来完整的 search[...] / click[...] command 被读成尾部碎片并送进环境，最终制造出两臂 0 分的测量假象。更准确的定责是：模型产生了已知格式漂移；我们的实验 harness 没有在正式 SEED 集成前处理这个已知漂移。用技术术语概括就是：模型自身有已知 wrapper 漂移，而我们的正式集成没有提前做兼容性预检。', 'The first SEED-strict PRIMARY-v1 run still placed the released SEED projection directly after this kind of model output without first checking, on real model outputs, that the projection could reliably recover the complete command. When wrappers did not match, otherwise complete search[...] / click[...] commands were projected into tail fragments and sent to the environment, producing the apparent all-zero result. The precise attribution is: the model produced known formatting drift, and our experiment harness did not handle that known drift before formal SEED integration.'),
    links: [
      { kind: 'raw-episode', label: t('当时冻结的 BASE 原始回合', 'Frozen BASE raw episode from the run'), href: `${rawEpisode}#L42-L53` },
      { kind: 'human-report', label: t('PRIMARY-v1 根因与修复记录', 'PRIMARY-v1 root-cause and repair record'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/RESULTS.md` },
    ],
  },
  {
    when: t('PRIMARY-v2 修复', 'PRIMARY-v2 repair'),
    title: t('PRIMARY-v2 只修测量接口，并对两边使用同一规则', 'PRIMARY-v2 repaired only measurement and used the same rule for both arms'),
    body: t('修复后的 PRIMARY-v2 只改变动作 wrapper 的识别方式，并对 BASE 与 SD-LoRA 使用同一合同；任务面板和比较边界保持不变。这个修复解决的是“评测器能不能读懂动作”，不是给 OpenEvo 一边额外能力。', 'Repaired PRIMARY-v2 changed only action-wrapper recognition and applied the same contract to BASE and SD-LoRA; the task panel and comparison boundary stayed the same. The repair addresses whether the evaluator can read the action, not whether one arm gets extra capability.'),
    links: [
      { kind: 'machine-result', label: t('PRIMARY-v2 配对分析', 'PRIMARY-v2 paired analysis'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/analysis-v2.json` },
      { kind: 'machine-result', label: t('PRIMARY-v2 覆盖与身份对账', 'PRIMARY-v2 coverage and identity reconciliation'), href: `${heldoutRoot}/docs/evidence/seed-official-heldout-comparison-v1/v2/reconciliation-v2.json` },
      { kind: 'code', label: t('parser compatibility 代码', 'Parser compatibility code'), href: `${experimentRoot}/scripts/openevo_webshop/webshop_comparison_contract.py#L69-L112` },
    ],
  },
];
---

<details class="wrapper-attribution" id="action-wrapper-attribution" data-ui-audit="layout overflow contrast">
  <summary>
    <span>
      <small>{t('发生了什么 · 为什么发生 · 如何修复', 'WHAT HAPPENED · WHY · REPAIR')}</small>
      <strong>{t('动作格式错误：<action>...</action> 被写成 [action]...', 'Action-format error: <action>...</action> was written as [action]...')}</strong>
    </span>
    <i aria-hidden="true"></i>
  </summary>

  <div class="wrapper-attribution__body">
    <p class="wrapper-attribution__lead wrapper-attribution__lead--context">{t('我们在用 WebShop 检验 OpenEvo 的参数更新能否让 Qwen2.5-7B-Instruct 从自己成功的任务轨迹里学到可迁移经验。流程是：先收集成功轨迹并训练一个 SD-LoRA adapter，再把未加载 adapter 的 BASE 和加载 final SD-LoRA 的模型放到同一批任务上比较。PRIMARY-v1 是这条流程的一次正式评测，不是一次新的训练。', 'We use WebShop to test whether an OpenEvo parameter update lets Qwen2.5-7B-Instruct learn transferable experience from its own successful trajectories. The pipeline collects successful trajectories, trains an SD-LoRA adapter, then compares untouched BASE against the same model with the final SD-LoRA on the same tasks. PRIMARY-v1 is a formal evaluation in that pipeline, not a new training run.')}</p>

    <p class="wrapper-attribution__incident">
      {t('模型生成的 search[...] / click[...] 命令本身是完整的，', 'The generated search[...] / click[...] command itself was complete, ')}
      <strong>{t('但有些输出把外层 <action>...</action> 写成了 [action]...。', 'but some outputs wrote the outer <action>...</action> wrapper as [action]....')}</strong>
      {t('SEED parser 因此没有读到完整动作，这直接造成了 PRIMARY-v1 的测量失效。', 'The SEED parser therefore failed to recover the complete action, directly invalidating the PRIMARY-v1 measurement.')}
    </p>

    <dl class="wrapper-attribution__facts" aria-label={t('判断原因前需要先知道的实验规模', 'Experiment scale needed for attribution')}>
      <div><dt>{t('正式评测', 'Formal evaluation')}</dt><dd><strong>128 × 2 = 256</strong> {t('个 episode；两边都是冻结模型，现场没有重新训练。', 'episodes; both arms were frozen and no retraining happened during evaluation.')}</dd></div>
      <div><dt>{t('adapter 训练规模', 'Adapter training scale')}</dt><dd><strong>16</strong> {t('条成功 rollout，覆盖 8 个任务 × 每个任务 2 条独立成功轨迹；8 次连续增量，1 epoch，每个增量最多 16 个 optimizer steps，因此累计 optimizer-step 上限是 ≤128；final effective rank 32。', 'successful rollouts across 8 tasks × 2 independent successes per task; 8 sequential increments, 1 epoch, at most 16 optimizer steps per increment, so the cumulative optimizer-step upper bound is ≤128; final effective rank 32.')}</dd></div>
      <div><dt>{t('错误何时已存在', 'When the error already exists')}</dt><dd><strong>{t('0 个 OpenEvo adapter 训练步即可看到', 'Visible with 0 OpenEvo adapter training steps')}</strong>{t('：adapter_loaded=false 的 BASE 已经写出了 [action] search[...]。所以不能把它的起源解释成“SD-LoRA 训练到第 N 步才把格式教坏”。', ': BASE with adapter_loaded=false already emitted [action] search[...]. Its origin therefore cannot be explained as “SD-LoRA training reached step N and taught the bad format.”')}</dd></div>
    </dl>

    <div class="wrapper-attribution__timeline">
      {steps.map((step, index) => (
        <article>
          <div class="wrapper-attribution__index"><span>{String(index + 1).padStart(2, '0')}</span><small>{step.when}</small></div>
          <div class="wrapper-attribution__copy">
            <h4>{step.title}</h4><p>{step.body}</p>
            <OpenEvoEvidenceRefs locale={locale} sources={step.links} compact ariaLabel={t(`“${step.title}”的证据`, `Evidence for ${step.title}`)} />
          </div>
        </article>
      ))}
    </div>

    <p class="wrapper-attribution__boundary"><strong>{t('证据边界：', 'Evidence boundary: ')}</strong>{t('仓库证据可以排除“Prompt 明确要求 [action]”“推理后端把尖括号改成方括号”“必须由 SD-LoRA 训练才会出现 [action]”这三种解释，但不能继续定位到 Qwen2.5-7B-Instruct 的哪一条预训练 / SFT 数据。因此这里不再把责任推给某个未知的上游样本或个人，也不声称 SD-LoRA 绝不可能改变 wrapper frequency。', 'Repository evidence rules out three explanations — a prompt explicitly requesting [action], inference-backend bracket rewriting, and the idea that [action] requires SD-LoRA training to appear — but it cannot identify which Qwen2.5-7B-Instruct pretraining/SFT example caused the behavior. Attribution therefore stops here rather than naming an unknown upstream sample or person, and it does not claim SD-LoRA could never affect wrapper frequency.')}</p>
  </div>
</details>

<style>
  .wrapper-attribution{max-width:1112px;margin:12px auto 42px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);color:var(--color-text)}
  .wrapper-attribution>summary{display:flex;align-items:center;justify-content:space-between;gap:18px;cursor:pointer;padding:18px 0;list-style:none}.wrapper-attribution>summary::-webkit-details-marker{display:none}.wrapper-attribution>summary span{display:grid;gap:5px;min-width:0}.wrapper-attribution>summary small{color:var(--color-text-muted);font-size:.67rem;font-weight:800;letter-spacing:.08em}.wrapper-attribution>summary strong{font-size:.96rem;line-height:1.45}.wrapper-attribution>summary i{position:relative;width:16px;height:16px;flex:0 0 16px}.wrapper-attribution>summary i::before,.wrapper-attribution>summary i::after{content:'';position:absolute;left:2px;right:2px;top:7px;height:1px;background:var(--color-text-muted)}.wrapper-attribution>summary i::after{transform:rotate(90deg);transition:transform .18s ease}.wrapper-attribution[open]>summary i::after{transform:rotate(0)}
  .wrapper-attribution__body{padding:2px 0 20px}.wrapper-attribution__lead,.wrapper-attribution__boundary{max-width:86ch;margin:0;font-size:.8rem;line-height:1.7}.wrapper-attribution__lead{color:var(--color-text)}.wrapper-attribution__boundary{color:var(--color-text-muted)}.wrapper-attribution__incident{max-width:86ch;margin:14px 0 0;padding:11px 14px;border-left:3px solid var(--color-danger);background:color-mix(in srgb,var(--color-danger) 5%,transparent);color:var(--color-text);font-size:.86rem;line-height:1.72}.wrapper-attribution__incident strong{color:var(--color-danger);font-weight:820}.wrapper-attribution__facts{max-width:900px;margin:16px 0 0;border-block:1px solid var(--color-border)}.wrapper-attribution__facts>div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:11px 0}.wrapper-attribution__facts>div+div{border-top:1px solid var(--color-border)}.wrapper-attribution__facts dt{color:var(--color-text-muted);font-size:.68rem;font-weight:800;letter-spacing:.03em}.wrapper-attribution__facts dd{margin:0;color:var(--color-text);font-size:.8rem;line-height:1.6}.wrapper-attribution__facts dd strong{font-size:.9rem;font-weight:820}.wrapper-attribution__timeline{margin-top:16px;border-top:1px solid var(--color-border)}.wrapper-attribution__timeline article{display:grid;grid-template-columns:132px minmax(0,1fr);gap:22px;padding:18px 0;border-bottom:1px solid var(--color-border)}.wrapper-attribution__index{display:grid;align-content:start;gap:5px}.wrapper-attribution__index span{color:var(--color-accent);font:700 .7rem ui-monospace,SFMono-Regular,Menlo,monospace}.wrapper-attribution__index small{color:var(--color-text-muted);font-size:.67rem;line-height:1.4}.wrapper-attribution__copy h4{margin:0 0 7px;font-size:.9rem;line-height:1.45}.wrapper-attribution__copy>p{margin:0;max-width:83ch;color:var(--color-text);font-size:.79rem;line-height:1.7}.wrapper-attribution__boundary{margin-top:16px}.wrapper-attribution__boundary strong{color:var(--color-text)}
  @media(max-width:720px){.wrapper-attribution{margin-inline:18px}.wrapper-attribution__timeline article,.wrapper-attribution__facts>div{grid-template-columns:1fr;gap:8px}.wrapper-attribution>summary{align-items:flex-start}}
</style>