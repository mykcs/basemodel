---
import { localePath, type Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const experimentTracks = [
  {
    id: 'matched',
    badge: t('最严格控制', 'Strictest control'),
    title: t('共同 Stage 1，再比较 Stage 2', 'Shared Stage 1, then compare Stage 2'),
    question: t('只把后续学习方法换掉，OpenEvo 还会更好吗？', 'If only the later learner changes, does OpenEvo still improve?'),
    stage1: t('同一 student rollout、同一外部 hindsight analyzer、同一 SFT checkpoint', 'Same student rollouts, same external hindsight analyzer, same SFT checkpoint'),
    stage2: t('从同一 checkpoint 分叉：SEED vs OpenEvo', 'Fork from the same checkpoint: SEED vs OpenEvo'),
    claim: t('支持 learner-level 因果对照；不把 harness / bootstrap 差异混进结论。', 'Supports a learner-level controlled comparison without mixing in harness/bootstrap differences.'),
  },
  {
    id: 'native',
    badge: 'OpenEvo-native',
    title: t('从第一条轨迹开始就用 OpenEvo', 'Use OpenEvo from the first trajectory'),
    question: t('作为一个完整系统，OpenEvo 自己采、自己选、自己学能做到多好？', 'How strong is OpenEvo as a complete native system that collects, selects, and learns from its own experience?'),
    stage1: t('OpenEvo harness + 本地 Qwen actor；不要求复制 SEED bootstrap', 'OpenEvo harness + local Qwen actor; no requirement to copy SEED bootstrap'),
    stage2: t('OpenEvo 原生持续演化', 'Native OpenEvo continual evolution'),
    claim: t('支持 full-system 比较；不能把差异全部归因于 Stage 2 learner。', 'Supports a full-system comparison; differences cannot all be attributed to the Stage-2 learner.'),
  },
  {
    id: 'nobootstrap',
    badge: t('效率支线', 'Efficiency arm'),
    title: t('跳过 Stage 1，直接自进化', 'Skip Stage 1 and evolve directly'),
    question: t('OpenEvo 是否根本不需要 1,440 条 teacher/bootstrap 经验？', 'Does OpenEvo need the 1,440-trajectory teacher/bootstrap phase at all?'),
    stage1: t('无', 'None'),
    stage2: t('从原始 student checkpoint 直接开始 OpenEvo', 'Start OpenEvo directly from the base student checkpoint'),
    claim: t('支持 sample-efficiency / bootstrap-necessity 讨论；预算必须单独列清。', 'Supports sample-efficiency/bootstrap-necessity claims, with budgets reported separately.'),
  },
  {
    id: 'analyzer',
    badge: t('教师消融', 'Analyzer ablation'),
    title: t('冻结同一批轨迹，只换 analyzer', 'Freeze trajectories and vary only the analyzer'),
    question: t('GLM / Kimi / MiniMax / thinking 设置究竟带来什么？', 'What is contributed by GLM, Kimi, MiniMax, or the thinking setting itself?'),
    stage1: t('同一 3B/7B student trajectories；一条完整轨迹对应一次 post-hoc analysis', 'Same 3B/7B student trajectories; one completed trajectory maps to one post-hoc analysis'),
    stage2: t('可先只产出 skills，再单独决定 downstream training treatment', 'Skills can be produced first; downstream training can be chosen as a separate treatment'),
    claim: t('支持 analyzer effect；不能把 teacher 变成 WebShop actor。', 'Supports analyzer-effect claims; the teacher must never become the WebShop actor.'),
  },
] as const;

const parameterRows = [
  ['Stage 1 actor temperature', '0.4', t('采样协议', 'sampling protocol'), t('180 × 8 的八次尝试要真的有多样性；旧 0.0 会把“8 次”退化成近似重复。', 'The eight attempts in 180 × 8 must actually explore; the old 0.0 setting made them near-duplicates.')],
  ['Stage 1 top-p / top-k', '1.0 / off', t('采样协议', 'sampling protocol'), t('显式冻结，避免 Qwen generation_config 的 0.8 / 20 偷偷接管。', 'Freeze explicitly so Qwen generation_config defaults such as 0.8 / 20 do not silently take over.')],
  ['repetition penalty', '1.0', t('采样协议', 'sampling protocol'), t('中性值；不让模型文件里的 1.05 成为隐藏变量。', 'Neutral value so the model file’s 1.05 does not become a hidden variable.')],
  ['max steps / output', '15 / 512', t('环境与生成预算', 'environment + generation budget'), t('保持 WebShop interaction horizon 与 completion budget 可审计。', 'Keeps the WebShop interaction horizon and completion budget auditable.')],
  ['history length', '2', t('交互协议', 'interaction protocol'), t('与 SEED 公共 WebShop Stage 1 设定对齐。', 'Aligned with the public SEED WebShop Stage-1 setting.')],
  ['rollout seeds', t('8 个不同且冻结', '8 distinct and frozen'), t('可复现探索', 'reproducible exploration'), t('3B/7B 使用同一 seed schedule；“随机”不等于“不可复现”。', '3B/7B share the same seed schedule; random does not mean irreproducible.')],
  ['malformed regeneration', '0', t('公平预算', 'fairness budget'), t('格式错不再给模型第二张彩票；API transport failure 与模型 malformed 必须分开。', 'Malformed output does not get a second lottery ticket; API transport failure and model malformation are separate states.')],
  ['Stage 2 actor temperature', '0.7', t('OpenEvo-native 设计', 'OpenEvo-native design'), t('不是 SEED 的 WebShop 官方值；它来自 OpenEvo-side on-policy prior，并与 SEED public veRL ~1.0 明确区分。', 'Not a SEED WebShop official value; it is an OpenEvo-side on-policy prior and is explicitly distinct from the public SEED/veRL ~1.0 path.')],
  ['Stage 2 update window', '256 rollouts', t('OpenEvo-native 设计', 'OpenEvo-native design'), t('当前 primary 的固定窗口；OpenEvo SD-LoRA 的 max_records=256 只说明训练记录规模，不等于官方规定“每 256 个 WebShop rollout 更新”。', 'Current fixed primary window; SD-LoRA max_records=256 describes training-record scale, not an official rule to update every 256 WebShop rollouts.')],
  ['Trajectory analyzer', 'T=0 · 1024 tokens', t('离线分析协议', 'offline analysis protocol'), t('一条 completed trajectory ≈ 一次 primary analyzer job；bounded transport / parse retry 单独记账。', 'One completed trajectory ≈ one primary analyzer job; bounded transport/parse retries are logged separately.')],
] as const;

const teacherModes = [
  {
    name: t('不请外部老师', 'No external teacher'),
    actor: t('本地 Qwen student', 'Local Qwen student'),
    when: t('不调用', 'Never'),
    output: t('只用 student 自产的 trajectory / clean success', 'Only student-generated trajectories / clean successes'),
    calls: '0',
    claim: t('OpenEvo 是否能 endogenous bootstrap', 'Whether OpenEvo can bootstrap endogenously'),
  },
  {
    name: t('SEED-style post-hoc analyzer', 'SEED-style post-hoc analyzer'),
    actor: t('本地 Qwen student', 'Local Qwen student'),
    when: t('episode 完成后', 'After episode completion'),
    output: 'episode_summary / episode_skill',
    calls: t('≈ 1 / trajectory', '≈ 1 / trajectory'),
    claim: t('外部 hindsight supervision 的价值', 'Value of external hindsight supervision'),
  },
  {
    name: 'OPSD privileged-distillation',
    actor: t('仍是 student on-policy actor', 'Student remains the on-policy actor'),
    when: t('对 student completion 做教师/学生双评分', 'Teacher/student score the same student completion'),
    output: t('token-level privileged distillation signal', 'token-level privileged distillation signal'),
    calls: t('按 completion / scoring contract 计', 'per completion/scoring contract'),
    claim: t('privileged teacher 是否改善 student 学习信号', 'Whether privileged teacher information improves student learning signal'),
  },
  {
    name: t('Step-level teacher actor', 'Step-level teacher actor'),
    actor: t('外部模型替 student 每步做题', 'External model acts for the student each step'),
    when: t('每个 WebShop step', 'Every WebShop step'),
    output: t('search[] / click[]', 'search[] / click[]'),
    calls: t('5–15 / trajectory', '5–15 / trajectory'),
    claim: t('不是 SEED-style analyzer 对照；会改变 actor', 'Not a SEED-style analyzer comparison; it changes the actor'),
  },
] as const;

const history = [
  {
    date: t('误区 01', 'Misread 01'),
    title: t('“Stage 1 应该只能用裸 WebShop harness”', '“Stage 1 should use only bare WebShop harness”'),
    verdict: t('被代码推翻', 'Overturned by code'),
    body: t('我们最初担心：如果 SEED 的 Stage 1 只是 Princeton WebShop 官方接口，而 OpenEvo 自己加了 harness，那么比较从第一步就不公平。重新读公开代码后，责任边界变清楚：SEED Stage 1 也通过 SEED / verl-agent 的模型侧 harness 组织 prompt、history、available actions 与 action projection。', 'We first worried that SEED Stage 1 used only Princeton WebShop while OpenEvo added its own harness, making the comparison unfair from the first step. Public code review clarified that SEED Stage 1 also uses a SEED / verl-agent model-facing harness for prompt, history, available actions, and action projection.'),
    inference: t('所以 OpenEvo-native 从自己的 harness 开始并不“天然作废”；它回答的是完整系统比较。若要只比较 learner，再补共同 Stage 1 的严格控制线。', 'Therefore an OpenEvo-native run is not invalid merely because it uses its own harness; it answers a full-system question. A shared Stage-1 control is required only for a learner-only comparison.'),
  },
  {
    date: t('误区 02', 'Misread 02'),
    title: t('“8 次 rollout 只要数量一样就公平”', '“Eight rollouts are fair as long as the count matches”'),
    verdict: t('被 temperature=0 暴露', 'Exposed by temperature=0'),
    body: t('旧 3B/7B 实验把 actor temperature 设成 0.0，同一 task 的 8 次尝试高度重复。账面上有 1,440 张“练习券”，信息量却远低于预期。', 'Old 3B/7B runs used actor temperature 0.0, so the eight attempts for a task were highly repetitive. The ledger said 1,440 practice tickets, but the information content was much lower than intended.'),
    inference: t('旧实验保留为 OpenEvo-native-greedy-v1 消融，但 sampled-v2 primary 改成 Stage 1 T=0.4，并冻结 top-p / top-k / seeds。', 'The old run remains useful as an OpenEvo-native-greedy-v1 ablation, while sampled-v2 primary uses Stage-1 T=0.4 with explicit top-p/top-k/seeds.'),
  },
  {
    date: t('误区 03', 'Misread 03'),
    title: t('“parser 可以帮模型兜底动作”', '“The parser can safely choose fallback actions for the model”'),
    verdict: t('被 clean-trajectory gate 否决', 'Rejected by clean-trajectory gate'),
    body: t('如果 malformed / inadmissible action 被 harness 自动替换成另一个可执行动作，成功轨迹里就混入了不是模型自己选的行为。', 'If a malformed or inadmissible action is replaced by a harness-chosen executable action, successful trajectories contain behavior the model did not choose.'),
    inference: t('确定性、无歧义的本地 repair 可以记录，但 fallback 不再替模型做题；真正 inadmissible action 直接终止 episode，且 repair/fallback 轨迹不能偷偷进入 clean-success training pool。', 'Unambiguous deterministic local repair can be logged, but fallback no longer acts for the model; genuinely inadmissible actions terminate the episode, and repaired/fallback trajectories cannot silently enter the clean-success training pool.'),
  },
  {
    date: t('事故 04', 'Incident 04'),
    title: t('“Kimi 当 external teacher”被实现成了每步 actor', '“Kimi as external teacher” was implemented as a step-level actor'),
    verdict: t('协议错误', 'Protocol-invalid'),
    body: t('外部 API 被放进 WebShop step loop：一条 episode 需要 5–15 次调用，额度快速消耗，而且 teacher 实际替 student 做题。', 'The external API was placed inside the WebShop step loop: one episode required 5–15 calls, rapidly consuming quota while the teacher effectively solved the task for the student.'),
    inference: t('SEED-style teacher 必须解耦：student 先完整完成 trajectory，再把整条轨迹一次性交给 analyzer。Kimi 的旧 step-level attempt 只保留为工程事故证据。', 'A SEED-style teacher must be decoupled: the student finishes the trajectory first, then the full trajectory is sent once to the analyzer. The old step-level Kimi attempt is retained only as engineering-incident evidence.'),
  },
  {
    date: t('修复 05', 'Repair 05'),
    title: t('固定 trajectory，把 analyzer 变成独立实验对象', 'Freeze trajectories and make the analyzer a separate experiment object'),
    verdict: t('当前推荐架构', 'Current recommended architecture'),
    body: t('3B 与 7B 的 Stage-1 student trajectories 可以独立冻结、哈希和复用。GLM、Kimi、MiniMax，甚至 MiniMax thinking ON/OFF 都可以读取同一批输入。', 'The Stage-1 student trajectories for 3B and 7B can be frozen, hashed, and reused independently. GLM, Kimi, MiniMax, and even MiniMax thinking ON/OFF can all read the exact same inputs.'),
    inference: t('WebShop rollout 与 trajectory analysis 从此是两个预算、两个 treatment；不再为了换老师重跑学生做题。', 'WebShop rollout and trajectory analysis become separate budgets and treatments; changing the analyzer no longer requires rerunning the student.'),
  },
] as const;
---

<article class="design-lab" data-training-decision-lab>
  <header class="design-hero">
    <div class="hero-kicker">SEED × OPENEVO · WEBSHOP</div>
    <h1>{t('WebShop 训练设计实验室', 'WebShop training design lab')}</h1>
    <p class="hero-dek">{t('这不是一份运行日志，而是一张“我们怎样把问题问清楚”的研究地图：谁真正做题、谁只复盘、哪些参数属于公平协议、哪些属于 OpenEvo 方法，以及每条实验分支究竟能支持什么结论。', 'This is not a run log. It is a research map of how the question was clarified: who actually acts, who only analyzes, which parameters belong to the fairness protocol, which belong to OpenEvo, and what each experimental branch can legitimately support.')}</p>
    <nav class="chapter-nav" aria-label={t('本页章节', 'Page chapters')}>
      <a href="#responsibility">{t('责任边界', 'Responsibility')}</a>
      <a href="#tracks">{t('实验路线', 'Experiment tracks')}</a>
      <a href="#parameters">{t('参数协议', 'Parameters')}</a>
      <a href="#history">{t('决策历史', 'Decision history')}</a>
      <a href="#teachers">{t('教师角色', 'Teacher roles')}</a>
      <a href="#decision">{t('最终决策树', 'Decision tree')}</a>
    </nav>
  </header>

  <section class="lab-section" id="responsibility" aria-labelledby="responsibility-title">
    <div class="section-heading"><span>01</span><div><small>{t('先分清谁负责什么', 'Start with ownership')}</small><h2 id="responsibility-title">{t('责任边界', 'Responsibility boundaries')}</h2></div></div>
    <p class="section-lede">{t('我们绕了很久才发现，很多“公平不公平”的争论其实不是模型问题，而是把 actor、harness、environment 和 analyzer 混成了一个黑盒。把它们拆开以后，Stage 1 立刻变得清楚。', 'Many fairness arguments turned out not to be model questions at all; they came from collapsing actor, harness, environment, and analyzer into one black box. Once separated, Stage 1 becomes much easier to reason about.')}</p>

    <figure class="responsibility-figure" aria-labelledby="responsibility-caption">
      <figcaption id="responsibility-caption">{t('正确的 Stage 1：先做题，再复盘', 'Correct Stage 1: act first, analyze after')}</figcaption>
      <div class="topology-grid">
        <article class="topology-node model"><small>ACTOR</small><strong>Qwen 3B / 7B</strong><span>{t('产生真实 WebShop action', 'produces real WebShop actions')}</span></article>
        <article class="topology-node harness"><small>HARNESS</small><strong>SEED / OpenEvo</strong><span>{t('prompt · history · action parser', 'prompt · history · action parser')}</span></article>
        <article class="topology-node environment"><small>ENVIRONMENT</small><strong>Princeton WebShop</strong><span>observation · score · transition</span></article>
        <article class="topology-node evidence"><small>SEALED EVIDENCE</small><strong>{t('完整 trajectory', 'completed trajectory')}</strong><span>task · steps · actions · outcome</span></article>
        <article class="topology-node analyzer"><small>OPTIONAL ANALYZER</small><strong>GLM / Kimi / MiniMax</strong><span>{t('episode 完成后读取一次', 'reads once after episode completion')}</span></article>
        <article class="topology-node persist"><small>PERSIST</small><strong>skill / adapter / checkpoint</strong><span>{t('供后续 bootstrap / Stage 2 使用', 'feeds later bootstrap / Stage 2')}</span></article>
        <svg class="topology-lines" viewBox="0 0 1200 260" role="img" aria-label={t('从 actor 到后续学习产物的数据流', 'Data flow from actor to learned output')}>
          <defs><marker id="design-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker></defs>
          <path d="M180 70 H320" />
          <path d="M420 70 H560" />
          <path d="M660 70 H800" />
          <path d="M900 70 C960 70 955 190 1010 190" />
          <path d="M1080 190 H1150" />
          <circle class="flow-pulse" cx="180" cy="70" r="5" />
        </svg>
      </div>
    </figure>

    <div class="wrong-right">
      <article class="protocol bad">
        <span>{t('错误层级', 'Wrong layer')}</span>
        <h3>{t('把外部老师放进 step loop', 'Put the teacher inside the step loop')}</h3>
        <ol><li>WebShop step 1 → external LLM</li><li>WebShop step 2 → external LLM</li><li>… 5–15 calls / episode</li></ol>
        <p>{t('teacher 变成 actor；API 消耗按 step 放大；不能叫 SEED-style trajectory analyzer。', 'The teacher becomes the actor; API usage scales with steps; this is not a SEED-style trajectory analyzer.')}</p>
      </article>
      <article class="protocol good">
        <span>{t('正确层级', 'Correct layer')}</span>
        <h3>{t('学生先完成整张卷子', 'The student finishes the whole exam first')}</h3>
        <ol><li>{t('Qwen 自己跑完整 episode', 'Qwen completes the episode')}</li><li>{t('trajectory 封存', 'trajectory is sealed')}</li><li>{t('analyzer 一次 post-hoc analysis', 'one post-hoc analyzer generation')}</li></ol>
        <p>{t('actor 与 analyzer 解耦；一条 trajectory ≈ 一次 analyzer 主调用。', 'Actor and analyzer are decoupled; one trajectory ≈ one primary analyzer call.')}</p>
      </article>
    </div>
  </section>

  <section class="lab-section" id="tracks" aria-labelledby="tracks-title">
    <div class="section-heading"><span>02</span><div><small>{t('不是只有一种“公平”', 'Fairness has more than one target')}</small><h2 id="tracks-title">{t('实验路线', 'Experiment tracks')}</h2></div></div>
    <p class="section-lede">{t('同一批 GPU 可以回答完全不同的问题。最重要的是先决定 claim，再决定该冻结哪些变量；不能先跑完，再给结果套一个更强的名字。', 'The same GPU budget can answer very different questions. Choose the claim first, then decide which variables must be frozen; do not run first and give the result a stronger label afterward.')}</p>
    <div class="track-grid">
      {experimentTracks.map((track) => (
        <details class="track" id={`track-${track.id}`}>
          <summary><span>{track.badge}</span><strong>{track.title}</strong><small>{track.question}</small></summary>
          <dl><div><dt>Stage 1</dt><dd>{track.stage1}</dd></div><div><dt>Stage 2</dt><dd>{track.stage2}</dd></div><div><dt>{t('能支持的结论', 'Supported claim')}</dt><dd>{track.claim}</dd></div></dl>
        </details>
      ))}
    </div>
    <aside class="claim-rule"><strong>{t('记住这个分界', 'Keep this boundary')}</strong><p>{t('“完整系统谁更强？”允许 SEED 和 OpenEvo 各用自己的 native harness；“只比较 learner 谁更强？”则应该共享 Stage 1 / bootstrap checkpoint，再从同一点分叉。', '“Which complete system is stronger?” may allow SEED and OpenEvo to use their native harnesses. “Which learner is stronger?” should share Stage 1 / the bootstrap checkpoint and fork only afterward.')}</p></aside>
  </section>

  <section class="lab-section" id="parameters" aria-labelledby="parameters-title">
    <div class="section-heading"><span>03</span><div><small>{t('把隐藏默认值变成显式协议', 'Turn hidden defaults into explicit protocol')}</small><h2 id="parameters-title">{t('参数协议', 'Parameter protocol')}</h2></div></div>
    <div class="table-wrap" tabindex="0">
      <table class="parameter-table">
        <thead><tr><th>{t('参数', 'Parameter')}</th><th>{t('冻结值', 'Frozen value')}</th><th>{t('归属', 'Owner')}</th><th>{t('为什么', 'Why')}</th></tr></thead>
        <tbody>{parameterRows.map((row) => <tr><td><code>{row[0]}</code></td><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>)}</tbody>
      </table>
    </div>
    <details class="deep-detail">
      <summary>{t('为什么 temperature=0 是这次最重要的参数事故？', 'Why was temperature=0 the most important parameter incident?')}</summary>
      <p>{t('180 个 task 每个做 8 次，本意是给同一道题 8 次略有不同的探索机会。greedy generation 让同一 task 的 8 条轨迹高度重复，于是“1,440 个 rollout”在数量上对齐、信息量却没有对齐。它不是“实验完全无效”，而是回答了另一条 greedy ablation。', 'Eight rollouts per task are meant to create eight slightly different exploration attempts. Greedy generation made those trajectories highly repetitive, so the nominal 1,440-rollout count matched while information content did not. The run was not meaningless; it became a greedy ablation instead of the sampled primary.')}</p>
    </details>
    <details class="deep-detail">
      <summary>{t('为什么 256 不是“SEED 官方更新频率”？', 'Why is 256 not an official SEED update cadence?')}</summary>
      <p>{t('OpenEvo 官方 SD-LoRA 的 max_records=256 说明一次参数写入最多吃多少训练记录；它不等价于“WebShop 每收 256 条 rollout 就必须更新一次”。当前 256-window 是 OpenEvo-native treatment，需要和 128/256 adaptive 方案分开报告。', 'OpenEvo SD-LoRA max_records=256 limits training records for one parameter-write step; it does not mean WebShop must update every 256 rollouts. The current 256-window is an OpenEvo-native treatment and should be reported separately from a future adaptive 128/256 design.')}</p>
    </details>
  </section>

  <section class="lab-section" id="history" aria-labelledby="history-title">
    <div class="section-heading"><span>04</span><div><small>{t('把失败保存成推理，而不是垃圾桶', 'Keep failures as reasoning, not clutter')}</small><h2 id="history-title">{t('决策历史', 'Decision history')}</h2></div></div>
    <ol class="belief-timeline">
      {history.map((item, index) => (
        <li>
          <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <div class="timeline-main"><div class="timeline-meta"><b>{item.date}</b><em>{item.verdict}</em></div><h3>{item.title}</h3><p>{item.body}</p><details><summary>{t('这一步改变了什么决策？', 'What decision changed here?')}</summary><p>{item.inference}</p></details></div>
        </li>
      ))}
    </ol>
    <div class="artifact-status">
      <article><strong>OpenEvo-native-greedy-v1</strong><span>{t('保留为 sampling ablation；不再当 sampled-v2 primary。', 'Keep as a sampling ablation; no longer sampled-v2 primary.')}</span></article>
      <article><strong>Kimi step-level gateway</strong><span>{t('协议无效的 SEED-style teacher 对照；只保留工程事故证据。', 'Protocol-invalid as a SEED-style teacher comparison; retain only as engineering-incident evidence.')}</span></article>
      <article><strong>{t('fallback-enabled trajectories', 'fallback-enabled trajectories')}</strong><span>{t('可用于 parser 诊断；不能把 harness 代选动作冒充 clean student experience。', 'Useful for parser diagnostics; harness-chosen actions are not clean student experience.')}</span></article>
    </div>
  </section>

  <section class="lab-section" id="teachers" aria-labelledby="teachers-title">
    <div class="section-heading"><span>05</span><div><small>{t('老师可以有很多种，但层级不能错', 'Teachers can differ; the layer cannot')}</small><h2 id="teachers-title">{t('教师角色', 'Teacher roles')}</h2></div></div>
    <div class="table-wrap" tabindex="0">
      <table class="teacher-table">
        <thead><tr><th>{t('方案', 'Mode')}</th><th>{t('谁在 WebShop 做题？', 'Who acts in WebShop?')}</th><th>{t('老师何时出现？', 'When is the teacher called?')}</th><th>{t('老师产出什么？', 'Teacher output')}</th><th>{t('API 量级', 'API scale')}</th><th>{t('主要问题', 'Scientific question')}</th></tr></thead>
        <tbody>{teacherModes.map((mode, index) => <tr class:list={[{ invalid: index === 3 }]}><th>{mode.name}</th><td>{mode.actor}</td><td>{mode.when}</td><td>{mode.output}</td><td>{mode.calls}</td><td>{mode.claim}</td></tr>)}</tbody>
      </table>
    </div>

    <div class="api-ledger">
      <div class="api-figure">
        <span>{t('正确的 SEED-style analyzer 预算', 'Correct SEED-style analyzer budget')}</span>
        <strong>180 × 8 = 1,440</strong>
        <p>{t('每个 student 模型约 1,440 条 completed trajectories ≈ 1,440 个 primary analyzer jobs。3B + 7B 合计约 2,880，不乘 trajectory step 数。', 'Per student model, 1,440 completed trajectories ≈ 1,440 primary analyzer jobs. 3B + 7B is about 2,880 total, not multiplied by trajectory steps.')}</p>
      </div>
      <div class="api-figure wrong-cost"><span>{t('错误的 step-level actor 预算', 'Wrong step-level actor budget')}</span><strong>2,880 × 5–15</strong><p>{t('这就是早期 Kimi 消耗异常的根因：API 被放在错的层级。', 'This is why early Kimi usage exploded: the API lived at the wrong layer.')}</p></div>
    </div>

    <section class="thinking-study" aria-labelledby="thinking-title">
      <header><small>ANALYZER ABLATION</small><h3 id="thinking-title">MiniMax-M3 thinking ON / OFF</h3><p>{t('同一批 10 条 trajectory 做配对 qualification：127 个 student actions，两边都只产生 10 次 primary analyzer generation。', 'Paired qualification on the same 10 trajectories: 127 student actions, but only 10 primary analyzer generations in either mode.')}</p></header>
      <div class="thinking-grid">
        <article><span>OFF</span><strong>35,029 tokens</strong><dl><div><dt>parse</dt><dd>10 / 10</dd></div><div><dt>latency</dt><dd>33.3 s</dd></div><div><dt>reasoning</dt><dd>disabled</dd></div></dl></article>
        <article class="primary"><span>ON · PRIMARY</span><strong>38,149 tokens</strong><dl><div><dt>parse</dt><dd>10 / 10</dd></div><div><dt>latency</dt><dd>91.1 s</dd></div><div><dt>reasoning</dt><dd>adaptive + split</dd></div></dl></article>
      </div>
      <p class="thinking-note">{t('ON 总 token 只增加约 8.9%，但 completion tokens 约 2.86×、latency 约 2.74×；10 对 skill 中 0 对完全相同。ON 被选为 primary，因为 SEED 的公开 GLM-5.2 analyzer 没显式关闭 reasoning，而 GLM-5.2 官方 README 把 reasoning_effort 默认记为 max。', 'ON increased total tokens by only about 8.9%, but completion tokens were about 2.86× and latency about 2.74×; 0 of 10 paired skills were identical. ON is primary because the public SEED GLM-5.2 analyzer does not explicitly disable reasoning, while the official GLM-5.2 README documents default reasoning_effort as max.')}</p>
      <details><summary>{t('证据边界：我们知道什么、不知道什么？', 'Evidence boundary: what do we know and not know?')}</summary><p>{t('公开代码能证明 SEED 传了 temperature=0、max_completion_tokens=1024，并没有显式 thinking-off；GLM-5.2 官方模型说明能证明 reasoning_effort 的公开默认。但我们没有论文作者当时线上托管 endpoint 的历史服务端快照，所以不会把 provider-side 默认说成法证级确定事实。', 'Public code proves SEED passed temperature=0 and max_completion_tokens=1024 without an explicit thinking-off override; the GLM-5.2 model documentation provides its public reasoning default. We do not have a forensic snapshot of the exact hosted endpoint used by the authors, so we do not overstate provider-side historical certainty.')}</p></details>
    </section>
  </section>

  <section class="lab-section" id="fairness" aria-labelledby="fairness-title">
    <div class="section-heading"><span>06</span><div><small>{t('同样的练习券，不等于同样的信息量', 'Same practice tickets do not mean same information')}</small><h2 id="fairness-title">{t('公平预算', 'Fairness ledger')}</h2></div></div>
    <div class="budget-lanes">
      <article><span>{t('环境预算', 'Environment')}</span><strong>21,920 rollouts</strong><p>1,440 Stage 1 + 20,480 Stage 2</p></article>
      <article><span>{t('教师预算', 'Teacher / API')}</span><strong>{t('单独记账', 'Log separately')}</strong><p>jobs · prompt/completion tokens · retries · latency</p></article>
      <article><span>{t('训练预算', 'Optimization')}</span><strong>{t('单独记账', 'Log separately')}</strong><p>optimizer steps · replay exposures · GPU-hours</p></article>
    </div>
    <p class="section-lede compact">{t('“双方都是 21,920 rollouts”只能证明 environment-interaction budget 对齐，不能证明 teacher 信息量、训练 FLOPs、token 数或更新次数相同。把三个账本同时报告，结论才不会偷偷跨层。', '“Both sides use 21,920 rollouts” establishes only matched environment interaction. It does not imply equal teacher information, training FLOPs, tokens, or update count. Report all three ledgers so claims do not silently cross layers.')}</p>
  </section>

  <section class="lab-section decision-section" id="decision" aria-labelledby="decision-title">
    <div class="section-heading"><span>07</span><div><small>{t('先选结论，再选实验', 'Choose the claim before the run')}</small><h2 id="decision-title">{t('最终决策树', 'Final decision tree')}</h2></div></div>
    <p class="section-lede">{t('点击你真正想回答的问题。下面的路线不会自动替你“选最强模型”，它只告诉你该控制哪些变量，以及这条实验结束后最多能说到哪里。', 'Choose the question you actually want to answer. The route does not pick a “best model”; it tells you which variables must be controlled and how strong the resulting claim can be.')}</p>
    <div class="claim-picker" role="tablist" aria-label={t('研究问题选择', 'Research question selector')}>
      <button type="button" role="tab" aria-selected="true" data-claim="system">{t('完整系统谁更强？', 'Which full system is stronger?')}</button>
      <button type="button" role="tab" aria-selected="false" data-claim="learner">{t('只比较 Stage 2 learner？', 'Compare Stage-2 learner only?')}</button>
      <button type="button" role="tab" aria-selected="false" data-claim="teacher">{t('外部 hindsight teacher 有用吗？', 'Does an external hindsight teacher help?')}</button>
      <button type="button" role="tab" aria-selected="false" data-claim="bootstrap">{t('Stage 1 可以省掉吗？', 'Can Stage 1 be removed?')}</button>
      <button type="button" role="tab" aria-selected="false" data-claim="thinking">{t('thinking 改变 analyzer 吗？', 'Does thinking change the analyzer?')}</button>
    </div>
    <div class="claim-panels">
      <section data-claim-panel="system"><strong>{t('路线：Native vs Native', 'Route: Native vs Native')}</strong><p>{t('SEED 用自己的 harness，OpenEvo 也用自己的 harness；匹配 task schedule、environment budget、eval panel。结果回答“哪个完整系统更强”，而不是“哪个 Stage 2 learner 更强”。', 'SEED uses its native harness and OpenEvo uses its native harness; match task schedule, environment budget, and eval panel. The result answers which complete system is stronger, not which Stage-2 learner is stronger.')}</p></section>
      <section data-claim-panel="learner" hidden><strong>{t('路线：共同 Stage 1 checkpoint 后分叉', 'Route: Fork after a shared Stage-1 checkpoint')}</strong><p>{t('共享 student trajectory、analyzer、SFT recipe 与 checkpoint，然后才分成 SEED Stage 2 / OpenEvo Stage 2。', 'Share student trajectories, analyzer, SFT recipe, and checkpoint; only then fork into SEED Stage 2 vs OpenEvo Stage 2.')}</p></section>
      <section data-claim-panel="teacher" hidden><strong>{t('路线：冻结同一批 student trajectories，只换 analyzer', 'Route: Freeze student trajectories and vary only the analyzer')}</strong><p>{t('例如 MiniMax thinking ON/OFF，或 GLM/MiniMax；API 必须是 post-hoc trajectory analyzer，不能进 WebShop step loop。', 'For example MiniMax thinking ON/OFF or GLM/MiniMax; the API must be a post-hoc trajectory analyzer and must never enter the WebShop step loop.')}</p></section>
      <section data-claim-panel="bootstrap" hidden><strong>{t('路线：No-bootstrap arm', 'Route: No-bootstrap arm')}</strong><p>{t('从原始 checkpoint 直接进入 OpenEvo。把少用的 1,440 个 rollout 明确记为 sample-efficiency 差异，而不是假装预算完全一样。', 'Start OpenEvo directly from the base checkpoint. Treat the missing 1,440 rollouts explicitly as a sample-efficiency difference rather than pretending budgets are identical.')}</p></section>
      <section data-claim-panel="thinking" hidden><strong>{t('路线：严格配对 analyzer ablation', 'Route: Paired analyzer ablation')}</strong><p>{t('同一个 trajectory_id 同时送给 thinking ON 与 OFF；比较 parse、tokens、latency、skill 内容，再决定是否把两份都扩到完整 2,880 jobs。', 'Send each identical trajectory_id to both thinking ON and OFF; compare parsing, tokens, latency, and skill content before deciding whether both arms deserve a full 2,880-job run.')}</p></section>
    </div>
  </section>

  <footer class="design-footer">
    <div><strong>{t('继续理解', 'Keep learning')}</strong><a href={p('/research/seed-openevo/flow/seed/')}>{t('SEED 方法', 'SEED method')}</a><a href={p('/research/seed-openevo/flow/openevo/')}>OpenEvo</a></div>
    <div><strong>{t('继续执行', 'Continue to execution')}</strong><a href={p('/research/seed-openevo/study/run/')}>{t('打开运行指南', 'Open run guide')}</a><a href={p('/research/seed-openevo/study/results/')}>{t('查看研究结果', 'View findings')}</a></div>
  </footer>
</article>

<script>
  const roots = document.querySelectorAll('[data-training-decision-lab]');
  roots.forEach((root) => {
    const buttons = Array.from(root.querySelectorAll('[data-claim]'));
    const panels = Array.from(root.querySelectorAll('[data-claim-panel]'));
    buttons.forEach((button) => button.addEventListener('click', () => {
      const claim = button.getAttribute('data-claim');
      buttons.forEach((candidate) => candidate.setAttribute('aria-selected', String(candidate === button)));
      panels.forEach((panel) => { panel.hidden = panel.getAttribute('data-claim-panel') !== claim; });
    }));
  });
</script>

