---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import OpenEvoHarnessFairnessPanel from './OpenEvoHarnessFairnessPanel.astro';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchDepth from './ResearchDepth.astro';
import { OPEN_EVO_EVIDENCE_LINKS, OPEN_EVO_Q17_FINAL, OPEN_EVO_STAGE1_FREEZE, OPEN_EVO_STAGE1_METRICS } from '../../data/openEvoSuccessorNarrative';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const links = {
  gateway: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/'),
  exploration: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/exploration/'),
  archive: p('/research/seed-openevo/study/capability-exploration/archive/'),
};
const arm3 = OPEN_EVO_STAGE1_METRICS[0];
const arm17 = OPEN_EVO_STAGE1_METRICS[1];
const final17 = OPEN_EVO_Q17_FINAL;
const terms = zh ? [
  { term: 'shared Harness', meaning: '两个模型共用的环境接口规则；允许合法 WebShop 动作，但不给购物解题策略。' },
  { term: 'raw Stage1', meaning: '模型还没有消费 learned carriers 时自己采出的第一批 1,440 条正式轨迹。' },
  { term: 'MiniMax post-hoc', meaning: '轨迹封存以后才做的外部批改分析；不替模型在线点网页。' },
  { term: 'carrier', meaning: '把已封存证据带入后续学习的结构，例如 adapter、Memory、Skill、Agent；不能提前泄漏回 raw Stage1。' },
] : [
  { term: 'shared harness', meaning: 'One environment interface shared by both models. It permits legal WebShop actions without supplying a shopping strategy.' },
  { term: 'raw Stage 1', meaning: 'The first 1,440 formal trajectories collected by each model before any learned carrier is consumed.' },
  { term: 'MiniMax post hoc', meaning: 'External review that begins only after trajectories are sealed; it never clicks WebShop for the model.' },
  { term: 'carrier', meaning: 'A structure that carries sealed evidence into later learning, such as adapter, Memory, Skill, or Agent; it cannot leak backward into raw Stage 1.' },
];
---
<main class="report-map" data-testid="openevo-successor-report">
  <ResearchOrientation
    locale={locale}
    eyebrow="REPORT / PAPER VIEW · STAGE 1 → QWEN3-1.7B FINAL CLOSEOUT"
    title={t("3B 与 1.7B 购物学习实验", "3B and 1.7B learning results")}
    lede={t("两种模型按相同购物规则收集经验，再分别学习。初始成绩、学习过程和最终测试分开记录。", "Shared shopping rules, separate learning. Compare initial scores and final evaluation.")}
    question={t("购物经验能否改善模型后来的表现？", "Can shopping experience improve later behavior?")}
    why={t("统一接口并记录各自起点，才能结合起点解释后续变化。", "Use one interface and record each starting point to interpret later changes.")}
    start={t("每种模型先完成 1,440 次购物尝试，保存初始经验。", "Each model first completes 1,440 shopping attempts to collect initial experience.")}
    finish={t("1.7B 后续学习完成 160 轮、20,480 次尝试后，固定模型测试 128 题。", "1.7B: 160 learning rounds (20,480 attempts), then a fixed 128-task test.")}
    state={t("1.7B 测试 37.60 分、1/128 次完全成功；3B 尚未同口径收口。", "1.7B: 37.60 points, 1/128 exact successes. 3B has no matched final result.")}
    stateTone="sealed"
    backHref={links.gateway}
    backLabel={t('两种读法', 'Two reading modes')}
    actionHref="#report-mainline"
    actionLabel={t('查看实验怎样进行', 'Read how the experiment worked')}
    terms={terms}
  />

  <nav class="report-map__switch" aria-label={t('切换叙事版本', 'Switch narrative view')}>
    <a href={links.exploration}>{t('← 看真实探索过程', '← Read the exploration history')}</a>
    <b>{t('当前：报告与论文版', 'Current: Report / paper')}</b>
  </nav>

  <section class="report-chronology" aria-labelledby="report-chronology-title">
    <h2 id="report-chronology-title">{t('实验阶段与结果位置', 'Experimental stages and results')}</h2>
    <table><thead><tr><th>{t('阶段', 'Stage')}</th><th>{t('做什么', 'Activity')}</th><th>{t('何时结束', 'Completion')}</th></tr></thead><tbody>
    <tr><th>{t('初始经验', 'Initial experience')}</th><td>{t('模型各自完成购物，再分析已有记录', 'Each model shops independently; records are analyzed afterwards')}</td><td>{t('每种模型的 1,440 次尝试固定保存，学习材料通过准备检查', 'Each set of 1,440 attempts is frozen and the learning materials pass readiness checks')}</td></tr>
    <tr><th>{t('后续学习', 'Later learning')}</th><td>{t('独立授权后，用经验继续更新模型', 'After separate authorization, use experience to update the model')}</td><td>{t('1.7B 完成 160 轮、20,480 次尝试后结束；3B 尚未同口径收口', '1.7B stops after 160 rounds / 20,480 attempts; 3B has no matched closeout')}</td></tr>
    <tr><th>{t('最终测试', 'Final evaluation')}</th><td>{t('固定最终模型，完成预定的 128 道测试任务', 'Freeze the final model and evaluate on the predefined 128 tasks')}</td><td>{t('核对有效记录后发布分数；测试期间不继续学习', 'Publish scores after validating the records; no learning continues during evaluation')}</td></tr>
    </tbody></table>
  </section>
  <section class="report-hero" aria-labelledby="report-result-title">
    <div class="report-hero__question">
      <span>RESEARCH QUESTION</span>
      <h2 id="report-result-title">{t('初始购物结果', 'Initial shopping results')}</h2>
      <p>{t(`冻结 ${OPEN_EVO_STAGE1_FREEZE.id} 后，两个模型都使用同一套不教具体解法的购物接口，各自完成 ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} 次购物尝试。`, `Under freeze ${OPEN_EVO_STAGE1_FREEZE.id}, both models use one strategy-neutral bootstrap harness and each produces ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} raw trajectories.`)}</p>
    </div>
    <div class="report-hero__metrics">
      <article data-arm={arm3.id}><span>{arm3.model}</span><strong>{arm3.exact} / {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong><b>{arm3.exactRate} {t("完全成功率", "exact success")}</b><small>{arm3.positive} / {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} {t('条有正分', 'positive trajectories')} · {arm3.exactTaskIdentities} {t('道不同任务曾完全成功', 'distinct exact-success tasks')}</small></article>
      <article data-arm={arm17.id}><span>{arm17.model}</span><strong>{arm17.exact} / {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong><b>{arm17.exactRate} {t("完全成功率", "exact success")}</b><small>{arm17.positive} / {OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} {t('条有正分', 'positive trajectories')} · {arm17.exactTaskIdentities} {t('道不同任务曾完全成功', 'distinct exact-success tasks')}</small></article>
    </div>
    <aside><strong>{t('解释边界：', 'Interpretation boundary:')}</strong>{t(' 1.7B 在这套规则下的初始成功率更高。这是本实验学习前的差异；后续学习提升了多少，要另做对照。仅凭这组数据也不能断定所有任务上 1.7B 都强于 3B。', ' the 1.7B arm has a clearly higher raw Stage-1 starting point, but this establishes only a bootstrap difference under the shared harness. It is not a Stage-2 learning gain or causal proof that 1.7B is generally stronger than 3B.')}</aside>
  </section>

  <section class="q17-final" data-testid="qwen3-1p7b-final-closeout" aria-labelledby="q17-final-title">
    <header>
      <p>QWEN3-1.7B · SEALED STAGE 2 → FIXED FINAL PANEL</p>
      <h2 id="q17-final-title">{t('1.7B 已完成最终考试；3B 仍未进入同一收口阶段', 'The 1.7B arm has completed its final exam; 3B has not reached the same closeout stage')}</h2>
      <span>{t('最终测试使用预先固定的 128 道任务，在模型完成学习后进行。它与最后一轮学习过程中记录的成绩分开计算。', 'Final evaluation uses the predefined set of 128 tasks after learning is complete; it is not the R159 training trajectory score.')}</span>
    </header>
    <p data-learning-completion>{t(`学习材料准备完成并另获授权后，1.7B 继续完成 ${final17.stage2.rounds} 轮、${final17.stage2.rollouts.toLocaleString()} 次尝试，产生 ${final17.stage2.acceptedParametricUpdates} 次被接受的参数更新。随后固定最终模型，完成 ${final17.finalEval.tasks} 道预定测试任务；测试期间不继续学习。完成学习并不等于已经证明稳定提升。`, `After material preparation and a separate release, 1.7B completed ${final17.stage2.rounds} learning rounds and ${final17.stage2.rollouts.toLocaleString()} attempts, with ${final17.stage2.acceptedParametricUpdates} accepted parameter updates. The final model was then frozen for ${final17.finalEval.tasks} predefined evaluation tasks, with no learning during evaluation. Completing training does not by itself prove stable improvement.`)}</p>
    <p data-final-score-meaning>{t("平均分反映任务完成程度，完全成功次数只统计完整完成的任务。因此可以有 37.60/100 的平均分，却只有 1/128 次完全成功；两者不是同一种量。", "Mean score measures degree of task completion; exact-success count includes only fully completed tasks. A mean of 37.60/100 can therefore coexist with 1/128 exact successes. These measure different things.")}</p>
    <div class="q17-final__metrics">
      <article><span>{t("最终测试分数", "OpenEVO FINAL SCORE")}</span><strong>{final17.finalEval.score.toFixed(2)}</strong><small>{t('固定 128 道测试任务 · 任务分数 ×100', 'Fixed 128-task panel · Task Score ×100')}</small></article>
      <article><span>{t("完全成功率", "OpenEVO SUCCESS")}</span><strong>{final17.finalEval.successPercent.toFixed(2)}%</strong><small>{final17.finalEval.exactSuccesses} / {final17.finalEval.tasks} {t("次完全成功", "exact successes")}</small></article>
      <article><span>{t("SEED 外部参考值", "SEED REFERENCE")}</span><strong>{final17.seedReference.score.toFixed(1)}</strong><small>{final17.seedReference.successPercent.toFixed(1)}% {t("完全成功率", "success")} · {t('项目预先固定的外部参考值', 'project-frozen reference')}</small></article>
      <article><span>{t("已完成学习轮次", "STAGE 2 SEALED")}</span><strong>{final17.stage2.rounds} / {final17.stage2.rounds}</strong><small>{final17.stage2.rollouts.toLocaleString()} {t("次学习过程中的任务尝试", "training rollouts")} · {final17.stage2.acceptedParametricUpdates} {t('次参数更新', 'parametric updates')}</small></article>
    </div>
    <div class="q17-final__comparison">
      <p><b>{t('对照数值之差', 'Reference-value difference')}:</b> OpenEVO − SEED = <strong>{final17.delta.scorePoints.toFixed(2)}</strong> {t('分', 'score points')} · <strong>{final17.delta.successPercentagePoints.toFixed(2)} {t('个百分点', 'pp')}</strong>.</p>
      <p data-reference-boundary>{t("SEED 数字是项目预先固定的外部参考值，不是从本次 OpenEvo 最终测试中得到的配对对照。以上差值不能单独归因于方法优劣。", "The SEED figures are external reference values frozen for this project, not paired controls from this OpenEvo final evaluation. Their differences cannot by themselves establish a method effect.")}</p>
      <p><b>{t('口径保护', 'Metric guardrail')}:</b> R159 = {final17.stage2.finalTrainingTrajectoryScore.toFixed(2)} {t('是最后一轮学习过程中的成绩，不是最终测试分数；两者分别记录，不能直接相减。', 'is only the last on-policy training trajectory score, not the final evaluation; the two must not be directly subtracted.')}</p>
    </div>
    <details>
      <summary>{t('最终测试中的故障与重新核验', 'Open final-panel recovery disclosure')}</summary>
      <p>{t('第一次 final-panel exposure 使用了过时的 final worker：模型实际输出了 action，但旧 parser 强制要求 <think>，因此 128/128 在第 0 步被接口拦下、环境 step=0。这次结果被标记为 engineering-invalid，不计作模型 0 分。随后只用 4 个非-final 任务做 score-blind Harness201.1 资格测试（4/4 interface-valid、0 repair），再对同一个 frozen final state、同一个 deterministic panel 做一次有效 remeasurement。有效结果为 128/128 valid、0 interface failure、0 repair、0 engineering invalid。', 'The first final-panel exposure used an obsolete final worker: the model emitted actions, but the old parser required a <think> tag, so all 128 rows were blocked at step 0 with zero environment steps. That attempt is retained as engineering-invalid, not a model score of zero. A score-blind Harness201.1 qualification then passed on four non-final tasks (4/4 interface-valid, 0 repairs) before one valid remeasurement of the same frozen final state on the same deterministic panel. The valid result has 128/128 valid rows, 0 interface failures, 0 repairs, and 0 engineering invalids.')}</p>
      <p>{t(`最终参数状态在 R49 后未再改变；7 次 accepted parametric update 的累计参数变化第一主方向解释约 ${final17.parameterGeometry.top1EnergySharePercent.toFixed(2)}% 能量，95% 能量约需 ${final17.parameterGeometry.rank95} 个方向。`, `The final parameter state stopped changing after R49; across seven accepted parametric updates, the first cumulative parameter direction explains about ${final17.parameterGeometry.top1EnergySharePercent.toFixed(2)}% of the energy, and about ${final17.parameterGeometry.rank95} directions cover 95% of it.`)}</p>
      <a href={OPEN_EVO_EVIDENCE_LINKS.qwen3FinalCloseoutPr} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.qwen3FinalCloseoutPr} />PR #348 · final closeout evidence</a>
    </details>
  </section>

  <section id="report-mainline" class="paper-spine" data-research-journey aria-label={t('论文式线性实验主线', 'Linear paper-style experiment mainline')}>
    <article data-paper-step="harness" data-research-step="harness">
      <div class="paper-step__index"><span>01</span><b>HARNESS</b></div>
      <div class="paper-step__body">
        <h2>{t('共享购物规则', 'Shared shopping rules')}</h2>
        <p class="paper-step__meaning">{t("两种模型都能看到购物要求、当前页面、最近的动作和现在可点击的按钮。接口负责把动作按规定格式送到商店，模型自己决定买什么、怎样找。", "Both models see the request, current page, recent actions, and available buttons. The interface sends actions to the shop in the required format; the model decides what to buy and how to find it.")}</p>
        <p class="paper-step__meaning">{t("这样可以比较同一套规则下的行为。通用动作格式和思考提示仍属于实验条件；它们没有提供具体购物策略。", "This compares behavior under a shared set of rules. The generic action format and reasoning prompt remain experimental conditions; they provide no task-specific shopping strategy.")}</p>
        <details class="paper-step__technical"><summary>{t('方法与检查记录', 'Method and verification record')}</summary><dl><div><dt>{t("操作","Action")}</dt><dd>{t('两个 arm 都看到 task、当前 observation、recent history 和当前 Allowed actions；action 用 hard envelope，action opener 由接口拥有；action 前保留模型自己写的短 reasoning。', 'Both arms receive the task, current observation, recent history, and current Allowed actions; actions use a hard envelope with an interface-owned opener, while brief pre-action reasoning remains model-authored.')}</dd></div><div><dt>{t("理由","Reason")}</dt><dd>{t('把“模型不会做题”和“模型想做合法动作却被 serialization 弄坏”分开；同时不为某个 model ID 加私有购物策略。', 'Separate task inability from serialization-induced invalidity, without giving either model ID a private shopping strategy.')}</dd></div><div><dt>{t("记录","Record")}</dt><dd>{t(`freeze ${OPEN_EVO_STAGE1_FREEZE.id}；T=${OPEN_EVO_STAGE1_FREEZE.temperature}、top_p=${OPEN_EVO_STAGE1_FREEZE.topP}、top_k=${OPEN_EVO_STAGE1_FREEZE.topK}、max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}；raw Stage1 learned carriers=none、teacher action calls=0。`, `Freeze ${OPEN_EVO_STAGE1_FREEZE.id}; T=${OPEN_EVO_STAGE1_FREEZE.temperature}, top_p=${OPEN_EVO_STAGE1_FREEZE.topP}, top_k=${OPEN_EVO_STAGE1_FREEZE.topK}, max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}; raw Stage-1 learned carriers=none and teacher action calls=0.`)}</dd></div><div><dt>{t("适用范围","Scope")}</dt><dd>{t('这不是“零脚手架”。hard action envelope 与通用 deliberation 都是实验条件；它们不提供 task-solving policy。', 'This is not “zero scaffolding.” The hard action envelope and generic deliberation are experimental conditions; they do not provide a task-solving policy.')}</dd></div></dl></details>
        <details><summary>{t('展开设计形成证据', 'Open design-formation evidence')}</summary><p>{t('paired diagnostics 先分别检查 sampling、history、self-deliberation 与 action serialization；temperature-only 与 history-only 都不足以解释行为恢复，最终候选才进入 shared freeze。', 'Paired diagnostics separately examined sampling, history, self-deliberation, and action serialization. Temperature-only and history-only explanations were insufficient before the final candidate entered the shared freeze.')}</p><a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Troubleshooting} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Troubleshooting} />diagnosis case</a></details>
      </div>
    </article>
    <span class="paper-connector"></span>

    <article data-paper-step="raw-stage1" data-research-step="raw-stage1">
      <div class="paper-step__index"><span>02</span><b>RAW STAGE 1</b></div>
      <div class="paper-step__body">
        <h2>{t('独立收集购物经验', 'Independent experience collection')}</h2>
        <p class="paper-step__meaning">{t("每种模型分别做 180 道任务，每道尝试 8 次，一共 1,440 次。一次尝试从收到购物要求开始，到购买、步数用尽或触发终止条件结束。", "Each model makes eight attempts on each of 180 tasks, for 1,440 attempts. An attempt starts with a request and ends at purchase, the step limit, or another termination condition.")}</p>
        <p class="paper-step__meaning">{t("两种模型各自产生自己的记录。检查任务覆盖、动作记录和来源之后，才把这批记录固定下来供分析；数据完整不代表购物成功。", "The models produce separate records. Task coverage, action records, and provenance are checked before the corpus is frozen for analysis. Complete records do not imply successful shopping.")}</p>
        <details class="paper-step__technical"><summary>{t('方法与检查记录', 'Method and verification record')}</summary><dl><div><dt>{t("操作","Action")}</dt><dd>{t('Qwen2.5-3B 与 Qwen3-1.7B 分别执行完整 WebShop schedule，不共享 trajectory，也不把 qualification rows 算进 formal corpus。', 'Qwen2.5-3B and Qwen3-1.7B independently execute the full WebShop schedule; trajectories are not shared and qualification rows are not counted inside the formal corpus.')}</dd></div><div><dt>{t("理由","Reason")}</dt><dd>{t('新的 action channel 会改变 on-policy trajectory，所以旧 3B 轨迹只能作为 predecessor evidence，不能改名接到 successor。', 'The new action channel changes on-policy trajectories, so old 3B data can remain predecessor evidence but cannot be relabeled into the successor.')}</dd></div><div><dt>{t("记录","Record")}</dt><dd>{t('两个 canonical corpus 都达到 1,440；raw corpus gate 先验证 coverage、mechanics 与 provenance，而不是先要求 reward 达标。', 'Both canonical corpora reach 1,440; the raw-corpus gate validates coverage, mechanics, and provenance rather than imposing a reward threshold.')}</dd></div><div><dt>{t("适用范围","Scope")}</dt><dd>{t('raw corpus PASS 只说明这批数据可以被科学地解释，不等于模型已经“学会 WebShop”。', 'Raw-corpus PASS means the data are scientifically interpretable; it does not mean the model has already “learned WebShop.”')}</dd></div></dl></details>
      </div>
    </article>
    <span class="paper-connector"></span>

    <article data-paper-step="behavior" data-research-step="behavior">
      <div class="paper-step__index"><span>03</span><b>BOOTSTRAP SIGNAL</b></div>
      <div class="paper-step__body">
        <h2>{t('本实验学习前的能力', 'Ability before learning in this experiment')}</h2>
        <p class="paper-step__meaning">{t("我们先数本实验学习前已经能完整做对的尝试，也记录只满足部分要求的尝试。上方的初始结果对应这一阶段。", "We count attempts that already meet every requirement before learning in this experiment, alongside attempts that meet only some. The initialization results above describe this stage.")}</p>
        <p class="paper-step__meaning">{t("这些成功经验可能用于后续学习，但有成功样本不代表数量足够。两个模型起点不同，后续效果必须结合各自起点解释。", "Successful experience may support later learning, but having some does not establish that there is enough. Later results must be interpreted against each model’s different starting point.")}</p>
        <details class="paper-step__technical"><summary>{t('方法与检查记录', 'Method and verification record')}</summary><dl><div><dt>{t("操作","Action")}</dt><dd>{t(`${arm3.model}: ${arm3.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact；${arm17.model}: ${arm17.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact。`, `${arm3.model}: ${arm3.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact; ${arm17.model}: ${arm17.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact.`)}</dd></div><div><dt>{t("理由","Reason")}</dt><dd>{t('自进化需要一个可学习的 bootstrap signal；这些 exact success 证明 raw policy 并非完全没有完整成功行为。', 'Self-evolution needs a learnable bootstrap signal; these exact successes show that the raw policies are not devoid of complete successful behavior.')}</dd></div><div><dt>{t("记录","Record")}</dt><dd>{t(`${arm3.positive} 条 3B trajectory 与 ${arm17.positive} 条 1.7B trajectory 得到 >0 的部分奖励；exact 分别覆盖 ${arm3.exactTaskIdentities} 与 ${arm17.exactTaskIdentities} 个不同任务。`, `${arm3.positive} 3B trajectories and ${arm17.positive} 1.7B trajectories receive >0 partial reward; exact success covers ${arm3.exactTaskIdentities} and ${arm17.exactTaskIdentities} distinct tasks respectively.`)}</dd></div><div><dt>{t("适用范围","Scope")}</dt><dd>{t('成功率差异是 Stage1 baseline；后续比较学习曲线必须保留这条起跑线差异。', 'The success-rate difference is a Stage-1 baseline; later learning-curve comparisons must preserve this starting-point difference.')}</dd></div></dl></details>
      </div>
    </article>
    <span class="paper-connector"></span>

    <article data-paper-step="minimax" data-research-step="minimax">
      <div class="paper-step__index"><span>04</span><b>POST-HOC ANALYSIS</b></div>
      <div class="paper-step__body">
        <h2>{t('购物后的分析', 'Analysis after shopping')}</h2>
        <p class="paper-step__meaning">{t("记录固定之后，MiniMax 才阅读已经结束的购物过程，分析哪里出错、哪些行为值得保留。它提供事后反馈，不替购物模型选择在线动作。", "After the records are frozen, MiniMax reviews completed attempts to analyze errors and useful behavior. It supplies feedback afterwards, without choosing actions for the shopping model.")}</p>
        <p class="paper-step__meaning">{t("初始购物由模型独立完成，后续经验分析使用外部模型。两部分的作用和预算分别记录。", "The model performs the initial shopping independently; an external model analyzes experience afterwards. Their roles and budgets are recorded separately.")}</p>
        <details class="paper-step__technical"><summary>{t('方法与检查记录', 'Method and verification record')}</summary><dl><div><dt>{t("操作","Action")}</dt><dd>{t('MiniMax 对已完成 trajectory 做 task-after analysis，形成后续 carrier 可消费的 teacher evidence。', 'MiniMax performs post-hoc analysis of completed trajectories to create teacher evidence for downstream carriers.')}</dd></div><div><dt>{t("理由","Reason")}</dt><dd>{t('把外部分析预算与模型自己的 WebShop 行为严格分开，避免“老师边看边指挥行动”。', 'Keep external analysis budget separate from the model’s WebShop behavior and avoid a teacher directing actions online.')}</dd></div><div><dt>{t("记录","Record")}</dt><dd>{t('两个 READY_FOR_MINIMAX receipt 都绑定 trajectory_count=1440，并写 new_webshop_calls=0。', 'Both READY_FOR_MINIMAX receipts bind trajectory_count=1440 and record new_webshop_calls=0.')}</dd></div><div><dt>{t("适用范围","Scope")}</dt><dd>{t('因此可以说 Stage1 behavior collection teacher-free；不能说整个 OpenEvo evolution 从未使用外部 analyzer。', 'Therefore Stage-1 behavior collection can be called teacher-free; the overall OpenEvo evolution cannot be described as never using an external analyzer.')}</dd></div></dl></details>
      </div>
    </article>
    <span class="paper-connector"></span>

    <article data-paper-step="carriers" data-research-step="carriers">
      <div class="paper-step__index"><span>05</span><b>BOUNDED CARRIERS</b></div>
      <div class="paper-step__body">
        <h2>{t('后续学习的材料', 'Materials for later learning')}</h2>
        <p class="paper-step__meaning">{t("分别把两种模型各自的经验整理成四类材料：可加载的参数增量、文本记忆、技能集合和系统指令。它们分别让经验进入参数或后续上下文。", "Each model’s experience is separately organized into four materials: a loadable parameter update, text memory, a skill collection, and system instructions. These carry experience into parameters or later context.")}</p>
        <p class="paper-step__meaning">{t("这些材料在初始采集之后生成，不能反过来参与初始成绩。材料过长时按预先确定的容量规则处理；不能看到奖励后再挑选分拆方式。", "These materials are created after initial collection and cannot contribute to its scores retroactively. Oversized material follows predetermined capacity rules, not a split chosen after seeing rewards.")}</p>
        <details class="paper-step__technical"><summary>{t('方法与检查记录', 'Method and verification record')}</summary><dl><div><dt>{t("操作","Action")}</dt><dd>{t('两边分别生成自己的 initial adapter、Text Memory、Skill Bundle 与 Agent System，并绑定同一 lineage 的 provenance。', 'Each arm builds its own initial adapter, Text Memory, Skill Bundle, and Agent System with provenance bound to the same lineage.')}</dd></div><div><dt>{t("理由","Reason")}</dt><dd>{t('这些是 Stage1 之后的学习 carrier，不能提前泄漏回 raw Stage1；容量问题也必须用预先定义的 deterministic rule 处理。', 'These are post-Stage-1 learning carriers and cannot leak backward into raw Stage 1; capacity problems also need pre-defined deterministic handling.')}</dd></div><div><dt>{t("记录","Record")}</dt><dd>{t('Text Memory A1.1 的 4096-token extended repair 对 3B / 1.7B 都失败；current A2 只有双 saturation 后才 fixed first10 + last10，max split depth=1。', 'Text-Memory A1.1 4096-token extended repair failed for both 3B and 1.7B; current A2 uses fixed first10 + last10 only after double saturation, with max split depth=1.')}</dd></div><div><dt>{t("适用范围","Scope")}</dt><dd>{t('10+10 不是看到 reward 后才挑的 adaptive split；如果按结果决定 topology，会改变科学语义。', '10+10 is not an outcome-selected adaptive split; choosing topology after observing rewards would change the scientific semantics.')}</dd></div></dl></details>
        <details><summary>{t('展开 4096 → 10+10 的证据链', 'Open the 4096 → 10+10 evidence chain')}</summary><p>{t('先尝试保持完整 20-input topology，只扩大输出修复容量；两边都 extended_repair_failed。A2 随后以同一个 20-input node 的 primary + same20 repair 双 saturation 为 trigger，才允许 bounded fixed split。', 'The first attempt kept the full 20-input topology and only expanded output repair capacity; both arms returned extended_repair_failed. A2 then uses double saturation of the same 20-input node—primary plus same20 repair—as the trigger for a bounded fixed split.')}</p><a href={OPEN_EVO_EVIDENCE_LINKS.capacityAuthority} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.capacityAuthority} />capacity authority</a></details>
      </div>
    </article>
    <span class="paper-connector"></span>

    <article data-paper-step="boundary" data-research-step="boundary" class="paper-step--boundary">
      <div class="paper-step__index"><span>06</span><b>PRE_STAGE2_READY</b></div>
      <div class="paper-step__body">
        <h2>{t('当时的准备检查', 'The preparation check at that time')}</h2>
        <p class="paper-step__meaning">{t("当时的检查确认两边的材料能够加载，并记录它们来自哪个模型和哪批经验。这一步结束了初始准备，只证明材料已准备好。", "The check at that time confirmed that both sets of materials could be loaded and recorded their model and experience origins. It completed initial preparation and established readiness only.")}</p>
        <p class="paper-step__meaning">{t("后续学习需要另一份独立授权。报告上方的 1.7B 最终测试来自后来获准执行的学习阶段，不能把后来完成的结果改写成当时已经完成。", "Later learning required separate authorization. The 1.7B final test above followed that later authorized learning phase; its completion must not be projected back onto this earlier check.")}</p>
        <details class="paper-step__technical"><summary>{t('方法与检查记录', 'Method and verification record')}</summary><dl><div><dt>{t("操作","Action")}</dt><dd>{t('两个 PRE_STAGE2_READY receipt 都是 PASS，并绑定 adapter / Memory / Skill / Agent / model revision / provenance。', 'Both PRE_STAGE2_READY receipts are PASS and bind adapter / Memory / Skill / Agent / model revision / provenance.')}</dd></div><div><dt>{t("理由","Reason")}</dt><dd>{t('把“准备好了”与“允许开始下一阶段”分开，防止工程自动续跑越过科学 gate。', 'Separate “ready” from “authorized to start the next phase,” preventing automated execution from crossing a scientific gate.')}</dd></div><div><dt>{t("记录","Record")}</dt><dd><code>stage2_authorized=false</code> · <code>stage2_requires_separate_activation=true</code></dd></div><div><dt>{t("适用范围","Scope")}</dt><dd>{t('这一步本身只支持 Stage1→PRE_STAGE2_READY；上方 1.7B final closeout 来自后续独立 Stage2 activation 与固定 final panel，不反向改写 Stage1。', 'This step itself supports only Stage1→PRE_STAGE2_READY; the 1.7B final closeout above comes from a later independent Stage-2 activation and fixed final panel and does not rewrite Stage 1.')}</dd></div></dl></details>
      </div>
    </article>
  </section>

  <ResearchDepth locale={locale} kind="method" summary={t('共享 Harness 的公平性与污染边界', 'Shared-harness fairness and contamination boundaries')} intro={t('这些边界必须保留，但不需要抢占第一次阅读的主线。', 'These boundaries remain auditable without dominating the first reading path.')}><OpenEvoHarnessFairnessPanel locale={locale} /></ResearchDepth>

  <section class="report-boundaries" aria-labelledby="report-boundary-title">
    <p>WHAT THIS RESULT DOES / DOES NOT CLAIM</p>
    <h2 id="report-boundary-title">{t('结论的适用范围', 'Scope of the conclusions')}</h2>
    <div><article><strong>{t('支持', 'Supported')}</strong><p>{t('两种模型共用不教具体解法的接口。初始尝试没有使用后来学到的材料、外部模型代选动作或最终测试题。1.7B 的后续学习已封存，并在预先固定的 128 道任务上独立测试；事后分析与模型购物分开进行。', 'One shared strategy-neutral interface; no learned-carrier / teacher-action / final-panel leakage in raw Stage 1; the 1.7B Stage 2 is sealed with an independent fixed 128-task final evaluation; post-hoc analysis remains separate from online acting.')}</p></article><article><strong>{t('不支持', 'Not supported')}</strong><p>{t('“完全没有接口辅助”；“基座模型预训练从未见过 WebShop”；“1.7B 普遍强于 3B”；“后续学习已经证明能稳定提升”。', '“No scaffolding at all”; “the base models never saw WebShop in pretraining”; “1.7B is generally stronger than 3B”; or “Stage 2 has already proven stable improvement.”')}</p></article></div>
  </section>

  <footer class="report-map__footer"><a href={links.exploration}>{t('← 看这些设计是怎样一步一步被试出来的', '← See how these choices were actually discovered')}</a><a href={links.archive}>{t('完整实验档案', 'Full experiment archive')}</a><a href={links.gateway}>{t('回到两种读法 →', 'Back to the two views →')}</a></footer>
</main>

