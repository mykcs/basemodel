---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const trackARoot = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19';
const wb1Root = 'https://github.com/mykcs/openevo-experiment/blob/c2791000a3af97190c264ba5ea39f0c4e5f65823';
const trackACloseout: EvidenceRef = { kind: 'machine-result', label: t('路线 A 机器可读收尾记录', 'Track A machine-readable closeout'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/CLOSEOUT.json` };
const trackASemanticValidation: EvidenceRef = { kind: 'runtime-receipt', label: t('128/128 任务语义核对通过', '128/128 runtime semantic validation · PASS'), href: `${trackARoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json` };
const trackAManifest: EvidenceRef = { kind: 'manifest', label: t('纠错后 128 个任务槽位清单', 'Corrected 128-slot task manifest'), href: `${trackARoot}/configs/experiment/manifests/webshop-seed-source-faithful-reproduction-v1-panel-v1.json` };
const trackAEvidenceManifest: EvidenceRef = { kind: 'audit', label: t('256 个任务回合逐文件核对证据清单', '256-episode byte-for-byte evidence manifest'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/EVIDENCE_MANIFEST.json` };
const wb1LiveCheckedAt = '2026-09-01';
const wb1LiveCheckedSha = 'd471341e518ed4568fc84f4f732784d091613b03';
const wb1LiveCampaign: EvidenceRef = { kind: 'config', label: t(`WB1 live router · main（${wb1LiveCheckedAt} 核验 · ${wb1LiveCheckedSha.slice(0, 8)}…）`, `WB1 live router · main (checked ${wb1LiveCheckedAt} · ${wb1LiveCheckedSha.slice(0, 8)}…)`), href: 'https://github.com/mykcs/openevo-experiment/blob/main/configs/experiment/current-campaign.json' };
const wb1AdoptedStateSnapshot: EvidenceRef = { kind: 'machine-result', label: t('state-v28 采纳时的不可变 campaign 快照', 'Immutable campaign snapshot at state-v28 adoption'), href: `${wb1Root}/configs/experiment/current-campaign.json` };
const wb1StateV28Reconciliation: EvidenceRef = { kind: 'audit', label: t('第 28 代 state-v28 状态门对账 · 通过', 'Gen28 state-v28 barrier reconciliation · PASS'), href: `${wb1Root}/docs/evidence/wb1/phase-2/amendment006-gen28-state-v28/RECONCILIATION.json` };

type Step = { index: string; title: string; plain: string; detail: string; sources?: EvidenceRef[] };
const steps: Step[] = [
  {
    index: 'N1',
    title: t('同一 128 个任务的两模型测量已完成', 'The two-model measurement on the same 128 tasks is complete'),
    plain: t('纠错后的 128 个任务已经全部核对通过，基础模型和加载冻结 OpenEvo 学习结果后的模型也都分别完成了 128 个有效任务回合。OpenEvo 的平均任务完成度高一点，但完整成功率两边同为 3.9%，统计范围仍包含“没有差异”，因此只能说观察到正向方向，不能说已经证明稳定优势。', 'All 128 corrected tasks passed validation, and both the base model and the same model plus the frozen OpenEvo learning result completed 128 valid episodes. Mean task progress is somewhat higher with OpenEvo, but exact success is 3.9% in both cases and the uncertainty range still includes no difference. This is a positive direction, not a proven stable advantage.'),
    detail: t('基础模型的平均任务完成度 / 完整成功率为 7.17 / 3.9%，OpenEvo 模型为 8.74 / 3.9%；同任务平均差是 +1.57，95% 置信区间为 [-3.21,+6.31]。全部 256 个原始任务回合以及对账、分析和运行凭据已逐文件校验并发布。这个面板不是论文最终 128 题，也不能当作论文 89.7 / 78.1% 的精确复现。', 'The base model scored 7.17 / 3.9% mean progress / exact success and the OpenEvo model scored 8.74 / 3.9%; the same-task mean difference is +1.57 with a 95% interval of [-3.21,+6.31]. All 256 raw episodes plus reconciliation, analysis, and run receipts are published and verified. This panel is not the paper-final 128 and is not an exact reproduction of the paper’s 89.7 / 78.1% result.'),
    sources: [trackACloseout, trackASemanticValidation, trackAManifest, trackAEvidenceManifest],
  },
  {
    index: 'N2',
    title: t('方法对方法比较等待继续授权', 'The method-versus-method comparison is waiting for resumption approval'),
    plain: t('SEED 和 OpenEvo 的方法级比较使用同一个冻结环境、同样的任务、同一评测程序和匹配预算。上一轮 128 个任务已经完成，原本漏存的训练状态也已经在不重跑 WebShop、不使用 GPU 的前提下补齐并核对通过。现在剩下的是决定能不能开始下一轮正式任务。', 'The method-level SEED and OpenEvo comparison uses one frozen environment, the same tasks, the same evaluator, and matched budgets. The previous 128-task round is complete, and the missing retained training state has been reconstructed and reconciled without rerunning WebShop or using GPUs. The remaining decision is whether the next formal round may start.'),
    detail: t('内部记录把补齐后的状态记为 GEN28_STATE_V28_BARRIER_PASS_ADOPTED。匹配经验预算已经使用 3,584 / 20,640 个任务回合，还剩 17,056；当前记录仍明确禁止继续消耗正式任务和分配 GPU，最终测试也保持锁定。恢复执行前必须重新读取最新的运行授权。', 'The internal record classifies the repaired state as GEN28_STATE_V28_BARRIER_PASS_ADOPTED. Matched experience accounting is 3,584 / 20,640 episodes with 17,056 remaining; formal task consumption and GPU allocation are still disallowed and the final test remains locked. The latest execution authority must be reread before resuming.'),
    sources: [wb1LiveCampaign, wb1AdoptedStateSnapshot, wb1StateV28Reconciliation],
  },
  {
    index: 'N3',
    title: t('WebShop 稳定后再做 ALFWorld 复现', 'Replicate in ALFWorld after WebShop is stable'),
    plain: t('如果 WebShop 上的方法比较和连续更新机制都变得稳定，再把同样的问题搬到 ALFWorld。这样才能判断我们看到的是通用学习现象，还是只适用于 WebShop 的任务结构。', 'If the method comparison and repeated-update mechanism become stable on WebShop, carry the same questions to ALFWorld to test whether the finding generalizes beyond WebShop-specific task structure.'),
    detail: t('跨环境复现应该放在 WebShop 的关键结论稳定以后，否则会把“方法机制是否稳定”和“环境差异”两个变量混在一起。', 'Cross-environment replication should follow stable WebShop mechanism evidence; otherwise method instability and environment differences would be confounded.'),
  },
];
---

<section class="next-steps" id="next-steps" aria-labelledby="next-steps-title">
  <header class="section-heading">
    <p>{t('下一步实验 · NEXT STEPS', 'NEXT STEPS')}</p>
    <div>
      <h2 id="next-steps-title">{t('下一轮 OpenEvo 与 SEED 公平比较', 'The next fair OpenEvo-versus-SEED comparison')}</h2>
      <p class="plain-intro">{t('同一 128 个任务分别给基础模型和加载 OpenEvo 学习结果后的模型做完以后，我们得到了一轮有效测量，但还没有证明稳定优势。下一步不再是继续解释这 128 题，而是让 SEED 和 OpenEvo 在同一环境、同一任务、同一评测程序和匹配预算下继续方法对方法的比较。上一轮训练状态已经补齐，但新一轮正式任务目前仍未获授权。', 'Running the same 128 tasks with the base model and the same model plus the OpenEvo learning result produced a valid measurement, but not a proven stable advantage. The next step is no longer to reinterpret that panel; it is to continue a method-versus-method SEED and OpenEvo comparison under the same environment, tasks, evaluator, and matched budget. The previous retained training state has been repaired, but a new round of formal task consumption is not yet authorized.')}</p>
    </div>
  </header>

  <ol class="step-list">
    {steps.map((step) => (
      <li class="step-card" id={`next-${step.index.toLowerCase()}`}>
        <span class="step-index">{step.index}</span>
        <div>
          <h3>{step.title}</h3><p class="step-plain">{step.plain}</p>
          <details class="step-detail">
            <summary>{t('实验记录', 'Experiment record')}</summary>
            <p>{step.detail}</p>
            {step.sources && <OpenEvoEvidenceRefs locale={locale} sources={step.sources} compact />}
          </details>
        </div>
      </li>
    ))}
  </ol>

  <aside class="min-gap">
    <strong>{t('两轮比较回答不同问题', 'The two comparisons answer different questions')}</strong>
    <p>{t('已经完成的 128 题测量比较的是“同一个 7B 基础模型，加载 OpenEvo 学习结果前后有什么差异”；它已经测完，但没有证明稳定提升。下一轮要回答的是更重要的方法级问题：在同一个冻结环境、同一批任务、同一评测程序和匹配预算下，重新运行 SEED 和 OpenEvo，谁表现更好？只有后一个实验才能直接回答 OpenEvo 与 SEED 的公平比较，而不是把我们的数字和论文 89.7 / 78.1% 直接相减。', 'The completed 128-task measurement compares the same 7B base model before and after loading the OpenEvo learning result; it is complete but does not establish a stable improvement. The next comparison asks the more important method-level question: under one frozen environment, the same tasks, the same evaluator, and matched budgets, which performs better when SEED and OpenEvo are rerun? Only that experiment directly answers the fair OpenEvo-versus-SEED comparison instead of subtracting our result from the paper’s 89.7 / 78.1%.')} <a href={localePath(locale, '/research/seed-openevo/study/')}>{t('查看实验设定 ↗', 'See the experiment setup ↗')}</a></p>
  </aside>
</section>

<style>
  .next-steps{max-width:1160px;margin:0 auto;padding:0 24px 52px;color:var(--color-text)}.section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}.section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.1em}.section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}.section-heading div>p{margin:0;max-width:70ch;font-size:.94rem;line-height:1.68}.plain-intro{color:var(--color-text)}
  .step-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}.step-card{display:grid;grid-template-columns:62px minmax(0,1fr);gap:20px;padding:22px 24px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}.step-index{color:var(--color-accent);font:700 .82rem ui-monospace,SFMono-Regular,Menlo,monospace}.step-card h3{margin:0 0 8px;font-size:1.05rem;letter-spacing:-.02em}.step-card p{margin:0;max-width:78ch;line-height:1.68}.step-plain{color:var(--color-text);font-size:.87rem}.step-detail{margin-top:10px;border-top:1px solid var(--color-border)}.step-detail summary{cursor:pointer;padding:10px 0 0;color:var(--color-accent);font-size:.76rem;font-weight:720}.step-detail p{margin-top:8px;color:var(--color-text-muted);font-size:.78rem}.min-gap{margin-top:12px;padding:18px 22px;border-left:3px solid var(--color-accent);border-radius:0 12px 12px 0;background:var(--color-surface)}.min-gap>strong{display:block;margin-bottom:5px;font-size:.86rem}.min-gap p{margin:0;max-width:84ch;font-size:.84rem;line-height:1.66}.min-gap a{color:var(--color-accent);font-weight:750;text-decoration:none}.min-gap a:hover{text-decoration:underline}
  @media(max-width:720px){.next-steps{padding-inline:18px}.section-heading{grid-template-columns:1fr;gap:8px}.step-card{grid-template-columns:1fr;gap:8px;padding:18px}}
</style>
