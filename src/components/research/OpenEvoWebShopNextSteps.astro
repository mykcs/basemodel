---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const sourceRoot = 'https://github.com/mykcs/openevo-experiment/blob/1971fad6602d23d499a5de8bd4bf718947207d86';
const sourceFaithfulConfig: EvidenceRef = { kind: 'preregistration', label: t('源码忠实复现冻结配置 / next gate', 'Source-faithful preregistration / next gate'), href: `${sourceRoot}/configs/experiment/webshop-seed-source-faithful-reproduction-v1.json` };
const sourceFaithfulManifest: EvidenceRef = { kind: 'manifest', label: t('已物化 128-slot 任务清单', 'Materialized 128-slot task manifest'), href: `${sourceRoot}/configs/experiment/manifests/webshop-seed-source-faithful-reproduction-v1-panel-v1.json` };
const rebuild1: EvidenceRef = { kind: 'runtime-receipt', label: t('clean rebuild #1 · PASS', 'clean rebuild #1 · PASS'), href: `${sourceRoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-rebuild-1.json` };
const rebuild2: EvidenceRef = { kind: 'runtime-receipt', label: t('clean rebuild #2 · PASS', 'clean rebuild #2 · PASS'), href: `${sourceRoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-rebuild-2.json` };

type Step = { index: string; title: string; plain: string; technical: string; sources?: EvidenceRef[] };
const steps: Step[] = [
  {
    index: 'N1',
    title: t('源码忠实 128 已经重建；下一关是服务器语义验证与正式 release', 'The source-faithful 128 is built; next is server semantic validation and formal release'),
    plain: t('我们已经把 SEED 公开代码“首次验证”能定义的 128 个任务槽位机械地重建出来，并完成两次干净重建。两次结果的 manifest file/content hash 完全一致，所以“任务清单能不能稳定重建”这一步已经通过。现在仍然不能直接开始正式比较：冻结配置明确保持 PREPARED，正式任务消费还没有授权。', 'We have mechanically reconstructed the 128 task slots defined by the released SEED code’s first validation and completed two clean rebuilds. Both rebuilds produced identical manifest file/content hashes, so deterministic task construction has cleared. Formal comparison still cannot begin directly: the frozen configuration remains PREPARED and formal task consumption is not authorized.'),
    technical: t('专业解释：当前 next_gate 是先在服务器完成 128/128 runtime semantic validation，再通过单独 activation/release PR 把 current campaign 移到 launch-authorized。validation base seed、每个 worker seed、有序 session 抽样、最终 instruction 和数据身份都已经冻结；BASE 与 OpenEvo SD-LoRA 都保持冻结。这里仍然只是“公开代码的一次指定首次验证”，不是论文 89.7 / 78.1% 的确切 128 题。', 'Technical detail: the current next_gate is 128/128 server runtime semantic validation, followed by a separate activation/release PR that moves the current campaign to launch-authorized. Validation base seed, per-worker seed, ordered session draw, resulting instruction, and data identity are frozen; BASE and OpenEvo SD-LoRA remain frozen. This remains one specified released-code first validation, not the exact 128 tasks behind paper 89.7 / 78.1%.'),
    sources: [sourceFaithfulManifest, rebuild1, rebuild2, sourceFaithfulConfig],
  },
  {
    index: 'N2',
    title: t('再解决第二代“学新东西时把旧能力弄丢”', 'Then address second-generation forgetting'),
    plain: t('第二次更新不是没有新经验，而是模型在吸收新经验时，没有同时稳定保住原来会做的任务和第一代已经得到的提升。', 'The second update did have new experience. The problem is that learning it did not stably preserve both prior capability and the first-generation gain.'),
    technical: t('专业解释：下一轮机制实验会围绕经验回放（experience replay）和正则化（regularization），同时重新测试新经验获取（acquisition）、旧能力保持（retention）和已有收益保持（preservation）。', 'Technical detail: the next mechanism study should use experience replay and regularization while retesting acquisition, retention, and preservation together.'),
  },
  {
    index: 'N3',
    title: t('最后再去 ALFWorld 看这个现象是不是 WebShop 特有', 'Then test whether the effect is specific to WebShop'),
    plain: t('如果 WebShop 上的一次迁移和多次连续更新都变得稳定，再把同样的问题搬到 ALFWorld。这样才能判断我们看到的是通用学习现象，还是只适用于 WebShop 的任务结构。', 'If one-step transfer and repeated updating become stable on WebShop, carry the same questions to ALFWorld to test whether the finding generalizes beyond WebShop-specific task structure.'),
    technical: t('专业解释：跨环境复现（cross-environment replication）应该在 WebShop 的关键结论稳定以后进行，否则会把“方法机制不稳定”和“环境差异”两个变量混在一起。', 'Technical detail: cross-environment replication should follow stable WebShop mechanism evidence; otherwise method instability and environment differences would be confounded.'),
  },
];
---

<section class="next-steps" id="next-steps" aria-labelledby="next-steps-title">
  <header class="section-heading">
    <p>{t('下一步实验 · NEXT STEPS', 'NEXT STEPS')}</p>
    <div>
      <h2 id="next-steps-title">{t('下一场真正会改变结论的实验', 'The next experiment that can change the conclusion')}</h2>
      <p class="plain-intro">{t('最优先的事情已经从“把 128 个任务重建出来”推进到“证明服务器实际运行时看到的就是这 128 个语义任务，并正式授权比较”。只有这道门通过以后，BASE 和 OpenEvo 在 source-faithful 面板上的正式分数才有科学意义。', 'The highest-priority work has advanced from constructing the 128 tasks to proving that the server runtime sees exactly those 128 semantic tasks and formally releasing the comparison. Only after that gate clears will BASE-vs-OpenEvo scores on the source-faithful panel have the intended scientific meaning.')}</p>
      <p class="technical-intro"><strong>{t('专业解释：', 'Technical detail: ')}</strong>{t('历史 128-task panel 仍可作为冻结的本地 SEED-compatible 面板，但不能重新标成源码忠实（source-faithful）的首次验证面板，更不能标成论文 89.7 / 78.1% 的确切分母。新 128-slot manifest 只恢复“固定公开代码 + 固定 validation ordinal”可机械恢复的任务语义；公开信息仍不足以唯一恢复论文最终表格对应的 validation 次序与 checkpoint。', 'The historical 128-task panel remains a valid frozen local SEED-compatible panel, but it must not be relabelled as the source-faithful first-validation panel or as the exact denominator behind paper 89.7 / 78.1%. The new 128-slot manifest recovers task semantics for fixed released code plus a fixed validation ordinal; public information still does not uniquely recover the validation ordinal and checkpoint behind the final paper table.')}</p>
    </div>
  </header>

  <ol class="step-list">
    {steps.map((step) => (
      <li class="step-card">
        <span class="step-index">{step.index}</span>
        <div>
          <h3>{step.title}</h3><p class="step-plain">{step.plain}</p><p class="step-technical">{step.technical}</p>
          {step.sources && <OpenEvoEvidenceRefs locale={locale} sources={step.sources} compact />}
        </div>
      </li>
    ))}
  </ol>

  <aside class="min-gap">
    <strong>{t('两条后续路线回答不同问题', 'Two follow-up tracks answer different questions')}</strong>
    <p>{t('路线 A（Track A）问：能不能忠实复现 SEED 公开代码能恢复出来的一次指定验证任务语义？路线 B（Track B，WB1）问：在同一个冻结世界、同一套任务、同一评测程序和匹配预算下，把 SEED 方法本身与 OpenEvo 重新跑一遍，谁表现更好？只有路线 B 才能真正回答 OpenEvo vs SEED，而不是把我们的数字直接和论文 89.7 / 78.1% 相减。', 'Track A asks whether task semantics for a specified validation call recoverable from released SEED code can be reproduced faithfully. Track B (WB1) asks which method performs better after rerunning the SEED method itself and OpenEvo under one frozen world, the same tasks, the same evaluator, and matched budgets. Only Track B directly answers OpenEvo vs SEED; it does not subtract our number from the paper’s 89.7 / 78.1%.')} <a href={localePath(locale, '/research/seed-openevo/experiment/')}>{t('查看实验设定 ↗', 'See the experiment setup ↗')}</a></p>
  </aside>
</section>

<style>
  .next-steps{max-width:1160px;margin:0 auto;padding:0 24px 52px;color:var(--color-text)}.section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}.section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.1em}.section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}.section-heading div>p{margin:0;max-width:70ch;font-size:.94rem;line-height:1.68}.plain-intro{color:var(--color-text)}.technical-intro{margin-top:9px!important;padding-top:9px;border-top:1px dashed var(--color-border);color:var(--color-text-muted);font-size:.82rem!important}.technical-intro strong{color:var(--color-text)}
  .step-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}.step-card{display:grid;grid-template-columns:62px minmax(0,1fr);gap:20px;padding:22px 24px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}.step-index{color:var(--color-accent);font:700 .82rem ui-monospace,SFMono-Regular,Menlo,monospace}.step-card h3{margin:0 0 8px;font-size:1.05rem;letter-spacing:-.02em}.step-card p{margin:0;max-width:78ch;line-height:1.68}.step-plain{color:var(--color-text);font-size:.87rem}.step-technical{margin-top:8px!important;padding-top:8px;border-top:1px dashed var(--color-border);color:var(--color-text-muted);font-size:.78rem}.min-gap{margin-top:12px;padding:18px 22px;border-left:3px solid var(--color-accent);border-radius:0 12px 12px 0;background:var(--color-surface)}.min-gap>strong{display:block;margin-bottom:5px;font-size:.86rem}.min-gap p{margin:0;max-width:84ch;font-size:.84rem;line-height:1.66}.min-gap a{color:var(--color-accent);font-weight:750;text-decoration:none}.min-gap a:hover{text-decoration:underline}
  @media(max-width:720px){.next-steps{padding-inline:18px}.section-heading{grid-template-columns:1fr;gap:8px}.step-card{grid-template-columns:1fr;gap:8px;padding:18px}}
</style>
