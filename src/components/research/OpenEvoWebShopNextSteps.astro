---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const trackARoot = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19';
const wb1Root = 'https://github.com/mykcs/openevo-experiment/blob/b892d8123cdb4737d7971f84db6e7c1bcc77c6ab';
const trackACloseout: EvidenceRef = { kind: 'machine-result', label: t('Track A 机器可读 closeout', 'Track A machine-readable closeout'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/CLOSEOUT.json` };
const trackASemanticValidation: EvidenceRef = { kind: 'runtime-receipt', label: t('128/128 运行时语义验证 · PASS', '128/128 runtime semantic validation · PASS'), href: `${trackARoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json` };
const trackAManifest: EvidenceRef = { kind: 'manifest', label: t('纠错后 128-slot 任务清单', 'Corrected 128-slot task manifest'), href: `${trackARoot}/configs/experiment/manifests/webshop-seed-source-faithful-reproduction-v1-panel-v1.json` };
const trackAEvidenceManifest: EvidenceRef = { kind: 'audit', label: t('256 episode byte-for-byte 证据清单', '256-episode byte-for-byte evidence manifest'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/EVIDENCE_MANIFEST.json` };
const wb1CurrentState: EvidenceRef = { kind: 'machine-result', label: t('WB1 当前 campaign 状态', 'Current WB1 campaign state'), href: `${wb1Root}/configs/experiment/current-campaign.json` };
const wb1Amendment006: EvidenceRef = { kind: 'human-report', label: t('Amendment 006 · Gen28 状态边界修复', 'Amendment 006 · Gen28 state-boundary repair'), href: `${wb1Root}/docs/experiment-tracking/WB1_AMENDMENT_006_GEN28_DEFERRED_NATIVE_STATE_UPDATE_2026-08-27.md` };
const wb1RepairEntrypoint: EvidenceRef = { kind: 'code', label: t('Gen28 fail-closed 修复入口', 'Gen28 fail-closed repair entrypoint'), href: `${wb1Root}/scripts/openevo_webshop/wb1_gen28_state_repair.py` };

type Step = { index: string; title: string; plain: string; technical: string; sources?: EvidenceRef[] };
const steps: Step[] = [
  {
    index: 'N1',
    title: t('Track A 已经闭环：有效测量，但没有稳定胜出', 'Track A is closed: valid measurement, no stable win'),
    plain: t('我们不再需要等“这 128 题到底是不是按 SEED 公开代码跑出来的”。纠错后的任务语义已经 128/128 验证通过，BASE 和冻结的 OpenEvo SD-LoRA 也都完成了 128 个有效 episode。OpenEvo 的平均 Task Score 更高一点，但 exact success 两边同为 3.9%，而配对置信区间跨 0，所以这一步给出的结论是“测到了一个方向，但没有证明稳定优势”。', 'We no longer need to wait on whether these 128 tasks match the released SEED runtime semantics. The corrected task semantics passed 128/128 validation, and BASE plus the frozen OpenEvo SD-LoRA each completed 128 valid episodes. OpenEvo has a somewhat higher mean Task Score, but exact success is 3.9% in both arms and the paired interval crosses zero. This is a measured direction, not a proven stable advantage.'),
    technical: t('专业解释：BASE=7.17 / 3.9%，SD-LoRA=8.74 / 3.9%，paired Task Score Δ=+1.57，95% CI [-3.21,+6.31]。256 个 raw episode 与 reconciliation、analysis、release/GPU/W&B receipts 已 byte-for-byte 入库并通过 per-file SHA-256 验证，artifact_publication_status=PUBLISHED_AND_VERIFIED。这个面板对应公开代码“首次验证”，不是论文最终 128 题；这不是声称找回了论文 89.7 / 78.1% 当年使用的那 128 题。', 'Technical detail: BASE=7.17 / 3.9%, SD-LoRA=8.74 / 3.9%, paired Task Score Δ=+1.57 with 95% CI [-3.21,+6.31]. All 256 raw episodes plus reconciliation, analysis, release, GPU, and W&B receipts are committed byte-for-byte and pass per-file SHA-256 verification; artifact_publication_status=PUBLISHED_AND_VERIFIED. This panel is the released-code “first validation”, not the paper-final 128, and it is not a claim that we recovered the exact 128 tasks used for the paper’s 89.7 / 78.1%.') ,
    sources: [trackACloseout, trackASemanticValidation, trackAManifest, trackAEvidenceManifest],
  },
  {
    index: 'N2',
    title: t('Track B / WB1 的阻塞点已经有修复合同，但还没生成 state-v28', 'Track B / WB1 now has a repair contract, but state-v28 is not produced yet'),
    plain: t('Gen28 的 128 次做题本身已经完成并且有效；缺的是做题之后那一步 OpenEvo native state update。现在已经不需要重新跑这 128 次，也不再停留在“要不要补”的讨论：Amendment 006 只允许把旧 Gen28 输入先封存校验，然后执行一次 CPU-only 的缺失状态更新，再做 barrier 对账。只有这三步都通过，state-v28 才能成为可采用状态；在这之前仍然不能开 Gen29。', 'The 128 Gen28 WebShop episodes themselves are complete and valid; what is missing is the OpenEvo native-state update that should follow them. We no longer need to rerun those episodes or debate whether a repair is allowed. Amendment 006 permits only a sealed-input check, one CPU-only execution of the missing state update, and barrier reconciliation. State-v28 becomes adoptable only if all three stages pass; Gen29 remains forbidden until then.'),
    technical: t('专业解释：当前 authority 已从 GEN28_COMPLETE_STATE_BARRIER_MISSING 推进到 GEN28_STATE_REPAIR_AUTHORIZED_INPUT_SEAL_PENDING。state-v27 仍是 latest adoptable state，预算仍为 3,456/20,640；只有 seal → exactly-one deferred text_memory_memevolve update → barrier reconciliation 完成并发布后，Gen28 的 128 条 experience 才能计入，届时预算变为 3,584/20,640、剩余 17,056。因为历史 native update 包含 gpt-5.5 / Codex 驱动的 MemEvolve 反思和候选选择，所以这里明确不声称“字节级 deterministic replay”；冻结的是输入、方法身份和 one-update boundary。formal_task_consumption_allowed=false、gpu_allocation_allowed=false、final 继续 locked。', 'Technical detail: current authority has advanced from GEN28_COMPLETE_STATE_BARRIER_MISSING to GEN28_STATE_REPAIR_AUTHORIZED_INPUT_SEAL_PENDING. State-v27 remains the latest adoptable state and the budget remains 3,456/20,640. Only after seal → exactly one deferred text_memory_memevolve update → barrier reconciliation is completed and published may the 128 Gen28 experiences count, advancing the budget to 3,584/20,640 with 17,056 remaining. Because the historical native update uses gpt-5.5 / Codex-driven MemEvolve reflection and candidate selection, this is explicitly not claimed to be a byte-deterministic replay; the frozen objects are the inputs, method identity, and one-update boundary. formal_task_consumption_allowed=false, gpu_allocation_allowed=false, and final remains locked.'),
    sources: [wb1CurrentState, wb1Amendment006, wb1RepairEntrypoint],
  },
  {
    index: 'N3',
    title: t('最后再去 ALFWorld 看这个现象是不是 WebShop 特有', 'Then test whether the effect is specific to WebShop'),
    plain: t('如果 WebShop 上的方法比较和连续更新机制都变得稳定，再把同样的问题搬到 ALFWorld。这样才能判断我们看到的是通用学习现象，还是只适用于 WebShop 的任务结构。', 'If the method comparison and repeated-update mechanism become stable on WebShop, carry the same questions to ALFWorld to test whether the finding generalizes beyond WebShop-specific task structure.'),
    technical: t('专业解释：跨环境复现（cross-environment replication）应该在 WebShop 的关键结论稳定以后进行，否则会把“方法机制不稳定”和“环境差异”两个变量混在一起。', 'Technical detail: cross-environment replication should follow stable WebShop mechanism evidence; otherwise method instability and environment differences would be confounded.'),
  },
];
---

<section class="next-steps" id="next-steps" aria-labelledby="next-steps-title">
  <header class="section-heading">
    <p>{t('下一步实验 · NEXT STEPS', 'NEXT STEPS')}</p>
    <div>
      <h2 id="next-steps-title">{t('下一场真正会改变结论的实验', 'The next experiment that can change the conclusion')}</h2>
      <p class="plain-intro">{t('最优先的问题已经进一步收窄：不是重跑 Gen28，而是先把缺失的 state-v28 边界按 Amendment 006 合法补齐并对账。Track A 的 source-faithful 128×2 比较已经完成；Track B 只有在 state 连续性恢复以后，才可以继续消耗新的训练 experience。', 'The highest-priority question is now narrower still: do not rerun Gen28; first repair and reconcile the missing state-v28 boundary under Amendment 006. The source-faithful Track A 128×2 comparison is complete. Track B may consume new training experience only after state continuity is restored.')}</p>
      <p class="technical-intro"><strong>{t('专业解释：', 'Technical detail: ')}</strong>{t('历史 128-task panel 仍可作为冻结的本地 SEED-compatible 面板，但不能重新标成 source-faithful first-validation panel，更不能标成论文 89.7 / 78.1% 的 exact denominator。Track A 的 corrected panel 已通过 128/128 runtime semantic validation 并完成 paired measurement；WB1 是独立 Track B。当前 Amendment 006 只授权 read-only input seal、一次 CPU-only deferred native update、以及 read-only barrier reconciliation；它没有授权 WebShop rerun、GPU、Gen29 或 final。', 'The historical 128-task panel remains a valid frozen local SEED-compatible panel, but it must not be relabelled as the source-faithful first-validation panel or as the exact denominator behind paper 89.7 / 78.1%. Track A’s corrected panel has passed 128/128 runtime semantic validation and completed its paired measurement; WB1 is a separate Track B line. Amendment 006 currently authorizes only a read-only input seal, one CPU-only deferred native update, and read-only barrier reconciliation; it does not authorize a WebShop rerun, GPU, Gen29, or final.')}</p>
    </div>
  </header>

  <ol class="step-list">
    {steps.map((step) => (
      <li class="step-card">
        <span class="step-index">{step.index}</span>
        <div>
          <h3>{step.title}</h3><p class="step-plain">{step.plain}</p><p class="step-technical">{step.technical}</p>
          {step.sources && <OpenEvoEvidenceRefs locale={locale} sources={step.sources} compact />}
        </div>
      </li>
    ))}
  </ol>

  <aside class="min-gap">
    <strong>{t('两条路线回答不同问题', 'The two tracks answer different questions')}</strong>
    <p>{t('路线 A（Track A）已经回答了：能不能忠实恢复 SEED 公开代码的一次指定 first-validation 任务语义，并在这套语义上做一次配对 BASE-vs-SD 测量？答案是可以恢复，也已经测完，但没有证明稳定提升。路线 B（Track B，WB1）继续回答更重要的问题：在同一个冻结世界、同一套任务、同一评测程序和匹配预算下，把 SEED 方法本身与 OpenEvo 重新跑一遍，谁表现更好？只有路线 B 才能真正回答 OpenEvo vs SEED，而不是把我们的数字和论文 89.7 / 78.1% 直接相减。', 'Track A has now answered whether one specified first-validation task semantics recoverable from released SEED code can be reproduced faithfully and used for a paired BASE-vs-SD measurement: yes, and the measurement is complete, but it does not establish a stable improvement. Track B (WB1) continues the more important question: under one frozen world, the same tasks, the same evaluator, and matched budgets, which method performs better when SEED itself and OpenEvo are rerun? Only Track B can truly answer OpenEvo vs SEED; it does not subtract our number from the paper’s 89.7 / 78.1%.')} <a href={localePath(locale, '/research/seed-openevo/experiment/')}>{t('查看实验设定 ↗', 'See the experiment setup ↗')}</a></p>
  </aside>
</section>

<style>
  .next-steps{max-width:1160px;margin:0 auto;padding:0 24px 52px;color:var(--color-text)}.section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}.section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.1em}.section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}.section-heading div>p{margin:0;max-width:70ch;font-size:.94rem;line-height:1.68}.plain-intro{color:var(--color-text)}.technical-intro{margin-top:9px!important;padding-top:9px;border-top:1px dashed var(--color-border);color:var(--color-text-muted);font-size:.82rem!important}.technical-intro strong{color:var(--color-text)}
  .step-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}.step-card{display:grid;grid-template-columns:62px minmax(0,1fr);gap:20px;padding:22px 24px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}.step-index{color:var(--color-accent);font:700 .82rem ui-monospace,SFMono-Regular,Menlo,monospace}.step-card h3{margin:0 0 8px;font-size:1.05rem;letter-spacing:-.02em}.step-card p{margin:0;max-width:78ch;line-height:1.68}.step-plain{color:var(--color-text);font-size:.87rem}.step-technical{margin-top:8px!important;padding-top:8px;border-top:1px dashed var(--color-border);color:var(--color-text-muted);font-size:.78rem}.min-gap{margin-top:12px;padding:18px 22px;border-left:3px solid var(--color-accent);border-radius:0 12px 12px 0;background:var(--color-surface)}.min-gap>strong{display:block;margin-bottom:5px;font-size:.86rem}.min-gap p{margin:0;max-width:84ch;font-size:.84rem;line-height:1.66}.min-gap a{color:var(--color-accent);font-weight:750;text-decoration:none}.min-gap a:hover{text-decoration:underline}
  @media(max-width:720px){.next-steps{padding-inline:18px}.section-heading{grid-template-columns:1fr;gap:8px}.step-card{grid-template-columns:1fr;gap:8px;padding:18px}}
</style>