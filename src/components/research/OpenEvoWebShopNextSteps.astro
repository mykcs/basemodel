---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoEvidenceRefs from './OpenEvoEvidenceRefs.astro';
import type { EvidenceRef } from '../../lib/researchEvidence';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const trackARoot = 'https://github.com/mykcs/openevo-experiment/blob/f80ae1816384bb7e8e82d193b22644e17f561f19';
const wb1Root = 'https://github.com/mykcs/openevo-experiment/blob/c2791000a3af97190c264ba5ea39f0c4e5f65823';
const trackACloseout: EvidenceRef = { kind: 'machine-result', label: t('路线 A 机器可读收尾记录', 'Track A machine-readable closeout'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/CLOSEOUT.json` };
const trackASemanticValidation: EvidenceRef = { kind: 'runtime-receipt', label: t('128/128 任务语义核对通过', '128/128 runtime semantic validation · PASS'), href: `${trackARoot}/configs/experiment/receipts/webshop-seed-source-faithful-reproduction-v1-semantic-validation.json` };
const trackAManifest: EvidenceRef = { kind: 'manifest', label: t('纠错后 128 个任务槽位清单', 'Corrected 128-slot task manifest'), href: `${trackARoot}/configs/experiment/manifests/webshop-seed-source-faithful-reproduction-v1-panel-v1.json` };
const trackAEvidenceManifest: EvidenceRef = { kind: 'audit', label: t('256 个任务回合逐文件核对证据清单', '256-episode byte-for-byte evidence manifest'), href: `${trackARoot}/docs/evidence/seed-webshop-public-code-reproduction-v1/EVIDENCE_MANIFEST.json` };
const wb1CurrentState: EvidenceRef = { kind: 'machine-result', label: t('路线 B / WB1 当前实验战役状态', 'Current WB1 campaign state'), href: `${wb1Root}/configs/experiment/current-campaign.json` };
const wb1StateV28Reconciliation: EvidenceRef = { kind: 'audit', label: t('第 28 代 state-v28 状态门对账 · 通过', 'Gen28 state-v28 barrier reconciliation · PASS'), href: `${wb1Root}/docs/evidence/wb1/phase-2/amendment006-gen28-state-v28/RECONCILIATION.json` };

type Step = { index: string; title: string; plain: string; technical: string; sources?: EvidenceRef[] };
const steps: Step[] = [
  {
    index: 'N1',
    title: t('路线 A 已完成：测量有效，但没有证明稳定胜出', 'Track A is closed: valid measurement, no stable win'),
    plain: t('我们不再需要等“这 128 题到底是不是按 SEED 公开代码跑出来的”。128/128 表示计划的 128 个任务槽位全部通过语义核对；基础模型（BASE）和加载冻结 OpenEvo SD-LoRA 适配器后的模型，也都分别完成了 128 个有效任务回合。OpenEvo 的平均任务完成度（Task Score）高一点，但真正完整成功率两边同为 3.9%，而配对 95% 置信区间仍包含“没有差异（0）”，所以这一步只能说“观察到正向方向”，不能说已经证明稳定优势。', 'We no longer need to wait on whether these 128 tasks match the released SEED runtime semantics. The corrected task semantics passed 128/128 validation, and BASE plus the frozen OpenEvo SD-LoRA each completed 128 valid episodes. OpenEvo has a somewhat higher mean Task Score, but exact success is 3.9% in both arms and the paired interval crosses zero. This is a measured direction, not a proven stable advantage.'),
    technical: t('专业解释：基础模型的平均任务完成度 / 完整成功率为 7.17 / 3.9%，SD-LoRA 为 8.74 / 3.9%；同任务配对后的平均任务完成度差值是 +1.57，95% 置信区间为 [-3.21,+6.31]。全部 256 个原始任务回合，以及对账、分析、发布、GPU 和 W&B 运行凭据，都已逐文件原样入库并通过 SHA-256 校验；机器发布状态 PUBLISHED_AND_VERIFIED 表示“产物已发布且校验通过”。这个面板对应公开代码能重建的“第一次验证”，不是论文最终 128 题，也不是声称找回了论文 89.7 / 78.1% 当年使用的确切 128 题。', 'Technical detail: BASE=7.17 / 3.9%, SD-LoRA=8.74 / 3.9%, paired Task Score Δ=+1.57 with 95% CI [-3.21,+6.31]. All 256 raw episodes plus reconciliation, analysis, release, GPU, and W&B receipts are committed byte-for-byte and pass per-file SHA-256 verification; artifact_publication_status=PUBLISHED_AND_VERIFIED. This panel is the released-code “first validation”, not the paper-final 128, and it is not a claim that we recovered the exact 128 tasks used for the paper’s 89.7 / 78.1%.') ,
    sources: [trackACloseout, trackASemanticValidation, trackAManifest, trackAEvidenceManifest],
  },
  {
    index: 'N2',
    title: t('第 28 代状态断点已修复；路线 B / WB1 等待第 29 代授权', 'Gen28 continuity is repaired; Track B / WB1 awaits Gen29 authorization'),
    plain: t('路线 B / WB1 把 SEED 方法和 OpenEvo 放进同一个冻结环境，用同样的任务、同一评测器和匹配预算重新比较。第 28 代（Gen28）的 128 个任务回合已经完成；缺失的第 28 代保留状态（state-v28）也已经在不重跑 WebShop、不使用 GPU 的前提下补齐，并通过状态完整性对账。现在真正剩下的是：是否按预先固定的路线 B 实验合同授权进入第 29 代，而不是继续修第 28 代。', 'Track B reruns SEED and OpenEvo as methods in one frozen world using the same tasks and matched budgets. Gen28’s 128 episodes are complete, and the missing state-v28 has now been produced without rerunning WebShop or using GPU and has passed barrier reconciliation. The remaining question is whether the frozen Track B contract should formally resume into Gen29, not how to repair Gen28 again.'),
    technical: t('专业解释：修订项 Amendment 006 规定的一次性“补做原本延后的本地状态更新”已经执行并通过对账。机器状态 GEN28_STATE_V28_BARRIER_PASS_ADOPTED 表示“第 28 代的 state-v28 已补齐、通过状态门并被正式采用”。第 28 代的 128 个有效任务回合按“只要信息进入保留状态，就只计一次”的规则计入匹配预算；当前已使用 3,584 / 20,640 个计入预算的任务回合，还剩 17,056。formal_task_consumption_allowed=false 表示暂不允许继续消耗正式任务，gpu_allocation_allowed=false 表示当前不授权这一步使用 GPU，final locked 表示最终测试仍锁定；第 29 代仍需要一次独立的“可以恢复执行”授权。', 'Technical detail: Amendment 006’s exactly-once deferred native update has been consumed and reconciled. Current classification is GEN28_STATE_V28_BARRIER_PASS_ADOPTED and the latest native state is state-v28. Because Gen28 information is now retained, its 128 valid episodes count exactly once toward the matched budget: 3,584/20,640, with 17,056 remaining. formal_task_consumption_allowed=false, gpu_allocation_allowed=false, and final remains locked; Gen29 still requires a separate execution-readiness / resumption release.'),
    sources: [wb1CurrentState, wb1StateV28Reconciliation],
  },
  {
    index: 'N3',
    title: t('最后再去 ALFWorld 看这个现象是不是 WebShop 特有', 'Then test whether the effect is specific to WebShop'),
    plain: t('如果 WebShop 上的方法比较和连续更新机制都变得稳定，再把同样的问题搬到 ALFWorld。这样才能判断我们看到的是通用学习现象，还是只适用于 WebShop 的任务结构。', 'If the method comparison and repeated-update mechanism become stable on WebShop, carry the same questions to ALFWorld to test whether the finding generalizes beyond WebShop-specific task structure.'),
    technical: t('专业解释：跨环境复现（cross-environment replication）应该在 WebShop 的关键结论稳定以后进行，否则会把“方法机制不稳定”和“环境差异”两个变量混在一起。', 'Technical detail: cross-environment replication should follow stable WebShop mechanism evidence; otherwise method instability and environment differences would be confounded.'),
  },
];
---

<section class="next-steps" id="next-steps" aria-labelledby="next-steps-title">
  <header class="section-heading">
    <p>{t('下一步实验 · NEXT STEPS', 'NEXT STEPS')}</p>
    <div>
      <h2 id="next-steps-title">{t('下一场真正会改变结论的实验', 'The next experiment that can change the conclusion')}</h2>
      <p class="plain-intro">{t('最优先的问题已经从“证明纠错后的 128 题逐题一致”推进到“如何在不破坏预算和状态连续性的前提下继续方法对方法的公平比较路线（Track B / WB1）”。源码忠实任务测量路线（Track A）已经完成“同一 128 个任务 × 两个模型组”的比较，并且它告诉我们：当前冻结的 SD-LoRA 适配器模型还没有在这套更可信的任务语义上证明稳定优势。', 'The highest-priority question has moved from proving the corrected 128 tasks match one by one to deciding how Track B / WB1 can continue without breaking budget or state continuity. The source-faithful Track A 128×2 comparison is complete, and it tells us that the frozen SD-LoRA has not established a stable advantage on this more trustworthy task semantic panel.')}</p>
      <p class="technical-intro"><strong>{t('专业解释：', 'Technical detail: ')}</strong>{t('历史 128 任务面板仍可以作为冻结的本地“与 SEED 兼容”面板，但不能重新标成“公开代码第一次验证的源码忠实面板”，更不能冒充论文 89.7 / 78.1% 的确切统计分母。路线 A 的纠错面板已经让 128 / 128 个任务槽位通过运行时语义核对，并完成同任务配对测量；与此同时，WB1 属于独立的路线 B，state-v28 已被采用，但第 29 代仍处于“不允许执行”的独立状态门之后。', 'The historical 128-task panel remains a valid frozen local SEED-compatible panel, but it must not be relabelled as the source-faithful first-validation panel or as the exact denominator behind paper 89.7 / 78.1%. Track A’s corrected panel has passed 128/128 runtime semantic validation and completed its paired measurement; WB1 is a separate Track B line and has adopted state-v28, while Gen29 remains behind a separate no-execution gate.')}</p>
    </div>
  </header>

  <ol class="step-list">
    {steps.map((step) => (
      <li class="step-card">
        <span class="step-index">{step.index}</span>
        <div>
          <h3>{step.title}</h3><p class="step-plain">{step.plain}</p><p class="step-technical">{step.technical}</p>
          {step.sources && <OpenEvoEvidenceRefs locale={locale} sources={step.sources} compact />}
        </div>
      </li>
    ))}
  </ol>

  <aside class="min-gap">
    <strong>{t('两条路线回答不同问题', 'The two tracks answer different questions')}</strong>
    <p>{t('路线 A（Track A）回答的是：能不能忠实恢复 SEED 公开代码“第一次验证”会生成的任务语义，并在同一批任务上比较基础模型与加载 SD-LoRA 的模型？答案是可以恢复，也已经测完，但没有证明稳定提升。路线 B（Track B，WB1）回答的是更重要的方法级问题：在同一个冻结环境、同一批任务、同一评测程序和匹配预算下，把 SEED 方法本身与 OpenEvo 重新跑一遍，谁表现更好？只有路线 B 才能真正回答 OpenEvo vs SEED，而不是把我们的数字和论文 89.7 / 78.1% 直接相减。', 'Track A has now answered whether one specified first-validation task semantics recoverable from released SEED code can be reproduced faithfully and used for a paired BASE-vs-SD measurement: yes, and the measurement is complete, but it does not establish a stable improvement. Track B (WB1) continues the more important question: under one frozen world, the same tasks, the same evaluator, and matched budgets, which method performs better when SEED itself and OpenEvo are rerun? Only Track B can truly answer OpenEvo vs SEED; it does not subtract our number from the paper’s 89.7 / 78.1%.')} <a href={localePath(locale, '/research/seed-openevo/study/')}>{t('查看实验设定 ↗', 'See the experiment setup ↗')}</a></p>
  </aside>
</section>

<style>
  .next-steps{max-width:1160px;margin:0 auto;padding:0 24px 52px;color:var(--color-text)}.section-heading{display:grid;grid-template-columns:145px minmax(0,760px);gap:28px;padding:38px 0 24px;border-top:1px solid var(--color-border)}.section-heading>p{margin:5px 0 0;color:var(--color-text-muted);font-size:.73rem;font-weight:750;letter-spacing:.1em}.section-heading h2{margin:0 0 8px;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}.section-heading div>p{margin:0;max-width:70ch;font-size:.94rem;line-height:1.68}.plain-intro{color:var(--color-text)}.technical-intro{margin-top:9px!important;padding-top:9px;border-top:1px dashed var(--color-border);color:var(--color-text-muted);font-size:.82rem!important}.technical-intro strong{color:var(--color-text)}
  .step-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}.step-card{display:grid;grid-template-columns:62px minmax(0,1fr);gap:20px;padding:22px 24px;border:1px solid var(--color-border);border-radius:15px;background:var(--color-bg)}.step-index{color:var(--color-accent);font:700 .82rem ui-monospace,SFMono-Regular,Menlo,monospace}.step-card h3{margin:0 0 8px;font-size:1.05rem;letter-spacing:-.02em}.step-card p{margin:0;max-width:78ch;line-height:1.68}.step-plain{color:var(--color-text);font-size:.87rem}.step-technical{margin-top:8px!important;padding-top:8px;border-top:1px dashed var(--color-border);color:var(--color-text-muted);font-size:.78rem}.min-gap{margin-top:12px;padding:18px 22px;border-left:3px solid var(--color-accent);border-radius:0 12px 12px 0;background:var(--color-surface)}.min-gap>strong{display:block;margin-bottom:5px;font-size:.86rem}.min-gap p{margin:0;max-width:84ch;font-size:.84rem;line-height:1.66}.min-gap a{color:var(--color-accent);font-weight:750;text-decoration:none}.min-gap a:hover{text-decoration:underline}
  @media(max-width:720px){.next-steps{padding-inline:18px}.section-heading{grid-template-columns:1fr;gap:8px}.step-card{grid-template-columns:1fr;gap:8px;padding:18px}}
</style>
