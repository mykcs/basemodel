---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const steps = [
  { title: t('收到购物要求', 'Receive a shopping request'), body: t('例如：蓝色杯子，价格不超过 20 美元。', 'Example: a blue cup costing no more than $20.'), detail: t('任务先给出需求。模型需要同时满足商品、颜色和价格等条件。', 'The task specifies requirements. The model must satisfy the item, color, and price constraints together.') },
  { title: t('模型选择动作', 'The model chooses an action'), body: t('搜索商品、打开详情、选择规格。', 'Search, open a product, or choose an option.'), detail: t('模型根据已经看到的页面，决定搜索什么或点击哪个按钮。一次动作不是一次完整任务。', 'The model decides what to search for or click from the pages it has seen. One action is not a complete task attempt.') },
  { title: t('网页返回信息', 'The website returns information'), body: t('新页面决定下一步能选什么。', 'The new page determines the available next actions.'), detail: t('WebShop 返回搜索结果或商品详情。模型再看页面、再选动作，这个循环持续到任务结束。', 'WebShop returns search results or product details. The model observes again and chooses another action until the task ends.') },
  { title: t('结束并记录结果', 'Finish and record the outcome'), body: t('购买、达到步数上限或触发终止条件。', 'Purchase, reach the step limit, or hit a termination condition.'), detail: t('从收到需求到结束的一整段记录叫轨迹（trajectory），也就是一次任务尝试。结束不代表成功，仍需检查买到的商品是否满足要求。', 'The full record from request to termination is a trajectory: one task attempt. Ending does not mean success; the purchase still has to meet the requirements.') },
];
---
<section class="task-context" id="shopping-task" data-reader-context data-testid="research-task-context" aria-labelledby="shopping-task-title" data-ui-audit="contrast layout">
  <h2 id="shopping-task-title">{t('模型的购物任务', 'The model’s shopping task')}</h2>
  <p data-reader-task>{t('WebShop 是一个模拟购物网站。智能体就是能读取页面、选择下一步动作的模型；我们观察它能否按要求买到商品。', 'WebShop is a simulated shopping website. An agent is a model that reads pages and chooses its next action; we observe whether it can buy an item that meets the request.')}</p>
  <figure class="task-example" data-task-example>
    <ol>
      {steps.map((step, index) => (
        <li data-example-step={index} data-ui-audit-item>
          <span class="task-example__number" aria-hidden="true">{index + 1}</span>
          <strong>{step.title}</strong><p>{step.body}</p>
          <svg class="task-example__arrow" viewBox="0 0 40 16" aria-hidden="true"><path d="M1 8H36M29 2l7 6-7 6" /></svg>
        </li>
      ))}
    </ol>
    <figcaption>{t('任务流程示意，不是实验数据。第 2、3 步会重复；完整记录才能算一次尝试。', 'Task illustration, not experiment data. Steps 2 and 3 repeat; only the full record counts as an attempt.')}</figcaption>
    <div class="task-example__controls" data-example-controls hidden>
      <button type="button" data-example-previous disabled>{t('上一步', 'Previous step')}</button>
      <span data-example-position>1 / 4</span>
      <button type="button" data-example-next>{t('下一步', 'Next step')}</button>
      <button type="button" data-example-reset>{t('重看示意', 'Restart illustration')}</button>
    </div>
    <p class="task-example__explanation" data-example-explanation aria-live="polite" aria-atomic="true" hidden></p>
    {steps.map((step) => <template data-example-detail>{step.detail}</template>)}
  </figure>
  <p>{t('OpenEvo 研究怎样把做任务的经验用于后续尝试；SEED 是研究采用的参照方法。具体实验可能只收集经验，也可能继续训练，必须分别看它的开始和结束条件。', 'OpenEvo studies how task experience can inform later attempts; SEED is the reference method. An experiment may only collect experience or may continue training, so each has its own start and stop conditions.')}</p>
</section>
<script>
  function initializeTaskExamples() {
    document.querySelectorAll<HTMLElement>('[data-task-example]').forEach((root) => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';
      const nodes = [...root.querySelectorAll<HTMLElement>('[data-example-step]')];
      const details = [...root.querySelectorAll<HTMLTemplateElement>('[data-example-detail]')];
      const controls = root.querySelector<HTMLElement>('[data-example-controls]');
      const previous = root.querySelector<HTMLButtonElement>('[data-example-previous]');
      const next = root.querySelector<HTMLButtonElement>('[data-example-next]');
      const reset = root.querySelector<HTMLButtonElement>('[data-example-reset]');
      const position = root.querySelector<HTMLElement>('[data-example-position]');
      const explanation = root.querySelector<HTMLElement>('[data-example-explanation]');
      if (!controls || !previous || !next || !reset || !position || !explanation || nodes.length === 0 || nodes.length !== details.length) return;
      let step = 0;
      const show = () => {
        nodes.forEach((node, index) => {
          if (index === step) node.setAttribute('aria-current', 'step');
          else node.removeAttribute('aria-current');
        });
        previous.disabled = step === 0;
        next.disabled = step === nodes.length - 1;
        position.textContent = `${step + 1} / ${nodes.length}`;
        explanation.textContent = details[step]?.content.textContent ?? '';
      };
      previous.addEventListener('click', () => { step = Math.max(0, step - 1); show(); });
      next.addEventListener('click', () => { step = Math.min(nodes.length - 1, step + 1); show(); });
      reset.addEventListener('click', () => { step = 0; show(); });
      controls.hidden = false;
      explanation.hidden = false;
      show();
    });
  }
  initializeTaskExamples();
  document.addEventListener('astro:page-load', initializeTaskExamples);
</script>
<style>
.task-context{margin:1.5rem 0;min-width:0;color:var(--ink)}.task-context h2{font-size:1.5rem;line-height:1.4;margin:0 0 .6rem}.task-context>p{max-width:48rem;line-height:1.8;margin:.75rem 0}.task-example{margin:1.2rem 0;padding:1.1rem 0;border-block:1px solid var(--line)}.task-example ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem;list-style:none;padding:0;margin:0}.task-example li{position:relative;min-width:0;padding:.7rem 0;border-top:3px solid var(--line);transition:border-color .18s ease,background-color .18s ease}.task-example li[aria-current="step"]{border-color:var(--accent-deep);background:var(--surface-muted)}.task-example__number{display:block;font:700 .85rem/1.5 var(--font-mono);color:var(--accent-deep);margin-bottom:.3rem}.task-example strong{display:block;font-size:1rem;line-height:1.5}.task-example li p{font-size:.95rem;line-height:1.7;margin:.5rem 0}.task-example__arrow{position:absolute;width:1.5rem;height:1rem;right:-1.75rem;top:2.8rem;fill:none;stroke:var(--muted);stroke-width:1.5}.task-example li:last-child .task-example__arrow{display:none}.task-example figcaption{font-size:.85rem;color:var(--muted);line-height:1.7;margin-top:.7rem}.task-example__controls:not([hidden]){display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.task-example button{padding:.55rem .8rem;min-height:44px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--surface);color:var(--ink);font:inherit;cursor:pointer}.task-example button:disabled{color:var(--muted);cursor:default}.task-example button:focus-visible{outline:2px solid var(--accent-deep);outline-offset:3px}.task-example button:hover:enabled{border-color:var(--accent-deep)}.task-example__explanation{max-width:48rem;min-height:3.5em;line-height:1.75;padding-left:1rem;border-left:2px solid var(--accent-deep)}@media(max-width:760px){.task-example ol{grid-template-columns:1fr;gap:1.1rem}.task-example li{padding:.5rem 0 .5rem 2rem;border-top:0;border-left:3px solid var(--line)}.task-example__number{position:absolute;left:.65rem}.task-example li p{margin:.25rem 0}.task-example__arrow{top:auto;bottom:-1rem;left:.15rem;transform:rotate(90deg);width:1.25rem}.task-example__explanation{min-height:0}}@media(prefers-reduced-motion:reduce){.task-example li{transition:none}}
</style>
