---
import { localePath, type Locale } from '../../i18n';
import ResearchTechnicalDisclosure from './ResearchTechnicalDisclosure.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const stages = [
  [t('做题模型', 'Actor'), 'Qwen2.5-3B-Instruct', t('当前对照固定同一模型；它自己选择 WebShop 动作', 'the current comparison fixes the same model; it chooses WebShop actions itself')],
  [t('提示与动作层', 'Prompt and action layer'), 'SEED / OpenEvo', t('各自负责提示、历史和动作解析；这一交互层不提供具体购物答案', 'each owns its prompts, history, and action parsing; this interaction layer does not supply shopping answers')],
  [t('任务环境', 'Environment'), 'Princeton WebShop', t('返回页面观察、任务分数和状态变化', 'returns page observations, task scores, and state changes')],
  [t('保存完整过程', 'Sealed trajectory'), t('一次完整任务', 'One completed task'), t('任务结束后才把整条交互记录固定下来', 'freezes the full interaction record only after the task ends')],
  [t('任务后复盘', 'Post-task review'), t('外部分析模型', 'External analysis model'), t('只在任务结束后读取已保存的轨迹', 'reads the saved trajectory only after task completion')],
  [t('交给后续学习', 'Handoff'), t('成功轨迹 + 任务后复盘', 'successful traces + post-task review'), t('作为后续持续学习阶段（Stage 2）的可追溯输入；具体经验或参数状态由这一阶段决定', 'becomes traceable input to Stage 2; Stage 2 decides the resulting experience or parameter state')],
] as const;
---
<div class="training-design-body">
  <p class="comparison-boundary">{t('完整系统比较只能回答两套系统总体表现有什么差异；如果要把后续差异归因到持续学习阶段（Stage 2）的学习器，两边还必须共享 Stage 1 轨迹、任务后复盘、训练配方和同一个起点模型。', 'A full-system comparison only answers how the two systems differ overall. To attribute a later difference to the Stage-2 learner, both sides must also share Stage-1 trajectories, post-task review, the training recipe, and the same starting model.')}</p>
  <ol class="responsibility-flow" aria-label={t('Stage 1 责任边界', 'Stage-1 responsibility flow')}>
    {stages.map((stage, index) => (
      <li>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <div><small>{stage[0]}</small><strong>{stage[1]}</strong><p>{stage[2]}</p></div>
      </li>
    ))}
  </ol>
  <p class="stage2-bridge">{t('Stage 1 留下可追溯的成功轨迹和任务后复盘。Stage 2（持续学习阶段）用这些输入分别产生文字记忆、技能、全局行为规则或 LoRA 参数的新版本；每一类状态都有实验开始前固定的更新条件：满足条件就采用新版本，不满足就沿用上一版。最后采用的版本才装入下一批任务。早期 Stage 1 / LoRA-vs-SD-LoRA 对照没有同时启用这四类状态。', 'Stage 1 leaves traceable successful trajectories and post-task review. Stage 2 (continual learning) uses those inputs to produce new versions of written memory, reusable skills, global behavior rules, or LoRA parameters. Each state type has update conditions frozen before the experiment: if the conditions pass, the new version is adopted; otherwise the prior version remains. Only the adopted versions are loaded into the next task batch. Earlier Stage-1 and LoRA-vs-SD-LoRA comparisons did not enable all four states together.')}</p>

  <section class="comparison-scope" data-learning-comparison-scope aria-labelledby="comparison-scope-title">
    <h3 id="comparison-scope-title">{t('比较口径决定差异能归因到哪里', 'The comparison scope determines what can explain a difference')}</h3>
    <div class="comparison-table-wrap">
      <table>
        <thead><tr><th scope="col">{t('比较口径', 'Comparison')}</th><th scope="col">{t('哪些条件保持一致', 'What stays aligned')}</th><th scope="col">{t('可以支持什么结论', 'What the result can support')}</th></tr></thead>
        <tbody>
          <tr><th scope="row">{t('完整系统比较', 'Full-system comparison')}</th><td>{t('模型、任务、评分和训练预算尽量一致；SEED 与 OpenEvo 可以使用各自的提示、历史与动作解析层。', 'Keep model, tasks, scoring, and training budget aligned; SEED and OpenEvo may use their own prompt, history, and action-parsing layers.')}</td><td>{t('只能比较两个完整系统的总体表现，不能把全部差异单独归因于 Stage 2 学习器。', 'Supports a comparison of the complete systems, not attribution of the whole difference to the Stage-2 learner alone.')}</td></tr>
          <tr><th scope="row">{t('只比较 Stage 2 学习器', 'Stage-2 learner only')}</th><td>{t('共享 Stage 1 轨迹、事后分析、监督微调（SFT）训练配方和同一个起点模型保存点（checkpoint，也就是一版固定参数），再从这里分成 SEED Stage 2 与 OpenEvo Stage 2。', 'Share Stage-1 trajectories, post-task analysis, the SFT recipe, and the same starting checkpoint — one fixed parameter snapshot — before forking into SEED Stage 2 and OpenEvo Stage 2.')}</td><td>{t('只有这种共同起点的对照，才允许把后续差异收窄到 Stage 2 学习器。', 'Only this common-start comparison can narrow a later difference to the Stage-2 learner.')}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <div class="design-disclosures">
    <ResearchTechnicalDisclosure
      eyebrow={false}
      summary={t('当前 Stage 1 参数协议', 'Current Stage-1 parameter protocol')}
    >
      <dl class="parameter-list">
        <div><dt>temperature</dt><dd>0.4</dd></div>
        <div><dt>top-p / top-k</dt><dd>1.0 / off</dd></div>
        <div><dt>max steps / output</dt><dd>15 / 512</dd></div>
        <div><dt>history length</dt><dd>2</dd></div>
        <div><dt>rollout seeds</dt><dd>{t('8 个不同且冻结', '8 distinct and frozen')}</dd></div>
        <div><dt>malformed regeneration</dt><dd>0</dd></div>
      </dl>
      <p class="parameter-note">{t('这些值属于采样与公平协议；它们不是装饰性默认值。旧 temperature=0 的 1,440 rollout 因为高度重复，应作为 greedy ablation 理解，而不是当前 primary。', 'These values belong to the sampling and fairness protocol. The old temperature=0 1,440-rollout run was highly repetitive and should be interpreted as a greedy ablation, not the current primary.')}</p>
    </ResearchTechnicalDisclosure>
  </div>

  <p class="design-next"><a href={p('/research/seed-openevo/study/run/')}>{t('按这个协议运行实验', 'Run the experiment with this protocol')} →</a></p>
</div>

<style>
  .comparison-boundary{max-width:82ch;margin:0 0 .85rem;padding:0 0 .75rem;border-bottom:1px solid var(--line);color:var(--muted);font-size:.78rem;line-height:1.6}.responsibility-flow{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.45rem;margin:0;padding:0;list-style:none}
  .responsibility-flow li{position:relative;min-width:0;padding:.8rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface)}
  .responsibility-flow li:not(:last-child)::after{content:'→';position:absolute;z-index:2;right:-.38rem;top:50%;transform:translateY(-50%);padding:.05rem;background:var(--surface);color:var(--muted);font-size:.8rem}
  .responsibility-flow li>span{color:var(--accent-deep);font:800 .64rem/1 var(--font-mono)}
  .responsibility-flow small,.responsibility-flow strong{display:block}
  .responsibility-flow small{margin-top:.6rem;color:var(--muted);font-size:.65rem}
  .responsibility-flow strong{margin-top:.15rem;font-size:.82rem}
  .responsibility-flow p{margin:.35rem 0 0;color:var(--muted);font-size:.69rem;line-height:1.45}
  .stage2-bridge{margin:.9rem 0 0;padding:.85rem 0;border-top:1px solid var(--line);color:var(--muted);font-size:.76rem;line-height:1.6}
  .comparison-scope{margin-top:.45rem;padding:1rem 0;border-top:1px solid var(--line)}
  .comparison-scope h3{margin:0 0 .65rem;font-size:.9rem}
  .comparison-table-wrap{max-width:100%;overflow-x:auto}
  .comparison-scope table{width:100%;min-width:660px;border-collapse:collapse;font-size:.72rem;line-height:1.5}
  .comparison-scope th,.comparison-scope td{padding:.65rem .7rem;border-top:1px solid var(--line);text-align:left;vertical-align:top}
  .comparison-scope thead th{color:var(--muted);font-size:.66rem;font-weight:760}
  .comparison-scope tbody th{width:18%;font-size:.74rem}
  .comparison-scope tbody td{color:var(--muted)}
  .design-disclosures{display:grid;gap:.35rem;margin-top:.35rem}
  .parameter-note{margin:.35rem 0 0;color:var(--muted);font-size:.71rem;line-height:1.55}
  .parameter-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.35rem;padding:.75rem .75rem 0;margin:0}
  .parameter-list div{display:flex;justify-content:space-between;gap:.7rem;padding:.45rem 0;border-bottom:1px solid var(--line)}
  .parameter-list dt{color:var(--muted);font-size:.68rem}
  .parameter-list dd{margin:0;font-size:.7rem;font-weight:700}
  .parameter-note{padding:0 .75rem .75rem}
  .design-next{margin:.8rem 0 0 3.05rem}
  .design-next a{font-size:.74rem;font-weight:750}
  @media(max-width:950px){
    .responsibility-flow{grid-template-columns:repeat(3,minmax(0,1fr))}
    .responsibility-flow li:nth-child(3)::after{display:none}
  }
  @media(max-width:640px){
    .design-next{margin-left:0}
    .responsibility-flow{grid-template-columns:1fr}
    .responsibility-flow li:not(:last-child)::after{content:'↓';right:auto;left:50%;top:auto;bottom:-.52rem;transform:translateX(-50%)}
    .parameter-list{grid-template-columns:1fr}
  }
</style>
