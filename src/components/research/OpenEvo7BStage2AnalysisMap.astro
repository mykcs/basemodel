---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  firstRun: p('/research/seed-openevo/study/capability-exploration/first-run/'),
  oldStage2: p('/research/seed-openevo/study/capability-exploration/stage2-256-window/'),
  ceiling: p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/'),
  archive: p('/research/seed-openevo/study/capability-exploration/archive/'),
};

const evidence = [
  {
    href: 'https://wandb.ai/zju-openevo-wangrui/zju-openevo-experiments',
    eyebrow: t('观测平台', 'OBSERVABILITY'),
    title: 'Weights & Biases · zju-openevo-experiments',
    note: t("训练曲线和参数更新观测；科学结论还需对应的固定配置、运行记录与 Git 证据。", "Training curves and parameter-update observations; scientific claims also need matching fixed configurations, run records, and Git evidence."),
  },
  {
    href: 'https://github.com/mykcs/openevo-experiment/blob/8692bf6dfbfdb948b7f6a7229fb65f26a49566a9/docs/troubleshooting/experiment-ops/CASE-CEILING1-END-TO-END-SCIENCE-ENGINEERING-RETROSPECTIVE-20260831.md',
    eyebrow: t('Ceiling-1.0 经验沉淀', 'CEILING-1.0 RETROSPECTIVE'),
    title: t("参数差、容量限制与来源记录", "Task vectors, capacity limits, and provenance"),
    note: t("记录参数差分析仅用于诊断的边界，不能凭几何曲线自动改变这条实验的训练规则。", "Records the diagnostic-only boundary: geometry does not automatically change the training rule in this experiment."),
  },
  {
    href: 'https://github.com/mykcs/openevo-experiment/blob/8692bf6dfbfdb948b7f6a7229fb65f26a49566a9/docs/science/webshop/reports/OPEN_EVO_WEBSHOP_H1_38A_COMBINED_AND_NEXT_2026-08-19.md',
    eyebrow: t('更早的 7B 参数机制对照', 'EARLIER 7B PARAMETER-MECHANISM CONTROL'),
    title: t("新任务迁移分析 · H1.38A", "New-task transfer analysis · H1.38A"),
    note: t("独立的历史 7B 对照，比较可训练的参数增量与新任务上的实际收益。", "An independent historical 7B control comparing trainable parameter increments with gains on new tasks."),
  },
  {
    href: 'https://github.com/mykcs/basemodel/blob/main/docs/agents/current/seed-openevo-research-ia-factual-debt-2026-09-03.md',
    eyebrow: t('网站事实边界', 'WEBSITE FACT BOUNDARY'),
    title: t("旧运行计数的来源核查", "Source audit of historical run counters"),
    note: t("2026-09-03 的核查记录：旧运行快照部分计数尚未对应到固定版本原始记录，不能作为已核实数字引用。", "The 2026-09-03 audit records that some old snapshot counters lacked immutable source binding and could not be cited as verified values."),
  },
];
---

<main data-copy-review class="stage2-map" data-testid="openevo-7b-stage2-analysis-map">
  <header class="stage2-map__head">
    <a href={links.lobby}>{t('← OpenEvo 能力探索', '← OpenEvo capability exploration')}</a>
    <p>{t("7B 后续学习 · 历史参数分析", "7B STAGE 2 · HISTORICAL PARAMETER ANALYSIS")}</p>
    <h1>{t("7B 后续学习与参数分析", "7B learning and parameter analysis")}</h1>
    <strong>{t("7B 模型在模拟商店里完成购物，再用成功经验更新模型内部的数值（参数）。历史实验先遇到更新门槛过高、参数始终不变的问题；修改规则后，模型确实产生了参数更新。", "The 7B model attempts shopping tasks and uses successful experience to update its internal parameters. An overly strict update rule initially prevented every update; a revised rule allowed real parameter updates.")}</strong>
    <span>{t("参数更新说明训练发生了；要知道购物能力有没有提高，还要在未用于训练的任务上比较表现。Ceiling-1.0 的持续学习记录与更早的 7B 参数对照来自不同实验，不能合并成一次运行。", "Parameter updates show that training occurred. Improvement requires a separate comparison on tasks not used for training. Ceiling-1.0 and the earlier 7B parameter controls are separate experiments.")}</span>
  </header>

  <section class="authority-strip" aria-label={t("历史证据范围", "Scope of historical evidence")}>
    <div>
      <span>{t('可以继续引用', 'SAFE TO REUSE')}</span>
      <strong>{t("旧规则：成功经验未触发参数更新", "Old rule: successful experience triggered no parameter updates")}</strong>
    </div>
    <div>
      <span>{t('可以继续引用', 'SAFE TO REUSE')}</span>
      <strong>{t("修订规则：按轮更新参数，分析指标仅用于诊断", "Revised rule: round-based updates, with diagnostic-only analysis")}</strong>
    </div>
    <div>
      <span>{t('暂不复制', 'DO NOT REPRINT YET')}</span>
      <strong>{t("旧运行快照的精确轮次与更新次数，仍需对应的固定版本记录", "Exact counters from older run snapshots still require matching immutable records")}</strong>
    </div>
  </section>

  <section class="story" aria-labelledby="stage2-story-title">
    <header>
      <p>{t("持续学习实验 · Ceiling-1.0", "LEARNING EXPERIMENT · CEILING-1.0")}</p>
      <h2 id="stage2-story-title">{t("7B 学习规则的变化", "Changes to the 7B learning rule")}</h2>
    </header>

    <div class="spine">
      <article class="node node--history">
        <span>00 · {t("旧版实验", "PREDECESSOR")}</span>
        <h3>{t("旧规则与零次参数更新", "Old rule and zero parameter updates")}</h3>
        <p>{t("旧实验的 7B/self 组完成了 20,480 次购物尝试，其中 797 条完整成功记录符合训练候选条件。规则把每 256 次尝试单独检查：同一批至少要有 8 个不同任务各完整成功 2 次，才允许更新参数。最好的一批只有 7 个，所以 80 批都没有触发参数更新。这是当时的实验门槛，不是 OpenEvo 的永久规则。", "The historical 7B/self run completed 20,480 shopping attempts, including 797 exact-success traces eligible for training. Each batch of 256 attempts needed at least eight distinct tasks with two exact successes each before parameters could update. The best batch reached seven, so all 80 batches produced no updates. This was the historical experiment rule, not a permanent OpenEvo requirement.")}</p>
        <a href={links.oldStage2}>{t('看旧 Stage 2 的完整证据 →', 'Open the full old Stage-2 evidence →')}</a>
      </article>
      <span class="connector"></span>

      <article class="node node--amend">
        <span>01 · {t("学习规则修订", "LEARNING-RULE AMENDMENT")}</span>
        <h3>{t("修订后的每轮学习规则", "Revised round-based learning rule")}</h3>
        <p>{t("Ceiling-1.0 每轮完成 16 个任务、每个尝试 8 次，共 128 次购物。只要本轮至少有一个任务留下符合质量要求的完整成功记录，就允许训练一个小的参数增量（SD-LoRA）；没有成功记录时参数保持不变。成功记录不跨轮累积成另一道门槛。", "Each Ceiling-1.0 round contains 16 tasks with eight attempts each: 128 shopping attempts. At least one clean exact-success trace permits training a small parameter increment with SD-LoRA. Without one, parameters remain unchanged. Successes are not accumulated across rounds into another gate.")}</p>
        <a href={links.ceiling}>{t('打开 Ceiling-1.0 历史规则页 →', 'Open the historical Ceiling-1.0 design →')}</a>
      </article>
      <span class="connector"></span>

      <article class="node node--main node--current">
        <span>02 · {t("参数更新证据", "UPDATE EVIDENCE")}</span>
        <h3>{t("已发生的参数更新", "Observed parameter updates")}</h3>
        <p>{t("Ceiling-1.0 的历史记录确认 7B 产生了真实的 SD-LoRA 参数更新，说明成功经验已经进入参数训练。旧运行快照中的精确轮次与组件数，仍需逐项匹配固定版本的原始记录；这些计数的缺口不等于没有发生训练。", "Historical Ceiling-1.0 evidence confirms real SD-LoRA parameter updates in 7B, showing that successful experience reached parameter training. Exact round and component counters from older snapshots still need matching immutable records; missing counter provenance does not mean training never occurred.")}</p>
      </article>
      <span class="connector"></span>

      <article class="node node--diagnostic">
        <span>03 · {t("参数诊断", "PARAMETER DIAGNOSTICS")}</span>
        <h3>{t("参数变化的幅度与方向", "Magnitude and direction of parameter changes")}</h3>
        <p>{t("比较两个已保存模型的参数，得到参数差向量（Task Vector）。它的长度表示改动幅度；相邻差向量的相似度表示两次更新是否朝相近方向。累计路径和有效秩等指标补充描述变化结构。这些数能帮助发现异常，却不能单独证明下一轮应该怎样调整学习率、参数容量或停止条件。", "Subtracting the parameters of two saved models gives a task vector. Its norm measures update magnitude; similarity between adjacent vectors measures whether updates point in similar directions. Path length and effective rank describe further structure. These diagnostics do not by themselves establish how to adjust learning rate, capacity, or stopping rules.")}</p>
        <strong>{t("这条历史实验中的参数分析只做诊断，不自动控制训练。", "Parameter analysis in this historical experiment was diagnostic only; it did not automatically control training.")}</strong>
      </article>
      <span class="connector"></span>

      <article class="node node--amend">
        <span>04 · {t("容量修订", "CAPACITY AMENDMENT")}</span>
        <h3>{t("参数更新次数的容量限制", "Capacity limit on parameter updates")}</h3>
        <p>{t("每次 SD-LoRA 更新会增加一个参数组件（component）。原实现最多允许 64 个组件，即使购物尝试预算还有剩余，也会停止新增更新。7B 实验因此单独修订了容量限制。后来的降秩与压缩属于另行研究，不能回写为这次训练已经使用的方法。", "Each SD-LoRA update adds a parameter component. The original implementation allowed at most 64 components, stopping new updates even with shopping budget remaining. The 7B experiment therefore made an explicit capacity amendment. Later rank reduction and compression belong to separate studies and were not part of this training run.")}</p>
      </article>
      <span class="connector"></span>

      <article class="node node--main">
        <span>05 · {t("结论范围", "CLAIM SCOPE")}</span>
        <h3>{t("参数学习与新任务表现", "Parameter learning and performance on new tasks")}</h3>
        <p>{t("更早的独立 7B 对照中，成功经验能训练出可重新加载、可完成评测的参数增量，但在新任务上没有稳定的正向收益。因此，“训练确实发生”与“未见任务上的表现可靠提高”需要分别验证，不能仅凭参数变化推断泛化效果。", "In earlier independent 7B controls, successful experience produced parameter increments that could be reloaded and evaluated, yet gains on new tasks were not reliably positive. Training execution and reliable improvement on unseen tasks therefore require separate evidence.")}</p>
      </article>
    </div>
  </section>

  <section class="side-study" aria-labelledby="side-study-title">
    <header>
      <p>{t("独立的历史 7B 对照", "INDEPENDENT HISTORICAL 7B CONTROL")}</p>
      <h2 id="side-study-title">{t("独立对照：训练任务的多样性", "Independent control: training-task diversity")}</h2>
    </header>
    <div>
      <strong>{t("独立对照检验：同样来自模型自身的成功经验，覆盖更多不同购物任务，能否改善新任务表现？", "The independent control asks whether self-generated successes from more distinct shopping tasks improve performance on new tasks.")}</strong>
      <p>{t("这项独立对照汇总了 192 个评测单元、768 次尝试，没有发现“训练任务种类越多，新任务表现就越好”的单调关系。D16 组的平均变化最高，但置信区间仍包含 0，无法排除偶然波动。后续研究因此需要分别测量学会训练任务、保留已有能力和迁移到未见任务的效果。", "Across 192 evaluation cells and 768 attempts, the independent control did not show monotonically better transfer with more distinct training tasks. D16 had the highest mean change, but its confidence interval included zero. Follow-up work needs separate measures of acquisition, retention, and transfer to unseen tasks.")}</p>
    </div>
  </section>

  <section class="evidence" aria-labelledby="stage2-evidence-title">
    <header>
      <p>{t("数据来源", "SOURCE EVIDENCE")}</p>
      <h2 id="stage2-evidence-title">{t("训练曲线与原始证据", "Training curves and source evidence")}</h2>
      <span>{t("W&B 展示训练变化；实验配置与原始记录说明这些变化属于哪个模型、哪组任务和哪条实验。", "W&B shows training changes; configurations and original records identify the model, tasks, and experiment behind them.")}</span>
    </header>
    <nav>
      {evidence.map((item) => (
        <a href={item.href} target="_blank" rel="noreferrer">
          <small>{item.eyebrow}</small>
          <strong><ExternalBrandMark href={item.href} />{item.title}</strong>
          <span>{item.note}</span>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </nav>
  </section>

  <footer class="stage2-map__footer">
    <a href={links.firstRun}>{t('← 回到第一轮 7B / 3B 历史地图', '← Back to the first-run 7B / 3B map')}</a>
    <a href={links.archive}>{t('打开完整实验档案 →', 'Open the full experiment archive →')}</a>
  </footer>
</main>

<style>
.stage2-map{width:min(1120px,calc(100% - 2rem));margin:0 auto 4rem}.stage2-map__head{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:.55rem 1.6rem;align-items:end;padding:1.35rem 0 1.4rem;border-bottom:1px solid var(--line)}.stage2-map__head>a{grid-column:1/-1;width:max-content;color:var(--muted);font-size:1rem;text-decoration:none}.stage2-map__head>p{grid-column:1/-1;margin:.2rem 0;color:var(--accent-deep);font:800 1rem/1.3 var(--font-mono);letter-spacing:.09em}.stage2-map__head h1{grid-column:1;margin:0;font-size:clamp(1.9rem,3.5vw,2.8rem);line-height:1.3;letter-spacing:-.025em}.stage2-map__head strong,.stage2-map__head span{grid-column:2;display:block}.stage2-map__head strong{font-size:1.04rem;line-height:1.55}.stage2-map__head span{color:var(--muted);font-size:1rem;line-height:1.65}.authority-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-bottom:1px solid var(--line)}.authority-strip div{display:grid;gap:.25rem;padding:.8rem;border-right:1px solid var(--line)}.authority-strip div:last-child{border-right:0}.authority-strip span{color:var(--muted);font:750 1rem/1.2 var(--font-mono)}.authority-strip strong{font-size:1rem;line-height:1.45}.story{padding:1.35rem 0}.story>header{display:grid;grid-template-columns:minmax(180px,.45fr) minmax(0,1.55fr);gap:1rem;margin-bottom:1rem}.story>header p{margin:0;color:var(--accent-deep);font:800 1rem/1.3 var(--font-mono);letter-spacing:.08em}.story h2{margin:0;font-size:1.35rem;line-height:1.15}.spine{display:grid;justify-items:center}.node{width:min(760px,100%);padding:1.05rem 1.15rem;border:1px solid var(--line);border-radius:var(--radius-feature);background:var(--surface)}.node>span{display:block;margin-bottom:.42rem;color:var(--muted);font:800 1rem/1.2 var(--font-mono);letter-spacing:.07em}.node h3{margin:0 0 .48rem;font-size:1.17rem;line-height:1.18}.node p{margin:0;color:var(--muted);font-size:1rem;line-height:1.62}.node>a{display:inline-block;margin-top:.65rem;color:var(--accent-deep);font-size:1rem;font-weight:760;text-underline-offset:.2em}.node--amend{width:min(700px,95%);border-style:double;border-width:3px}.node--history{width:min(700px,95%);background:var(--surface-muted)}.node--current{border-color:var(--accent);box-shadow:inset 4px 0 0 var(--accent)}.node--diagnostic{width:min(690px,94%);border-radius:var(--radius-panel)}.node--diagnostic>strong{display:block;margin-top:.65rem;padding-top:.6rem;border-top:1px solid var(--line);font-size:1rem}.connector{width:2px;height:2rem;background:var(--line)}.side-study{display:grid;grid-template-columns:minmax(220px,.55fr) minmax(0,1.45fr);gap:1.1rem;padding:1.2rem 0;border-top:1px solid var(--line)}.side-study header p{margin:0;color:var(--muted);font:800 1rem/1.2 var(--font-mono);letter-spacing:.06em}.side-study h2{margin:.35rem 0 0;font-size:1.15rem}.side-study>div{padding:.85rem 1rem;border-left:3px solid var(--line)}.side-study>div strong{font-size:1rem;line-height:1.5}.side-study>div p{margin:.5rem 0 0;color:var(--muted);font-size:1rem;line-height:1.58}.evidence{display:grid;grid-template-columns:minmax(220px,.55fr) minmax(0,1.45fr);gap:1rem;padding:1.25rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.evidence header p{margin:0;color:var(--accent-deep);font:800 1rem/1.2 var(--font-mono);letter-spacing:.07em}.evidence h2{margin:.35rem 0 .4rem;font-size:1.15rem}.evidence header span{display:block;color:var(--muted);font-size:1rem;line-height:1.52}.evidence nav{display:grid;gap:.55rem}.evidence nav>a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.2rem .7rem;padding:.72rem .8rem;border:1px solid var(--line);border-radius:var(--radius-panel);color:inherit;text-decoration:none}.evidence nav>a:hover,.evidence nav>a:focus-visible{border-color:var(--accent)}.evidence nav small{color:var(--accent-deep);font:800 1rem/1.2 var(--font-mono);letter-spacing:.05em}.evidence nav strong{display:flex;align-items:center;gap:.38rem;font-size:1rem}.evidence nav span{color:var(--muted);font-size:1rem;line-height:1.45}.evidence nav b{grid-column:2;grid-row:1/span 3;align-self:center;color:var(--accent-deep)}.stage2-map__footer{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0}.stage2-map__footer a{color:var(--accent-deep);font-size:1rem;font-weight:750;text-underline-offset:.2em}@media(max-width:760px){.stage2-map{width:min(100% - 1rem,1120px)}.stage2-map__head{grid-template-columns:1fr;gap:.55rem;padding:1rem 0}.stage2-map__head>a,.stage2-map__head>p,.stage2-map__head h1,.stage2-map__head strong,.stage2-map__head span{grid-column:auto}.stage2-map__head h1{font-size:clamp(1.9rem,3.5vw,2.8rem)}.authority-strip{grid-template-columns:1fr}.authority-strip div{border-right:0;border-bottom:1px solid var(--line)}.authority-strip div:last-child{border-bottom:0}.story>header,.side-study,.evidence{grid-template-columns:1fr}.story>header{gap:.3rem}.node,.node--amend,.node--history,.node--diagnostic{width:100%}.stage2-map__footer{display:grid}}
</style>

