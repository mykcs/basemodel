---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import OpenEvoHarnessFairnessPanel from './OpenEvoHarnessFairnessPanel.astro';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchJourney from './ResearchJourney.astro';
import ResearchDepth from './ResearchDepth.astro';
import { OPEN_EVO_CEILING_PRINCIPLE, OPEN_EVO_EVIDENCE_LINKS, OPEN_EVO_STAGE1_FREEZE, OPEN_EVO_STAGE1_METRICS } from '../../data/openEvoSuccessorNarrative';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const principle = zh ? OPEN_EVO_CEILING_PRINCIPLE.zh : OPEN_EVO_CEILING_PRINCIPLE.en;
const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  gateway: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/'),
  report: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/report/'),
  firstRun: p('/research/seed-openevo/study/capability-exploration/first-run/'),
  archive: p('/research/seed-openevo/study/capability-exploration/archive/'),
};
const arm3 = OPEN_EVO_STAGE1_METRICS[0];
const arm17 = OPEN_EVO_STAGE1_METRICS[1];
const terms = zh ? [
  { term: '假设 / diagnostic', meaning: '用一个小而受控的实验排查“为什么 3B 表现差”，不是正式结果 arm。' },
  { term: '证伪', meaning: '某个解释没有被配对证据支持，因此下一步不再把它当成主要根因。' },
  { term: 'shared freeze', meaning: '多轮诊断后才允许固定的一套 3B + 1.7B 公共 Harness 与 Stage1 合同。' },
  { term: 'engineering fix', meaning: '修复执行/路径/readback 问题，但不改变科学问题、模型身份或预算。' },
] : [
  { term: 'hypothesis / diagnostic', meaning: 'A small controlled test of why 3B behavior is weak, not a formal result arm.' },
  { term: 'falsified', meaning: 'The paired evidence did not support an explanation strongly enough to keep it as the main cause.' },
  { term: 'shared freeze', meaning: 'The common 3B + 1.7B harness and Stage-1 contract frozen only after the diagnostic sequence.' },
  { term: 'engineering fix', meaning: 'A repair to execution, paths, or readback that does not change the scientific question, model identity, or budget.' },
];
const summarySteps = zh ? [
  { id: 'symptom', kicker: '问题', title: '3B 的轨迹太弱，但不能直接归因于“模型小”', summary: 'exact success 稀少，同时 invalid / serialization 问题很多。', detail: '于是研究先问：这是模型能力上限，还是 Harness 把本来可执行的意图测坏了？', outcome: '把“模型不行”和“接口测坏”拆成可检验的两个解释。', state: '起点' },
  { id: 'falsify', kicker: '证伪', title: '先排除几个直觉解释：更多步数、sampling、history 都不够', summary: '30-step paired delta=0；T=1.0 和 SEED-native history 会改行为，但都不能单独解释恢复。', detail: '这些小实验没有白跑：它们把搜索范围从“给模型更多机会”缩到 prompt / deliberation / action channel。', outcome: '研究从宽泛调参转向接口语义。', state: '3 条路被排除' },
  { id: 'interface', kicker: '更强线索', title: '真正值得追的是自我推理被删掉，以及合法动作被格式化破坏', summary: '恢复 model-authored brief reasoning，并把 mechanical invalidity 从能力评估里拆出去。', detail: 'Harness 可以拥有 action opener 和合法动作 envelope，但不能替模型从合法动作里挑答案。', outcome: '得到一个既能合法交互、又不教 WebShop 策略的候选 Harness。', state: '候选形成' },
  { id: 'freeze', kicker: '配对验证', title: '同一个候选必须同时过 3B 和 1.7B，才冻结 shared Stage1', summary: `最终冻结 ${OPEN_EVO_STAGE1_FREEZE.id}：每个模型 ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} 条，T=${OPEN_EVO_STAGE1_FREEZE.temperature}，max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}。`, detail: '不能为 3B 单独加“更会做题”的 Harness；模型差异允许存在，model-ID-specific strategy 不允许。', outcome: '从诊断阶段进入真正可比较的 canonical Stage1。', state: '已冻结' },
  { id: 'after-seal', kicker: '封存以后', title: '先看 raw 起跑线，再让 MiniMax 批改，最后处理 carrier 容量', summary: `${arm3.model}: ${arm3.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact；${arm17.model}: ${arm17.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact。随后 MiniMax post-hoc，4096 失败后才触发 bounded 10+10。`, detail: 'PRE_STAGE2_READY 只说明下游材料可加载；Stage2 仍需独立 activation。', outcome: '探索地图在“ready ≠ authorized”处停止。', state: 'Stage1 已收口' },
] : [
  { id: 'symptom', kicker: 'PROBLEM', title: '3B trajectories were weak, but “the model is small” was not enough', summary: 'Exact success was sparse while invalid / serialization behavior was common.', detail: 'The research question became whether this was a capability ceiling or a harness that corrupted measurement.', outcome: 'Separate model inability from interface-induced failure.', state: 'Starting point' },
  { id: 'falsify', kicker: 'FALSIFY', title: 'Rule out simple explanations: more steps, sampling, and history are not enough', summary: 'The 30-step paired delta was zero; T=1.0 and SEED-native history changed behavior but did not explain recovery alone.', detail: 'These diagnostics narrowed the search from generic tuning toward prompt, deliberation, and the action channel.', outcome: 'Move from broad tuning to interface semantics.', state: '3 branches rejected' },
  { id: 'interface', kicker: 'STRONGER CLUE', title: 'The stronger clue was removed self-deliberation plus broken legal-action serialization', summary: 'Restore model-authored brief reasoning and separate mechanical invalidity from capability.', detail: 'The harness may own the action opener and legal-action envelope but may not choose the answer for the model.', outcome: 'A strategy-neutral harness candidate emerges.', state: 'Candidate formed' },
  { id: 'freeze', kicker: 'PAIRED CHECK', title: 'The same candidate must pass on both 3B and 1.7B before the shared freeze', summary: `Freeze ${OPEN_EVO_STAGE1_FREEZE.id}: ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} trajectories per model, T=${OPEN_EVO_STAGE1_FREEZE.temperature}, max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}.`, detail: 'The models may differ, but model-ID-specific solving strategies are forbidden.', outcome: 'Diagnostics become a comparable canonical Stage 1.', state: 'Frozen' },
  { id: 'after-seal', kicker: 'AFTER SEAL', title: 'Read the raw starting point, then MiniMax review, then bounded carrier recovery', summary: `${arm3.model}: ${arm3.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact; ${arm17.model}: ${arm17.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact. MiniMax enters post hoc; 4096 fails before bounded 10+10.`, detail: 'PRE_STAGE2_READY means downstream artifacts are loadable, not that Stage 2 is authorized.', outcome: 'The exploration stops at “ready ≠ authorized.”', state: 'Stage1 closed' },
];
---
<main class="explore-map" data-testid="openevo-successor-exploration-map">
  <ResearchOrientation
    locale={locale}
    eyebrow="ROGUELIKE RESEARCH MAP · EXPLORATION"
    title={t('3B 为什么这么弱？', 'Why was 3B so weak?')}
    lede={t('探索版保留真正改变设计的失败假设和回退，但先给你一条 5 步摘要。完整诊断树仍可展开审计，不再要求第一次来的读者把所有工程枝杈都读完。', 'Start with five decisions that changed the design. The full diagnostic tree remains available below for audit.')}
    question={t('3B 为什么这么弱：真的是模型能力不够，还是 Harness / action channel 把能力测坏了？', 'Was weak 3B behavior a capability limit, or did the harness / action channel corrupt the measurement?')}
    why={t('如果根因是接口，我们不能拿被接口破坏的轨迹去证明“模型不会”；如果根因是能力，我们也不能靠更会做题的 Harness 把结果救回来。', 'If the harness caused failure, weak trajectories cannot prove model inability; if capability did, task-solving help cannot be used to rescue it.')}
    start={t('从第一轮 3B 的 weak trajectories 和 high invalid/serialization behavior 开始。', 'Start from the first 3B campaign: weak trajectories plus invalid / serialization failures.')}
    finish={t(`在 ${OPEN_EVO_STAGE1_FREEZE.id} shared Stage1 封存、MiniMax post-hoc 与 bounded carrier 准备完成后停在 PRE_STAGE2_READY；Stage2 仍需独立授权。`, `Stop at PRE_STAGE2_READY after freeze ${OPEN_EVO_STAGE1_FREEZE.id}, MiniMax review, and bounded-carrier preparation; Stage 2 needs separate authority.`)}
    state={t('探索结论已经形成并冻结；这页是形成过程，不是一个仍在调参的 live notebook。', 'The exploration conclusion is frozen; this page explains how it formed.')}
    stateTone="sealed"
    backHref={links.gateway}
    backLabel={t('两种读法', 'Two reading modes')}
    actionHref="#exploration-summary"
    actionLabel={t('先看五步摘要', 'Start with the five-step summary')}
    terms={terms}
  />

  <blockquote class="explore-map__principle" data-principle>
    <span>{t('这条路始终不变的约束', 'THE CONSTRAINT THAT STAYS FIXED')}</span>
    <strong>{principle}</strong>
  </blockquote>

  <nav class="explore-map__switch" aria-label={t('切换叙事版本', 'Switch narrative view')}>
    <b>{t('当前：探索版', 'Current: Exploration')}</b>
    <a href={links.report}>{t('切到报告与论文版 →', 'Switch to report / paper →')}</a>
  </nav>

  <div id="exploration-summary">
    <ResearchJourney
      locale={locale}
      eyebrow="HYPOTHESIS → TEST → DECISION"
      title={t('先用五步看懂：每次失败到底改变了什么', 'Start with five steps: what did each failure actually change?')}
      intro={t('摘要只保留会改变下一步科学设计的证据；完整的 30-step、sampling、history、readback、4096 等细节在下面可展开。', 'The summary keeps only evidence that changed the next scientific decision. Full 30-step, sampling, history, readback, 4096, and other details remain expandable below.')}
      steps={summarySteps}
    />
  </div>

  <ResearchDepth
    locale={locale}
    kind="history"
    summary={t('完整探索路线：所有假设、证伪、工程修复与 freeze 证据', 'Complete exploration route: every hypothesis, falsification, engineering repair, and freeze')}
    intro={t('这里保留完整研究历史，供复盘和审计；这些 historical predecessor diagnostics 不混成同一个实验批次，也不会被改名接到 current freeze。第一次阅读不需要打开。', 'The complete research history is preserved here for reconstruction and audit. Historical predecessor diagnostics are not relabeled or mixed into the current experiment batch; a first reading does not require opening it.')}
  >
  <section class="explore-legend" aria-label={t('探索地图图例', 'Exploration map legend')}>
    <span><i class="is-main"></i>{t('主线', 'Mainline')}</span>
    <span><i class="is-test"></i>{t('小实验 / 假设', 'Diagnostic / hypothesis')}</span>
    <span><i class="is-backtrack"></i>{t('证伪后回退', 'Falsified → backtrack')}</span>
    <span><i class="is-fix"></i>{t('工程修复', 'Engineering fix')}</span>
    <span><i class="is-freeze"></i>{t('科学 freeze / boundary', 'Scientific freeze / boundary')}</span>
  </section>

  <section class="explore-spine" aria-label={t('3B 与 1.7B successor 的探索路线', 'Exploration path for the 3B and 1.7B successor')}>
    <article class="quest quest--main" data-quest="start">
      <span>00 · START · HISTORICAL PREDECESSOR</span>
      <h2>{t('先承认一个事实：3B 的轨迹质量太差，不能只怪模型小', 'Start with an uncomfortable fact: 3B trajectories were too weak to blame size alone')}</h2>
      <p>{t('第一轮 7B / 3B 实验已经证明 OpenEvo 可以进入持续学习，但 3B 上 exact success 很稀、invalid/serialization 行为又多。研究问题于是变成：到底是能力上限，还是 Harness 把能力测坏了？', 'The first 7B / 3B campaign showed that OpenEvo could enter sustained learning, but 3B had sparse exact success plus substantial invalid/serialization behavior. The next question became: is this the model ceiling, or is the harness corrupting the measurement?')}</p>
      <a href={links.firstRun}>{t('回看 predecessor →', 'Review predecessor →')}</a>
    </article>
    <span class="rail"></span>

    <div class="branch-row branch-row--left" data-exploration-detour="horizon">
      <article class="quest quest--test">
        <span>01A · HYPOTHESIS · HISTORICAL H1.17</span>
        <h2>{t('会不会只是 15 步不够？那就试 30 步', 'Maybe 15 steps are too short? Try 30')}</h2>
        <p>{t('这是更早 3B predecessor 的诊断，不是 current 202609030400 freeze 内重新消耗的样本。我们把 BASE-15 与 BASE-30 做 paired comparison。', 'This is an earlier 3B predecessor diagnostic, not a new sample consumed inside the current 202609030400 freeze. BASE-15 and BASE-30 were compared pairwise.')}</p>
        <strong>{t('结果：64/64 valid；所有 paired horizon delta = 0。', 'Result: 64/64 valid; every paired horizon delta = 0.')}</strong>
        <details><summary>{t('为什么这条路被放弃？', 'Why was this branch abandoned?')}</summary><p>{t('把 horizon 翻倍没有改变 paired outcome，所以“多给时间自然会救回来”没有得到支持。后来 shared Harness 回到 SEED-aligned 的 15 步，把预算继续花在更可疑的接口因素上。', 'Doubling the horizon did not change paired outcomes, so “more time will rescue behavior” was unsupported. The later shared harness returned to the SEED-aligned 15-step boundary and spent diagnostic budget on more plausible interface factors.')}</p><a href={OPEN_EVO_EVIDENCE_LINKS.historicalHorizonPr} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.historicalHorizonPr} />PR #35 · H1.17</a></details>
      </article>
      <b class="backtrack">↩ {t('30 → 15', '30 → 15')}</b>
    </div>
    <span class="rail"></span>

    <div class="branch-row branch-row--right" data-exploration-detour="sampling">
      <article class="quest quest--test">
        <span>01B · HYPOTHESIS</span>
        <h2>{t('会不会 sampling 太保守？', 'Maybe sampling is too conservative?')}</h2>
        <p>{t('把主要嫌疑放在 temperature / top-k 上很自然。小实验显示 T=1.0 会提高行为多样性，但没有单独恢复 reward / loop quality。', 'Temperature / top-k were natural suspects. Diagnostics showed that T=1.0 increased behavioral diversity, but did not by itself recover reward or loop quality.')}</p>
        <strong>{t('结论：sampling 是条件，不是根因解释。', 'Conclusion: sampling matters, but does not explain the failure by itself.')}</strong>
      </article>
      <b class="backtrack">↩ {t('继续找混淆因素', 'Keep searching for the confound')}</b>
    </div>
    <span class="rail"></span>

    <div class="branch-row branch-row--left" data-exploration-detour="history">
      <article class="quest quest--test">
        <span>01C · HYPOTHESIS</span>
        <h2>{t('那是不是 history 格式让模型迷路？', 'Maybe the history format is making the model lose context?')}</h2>
        <p>{t('SEED-native history formatting 确实改变了行为，但单独改 history 仍不足以解释旧版与更好历史行为之间的差距。', 'SEED-native history formatting changed behavior, but history alone still could not explain the gap between the weak run and stronger historical behavior.')}</p>
        <strong>{t('结论：保留 SEED-native history，但不在这里停止诊断。', 'Conclusion: keep SEED-native history, but do not stop the diagnosis here.')}</strong>
      </article>
      <b class="backtrack">↩ {t('回到 prompt / action channel', 'Return to prompt / action channel')}</b>
    </div>
    <span class="rail"></span>

    <article class="quest quest--amend" data-quest="deliberation">
      <span>02 · CAUSAL CLUE</span>
      <h2>{t('真正强的线索：升级 Harness 时，我们把短自我推理也一起删掉了', 'The stronger clue: the harness upgrade had also removed brief self-deliberation')}</h2>
      <p>{t('同模型历史对照让这个变化比 temperature 更可疑。于是我们恢复的不是“购物技巧”，而是一个通用接口：action 前先由模型写自己的短 reasoning；内容不被 Harness 指挥。', 'Same-model historical comparisons made this change more suspicious than temperature. What was restored was not shopping advice, but a generic interface: the model writes its own brief reasoning before acting, without the harness prescribing its content.')}</p>
      <details><summary>{t('这会不会已经是在教它做题？', 'Is this already teaching the model how to solve the task?')}</summary><p>{t('公平性关键是“要求思考”与“告诉它应该想什么”不同。当前 contract 只要求 model-authored pre-action tokens，不给 search/buy heuristics、next-action ranking 或 expert trajectory。', 'The fairness distinction is between asking the model to think and telling it what to think. The current contract requires model-authored pre-action tokens but provides no search/buy heuristics, next-action ranking, or expert trajectory.')}</p></details>
    </article>
    <span class="rail"></span>

    <article class="quest quest--amend" data-quest="action-channel">
      <span>03 · ACTION CHANNEL REDESIGN</span>
      <h2>{t('再把“想对了但格式写坏”从能力评估里拆出去', 'Separate “right intent, broken serialization” from capability')}</h2>
      <p>{t('malformed wrapper 经常仍能看出模型想选择一个真实 admissible action。于是接口拥有 action opener，并在 action token prefix 上只允许当前 Allowed actions；parser repair 与 unconstrained fallback 关闭。', 'Malformed wrappers often still revealed intent to choose a real admissible action. The interface therefore owns the action opener and constrains the action token prefix to current Allowed actions, while parser repair and unconstrained fallback remain disabled.')}</p>
      <strong>{t('这减少 mechanical invalidity，但不替模型从合法动作中选答案。', 'This reduces mechanical invalidity without choosing the answer among legal actions.')}</strong>
    </article>

    <div class="patch-lane" aria-label={t('不改变科学合同的工程绕路', 'Engineering detours that do not change the scientific contract')}>
      <article data-fix="sampling-readback"><span>PATCH · RUNTIME READBACK</span><strong>{t('配置写 T=1.0 不等于真正执行读到了 T=1.0', 'Writing T=1.0 in config does not prove runtime read T=1.0')}</strong><p>{t('曾发现 wrapper intent 是 1.0，但实际 module alias 仍读 0.4。修复 read path 并加 runtime receipt；这是 provenance 修复，不重新定义 sampling hypothesis。', 'A wrapper intended 1.0 while the execution module still read 0.4. The read path and runtime receipt were fixed; this is provenance repair, not a new sampling hypothesis.')}</p></article>
      <article data-fix="model-path"><span>PATCH · MODEL PATH</span><strong>{t('run-local snapshot 会被回收', 'Run-local snapshots can be reclaimed')}</strong><p>{t('正式 launcher 改绑 stable canonical model path 并核对 revision/hash。模型身份不变，因此这是 engineering fix。', 'Formal launchers bind a stable canonical model path and verify revision/hash. Model identity is unchanged, so this remains an engineering fix.')}</p></article>
    </div>
    <span class="rail"></span>

    <article class="quest quest--freeze" data-quest="paired-diagnostic">
      <span>04 · PAIRED 3B + 1.7B DIAGNOSTICS</span>
      <h2>{t('不能为 3B 单独写一套“更会做题”的 Harness', 'Do not give 3B a private “better-solving” harness')}</h2>
      <p>{t('最终候选必须在 Qwen2.5-3B 与 Qwen3-1.7B 上成对确认。允许模型自身差异，不允许按 model ID 注入不同策略；最终得到一套共同的 action/history/deliberation contract。', 'The final candidate had to survive paired checks on Qwen2.5-3B and Qwen3-1.7B. Model-native differences are allowed; model-ID-specific strategy injection is not. The result is one shared action/history/deliberation contract.')}</p>
      <a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Troubleshooting} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Troubleshooting} />{t('查看完整 diagnosis case →', 'Open the diagnosis case →')}</a>
    </article>
    <span class="rail"></span>

    <article class="quest quest--freeze quest--current" data-quest="freeze">
      <span>05 · FREEZE_ONE_SHARED_STAGE1_HARNESS · {OPEN_EVO_STAGE1_FREEZE.id}</span>
      <h2>{t('现在才冻结正式 shared Stage 1', 'Only now freeze the formal shared Stage 1')}</h2>
      <p>{t(`两边都固定为 ${OPEN_EVO_STAGE1_FREEZE.tasks} tasks × ${OPEN_EVO_STAGE1_FREEZE.rolloutsPerTask} rollouts = ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}，max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}，T=${OPEN_EVO_STAGE1_FREEZE.temperature}。reward 不作为 raw corpus PASS gate；先检查 schedule / mechanics / provenance。`, `Both arms are frozen to ${OPEN_EVO_STAGE1_FREEZE.tasks} tasks × ${OPEN_EVO_STAGE1_FREEZE.rolloutsPerTask} rollouts = ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}, max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}, T=${OPEN_EVO_STAGE1_FREEZE.temperature}. Reward is not the raw-corpus PASS gate; schedule, mechanics, and provenance come first.`)}</p>
      <a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Pr} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Pr} />PR #270 · authority</a>
    </article>
    <span class="rail"></span>

    <article class="quest quest--evidence" data-quest="raw-results">
      <span>06 · CANONICAL RAW STAGE 1</span>
      <h2>{t('共享 Harness 并没有把两种模型“教成一样”', 'A shared harness does not make the two models behave the same')}</h2>
      <div class="result-pair">
        <div><b>{arm3.model}</b><strong>{arm3.exact}/{OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong><span>{arm3.exactRate} exact · {arm3.positive} positive</span></div>
        <div><b>{arm17.model}</b><strong>{arm17.exact}/{OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong><span>{arm17.exactRate} exact · {arm17.positive} positive</span></div>
      </div>
      <p>{t('1.7B raw bootstrap 更强本身就是观察结果；公平的意义是“同一接口下差异可解释”，不是强行把两边成功率拉齐。', 'The stronger raw 1.7B bootstrap is itself an observation. Fairness means differences are measured under one interface, not that the harness forces equal success rates.')}</p>
    </article>
    <span class="rail"></span>

    <article class="quest quest--main" data-quest="minimax">
      <span>07 · AFTER RAW SEAL</span>
      <h2>{t('这时才让 MiniMax 看轨迹：老师批改，不替学生继续点网页', 'Only after sealing raw trajectories does MiniMax enter: review, not action-taking')}</h2>
      <p>{t('两个 READY_FOR_MINIMAX receipt 都绑定 1,440 条 source trajectory，并记录 new_webshop_calls=0。MiniMax 生成 post-hoc evidence，不能反向改变已经发生的 raw Stage1。', 'Both READY_FOR_MINIMAX receipts bind 1,440 source trajectories and record new_webshop_calls=0. MiniMax produces post-hoc evidence and cannot reach backward to change raw Stage 1.')}</p>
    </article>
    <span class="rail"></span>

    <div class="branch-row branch-row--right" data-exploration-detour="memory-capacity">
      <article class="quest quest--test">
        <span>08A · TEXT MEMORY CAPACITY</span>
        <h2>{t('20 条输入塞不下：先试把输出上限放到 4096', 'Twenty inputs do not fit: first try a 4096-token output cap')}</h2>
        <p>{t('为了不轻易改变 input topology，A1.1 先对 3B 和 1.7B 对称地扩大 repair 容量。结果两个 arm 都仍然 BLOCKED / extended_repair_failed。', 'To avoid changing input topology too quickly, A1.1 first expanded repair capacity symmetrically for 3B and 1.7B. Both arms still ended BLOCKED / extended_repair_failed.')}</p>
        <strong>{t('结论：只加 token cap 不够，4096 这条路被证伪。', 'Conclusion: output-cap expansion alone is insufficient; the 4096 branch is falsified.')}</strong>
        <details><summary>{t('为什么不能一开始就随便拆 10+10？', 'Why not split 10+10 immediately?')}</summary><p>{t('因为 input topology 会改变 consolidation semantics。当前 A2 只有在同一 20-input node 的 primary 2048 与 same-20 repair 2048 都 saturation 后才被允许触发。', 'Because input topology changes consolidation semantics. Current A2 activates only after both the 2048 primary and same-20 2048 repair saturate on the same 20-input node.')}</p></details>
      </article>
      <b class="backtrack">↩ {t('4096 失败 → bounded A2', '4096 fails → bounded A2')}</b>
    </div>
    <span class="rail"></span>

    <article class="quest quest--amend" data-quest="a2">
      <span>08B · BOUNDED A2</span>
      <h2>{t('只有双 saturation 后，才固定拆成 first10 + last10', 'Only after double saturation: fixed first10 + last10')}</h2>
      <p>{t('A2 是 outcome-blind、max split depth=1 的 deterministic recovery，不允许根据 reward 自适应地继续二分。它改变了容量处理方式，所以必须有明确 trigger receipt，而不能包装成普通工程 patch。', 'A2 is an outcome-blind deterministic recovery with max split depth=1; it may not recursively split based on reward. Because it changes capacity handling, it requires an explicit trigger receipt rather than being hidden as an engineering patch.')}</p>
      <a href={OPEN_EVO_EVIDENCE_LINKS.capacityAuthority} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.capacityAuthority} />{t('查看 capacity authority →', 'Open capacity authority →')}</a>
    </article>
    <span class="rail"></span>

    <article class="quest quest--boundary" data-quest="prestage2">
      <span>09 · PRE_STAGE2_READY</span>
      <h2>{t('Stage1 downstream 准备完成，也不等于自动开始 Stage2', 'Stage-1 downstream readiness still does not automatically start Stage 2')}</h2>
      <p>{t('两个 PRE_STAGE2_READY receipt 都能绑定 adapter、Memory、Skill、Agent 与 provenance，并且 status=PASS；但同时明确写着 stage2_authorized=false、requires separate activation。', 'Both PRE_STAGE2_READY receipts bind adapter, Memory, Skill, Agent, and provenance with status=PASS, while also stating stage2_authorized=false and requiring a separate activation.')}</p>
      <strong>{t('探索地图在这里停：准备好 ≠ 已获准继续。', 'The exploration map stops here: ready ≠ authorized to continue.')}</strong>
    </article>
  </section>

  <OpenEvoHarnessFairnessPanel locale={locale} />
  </ResearchDepth>

  <footer class="explore-map__footer">
    <a href={links.gateway}>{t('← 回到两种读法', '← Back to the two views')}</a>
    <a href={links.archive}>{t('打开完整实验档案', 'Open the full experiment archive')}</a>
    <a href={links.report}>{t('把这段历史压成论文式主线 →', 'Compress this history into the report view →')}</a>
  </footer>
</main>

