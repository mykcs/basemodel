---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ExternalBrandMark from '../common/ExternalBrandMark';
import OpenEvoHarnessFairnessPanel from './OpenEvoHarnessFairnessPanel.astro';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchJourney from './ResearchJourney.astro';
import ResearchDepth from './ResearchDepth.astro';
import { OPEN_EVO_CEILING_PRINCIPLE, OPEN_EVO_EVIDENCE_LINKS, OPEN_EVO_STAGE1_FREEZE, OPEN_EVO_STAGE1_METRICS } from '../../data/openEvoSuccessorNarrative';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const principle = zh ? OPEN_EVO_CEILING_PRINCIPLE.zh : OPEN_EVO_CEILING_PRINCIPLE.en;
const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  gateway: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/'),
  report: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/report/'),
  firstRun: p('/research/seed-openevo/study/capability-exploration/first-run/'),
  archive: p('/research/seed-openevo/study/capability-exploration/archive/'),
};
const arm3 = OPEN_EVO_STAGE1_METRICS[0];
const arm17 = OPEN_EVO_STAGE1_METRICS[1];
const terms = zh ? [
  { term: '假设 / diagnostic', meaning: '用一个小而受控的实验排查“为什么 3B 表现差”，不是正式结果 arm。' },
  { term: '证据不支持', meaning: '同题对照未支持某个解释；这不能证明该因素在任何条件下都没有作用。' },
  { term: 'shared freeze', meaning: '多轮诊断后才允许固定的一套 3B + 1.7B 公共 Harness 与 Stage1 合同。' },
  { term: 'engineering fix', meaning: '修复执行/路径/readback 问题，但不改变科学问题、模型身份或预算。' },
] : [
  { term: 'hypothesis / diagnostic', meaning: 'A small controlled test of why 3B behavior is weak, not a formal result arm.' },
  { term: 'Unsupported explanation', meaning: 'Matched evidence did not support the explanation; it does not prove that the factor has no effect under every condition.' },
  { term: 'shared freeze', meaning: 'The common 3B + 1.7B harness and Stage-1 contract frozen only after the diagnostic sequence.' },
  { term: 'engineering fix', meaning: 'A repair to execution, paths, or readback that does not change the scientific question, model identity, or budget.' },
];
const summarySteps = zh ? [
  { id: 'symptom', kicker: '问题', title: '3B 的轨迹太弱，但不能直接归因于“模型小”', summary: '完全成功的购物尝试很少，动作无效或格式错误也经常出现。', detail: '于是研究先问：这是模型能力上限，还是 Harness 把本来可执行的意图测坏了？', outcome: '把“模型不行”和“接口测坏”拆成可检验的两个解释。', state: '起点' },
  { id: 'falsify', kicker: '检查解释', title: '检查几种解释：步数、随机性和历史信息单独都不够', summary: '同一批配对任务从 15 步改为 30 步，成绩差值为 0；把动作随机性的温度设为 1.0，或使用 SEED 的历史呈现方式，都改变了行为，但单独调整仍不足以解释表现恢复。', detail: '这些小实验没有白跑：它们把搜索范围从“给模型更多机会”缩到 prompt / deliberation / action channel。', outcome: '研究从宽泛调参转向接口语义。', state: '单独不足以解释恢复' },
  { id: 'interface', kicker: '更强线索', title: '动作前的思考与动作格式成为关键线索', summary: '恢复模型自己写的动作前短思考，并区分动作格式造成的失败与模型购物决策造成的失败。', detail: 'Harness 可以拥有 action opener 和合法动作 envelope，但不能替模型从合法动作里挑答案。', outcome: '形成减少动作格式错误、不提供具体购物解法的候选接口。', state: '候选形成' },
  { id: 'freeze', kicker: '配对验证', title: '两种模型都通过接口检查，才固定初始采集规则', summary: `每种模型按相同规则尝试 ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} 次；动作随机性的温度为 ${OPEN_EVO_STAGE1_FREEZE.temperature}，每次最多 ${OPEN_EVO_STAGE1_FREEZE.maxSteps} 步。`, detail: '不能为 3B 单独加“更会做题”的 Harness；模型差异允许存在，model-ID-specific strategy 不允许。', outcome: '从诊断阶段进入真正可比较的 canonical Stage1。', state: '已冻结' },
  { id: 'after-seal', kicker: '封存以后', title: '先记录初始表现，再分析经验并准备学习材料', summary: `${arm3.model} 完全成功 ${arm3.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} 次；${arm17.model} 完全成功 ${arm17.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} 次。购物结束后由 MiniMax 分析已保存记录。按预定容量规则，只有同一组 20 条输入的初次整理和同输入重试都达到容量上限后，才固定拆分为前 10 条与后 10 条；这一处理不增加购物尝试。准备检查通过后，这段设计历史结束；正式学习仍需独立授权。`, detail: 'PRE_STAGE2_READY 只说明下游材料可加载；Stage2 仍需独立 activation。', outcome: '学习材料准备完成；后续训练仍需独立授权。', state: '初始记录已固定' },
] : [
  { id: 'symptom', kicker: 'PROBLEM', title: '3B trajectories were weak, but “the model is small” was not enough', summary: 'Exact success was sparse while invalid / serialization behavior was common.', detail: 'The research question became whether this was a capability ceiling or a harness that corrupted measurement.', outcome: 'Separate model inability from interface-induced failure.', state: 'Starting point' },
  { id: 'falsify', kicker: 'TESTING EXPLANATIONS', title: 'Test simple explanations: more steps, sampling, and history are not enough', summary: 'The 30-step paired delta was zero; T=1.0 and SEED-native history changed behavior but did not explain recovery alone.', detail: 'These diagnostics narrowed the search from generic tuning toward prompt, deliberation, and the action channel.', outcome: 'Move from broad tuning to interface semantics.', state: 'Insufficient alone' },
  { id: 'interface', kicker: 'STRONGER CLUE', title: 'The stronger clue was removed self-deliberation plus broken legal-action serialization', summary: 'Restore model-authored brief reasoning and separate mechanical invalidity from capability.', detail: 'The harness may own the action opener and legal-action envelope but may not choose the answer for the model.', outcome: 'A strategy-neutral harness candidate emerges.', state: 'Candidate formed' },
  { id: 'freeze', kicker: 'PAIRED CHECK', title: 'The same candidate must pass on both 3B and 1.7B before the shared freeze', summary: `Shared rules: ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} trajectories per model, T=${OPEN_EVO_STAGE1_FREEZE.temperature}, max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}.`, detail: 'The models may differ, but model-ID-specific solving strategies are forbidden.', outcome: 'Diagnostics become a comparable canonical Stage 1.', state: 'Frozen' },
  { id: 'after-seal', kicker: 'AFTER SEAL', title: 'Read the raw starting point, then MiniMax review, then bounded carrier recovery', summary: `${arm3.model}: ${arm3.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact; ${arm17.model}: ${arm17.exact}/${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} exact. After shopping ends, MiniMax analyzes the saved records. Under the predefined capacity rule, the same twenty inputs are split into the first ten and last ten only after both the initial organization attempt and the retry reach the capacity limit; this adds no shopping attempts. The design history ends at readiness checks, while formal learning still requires separate authorization.`, detail: 'PRE_STAGE2_READY means downstream artifacts are loadable, not that Stage 2 is authorized.', outcome: 'The exploration stops at “ready ≠ authorized.”', state: 'Stage1 closed' },
];
---
<main data-copy-review class="explore-map" data-testid="openevo-successor-exploration-map">
  <ResearchOrientation
    locale={locale}
    eyebrow="ROGUELIKE RESEARCH MAP · EXPLORATION"
    title={t("购物接口的探索与修订", "Shopping interface study")}
    lede={t("3B 经常无法完成购物。我们逐项检查步数、历史信息和动作传递，形成两种模型共用的购物规则。旧记录保留原身份。", "We tested why 3B failed to shop. Historical records stay distinct.")}
    question={t("失败来自模型能力，还是购物接口？", "Does failure come from the model or its interface?")}
    why={t("接口错误造成的失败，不能算作模型不会购物的证据。", "Interface failures do not establish that the model cannot shop.")}
    start={t("从早期 3B 购物失败及动作格式错误开始排查。", "Begin with early 3B task and action-format failures.")}
    finish={t("这段设计历史结束于初始经验封存、分析和学习材料准备。", "Ends with sealed initial records, analysis and learning materials.")}
    state={t("这些准备检查已经完成；后来独立开展的学习与最终测试见报告。", "Preparation complete; later learning results are in the report.")}
    stateTone="sealed"
    backHref={links.gateway}
    backLabel={t("3B + 1.7B 学习实验", "3B + 1.7B learning study")}
    actionHref="#exploration-summary"
    actionLabel={t("查看设计过程", "View the design process")}
    terms={terms}
  />

  <blockquote class="explore-map__principle" data-principle>
    <span>{t('这条路始终不变的约束', 'THE CONSTRAINT THAT STAYS FIXED')}</span>
    <strong>{zh ? '在与 SEED 对齐的购物任务、尝试次数和评测预算内，先固定规则再看结果，研究 OpenEvo 能把模型提高到什么程度。' : principle}</strong>
  </blockquote>

  <nav class="explore-map__switch" aria-label={t('切换叙事版本', 'Switch narrative view')}>
    <b>{t('当前：探索版', 'Current: Exploration')}</b>
    <a href={links.report}>{t('切到报告与论文版 →', 'Switch to report / paper →')}</a>
  </nav>

  <div id="exploration-summary">
    <ResearchJourney
      locale={locale}
      eyebrow="HYPOTHESIS → TEST → DECISION"
      title={t("从购物失败到共同规则", "From shopping failures to shared rules")}
      intro={t("增加步数、调整动作随机性和提供历史信息仍不足以解释恢复；动作前的思考与动作传递成为后续检查的重点。", "More steps, adjusted sampling, and task history did not explain recovery alone. Subsequent checks focused on pre-action reasoning and action transmission.")}
      steps={summarySteps}
    />
  </div>

  <ResearchDepth
    locale={locale}
    kind="history"
    summary={t("对照检查、接口修订与固定规则的证据", "Evidence from controlled checks, interface revisions, and rule freezing")}
    intro={t("这些诊断发生在不同历史批次。它们用于解释设计选择，不合并计入后来正式采集的结果。", "These diagnostics belong to distinct historical batches. They explain design choices and are not pooled into the later formal collection.")}
  >
  <section class="explore-legend" aria-label={t('探索地图图例', 'Exploration map legend')}>
    <span><i class="is-main"></i>{t('主线', 'Mainline')}</span>
    <span><i class="is-test"></i>{t('小实验 / 假设', 'Diagnostic / hypothesis')}</span>
    <span><i class="is-backtrack"></i>{t('证伪后回退', 'Falsified → backtrack')}</span>
    <span><i class="is-fix"></i>{t('工程修复', 'Engineering fix')}</span>
    <span><i class="is-freeze"></i>{t('科学 freeze / boundary', 'Scientific freeze / boundary')}</span>
  </section>

  <section class="explore-spine" aria-label={t('3B 与 1.7B successor 的探索路线', 'Exploration path for the 3B and 1.7B successor')}>
    <article class="quest quest--main" data-quest="start">
      <span>00 · START · HISTORICAL PREDECESSOR</span>
      <h2>{t('起点：3B 的购物失败', 'Starting point: failed 3B shopping attempts')}</h2>
      <p>{t('第一轮 7B / 3B 实验中，3B 完全成功的尝试很少，也经常出现动作格式错误。低成绩可能来自购物决策，也可能来自接口传递动作的问题，需要分别检查。', 'The first 7B / 3B campaign showed that OpenEvo could enter sustained learning, but 3B had sparse exact success plus substantial invalid/serialization behavior. The next question became: is this the model ceiling, or is the harness corrupting the measurement?')}</p>
      <a href={links.firstRun}>{t('回看 predecessor →', 'Review predecessor →')}</a>
    </article>
    <span class="rail"></span>

    <div class="branch-row branch-row--left" data-exploration-detour="horizon">
      <article class="quest quest--test">
        <span>01A · HYPOTHESIS · HISTORICAL H1.17</span>
        <h2>{t('步数上限：15 步与 30 步', 'Maybe 15 steps are too short? Try 30')}</h2>
        <p>{t('这项早期 3B 检查让同一个起始模型在配对任务上分别使用 15 步和 30 步。它是独立的历史检查，样本不计入后来的正式采集。', 'This is an earlier 3B predecessor diagnostic, not a new sample consumed inside the current 202609030400 freeze. BASE-15 and BASE-30 were compared pairwise.')}</p>
        <strong>{t('结果：64 条记录全部有效；每一对任务的结果差值都是 0。', 'Result: 64/64 valid; every paired horizon delta = 0.')}</strong>
        <p>{t("同题对照中，从最多 15 步增加到 30 步没有改变成绩，因此“只要多给时间就会恢复”的解释未获支持。后来的共同规则保留最多 15 步，与 SEED 对齐，并继续检查接口因素。", "In matched tasks, raising the limit from 15 to 30 steps did not change outcomes. More time alone was therefore unsupported as an explanation of recovery. The shared rules retained the SEED-aligned 15-step limit while interface factors were investigated.")}</p><details><summary>{t("步数对照的原始记录", "Original step-limit comparison")}</summary><a href={OPEN_EVO_EVIDENCE_LINKS.historicalHorizonPr} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.historicalHorizonPr} />PR #35 · H1.17</a></details>
      </article>
      <b class="backtrack">↩ {t('30 → 15', '30 → 15')}</b>
    </div>
    <span class="rail"></span>

    <div class="branch-row branch-row--right" data-exploration-detour="sampling">
      <article class="quest quest--test">
        <span>01B · HYPOTHESIS</span>
        <h2>{t('动作选择的随机性', 'Maybe sampling is too conservative?')}</h2>
        <p>{t('提高采样温度，会让模型尝试更不同的动作。检查发现温度设为 1.0 时行为更多样，但仅改这一项没有恢复购物得分，也没有解决反复循环。', 'Temperature / top-k were natural suspects. Diagnostics showed that T=1.0 increased behavioral diversity, but did not by itself recover reward or loop quality.')}</p>
        <strong>{t('判断：随机性会影响行为，单独改它不足以解释这次失败。', 'Conclusion: sampling matters, but does not explain the failure by itself.')}</strong>
      </article>
      <b class="backtrack">↩ {t('继续找混淆因素', 'Keep searching for the confound')}</b>
    </div>
    <span class="rail"></span>

    <div class="branch-row branch-row--left" data-exploration-detour="history">
      <article class="quest quest--test">
        <span>01C · HYPOTHESIS</span>
        <h2>{t('历史信息的呈现', 'Maybe the history format is making the model lose context?')}</h2>
        <p>{t('模型每一步都会读取最近发生过的事。按 SEED 原生方式呈现这段历史后，行为有所改变；但这一个因素仍不足以解释较差运行与较好历史运行的差距。', 'SEED-native history formatting changed behavior, but history alone still could not explain the gap between the weak run and stronger historical behavior.')}</p>
        <strong>{t('判断：保留 SEED 原生历史格式，继续检查思考过程和动作接口。', 'Conclusion: keep SEED-native history, but do not stop the diagnosis here.')}</strong>
      </article>
      <b class="backtrack">↩ {t("检查提示与动作接口", "Inspect prompts and the action interface")}</b>
    </div>
    <span class="rail"></span>

    <article class="quest quest--amend" data-quest="deliberation">
      <span>02 · CAUSAL CLUE</span>
      <h2>{t('动作前的短思考', 'The stronger clue: the harness upgrade had also removed brief self-deliberation')}</h2>
      <p>{t('检查同一模型的历史记录发现，接口升级时还删除了动作前的短思考。后续方案恢复模型自己写的思考过程；接口规定输出形式，思考内容由模型决定。', 'Same-model historical comparisons made this change more suspicious than temperature. What was restored was not shopping advice, but a generic interface: the model writes its own brief reasoning before acting, without the harness prescribing its content.')}</p>
      <details><summary>{t('这会不会已经是在教它做题？', 'Is this already teaching the model how to solve the task?')}</summary><p>{t('公平性关键是“要求思考”与“告诉它应该想什么”不同。当前 contract 只要求 model-authored pre-action tokens，不给 search/buy heuristics、next-action ranking 或 expert trajectory。', 'The fairness distinction is between asking the model to think and telling it what to think. The current contract requires model-authored pre-action tokens but provides no search/buy heuristics, next-action ranking, or expert trajectory.')}</p></details>
    </article>
    <span class="rail"></span>

    <article class="quest quest--amend" data-quest="action-channel">
      <span>03 · ACTION CHANNEL REDESIGN</span>
      <h2>{t('动作格式与动作选择', 'Separate “right intent, broken serialization” from capability')}</h2>
      <p>{t('一些记录里的动作指向了真实按钮，但外层格式写错，商店无法接收。新接口负责动作的开头格式，并限制输出为当前页面允许的动作；模型仍需自己选择哪个动作。', 'Malformed wrappers often still revealed intent to choose a real admissible action. The interface therefore owns the action opener and constrains the action token prefix to current Allowed actions, while parser repair and unconstrained fallback remain disabled.')}</p>
      <strong>{t('接口减少动作格式造成的失败；购物选择仍由模型负责。', 'The interface reduces failures caused by action formatting; the model remains responsible for its shopping choices.')}</strong>
    </article>

    <div class="patch-lane" aria-label={t('不改变科学合同的工程绕路', 'Engineering detours that do not change the scientific contract')}>
      <article data-fix="sampling-readback"><span>PATCH · RUNTIME READBACK</span><strong>{t('配置写 T=1.0 不等于真正执行读到了 T=1.0', 'Writing T=1.0 in config does not prove runtime read T=1.0')}</strong><p>{t('曾发现 wrapper intent 是 1.0，但实际 module alias 仍读 0.4。修复 read path 并加 runtime receipt；这是 provenance 修复，不重新定义 sampling hypothesis。', 'A wrapper intended 1.0 while the execution module still read 0.4. The read path and runtime receipt were fixed; this is provenance repair, not a new sampling hypothesis.')}</p></article>
      <article data-fix="model-path"><span>PATCH · MODEL PATH</span><strong>{t('run-local snapshot 会被回收', 'Run-local snapshots can be reclaimed')}</strong><p>{t('正式 launcher 改绑 stable canonical model path 并核对 revision/hash。模型身份不变，因此这是 engineering fix。', 'Formal launchers bind a stable canonical model path and verify revision/hash. Model identity is unchanged, so this remains an engineering fix.')}</p></article>
    </div>
    <span class="rail"></span>

    <article class="quest quest--freeze" data-quest="paired-diagnostic">
      <span>04 · PAIRED 3B + 1.7B DIAGNOSTICS</span>
      <h2>{t('两种模型的共同检查', 'Do not give 3B a private “better-solving” harness')}</h2>
      <p>{t('候选接口同时在 Qwen2.5-3B 与 Qwen3-1.7B 上检查。两边使用相同的动作格式、历史呈现和思考要求；不为某个模型额外提供购物策略。', 'The final candidate had to survive paired checks on Qwen2.5-3B and Qwen3-1.7B. Model-native differences are allowed; model-ID-specific strategy injection is not. The result is one shared action/history/deliberation contract.')}</p>
      <a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Troubleshooting} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Troubleshooting} />{t('查看完整 diagnosis case →', 'Open the diagnosis case →')}</a>
    </article>
    <span class="rail"></span>

    <article class="quest quest--freeze quest--current" data-quest="freeze">
      <span>05 · FREEZE_ONE_SHARED_STAGE1_HARNESS · {OPEN_EVO_STAGE1_FREEZE.id}</span>
      <h2>{t('正式采集规则', 'Only now freeze the formal shared Stage 1')}</h2>
      <p>{t(`两边都固定完成 ${OPEN_EVO_STAGE1_FREEZE.tasks} 道任务，每题 ${OPEN_EVO_STAGE1_FREEZE.rolloutsPerTask} 次尝试，共 ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm} 次，每次最多 ${OPEN_EVO_STAGE1_FREEZE.maxSteps} 步。采样温度固定为 ${OPEN_EVO_STAGE1_FREEZE.temperature}。记录验收检查任务覆盖、动作过程与来源，不用得分高低决定是否保留。`, `Both arms are frozen to ${OPEN_EVO_STAGE1_FREEZE.tasks} tasks × ${OPEN_EVO_STAGE1_FREEZE.rolloutsPerTask} rollouts = ${OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}, max_steps=${OPEN_EVO_STAGE1_FREEZE.maxSteps}, T=${OPEN_EVO_STAGE1_FREEZE.temperature}. Reward is not the raw-corpus PASS gate; schedule, mechanics, and provenance come first.`)}</p>
      <a href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Pr} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.sharedStage1Pr} />PR #270 · authority</a>
    </article>
    <span class="rail"></span>

    <article class="quest quest--evidence" data-quest="raw-results">
      <span>06 · CANONICAL RAW STAGE 1</span>
      <h2>{t('共同规则下的初始差异', 'A shared harness does not make the two models behave the same')}</h2>
      <div class="result-pair">
        <div><b>{arm3.model}</b><strong>{arm3.exact}/{OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong><span>{arm3.exactRate} exact · {arm3.positive} positive</span></div>
        <div><b>{arm17.model}</b><strong>{arm17.exact}/{OPEN_EVO_STAGE1_FREEZE.trajectoriesPerArm}</strong><span>{arm17.exactRate} exact · {arm17.positive} positive</span></div>
      </div>
      <p>{t('在这批初始任务中，1.7B 完全成功的尝试更多。这是共同接口下观测到的起点差异，后续分析应保留它，而不是把两边的成功率调整为相同。', 'The stronger raw 1.7B bootstrap is itself an observation. Fairness means differences are measured under one interface, not that the harness forces equal success rates.')}</p>
    </article>
    <span class="rail"></span>

    <article class="quest quest--main" data-quest="minimax">
      <span>07 · AFTER RAW SEAL</span>
      <h2>{t('购物结束后的经验分析', 'Only after sealing raw trajectories does MiniMax enter: review, not action-taking')}</h2>
      <p>{t('两边都先固定保存 1,440 次购物尝试，再让 MiniMax 阅读已有记录并反馈。分析不产生新的购物动作，初始成绩保持不变。', 'Both READY_FOR_MINIMAX receipts bind 1,440 source trajectories and record new_webshop_calls=0. MiniMax produces post-hoc evidence and cannot reach backward to change raw Stage 1.')}</p>
    </article>
    <span class="rail"></span>

    <div class="branch-row branch-row--right" data-exploration-detour="memory-capacity">
      <article class="quest quest--test">
        <span>08A · TEXT MEMORY CAPACITY</span>
        <h2>{t('记忆容量的检查', 'Twenty inputs do not fit: first try a 4096-token output cap')}</h2>
        <p>{t('先保持每组 20 条输入不变，只把输出容量扩大到 4,096 个词元。两种模型按同一办法检查，仍未得到符合要求的完整输出。', 'To avoid changing input topology too quickly, A1.1 first expanded repair capacity symmetrically for 3B and 1.7B. Both arms still ended BLOCKED / extended_repair_failed.')}</p>
        <details><summary>{t('容量检查记录', 'Capacity check record')}</summary><p><code>4096</code> · <code>extended_repair_failed</code> {t('两种模型均未通过扩大输出容量后的检查。', 'Both models failed the expanded-output-capacity check.')}</p></details>
        <strong>{t('这次两种模型的检查中，扩大输出容量后仍未通过。', 'In these checks, neither model passed after the output capacity was expanded.')}</strong>
        <details><summary>{t('为什么不能一开始就随便拆 10+10？', 'Why not split 10+10 immediately?')}</summary><p>{t('因为 input topology 会改变 consolidation semantics。当前 A2 只有在同一 20-input node 的 primary 2048 与 same-20 repair 2048 都 saturation 后才被允许触发。', 'Because input topology changes consolidation semantics. Current A2 activates only after both the 2048 primary and same-20 2048 repair saturate on the same 20-input node.')}</p></details>
      </article>
      <b class="backtrack">↩ {t('4096 失败 → bounded A2', '4096 fails → bounded A2')}</b>
    </div>
    <span class="rail"></span>

    <article class="quest quest--amend" data-quest="a2">
      <span>08B · BOUNDED A2</span>
      <h2>{t('固定分拆的条件', 'Only after double saturation: fixed first10 + last10')}</h2>
      <p>{t('后来的修订规定：同一组 20 条输入经过初次生成和一次修复，两次都用尽容量时，才固定分为前 10 条与后 10 条，最多分拆一次。这个条件在看奖励之前确定，并单独记录；分组改变了经验整理方式。', 'A2 is an outcome-blind deterministic recovery with max split depth=1; it may not recursively split based on reward. Because it changes capacity handling, it requires an explicit trigger receipt rather than being hidden as an engineering patch.')}</p>
      <details><summary>{t('分拆规则的精确字段', 'Exact split-rule fields')}</summary><p><code>first10 + last10</code> · <code>max split depth=1</code></p></details>
      <a href={OPEN_EVO_EVIDENCE_LINKS.capacityAuthority} target="_blank" rel="noreferrer"><ExternalBrandMark href={OPEN_EVO_EVIDENCE_LINKS.capacityAuthority} />{t('查看 capacity authority →', 'Open capacity authority →')}</a>
    </article>
    <span class="rail"></span>

    <article class="quest quest--boundary" data-quest="prestage2">
      <span>09 · PRE_STAGE2_READY</span>
      <h2>{t('当时的初始准备结束', 'Stage-1 downstream readiness still does not automatically start Stage 2')}</h2>
      <p>{t('当时，两种模型的参数增量、文本记忆、技能和系统指令都通过了加载与来源检查。准备检查完成后，后续学习仍需另一份独立授权。', 'Both PRE_STAGE2_READY receipts bind adapter, Memory, Skill, Agent, and provenance with status=PASS, while also stating stage2_authorized=false and requiring a separate activation.')}</p>
      <details><summary>{t('当时的准备记录', 'Readiness record at that time')}</summary><p><code>stage2_authorized=false</code> · <code>requires separate activation</code></p></details>
      <strong>{t('这份历史记录到初始准备为止。后续另行授权的学习和最终测试，见结果报告。', 'This history ends at initial readiness. Later separately authorized learning and final evaluation are recorded in the report.')}</strong>
    </article>
  </section>

  <p class="explore-next"><a href={links.report}>{t('查看后续学习与最终测试结果', 'View later learning and final evaluation')}</a></p>
  <OpenEvoHarnessFairnessPanel locale={locale} />
  </ResearchDepth>

  <footer class="explore-map__footer">
    <a href={links.gateway}>{t("← 3B + 1.7B 学习实验", "← 3B + 1.7B learning study")}</a>
    <a href={links.archive}>{t('打开完整实验档案', 'Open the full experiment archive')}</a>
    <a href={links.report}>{t('把这段历史压成论文式主线 →', 'Compress this history into the report view →')}</a>
  </footer>
</main>

