---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="openevo-framework" aria-labelledby="openevo-framework-title">
  <header class="diagram-head"><span>OPENEVO · METHOD</span><h2 id="openevo-framework-title">{t('OpenEvo 跨任务演化框架','OpenEvo cross-task evolution framework')}</h2><p>{t('任务结束后先封存证据，再由演化方法生成 memory、artifact 或 adapter；验证通过后组成 successor revision，从后续任务开始生效。','After a task ends, evidence is sealed. Evolution methods then produce memory, artifacts, or adapters; validated state becomes the successor revision and activates on later tasks.')}</p></header>
  <div class="arch-canvas">
    <div class="lane task"><div class="lane-label"><b>TASK N</b><span>{t('执行','Execution')}</span></div><article class="node violet"><small>PROJECT HEAD</small><strong>{t('当前 agent / model revision','current agent / model revision')}</strong><span>Qwen2.5-3B-Instruct</span></article><div class="arrow"><span></span><i></i></div><article class="node blue"><small>ENVIRONMENT</small><strong>WebShop / ALFWorld</strong><span>observation ↔ action ↔ reward</span></article><div class="arrow"><span></span><i></i></div><article class="node cyan"><small>SEALED EVIDENCE</small><strong>trajectory + score + metadata</strong><span>{t('任务结束后进入演化','evolution starts after task completion')}</span></article></div>
    <div class="down"><span></span><i></i></div>
    <div class="lane evolve"><div class="lane-label"><b>EVOLVE</b><span>{t('演化层','Evolution')}</span></div><article class="node amber"><small>EVOLUTION METHOD</small><strong>{t('反思 / 提炼 / 参数演变','reflection / extraction / parametric evolution')}</strong><span>{t('不在任务中途切换状态','no hidden mid-task state switch')}</span></article><div class="arrow"><span></span><i></i></div><div class="carrier"><small>{t('演化载体','Evolution carriers')}</small><div><article><b>MEMORY</b><span>{t('外部经验','external experience')}</span></article><article><b>ARTIFACT</b><span>{t('agent-system 状态','agent-system state')}</span></article><article><b>ADAPTER</b><span>LoRA / SD-LoRA</span></article></div></div><div class="arrow"><span></span><i></i></div><article class="node green"><small>VALIDATION</small><strong>{t('身份 · digest · reload · 行为探针','identity · digest · reload · behavior probes')}</strong><span>{t('通过后才发布','publish only after pass')}</span></article></div>
    <div class="down green-down"><span></span><i></i></div>
    <div class="lane next"><div class="lane-label"><b>TASK N+1</b><span>{t('后续任务','Next task')}</span></div><article class="node green"><small>SUCCESSOR REVISION</small><strong>{t('更新后的 agent 状态','updated agent state')}</strong><span>{t('从明确边界生效','activates at an explicit boundary')}</span></article><div class="arrow green-arrow"><span></span><i></i></div><article class="node green"><small>NEXT ROLLOUT</small><strong>{t('继续采集新经验','collect new experience')}</strong><span>{t('形成下一轮跨任务循环','forms the next cross-task cycle')}</span></article></div>
  </div>
  <div class="parametric"><small>{t('当前 WebShop 参数演变路径','Current WebShop parametric path')}</small><div><span>WebShop trajectory</span><i>→</i><span>dataset adapter</span><i>→</i><span>SD-LoRA train</span><i>→</i><span>adapter artifact</span><i>→</i><span>fresh reload</span><i>→</i><span>real rollout</span></div></div>
  <aside><strong>OpenEvo Core</strong><p>{t('Core 保持外部 pinned dependency；实验仓库负责 benchmark adapter、任务合同、manifest 与证据。','Core remains an external pinned dependency; the experiment repository owns the benchmark adapter, task contracts, manifests, and evidence.')}</p></aside>
</section>
<style>
.openevo-framework{--blue:#2563eb;--cyan:#0891b2;--violet:#7c3aed;--amber:#d97706;--green:#059669;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:0 20px 60px color-mix(in srgb,#000 7%,transparent)}.diagram-head{max-width:900px}.diagram-head>span{color:var(--violet);font-size:.7rem;font-weight:850}.diagram-head h2{margin:.35rem 0 .5rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.65}.arch-canvas{margin-top:1rem}.lane{display:grid;grid-template-columns:92px 1fr 44px 1fr 44px 1fr;gap:.35rem;align-items:center;padding:.85rem;border:1px solid var(--line);border-radius:17px}.task{background:color-mix(in srgb,var(--blue) 6%,var(--surface))}.evolve{grid-template-columns:92px 1.1fr 44px 1.35fr 44px 1fr;background:color-mix(in srgb,var(--violet) 6%,var(--surface))}.next{grid-template-columns:92px 1fr 44px 1fr;background:color-mix(in srgb,var(--green) 6%,var(--surface))}.lane-label b,.lane-label span{display:block}.lane-label b{font:850 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}.lane-label span{margin-top:.22rem;font-size:.58rem;color:var(--muted)}.node{min-height:100px;padding:.75rem;border:1.5px solid;border-radius:13px;background:var(--surface);box-shadow:0 9px 20px color-mix(in srgb,#000 5%,transparent)}.node small,.node strong,.node span{display:block}.node small{color:var(--muted);font-size:.55rem}.node strong{margin:.32rem 0;font-size:.72rem;line-height:1.3}.node span{color:var(--muted);font-size:.59rem;line-height:1.38}.violet{border-color:color-mix(in srgb,var(--violet) 60%,var(--line));border-top:4px solid var(--violet)}.blue{border-color:color-mix(in srgb,var(--blue) 60%,var(--line));border-top:4px solid var(--blue)}.cyan{border-color:color-mix(in srgb,var(--cyan) 60%,var(--line));border-top:4px solid var(--cyan)}.amber{border-color:color-mix(in srgb,var(--amber) 60%,var(--line));border-top:4px solid var(--amber)}.green{border-color:color-mix(in srgb,var(--green) 60%,var(--line));border-top:4px solid var(--green)}.arrow{position:relative;height:28px}.arrow span{position:absolute;left:0;right:9px;top:12px;height:3px;background:var(--muted);border-radius:99px}.arrow i{position:absolute;right:0;top:6px;border-top:8px solid transparent;border-bottom:8px solid transparent;border-left:10px solid var(--muted)}.green-arrow span{background:var(--green)}.green-arrow i{border-left-color:var(--green)}.down{position:relative;height:42px;margin-left:120px}.down span{position:absolute;left:28px;top:0;bottom:10px;width:3px;background:linear-gradient(var(--cyan),var(--violet));border-radius:99px}.down i{position:absolute;left:21px;bottom:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:10px solid var(--violet)}.green-down span{background:linear-gradient(var(--violet),var(--green))}.green-down i{border-top-color:var(--green)}.carrier{padding:.7rem;border:1.5px dashed color-mix(in srgb,var(--violet) 55%,var(--line));border-radius:13px}.carrier>small{display:block;color:var(--muted);font-size:.55rem}.carrier>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.3rem;margin-top:.5rem}.carrier article{padding:.45rem;border:1px solid var(--line);border-radius:8px;background:var(--surface)}.carrier b,.carrier span{display:block}.carrier b{font-size:.57rem;color:var(--violet)}.carrier span{font-size:.53rem;color:var(--muted)}.parametric{margin-top:.75rem;padding:.75rem;border:1px solid color-mix(in srgb,var(--amber) 45%,var(--line));border-radius:12px;background:color-mix(in srgb,var(--amber) 6%,var(--surface))}.parametric>small{display:block;color:var(--muted);font-size:.58rem}.parametric>div{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;margin-top:.5rem}.parametric span{padding:.35rem .5rem;border-radius:8px;background:var(--surface);border:1px solid var(--line);font-size:.59rem}.parametric i{font-style:normal;color:var(--amber);font-weight:900}.openevo-framework>aside{display:grid;grid-template-columns:120px 1fr;gap:.7rem;margin-top:.65rem;padding:.7rem;border-left:4px solid var(--violet);background:var(--surface-muted);border-radius:9px}.openevo-framework>aside strong{font-size:.68rem}.openevo-framework>aside p{margin:0;color:var(--muted);font-size:.62rem;line-height:1.45}@media(max-width:980px){.lane,.evolve,.next{grid-template-columns:1fr}.arrow{height:34px}.arrow span{left:50%;right:auto;top:0;bottom:9px;width:3px;height:auto}.arrow i{left:calc(50% - 7px);right:auto;top:auto;bottom:0;border-left:7px solid transparent;border-right:7px solid transparent;border-top:10px solid var(--muted);border-bottom:0}.carrier>div{grid-template-columns:1fr}.down{margin-left:50%}.openevo-framework>aside{grid-template-columns:1fr}}@media(max-width:560px){.openevo-framework{width:min(100% - 1rem,1180px);padding:.8rem}}
</style>
