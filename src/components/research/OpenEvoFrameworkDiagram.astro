---
import type { Locale } from '../../i18n';
import ResearchDiagramLegend from './ResearchDiagramLegend.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="openevo-framework" aria-labelledby="openevo-framework-title" data-explainer="openevo-core">
  <header class="diagram-head">
    <span>OPENEVO · CORE PRINCIPLE</span>
    <h2 id="openevo-framework-title">{t('OpenEvo 跨任务演化机制','OpenEvo cross-task evolution mechanism')}</h2>
    <p>{t('OpenEvo 的核心顺序是：先完整结束当前任务并固定证据，再根据这些证据更新下一任务可以继承的状态。这个状态可以是外部记忆、Agent 系统文件或参数适配器（这些都统称为 carrier）；验证通过后再合并成下一版 agent 状态（successor revision），从下一任务开始生效。','OpenEvo follows one core order: finish the current task and freeze its evidence, then use that evidence to update state that the next task can inherit. That state may be external memory, an agent-system artifact, or a parametric adapter (collectively, carriers); validated state is then assembled into the next agent version (the successor revision) and activates on the following task.')}</p>
  </header>

  <div class="principles">
    <article><small>{t('什么时候演化','When does evolution happen?')}</small><strong>{t('任务结束以后，不在任务中途偷偷换状态','after task completion, never by silently switching state mid-task')}</strong></article>
    <article><small>{t('什么东西可以演化','What can evolve?')}</small><strong>{t('外部 memory / agent artifact / 参数化 adapter','external memory / agent artifact / parametric adapter')}</strong></article>
    <article><small>{t('为什么下一任务会不同','Why is the next task different?')}</small><strong>{t('因为 successor revision 继承了通过验证的新状态','because the successor revision inherits validated new state')}</strong></article>
  </div>

  <figure class="evo-scene" role="img" aria-label={t('OpenEvo：Project Head 在环境中完成 Task N 并产生 sealed evidence；任务结束后 evidence 进入 evolution method，并分叉为 memory、artifact 或 adapter；验证通过后合并为 successor revision，用于 Task N+1','OpenEvo: a Project Head completes Task N in an environment and produces sealed evidence; after task completion the evidence enters an evolution method and branches into memory, artifact, or adapter carriers; validated state merges into a successor revision for Task N+1')}>
    <figcaption><span>{t('跨任务演化边界','Cross-task evolution boundary')}</span><strong>TASK N → EVOLVE → TASK N+1</strong><small>{t('“完成任务”与“改变 agent”是两个明确分开的阶段','completing the task and changing the agent are explicitly separate phases')}</small></figcaption>

    <article class="node head"><span class="node-role">PROJECT HEAD</span><strong>{t('当前 agent revision','current agent revision')}</strong><small>Qwen2.5-3B-Instruct + current carrier state</small></article>
    <article class="node environment"><span class="node-role">TASK N · ENVIRONMENT</span><strong>WebShop / ALFWorld</strong><small>observation · action · reward</small></article>
    <article class="node evidence"><span class="node-role">SEALED EVIDENCE</span><strong>trajectory + outcome + metadata</strong><small>{t('任务完成后冻结，先保留“发生了什么”','frozen after task completion so the evidence of what happened is preserved first')}</small></article>

    <article class="node engine"><span class="node-role">EVOLUTION METHOD</span><strong>{t('反思 / 提炼 / 参数演变','reflection / extraction / parametric evolution')}</strong><small>{t('方法读取已经封存的 evidence，不改变刚完成的 Task N','the method reads sealed evidence; it does not retroactively change Task N')}</small></article>

    <article class="carrier memory"><span class="node-role">CARRIER A</span><strong>MEMORY</strong><small>{t('把经验留在模型外部，后续任务检索 / 注入','experience stays outside the model and is retrieved/injected later')}</small></article>
    <article class="carrier artifact"><span class="node-role">CARRIER B</span><strong>AGENT ARTIFACT</strong><small>{t('工具、技能、策略文件或 agent-system 状态','tools, skills, policy files, or agent-system state')}</small></article>
    <article class="carrier adapter active"><span class="node-role">CARRIER C · CURRENT WEBSHOP PATH</span><strong>PARAMETRIC ADAPTER</strong><small>SD-LoRA / LoRA · {t('参数化经验','parametric experience')}</small></article>

    <article class="node validation"><span class="node-role">VALIDATION GATE</span><strong>{t('identity · digest · reload · behavior probe','identity · digest · reload · behavior probe')}</strong><small>{t('只有可追溯且真正生效的状态才被接受','only traceable state that actually activates is accepted')}</small></article>
    <article class="node successor"><span class="node-role">SUCCESSOR REVISION</span><strong>{t('下一版 agent 状态','next agent state')}</strong><small>{t('可以同时包含代码 identity、memory、artifact、adapter','may combine code identity, memory, artifacts, and adapters')}</small></article>
    <article class="node next"><span class="node-role">TASK N+1</span><strong>{t('下一任务从 successor revision 开始','the next task starts from the successor revision')}</strong><small>{t('继续产生新 evidence，形成下一轮演化','new evidence starts the next evolution cycle')}</small></article>

    <svg class="evo-wires" viewBox="0 0 1200 720" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <marker id="evo-arrow-blue" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#2563eb" /></marker>
        <marker id="evo-arrow-amber" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#d97706" /></marker>
        <marker id="evo-arrow-violet" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#7c3aed" /></marker>
        <marker id="evo-arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#059669" /></marker>
      </defs>
      <path class="wire state" d="M195 145 C270 145 330 145 385 145" marker-end="url(#evo-arrow-violet)" />
      <path class="wire env" d="M545 145 C620 145 675 145 720 145" marker-end="url(#evo-arrow-blue)" />
      <path class="wire boundary" d="M800 205 C800 255 600 245 600 292" marker-end="url(#evo-arrow-amber)" />
      <path class="wire branch" d="M600 370 C470 420 310 420 250 458" marker-end="url(#evo-arrow-amber)" />
      <path class="wire branch" d="M600 370 C600 410 600 425 600 458" marker-end="url(#evo-arrow-amber)" />
      <path class="wire branch" d="M600 370 C735 420 890 420 950 458" marker-end="url(#evo-arrow-amber)" />
      <path class="wire converge" d="M250 545 C330 590 420 590 515 605" marker-end="url(#evo-arrow-green)" />
      <path class="wire converge" d="M600 545 C600 565 600 580 600 596" marker-end="url(#evo-arrow-green)" />
      <path class="wire converge" d="M950 545 C865 590 785 590 685 605" marker-end="url(#evo-arrow-green)" />
      <path class="wire persist" d="M690 630 C760 630 810 630 858 630" marker-end="url(#evo-arrow-green)" />
      <path class="wire persist" d="M1010 630 C1060 630 1090 630 1115 630" marker-end="url(#evo-arrow-green)" />
      <path class="wire loop" d="M1110 670 C1110 705 150 705 145 190" marker-end="url(#evo-arrow-green)" />
    </svg>
    <span class="wire-label completion-boundary">{t('任务完成边界：先封存，再演化','completion boundary: seal first, evolve second')}</span>
    <span class="wire-label fanout-label">{t('同一 evidence 可以进入不同 evolution carrier','the same evidence can feed different evolution carriers')}</span>
    <span class="wire-label validated-label">{t('只有 PASS 状态进入 successor revision','only PASS state enters the successor revision')}</span>
  </figure>

  <section class="webshop-path" aria-labelledby="webshop-path-title">
    <header><span>{t('当前具体实现','Current concrete implementation')}</span><h3 id="webshop-path-title">OpenEvo × WebShop · SD-LoRA parametric path</h3></header>
    <div class="path-canvas">
      <article><small>01 · EXPERIENCE</small><strong>real WebShop trajectory</strong></article>
      <i aria-hidden="true"></i>
      <article><small>02 · ADAPT</small><strong>parametric dataset adapter</strong></article>
      <i aria-hidden="true"></i>
      <article><small>03 · UPDATE</small><strong>official OpenEvo SD-LoRA</strong></article>
      <i aria-hidden="true"></i>
      <article><small>04 · PERSIST</small><strong>adapter + logical state digest</strong></article>
      <i aria-hidden="true"></i>
      <article><small>05 · VERIFY</small><strong>fresh reload + real rollout</strong></article>
    </div>
    <p>{t('这条 adapter 路线是当前 WebShop 实验正在用的 carrier，但它只是 OpenEvo 框架允许的一种演化载体；不能反过来把 OpenEvo 定义成“SD-LoRA 框架”。','This adapter route is the carrier used by the current WebShop experiment, but it is only one carrier allowed by OpenEvo; OpenEvo should not be reduced to “the SD-LoRA framework.”')}</p>
  </section>

  <div class="mental-model">
    <article><small>{t('一句话直觉','One-sentence intuition')}</small><strong>{t('先把一次任务发生的事情封存成证据，再决定“这次经验应该写进哪里”，最后把通过验证的新状态交给下一任务。','First seal what happened in a task as evidence, then decide where that experience should be written, and give the validated new state to the next task.')}</strong></article>
    <article><small>{t('和普通在线学习最重要的区别','Key difference from naive online mutation')}</small><strong>{t('OpenEvo 强调明确的 task / evolution 边界，避免同一个 episode 中途悄悄换 agent 状态导致证据不可审计。','OpenEvo emphasizes an explicit task/evolution boundary so the agent does not silently change state mid-episode and make the evidence unauditable.')}</strong></article>
  </div>

  <ResearchDiagramLegend locale={locale} />

  <details class="technical-details"><summary>{t('技术细节：OpenEvo Core、实验仓库与 carrier 的职责','Technical detail: responsibilities of OpenEvo Core, the experiment repository, and carriers')}</summary><div class="technical-grid"><article><strong>OpenEvo Core</strong><p>{t('保持 external pinned dependency，提供正式 evolution / trainer 能力；实验仓库不复制一份新的 Core。','Remains an external pinned dependency providing the evolution/trainer capability; the experiment repository does not fork a second mutable Core.')}</p></article><article><strong>openevo-experiment</strong><p>{t('负责 benchmark adapter、task contract、Run Manifest、carrier identity、实验结果与科学结论。','Owns benchmark adapters, task contracts, Run Manifests, carrier identities, experiment results, and scientific claims.')}</p></article><article><strong>carrier identity</strong><p>{t('memory / artifact / adapter 都必须有版本、digest 或等价 provenance；“文件名一样”不算同一个演化状态。','Memory, artifacts, and adapters need versions, digests, or equivalent provenance; matching filenames alone do not establish identical evolution state.')}</p></article></div></details>
</section>

<style>
.openevo-framework{--env:#2563eb;--experience:#d97706;--signal:#dc2626;--state:#7c3aed;--persist:#059669;--cyan:#0891b2;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:24px;background:radial-gradient(circle at 75% 0,color-mix(in srgb,var(--state) 8%,transparent),transparent 32%),var(--surface);box-shadow:0 24px 76px color-mix(in srgb,#000 8%,transparent)}.diagram-head{max-width:930px}.diagram-head>span{color:var(--state);font:850 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.diagram-head h2{margin:.38rem 0 .55rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.68}.principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:1rem 0}.principles article{padding:.65rem .72rem;border:1px solid var(--line);border-radius:11px;background:var(--surface-muted)}.principles small,.principles strong{display:block}.principles small{color:var(--muted);font-size:.56rem}.principles strong{margin-top:.2rem;font-size:.67rem;line-height:1.38}.evo-scene{position:relative;isolation:isolate;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-areas:"cap cap cap" "head environment evidence" ". engine ." "memory artifact adapter" "validation validation validation" ". successor next";gap:1.05rem .75rem;min-height:710px;padding:1rem;border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,color-mix(in srgb,var(--state) 4%,var(--surface)),var(--surface));overflow:hidden}.evo-scene figcaption{grid-area:cap;z-index:2;display:flex;align-items:baseline;gap:.55rem;flex-wrap:wrap}.evo-scene figcaption span{color:var(--experience);font:850 .56rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.evo-scene figcaption strong{font-size:.72rem}.evo-scene figcaption small{color:var(--muted);font-size:.57rem}.node,.carrier{z-index:2;align-self:center;min-height:108px;padding:.72rem;border:1.5px solid var(--line);border-radius:13px;background:color-mix(in srgb,var(--surface) 96%,transparent);box-shadow:0 10px 24px color-mix(in srgb,#000 6%,transparent);backdrop-filter:blur(5px)}.node-role{display:block;color:var(--muted);font:850 .51rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.node strong,.node small,.carrier strong,.carrier small{display:block}.node strong,.carrier strong{margin:.3rem 0;font-size:.69rem;line-height:1.3}.node small,.carrier small{color:var(--muted);font-size:.56rem;line-height:1.42}.head{grid-area:head;border-top:5px solid var(--state)}.environment{grid-area:environment;border-top:5px solid var(--env)}.evidence{grid-area:evidence;border-top:5px solid var(--experience)}.engine{grid-area:engine;justify-self:center;width:80%;border-top:5px solid var(--experience)}.memory{grid-area:memory;border-top:5px solid var(--experience)}.artifact{grid-area:artifact;border-top:5px solid var(--state)}.adapter{grid-area:adapter;border-top:5px solid var(--state)}.adapter.active{border-color:color-mix(in srgb,var(--state) 62%,var(--line));box-shadow:0 0 0 3px color-mix(in srgb,var(--state) 10%,transparent),0 12px 30px color-mix(in srgb,var(--state) 12%,transparent)}.validation{grid-area:validation;justify-self:center;width:56%;border-top:5px solid var(--persist)}.successor{grid-area:successor;border-top:5px solid var(--persist)}.next{grid-area:next;border-top:5px solid var(--persist)}.evo-wires{z-index:1;position:absolute;inset:45px 0 0;width:100%;height:calc(100% - 45px);pointer-events:none}.wire{fill:none;stroke-width:4;vector-effect:non-scaling-stroke}.wire.state{stroke:var(--state)}.wire.env{stroke:var(--env)}.wire.boundary,.wire.branch{stroke:var(--experience)}.wire.boundary{stroke-dasharray:10 8}.wire.converge,.wire.persist,.wire.loop{stroke:var(--persist)}.wire.loop{stroke-dasharray:12 9;animation:evoLoop 5s linear infinite}.wire-label{z-index:3;position:absolute;padding:.2rem .36rem;border:1px solid var(--line);border-radius:999px;background:var(--surface);box-shadow:0 4px 11px color-mix(in srgb,#000 5%,transparent);font:730 .49rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.completion-boundary{right:23%;top:31%;color:var(--experience)}.fanout-label{left:50%;top:54%;transform:translateX(-50%);color:var(--experience)}.validated-label{left:50%;bottom:19%;transform:translateX(-50%);color:var(--persist)}.webshop-path{margin-top:.75rem;padding:.8rem;border:1px solid color-mix(in srgb,var(--state) 32%,var(--line));border-radius:14px;background:color-mix(in srgb,var(--state) 4%,var(--surface))}.webshop-path>header{display:flex;align-items:baseline;gap:.55rem;flex-wrap:wrap}.webshop-path>header span{color:var(--state);font:850 .55rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.webshop-path h3{margin:0;font-size:.7rem}.path-canvas{display:grid;grid-template-columns:1fr 34px 1fr 34px 1fr 34px 1fr 34px 1fr;align-items:center;gap:.25rem;margin-top:.65rem}.path-canvas article{padding:.55rem;border:1px solid var(--line);border-top:4px solid var(--state);border-radius:9px;background:var(--surface)}.path-canvas article:first-child{border-top-color:var(--experience)}.path-canvas article:last-child{border-top-color:var(--persist)}.path-canvas small,.path-canvas strong{display:block}.path-canvas small{color:var(--muted);font-size:.48rem}.path-canvas strong{margin-top:.18rem;font-size:.57rem}.path-canvas i{position:relative;height:3px;background:var(--state)}.path-canvas i:after{content:"";position:absolute;right:-1px;top:-4px;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:7px solid var(--state)}.webshop-path>p{margin:.55rem 0 0;color:var(--muted);font-size:.59rem;line-height:1.46}.mental-model{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin-top:.65rem}.mental-model article{padding:.7rem;border:1px solid var(--line);border-radius:10px;background:var(--surface-muted)}.mental-model small,.mental-model strong{display:block}.mental-model small{color:var(--muted);font-size:.55rem}.mental-model strong{margin-top:.22rem;font-size:.65rem;line-height:1.45}.technical-details{margin-top:.7rem;border:1px solid var(--line);border-radius:11px;background:var(--surface-muted)}.technical-details summary{cursor:pointer;padding:.68rem .75rem;font-size:.63rem;font-weight:800}.technical-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;padding:0 .75rem .75rem}.technical-grid article{padding:.62rem;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.technical-grid strong{font-size:.61rem}.technical-grid p{margin:.25rem 0 0;color:var(--muted);font-size:.56rem;line-height:1.45}@keyframes evoLoop{to{stroke-dashoffset:-42}}@media(prefers-reduced-motion:reduce){.wire.loop{animation:none}}@media(max-width:960px){.principles{grid-template-columns:1fr}.evo-scene{grid-template-columns:1fr;grid-template-areas:"cap" "head" "environment" "evidence" "engine" "memory" "artifact" "adapter" "validation" "successor" "next";min-height:auto}.node,.carrier,.engine,.validation{width:100%}.evo-wires,.wire-label{display:none}.node:not(.next):after,.carrier:after{content:"";position:absolute;left:50%;bottom:-1.05rem;width:3px;height:1.05rem;background:color-mix(in srgb,var(--muted) 45%,transparent)}.path-canvas{grid-template-columns:1fr}.path-canvas i{width:3px;height:24px;margin:auto}.path-canvas i:after{left:-4px;right:auto;top:auto;bottom:-1px;border-left:5px solid transparent;border-right:5px solid transparent;border-top:7px solid var(--state);border-bottom:0}.mental-model,.technical-grid{grid-template-columns:1fr}}@media(max-width:560px){.openevo-framework{width:min(100% - 1rem,1180px);padding:.8rem}}
  /* Dashed routes stay still; motion made the topology harder to read. */
  .wire.loop{animation:none!important}
</style>
