---
import { localePath, type Locale } from '../../i18n';
import ResearchDiagramLegend from './ResearchDiagramLegend.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---

<section id="fig-seed-openevo-update-target" class="canonical-figure comparison-figure" aria-labelledby="seed-openevo-canonical-title" data-ui-audit="contrast layout overflow readability">
  <header class="figure-header">
    <div class="figure-label">FIGURE C1 · SEED × OPENEVO</div>
    <h2 id="seed-openevo-canonical-title">{t('同一份任务经验，SEED 和 OpenEvo 到底把什么东西变了？','Given the same task experience, what does SEED change — and what does OpenEvo change?')}</h2>
    <p data-ui-prose>{t('两种方法都从已完成的任务经验开始：SEED 把 hindsight 组织成 policy 更新；OpenEvo 把 evidence 交给 evolution method，形成后续任务可以加载的 successor state。','Both methods begin from completed task experience: SEED turns hindsight into a policy update, while OpenEvo hands evidence to an evolution method that forms successor state for later tasks.')}</p>
    <div class="figure-actions">
      <a href={p('/research/seed-openevo/flow/webshop/#fig-seed-webshop')}>{t('SEED × WebShop 具体图 →','SEED × WebShop concrete figure →')}</a>
      <a href={p('/research/seed-openevo/flow/openevo/')}>{t('OpenEvo 完整机制 →','Full OpenEvo mechanism →')}</a>
    </div>
  </header>

  <figure class="comparison-body">
    <div class="shared-experience" data-ui-audit-item>
      <small>SHARED EXPERIENCE</small>
      <strong>task + observations + sampled actions + outcome</strong>
      <span data-ui-prose>{t('同一次任务结束后，两种框架都先拿到这份 completed experience。','After the same task ends, both frameworks first receive this completed experience.')}</span>
    </div>

    <div class="framework-columns" data-ui-audit="layout">
      <article class="framework-column seed-column" data-ui-audit-item>
        <header class="column-header">
          <span>SEED</span>
          <strong>{t('把 hindsight 写回 policy','Write hindsight back into the policy')}</strong>
        </header>

        <div class="framework-wrapper seed-wrapper">
          <div class="wrapper-name">SEED</div>
          <div class="agent-inner trainable-agent">
            <span class="paper-symbol" aria-hidden="true">🔥</span>
            <div><small>AGENT / POLICY</small><strong>π<sub>θ</sub></strong></div>
          </div>
          <p data-ui-prose>{t('训练阶段，optimizer 真正更新的是 policy 参数。','During training, the optimizer updates the policy parameters.')}</p>
        </div>

        <div class="column-flow">
          <div class="flow-node"><small>LOOK BACK</small><strong>📄 hindsight skill</strong></div>
          <i aria-hidden="true">↓</i>
          <div class="flow-node signal"><small>LEARNING SIGNAL</small><strong>OPD + RL</strong></div>
          <i aria-hidden="true">↓</i>
          <div class="change-node parameter-change">
            <span class="paper-symbol" aria-hidden="true">🔥</span>
            <div><small>WHAT CHANGES?</small><strong>MODEL PARAMETERS · θ → θ′</strong></div>
          </div>
        </div>

        <section class="next-task seed-next">
          <small>NEXT ROUND / INFERENCE</small>
          <div class="next-agent"><strong>Agent θ′</strong><span data-ui-prose>{t('经验已经内化进模型本身','experience is internalized in the model')}</span></div>
          <i aria-hidden="true">↓</i>
          <b>new task</b>
          <p data-ui-prose>{t('推理时不需要永久携带 hindsight analyzer 或 skill prompt。','Inference does not require permanently carrying the hindsight analyzer or skill prompt.')}</p>
        </section>
      </article>

      <article class="framework-column evo-column" data-ui-audit-item>
        <header class="column-header">
          <span>OpenEvo</span>
          <strong>{t('把 evidence 变成 successor state','Turn evidence into successor state')}</strong>
        </header>

        <div class="framework-wrapper evo-wrapper">
          <div class="wrapper-name">OpenEvo</div>
          <div class="agent-inner">
            <small>AGENT</small><strong>{t('base / current Agent','base / current Agent')}</strong>
          </div>
          <div class="carrier-slot"><small>EVOLUTION CARRIER</small><span>memory · skill · instructions · adapter</span></div>
          <p data-ui-prose>{t('OpenEvo 规定任务边界、evidence、evolution 与 successor 的合同；具体 carrier 决定经验最后以什么形式保存。','OpenEvo defines the task-boundary, evidence, evolution, and successor contract; the carrier determines the form in which experience persists.')}</p>
        </div>

        <div class="column-flow">
          <div class="flow-node"><small>TASK BOUNDARY</small><strong>📄 sealed evidence</strong></div>
          <i aria-hidden="true">↓</i>
          <div class="flow-node experience"><small>EVOLUTION METHOD</small><strong>reflect / extract / parametric update</strong></div>
          <i aria-hidden="true">↓</i>
          <div class="change-node carrier-change">
            <span aria-hidden="true">✓</span>
            <div><small>WHAT CHANGES?</small><strong>VALIDATED SUCCESSOR CARRIER / STATE</strong></div>
          </div>
        </div>

        <div class="carrier-note" data-ui-audit-item aria-label={t('OpenEvo carrier 参数状态','OpenEvo carrier parameter status')}>
          <span><b aria-hidden="true">❄️</b><strong>non-weight</strong><em>{t('Agent 参数不变','Agent parameters unchanged')}</em></span>
          <span><b aria-hidden="true">🔥</b><strong>parametric</strong><em>{t('adapter 可更新','adapter may update')}</em></span>
        </div>

        <section class="next-task evo-next">
          <small>NEXT TASK</small>
          <div class="successor-package"><strong>OpenEvo</strong><div class="next-agent"><span>Agent</span><b>+</b><span>{t('accepted carrier','accepted carrier')}</span></div></div>
          <i aria-hidden="true">↓</i>
          <b>new task</b>
          <p data-ui-prose>{t('只有经过 validation / promotion 的 successor，才从后续任务开始生效。','Only a successor that passes validation / promotion activates on later tasks.')}</p>
        </section>
      </article>
    </div>

    <figcaption data-ui-prose>
      <strong>{t('Figure C1｜同一份任务经验，两种不同的持久化路径。','Figure C1 | The same task experience, two persistence paths.')}</strong>
      {t('SEED 把 completed trajectory 转成 hindsight supervision，并通过 OPD 与 outcome-based RL 更新 policy 参数；OpenEvo 在任务边界封存 evidence，再由选定的 evolution method 产生并验证 successor carrier/state。OpenEvo 方法页进一步区分 memory、artifact 与 parametric adapter 等 carrier。','SEED converts a completed trajectory into hindsight supervision and updates policy parameters through OPD plus outcome-based RL; OpenEvo seals evidence at the task boundary and uses the selected evolution method to produce and validate successor carrier/state. The OpenEvo method page further distinguishes memory, artifact, and parametric-adapter carriers.')}
    </figcaption>
  </figure>

  <ResearchDiagramLegend locale={locale} />
</section>

<style>
.comparison-figure{--env:#2563eb;--experience:#d97706;--signal:#dc2626;--state:#7c3aed;--persist:#059669;width:100%;margin:0;padding:clamp(1rem,2vw,1.45rem);border:1px solid var(--line);border-radius:24px;background:linear-gradient(90deg,color-mix(in srgb,var(--signal) 2.6%,var(--surface)),var(--surface) 48%,color-mix(in srgb,var(--state) 2.6%,var(--surface)));box-shadow:0 22px 70px color-mix(in srgb,#000 7%,transparent)}
.figure-header{max-width:980px}.figure-label{color:var(--state);font:850 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.figure-header h2{margin:.45rem 0 .6rem;font-size:clamp(1.45rem,2.7vw,2.3rem);letter-spacing:-.035em;line-height:1.12}.figure-header p{max-width:78ch;margin:0;color:var(--muted);font-size:.92rem;line-height:1.7}.figure-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}.figure-actions a{padding:.45rem .7rem;border:1px solid var(--line);border-radius:999px;color:var(--ink);font-size:.72rem;text-decoration:none}.figure-actions a:hover,.figure-actions a:focus-visible{border-color:var(--state);color:var(--state)}
.comparison-body{margin:1.1rem 0 0}.shared-experience{width:min(760px,94%);margin:0 auto .85rem;padding:.8rem 1rem;border:1.5px solid color-mix(in srgb,var(--env) 46%,var(--line));border-top:5px solid var(--env);border-radius:14px;background:color-mix(in srgb,var(--env) 4%,var(--surface));text-align:center}.shared-experience small,.shared-experience strong,.shared-experience span{display:block}.shared-experience small,.column-header span,.flow-node small,.change-node small,.next-task small{color:var(--muted);font:850 .64rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.055em}.shared-experience strong{margin:.28rem 0;font-size:.84rem}.shared-experience span{color:var(--muted);font-size:.76rem;line-height:1.5}
.framework-columns{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.15rem;position:relative}.framework-columns:after{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:1px dashed color-mix(in srgb,var(--muted) 22%,transparent);pointer-events:none}.framework-column{position:relative;z-index:1;min-width:0;padding:1rem;border:1px solid var(--line);border-radius:17px;background:color-mix(in srgb,var(--surface) 97%,transparent)}.seed-column{box-shadow:inset 0 4px 0 color-mix(in srgb,var(--signal) 75%,transparent)}.evo-column{box-shadow:inset 0 4px 0 color-mix(in srgb,var(--state) 75%,transparent)}.column-header{text-align:center;padding:.15rem .3rem .75rem}.column-header span,.column-header strong{display:block}.column-header span{color:var(--signal);font-size:.76rem}.evo-column .column-header span{color:var(--state)}.column-header strong{margin-top:.28rem;font-size:.84rem;line-height:1.4}
.framework-wrapper{position:relative;padding:1.9rem .85rem .8rem;border:2px solid color-mix(in srgb,var(--signal) 46%,var(--line));border-radius:16px;background:color-mix(in srgb,var(--signal) 3%,var(--surface))}.evo-wrapper{border-color:color-mix(in srgb,var(--state) 46%,var(--line));background:color-mix(in srgb,var(--state) 3%,var(--surface))}.wrapper-name{position:absolute;top:.6rem;left:.75rem;color:var(--signal);font:900 .7rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.evo-wrapper .wrapper-name{color:var(--state)}.agent-inner{display:flex;align-items:center;justify-content:center;gap:.45rem;padding:.7rem;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.agent-inner small,.agent-inner strong{display:block}.agent-inner small{color:var(--muted);font:800 .62rem ui-monospace,SFMono-Regular,Menlo,monospace}.agent-inner strong{font-size:.82rem}.paper-symbol{font-size:1rem}.framework-wrapper>p{margin:.6rem 0 0;color:var(--muted);font-size:.76rem;line-height:1.58}.carrier-slot{margin-top:.48rem;padding:.55rem;border:1px dashed color-mix(in srgb,var(--state) 38%,var(--line));border-radius:9px;text-align:center}.carrier-slot small,.carrier-slot span{display:block}.carrier-slot small{color:var(--muted);font:800 .6rem ui-monospace,SFMono-Regular,Menlo,monospace}.carrier-slot span{margin-top:.2rem;font-size:.72rem;line-height:1.45}
.column-flow{display:grid;justify-items:center;gap:.32rem;margin-top:.7rem}.column-flow>i{color:var(--muted);font-style:normal}.flow-node,.change-node{width:min(390px,96%);padding:.68rem .8rem;border:1px solid var(--line);border-radius:11px;background:var(--surface);text-align:center}.flow-node{border-top:4px solid var(--experience)}.flow-node.signal{border-top-color:var(--signal)}.flow-node.experience{border-top-color:var(--experience)}.flow-node small,.flow-node strong{display:block}.flow-node strong{margin-top:.24rem;font-size:.78rem;line-height:1.4}.change-node{display:flex;align-items:center;justify-content:center;gap:.45rem;border-top:4px solid #f97316}.change-node>span{font-size:1rem}.change-node small,.change-node strong{display:block}.change-node strong{margin-top:.15rem;font-size:.76rem;line-height:1.42}.carrier-change{border-top-color:var(--persist)}.carrier-change>span{color:var(--persist)}
.carrier-note{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin-top:.65rem}.carrier-note span{display:flex;align-items:center;justify-content:center;gap:.38rem;padding:.5rem .6rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);font-size:.74rem;line-height:1.35;text-align:center}.carrier-note b{flex:0 0 auto;font-size:.88rem}.carrier-note strong{font-size:.72rem}.carrier-note em{color:var(--muted);font-size:.72rem;font-style:normal}
.next-task{margin-top:.7rem;padding:.75rem;border:1.5px solid color-mix(in srgb,var(--persist) 45%,var(--line));border-radius:13px;background:color-mix(in srgb,var(--persist) 4%,var(--surface));text-align:center}.next-task>small{display:block}.next-task>i{display:block;margin:.25rem 0;color:var(--persist);font-style:normal}.next-task>b{font-size:.76rem}.next-task>p{margin:.45rem auto 0;max-width:46ch;color:var(--muted);font-size:.74rem;line-height:1.55}.next-agent{margin:.4rem auto 0;padding:.55rem;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.next-agent strong,.next-agent span{display:block}.next-agent strong{font-size:.8rem}.next-agent span{margin-top:.12rem;color:var(--muted);font-size:.72rem;line-height:1.45}.successor-package{margin-top:.4rem;padding:.55rem;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.successor-package>strong{display:block;color:var(--state);font:900 .64rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.successor-package .next-agent{display:flex;align-items:center;justify-content:center;gap:.45rem;margin-top:.35rem}.successor-package .next-agent span{margin:0}.successor-package .next-agent b{color:var(--state)}
.comparison-body figcaption{margin-top:.9rem;padding-top:.8rem;border-top:1px solid var(--line);color:var(--muted);font-size:.78rem;line-height:1.65}.comparison-body figcaption strong{color:var(--ink)}
@media(max-width:900px){.framework-columns{grid-template-columns:1fr}.framework-columns:after{display:none}.carrier-note{grid-template-columns:1fr}}
@media(max-width:620px){.comparison-figure{padding:.85rem;border-radius:17px}.framework-column{padding:.75rem}.carrier-note span{flex-wrap:wrap}.figure-actions a{width:100%;text-align:center}}
</style>
