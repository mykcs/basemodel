---
import type { Locale } from '../../i18n';
import { openEvoCeilingStage2Snapshot as snap } from '../../data/openEvoCeilingStage2Snapshot';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const pct = ((snap.sevenB.rolloutsConsumed / snap.totalRollouts) * 100).toFixed(2);
const stage1 = [
  { n:'01', title:'OPSD', text:t('用已封存的 MiniMax episode_skill 作为 teacher-view 的额外信息；student view 与 teacher view 对同一个学生原始 completion 打分。Stage 1 的参数化 bootstrap 只由 OPSD 承担。','Use sealed MiniMax episode_skill as privileged teacher-view context while scoring the same original student completion from the student and teacher views. OPSD is the sole parametric bootstrap in Stage 1.') },
  { n:'02', title:'Text Memory', text:t('完整覆盖 1,440 / 1,440 条封存老师证据做层级整理；后续反思只用同尺度本地 Qwen，不再追加 MiniMax / GPT / GLM 老师调用。','Hierarchically consolidate all 1,440 / 1,440 sealed teacher evidence items; later reflection uses same-scale local Qwen with no extra MiniMax / GPT / GLM teacher calls.') },
  { n:'03', title:'Agent System', text:t('把任务级证据整理为可被 WebShop runtime 真实注入的行为约束与恢复策略；能生成文件不等于 carrier 生效，必须通过 runtime readback。','Turn task-level evidence into behavior constraints and recovery policy that the WebShop runtime actually injects. Creating a file is not enough; runtime readback must prove the carrier is consumed.') },
  { n:'04', title:'Skill Bundle', text:t('初始设计曾因为缺少已证明的 loader 而禁用 Skill；最终 Stage-2 协议只在 consumption path 通过 qualification 后才启用，并允许每轮根据证据更新或 NOOP。','The initial design disabled Skill because no qualified loader existed. The final Stage-2 protocol enables it only after the consumption path was qualified, and each round may update it or record a NOOP.') },
] as const;
---
<main class="ceiling" data-testid="ceiling-stage2-strategy">
  <OpenEvoStage2StrategyChooser locale={locale} active="ceiling" />
  <header class="ceiling__hero">
    <div>
      <p>OPENEVO-CEILING-1.0 · STAGE2 CONFIG {snap.configSha256.slice(0,12)}</p>
      <h1>{t('Stage 2：同一轮证据分别更新四种可继承状态', 'Stage 2: one round of evidence updates four inheritable states')}</h1>
      <span>{t('Ceiling-1.0 保持 WebShop 任务尝试预算和外部老师预算不变。每 128 次完整任务尝试形成一轮共同证据；Text Memory、SD-LoRA、Skill Bundle、Agent System 四种可继承状态分别判断是否更新，证据不足就保持原状态，一轮结束后只合并一次。旧的 7/8 逐块门槛明确停用。', 'Ceiling-1.0 keeps the WebShop attempt budget and external-teacher budget fixed. Every 128 complete attempts form one shared evidence set; Text Memory, SD-LoRA, Skill Bundle, and Agent System each decide whether to update, otherwise remain unchanged, and the round is composed once at the end. The old 7/8 per-block gate is explicitly disabled.')}</span>
    </div>
    <aside>
      <span>{t('2026-08-31 receipt 快照', '2026-08-31 RECEIPT SNAPSHOT')}</span>
      <strong>{t(`7B Stage 2 正在运行：已封存 round ${snap.sevenB.completedRange}`, `7B Stage 2 is running: rounds ${snap.sevenB.completedRange} are sealed`)}</strong>
      <small>{t(`已消费 ${snap.sevenB.rolloutsConsumed.toLocaleString()} / ${snap.totalRollouts.toLocaleString()} rollout（${pct}%）；final panel 访问 ${snap.sevenB.finalPanelAccessCount} 次。`, `${snap.sevenB.rolloutsConsumed.toLocaleString()} / ${snap.totalRollouts.toLocaleString()} rollouts consumed (${pct}%); final-panel accesses: ${snap.sevenB.finalPanelAccessCount}.`)}</small>
    </aside>
  </header>
  <section class="ceiling__section">
    <p class="kicker">SCIENTIFIC QUESTION</p>
    <h2>{t('我们不是在问“能不能凑到 8”，而是在问固定预算下 OpenEVO 能进化到哪里', 'The question is not whether the run can reach eight; it is how far OpenEVO can evolve under fixed budgets')}</h2>
    <p>{t('外部老师信息在 Stage 1 封存后停止增长；Stage 2 不再调用 MiniMax。最终 128 任务 panel 在 Stage 2 全部封存前保持锁定，不能被拿来调 gate、选 checkpoint 或做 smoke。', 'External-teacher information stops growing after Stage 1 is sealed; Stage 2 makes no MiniMax calls. The final 128-task panel stays locked until Stage 2 is sealed and cannot be used to tune gates, select checkpoints, or run smoke tests.')}</p>
    <div class="ceiling__budget">
      <div><b>1,440</b><span>{t('Stage-1 student trajectories', 'Stage-1 student trajectories')}</span></div>
      <div><b>1,440</b><span>{t('封存 MiniMax analyses', 'sealed MiniMax analyses')}</span></div>
      <div><b>20,480</b><span>Stage-2 rollouts</span></div>
      <div><b>128</b><span>{t('最终 panel，只在 Stage 2 封存后访问', 'final panel, only after Stage 2 seal')}</span></div>
    </div>
  </section>

  <section class="ceiling__section">
    <p class="kicker">STAGE 1 · BOOTSTRAP STATE</p>
    <h2>{t('老师信息必须变成 runtime 真正会读取的状态', 'Teacher evidence must become state the runtime actually consumes')}</h2>
    <div class="ceiling__cards">{stage1.map((item) => <article><span>{item.n}</span><strong>{item.title}</strong><p>{item.text}</p></article>)}</div>
    <p class="ceiling__note">{t('这也是为什么“生成了 SKILL.md / memory.md”本身不算能力：文件存在只证明 artifact 被写出，runtime readback 才证明模型下一轮真的看见它。', 'This is why merely generating SKILL.md or memory.md does not count as capability: file existence proves an artifact was written, while runtime readback proves the next model round actually sees it.')}</p>
  </section>

  <section class="ceiling__section">
    <p class="kicker">STAGE 2 · 160 × 128</p>
    <h2>{t('每 128 次任务尝试形成一轮共同证据，不是成功门槛', 'Every 128 task attempts form one shared evidence set; 128 is not a success threshold')}</h2>
    <div class="ceiling__rounds">
      <article><b>128</b><strong>{t('每轮完整任务尝试', 'complete task attempts per round')}</strong><p>{t('16 个任务 × 每任务 8 次。四种可继承状态都读取这一轮同一份已固定证据，并从同一个轮前状态开始。', '16 tasks × 8 attempts. All four inheritable states read the same frozen evidence set and start from the same pre-round state.')}</p></article>
      <article><b>0–16</b><strong>{t('SD-LoRA 每轮最多使用 16 条完整成功轨迹', 'SD-LoRA uses at most 16 exact-success trajectories per round')}</strong><p>{t('每个任务最多选最早出现的 1 条完整且技术有效的成功轨迹。若这一轮一条都没有，参数保持不变（NOOP）；至少有 1 条时，才允许进行一次原生 SD-LoRA 参数更新。', 'Select at most the earliest complete, technically valid success from each task. If the round has none, parameters remain unchanged (NOOP); with at least one, one native SD-LoRA parameter update is allowed.')}</p></article>
      <article><b>4</b><strong>{t('种可继承状态分别判断是否更新', 'inheritable states decide independently')}</strong><p>{t('这里把 Text Memory、SD-LoRA、Skill Bundle、Agent System 统称为 carrier（可带到下一轮的状态）。同一轮里，它们不能把刚产生的新状态互相喂给对方，避免执行顺序改变实验含义。', 'Text Memory, SD-LoRA, Skill Bundle, and Agent System are carriers: states that can persist into the next round. Within one round they cannot feed newly produced state into one another, preventing execution order from changing the experimental meaning.')}</p></article>
      <article><b>1×</b><strong>{t('最后 compose 一次', 'one compose at the end')}</strong><p>{t('四个 terminal receipt 都闭合后才生成 State_(k+1)；新的 state 只影响下一轮，不回写产生它的轨迹。', 'State_(k+1) is composed only after all four terminal receipts close; the new state affects only later rounds and never rewrites the trajectories that produced it.')}</p></article>
    </div>
    <div class="ceiling__transition"><code>本轮开始状态 + 128 次任务尝试形成的共同证据</code><span>→ 四种可继承状态分别判断是否更新 →</span><code>统一合并一次 → 下一轮状态</code></div>
  </section>
  <section class="ceiling__section ceiling__compare">
    <div><p class="kicker">{t('历史错误规则', 'SUPERSEDED RULE')}</p><h2>256-window hard gate</h2><ul><li>256 rollouts / window</li><li>8 identities × 2 successes</li><li>{t('局部门槛决定是否允许学习', 'local threshold decides permission to learn')}</li><li>{t('历史四臂都得到 0 次 Stage-2 参数更新', 'all four historical arms produced zero Stage-2 parameter updates')}</li></ul></div>
    <div><p class="kicker">{t('当前规则', 'CURRENT RULE')}</p><h2>{t('每 128 次任务尝试形成一轮共同证据', 'One shared evidence set per 128 task attempts')}</h2><ul><li>{t('每轮 128 次完整任务尝试', '128 complete task attempts per round')}</li><li>{t('旧的 7 / 8 逐块任务数门槛不再使用', 'the old 7 / 8 per-block task-count gate is no longer used')}</li><li>{t('四种可继承状态分别根据自己的证据条件决定更新或保持原状', 'each inheritable state independently decides whether to update or remain unchanged')}</li><li>{t('一轮结束后只统一合并一次', 'compose exactly once at round end')}</li></ul></div>
  </section>

  <section class="ceiling__section">
    <p class="kicker">CARRIER GATES</p>
    <h2>{t('证据不足时保持原状态也是合法结果（NOOP）', 'Leaving state unchanged when evidence is insufficient is a valid outcome (NOOP)')}</h2>
    <div class="ceiling__carrier-grid">
      <article><strong>Text Memory</strong><p>{t('只有完整且技术有效的成功轨迹、同一任务的原始得分对比，或能从轨迹重复验证的失败模式，才支持修改记忆；否则保持原状态（NOOP）。', 'Update memory only from complete technically valid successes, within-task raw-score contrasts, or repeated failure patterns verifiable from trajectories; otherwise leave it unchanged (NOOP).')}</p></article>
      <article><strong>SD-LoRA</strong><p>{t('当前轮至少 1 个任务存在 clean exact success 才允许一次 generation；不跨轮藏一份 raw-success buffer 来凑门槛。', 'One or more tasks in the current round must have a clean exact success to permit one generation; no hidden cross-round raw-success buffer is used to accumulate a threshold.')}</p></article>
      <article><strong>Skill Bundle</strong><p>{t('当前轮至少要有 2 个不同任务提供支持证据；先做一次主要反思，最多再修一次。仍不满足条件就保持原状态，不继续尝试（内部状态：NOOP / fail-closed）。', 'The current round needs support from at least two distinct tasks; run one primary reflection and at most one repair. If that is still insufficient, leave the state unchanged and stop further attempts for this round (NOOP / fail-closed).')}</p></article>
      <article><strong>Agent System</strong><p>{t('当前轮至少要有 3 个不同任务提供支持证据；同样只允许一次主要反思和最多一次修复。同一轮里，它不能读取其他模块刚生成的新状态。', 'The current round needs support from at least three distinct tasks; it likewise gets one primary reflection and at most one repair. Within the same round it cannot inspect newly produced state from another module.')}</p></article>
    </div>
    <p class="ceiling__note">{t('Task Vector 在当前协议里只做诊断：modify_training=false，modify_next_round=false。达到 native SD-LoRA 64-component hard cap 时冻结参数 carrier，但不因此提前结束剩余 rollout 或其他 carrier。', 'Task Vector is diagnostic only in the current protocol: modify_training=false and modify_next_round=false. At the native SD-LoRA 64-component hard cap, the parametric carrier freezes without ending the remaining rollout budget or other carriers.')}</p>
  </section>

  <section class="ceiling__section">
    <p class="kicker">RECEIPT-BACKED EXECUTION SNAPSHOT</p>
    <h2>{t('策略是冻结的；下面的进度只是带时间边界的运行快照', 'The strategy is frozen; the progress below is a time-bounded execution snapshot')}</h2>
    <div class="ceiling__arm-status">
      <article class="running"><span>7B</span><strong>{t('Stage 2 正在运行', 'Stage 2 running')}</strong><dl><div><dt>{t('已封存 rounds', 'sealed rounds')}</dt><dd>{snap.sevenB.completedRange} ({snap.sevenB.roundsComplete})</dd></div><div><dt>rollouts</dt><dd>{snap.sevenB.rolloutsConsumed.toLocaleString()} / {snap.totalRollouts.toLocaleString()}</dd></div><div><dt>SD-LoRA generations</dt><dd>{snap.sevenB.sdGenerations}</dd></div><div><dt>{t('外部老师调用', 'external-teacher calls')}</dt><dd>{snap.sevenB.externalTeacherCalls}</dd></div><div><dt>final panel access</dt><dd>{snap.sevenB.finalPanelAccessCount}</dd></div></dl><p>{t(`快照时 round ${snap.sevenB.nextRound} 已进入 rollout。这个数字不是最终结果；后续 progress 必须由新的 execution-state / receipt 更新。`, `At snapshot time, round ${snap.sevenB.nextRound} had entered rollout. This is not a final result; later progress must be updated from newer execution-state / receipts.`)}</p></article>
      <article class="blocked"><span>3B</span><strong>{t('3B 还没有满足进入 Stage 2 的条件', '3B has not yet met the conditions to enter Stage 2')}</strong><p>{t('3B 的 Text Memory 一次必须同时处理固定的 20 条记录。主要尝试和使用完全相同 20 条记录的一次修复尝试都撞到了 2,048-token 输出上限。当前实验协议既不允许偷偷拆成 10+10，也不允许自动提高上限，所以流程在这里停止，等待明确的科学设计决策（内部称 fail-closed）；这不表示 3B 实验本身失败。', 'The 3B Text Memory step must process the same fixed set of 20 records in one call. Both the primary attempt and the one repair using those exact same 20 records hit the 2,048-token output cap. The current protocol allows neither silently splitting them into 10+10 nor automatically raising the cap, so the workflow stops here pending an explicit scientific-design decision (fail-closed); this does not mean the 3B experiment itself failed.')}</p></article>
    </div>
    <p class="ceiling__snapshot-note">{t(`证据边界：${snap.observedAt} 读取 7B execution-state；Stage-2 config SHA-256 = ${snap.configSha256}；final panel access = 0。网页不是运行 authority，后续实验始终以当前 config / activation / immutable receipts / live execution-state 为准。`, `Evidence boundary: 7B execution-state read at ${snap.observedAt}; Stage-2 config SHA-256 = ${snap.configSha256}; final-panel access = 0. This webpage is not execution authority; current config, activation, immutable receipts, and live execution-state always take precedence.`)}</p>
  </section>
</main>
<style>
.ceiling{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}
.ceiling__hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:2rem;align-items:end;padding:2rem 0;border-bottom:1px solid var(--color-border)}.ceiling__hero>div>p,.kicker{margin:0 0 .55rem;color:var(--color-accent);font:800 .64rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.ceiling__hero h1,.ceiling__section h2{margin:0;letter-spacing:-.04em}.ceiling__hero h1{font-size:clamp(2rem,5vw,4rem)}.ceiling__hero>div>span{display:block;margin-top:.8rem;color:var(--color-text-muted);line-height:1.7}.ceiling__hero aside{display:flex;flex-direction:column;gap:.35rem;padding:1rem;border:1px solid var(--color-border);border-radius:12px}.ceiling__hero aside span{color:var(--color-text-muted);font:800 .6rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__hero aside strong{font-size:.8rem}.ceiling__hero aside small{color:var(--color-text-muted);line-height:1.55}
.ceiling__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.ceiling__section h2{font-size:clamp(1.4rem,3vw,2.25rem)}.ceiling__section>p,.ceiling__note,.ceiling__snapshot-note{color:var(--color-text-muted);line-height:1.65}.ceiling__budget,.ceiling__cards,.ceiling__rounds{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;margin-top:1.1rem}.ceiling__budget>div,.ceiling__cards article,.ceiling__rounds article,.ceiling__carrier-grid article,.ceiling__arm-status article{padding:.9rem;border:1px solid var(--color-border);border-radius:10px}.ceiling__budget b,.ceiling__rounds b{display:block;color:var(--color-accent);font:850 1.35rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__budget span{display:block;margin-top:.3rem;color:var(--color-text-muted);font-size:.7rem}.ceiling__cards span{color:var(--color-accent);font:800 .62rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__cards strong,.ceiling__rounds strong,.ceiling__carrier-grid strong{display:block;margin:.4rem 0;font-size:.8rem}.ceiling__cards p,.ceiling__rounds p,.ceiling__carrier-grid p{margin:0;color:var(--color-text-muted);font-size:.72rem;line-height:1.55}
.ceiling__transition{display:flex;align-items:center;justify-content:center;gap:.8rem;margin-top:1rem;padding:1rem;border:1px dashed var(--color-border);border-radius:10px;text-align:center}.ceiling__transition code{white-space:normal;font-size:.68rem}.ceiling__transition span{color:var(--color-accent);font-size:.72rem}
.ceiling__compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.ceiling__compare>div{padding:1rem;border:1px solid var(--color-border);border-radius:12px}.ceiling__compare>div:first-child{border-style:dashed}.ceiling__compare ul{margin:.8rem 0 0;padding-left:1.1rem}.ceiling__compare li{margin:.45rem 0;color:var(--color-text-muted);font-size:.76rem;line-height:1.55}
.ceiling__carrier-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin-top:1rem}.ceiling__arm-status{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1rem}.ceiling__arm-status article>span{color:var(--color-accent);font:820 .68rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__arm-status article>strong{display:block;margin:.35rem 0 .7rem}.ceiling__arm-status dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin:0}.ceiling__arm-status dl>div{padding:.55rem;border-radius:8px;background:color-mix(in srgb,var(--color-text) 3.5%,transparent)}.ceiling__arm-status dt{color:var(--color-text-muted);font-size:.58rem}.ceiling__arm-status dd{margin:.18rem 0 0;font:750 .7rem ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}.ceiling__arm-status p{margin:.7rem 0 0;color:var(--color-text-muted);font-size:.74rem;line-height:1.58}.ceiling__arm-status .blocked{border-style:dashed}.ceiling__snapshot-note{margin-top:1rem;font-size:.7rem;overflow-wrap:anywhere}
@media(max-width:820px){.ceiling__hero,.ceiling__compare,.ceiling__arm-status{grid-template-columns:1fr}.ceiling__budget,.ceiling__cards,.ceiling__rounds,.ceiling__carrier-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ceiling__transition{align-items:stretch;flex-direction:column}}
@media(max-width:520px){.ceiling__budget,.ceiling__cards,.ceiling__rounds,.ceiling__carrier-grid,.ceiling__arm-status dl{grid-template-columns:1fr}}
</style>
