---
import type { Locale } from '../../i18n';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';
interface Props { locale: Locale }
const { locale }=Astro.props;
const zh=locale==='zh';
const t=(cn:string,en:string)=>zh?cn:en;
const stage1=[
 {n:'01',title:'OPSD',text:t('用已封存的 MiniMax episode_skill 作为 teacher-view 的额外信息，同一个学生原始 completion 同时由 student/teacher view 打分；1 epoch，LoRA rank 8。','Use sealed MiniMax episode_skill as privileged teacher-view context while scoring the same original student completion from student/teacher views; 1 epoch, LoRA rank 8.')},
 {n:'02',title:'Text Memory',text:t('1440/1440 老师证据做层级压缩；后续 reflector 只用同尺度本地 Qwen，不再调用 MiniMax。','Hierarchically consolidate all 1440/1440 teacher evidence items; later reflection uses only same-scale local Qwen with no additional MiniMax calls.')},
 {n:'03',title:'Fixed Agent System',text:t('把 8 条同 task 分析聚成 180 个 task-level evidence group，生成固定 WebShop 工作流/约束检查/失败恢复；Stage 2 不在线改写。','Aggregate eight analyses per task into 180 task-level evidence groups and synthesize a fixed WebShop workflow, constraint checks, and recovery policy; it stays fixed in Stage 2.')},
 {n:'04',title:t('Skill 禁用','Skill disabled'),text:t('当前 WebShop runner 没有已证明的 skill loader；不把生成但没人读取的 SKILL.md 当作能力。','The current WebShop runner has no qualified skill loader, so an unread SKILL.md is not counted as a working carrier.')},
] as const;
const rounds=[
 {n:'128',title:t('rollouts / round','rollouts / round'),text:t('16 tasks × 每 task 8 次。这里是 frozen evolution dataset boundary，不是 success gate。','16 tasks × 8 attempts each. This is the frozen evolution dataset boundary, not a success gate.')},
 {n:'0..16',title:t('每 round 进入 SD-LoRA 的 trajectory','trajectories selected for SD-LoRA'),text:t('16 个 task 分别最多选最早的 1 条 clean exact success，避免容易 task 因多次成功被重复加权。','For each of the 16 tasks, select at most the earliest clean exact success so easy tasks are not overweighted by repeated wins.')},
 {n:'≥1',title:t('即可允许一次参数 generation','permits one parametric generation'),text:t('0 条 = SD_LORA_NOOP_NO_SUCCESS；至少 1 条 = 调用一次 pinned native parametric_memory_sd_lora。','Zero means SD_LORA_NOOP_NO_SUCCESS; one or more invokes one pinned native parametric_memory_sd_lora generation.')},
 {n:'128',title:t('Text Memory 也检查一次','Text Memory checks once'),text:t('只从 exact success、同 task raw-score 对比或可验证 failure pattern 更新；没有 grounded 新证据就 no-op。','Update only from exact success, within-task raw-score contrast, or trace-verifiable failure patterns; no grounded evidence means no-op.')},
] as const;
---
<main class="ceiling" data-testid="ceiling-stage2-strategy">
 <OpenEvoStage2StrategyChooser locale={locale} active="ceiling" />
 <header class="ceiling__hero"><div><p>OPENEVO-CEILING-1.0 · DESIGN SHA 8cfce26c</p><h1>{t('把 Stage 2 重新定义成“有证据就进化”','Redefining Stage 2 as evidence-driven evolution')}</h1><span>{t('Ceiling-1.0 的目标不是保守复现旧 gate，而是在同样的 WebShop 交互预算与 teacher-information envelope 下，让已经能被 WebShop harness 真正消费的 OpenEVO carriers 尽量工作。当前科学语义已冻结，但正式 Stage 2 仍需通过 activation gates 后才能 task-bearing launch。','Ceiling-1.0 does not preserve the old gate. Under the same WebShop interaction and teacher-information envelope, it lets OpenEVO carriers that are actually consumed by the WebShop harness work as fully as possible. Scientific semantics are frozen, but formal task-bearing Stage 2 still requires activation-gate qualification.')}</span></div><aside><span>{t('当前状态','STATUS')}</span><strong>design-frozen · implementation qualification in progress</strong><small>{t('Stage 2 正式 task consumption：尚未开始','Formal Stage-2 task consumption: not started')}</small></aside></header>
 <section class="ceiling__section"><p class="kicker">RESOURCE CONTRACT</p><h2>{t('预算不靠改 gate 偷变','The budget stays fixed while the learning rule changes')}</h2><div class="ceiling__budget"><div><b>1,440</b><span>{t('Stage-1 student trajectories','Stage-1 student trajectories')}</span></div><div><b>1,440</b><span>{t('封存 MiniMax analyses','sealed MiniMax analyses')}</span></div><div><b>20,480</b><span>Stage-2 rollouts</span></div><div><b>128</b><span>{t('最终 panel，只访问一次','final panel, one access')}</span></div></div><p>{t('Stage 1 之后新增 MiniMax / GPT / GLM privileged calls = 0；Stage 2 没有外部老师。','Additional privileged MiniMax / GPT / GLM calls after sealed Stage-1 analyses = 0; Stage 2 has no external teacher.')}</p></section>
 <section class="ceiling__section"><p class="kicker">STAGE 1 · TEACHER BOOTSTRAP</p><h2>{t('先把老师信息变成真正能被 runner 消费的状态','Turn teacher evidence into state the runner can actually consume')}</h2><div class="ceiling__cards">{stage1.map(x=><article><span>{x.n}</span><strong>{x.title}</strong><p>{x.text}</p></article>)}</div><p class="ceiling__note">{t('Stage-1 clean success 仍保留为诊断，但 Ceiling-1.0 不再叠加 Stage-1 SD-LoRA；OPSD 是唯一 Stage-1 parametric bootstrap，Stage 2 才开始 native SD-LoRA continual evolution。','Stage-1 clean successes remain diagnostic evidence, but Ceiling-1.0 does not stack Stage-1 SD-LoRA on top; OPSD is the sole Stage-1 parametric bootstrap, and native SD-LoRA continual evolution begins in Stage 2.')}</p></section>
 <section class="ceiling__section"><p class="kicker">STAGE 2 · 160 ROUNDS</p><h2>{t('128 是 dataset boundary，不是“成功够不够”的门槛','128 is a dataset boundary, not a success threshold')}</h2><div class="ceiling__rounds">{rounds.map(x=><article><b>{x.n}</b><strong>{x.title}</strong><p>{x.text}</p></article>)}</div><div class="ceiling__transition"><code>parameters_k + fixed Agent System + Memory_k</code><span>→ 128 rollouts →</span><code>optional Memory_(k+1) + optional one SD-LoRA generation</code></div></section>
 <section class="ceiling__section ceiling__compare"><div><p class="kicker">{t('旧规则','OLD')}</p><h2>256-window hard gate</h2><ul><li>2 rounds / 256 rollouts</li><li>8 identities × 2 successes</li><li>{t('不允许跨窗口累计','no cross-window accumulation')}</li><li>{t('未达 gate = 必然 no-update','miss gate = forced no-update')}</li></ul></div><div><p class="kicker">{t('Ceiling-1.0','NEW')}</p><h2>128-round evolution</h2><ul><li>1 round / 128 rollouts</li><li>{t('每 task 最多 1 条 earliest clean exact success','≤1 earliest clean exact success per task')}</li><li>{t('0 success 才 no-op；≥1 就可参数进化','zero success = no-op; ≥1 can evolve parameters')}</li><li>{t('Text Memory 按 grounded evidence 独立更新','Text Memory evolves independently from grounded evidence')}</li></ul></div></section>
 <section class="ceiling__section"><p class="kicker">FAIL-CLOSED BOUNDARIES</p><h2>{t('新策略也不是“有数据就随便学”','The new strategy is still fail-closed')}</h2><ul class="ceiling__guards"><li>{t('每条 trajectory 最多 15 steps；16 条最多 240 个 training examples，小于 pinned max_records=256，禁止 silent truncation。','At 15 steps per trajectory, 16 selected trajectories yield at most 240 training examples, below pinned max_records=256; silent truncation is forbidden.')}</li><li>{t('不跨 round 累积 success 来凑门槛，也不再要求 8 identities、每 task 两次成功或 16 条才更新。','Success is not accumulated across rounds to satisfy a threshold; there is no 8-identity, two-wins-per-task, or 16-trajectory gate.')}</li><li>{t('native SD-LoRA 达到 64-component hard cap 时冻结参数 carrier，但 Text Memory 与剩余 rollout 继续完成。','At the native 64-component hard cap, freeze the parametric carrier while Text Memory and remaining rollouts continue.')}</li><li>{t('所有 artifact 只影响后续 round，不回写产生它们的 trajectory；final 128 panel 永不参与训练或 checkpoint 选择。','Artifacts affect only later rounds and never rewrite the trajectories that created them; the final 128-task panel never participates in training or checkpoint selection.')}</li></ul></section>
 <section class="ceiling__section"><p class="kicker">ACTIVATION</p><h2>{t('设计冻结 ≠ 已经拿到最终结果','Design frozen does not mean the result exists')}</h2><p>{t('GPU7 的 synthetic native SD-LoRA、真实 WebShop OPSD 1-step、OPSD→SD-LoRA composition 技术路径已通过若干 qualification；但正式 activation 前仍保留多条真实 prompt 的 merge/reload behavioral-equivalence、Text Memory/Agent System runtime injection、Stage-2 evidence gate 等检查。页面不会在这些 gate 通过前把 Ceiling 写成“已经跑完”。','GPU7 qualification has already exercised synthetic native SD-LoRA, one real WebShop OPSD step, and the OPSD→SD-LoRA composition path. Formal activation still requires multi-prompt merge/reload behavioral equivalence, Text Memory and Agent System runtime injection, Stage-2 evidence-gate tests, and other fail-closed checks. This page will not present Ceiling as complete before those gates pass.')}</p></section>
</main>
<style>
.ceiling{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem;color:var(--color-text)}.ceiling__hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:2rem;align-items:end;padding:2rem 0;border-bottom:1px solid var(--color-border)}.ceiling__hero>div>p,.kicker{margin:0 0 .55rem;color:var(--color-accent);font:800 .64rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.ceiling__hero h1,.ceiling__section h2{margin:0;letter-spacing:-.04em}.ceiling__hero h1{font-size:clamp(2rem,5vw,4rem)}.ceiling__hero>div>span{display:block;margin-top:.8rem;color:var(--color-text-muted);line-height:1.7}.ceiling__hero aside{display:flex;flex-direction:column;gap:.35rem;padding:1rem;border:1px solid var(--color-border);border-radius:12px}.ceiling__hero aside span{color:var(--color-text-muted);font:800 .6rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__hero aside strong{font-size:.8rem}.ceiling__hero aside small{color:var(--color-text-muted)}.ceiling__section{padding:2.2rem 0;border-bottom:1px solid var(--color-border)}.ceiling__section h2{font-size:clamp(1.4rem,3vw,2.25rem)}.ceiling__section>p:last-child,.ceiling__note{color:var(--color-text-muted);line-height:1.65}.ceiling__budget,.ceiling__cards,.ceiling__rounds{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;margin-top:1.1rem}.ceiling__budget>div,.ceiling__cards article,.ceiling__rounds article{padding:.9rem;border:1px solid var(--color-border);border-radius:10px}.ceiling__budget b,.ceiling__rounds b{display:block;color:var(--color-accent);font:850 1.35rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__budget span{display:block;margin-top:.3rem;color:var(--color-text-muted);font-size:.7rem}.ceiling__cards span{color:var(--color-accent);font:800 .62rem ui-monospace,SFMono-Regular,Menlo,monospace}.ceiling__cards strong,.ceiling__rounds strong{display:block;margin:.4rem 0;font-size:.8rem}.ceiling__cards p,.ceiling__rounds p{margin:0;color:var(--color-text-muted);font-size:.72rem;line-height:1.55}.ceiling__transition{display:flex;align-items:center;justify-content:center;gap:.8rem;margin-top:1rem;padding:1rem;border:1px dashed var(--color-border);border-radius:10px;text-align:center}.ceiling__transition code{white-space:normal;font-size:.68rem}.ceiling__transition span{color:var(--color-accent);font-size:.72rem}.ceiling__compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.ceiling__compare>div{padding:1rem;border:1px solid var(--color-border);border-radius:12px}.ceiling__compare>div:first-child{border-style:dashed}.ceiling__compare ul,.ceiling__guards{margin:.8rem 0 0;padding-left:1.1rem}.ceiling__compare li,.ceiling__guards li{margin:.45rem 0;color:var(--color-text-muted);font-size:.76rem;line-height:1.55}.ceiling__guards{max-width:90ch}
@media(max-width:820px){.ceiling__hero,.ceiling__compare{grid-template-columns:1fr}.ceiling__budget,.ceiling__cards,.ceiling__rounds{grid-template-columns:repeat(2,minmax(0,1fr))}.ceiling__transition{align-items:stretch;flex-direction:column}}
@media(max-width:520px){.ceiling__budget,.ceiling__cards,.ceiling__rounds{grid-template-columns:1fr}}
</style>
