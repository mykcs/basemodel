---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import { openEvoCeilingStage2Snapshot as snap } from '../../data/openEvoCeilingStage2Snapshot';
import ExternalBrandMark from '../common/ExternalBrandMark';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path:string) => localePath(locale,path);
const pct = ((snap.sevenB.rolloutsConsumed / snap.totalRollouts) * 100).toFixed(2);
const final7 = snap.sevenBFinalCloseout;
const archive = final7.archiveIdentity;
const hfRevisionUrl = (revision: string) => `https://huggingface.co/datasets/${archive.repository}/tree/${revision}`;
const governanceUrl = `https://github.com/mykcs/openevo-experiment/blob/${archive.governance.sourceCommit}/${archive.governance.evidencePath}`;
const reuseReceiptUrl = `https://github.com/mykcs/openevo-experiment/blob/${archive.governance.sourceCommit}/${archive.governance.reuseReceiptPath}`;
const stage1 = [
  { n:'01', title:'OPSD', text:t('这是 Stage 1 里唯一真正改模型参数的通道。MiniMax 已经写好的任务后分析只作为额外参考，学生模型自己的原始回答不被替换；最后由 OPSD 产生最初的参数更新。','This is the only Stage-1 channel that changes model parameters. Sealed MiniMax hindsight is used only as extra context, the student’s original completion is not replaced, and OPSD produces the initial parameter updates.') },
  { n:'02', title:'Text Memory', text:t('把 1,440 条老师分析整理成可复用的文字经验。整理完成后不再继续调用 MiniMax、GPT 或 GLM；后续只让同规模的本地 Qwen 对已有经验做归纳。','Turn all 1,440 teacher analyses into reusable textual experience. After that, no additional MiniMax, GPT, or GLM calls are made; later consolidation uses only the same-scale local Qwen.') },
  { n:'03', title:'Agent System', text:t('把经验整理成少量全局行为原则和出错后的恢复规则。重点不是“文件写出来了”，而是下一轮 WebShop 运行时真的把这些规则放进模型上下文。','Turn experience into a small set of global behavior rules and recovery rules. The important part is not merely writing a file, but proving that the next WebShop run actually places those rules in model context.') },
  { n:'04', title:'Skill Bundle', text:t('把可复用策略整理成技能说明。只有运行时已经证明模型真的能读到这份技能时才启用；某一轮没有足够证据更新时，就保持原样，不为了凑“更新次数”硬改。','Organize reusable strategies into skill descriptions. Skills are enabled only after runtime proves the model actually sees them; when a round has insufficient evidence, the state stays unchanged rather than being forced to update.') },
] as const;
---
<main class="ceiling" data-testid="ceiling-stage2-strategy">
  <OpenEvoStage2StrategyChooser locale={locale} active="ceiling" />
  <header class="ceiling__hero">
    <div>
      <p>OPENEVO-CEILING-1.0 · {t('第二版 Stage 2', 'SECOND STAGE-2 DESIGN')}</p>
      <h1>{t('7B 已经走到终点：49.33 分，58 / 128 完整成功', 'The 7B lineage reached its endpoint: 49.33 score with 58 / 128 exact successes')}</h1>
      <span>{t('Ceiling-1.0 去掉旧的批次门槛后，7B 最终完成 149 个完整 round（0–148）、19,072 次 accepted Stage-2 rollout，并积累 143 个 SD-LoRA component。冻结 checkpoint 后才首次打开 128 题 final panel：Task Score ×100 = 49.33，完整成功 58 / 128 = 45.31%。旧的 2026-08-31 快照仍原样保留在下面，作为当时运行到 25 个 component 时的历史记录。', 'After Ceiling-1.0 removed the old batch gate, the 7B lineage ultimately completed 149 full rounds (0–148), consumed 19,072 accepted Stage-2 rollouts, and accumulated 143 SD-LoRA components. The 128-task final panel was opened only after the checkpoint was frozen: Task Score ×100 = 49.33 with 58 / 128 = 45.31% exact success. The older 2026-08-31 snapshot below is preserved unchanged as the historical state when the run had reached 25 components.')}</span>
    </div>
    <aside>
      <span>{t('当时的运行快照 · 2026-08-31', 'RUN SNAPSHOT · 2026-08-31')}</span>
      <strong>{t(`7B 已完成并封存 ${snap.sevenB.completedRange} 这些轮次`, `7B had sealed rounds ${snap.sevenB.completedRange}`)}</strong>
      <small>{t(`当时已经做了 ${snap.sevenB.rolloutsConsumed.toLocaleString()} / ${snap.totalRollouts.toLocaleString()} 次 Stage-2 任务（${pct}%）。最终 128 题还没有被打开过，所以这些数字没有拿最终评测来调参。`, `${snap.sevenB.rolloutsConsumed.toLocaleString()} / ${snap.totalRollouts.toLocaleString()} Stage-2 attempts had been consumed (${pct}%). The final 128-task panel had not been opened, so these decisions were not tuned against final evaluation.`)}</small>
    </aside>
  </header>

  <section class="ceiling__section ceiling__final" data-testid="ceiling-7b-final-closeout">
    <p class="kicker">{t('7B 最终封存 · 2026-09-04', '7B FINAL CLOSEOUT · 2026-09-04')}</p>
    <h2>{t('149 个完整 round 后，最终 WebShop Score = 49.33，完整成功率 = 45.31%', 'After 149 completed rounds: WebShop Score = 49.33 and exact success = 45.31%')}</h2>
    <div class="ceiling__budget">
      <div><b>{final7.completedRounds}</b><span>{t('完整 Stage-2 rounds · 0–148', 'completed Stage-2 rounds · 0–148')}</span></div>
      <div><b>{final7.acceptedRollouts.toLocaleString()}</b><span>{t('accepted Stage-2 rollouts', 'accepted Stage-2 rollouts')}</span></div>
      <div><b>{final7.sdComponents}</b><span>{t('最终 SD-LoRA components', 'final SD-LoRA components')}</span></div>
      <div><b>{final7.exactSuccessCount} / {final7.finalPanelSize}</b><span>{t('完整成功 · 45.31%', 'exact success · 45.31%')}</span></div>
    </div>
    <div class="ceiling__arm-status">
      <article class="running"><span>OPENEVO · 7B</span><strong>49.33 / 100</strong><p>{t('128 / 128 全部完成；7 条 action-admissibility failure 按 fail-closed 计 0；runtime error 为 0。headline 始终以全部 128 题为分母。', 'All 128 / 128 tasks completed. Seven action-admissibility failures count as zero under the fail-closed contract; runtime errors are zero. The headline denominator remains all 128 tasks.')}</p></article>
      <article><span>SEED · PAPER REFERENCE</span><strong>89.7 / 100 · 78.1%</strong><p>{t('这是 SEED Table 1 对 Qwen2.5-7B-Instruct 的论文报告值，不是我们在同一 checkpoint / 同一 exact denominator 上本地重跑出的 paired result。因此这里只报告数值差距：Score −40.37、Success −32.79 个百分点，不把它写成方法因果效应。', 'These are the SEED Table 1 paper-reported values for Qwen2.5-7B-Instruct, not a local paired rerun on the same checkpoint and exact denominator. We therefore report only the numerical gaps—Score −40.37 and Success −32.79 percentage points—rather than a causal method effect.')}</p></article>
    </div>
    <p class="ceiling__note">{t('每个完整轮次包含 128 次尝试；20,480 是原定上限，本次提前停止的具体原因尚待原始终止记录核验。partial round149 的 96 条 rollout 只保留 provenance，没有进入最终 checkpoint 或最终分数。final panel 在 checkpoint 冻结后只打开 1 次；Stage 2 额外外部老师调用为 0。归档治理证据记录了此前远端验证 PASS；2026-09-05 的最新 fresh-read 因工具参数错误未完成，因此不能表述成“当前已重新远端验证”。', 'Each complete round contains 128 attempts. The original ceiling was 20,480; the specific reason for stopping early still requires verification against the original termination record. The 96 rollouts from partial round149 remain provenance only and do not enter the final checkpoint or score. The final panel was opened exactly once after checkpoint freeze, and Stage 2 made zero additional external-teacher calls. Archive-governance evidence records a prior remote-verification PASS; the latest fresh-read on 2026-09-05 did not complete because of a tool-parameter error, so it is not represented as a fresh current verification.')}</p>
    <details class="ceiling__provenance" data-testid="ceiling-7b-archive-identity">
      <summary>{t('查看不可混用的归档身份与验证边界', 'Inspect role-specific archive identities and verification boundary')}</summary>
      <p>{t(`以下 Hugging Face 数据集仓库是 private / restricted 研究资产，需要相应权限。三个 revision 分别固定 component store、完整 lineage 与参数分析，不能互相替代，也不能用网站 Git commit 代替。`, `The Hugging Face dataset repository below is a private / restricted research asset and requires permission. The three revisions pin the component store, full lineage, and parameter analysis respectively; they are not interchangeable and cannot be replaced by a website Git commit.`)}</p>
      <dl>
        <div><dt>HF DATASET</dt><dd><code>{archive.repository}</code></dd></div>
        <div><dt>COMPONENT STORE</dt><dd><code>{archive.componentStoreRevision}</code></dd></div>
        <div><dt>FULL LINEAGE</dt><dd><code>{archive.fullLineageRevision}</code><small>SHA-256 · {archive.fullLineageSha256}</small></dd></div>
        <div><dt>PARAMETER ANALYSIS</dt><dd><code>{archive.parameterAnalysisRevision}</code><small>SHA-256 · {archive.parameterAnalysisSha256}</small></dd></div>
      </dl>
      <nav aria-label={t('7B 归档固定版本与治理证据', 'Pinned 7B archives and governance evidence')}>
        <a href={hfRevisionUrl(archive.componentStoreRevision)} target="_blank" rel="noreferrer"><ExternalBrandMark href={hfRevisionUrl(archive.componentStoreRevision)} />{t('Component store · 私有/受限 ↗', 'Component store · private/restricted ↗')}</a>
        <a href={hfRevisionUrl(archive.fullLineageRevision)} target="_blank" rel="noreferrer"><ExternalBrandMark href={hfRevisionUrl(archive.fullLineageRevision)} />{t('完整 lineage · 私有/受限 ↗', 'Full lineage · private/restricted ↗')}</a>
        <a href={hfRevisionUrl(archive.parameterAnalysisRevision)} target="_blank" rel="noreferrer"><ExternalBrandMark href={hfRevisionUrl(archive.parameterAnalysisRevision)} />{t('参数分析 · 私有/受限 ↗', 'Parameter analysis · private/restricted ↗')}</a>
        <a href={governanceUrl} target="_blank" rel="noreferrer"><ExternalBrandMark href={governanceUrl} />{t('治理技术证据 ↗', 'Governance technical evidence ↗')}</a>
        <a href={reuseReceiptUrl} target="_blank" rel="noreferrer"><ExternalBrandMark href={reuseReceiptUrl} />{t('发布复用 receipt ↗', 'Publication reuse receipt ↗')}</a>
      </nav>
    </details>
  </section>
  <section class="ceiling__section">
    <p class="kicker">{t('Ceiling-1.0 想回答什么', 'SCIENTIFIC QUESTION')}</p>
    <h2>{t('不给更多老师、不增加做题次数，只改学习规则，OpenEVO 能走多远？', 'How far can OpenEVO improve if budgets stay fixed and only the learning rule changes?')}</h2>
    <p>{t('Stage 1 已经把 1,440 次学生做题和 1,440 条 MiniMax 回看分析全部封存。进入 Stage 2 后不再调用 MiniMax，只让模型用自己后续产生的经验继续学习。最终 128 个评测任务一直锁着，Stage 2 没结束前不能用它们挑规则、挑模型或做试跑。', 'Stage 1 already sealed 1,440 student attempts and 1,440 MiniMax hindsight analyses. Stage 2 makes no further MiniMax calls and learns only from later self-generated experience. The final 128 evaluation tasks stay locked until Stage 2 ends and cannot be used to tune rules, choose checkpoints, or run smoke tests.')}</p>
    <div class="ceiling__budget">
      <div><b>1,440</b><span>{t('Stage 1 学生任务尝试', 'Stage-1 student attempts')}</span></div>
      <div><b>1,440</b><span>{t('已经封存的 MiniMax 回看分析', 'sealed MiniMax hindsight analyses')}</span></div>
      <div><b>20,480</b><span>{t('Stage 2 最多做题次数', 'Stage-2 task-attempt budget')}</span></div>
      <div><b>128</b><span>{t('最终评测任务；Stage 2 结束前不打开', 'final evaluation tasks; locked until Stage 2 ends')}</span></div>
    </div>
  </section>

  <section class="ceiling__section">
    <p class="kicker">{t('Stage 1 留给下一阶段什么', 'WHAT STAGE 1 LEAVES BEHIND')}</p>
    <h2>{t('老师分析不能只存在文件里，下一轮模型必须真的看见并用到它', 'Teacher analysis must become context the next model round actually sees')}</h2>
    <div class="ceiling__cards">{stage1.map((item) => <article><span>{item.n}</span><strong>{item.title}</strong><p>{item.text}</p></article>)}</div>
    <p class="ceiling__note">{t('所以“服务器上生成了 SKILL.md 或 memory.md”不算成功。真正需要确认的是：WebShop 下一轮运行时，这些内容有没有按设计进入模型上下文，而且没有盖过当前页面和当前允许动作。', 'So merely generating SKILL.md or memory.md on disk is not enough. The real check is whether the next WebShop round receives that content as intended without letting historical context override the live page and currently allowed actions.')}</p>
  </section>

  <section class="ceiling__section">
    <p class="kicker">{t('Stage 2 怎么跑', 'HOW STAGE 2 RUNS')}</p>
    <h2>{t('每 128 次任务是一轮整理经验，不再是一道“过不了就不准学”的门', 'Every 128 attempts form one learning round, not a gate that blocks learning entirely')}</h2>
    <p>{t('每 128 次任务形成一轮共同证据；这是一项历史设计规则，不是最终结果分母。', 'Every 128 attempts form one shared evidence round; this is a historical design rule, not the final-evaluation denominator.')}</p>
    <div class="ceiling__rounds">
      <article><b>128</b><strong>{t('次任务尝试组成一轮', 'task attempts per round')}</strong><p>{t('一轮包含 16 个任务，每个任务做 8 次。参数、文字记忆、技能和 Agent 规则都看这一轮同一份任务记录，起点也都是同一个上一轮模型状态。', 'One round contains 16 tasks with eight attempts each. Parameters, text memory, skills, and agent rules all read the same task evidence and start from the same previous-round state.')}</p></article>
      <article><b>0..16</b><strong>{t('参数训练最多选 16 条成功轨迹', 'up to 16 success traces for parameter training')}</strong><p>{t('每个任务最多取最早的一条干净完整成功。一个成功都没有时，这一轮参数不变；只要至少有 1 个任务成功，就允许做一次 SD-LoRA 更新。', 'At most the earliest clean exact success is selected from each task. With no success, parameters stay unchanged for that round; with at least one successful task, one SD-LoRA update is allowed.')}</p></article>
      <article><b>4</b><strong>{t('四类可学习状态分别判断要不要改', 'four learnable states decide independently')}</strong><p>{t('Text Memory、SD-LoRA、Skill Bundle 和 Agent System 都只看“上一轮状态 + 这一轮任务记录”，同一轮里互相看不到对方刚产生的新版本，避免执行顺序偷偷改变实验。', 'Text Memory, SD-LoRA, Skill Bundle, and Agent System each see only the previous state plus the current round evidence; they cannot inspect one another’s newly produced same-round outputs, so execution order cannot silently change the experiment.')}</p></article>
      <article><b>1×</b><strong>{t('这一轮结束时合并一次', 'one merge at round end')}</strong><p>{t('四类状态都完成“更新或保持不变”的判断后，才合成下一轮要用的新状态。新状态只影响后面的任务，不会回头改变已经产生的轨迹。', 'After all four states decide whether to update or stay unchanged, they are combined into the next-round state. That new state affects only future tasks and never rewrites the trajectories that created it.')}</p></article>
    </div>
    <div class="ceiling__transition"><code>{t('上一轮模型与经验 + 本轮 128 次任务', 'previous state + 128 current attempts')}</code><span>→ {t('四类状态分别判断', 'four independent decisions')} →</span><code>{t('合并成下一轮状态', 'merge into next-round state')}</code></div>
  </section>
  <section class="ceiling__section ceiling__compare">
    <div><p class="kicker">{t('第一版 Stage 2', 'FIRST STAGE-2 DESIGN')}</p><h2>{t('每 256 次任务重新过一次门槛', 'Re-qualify after every 256 attempts')}</h2><ul><li>{t('每批 256 次任务', '256 attempts per batch')}</li><li>{t('同一批必须有 8 个不同任务各自成功 2 次', 'eight distinct tasks each had to succeed twice in the same batch')}</li><li>{t('没凑齐就完全不更新参数', 'no parameter update if the batch fell short')}</li><li>{t('四组历史实验的 Stage 2 最后都是 0 次参数更新', 'all four historical Stage-2 runs ended with zero parameter updates')}</li></ul></div>
    <div><p class="kicker">{t('第二版 Ceiling-1.0', 'SECOND DESIGN · CEILING-1.0')}</p><h2>{t('每 128 次任务整理一次证据，能改就改，没证据就保持不变', 'Every 128 attempts form one evidence round; update when supported, otherwise stay unchanged')}</h2><ul><li>{t('每轮 128 次任务', '128 attempts per round')}</li><li>{t('不再使用旧的 7 对 8 门槛', 'the old 7-versus-8 gate is removed')}</li><li>{t('参数、文字记忆、技能和 Agent 规则各自判断有没有足够证据', 'parameters, text memory, skills, and agent rules decide independently')}</li><li>{t('一轮结束后再合并成下一轮状态', 'merge once at the end of the round')}</li></ul></div>
  </section>

  <section class="ceiling__section">
    <p class="kicker">{t('四类状态什么时候可以改', 'WHEN EACH STATE MAY CHANGE')}</p>
    <h2>{t('没有足够证据时，保持不变也是正常结果', 'Staying unchanged is a valid result when evidence is insufficient')}</h2>
    <div class="ceiling__carrier-grid">
      <article><strong>Text Memory</strong><p>{t('只有这一轮真的出现完整成功、同一任务明显变好或变差、或者重复出现同一种可验证失败时，才改文字记忆；否则保留上一轮内容。', 'Text memory changes only when the round contains exact success, a clear within-task improvement/regression, or a repeated failure pattern visible in the traces; otherwise it stays unchanged.')}</p></article>
      <article><strong>SD-LoRA</strong><p>{t('这一轮只要至少有 1 个任务完整成功，就可以做一次参数更新；一个都没有时参数保持不变。不会把几轮成功偷偷攒起来再凑一个新门槛。', 'At least one exact-success task in the current round permits one parameter update; with none, parameters stay unchanged. Successes are not secretly accumulated across rounds to create another threshold.')}</p></article>
      <article><strong>Skill Bundle</strong><p>{t('至少需要两个不同任务支持同一种策略，才把它写进技能；第一次整理仍不够清楚时最多再修一次，之后还不满足就保持原样。', 'A strategy needs support from at least two distinct tasks before it enters the skill bundle. If the first summary is still inadequate, it may be repaired once; otherwise the state stays unchanged.')}</p></article>
      <article><strong>Agent System</strong><p>{t('至少需要三个不同任务共同支持，才修改更高层的行为原则。它只能看上一轮状态和这一轮任务记录，不能偷看同一轮其他模块刚写出的新内容。', 'At least three distinct tasks must support a change to higher-level behavior rules. It can see only the previous state and current-round evidence, not new outputs produced by other modules in the same round.')}</p></article>
    </div>
    <p class="ceiling__note">{t('Task Vector 在这版里只用于分析，不会修改训练，也不会影响下一轮。最初沿用的 64-component guard 现在只保留为 upstream provenance：7B Ceiling-1.0 当时通过容量 amendment 取消了独立的 64-component stop，最终走到 143 components；当时仍保留 effective rank ≤ 4096 等容量保护，formal 训练里始终没有启用 rank reduction / compression。训练结束后的 K64/K80/K96 只属于只读机制诊断，不回写 final checkpoint。这个 amendment 只授权 7B，不自动授权 3B。', 'Task Vector is diagnostic only and does not alter training or the next round. The original 64-component guard is now retained only as upstream provenance: the 7B Ceiling-1.0 lineage used a capacity amendment that removed the independent 64-component stop and ultimately reached 143 components while retaining capacity safeguards such as effective rank ≤ 4096. Formal training never activated rank reduction / compression; the later K64/K80/K96 studies are read-only mechanism diagnostics and do not alter the final checkpoint. The amendment applied to 7B only and did not automatically authorize 3B.')}</p>
  </section>

  <section class="ceiling__section">
    <p class="kicker">{t('当时跑到哪里', 'RUN SNAPSHOT')}</p>
    <h2>{t('7B 已经能继续产生参数更新；3B 跑了很多任务，却仍然没有产生一个新参数组件', '7B continued producing parameter updates; 3B consumed many tasks without producing a new parameter component')}</h2>
    <div class="ceiling__arm-status">
      <article class="running"><span>7B</span><strong>{t('Ceiling-1.0 在 7B 上能够继续产生参数学习', 'Ceiling-1.0 continued producing parameter learning for 7B')}</strong><dl><div><dt>{t('已经完成的轮次', 'completed rounds')}</dt><dd>{snap.sevenB.completedRange} ({snap.sevenB.roundsComplete})</dd></div><div><dt>{t('已经做的任务', 'task attempts')}</dt><dd>{snap.sevenB.rolloutsConsumed.toLocaleString()} / {snap.totalRollouts.toLocaleString()}</dd></div><div><dt>{t('新增参数组件', 'new parameter components')}</dt><dd>{snap.sevenB.sdGenerations}</dd></div><div><dt>{t('Stage 2 额外老师调用', 'extra teacher calls in Stage 2')}</dt><dd>{snap.sevenB.externalTeacherCalls}</dd></div><div><dt>{t('最终评测提前查看次数', 'early final-eval access')}</dt><dd>{snap.sevenB.finalPanelAccessCount}</dd></div></dl><p>{t(`这个快照记录到第 ${snap.sevenB.nextRound} 轮已经开始。它不是最终实验结果，只说明在这个时间点 7B 确实还在产生新的参数学习。`, `At this snapshot, round ${snap.sevenB.nextRound} had already started. This is not the final experiment result; it only shows that 7B was still producing real parameter learning at that point.`)}</p></article>
      <article class="running"><span>3B</span><strong>{t('3B 完成 18 轮后仍是 0 个新参数组件', '3B still had zero new parameter components after 18 rounds')}</strong><dl><div><dt>{t('已经完成的轮次', 'completed rounds')}</dt><dd>{snap.threeB.completedRange} ({snap.threeB.roundsComplete})</dd></div><div><dt>{t('已经做的任务', 'task attempts')}</dt><dd>{snap.threeB.rolloutsConsumed.toLocaleString()} / {snap.totalRollouts.toLocaleString()}</dd></div><div><dt>{t('新增参数组件', 'new parameter components')}</dt><dd>{snap.threeB.sdComponents}</dd></div><div><dt>{t('最终评测提前查看次数', 'early final-eval access')}</dt><dd>{snap.threeB.finalPanelAccessCount}</dd></div></dl><p>{t('这不等于已经证明“3B 天生学不会”。轨迹复核发现，3B 很多失败不是输出格式坏了，而是会选一个当前页面根本不存在的动作；同时这一版每一步都注入 Text Memory、Skill、Agent System。两件事共同让经验注入 / 动作接口成为后续诊断假设，但这里没有把模型规模、基础 policy、prompt/parser contract 等变量单独隔离，所以不能把 carrier 写成已经证实的根因。', 'This does not prove that 3B is intrinsically unable to learn. Trajectory review found many failures where the output format was valid but the chosen action did not exist on the current page, while this design injected Text Memory, Skill, and Agent System on every step. Together those observations make experience injection and the action interface a follow-up hypothesis, but model scale, the base policy, and the shared prompt/parser contract were not independently isolated here, so carriers cannot be presented as an established root cause.')}</p></article>
    </div>
    <p class="ceiling__snapshot-note">{t(`这些数字是 ${snap.observedAt} 的历史快照，不是现在的实时进度。精确配置版本为 ${snap.configSha256}；当时两组都没有提前查看最终 128 题。后续 successor 状态要以实验仓库和第二张地图的最新记录为准。`, `These values are a historical snapshot from ${snap.observedAt}, not live progress. The exact configuration version is ${snap.configSha256}; neither arm had accessed the final 128 tasks at that time. Later state must be read from newer experiment records.`)}</p>
  </section>

  <section class="ceiling__section ceiling__successor">
    <div><p class="kicker">{t('后续 successor', 'FOLLOW-UP SUCCESSOR')}</p><h2>{t('Ceiling-1.0 历史证据原样保留；新版从新的 Harness 与 fresh Stage 1 重新开始', 'Ceiling-1.0 evidence remains unchanged; the redesign restarts from a new harness and fresh Stage 1')}</h2><p>{t('Ceiling-1.0 已产生的轨迹、状态和参数证据不因后续 harness 研究而改写。后续诊断表明行动接口会改变 on-policy trajectory，因此当前 successor 不再复用这批 Stage 1 作为正式数据：Harness201.1 qualification 已 PASS，3B 已从 fresh Stage 1 进入新的 MiniMax / OPSD / carrier downstream；新的 formal Stage 2 必须由这条 fresh lineage 另行 activation，不能从旧 checkpoint 接着跑。', 'Ceiling-1.0 trajectories, state, and parameter evidence are not rewritten by later harness work. Follow-up diagnosis showed that the action interface changes on-policy trajectories, so the current successor no longer reuses this Stage 1 as formal data: Harness201.1 qualification has passed, and the 3B successor has moved from fresh Stage 1 into fresh MiniMax / OPSD / carrier downstream work. A new formal Stage 2 requires a separate activation for that fresh lineage and cannot continue from the old checkpoint.')}</p></div>
    <a href={p('/research/seed-openevo/study/capability-exploration/openevo-2-0/')}>{t('进入第二张地图：重新设计 OpenEvo →','Open map two: Redesigning OpenEvo →')}</a>
  </section>
