---
import { localePath, type Locale } from '../../i18n';
import ResearchDiagramLegend from './ResearchDiagramLegend.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---

<section id="fig-seed-webshop" class="canonical-figure seed-webshop-figure" aria-labelledby="seed-webshop-figure-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">FIGURE S1 · SEED × WEBSHOP</div>
    <h2 id="seed-webshop-figure-title">{t('SEED 怎样在 WebShop 上训练，又怎样在测试时直接完成购物任务','How SEED trains on WebShop — and then shops directly at test time')}</h2>
    <p>{t('把论文里的数据设定、两阶段训练和推理边界放在同一张图里。先看“用了哪些 WebShop 数据”，再看“经验如何变成参数更新”，最后看测试时哪些训练模块会消失。','One figure aligns the paper’s data configuration, two-stage training, and inference boundary. Read it from “which WebShop data is used,” to “how experience becomes a parameter update,” to “which training-only modules disappear at test time.”')}</p>
    <div class="figure-actions">
      <a href={p('/research/seed-openevo/webshop/')}>{t('WebShop 环境说明 →','WebShop environment →')}</a>
      <a href={p('/papers/seed/')}>{t('SEED 论文页 →','SEED paper →')}</a>
    </div>
  </header>

  <figure class="figure-body">
    <section class="dataset-band" aria-labelledby="seed-webshop-data-title">
      <div class="band-heading">
        <span>01 · DATASET SETTING</span>
        <h3 id="seed-webshop-data-title">{t('先分清 WebShop 官方数据，和 SEED 实际拿来训练 / 测试的子集','Separate the official WebShop split from the subsets SEED actually trains and evaluates on')}</h3>
      </div>

      <div class="official-dataset" data-ui-audit="layout">
        <div class="dataset-origin" data-ui-audit-item>
          <small>ORIGINAL WEBSHOP</small>
          <strong>12,087</strong>
          <span>{t('shopping instructions','shopping instructions')}</span>
        </div>
        <div class="dataset-splits">
          <article class="split train" data-ui-audit-item>
            <small>TRAIN</small><strong>10,587</strong><span>{t('官方训练 split','official training split')}</span>
          </article>
          <article class="split dev" data-ui-audit-item>
            <small>DEV</small><strong>1,000</strong><span>{t('官方开发 split','official development split')}</span>
          </article>
          <article class="split test" data-ui-audit-item>
            <small>TEST</small><strong>500</strong><span>{t('官方测试 split','official test split')}</span>
          </article>
        </div>
      </div>

      <div class="seed-usage-grid" aria-label={t('SEED 在 WebShop 上的数据使用方式','How SEED uses WebShop data')}>
        <article class="usage-card sft" data-ui-audit-item>
          <div class="usage-source"><span>TRAIN</span><i aria-hidden="true">↓</i></div>
          <small>STAGE 1 · SFT</small>
          <strong>180 tasks × 8 rollouts</strong>
          <b>= 1,440 trajectories</b>
          <p>{t('为每条完整 trajectory 生成 hindsight skill，再用 trajectory → skill 做三轮 SFT。','Generate a hindsight skill for each completed trajectory, then run three SFT epochs on trajectory → skill pairs.')}</p>
        </article>
        <article class="usage-card rl" data-ui-audit-item>
          <div class="usage-source"><span>TRAIN</span><i aria-hidden="true">↓</i></div>
          <small>STAGE 2 · RL</small>
          <strong>2,400 training instances</strong>
          <b>150 policy updates · N = 8</b>
          <p>{t('WebShop batch size 16；每个 interaction 最多 15 steps。','WebShop uses batch size 16; each interaction is capped at 15 steps.')}</p>
        </article>
        <article class="usage-card eval" data-ui-audit-item>
          <div class="usage-source"><span>TEST</span><i aria-hidden="true">↓</i></div>
          <small>EVALUATION</small>
          <strong>128 test samples</strong>
          <b>Score + Success Rate</b>
          <p>{t('这是 SEED 论文自己的评估设置；不是把官方 500-task test split 全部跑完。','This is SEED’s paper evaluation setting; it is not an evaluation over all 500 tasks in the official test split.')}</p>
        </article>
      </div>
      <p class="dataset-note">{t('图中 DEV 保留为官方 split，但不画用途箭头：这里只可视化论文明确说明的 SFT、RL 与 evaluation 数据配置，不把未明确的用途自行补成事实。','DEV remains visible as an official split but has no usage arrow: the figure only visualizes SFT, RL, and evaluation uses explicitly stated by the paper instead of inventing an unstated role.')}</p>
    </section>

    <section class="training-stage stage-one" aria-labelledby="seed-stage-one-canonical-title">
      <div class="band-heading">
        <span>02 · STAGE 1</span>
        <h3 id="seed-stage-one-canonical-title">{t('先让 policy 学会“看完整条轨迹以后复盘”','First teach the policy to reflect after seeing a complete trajectory')}</h3>
      </div>

      <div class="stage-one-flow" data-ui-audit="layout">
        <article class="paper-node frozen" data-ui-audit-item>
          <div class="paper-node-top"><span class="paper-symbol" aria-hidden="true">❄️</span><small>ROLLOUT CHECKPOINT</small></div>
          <strong>{t('Base Agent 做 WebShop task','Base Agent attempts a WebShop task')}</strong>
          <p>{t('本次 rollout 内参数不更新。','Parameters do not update inside this rollout.')}</p>
        </article>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <article class="paper-node environment" data-ui-audit-item>
          <small>WEBSHOP</small>
          <strong>{t('instruction → search → product → options → buy','instruction → search → product → options → buy')}</strong>
          <p>{t('得到完整 interaction 与终局 outcome。','Produces a full interaction and terminal outcome.')}</p>
        </article>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <article class="paper-node artifact" data-ui-audit-item>
          <small>📄 TRAJECTORY</small>
          <strong>instruction + observations + actions + outcome</strong>
          <p>{t('训练样本首先是一整个 episode，而不是单独一个动作。','The training object is a complete episode, not an isolated action.')}</p>
        </article>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <article class="paper-node frozen" data-ui-audit-item>
          <div class="paper-node-top"><span class="paper-symbol" aria-hidden="true">❄️</span><small>EXTERNAL ANALYZER</small></div>
          <strong>GLM-5.2</strong>
          <p>{t('阅读完整 episode，标注 hindsight skill；它不参与 policy 参数优化。','Reads the complete episode and annotates a hindsight skill; it is not optimized as part of the policy.')}</p>
        </article>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <article class="paper-node trainable" data-ui-audit-item>
          <div class="paper-node-top"><span class="paper-symbol" aria-hidden="true">🔥</span><small>HINDSIGHT-SKILL SFT</small></div>
          <strong>{t('Agent 学习 trajectory → skill','Agent learns trajectory → skill')}</strong>
          <p>SFT × 3 epochs → θ<sub>SFT</sub></p>
        </article>
      </div>
      <p class="stage-intuition">{t('Stage 1 的目的不是直接教模型“正确购物答案”，而是先让同一个 policy checkpoint 具备一种能力：任务做完以后，能总结“如果早知道什么，之前会更容易做对”。','Stage 1 does not directly teach a catalog of “correct shopping answers.” It first gives the policy checkpoint a new capability: after an episode, summarize what hindsight would have made the earlier decisions easier.')}</p>
    </section>

    <section class="training-stage stage-two" aria-labelledby="seed-stage-two-canonical-title">
      <div class="band-heading">
        <span>03 · STAGE 2</span>
        <h3 id="seed-stage-two-canonical-title">{t('同一个 Agent 一边做任务，一边把事后复盘变成更密的训练信号','The same Agent acts, reflects, and converts hindsight into denser training signal')}</h3>
      </div>

      <div class="seed-wrapper" data-ui-audit="contrast layout">
        <div class="wrapper-label">SEED</div>
        <div class="actor-row">
          <article class="paper-node frozen actor" data-ui-audit-item>
            <div class="paper-node-top"><span class="paper-symbol" aria-hidden="true">❄️</span><small>POLICY SNAPSHOT</small></div>
            <strong>π<sub>θold</sub> · Agent</strong>
            <p>{t('本轮冻结：收集 rollout，也作为 hindsight analyzer 来源。','Frozen for this update: collects rollouts and supplies the hindsight analyzer.')}</p>
          </article>
          <div class="interaction-loop" data-ui-audit-item>
            <span>↔</span>
            <strong>WebShop</strong>
            <small>observation · sampled actions · reward</small>
          </div>
          <article class="paper-node artifact trajectory" data-ui-audit-item>
            <small>📄 COMPLETED TRAJECTORY τ</small>
            <strong>{t('同一批 sampled action tokens 已经固定','The sampled action tokens are now fixed')}</strong>
            <p>{t('后面不会重写一条“知道答案以后”的新轨迹。','Later stages do not rewrite a new “correct-with-hindsight” trajectory.')}</p>
          </article>
        </div>

        <div class="branch-grid" data-ui-audit="layout">
          <section class="branch reward-branch" data-ui-audit-item>
            <header><small>OUTCOME VIEW</small><strong>{t('最后结果怎么样？','How did the episode end?')}</strong></header>
            <div class="branch-step"><span>R(τ)</span><i aria-hidden="true">↓</i><b>GRPO</b></div>
            <p>{t('环境 outcome 提供 trajectory-level 的相对 RL signal。','The environment outcome provides a trajectory-level relative RL signal.')}</p>
          </section>

          <section class="branch hindsight-branch" data-ui-audit-item>
            <header><small>HINDSIGHT VIEW</small><strong>{t('事后看，什么经验值得带回来？','In hindsight, what experience is worth bringing back?')}</strong></header>
            <div class="hindsight-line"><span>π<sub>θold</sub> ❄️</span><i aria-hidden="true">→</i><span>📄 hindsight skill s</span></div>
            <p>{t('同一冻结 snapshot 看完 trajectory，再生成自然语言 hindsight skill。','The same frozen snapshot reads the completed trajectory and generates a natural-language hindsight skill.')}</p>
          </section>
        </div>

        <div class="rescore-panel" data-ui-audit="layout">
          <div class="same-action-banner"><small>SAME SAMPLED ACTION TOKENS</small><strong>a<sub>1</sub> … a<sub>L</sub></strong></div>
          <div class="rescore-columns">
            <article class="rescore-card student" data-ui-audit-item>
              <small>PLAIN CONTEXT · h</small>
              <div class="paper-node-top"><span class="paper-symbol" aria-hidden="true">🔥</span><strong>π<sub>θ</sub></strong></div>
              <p>log P<sub>θ</sub>(a | h)</p>
              <span>{t('梯度从 ordinary branch 更新当前 policy','Gradients update the current policy through the ordinary branch')}</span>
            </article>
            <div class="compare-mark" aria-hidden="true">Δ</div>
            <article class="rescore-card teacher" data-ui-audit-item>
              <small>+ HINDSIGHT SKILL · H(h,s)</small>
              <div class="paper-node-top"><span class="paper-symbol" aria-hidden="true">🔥</span><strong>same π<sub>θ</sub></strong></div>
              <p>log P<sub>θ</sub>(a | H(h,s))</p>
              <span class="stop-gradient"><b aria-hidden="true">⊥</b> sg · {t('teacher signal detached','teacher signal detached')}</span>
            </article>
          </div>
          <div class="opd-line">
            <span>{t('skill-induced probability shift','skill-induced probability shift')}</span>
            <i aria-hidden="true">→</i>
            <strong>OPD</strong>
          </div>
          <p class="rescore-note">{t('这里的 ❄️ 和 ⊥ 是两种不同语义：πθold 是本轮冻结的参数 snapshot；skill-conditioned branch 使用当前 πθ 做 forward，但作为 teacher signal 时 stop-gradient。','❄️ and ⊥ mean different things here: πθold is a parameter snapshot frozen for this update; the skill-conditioned branch still runs the current πθ forward, but its teacher signal is stop-gradient.')}</p>
        </div>

        <div class="optimizer-row">
          <div class="signal-pill">GRPO</div>
          <span aria-hidden="true">+</span>
          <div class="signal-pill">OPD</div>
          <span aria-hidden="true">→</span>
          <article class="update-node trainable" data-ui-audit-item>
            <span class="paper-symbol" aria-hidden="true">🔥</span>
            <div><small>JOINT OPTIMIZATION</small><strong>π<sub>θ</sub> → π<sub>θt+1</sub></strong></div>
          </article>
          <span class="loop-back" aria-hidden="true">↻</span>
          <small>{t('下一轮','next update')}</small>
        </div>
      </div>

      <aside class="why-inset" aria-labelledby="why-seed-helps-title">
        <div>
          <small>MECHANISM INTUITION</small>
          <h4 id="why-seed-helps-title">{t('为什么这可能比只看终局 reward 学得更充分？','Why can this extract more learning signal than terminal reward alone?')}</h4>
        </div>
        <div class="signal-contrast">
          <article>
            <small>OUTCOME-ONLY RL</small>
            <div class="action-chain">a1 → a2 → a3 → a4 → a5 <b>→ R</b></div>
            <p>{t('整条 trajectory 主要由一个稀疏结果信号指导。','The whole trajectory is guided primarily by a sparse outcome signal.')}</p>
          </article>
          <strong class="versus">VS</strong>
          <article>
            <small>SEED</small>
            <div class="action-chain dense">a1 ↑ · a2 ↑↑ · a3 ↑ · a4 ↑↑ · a5 <b>→ R</b></div>
            <p>{t('hindsight 诱导的 token-level probability shift，再补充一条更细的监督。','Hindsight-induced token-level probability shifts add a finer-grained supervision signal.')}</p>
          </article>
        </div>
        <strong class="intuition-bottom">{t('同一条 trajectory，不只留下一个分数；还可以留下更具体的“复盘课”。','One trajectory leaves more than a score; it can also leave a more specific lesson from hindsight.')}</strong>
      </aside>
    </section>

    <section class="inference-stage" aria-labelledby="seed-inference-title">
      <div class="band-heading">
        <span>04 · INFERENCE / TEST</span>
        <h3 id="seed-inference-title">{t('考试时反而很简单：保留训练好的 Agent，训练专用模块退场','Test time is deliberately simple: keep the trained Agent and remove the training-only machinery')}</h3>
      </div>
      <div class="inference-flow" data-ui-audit="layout">
        <article class="framework-wrapper" data-ui-audit-item>
          <small>SEED-TRAINED</small>
          <div class="agent-inner"><strong>Agent θ*</strong><span>{t('已更新的 policy 参数','updated policy parameters')}</span></div>
        </article>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <article class="task-card" data-ui-audit-item>
          <small>NEW WEBSHOP TASK</small>
          <strong>{t('新的购物 instruction','new shopping instruction')}</strong>
        </article>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <div class="shopping-chain" data-ui-audit-item>
          <span>search</span><i>→</i><span>inspect</span><i>→</i><span>choose</span><i>→</i><span>buy</span>
        </div>
        <div class="flow-arrow" aria-hidden="true">→</div>
        <article class="score-card" data-ui-audit-item>
          <small>EVALUATION</small><strong>Score + Success Rate</strong>
        </article>
      </div>
      <div class="training-only-note">
        <small>TRAINING ONLY</small>
        <span class="retired">analyzer</span><span class="retired">skill branch</span><span class="retired">OPD</span><span class="retired">GRPO update</span>
        <strong>{t('推理时不需要永久携带 hindsight skill prompt。','No permanent hindsight-skill prompt is required at inference.')}</strong>
      </div>
    </section>

    <figcaption>
      <strong>{t('Figure S1｜SEED 在 WebShop 上的数据、训练与推理。','Figure S1 | SEED data, training, and inference on WebShop.')}</strong>
      {t('原始 WebShop 包含 12,087 条 instruction，官方 i.i.d. split 为 10,587 / 1,000 / 500。SEED 的 Stage 1 从训练 split 选择 180 个 task，每个 task 采样 8 条 rollout，得到 1,440 条 trajectory，由外部 GLM-5.2 analyzer 生成 hindsight skill，并进行三轮 SFT。Stage 2 使用 2,400 个 WebShop training instances，进行 150 次 policy update；当前 snapshot 收集 on-policy trajectory 并生成 hindsight skill，当前可训练 policy 对同一批 sampled action tokens 在 plain 与 skill-augmented context 下重打分，skill-conditioned teacher signal stop-gradient，OPD 与 GRPO 联合更新 policy。论文在 128 个 WebShop test samples 上报告 normalized task-completion Score 与 exact Success Rate。🔥 表示本次优化中会更新的参数，❄️ 表示本次操作中参数保持不变，⊥ 表示 stop-gradient / detached signal。','Original WebShop contains 12,087 instructions with an official i.i.d. 10,587 / 1,000 / 500 train/dev/test split. SEED Stage 1 selects 180 training tasks and samples eight rollouts per task, producing 1,440 trajectories; an external GLM-5.2 analyzer generates hindsight skills and the backbone is fine-tuned for three epochs. Stage 2 uses 2,400 WebShop training instances for 150 policy updates. The current snapshot collects on-policy trajectories and generates hindsight skills; the current trainable policy re-scores the same sampled action tokens under plain and skill-augmented contexts, the skill-conditioned teacher signal is stop-gradient, and OPD is optimized jointly with GRPO. The paper evaluates 128 WebShop test samples using normalized task-completion Score and exact Success Rate. 🔥 marks parameters updated in the current optimization, ❄️ marks parameters held fixed in the current operation, and ⊥ marks a stop-gradient / detached signal.')}
    </figcaption>
  </figure>

  <ResearchDiagramLegend locale={locale} />
</section>

<style>
.seed-webshop-figure{--env:#2563eb;--experience:#d97706;--signal:#dc2626;--state:#7c3aed;--persist:#059669;--paper:#0f766e;width:100%;margin:0;padding:clamp(.9rem,2vw,1.35rem);border:1px solid var(--line);border-radius:24px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface) 98%,transparent),color-mix(in srgb,var(--surface-muted) 76%,var(--surface)));box-shadow:0 22px 70px color-mix(in srgb,#000 7%,transparent)}
.figure-header{max-width:980px}.figure-label{color:var(--signal);font:850 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.figure-header h2{margin:.45rem 0 .55rem;font-size:clamp(1.35rem,2.7vw,2.25rem);letter-spacing:-.035em;line-height:1.1}.figure-header p{max-width:78ch;margin:0;color:var(--muted);font-size:.88rem;line-height:1.65}.figure-actions{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:.75rem}.figure-actions a{padding:.38rem .6rem;border:1px solid var(--line);border-radius:999px;color:var(--ink);font-size:.64rem;text-decoration:none}.figure-actions a:hover,.figure-actions a:focus-visible{border-color:var(--signal);color:var(--signal)}
.figure-body{margin:1rem 0 0}.figure-body>section{padding:1rem 0;border-top:1px solid var(--line)}.band-heading{display:grid;grid-template-columns:150px minmax(0,1fr);gap:.8rem;align-items:start;margin-bottom:.85rem}.band-heading>span{color:var(--muted);font:800 .57rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.band-heading h3{margin:0;font-size:clamp(.92rem,1.7vw,1.2rem);line-height:1.35;letter-spacing:-.018em}
.official-dataset{display:grid;grid-template-columns:190px 1fr;gap:.65rem}.dataset-origin,.split,.usage-card,.paper-node,.branch,.rescore-card,.task-card,.score-card{border:1px solid var(--line);border-radius:12px;background:var(--surface)}.dataset-origin{display:flex;flex-direction:column;justify-content:center;padding:.75rem;border-top:5px solid var(--env)}.dataset-origin small,.split small,.usage-card small,.paper-node small,.branch small,.rescore-card small,.framework-wrapper small,.task-card small,.score-card small{color:var(--muted);font:800 .5rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.055em}.dataset-origin strong{font-size:1.35rem}.dataset-origin span,.split span{color:var(--muted);font-size:.58rem}.dataset-splits{display:grid;grid-template-columns:2.4fr .8fr .8fr;gap:.5rem}.split{padding:.68rem;border-top:5px solid var(--env)}.split.dev{border-top-color:var(--muted)}.split.test{border-top-color:var(--persist)}.split strong,.split span{display:block}.split strong{margin:.12rem 0;font-size:1rem}.seed-usage-grid{display:grid;grid-template-columns:1.1fr 1fr .9fr;gap:.55rem;margin-top:.6rem;padding-left:calc(190px + .65rem)}.usage-card{position:relative;padding:.7rem;border-top:5px solid}.usage-card.sft{border-top-color:var(--experience)}.usage-card.rl{border-top-color:var(--signal)}.usage-card.eval{border-top-color:var(--persist)}.usage-source{display:flex;align-items:center;gap:.3rem;margin-bottom:.25rem;color:var(--muted);font:750 .49rem ui-monospace,SFMono-Regular,Menlo,monospace}.usage-source i{font-style:normal}.usage-card strong,.usage-card b{display:block}.usage-card strong{font-size:.69rem}.usage-card b{margin-top:.16rem;color:var(--ink);font-size:.58rem}.usage-card p,.paper-node p,.branch p,.rescore-note{margin:.35rem 0 0;color:var(--muted);font-size:.56rem;line-height:1.45}.dataset-note{margin:.55rem 0 0;padding-left:calc(190px + .65rem);color:var(--muted);font-size:.56rem;line-height:1.5}
