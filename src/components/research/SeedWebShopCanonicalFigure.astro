---
import { localePath, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
---

<section id="fig-seed-webshop" class="canonical-figure seed-webshop-setting" aria-labelledby="seed-webshop-setting-title" data-ui-audit="contrast layout overflow">
  <header class="figure-header">
    <div class="figure-label">FIGURE S1-C · FAIR WEBSHOP SETTING</div>
    <h2 id="seed-webshop-setting-title">{t('SEED 论文语境下，公平比较要进入哪个 WebShop 场地？','Which WebShop setting makes a SEED comparison fair?')}</h2>
    <p>{t('这里固定的是比赛场地，不是学习方法：SEED、OpenEvo 或其他框架都应进入同一个世界、同一批任务和同一种评分。','This fixes the playing field, not the learning method: SEED, OpenEvo, or another framework should enter the same world, task pools, and scoring.')}</p>
    <div class="figure-actions"><a href={p('/research/seed-openevo/webshop/')}>{t('WebShop 环境说明 →','WebShop environment →')}</a><a href={p('/papers/seed/')}>{t('SEED 论文页 →','SEED paper →')}</a></div>
  </header>

  <figure class="setting-map" aria-labelledby="seed-webshop-setting-title">
    <section class="method-entry" aria-label={t('学习框架进入同一设置','Learning frameworks enter the same setting')}>
      <article><strong>SEED Agent</strong><span>{t('学习方法可以不同','learning method may differ')}</span></article>
      <b aria-hidden="true">\</b><div class="same-contract">SAME WEBSHOP SETTING</div><b aria-hidden="true">/</b>
      <article><strong>OpenEvo Agent</strong><span>{t('学习方法可以不同','learning method may differ')}</span></article>
    </section>

    <section class="evidence-grid" aria-label={t('公平比较的证据层','Evidence layers for a fair comparison')}>
      <article class="evidence-card paper" data-ui-audit-item><small>PAPER EXPLICIT</small><strong>128</strong><p>{t('论文报告的 WebShop test samples','WebShop test samples reported by the paper')}</p></article>
      <article class="evidence-card code" data-ui-audit-item><small>RELEASED-CODE DEFAULT</small><strong>1,000</strong><p>{t('small WebShop products；公开脚本默认启用 use_small','small WebShop products; released scripts default to use_small')}</p></article>
      <article class="evidence-card boundary" data-ui-audit-item><small>PAPER BOUNDARY</small><strong>{t('未明确','Not explicit')}</strong><p>{t('论文未明确说明最终数字使用的 catalog size','The paper does not state the catalog size behind its final numbers')}</p></article>
    </section>

    <section class="contract-world" aria-label={t('同一 WebShop 任务合同','Same WebShop task contract')}>
      <header><small>RELEASED-CODE TASK SETTING</small><strong>{t('1,000-product small WebShop · 6,910 goals','1,000-product small WebShop · 6,910 goals')}</strong></header>
      <div class="pools">
        <article data-ui-audit-item><small>TRAIN CANDIDATE POOL</small><strong>goal 500–6909</strong><span>6,410 {t('goals','goals')}</span><p>{t('公开代码默认从 goal 500 开始取训练候选任务。','Released code defaults to training candidates beginning at goal 500.')}</p></article>
        <article data-ui-audit-item><small>COMPARISON CONTRACT</small><strong>goal 0–499</strong><span>500 {t('held-out task slots','held-out task slots')}</span><p>{t('本站比较合同把这 500 个 task slots 与从 500 开始的训练候选池分开；exact 128 IDs 仍未公开钉死。','This site’s comparison contract keeps these 500 task slots apart from the training candidates beginning at 500; exact 128 IDs are still not publicly pinned.')}</p></article>
        <article class="manifest" data-ui-audit-item><small>MANIFEST BOUNDARY</small><strong>128 {t('reported samples','reported samples')}</strong><p>{t('exact 128-goal manifest：尚未在这里钉死。','Exact 128-goal manifest: not yet pinned here.')}</p></article>
      </div>
    </section>

    <section class="same-rules" aria-label={t('同一比赛规则','Same competition rules')}>
      <strong>SAME RULES</strong><span>{t('同一个商品世界','same product world')}</span><span>{t('同一批可学习任务','same learning-task pool')}</span><span>{t('同一批最终考试题','same final test')}</span><span>{t('同一种 Score / Success 评分','same Score / Success scoring')}</span>
    </section>
    <figcaption><strong>{t('同一个世界、同一批任务、同一场考试、同一种评分；学习方法可以不同。','Same world, same tasks, same test, same scoring; learning methods may differ.')}</strong> {t('1,000 商品、训练起点和 6,910 goals 来自当前 released code 与 WebShop small environment；“128”来自 SEED 论文报告。图中不把未公布的 exact 128 goal IDs 或论文 catalog size 当作既定事实。','The 1,000 products, training start, and 6,910 goals come from current released code and the WebShop small environment; 128 is paper-reported. This figure does not present unpublished exact 128 goal IDs or a paper catalog size as settled facts.')}</figcaption>
  </figure>
</section>

<style>
  .seed-webshop-setting{width:min(1120px,calc(100% - 2rem));margin:2.2rem auto;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .figure-header{max-width:820px}.figure-label{color:var(--accent);font:800 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em}.figure-header h2{margin:.42rem 0 .65rem;font-size:clamp(1.55rem,3.5vw,2.7rem);line-height:1.08;letter-spacing:-.04em}.figure-header p{margin:0;color:var(--muted);line-height:1.65}.figure-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.figure-actions a{padding:.45rem .65rem;border:1px solid var(--line);border-radius:6px;color:var(--ink);font-weight:750;text-decoration:none}.figure-actions a:hover,.figure-actions a:focus-visible{border-color:var(--accent);color:var(--accent)}
  .setting-map{display:grid;gap:1rem;margin:1.5rem 0 0}.method-entry{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(150px,.75fr) auto minmax(0,1fr);gap:.55rem;align-items:center;padding:1rem;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted);text-align:center}.method-entry article{padding:.72rem;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.method-entry article strong,.method-entry article span{display:block}.method-entry article span{margin-top:.25rem;color:var(--muted);font-size:.67rem}.method-entry>b{color:var(--accent);font-size:1.6rem}.same-contract{padding:.6rem;border:2px solid var(--accent);border-radius:8px;color:var(--accent);font:800 .63rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}
  .evidence-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.evidence-card{min-width:0;padding:.85rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.evidence-card small{display:block;color:var(--muted);font:800 .56rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.evidence-card strong{display:block;margin:.42rem 0;font-size:clamp(1.2rem,2vw,1.8rem);line-height:1.1}.evidence-card p{margin:0;color:var(--muted);font-size:.7rem;line-height:1.48}.evidence-card.paper{border-top:4px solid var(--success)}.evidence-card.code{border-top:4px solid var(--accent)}.evidence-card.boundary{border-top:4px solid var(--warning)}
  .contract-world{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface-muted)}.contract-world>header{padding:1rem;border-bottom:1px solid var(--line);background:var(--surface)}.contract-world>header small,.contract-world>header strong{display:block}.contract-world>header small{color:var(--muted);font:800 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.contract-world>header strong{margin-top:.35rem;font-size:clamp(1rem,2vw,1.4rem)}.pools{display:grid;grid-template-columns:1fr 1fr .8fr;gap:.7rem;padding:.85rem}.pools article{padding:.8rem;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.pools small,.pools span{display:block;color:var(--muted);font-size:.62rem;line-height:1.45}.pools strong{display:block;margin:.35rem 0;font-size:1rem}.pools p{margin:.42rem 0 0;color:var(--muted);font-size:.7rem;line-height:1.5}.pools .manifest{border-style:dashed}
  .same-rules{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;padding:.8rem;border-block:1px solid var(--line)}.same-rules strong{margin-right:.2rem;color:var(--accent);font:800 .63rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.same-rules span{padding:.38rem .5rem;border:1px solid var(--line);border-radius:999px;background:var(--surface-muted);font-size:.68rem}.setting-map figcaption{max-width:90ch;color:var(--muted);font-size:.76rem;line-height:1.6}.setting-map figcaption strong{color:var(--ink)}
  @media(max-width:860px){.seed-webshop-setting{width:min(100% - 1rem,1120px);padding:1rem}.method-entry{grid-template-columns:1fr}.method-entry>b{display:none}.evidence-grid,.pools{grid-template-columns:1fr}.same-rules{align-items:flex-start;flex-direction:column}.same-rules span{width:100%;border-radius:6px}}
</style>
