---
import type { Locale } from '../../i18n';
import MathFormula from '../common/MathFormula.astro';
interface Props { locale: Locale; instanceId?: string }
const { locale, instanceId = 'round-map' } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const safeInstanceId = instanceId.replace(/[^a-zA-Z0-9_-]/g, '-');
const arrowId = `sdlora-flow-arrow-${locale}-${safeInstanceId}`;
const arrowUrl = `url(#${arrowId})`;
---
<section class="sdlora-slide" data-locale={locale} data-slide-canvas data-active-step-id="all" data-ui-audit="contrast layout" aria-labelledby="sdlora-title">
  <header class="sdlora-slide__header">
    <div>
      <p id="sdlora-title" class="sdlora-slide__title">{t('一轮 SD-LoRA 参数更新', 'One SD-LoRA parameter-update round')}</p>
      <p>{t(
        '上一轮选定的累计 LoRA 先做 128 次 WebShop 任务尝试。每题最早一条通过全部检查的成功进入训练，最多 64 条旧经验也会一起训练。SD-LoRA 得到一份候选参数后，再决定下一轮用新参数还是旧参数。',
        'The cumulative LoRA selected last round runs 128 WebShop attempts. The earliest fully checked success for each task trains together with up to 64 old examples. SD-LoRA then produces candidate parameters, and a separate rule decides whether the next round uses the new or old state.'
      )}</p>
    </div>
  </header>

  <nav class="sdlora-stepper" data-sdlora-stepper aria-label={t('逐步查看一轮参数更新', 'Inspect one parameter-update round step by step')}>
    <button type="button" data-step-id="all" aria-pressed="true">{t('全图', 'Full map')}</button>
    <button type="button" data-step-id="attempts" aria-pressed="false">{t('01 尝试', '01 Attempts')}</button>
    <button type="button" data-step-id="select" aria-pressed="false">{t('02 筛选', '02 Select')}</button>
    <button type="button" data-step-id="update" aria-pressed="false">{t('03 更新', '03 Update')}</button>
    <button type="button" data-step-id="candidate" aria-pressed="false">{t('04 候选', '04 Candidate')}</button>
    <button type="button" data-step-id="choose" aria-pressed="false">{t('05 采用规则', '05 Adoption')}</button>
    <button type="button" data-step-id="noop" aria-pressed="false">{t('无训练样本', 'No trainable sample')}</button>
    <button type="button" data-step-id="next" aria-pressed="false">{t('下一轮', 'Next round')}</button>
  </nav>

  <figure class="sdlora-map" data-testid="sdlora-topology-map" aria-labelledby="sdlora-map-caption">
    <figcaption id="sdlora-map-caption" class="sdlora-map__caption">
      {t(
        '上一轮选定的累计 LoRA 先做 128 次任务尝试；每题最早一条通过全部检查的成功进入训练，最多 64 条旧经验从旁路一起训练。SD-LoRA 保留旧方向、学一个新方向，再重新调整每个方向的影响大小，得到候选 LoRA。如果没有新的、尚未消费并最终能进入参数训练数据集的 clean exact success，参数通道直接 NOOP，沿用上一版累计 LoRA。当前 DirectApply 对有候选的轮次直接采用通过检查的新候选；历史本地 GDR-v1 会先用 16 个任务小测再选新旧参数。选定或沿用后进入下一轮，再回到任务尝试。',
        'The cumulative LoRA selected last round runs 128 task attempts. The earliest fully checked success per task trains together with up to 64 old examples. SD-LoRA keeps old directions fixed, learns one new direction, and rebalances their influence to produce a candidate LoRA. If no new, unattempted clean-exact evidence remains eligible for the parametric training dataset, the parametric channel is a NOOP and keeps the prior cumulative LoRA. For rounds with a candidate, current DirectApply adopts it after checks, while historical local GDR-v1 first probes 16 tasks before choosing new or old parameters. The selected or retained state then runs the next round.'
      )}
    </figcaption>

    <div class="sdlora-map__desktop" data-flow-layout="desktop" aria-hidden="false">
      <svg class="sdlora-map__edges" viewBox="0 0 1200 520" preserveAspectRatio="none" role="img" aria-label={t('Vanilla SD-LoRA 一轮参数更新流程', 'One Vanilla SD-LoRA parameter-update flow')}>
        <defs>
          <marker id={arrowId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" class="sdlora-map__arrowhead" />
          </marker>
        </defs>

        <path data-edge="prior-rollout" class="sdlora-map__edge sdlora-map__edge--main" d="M200 72 H245" marker-end={arrowUrl} />
        <path data-edge="rollout-clean" class="sdlora-map__edge sdlora-map__edge--main" d="M405 72 H450" marker-end={arrowUrl} />
        <path data-edge="clean-update" class="sdlora-map__edge sdlora-map__edge--main" d="M640 72 H700" marker-end={arrowUrl} />
        <path data-edge="clean-noop" class="sdlora-map__edge sdlora-map__edge--noop" d="M555 122 V344 H700" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label sdlora-map__edge-label--noop" x="560" y="330">{t('没有新的可训练成功', 'no new eligible clean success')}</text>
        <path data-edge="update-candidate" class="sdlora-map__edge sdlora-map__edge--main" d="M930 72 H995" marker-end={arrowUrl} />

        <path data-edge="replay-update" class="sdlora-map__edge sdlora-map__edge--side" d="M620 260 H655 Q685 260 700 225" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label" x="628" y="242">{t('≤64 条旧经验', '≤64 old examples')}</text>

        <path data-edge="candidate-directapply" class="sdlora-map__edge sdlora-map__edge--branch" d="M1090 122 V155 H1015 V225" marker-end={arrowUrl} />
        <path data-edge="candidate-gdr" class="sdlora-map__edge sdlora-map__edge--branch" d="M1090 122 V155 H1145 V225" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label" x="1036" y="147">{t('下一轮用哪一版', 'choose next state')}</text>

        <path data-edge="directapply-next" class="sdlora-map__edge sdlora-map__edge--branch" d="M1015 320 V365 H1090 V405" marker-end={arrowUrl} />
        <path data-edge="gdr-next" class="sdlora-map__edge sdlora-map__edge--branch" d="M1145 320 V365 H1090 V405" marker-end={arrowUrl} />
        <path data-edge="noop-next" class="sdlora-map__edge sdlora-map__edge--noop" d="M930 360 H960 V430 H995" marker-end={arrowUrl} />

        <path data-edge="round-return" class="sdlora-map__edge sdlora-map__edge--return" d="M995 430 H950 V492 H315 V126" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label sdlora-map__edge-label--return" x="606" y="482">{t('下一轮：再做 128 次任务尝试', 'Next round: run 128 task attempts again')}</text>
      </svg>

      <article class="sdlora-node sdlora-node--prior" data-flow-node="prior" data-ui-audit-item>
        <small>{t('起点 · 上一轮选定', 'Start · selected last round')}</small>
        <strong>{t('上一轮选定的累计 LoRA', 'Cumulative LoRA selected last round')}</strong>
        <p>{t('基础模型保持不变，加载上一轮已经采用的累计 LoRA。', 'Keep the base model frozen and load the cumulative LoRA adopted last round.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--rollout" data-flow-node="rollout" data-ui-audit-item>
        <small>{t('01 · 任务尝试', '01 · task attempts')}</small>
        <strong>{t('做 128 次 WebShop 尝试', 'Run 128 WebShop attempts')}</strong>
        <p>{t('16 个任务 × 每题 8 次；动作、输出、分数和错误全部记录。', '16 tasks × 8; actions, outputs, scores, and errors are all recorded.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--clean" data-flow-node="clean" data-ui-audit-item>
        <small>{t('02 · 训练数据', '02 · training data')}</small>
        <strong>{t('每题只选一条通过全部检查的成功', 'Use one fully checked success per task')}</strong>
        <p>{t('取最早一条；失败、部分成功、修复过的输出和无效运行只留作分析。', 'Take the earliest one; failures, partial successes, repaired outputs, and invalid runs stay as diagnostics.')}</p>
      </article>

      <aside class="sdlora-node sdlora-node--replay" data-flow-node="replay" data-ui-audit-item>
        <small>{t('旁路 · 旧经验回放', 'Side input · old-example replay')}</small>
        <strong>{t('最多带回 64 条旧经验', 'Bring back up to 64 old examples')}</strong>
        <p>{t('它们和本轮成功样本一起训练，但不算本轮任务尝试。', 'They train alongside this round’s successful examples, but they are not current-round attempts.')}</p>
      </aside>

      <aside class="sdlora-node sdlora-node--noop" data-flow-node="noop" data-ui-audit-item>
        <small>{t('02b · 没有新的可训练成功', '02b · no new eligible clean success')}</small>
        <strong>{t('参数不更新，沿用上一版 LoRA', 'No parameter update; keep the prior LoRA')}</strong>
        <p>{t('没有新的、尚未消费并能进入训练数据集的 clean exact success 时，参数通道记为 NOOP，adapter 与 component 数保持不变。', 'When no new, unattempted clean-exact evidence remains eligible for the training dataset, the parametric channel records a NOOP and keeps the adapter and component count unchanged.')}</p>
      </aside>

      <article class="sdlora-node sdlora-node--update" data-flow-node="update" data-testid="sdlora-direction-magnitude-core" data-ui-audit-item>
        <small>{t('03 · SD-LoRA 更新', '03 · SD-LoRA update')}</small>
        <strong>{t('旧方向不改；学一个新方向；重新调整所有方向的影响大小', 'Keep old directions fixed, learn one new direction, and rebalance each direction’s influence')}</strong>
        <div class="sdlora-update-grid" aria-label={t('SD-LoRA 参数内部', 'Inside the SD-LoRA update')}>
          <span><b>W₀</b>{t('基础模型不动', 'base stays fixed')}</span>
          <span><b>D₁…Dₜ₋₁</b>{t('旧方向不动', 'old directions stay fixed')}</span>
          <span><b>Dₜ ← BₜAₜ</b>{t('本轮新学', 'learned this round')}</span>
          <span><b>α₁ · α₂ · … · αₜ</b>{t('重新调整影响大小', 'rebalance influence')}</span>
        </div>
        <MathFormula latex={String.raw`D_t = \frac{B_tA_t}{\lVert B_tA_t\rVert_F}\quad\Longrightarrow\quad\Delta W_t=\sum_i\alpha_iD_i`} display={false} label={t('SD-LoRA 方向归一化与累计更新', 'SD-LoRA direction normalization and accumulated update')} />
      </article>

      <article class="sdlora-node sdlora-node--candidate" data-flow-node="candidate" data-ui-audit-item>
        <small>{t('04 · 候选参数', '04 · candidate parameters')}</small>
        <strong>{t('得到一份新的累计 LoRA', 'Produce a new cumulative LoRA')}</strong>
        <p>{t('把所有方向合成一份 LoRA。训练到这里结束，但还没决定下一轮是否使用它。', 'Combine all directions into one LoRA. Training ends here, but the next round has not adopted it yet.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--direct" data-flow-node="directapply" data-ui-audit-item>
        <small>{t('当前做法 · DirectApply（直接采用）', 'Current rule · DirectApply')}</small>
        <strong>{t('检查通过就直接采用', 'Adopt directly after checks')}</strong>
        <p>{t('检查通过，下一轮用新参数。', 'After checks, the next round uses the new parameters.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--gdr" data-flow-node="gdr" data-ui-audit-item>
        <small>{t('历史本地做法 · GDR-v1（16 题筛选）', 'Historical local rule · GDR-v1')}</small>
        <strong>{t('先用 16 题小测再决定', 'Probe 16 tasks before deciding')}</strong>
        <p>{t('先用 16 个任务小测，再选新旧参数。', 'Probe 16 tasks, then choose new or old parameters.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--next" data-flow-node="next" data-ui-audit-item>
        <small>{t('下一轮', 'Next round')}</small>
        <strong>{t('用选定的参数继续跑', 'Continue with the selected parameters')}</strong>
        <p>{t('再做下一批 128 次任务尝试，循环继续。', 'Run the next 128 task attempts and continue the loop.')}</p>
      </article>
    </div>

    <div class="sdlora-map__mobile" data-flow-layout="mobile">
      <article class="sdlora-mobile-node" data-flow-node="prior-mobile">
        <small>{t('起点', 'Start')}</small><strong>{t('上一轮选定的累计 LoRA', 'Cumulative LoRA selected last round')}</strong>
      </article>
      <svg class="sdlora-mobile-edge" viewBox="0 0 40 44" role="img" aria-label={t('开始做任务尝试', 'start task attempts')}><path data-edge="prior-rollout-mobile" d="M20 2 V32"/><path d="M14 26 L20 34 L26 26"/></svg>

      <article class="sdlora-mobile-node" data-flow-node="rollout-mobile">
        <small>{t('01 · 任务尝试', '01 · task attempts')}</small><strong>{t('128 次任务尝试', '128 task attempts')}</strong><p>{t('16 个任务 × 每题 8 次。', '16 tasks × 8.')}</p>
      </article>
      <svg class="sdlora-mobile-edge" viewBox="0 0 40 44" role="img" aria-label={t('选出通过全部检查的成功', 'select fully checked success')}><path data-edge="rollout-clean-mobile" d="M20 2 V32"/><path d="M14 26 L20 34 L26 26"/></svg>

      <article class="sdlora-mobile-node" data-flow-node="clean-mobile">
        <small>{t('02 · 训练数据', '02 · training data')}</small><strong>{t('通过全部检查的成功', 'Fully checked success')}</strong><p>{t('每题取最早一条；其他结果只留作分析。', 'Take the earliest one per task; other results stay for diagnostics.')}</p>
      </article>

      <div class="sdlora-mobile-noop" aria-label={t('没有新的可训练成功时的参数 NOOP 分支', 'parameter NOOP branch when no new eligible clean success remains')}>
        <svg viewBox="0 0 64 48" role="img" aria-label={t('没有新的可训练成功，进入 NOOP', 'no new eligible clean success, enter NOOP')}><path data-edge="clean-noop-mobile" d="M32 2 V28 H50"/><path d="M44 22 L52 28 L44 34"/></svg>
        <aside data-flow-node="noop-mobile">
          <small>{t('如果没有新的可训练成功', 'if no new eligible clean success remains')}</small>
          <strong>{t('参数不更新，沿用上一版 LoRA', 'No parameter update; keep the prior LoRA')}</strong>
          <p>{t('参数通道记录 NOOP；adapter 与 component 数不变，直接继续下一轮。', 'The parametric channel records a NOOP; adapter and component count stay unchanged, then the next round continues.')}</p>
          <div class="sdlora-mobile-noop__next-row">
            <svg class="sdlora-mobile-noop__next" viewBox="0 0 72 28" role="img" aria-label={t('沿用参数后进入下一轮', 'retained parameters continue to the next round')}><path data-edge="noop-next-mobile" d="M2 14 H58"/><path d="M52 8 L60 14 L52 20"/></svg>
            <span data-flow-node="noop-terminal-mobile">{t('下一轮 · 沿用上一版 LoRA', 'Next round · keep the prior LoRA')}</span>
          </div>
        </aside>
      </div>

      <div class="sdlora-mobile-join">
        <aside class="sdlora-mobile-side" data-flow-node="replay-mobile"><small>{t('旧经验回放', 'old-example replay')}</small><strong>{t('最多 64 条', 'up to 64')}</strong></aside>
        <svg viewBox="0 0 64 88" role="img" aria-label={t('旧经验从旁边一起参加训练', 'old examples join training from the side')}><path data-edge="replay-update-mobile" d="M4 28 H36 Q52 28 52 44 V58"/><path d="M46 52 L52 60 L58 52"/></svg>
        <article class="sdlora-mobile-node sdlora-mobile-node--update" data-flow-node="update-mobile">
          <small>{t('03 · SD-LoRA 更新', '03 · SD-LoRA update')}</small><strong>{t('旧方向不改；学一个新方向；重调各方向影响大小', 'Keep old directions fixed; learn one new direction; rebalance their influence')}</strong><MathFormula latex={String.raw`\Delta W_t=\sum_i\alpha_iD_i`} display={false} label={t('SD-LoRA 累计参数更新', 'SD-LoRA accumulated parameter update')} />
        </article>
      </div>

      <svg class="sdlora-mobile-edge" viewBox="0 0 40 44" role="img" aria-label={t('形成候选参数', 'produce candidate parameters')}><path data-edge="update-candidate-mobile" d="M20 2 V32"/><path d="M14 26 L20 34 L26 26"/></svg>
      <article class="sdlora-mobile-node" data-flow-node="candidate-mobile"><small>{t('04 · 候选参数', '04 · candidate parameters')}</small><strong>{t('新的累计 LoRA', 'New cumulative LoRA')}</strong><p>{t('训练完成，但还没决定下一轮是否使用它。', 'Training is done, but the next round has not adopted it yet.')}</p></article>

      <div class="sdlora-mobile-branch" aria-label={t('下一轮用新参数还是旧参数', 'choose new or old parameters for the next round')}>
        <svg class="sdlora-mobile-branch__split" viewBox="0 0 300 54" role="img" aria-label={t('两种做法决定下一轮参数', 'two rules choose the next-round parameters')}>
          <path data-edge="candidate-directapply-mobile" d="M150 2 V20 H72 V42"/><path d="M66 36 L72 44 L78 36"/>
          <path data-edge="candidate-gdr-mobile" d="M150 2 V20 H228 V42"/><path d="M222 36 L228 44 L234 36"/>
        </svg>
        <div class="sdlora-mobile-branch__choices">
          <article><small>{t('当前做法 · DirectApply（直接采用）', 'Current rule · DirectApply')}</small><strong>{t('检查通过就直接采用', 'Adopt directly after checks')}</strong></article>
          <article><small>{t('历史本地做法 · GDR-v1（16 题筛选）', 'Historical local rule · GDR-v1')}</small><strong>{t('先用 16 题小测再决定', 'Probe 16 tasks before deciding')}</strong></article>
        </div>
        <svg class="sdlora-mobile-branch__join" viewBox="0 0 300 54" role="img" aria-label={t('选定参数后进入下一轮', 'selected parameters enter the next round')}>
          <path data-edge="directapply-next-mobile" d="M72 2 V18 H150 V42"/><path data-edge="gdr-next-mobile" d="M228 2 V18 H150 V42"/><path d="M144 36 L150 44 L156 36"/>
        </svg>
      </div>

      <article class="sdlora-mobile-node" data-flow-node="next-mobile"><small>{t('下一轮', 'Next round')}</small><strong>{t('用选定的参数继续跑', 'Continue with the selected parameters')}</strong></article>
      <svg class="sdlora-mobile-return" viewBox="0 0 320 72" role="img" aria-label={t('下一轮继续做任务尝试', 'next round continues with task attempts')}>
        <path data-edge="round-return-mobile" d="M286 10 H64 Q24 10 24 42 H236"/>
        <path d="M228 36 L238 42 L228 48"/>
        <text x="78" y="64">{t('再做 128 次任务尝试', 'run 128 task attempts again')}</text>
      </svg>
    </div>
  </figure>

  <div class="sdlora-legend" aria-label={t('图例', 'Legend')}>
    <span data-kind="main">{t('主流程', 'main path')}</span>
    <span data-kind="side">{t('旧经验回放', 'old-example replay')}</span>
    <span data-kind="branch">{t('新旧参数选择', 'new/old parameter choice')}</span>
    <span data-kind="noop">{t('没有训练样本时不更新', 'no update without trainable data')}</span>
    <span data-kind="return">{t('回到下一轮', 'return to next round')}</span>
  </div>
</section>

<script>
  const stepMap = {
    attempts: {
      nodes: ['prior', 'rollout', 'prior-mobile', 'rollout-mobile'],
      edges: ['prior-rollout', 'prior-rollout-mobile'],
    },
    select: {
      nodes: ['rollout', 'clean', 'rollout-mobile', 'clean-mobile'],
      edges: ['rollout-clean', 'rollout-clean-mobile'],
    },
    update: {
      nodes: ['clean', 'replay', 'update', 'clean-mobile', 'replay-mobile', 'update-mobile'],
      edges: ['clean-update', 'replay-update', 'replay-update-mobile'],
    },
    candidate: {
      nodes: ['update', 'candidate', 'update-mobile', 'candidate-mobile'],
      edges: ['update-candidate', 'update-candidate-mobile'],
    },
    choose: {
      nodes: ['candidate', 'directapply', 'gdr', 'next', 'candidate-mobile', 'next-mobile'],
      edges: ['candidate-directapply', 'candidate-gdr', 'directapply-next', 'gdr-next', 'candidate-directapply-mobile', 'candidate-gdr-mobile', 'directapply-next-mobile', 'gdr-next-mobile'],
    },
    noop: {
      nodes: ['clean', 'noop', 'next', 'clean-mobile', 'noop-mobile', 'noop-terminal-mobile', 'next-mobile'],
      edges: ['clean-noop', 'noop-next', 'clean-noop-mobile', 'noop-next-mobile'],
    },
    next: {
      nodes: ['next', 'rollout', 'next-mobile', 'rollout-mobile'],
      edges: ['round-return', 'round-return-mobile'],
    },
  } as const;

  document.querySelectorAll<HTMLElement>('[data-slide-canvas]').forEach((root) => {
    const stepper = root.querySelector<HTMLElement>('[data-sdlora-stepper]');
    if (!stepper || root.dataset.enhanced === 'true') return;
    root.dataset.enhanced = 'true';
    const buttons = [...stepper.querySelectorAll<HTMLButtonElement>('[data-step-id]')];

    const setActiveStepId = (activeStepId: string) => {
      root.dataset.activeStepId = activeStepId;
      root.dataset.stepFiltered = activeStepId === 'all' ? 'false' : 'true';
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.stepId === activeStepId)));

      root.querySelectorAll<HTMLElement>('[data-flow-node], [data-edge]').forEach((element) => {
        element.removeAttribute('data-sdlora-focused');
      });
      if (activeStepId === 'all') return;
      const group = stepMap[activeStepId as keyof typeof stepMap];
      if (!group) return;
      group.nodes.forEach((node) => root.querySelectorAll<HTMLElement>(`[data-flow-node="${node}"]`).forEach((element) => element.dataset.sdloraFocused = 'true'));
      group.edges.forEach((edge) => root.querySelectorAll<HTMLElement>(`[data-edge="${edge}"]`).forEach((element) => element.dataset.sdloraFocused = 'true'));
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => setActiveStepId(button.dataset.stepId || 'all'));
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? buttons.length - 1
            : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
        buttons[nextIndex]?.focus();
        buttons[nextIndex]?.click();
      });
    });

    setActiveStepId('all');
  });
</script>

<style>
