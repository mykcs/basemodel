---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const arrowId = `sdlora-flow-arrow-${locale}`;
const arrowUrl = `url(#${arrowId})`;
---
<section class="sdlora-slide" data-locale={locale} data-slide-canvas data-ui-audit="contrast layout" aria-labelledby="sdlora-title">
  <header class="sdlora-slide__header">
    <div>
      <h2 id="sdlora-title">{t('Vanilla SD-LoRA 的一轮参数更新', 'One Vanilla SD-LoRA parameter-update round')}</h2>
      <p>{t(
        '上一轮选定的累计 LoRA 先做 128 次 WebShop 任务尝试。每题最早一条通过全部检查的成功进入训练，最多 64 条旧经验也会一起训练。SD-LoRA 得到一份候选参数后，再决定下一轮用新参数还是旧参数。',
        'The cumulative LoRA selected last round runs 128 WebShop attempts. The earliest fully checked success for each task trains together with up to 64 old examples. SD-LoRA then produces candidate parameters, and a separate rule decides whether the next round uses the new or old state.'
      )}</p>
      <p class="sdlora-slide__scope">{t(
        '实线是本轮主流程；旁路表示旧经验回放；分支表示训练结束后还要在新旧参数之间做选择。动画只沿这些真实路线移动，关闭动画也不影响理解。',
        'The solid route is the main round; the side route is old-example replay; the branch chooses whether the next round uses new or old parameters. Motion only traces these routes, and the full meaning remains visible with motion off.'
      )}</p>
    </div>
  </header>

  <figure class="sdlora-map" data-testid="sdlora-topology-map" aria-labelledby="sdlora-map-caption">
    <figcaption id="sdlora-map-caption" class="sdlora-map__caption">
      {t(
        '上一轮选定的累计 LoRA 先做 128 次任务尝试；每题最早一条通过全部检查的成功进入训练，最多 64 条旧经验从旁路一起训练。SD-LoRA 保留旧方向、学一个新方向，再重新调整每个方向的影响大小，得到候选 LoRA。当前 DirectApply 直接采用通过检查的新候选；历史本地 GDR-v1 会先用 16 个任务小测再选新旧参数。选定后进入下一轮，再回到任务尝试。',
        'The cumulative LoRA selected last round runs 128 task attempts. The earliest fully checked success per task trains together with up to 64 old examples. SD-LoRA keeps old directions fixed, learns one new direction, and rebalances their influence to produce a candidate LoRA. Current DirectApply adopts a candidate after checks; historical local GDR-v1 first probes 16 tasks before choosing new or old parameters. The selected state then runs the next round.'
      )}
    </figcaption>

    <div class="sdlora-map__desktop" data-flow-layout="desktop" aria-hidden="false">
      <svg class="sdlora-map__edges" viewBox="0 0 1200 520" preserveAspectRatio="none" role="img" aria-label={t('Vanilla SD-LoRA 一轮参数更新流程', 'One Vanilla SD-LoRA parameter-update flow')}>
        <defs>
          <marker id={arrowId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" class="sdlora-map__arrowhead" />
          </marker>
        </defs>

        <path data-edge="prior-rollout" class="sdlora-map__edge sdlora-map__edge--main" d="M200 72 H245" marker-end={arrowUrl} />
        <path data-edge="rollout-clean" class="sdlora-map__edge sdlora-map__edge--main" d="M405 72 H450" marker-end={arrowUrl} />
        <path data-edge="clean-update" class="sdlora-map__edge sdlora-map__edge--main" d="M640 72 H700" marker-end={arrowUrl} />
        <path data-edge="update-candidate" class="sdlora-map__edge sdlora-map__edge--main" d="M930 72 H995" marker-end={arrowUrl} />

        <path data-edge="replay-update" class="sdlora-map__edge sdlora-map__edge--side" d="M620 260 H655 Q685 260 700 225" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label" x="628" y="242">{t('≤64 条旧经验', '≤64 old examples')}</text>

        <path data-edge="candidate-directapply" class="sdlora-map__edge sdlora-map__edge--branch" d="M1090 122 V155 H1015 V225" marker-end={arrowUrl} />
        <path data-edge="candidate-gdr" class="sdlora-map__edge sdlora-map__edge--branch" d="M1090 122 V155 H1145 V225" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label" x="1036" y="147">{t('下一轮用哪一版', 'choose next state')}</text>

        <path data-edge="directapply-next" class="sdlora-map__edge sdlora-map__edge--branch" d="M1015 320 V348 H1090 V380" marker-end={arrowUrl} />
        <path data-edge="gdr-next" class="sdlora-map__edge sdlora-map__edge--branch" d="M1145 320 V348 H1090 V380" marker-end={arrowUrl} />

        <path data-edge="round-return" class="sdlora-map__edge sdlora-map__edge--return" d="M995 430 H950 V492 H315 V126" marker-end={arrowUrl} />
        <text class="sdlora-map__edge-label sdlora-map__edge-label--return" x="606" y="482">{t('下一轮：再做 128 次任务尝试', 'Next round: run 128 task attempts again')}</text>
      </svg>

      <article class="sdlora-node sdlora-node--prior" data-flow-node="prior" data-ui-audit-item>
        <small>{t('起点 · 上一轮选定', 'Start · selected last round')}</small>
        <strong>{t('上一轮选定的累计 LoRA', 'Cumulative LoRA selected last round')}</strong>
        <p>{t('基础模型保持不变，加载上一轮已经采用的累计 LoRA。', 'Keep the base model frozen and load the cumulative LoRA adopted last round.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--rollout" data-flow-node="rollout" data-ui-audit-item>
        <small>{t('01 · 任务尝试', '01 · task attempts')}</small>
        <strong>{t('做 128 次 WebShop 尝试', 'Run 128 WebShop attempts')}</strong>
        <p>{t('16 个任务 × 每题 8 次；动作、输出、分数和错误全部记录。', '16 tasks × 8; actions, outputs, scores, and errors are all recorded.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--clean" data-flow-node="clean" data-ui-audit-item>
        <small>{t('02 · 训练数据', '02 · training data')}</small>
        <strong>{t('每题只选一条通过全部检查的成功', 'Use one fully checked success per task')}</strong>
        <p>{t('取最早一条；失败、部分成功、修复过的输出和无效运行只留作分析。', 'Take the earliest one; failures, partial successes, repaired outputs, and invalid runs stay as diagnostics.')}</p>
      </article>

      <aside class="sdlora-node sdlora-node--replay" data-flow-node="replay" data-ui-audit-item>
        <small>{t('旁路 · 旧经验回放', 'Side input · old-example replay')}</small>
        <strong>{t('最多带回 64 条旧经验', 'Bring back up to 64 old examples')}</strong>
        <p>{t('它们和本轮成功样本一起训练，但不算本轮任务尝试。', 'They train alongside this round’s successful examples, but they are not current-round attempts.')}</p>
      </aside>

      <article class="sdlora-node sdlora-node--update" data-flow-node="update" data-testid="sdlora-direction-magnitude-core" data-ui-audit-item>
        <small>{t('03 · SD-LoRA 更新', '03 · SD-LoRA update')}</small>
        <strong>{t('旧方向不改；学一个新方向；重新调整所有方向的影响大小', 'Keep old directions fixed, learn one new direction, and rebalance each direction’s influence')}</strong>
        <div class="sdlora-update-grid" aria-label={t('SD-LoRA 参数内部', 'Inside the SD-LoRA update')}>
          <span><b>W₀</b>{t('基础模型不动', 'base stays fixed')}</span>
          <span><b>D₁…Dₜ₋₁</b>{t('旧方向不动', 'old directions stay fixed')}</span>
          <span><b>Dₜ ← BₜAₜ</b>{t('本轮新学', 'learned this round')}</span>
          <span><b>α₁ · α₂ · … · αₜ</b>{t('重新调整影响大小', 'rebalance influence')}</span>
        </div>
        <code>Dₜ = BₜAₜ / ‖BₜAₜ‖<sub>F</sub>　→　ΔWₜ = Σ αᵢDᵢ</code>
      </article>

      <article class="sdlora-node sdlora-node--candidate" data-flow-node="candidate" data-ui-audit-item>
        <small>{t('04 · 候选参数', '04 · candidate parameters')}</small>
        <strong>{t('得到一份新的累计 LoRA', 'Produce a new cumulative LoRA')}</strong>
        <p>{t('把所有方向合成一份 LoRA。训练到这里结束，但还没决定下一轮是否使用它。', 'Combine all directions into one LoRA. Training ends here, but the next round has not adopted it yet.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--direct" data-flow-node="directapply" data-ui-audit-item>
        <small>{t('当前做法', 'Current rule')}</small>
        <strong>DirectApply</strong>
        <p>{t('检查通过，下一轮用新参数。', 'After checks, the next round uses the new parameters.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--gdr" data-flow-node="gdr" data-ui-audit-item>
        <small>{t('历史本地做法', 'Historical local rule')}</small>
        <strong>GDR-v1</strong>
        <p>{t('先用 16 个任务小测，再选新旧参数。', 'Probe 16 tasks, then choose new or old parameters.')}</p>
      </article>

      <article class="sdlora-node sdlora-node--next" data-flow-node="next" data-ui-audit-item>
        <small>{t('下一轮', 'Next round')}</small>
        <strong>{t('用选定的参数继续跑', 'Continue with the selected parameters')}</strong>
        <p>{t('再做下一批 128 次任务尝试，循环继续。', 'Run the next 128 task attempts and continue the loop.')}</p>
      </article>
    </div>

    <div class="sdlora-map__mobile" data-flow-layout="mobile">
      <article class="sdlora-mobile-node" data-flow-node="prior-mobile">
        <small>{t('起点', 'Start')}</small><strong>{t('上一轮选定的累计 LoRA', 'Cumulative LoRA selected last round')}</strong>
      </article>
      <svg class="sdlora-mobile-edge" viewBox="0 0 40 44" role="img" aria-label={t('开始做任务尝试', 'start task attempts')}><path data-edge="prior-rollout-mobile" d="M20 2 V32"/><path d="M14 26 L20 34 L26 26"/></svg>

      <article class="sdlora-mobile-node" data-flow-node="rollout-mobile">
        <small>{t('01 · 任务尝试', '01 · task attempts')}</small><strong>{t('128 次任务尝试', '128 task attempts')}</strong><p>{t('16 个任务 × 每题 8 次。', '16 tasks × 8.')}</p>
      </article>
      <svg class="sdlora-mobile-edge" viewBox="0 0 40 44" role="img" aria-label={t('选出通过全部检查的成功', 'select fully checked success')}><path data-edge="rollout-clean-mobile" d="M20 2 V32"/><path d="M14 26 L20 34 L26 26"/></svg>

      <article class="sdlora-mobile-node" data-flow-node="clean-mobile">
        <small>{t('02 · 训练数据', '02 · training data')}</small><strong>{t('通过全部检查的成功', 'Fully checked success')}</strong><p>{t('每题取最早一条；其他结果只留作分析。', 'Take the earliest one per task; other results stay for diagnostics.')}</p>
      </article>

      <div class="sdlora-mobile-join">
        <aside class="sdlora-mobile-side" data-flow-node="replay-mobile"><small>{t('旧经验回放', 'old-example replay')}</small><strong>{t('最多 64 条', 'up to 64')}</strong></aside>
        <svg viewBox="0 0 64 88" role="img" aria-label={t('旧经验从旁边一起参加训练', 'old examples join training from the side')}><path data-edge="replay-update-mobile" d="M4 28 H36 Q52 28 52 44 V58"/><path d="M46 52 L52 60 L58 52"/></svg>
        <article class="sdlora-mobile-node sdlora-mobile-node--update" data-flow-node="update-mobile">
          <small>{t('03 · SD-LoRA 更新', '03 · SD-LoRA update')}</small><strong>{t('旧方向不改；学一个新方向；重调各方向影响大小', 'Keep old directions fixed; learn one new direction; rebalance their influence')}</strong><code>ΔWₜ = Σ αᵢDᵢ</code>
        </article>
      </div>

      <svg class="sdlora-mobile-edge" viewBox="0 0 40 44" role="img" aria-label={t('形成候选参数', 'produce candidate parameters')}><path data-edge="update-candidate-mobile" d="M20 2 V32"/><path d="M14 26 L20 34 L26 26"/></svg>
      <article class="sdlora-mobile-node" data-flow-node="candidate-mobile"><small>{t('04 · 候选参数', '04 · candidate parameters')}</small><strong>{t('新的累计 LoRA', 'New cumulative LoRA')}</strong><p>{t('训练完成，但还没决定下一轮是否使用它。', 'Training is done, but the next round has not adopted it yet.')}</p></article>

      <div class="sdlora-mobile-branch" aria-label={t('下一轮用新参数还是旧参数', 'choose new or old parameters for the next round')}>
        <svg class="sdlora-mobile-branch__split" viewBox="0 0 300 54" role="img" aria-label={t('两种做法决定下一轮参数', 'two rules choose the next-round parameters')}>
          <path data-edge="candidate-directapply-mobile" d="M150 2 V20 H72 V42"/><path d="M66 36 L72 44 L78 36"/>
          <path data-edge="candidate-gdr-mobile" d="M150 2 V20 H228 V42"/><path d="M222 36 L228 44 L234 36"/>
        </svg>
        <div class="sdlora-mobile-branch__choices">
          <article><small>{t('当前做法', 'Current rule')}</small><strong>DirectApply</strong></article>
          <article><small>{t('历史本地做法', 'Historical local rule')}</small><strong>GDR-v1</strong></article>
        </div>
        <svg class="sdlora-mobile-branch__join" viewBox="0 0 300 54" role="img" aria-label={t('选定参数后进入下一轮', 'selected parameters enter the next round')}>
          <path data-edge="directapply-next-mobile" d="M72 2 V18 H150 V42"/><path data-edge="gdr-next-mobile" d="M228 2 V18 H150 V42"/><path d="M144 36 L150 44 L156 36"/>
        </svg>
      </div>

      <article class="sdlora-mobile-node" data-flow-node="next-mobile"><small>{t('下一轮', 'Next round')}</small><strong>{t('用选定的参数继续跑', 'Continue with the selected parameters')}</strong></article>
      <svg class="sdlora-mobile-return" viewBox="0 0 320 72" role="img" aria-label={t('下一轮继续做任务尝试', 'next round continues with task attempts')}>
        <path data-edge="round-return-mobile" d="M286 10 H64 Q24 10 24 42 H236"/>
        <path d="M228 36 L238 42 L228 48"/>
        <text x="78" y="64">{t('再做 128 次任务尝试', 'run 128 task attempts again')}</text>
      </svg>
    </div>
  </figure>

  <div class="sdlora-legend" aria-label={t('图例', 'Legend')}>
    <span data-kind="main">{t('主流程', 'main path')}</span>
    <span data-kind="side">{t('旧经验回放', 'old-example replay')}</span>
    <span data-kind="branch">{t('新旧参数选择', 'new/old parameter choice')}</span>
    <span data-kind="return">{t('回到下一轮', 'return to next round')}</span>
  </div>
</section>

<style>
.sdlora-slide{box-sizing:border-box;aspect-ratio:16/9;min-height:0;padding:1.05rem 1.25rem .75rem;border:1px solid var(--line);border-radius:var(--radius-feature);background:var(--surface);display:grid;grid-template-rows:auto 1fr auto;gap:.55rem;overflow:hidden}.sdlora-slide__header{border-bottom:1px solid var(--line);padding-bottom:.58rem}.sdlora-slide h2{max-width:17ch;margin:0;font-size:clamp(1.95rem,3.7vw,3.45rem);line-height:1.02;letter-spacing:-.045em}.sdlora-slide__header>div>p{max-width:66rem;margin:.38rem 0 0;font-size:.92rem;line-height:1.42}.sdlora-slide__header>div>p.sdlora-slide__scope{color:var(--muted);font-size:.69rem}.sdlora-map{position:relative;min-height:0;margin:0}.sdlora-map__caption{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.sdlora-map__desktop{position:relative;height:100%;min-height:0}.sdlora-map__mobile{display:none}.sdlora-map__edges{position:absolute;inset:0;width:100%;height:100%;z-index:0;overflow:visible}.sdlora-map__edge{fill:none;stroke:var(--line-strong,var(--line));stroke-width:2.2;vector-effect:non-scaling-stroke}.sdlora-map__edge--main{stroke:var(--accent-deep);stroke-dasharray:10 8;animation:sdlora-route-trace 2.8s linear infinite}.sdlora-map__edge--side{stroke:var(--color-info);stroke-dasharray:6 6}.sdlora-map__edge--branch{stroke:var(--muted);stroke-dasharray:5 5}.sdlora-map__edge--return{stroke:var(--color-positive);stroke-dasharray:11 9;animation:sdlora-route-trace 3.3s linear infinite}.sdlora-map__arrowhead{fill:var(--ink)}.sdlora-map__edge-label{fill:var(--muted);font:700 13px/1 var(--font-sans)}.sdlora-map__edge-label--return{fill:var(--color-positive)}.sdlora-node{position:absolute;z-index:1;box-sizing:border-box;padding:.55rem .65rem;border:1px solid var(--line);border-radius:.72rem;background:color-mix(in srgb,var(--surface) 96%,transparent);box-shadow:0 8px 22px color-mix(in srgb,var(--ink) 7%,transparent)}.sdlora-node small{display:block;color:var(--muted);font:800 .58rem/1.2 var(--font-mono);letter-spacing:.03em}.sdlora-node strong{display:block;margin:.18rem 0 0;font-size:.76rem;line-height:1.24}.sdlora-node p{margin:.22rem 0 0;color:var(--muted);font-size:.61rem;line-height:1.34}.sdlora-node--prior{left:1.2%;top:2%;width:15.5%}.sdlora-node--rollout{left:20.3%;top:2%;width:15.2%}.sdlora-node--clean{left:38.4%;top:2%;width:16.8%}.sdlora-node--update{left:58.4%;top:0;width:19.4%;min-height:51%;border-color:color-mix(in srgb,var(--accent-deep) 48%,var(--line));background:color-mix(in srgb,var(--accent) 7%,var(--surface))}.sdlora-node--candidate{left:82.2%;top:2%;width:16.5%}.sdlora-node--replay{left:39.2%;top:42%;width:16.4%;border-style:dashed}.sdlora-node--direct{left:80.5%;top:43%;width:8.7%;text-align:center}.sdlora-node--gdr{left:90.7%;top:43%;width:8.1%;text-align:center}.sdlora-node--direct p,.sdlora-node--gdr p{font-size:.55rem}.sdlora-node--next{left:82.2%;top:72%;width:16.5%;border-color:color-mix(in srgb,var(--color-positive) 48%,var(--line))}.sdlora-update-grid{display:grid;grid-template-columns:1fr 1fr;gap:.24rem;margin:.45rem 0 .4rem}.sdlora-update-grid span{display:grid;gap:.08rem;padding:.25rem .3rem;border:1px solid var(--line);border-radius:.42rem;background:var(--surface)}.sdlora-update-grid b{font:800 .59rem/1.15 var(--font-mono)}.sdlora-update-grid span{color:var(--muted);font-size:.49rem;line-height:1.2}.sdlora-node--update code{display:block;padding-top:.28rem;border-top:1px solid var(--line);white-space:normal;color:var(--ink);font-size:.55rem;line-height:1.3}.sdlora-legend{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .9rem;padding-top:.36rem;border-top:1px solid var(--line);font-size:.64rem;color:var(--muted)}.sdlora-legend span::before{content:"";display:inline-block;width:.72rem;height:.16rem;margin-right:.3rem;vertical-align:.2rem;background:var(--line)}.sdlora-legend span[data-kind="main"]::before{background:var(--accent-deep)}.sdlora-legend span[data-kind="side"]::before{background:var(--color-info)}.sdlora-legend span[data-kind="branch"]::before{background:var(--muted)}.sdlora-legend span[data-kind="return"]::before{background:var(--color-positive)}
@keyframes sdlora-route-trace{to{stroke-dashoffset:-36}}
@media(prefers-reduced-motion:reduce){.sdlora-map__edge--main,.sdlora-map__edge--return{animation:none}}
@media(max-width:900px){.sdlora-slide{aspect-ratio:auto;overflow:visible}.sdlora-map__desktop{display:none}.sdlora-map__mobile{display:grid;gap:.12rem;padding:.3rem 0}.sdlora-mobile-node{padding:.68rem .75rem;border:1px solid var(--line);border-radius:.72rem;background:var(--surface-muted)}.sdlora-mobile-node small,.sdlora-mobile-side small,.sdlora-mobile-branch article small{display:block;color:var(--muted);font:800 .61rem/1.2 var(--font-mono)}.sdlora-mobile-node strong,.sdlora-mobile-side strong,.sdlora-mobile-branch article strong{display:block;margin-top:.15rem;font-size:.84rem;line-height:1.28}.sdlora-mobile-node p{margin:.2rem 0 0;color:var(--muted);font-size:.7rem;line-height:1.4}.sdlora-mobile-node code{display:block;margin-top:.34rem;padding-top:.3rem;border-top:1px solid var(--line);font-size:.66rem}.sdlora-mobile-edge{width:40px;height:32px;justify-self:center;overflow:visible}.sdlora-mobile-edge path,.sdlora-mobile-join svg path,.sdlora-mobile-branch svg path,.sdlora-mobile-return path{fill:none;stroke:var(--accent-deep);stroke-width:2.2;vector-effect:non-scaling-stroke}.sdlora-mobile-edge path:first-child{stroke-dasharray:7 6;animation:sdlora-route-trace 2.8s linear infinite}.sdlora-mobile-join{display:grid;grid-template-columns:minmax(0,.72fr) 48px minmax(0,1.45fr);align-items:center;gap:.35rem}.sdlora-mobile-side{padding:.55rem .6rem;border:1px dashed var(--color-info);border-radius:.68rem;background:var(--surface)}.sdlora-mobile-join svg{width:48px;height:72px}.sdlora-mobile-join svg path{stroke:var(--color-info);stroke-dasharray:5 5}.sdlora-mobile-node--update{border-color:color-mix(in srgb,var(--accent-deep) 48%,var(--line));background:color-mix(in srgb,var(--accent) 7%,var(--surface))}.sdlora-mobile-branch{display:grid;gap:0}.sdlora-mobile-branch__split,.sdlora-mobile-branch__join{width:min(300px,86%);height:48px;justify-self:center}.sdlora-mobile-branch svg path{stroke:var(--muted);stroke-dasharray:5 5}.sdlora-mobile-branch__choices{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.sdlora-mobile-branch__choices article{padding:.58rem .65rem;border:1px solid var(--line);border-radius:.68rem;text-align:center;background:var(--surface)}.sdlora-mobile-return{width:min(320px,94%);height:68px;justify-self:center}.sdlora-mobile-return path{stroke:var(--color-positive);stroke-dasharray:9 7;animation:sdlora-route-trace 3.3s linear infinite}.sdlora-mobile-return text{fill:var(--color-positive);font:700 12px/1 var(--font-sans)}.sdlora-legend{font-size:.62rem}}
