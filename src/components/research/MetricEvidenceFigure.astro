---
interface MetricChart {
  title: string;
  src: string;
  href: string;
  alt: string;
  linkText?: string;
}
interface Props { item: MetricChart }
const { item } = Astro.props;
const linkText = item.linkText ?? '打开 W&B 原生 panel ↗';
const ariaAction = linkText.replace(/\s*↗$/, '');
const frameId = 'metric-evidence-' + item.src.split('/').at(-1)!.replace(/[^a-z0-9-]/gi, '-');
---

<figure class="metric-evidence" data-research-figure-size="wide">
  <div class="metric-evidence__viewport" id={frameId} tabindex="-1" aria-label={`${item.title}，可展开原尺寸并在图内横向滚动`}>
    <a href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.title} · ${ariaAction}`}>
      <img src={item.src} alt={item.alt} loading="lazy" width="1200" height="675" />
    </a>
  </div>
  <figcaption>
    <strong>{item.title}</strong>
    <button type="button" hidden class="metric-evidence__zoom-toggle" data-metric-zoom aria-controls={frameId} aria-expanded="false">
      <span class="metric-evidence__zoom-symbol" aria-hidden="true">+</span>
      <span data-metric-zoom-label>放大查看图表</span>
    </button>
    <a href={item.src} target="_blank" rel="noreferrer" aria-label={`原尺寸打开：${item.title}`}>查看原尺寸 SVG</a>
    <a href={item.href} target="_blank" rel="noreferrer">{linkText}</a>
  </figcaption>
</figure>

<style>
  .metric-evidence{margin:1rem 0 1.35rem;min-width:0}
  .metric-evidence__viewport{display:block;max-width:100%;min-width:0;overflow:hidden;border:1px solid var(--border-color);border-radius:var(--radius-panel);background:#fff;box-shadow:0 10px 28px color-mix(in srgb,var(--text-primary) 7%,transparent)}
  .metric-evidence__viewport a{display:block;width:100%}
  .metric-evidence__viewport img{display:block;width:100%;height:auto;max-width:100%}
  .metric-evidence__viewport.is-expanded{overflow-x:auto;overscroll-behavior-inline:contain;scrollbar-width:thin}
  .metric-evidence__viewport.is-expanded a{width:1200px}
  .metric-evidence__viewport.is-expanded img{width:1200px;max-width:none}
  .metric-evidence figcaption{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem 1rem;margin-top:.6rem;line-height:1.5}
  .metric-evidence figcaption>strong{margin-inline-end:auto;font-size:var(--type-figure-title);font-weight:var(--type-weight-label)}
  .metric-evidence figcaption>a{font-size:var(--type-meta);font-weight:var(--type-weight-medium)}
  .metric-evidence__zoom-toggle[hidden]{display:none}
  .metric-evidence__zoom-toggle{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .5rem;border:1px solid var(--color-border);border-radius:var(--radius-control);background:var(--color-surface);color:var(--color-text);font:var(--type-weight-medium) var(--type-meta)/var(--type-leading-caption) var(--font-interface);cursor:pointer}
  .metric-evidence__zoom-toggle:hover{border-color:var(--color-accent)}
  .metric-evidence__zoom-toggle:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}
  .metric-evidence__zoom-symbol{display:inline-grid;place-items:center;width:1.2rem;height:1.2rem;border:1px solid currentColor;border-radius:50%;line-height:1;font-size:var(--type-meta)}
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-metric-zoom]').forEach(button => {
    const id = button.getAttribute('aria-controls');
    const viewport = id ? document.getElementById(id) : null;
    const label = button.querySelector('[data-metric-zoom-label]');
    const symbol = button.querySelector('.metric-evidence__zoom-symbol');
    if (!(viewport instanceof HTMLElement) || !(label instanceof HTMLElement) || !(symbol instanceof HTMLElement)) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const expanded = !viewport.classList.contains('is-expanded');
      viewport.classList.toggle('is-expanded', expanded);
      viewport.tabIndex = expanded ? 0 : -1;
      viewport.scrollLeft = 0;
      button.setAttribute('aria-expanded', String(expanded));
      label.textContent = expanded ? '收起原尺寸图' : '放大查看图表';
      symbol.textContent = expanded ? '−' : '+';
      if (expanded) viewport.focus({ preventScroll: true });
    });
  });
</script>
