---
interface MetricChart {
  title: string;
  src: string;
  href: string;
  alt: string;
}
interface Props { item: MetricChart }
const { item } = Astro.props;
---

<figure class="metric-evidence">
  <a href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.title} · 打开 W&B 原生 panel`}>
    <img src={item.src} alt={item.alt} loading="lazy" width="1200" height="675" />
  </a>
  <figcaption>
    <strong>{item.title}</strong>
    <a href={item.href} target="_blank" rel="noreferrer">打开 W&B 原生 panel ↗</a>
  </figcaption>
</figure>

<style>
  .metric-evidence{margin:1rem 0 1.35rem;min-width:0}
  .metric-evidence>a{display:block;border:1px solid var(--border-color);border-radius:var(--radius-panel);overflow:hidden;background:#fff;box-shadow:0 10px 28px color-mix(in srgb,var(--text-primary) 7%,transparent)}
  .metric-evidence img{display:block;width:100%;height:auto}
  .metric-evidence figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.45rem 1rem;margin-top:.6rem;line-height:1.5}
  .metric-evidence figcaption a{font-weight:700}
</style>
