---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import OpenEvoExperimentSelector from './OpenEvoExperimentSelector.astro';
import OpenEvoStage2StrategyChooser from './OpenEvoStage2StrategyChooser.astro';
import OpenEvoCheckpointCurve from './OpenEvoCheckpointCurve.astro';
import { legacyStage2Arms } from '../../data/openEvoLegacyStage2Archive';

type Mode = '3b-self' | '7b-self' | '3b-minimax' | '7b-minimax' | 'cross-arm';
interface Props { locale: Locale; mode: Mode }
const { locale, mode } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);
const PENDING = t('尚无最终结果（对应实验仍未封口）', 'No final result yet (the corresponding run is not closed)');

const armMeta = {
  '3b-self': {
    title:t('3B · 无外部教师（self）', '3B · self only'),
    eyebrow:t('历史单实验 · 旧 Stage 2 方法控制', 'HISTORICAL ARM · OLD STAGE-2 METHOD CONTROL'),
    status:t('旧方法控制已完成；Stage 2 = 0 次更新', 'Old method-control complete; Stage 2 = 0 updates'),
    question:t('3B 只靠自己产生经验时，能不能跨过“先产生足够好经验，才能继续学”的门槛？', 'Can 3B, using only its own experience, cross the threshold required to keep learning?'),
    known:[
      t('Stage 1 共找到 4 条可用于训练的完整成功轨迹，但它们只来自 1 个能够重复成功的任务；启动训练要求至少 8 个这样的不同任务。因此 3B/self 没达到启动门槛，没有创建新的学习适配器（adapter），Stage 1 的模型参数保持初始基础模型（base）状态。', 'Stage 1 found four trainable exact-success trajectories, but they came from only one task that succeeded repeatedly; bootstrap requires at least eight such distinct tasks. 3B/self therefore did not reach the start threshold, created no learned adapter, and kept the base model parameters unchanged.'),
      t('旧 Stage 2 完成了 20,480 次任务尝试，按每 256 次尝试分成 80 批。138 次尝试是完整成功、且轨迹质量足以进入训练候选池；但最好的一批里也只有 2 个不同任务能够各自重复完整成功，而当时的规则要求至少 8 个才允许更新参数。因此 80 批数据都没有触发参数更新。这个结果只说明旧方法控制规则怎样阻断了学习，不代表当前 OpenEVO Stage 2。', 'The old Stage 2 completed 20,480 task attempts, grouped into 80 batches of 256. Of those attempts, 138 were exact successes with traces clean enough to enter the training candidate pool. Even the best batch contained only two distinct tasks that each succeeded repeatedly, while the historical rule required at least eight before a parameter update was allowed. None of the 80 batches therefore triggered an update. This documents how the old method-control blocked learning; it does not define the current OpenEVO Stage 2.'),
      t('封存的 128 任务最终评测已经存在：平均 Task Score ×100 = 1.71，完整成功 1/128，技术有效轨迹 121/128。因为这条 arm 从 Stage 1 到旧 Stage 2 都没有产生 adapter，两个 final-eval cell 与 3B base 逐项一致；这是“参数没变”的真实负结果，不是评测缺失。', 'A sealed 128-task final evaluation exists: mean Task Score ×100 = 1.71, exact success = 1/128, and valid episodes = 121/128. Because this arm created no adapter in either Stage 1 or old Stage 2, both final-evaluation cells match 3B base exactly. This is a real unchanged-parameter result, not missing evaluation.'),
    ],
    next:t('不恢复这条旧 Stage 2。保留其完整 rollout、selection、execution-state 与 base-pointer 语义，用于解释为什么旧硬门槛会阻断学习。', 'Do not resume this old Stage 2. Preserve its rollouts, selections, execution state, and base-pointer semantics to explain why the brittle gate blocked learning.'),
  },
  '7b-self': {
    title:t('7B · 无外部教师（self）', '7B · self only'),
    eyebrow:t('历史单实验 · checkpoint sweep 已完成', 'HISTORICAL ARM · CHECKPOINT SWEEP COMPLETE'),
    status:t('旧方法控制完成；Stage 2 = 0 次更新', 'Old method-control complete; Stage 2 = 0 updates'),
    question:t('7B/self 已经变好了，但它到底学到了“更会做题”，还是主要学到了“更会输出可执行动作”？', '7B/self improved, but did it learn to solve tasks better, or mostly to emit executable actions?'),
    known:[
      t('Stage 1 达到了启动门槛，并完成 8 次 SD-LoRA 参数更新。训练目标误差（loss）从 0.479 降到 0.055；它表示模型更贴合这批训练记录，但不能单独说明 WebShop 做题能力一定同步上升。', 'Stage 1 reached the bootstrap threshold and completed eight SD-LoRA parameter updates. Training loss fell from 0.479 to 0.055; this means better fit to the training records, not guaranteed step-by-step improvement on WebShop tasks.'),
      t('Stage 2 共完成 20,480 次任务尝试，其中 797 条是可用于训练的完整成功轨迹。这次历史运行采用了一条 method-control（方法控制）规则：每 256 次尝试单独检查，同一数据块里必须至少有 8 个不同任务各自重复完整成功，才允许更新参数。实际最好的一块只有 7 个，因此按照这次运行的程序，80 个数据块都没有触发 Stage-2 参数更新。这准确解释了本次运行为什么是 0 次更新，但不代表 OpenEVO 的长期 Stage 2 必须使用这条规则，也不代表模型没有产生可学习数据。', 'Stage 2 completed 20,480 task attempts, including 797 trainable exact-success trajectories. This historical run used a method-control rule: every 256-attempt block was checked separately, and at least eight distinct tasks had to achieve repeated exact success before parameters could update. The best block reached seven, so under that run’s program none of the 80 blocks triggered a Stage-2 update. This accurately explains why this run recorded zero updates; it does not establish that long-term OpenEVO Stage 2 must use this rule or that the model produced no learnable data.'),
      t('在固定的 128 个评测任务上，平均 WebShop 任务得分（Task Score ×100）从 13.33 升到 25.66；技术有效的完整轨迹从 109/128 增到 122/128，动作格式或解析失败从 19 次降到 6 次；真正完整完成任务则只从 3/128 增到 4/128。也就是说，可执行性和部分任务进展明显改善，但完整做成任务只多了 1 个。', 'On the fixed 128-task evaluation panel, mean WebShop Task Score ×100 rose from 13.33 to 25.66; technically valid episodes increased from 109/128 to 122/128 and parser/action-format failures fell from 19 to 6; fully completed tasks rose only from 3/128 to 4/128. Executability and partial progress improved clearly, while full task completion increased by only one task.'),
      t('我们把 Stage 1 每次参数更新后的模型保存点（checkpoint）都放到同一套固定 128 任务上补测。从初始基础模型（base）到第 8 次更新后的平均任务得分（Task Score ×100）依次为 13.33 → 17.13 → 18.41 → 13.67 → 17.63 → 16.51 → 22.01 → 20.72 → 25.66。训练 loss 一直下降，但评测分数中间两次回落；第 8 次更新后的保存点（increment-07）是最高点。', 'We re-evaluated every Stage-1 model checkpoint on the same fixed 128-task panel. Task Score from base through the eighth update was 13.33 → 17.13 → 18.41 → 13.67 → 17.63 → 16.51 → 22.01 → 20.72 → 25.66. Training loss fell continuously, but evaluation score regressed twice; the checkpoint after the eighth update (increment-07) is the best point.'),
    ],
    next:t('逐个训练保存点的补测已经回答了关键缺口：后期模型总体更强，最后一个保存点最好，但固定 128 任务上的能力会在某些更新后回落，因此训练 loss 不能当成“每降一点，WebShop 能力就一定升一点”的仪表。完整成功也只从 3/128 增到 4/128，所以更稳妥的解释仍是：训练明显改善了动作可执行性与部分任务进展，完整做成任务只小幅增加。', 'The checkpoint sweep closes the key gap: later models are stronger overall and the final checkpoint is best, but capability on the fixed 128 tasks regresses after some updates. Training loss therefore cannot be treated as a gauge where every decrease guarantees a WebShop capability increase. Exact success rises only from 3/128 to 4/128, so the supported interpretation remains improved executability and partial progress with only a small increase in full task completion.'),
  },
  '3b-minimax': {
    title:t('3B · MiniMax 任务后回看监督（有老师）', '3B · MiniMax hindsight analysis'),
    eyebrow:t('历史单实验 · 74.58% 时主动停止', 'HISTORICAL ARM · STOPPED AT 74.58%'),
    status:t('旧方法已停止；完成 59 批数据，第 60 批保留 171 次尚未计入完整批次的任务尝试', 'Old method stopped; 59 complete batches plus 171 attempts preserved from batch 60'),
    question:t('按旧规则每 256 次尝试单独判断时，MiniMax 启动训练后的 3B 能不能继续更新参数？', 'Could the MiniMax-bootstrapped 3B keep updating when the old rule judged each 256 attempts separately?'),
    known:[
      t('这里口头说“有老师”，更精确地说是：MiniMax 在 episode 结束后分析轨迹；它不替 3B 在 WebShop 里点击或搜索。', '“With a teacher” is shorthand here: MiniMax analyzes the trajectory after the episode; it does not click or search inside WebShop for the 3B actor.'),
      t('MiniMax 启动训练确实完成了 8 次参数更新；进入旧 Stage 2 后，前 59 批共 15,104 次任务尝试里只有 38 次是可用于训练的完整成功轨迹。最好的一批也只有 1 个不同任务能够重复完整成功，而当时要求至少 8 个才允许更新，因此 Stage 2 仍没有参数更新。停止时，第 60 批已产生的 171 次尝试原样保留，但不混入 59 批完整统计。', 'MiniMax bootstrap did complete eight parameter updates. In the old Stage 2, the first 59 complete batches contained 15,104 task attempts, of which only 38 were exact-success traces clean enough to enter training. Even the best batch had just one distinct task that succeeded repeatedly, while the historical rule required at least eight before an update was allowed. Stage 2 therefore still made no parameter update. The 171 attempts already produced in batch 60 were preserved when the run stopped, but are not mixed into the 59 complete-batch statistics.'),
      t('这条旧方法在 74.58% 时被主动停止；服务器历史归档中没有任何封存的 3B/MiniMax final-eval 产物。因此页面明确写“未运行”，不能把没有结果伪装成 0 分。', 'This old-method run was explicitly stopped at 74.58%, and the historical archive contains no sealed 3B/MiniMax final-evaluation artifact. The page therefore says “Not run”; absence of a result must not be fabricated as a score of zero.'),
    ],
    next:t('这条 run 已由用户明确停止并标记 superseded，不建议恢复。保留 74.58% 的真实产物作为旧方法控制证据与工程 smoke 资产。', 'The owner explicitly stopped and superseded this run. Resumption is not recommended; preserve the real 74.58% artifact set as old-method evidence and engineering-smoke material.'),
  },
  '7b-minimax': {
    title:t('7B · MiniMax 任务后回看监督（有老师）', '7B · MiniMax hindsight analysis'),
    eyebrow:t('历史单实验 · 旧 Stage 2 已完成', 'HISTORICAL ARM · OLD STAGE-2 COMPLETE'),
    status:t('80 批任务尝试全部完成；Stage 2 没有触发参数更新', 'All 80 attempt batches completed; Stage 2 triggered no parameter update'),
    question:t('MiniMax 启动训练后的 7B，在旧的逐批判断规则下能不能继续更新参数？', 'Could the MiniMax-bootstrapped 7B keep updating under the old batch-by-batch rule?'),
    known:[
      t('这里的 MiniMax 同样只在一次任务结束后回看并分析轨迹，不会替学生模型在 WebShop 里搜索或点击。', 'MiniMax is again a post-episode analyzer, not the WebShop actor.'),
      t('7B+MiniMax 启动训练完成了 8 次参数更新。旧 Stage 2 随后完成 20,480 次任务尝试，其中 592 次是可用于训练的完整成功轨迹。按当时规则，每 256 次尝试里至少要有 8 个不同任务各自重复完整成功才允许更新；实际最好的一批只有 7 个，所以 80 批数据都没有触发参数更新。', '7B+MiniMax bootstrap completed eight parameter updates. The old Stage 2 then completed 20,480 task attempts, including 592 exact-success traces clean enough to enter training. Under the historical rule, every 256 attempts needed at least eight distinct tasks that each succeeded repeatedly before an update was allowed. The best batch reached only seven, so none of the 80 batches triggered a parameter update.'),
      t('封存的 128 任务最终评测为 Task Score ×100 = 16.94、完整成功 0/128、技术有效轨迹 116/128。由于旧 Stage 2 从未更新参数，这个 final eval 实际评的是 MiniMax bootstrap increment-07，而不是一个不存在的“Stage-2 checkpoint”。', 'The sealed 128-task final evaluation reports Task Score ×100 = 16.94, exact success = 0/128, and valid episodes = 116/128. Because old Stage 2 never updated parameters, this final evaluation measures the MiniMax-bootstrap increment-07 state rather than a nonexistent “Stage-2 checkpoint”.'),
    ],
    next:t('旧 Stage 2 已经完整显示：在这条“每批至少 8 个重复成功任务”的历史规则下，这组实验始终没有进入参数更新。后续不再沿用这条规则扩展结论，转入 Ceiling-1.0 新策略。', 'The completed old Stage 2 shows that this arm never entered parameter updating under the historical rule requiring at least eight repeatedly successful tasks in each batch. Do not extend conclusions by continuing that rule; move the mainline to Ceiling-1.0.'),
  },
} as const;

const current = mode === 'cross-arm' ? null : armMeta[mode];
const archiveArm = mode === 'cross-arm' ? null : legacyStage2Arms.find((arm) => arm.id === mode);
const sealedFinal = archiveArm?.finalEvaluation.status === 'sealed' ? archiveArm.finalEvaluation : null;
const NOT_RUN_3B_MINIMAX = t('未运行（旧方法在 74.58% 时停止）', 'Not run (old method stopped at 74.58%)');

const experimentTerms = [
  {
    term:t('Stage 1：启动学习阶段', 'Stage 1: bootstrap-learning phase'),
    meaning:t('先用 1,440 次任务尝试建立第一批学习数据，再尝试让基础模型发生最初的参数更新。self 组从模型自己的完整成功轨迹里学习；MiniMax 组则对同一批学生轨迹增加任务后回看监督。是否真的更新参数，取决于这一阶段有没有满足启动门槛。', 'Stage 1 uses 1,440 task attempts to form the first learning set and then tries to produce the initial parameter updates from the base model. Self arms learn from the model’s own exact-success trajectories; MiniMax arms add post-task hindsight supervision over the same student trajectories. Parameter updates occur only if the bootstrap requirement is satisfied.'),
  },
  {
    term:t('历史 Stage 2：旧 256-window 方法控制', 'Historical Stage 2: old 256-window method-control'),
    meaning:t('从 Stage 1 结束时的模型继续做题，但不再由 MiniMax 提供老师监督。本次历史运行计划了 80 个数据块、每块 256 次任务尝试，并用逐块 8 任务门槛决定是否更新。这里描述的是这次实验采用的 method-control 配置，不是对 OpenEVO 长期 Stage 2 算法的通用定义。', 'The model continues attempting tasks from its post-Stage-1 state without MiniMax supervision. This historical run used 80 blocks of 256 attempts and a per-block eight-task gate. That is the method-control configuration of this run, not a general definition of the long-term OpenEVO Stage-2 algorithm.'),
  },
  {
    term:t('一次任务尝试（rollout）', 'One task attempt (rollout)'),
    meaning:t('模型从拿到一个 WebShop 任务开始，连续搜索、点击，直到成功、失败或达到 15 步上限。这是一整次做题，不是一次参数训练，也不是单个动作。', 'One complete WebShop attempt from receiving the task through search/click actions until success, failure, or the 15-step limit. It is not a parameter update and not a single action.'),
  },
  {
    term:t('可用于训练的完整成功轨迹（qualified positive）', 'Trainable exact-success trajectory (qualified positive)'),
    meaning:t('一次任务尝试（rollout）只有在任务完全成功、轨迹完整、任务身份核对正确，而且没有动作解析失败，也没有由系统兜底逻辑替代模型动作时才算。797 说的是这种成功轨迹的条数。', 'A rollout counts only when the task is fully won, the trace is complete, task identity matches, and there is no parser failure and no system-generated substitute action. The number 797 counts trajectories that pass all of these checks.'),
  },
  {
    term:t('达标任务身份（qualifying identity）', 'Qualifying task identity'),
    meaning:t('这里数的不是轨迹条数，而是“不同的任务”。同一个 256 次任务尝试的数据块里，一个任务至少要独立完整成功 2 次，才算 1 个达标任务身份；同一任务成功很多次仍只算 1 个身份。', 'This counts distinct tasks, not trajectories. Within one 256-rollout block, a task must achieve at least two independent exact successes to count as one qualifying identity; many successes on the same task still count as one identity.'),
  },
  {
    term:t('本次历史 Stage 2 的参数更新门槛（gate）', 'Historical Stage-2 parameter-update gate'),
    meaning:t('本次历史运行每收集 256 次任务尝试就检查一次：只有这一块里至少有 8 个达标任务身份才允许更新；不足 8 个时模型权重保持不变，且程序不跨块累计。这是当时预先采用的方法控制规则。它可以解释本次运行的 0 次更新，但不能被推广成 OpenEVO 长期 Stage 2 的必然清空条件。', 'This historical run checked after every 256 rollouts: updates were allowed only when that block contained at least eight qualifying task identities, and the program did not pool successes across blocks. This was the preregistered method-control rule for that run. It explains the observed zero updates but must not be generalized into a necessary reset rule for long-term OpenEVO Stage 2.'),
  },
  {
    term:t('启动训练（bootstrap）', 'Bootstrap training'),
    meaning:t('Stage 1 先让基础模型自己做题并收集经验；当成功经验达到门槛后，才进行本实验的第一轮参数学习。页面里的 bootstrap 指“从基础模型进入已学习状态”的首次启动更新，不是重新下载或重新初始化模型。', 'Stage 1 first lets the base model attempt tasks and collect experience. Only after enough successful experience is available does the experiment perform its first parameter learning. Here, bootstrap means the initial transition from the base model to a learned state, not redownloading or reinitializing the model.'),
  },
  {
    term:t('参数更新与学习适配器（adapter）', 'Parameter update and learned adapter'),
    meaning:t('真正“学了一次”意味着 SD-LoRA 的附加参数被优化并保存成新的 adapter。页面写“0 次 Stage-2 参数更新”时，意思是 Stage 2 做了探索和数据采集，但没有改动 Stage 1 留下的模型参数；不等于实验没跑，也不等于没有成功数据。', 'A real learning update means SD-LoRA auxiliary parameters were optimized and saved into a new adapter. “0 Stage-2 parameter updates” means Stage 2 collected experience without changing the Stage-1 model parameters; it does not mean the experiment failed to run or produced no successful data.'),
  },
  {
    term:t('Task Score、完整成功与技术有效性', 'Task Score, exact success, and technical validity'),
    meaning:t('Task Score ×100 是 128 个任务的平均 WebShop 得分，可包含部分任务进展；完整成功（Exact Success）只数真正完成整个任务；技术有效轨迹（Valid Episode）只说明输出能被环境正确执行，不保证任务成功。三者必须分开看。', 'Task Score ×100 is the mean WebShop score over 128 tasks and can include partial progress; Exact Success counts only fully completed tasks; a Valid Episode means the output could be executed correctly by the environment, not that the task was solved. These three must be interpreted separately.'),
  },
];

const sevenBStage2Flow = [
  { n:'20,480', title:t('次 Stage-2 任务尝试', 'Stage-2 task attempts'), text:t('80 个数据块 × 每块 256 次任务尝试。这里是经验采集量，不是 20,480 次训练。', '80 blocks × 256 rollouts. This is experience-collection volume, not 20,480 training updates.') },
  { n:'797', title:t('条合格成功轨迹', 'trainable exact-success trajectories'), text:t('它们都满足完整成功和技术有效条件。它们证明这次运行产生了可学习数据；是否以及怎样跨窗口使用这些数据，是尚未解决的算法设计问题。', 'They all pass exact-success and technical-validity checks and show that this run produced learnable data. Whether and how to use it across windows remains an unresolved algorithm-design question.') },
  { n:'8', title:t('个达标任务身份才允许更新', 'qualifying task identities required'), text:t('同一个 256 次任务尝试的数据块内，每个身份还必须至少独立成功 2 次。这个 8 是“不同任务数门槛”，不是 8 分，也不是要 8 条轨迹。', 'Within the same 256-rollout block, each identity must also succeed independently at least twice. The 8 is a threshold on distinct tasks, not a score of 8 and not eight trajectories.') },
  { n:'7', title:t('是实际单块最高值', 'was the best block observed'), text:t('最好的一块也只覆盖 7 个达标任务身份，离门槛差 1 个；其余数据块更低。', 'Even the best block covered only seven qualifying task identities, one short of the threshold; every other block was lower.') },
  { n:'0', title:t('次 Stage-2 参数更新', 'Stage-2 parameter updates'), text:t('按这次历史 method-control 规则，80 个数据块都没有达到单块 8 任务门槛，因此程序从未改动参数；最终评测继续使用 Stage 1 的适配器。这是旧配置的运行结果，不是合理 Stage 2 训练后的能力上限。', 'Under this historical method-control rule, none of the 80 blocks reached the per-block threshold, so parameters never changed and final evaluation used the Stage-1 adapter. This is the outcome of the old configuration, not a capability ceiling after a well-designed Stage 2.') },
];

const individualMetrics = [
  {
    metric:t('最终平均任务得分（Task Score ×100）', 'Final mean Task Score ×100'),
    value:sealedFinal ? sealedFinal.taskScoreX100!.toFixed(2) : (mode === '3b-minimax' ? NOT_RUN_3B_MINIMAX : PENDING),
    note:sealedFinal ? t('来自同一套封存 128 任务 final eval；这是历史旧方法结果', 'From the same sealed 128-task final evaluation; this is a historical old-method result') : t('旧方法被停止后没有封存 final eval，不能把缺失写成 0 分', 'No sealed final evaluation exists after the old method was stopped; absence must not be reported as zero'),
  },
  {
    metric:t('完整成功（Exact Success）', 'Exact Success (full task completion)'),
    value:sealedFinal ? sealedFinal.exactSuccess! : (mode === '3b-minimax' ? NOT_RUN_3B_MINIMAX : PENDING),
    note:t('和 Task Score 分开解释', 'Interpret separately from Task Score'),
  },
  {
    metric:t('技术有效轨迹（Valid Episode）', 'Technically valid episodes'),
    value:sealedFinal ? sealedFinal.validEpisodes! : (mode === '3b-minimax' ? NOT_RUN_3B_MINIMAX : PENDING),
    note:t('用于区分“更会说合法动作”和“更会完成任务”', 'Separates valid action production from task completion'),
  },
  {
    metric:t('Stage-2 最终参数更新数', 'Final Stage-2 optimizer updates'),
    value:archiveArm ? String(archiveArm.stage2Updates) : PENDING,
    note:archiveArm ? (mode === '3b-minimax' ? t('截至 74.58% 主动停止时仍为 0；这是历史 stop state，不伪装成完整 80-block 结果', 'Still zero when explicitly stopped at 74.58%; this is a historical stop state, not a fabricated 80-block completion') : t('该历史臂已经封口；Stage 2 没有产生新 adapter bytes', 'This historical arm is closed; Stage 2 created no new adapter bytes')) : PENDING,
  },
  {
    metric:t('每次 Stage-1 参数更新后的能力', 'Capability after each Stage-1 parameter update'),
    value:mode === '7b-self'
      ? t('13.33 → 17.13 → 18.41 → 13.67 → 17.63 → 16.51 → 22.01 → 20.72 → 25.66', '13.33 → 17.13 → 18.41 → 13.67 → 17.63 → 16.51 → 22.01 → 20.72 → 25.66')
      : mode === '3b-self'
        ? t('不适用：Stage 1 没有参数更新，模型保持 base', 'Not applicable: Stage 1 made no parameter update and the model stayed at base')
        : mode === '7b-minimax'
          ? t('未做完整 checkpoint sweep；已封存最终点 16.94', 'No full checkpoint sweep; sealed final endpoint is 16.94')
          : t('未做完整 sweep；旧方法在 74.58% 时停止', 'No full sweep; old method stopped at 74.58%'),
    note:mode === '7b-self' ? t('同一套固定 128 任务；中间会回落，第 8 次更新后的保存点最高', 'Same fixed 128 tasks; performance regresses between some updates, and the checkpoint after update eight is best') : t('不把未执行的诊断继续写成 Pending 承诺', 'Do not turn an unperformed historical diagnostic into an open-ended Pending promise'),
  },
  {
    metric:t('单实验最终解释', 'Final single-arm interpretation'),
    value:mode === '7b-self'
      ? t('训练 loss 下降不等于做题能力逐步上升；收益主要落在可执行性与部分任务进展，完整成功只增加 1 个任务', 'Lower training loss did not mean step-by-step capability gains; most improvement is in executability and partial progress, while exact success increased by only one task')
      : mode === '3b-self'
        ? t('最终评测与 3B base 一致：这条历史路径没有发生参数学习', 'Final evaluation matches 3B base: this historical path made no parameter-learning change')
        : mode === '7b-minimax'
          ? t('最终 16.94 / 0 个完整成功；旧 Stage 2 没有再改参数，所以它评的是 MiniMax bootstrap adapter，而不是 Stage-2 学习后的模型', 'Final score is 16.94 with zero exact successes; old Stage 2 made no further parameter change, so this evaluates the MiniMax-bootstrap adapter rather than a model learned in Stage 2')
          : t('没有 final eval：旧方法在 74.58% 时停止，不能给最终分数', 'No final evaluation: the old method stopped at 74.58%, so no final score can be reported'),
    note:t('必须同时看 Task Score、exact success、validity 和机制证据', 'Requires Task Score, exact success, validity, and mechanism evidence together'),
  },
];

const matrixRows = [
  { label:t('Stage 1 启动训练', 'Stage-1 bootstrap'), a:t('0 次参数更新；未创建学习适配器（启动门槛未达到）', '0 parameter updates; no learned adapter was created because the bootstrap threshold was not reached'), b:t('8 次参数更新', '8 parameter updates'), c:t('8 次参数更新', '8 parameter updates'), d:t('8 次参数更新', '8 parameter updates') },
  { label:t('最终 Task Score', 'Final Task Score'), a:'1.71', b:'25.66', c:NOT_RUN_3B_MINIMAX, d:'16.94' },
  { label:t('完整成功（Exact Success）', 'Exact Success (full task completion)'), a:'1 / 128', b:'4 / 128', c:NOT_RUN_3B_MINIMAX, d:'0 / 128' },
  { label:t('旧 Stage 2 实际参数更新次数', 'Actual old Stage-2 parameter updates'), a:t('0（80/80 block）','0 (80/80 blocks)'), b:t('0（80/80 block）', '0 (80/80 blocks)'), c:t('0（59 个完整 block；随后停止）','0 (59 complete blocks; then stopped)'), d:t('0（80/80 block）','0 (80/80 blocks)') },
  { label:t('技术有效轨迹（Valid Episode）', 'Technically valid episodes'), a:'121 / 128', b:'122 / 128', c:NOT_RUN_3B_MINIMAX, d:'116 / 128' },
  { label:t('各训练保存点的评测能力', 'Evaluation capability at each training checkpoint'), a:t('最终参数仍是 base；final eval 与 3B base 一致', 'Final parameters remain base; final evaluation matches 3B base'), b:t('已完成；中间有回落；最后一个保存点 25.66 最高', 'Complete; performance regresses between some updates; final checkpoint is best at 25.66'), c:NOT_RUN_3B_MINIMAX, d:t('最终评测已封存；未做完整 checkpoint sweep', 'Final evaluation sealed; no full checkpoint sweep') },
];

const sevenBSelfCheckpointCurve = [
  { label:'base', loss:'—', rank:'0', score:'13.33', exact:'3 / 128', valid:'109 / 128', failures:'19' },
  { label:'increment-00', loss:'0.479', rank:'4', score:'17.13', exact:'3 / 128', valid:'114 / 128', failures:'14' },
  { label:'increment-01', loss:'0.301', rank:'8', score:'18.41', exact:'1 / 128', valid:'117 / 128', failures:'11' },
  { label:'increment-02', loss:'0.196', rank:'12', score:'13.67', exact:'3 / 128', valid:'116 / 128', failures:'12' },
  { label:'increment-03', loss:'0.179', rank:'16', score:'17.63', exact:'3 / 128', valid:'115 / 128', failures:'13' },
  { label:'increment-04', loss:'0.129', rank:'20', score:'16.51', exact:'3 / 128', valid:'119 / 128', failures:'9' },
  { label:'increment-05', loss:'0.070', rank:'24', score:'22.01', exact:'4 / 128', valid:'114 / 128', failures:'14' },
  { label:'increment-06', loss:'0.066', rank:'28', score:'20.72', exact:'3 / 128', valid:'118 / 128', failures:'10' },
  { label:'increment-07', loss:'0.055', rank:'32', score:'25.66', exact:'4 / 128', valid:'122 / 128', failures:'6' },
];

const contrasts = [
  { id:'C1', title:t('3B：有老师 vs 没老师', '3B: MiniMax vs self'), formula:'3B/MiniMax − 3B/self', answer:t('这条历史四臂实验不能给完整最终差：3B/MiniMax 在 74.58% 时停止且没有 final eval。我们不会为了补表而恢复已经被判定设计错误的 Stage 2。', 'This historical four-arm study cannot provide a complete final difference: 3B/MiniMax stopped at 74.58% and has no final evaluation. We will not resume the superseded Stage-2 design merely to fill the table.'), need:t('若未来仍要回答，需要单独 preregister 新实验；不能事后补跑旧错误算法', 'A future answer requires a separately preregistered study; the superseded algorithm must not be backfilled post hoc') },
  { id:'C2', title:t('7B：有老师 vs 没老师', '7B: MiniMax vs self'), formula:'7B/MiniMax − 7B/self', answer:t('同一封存 128 任务上，Task Score ×100 为 16.94 vs 25.66，均值差 −8.72；完整成功 0/128 vs 4/128。这里只是历史两臂结果差，不把它直接写成 MiniMax 的因果效应。', 'On the same sealed 128 tasks, Task Score ×100 is 16.94 vs 25.66, a mean difference of −8.72; exact success is 0/128 vs 4/128. This is a difference between two historical arms, not a direct causal estimate of MiniMax.'), need:t('如要做机制归因，仍需逐题配对和训练路径分解', 'Mechanism attribution still requires per-task pairing and training-path decomposition') },
  { id:'C3', title:t('没老师：7B vs 3B', 'Self only: 7B vs 3B'), formula:'7B/self − 3B/self', answer:t('同一封存 128 任务上，Task Score ×100 为 25.66 vs 1.71，均值差 +23.95；但模型大小与 Stage-1 是否形成 adapter 同时变化，不能把差值当作纯规模效应。', 'On the same sealed 128 tasks, Task Score ×100 is 25.66 vs 1.71, a mean difference of +23.95; model size and whether Stage 1 created an adapter change together, so this is not a pure scaling effect.'), need:t('机制归因仍需控制 Stage-1 学习状态与逐题差异', 'Mechanism attribution still requires controlling Stage-1 learning state and per-task differences') },
  { id:'C4', title:t('有老师：7B vs 3B', 'MiniMax: 7B vs 3B'), formula:'7B/MiniMax − 3B/MiniMax', answer:t('7B/MiniMax 有封存 final eval，但 3B/MiniMax 没有，因此历史旧方法不能形成完整模型大小比较。', '7B/MiniMax has a sealed final evaluation but 3B/MiniMax does not, so the historical old-method study cannot form a complete model-size comparison.'), need:t('需要新的预注册实验，而不是恢复 superseded Stage 2', 'Requires a new preregistered study rather than resuming superseded Stage 2') },
  { id:'C5', title:t('模型大小会不会改变 MiniMax 回看监督的收益幅度？', 'Does model size change the size of the MiniMax-hindsight benefit?'), formula:'(7B/MiniMax−7B/self) − (3B/MiniMax−3B/self)', answer:t('当前历史数据不能计算这个四臂交互项，因为 3B/MiniMax 没有 final eval。把缺失填成 0 会制造假结论。', 'The historical data cannot compute this four-arm interaction because 3B/MiniMax has no final evaluation. Treating the missing endpoint as zero would fabricate a conclusion.'), need:t('需要四臂都完整的新预注册设计', 'Requires a new preregistered design with all four endpoints') },
  { id:'C6', title:t('差异发生在机制链哪一段？', 'Where does the difference arise in the mechanism chain?'), formula:t('启动训练 → Stage 2 成功任务覆盖 → 参数更新 → 最终评测', 'bootstrap → Stage-2 successful-task coverage → parameter update → final evaluation'), answer:t('历史过程证据可做 matched-prefix 诊断，但由于 3B/MiniMax 提前停止，只能支持过程分析，不能补成完整四臂最终因果链。', 'Historical process evidence can support matched-prefix diagnostics, but because 3B/MiniMax stopped early it cannot be promoted into a complete four-arm final causal chain.'), need:t('把过程诊断与新 Ceiling 主实验分开报告', 'Report process diagnostics separately from the new Ceiling mainline') },
];
---

<main class="exp-scaffold" data-testid={`experiment-results-scaffold-${mode}`}>
  <OpenEvoStage2StrategyChooser locale={locale} active="legacy" />
  <aside class="exp-scaffold__legacy-warning" data-testid="legacy-stage2-warning">
    <strong>{t('历史方法控制 · 已取代', 'HISTORICAL METHOD CONTROL · SUPERSEDED')}</strong>
    <p>{t('这里保留旧实验的真实结果与模型保存点诊断。那次实验每收集 256 次任务尝试，就要求至少 8 个不同任务各自完整成功 2 次，才允许更新参数。这条历史规则不再代表当前 OpenEVO Stage 2；当前主线请看 OpenEVO-Ceiling-1.0。', 'This section preserves the real results and checkpoint diagnostics from the old experiment. That run checked every 256 task attempts and allowed a parameter update only when at least eight distinct tasks had each achieved exact success twice. This historical rule no longer represents the current OpenEVO Stage 2; see OpenEVO-Ceiling-1.0 for the current mainline.')}</p>
  </aside>
  <OpenEvoExperimentSelector locale={locale} mode={mode} />

  <header class="exp-scaffold__hero">
    <div class="exp-scaffold__hero-copy">
      <p class="exp-scaffold__eyebrow">{t('OpenEvo 基础能力探索实验', 'OPENEVO CAPABILITY EXPLORATION')} · {mode === 'cross-arm' ? t('组间实验', 'CROSS-ARM ANALYSIS') : current?.eyebrow}</p>
      <h1>{mode === 'cross-arm' ? t('四组实验：先把所有比较问题摆好，再等数字回来', 'Four arms: pre-build every comparison, then fill the evidence') : current?.title}</h1>
      <p class="exp-scaffold__lead">{mode === 'cross-arm'
        ? t('四个 arm 是 3B/self、7B/self、3B/MiniMax、7B/MiniMax。现在先固定“以后要比较什么、用什么证据、哪些格子还不能填”，避免实验跑完后再临时挑指标。', 'The four arms are 3B/self, 7B/self, 3B/MiniMax, and 7B/MiniMax. We fix the comparisons, evidence, and still-empty cells now so metrics are not chosen opportunistically after the runs finish.')
        : current?.question}</p>
    </div>
    <div class="exp-scaffold__status" aria-label={t('当前状态', 'Current status')}>
      <span>{t('当前状态', 'STATUS')}</span>
      <strong>{mode === 'cross-arm' ? t('等待四组结果齐全', 'Waiting for all four arms') : current?.status}</strong>
      <small>{mode === '7b-self' ? t('训练保存点补测完成：2026-08-29', 'Checkpoint sweep completed: 2026-08-29') : t('页面骨架冻结：2026-08-29', 'Page scaffold frozen: 2026-08-29')}</small>
    </div>
  </header>

  {mode === '7b-self' && (
    <section class="exp-scaffold__resource-summary" aria-labelledby="resource-summary-title">
      <div class="exp-scaffold__resource-heading">
        <p class="exp-scaffold__section-kicker">{t('实验资源与耗时', 'RESOURCE FOOTPRINT')}</p>
        <h2 id="resource-summary-title">{t('这次 7B/self 跑了多久？', 'How long did this 7B/self run take?')}</h2>
        <p>{t('正式主实验始终使用两张 RTX 5090 并行。下面先报真实墙钟时间，再给出等价 GPU·小时；两张卡同时跑 1 小时，墙钟时间仍然只算 1 小时。', 'The formal main run used two RTX 5090 GPUs in parallel throughout. We report real wall-clock time first, then equivalent GPU-hours; when two GPUs run together for one hour, wall time is still one hour.')}</p>
      </div>
      <dl class="exp-scaffold__resource-grid">
        <div>
          <dt>{t('GPU', 'GPU')}</dt>
          <dd>2 × RTX 5090</dd>
          <small>{t('两张卡全程并行', 'two GPUs in parallel')}</small>
        </div>
        <div>
          <dt>{t('Stage 1', 'Stage 1')}</dt>
          <dd>{t('约 7 小时 24 分', '~7 h 24 min')}</dd>
          <small>{t('1,440 次 rollout + 8 次参数更新', '1,440 rollouts + 8 parameter updates')}</small>
        </div>
        <div>
          <dt>{t('Stage 2', 'Stage 2')}</dt>
          <dd>{t('约 29 小时 19 分', '~29 h 19 min')}</dd>
          <small>{t('80 × 256 = 20,480 次 rollout', '80 × 256 = 20,480 rollouts')}</small>
        </div>
        <div class="exp-scaffold__resource-total">
          <dt>{t('主实验合计', 'Main-run total')}</dt>
          <dd>{t('约 36 小时 44 分', '~36 h 44 min')}</dd>
          <small>{t('≈ 73.5 GPU·小时', '≈ 73.5 GPU-hours')}</small>
        </div>
      </dl>
      <p class="exp-scaffold__resource-note">{t('口径：按正式运行产物时间戳计算，Stage 1 为约 7:24，Stage 2 为约 29:19，两阶段首尾连续约 36:44。这里不包含之后的固定 128 任务最终评测，也不包含单独进行的 checkpoint sweep（该补测约 80.2 分钟）。', 'Measurement: derived from timestamps of the sealed formal-run artifacts. Stage 1 is ~7:24, Stage 2 is ~29:19, and the two stages span ~36:44 continuously. This excludes the later fixed-128 final evaluation and the separate checkpoint sweep (~80.2 minutes).')}</p>
    </section>
  )}

  <section class="exp-scaffold__section exp-scaffold__counting" aria-labelledby="counting-title">
    <p class="exp-scaffold__section-kicker">{t('实验计数规则', 'EXPERIMENT COUNTING RULES')}</p>
    <h2 id="counting-title">{t('旧 Stage 2 参数更新门槛（已取代）', 'Old Stage-2 parameter-update rule (superseded)')}</h2>
    <p class="exp-scaffold__section-intro">{t('这里最容易误读的地方是："跑了多少次任务"、"收集到多少条成功轨迹"和"模型真的更新了多少次参数"是三件不同的事。下面这些定义就是本组结果页后续数字的统一口径。', 'The key distinction is that task attempts, successful trajectories, and actual model-parameter updates are three different quantities. These definitions are the common counting contract for the result pages in this series.')}</p>
    <dl class="exp-scaffold__term-list">
      {experimentTerms.map((item) => <div><dt>{item.term}</dt><dd>{item.meaning}</dd></div>)}
    </dl>

    {mode === '7b-self' && (
      <figure class="exp-scaffold__gate-figure" aria-labelledby="gate-flow-title">
        <figcaption id="gate-flow-title">{t('7B/self 历史运行：为什么当时的 20,480 次尝试是 0 次参数更新', 'Historical 7B/self run: why its 20,480 attempts led to zero parameter updates')}</figcaption>
        <ol class="exp-scaffold__gate-flow">
          {sevenBStage2Flow.map((step) => <li>
            <span class="exp-scaffold__gate-number">{step.n}</span>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </li>)}
        </ol>
        <p class="exp-scaffold__gate-conclusion">{t('所以这里的 "7" 和 "8" 都不是模型分数：它们数的是这次历史 method-control 在同一个 256 次尝试数据块里看到的重复成功任务数。7 < 8 准确解释了当时程序为什么没有更新；它不能证明长期 Stage 2 应该逐块清零，也不能把 797 条合格成功轨迹说成没有可学习数据。', 'The “7” and “8” are not model scores. They are counts used by this historical method-control inside one 256-attempt block. 7 < 8 accurately explains why that program did not update; it does not prove that long-term Stage 2 should reset every block or that 797 qualifying trajectories were not learnable data.')}</p>
      </figure>
    )}
  </section>

  {mode !== 'cross-arm' && current && (
    <>
      <section class="exp-scaffold__section exp-scaffold__two-col" aria-labelledby="known-title">
        <div>
          <p class="exp-scaffold__section-kicker">{t('先说已经知道的', 'WHAT WE ALREADY KNOW')}</p>
          <h2 id="known-title">{t('已有证据', 'Existing evidence')}</h2>
          <div class="exp-scaffold__known">
            {current.known.map((item, i) => <article><span>{String(i + 1).padStart(2,'0')}</span><p>{item}</p></article>)}
          </div>
        </div>
        <aside class="exp-scaffold__pending-callout">
          <span>{mode === '7b-self' ? t('GPU 缺口已经补齐', 'GPU GAP CLOSED') : t('还不能回答', 'STILL UNKNOWN')}</span>
          <h3>{mode === '7b-self' ? t('现在可以给出单实验解释', 'A single-arm interpretation is now supported') : t('最终解释先留空', 'Keep the final interpretation empty')}</h3>
          <p>{current.next}</p>
          <div class="exp-scaffold__pending-chip">{mode === '7b-self' ? t('训练保存点分析：完成', 'Checkpoint analysis: complete') : t('结论：等待证据', 'Conclusion: pending evidence')}</div>
        </aside>
      </section>

      <section class="exp-scaffold__section" aria-labelledby="slots-title">
        <p class="exp-scaffold__section-kicker">{mode === '7b-self' ? t('已封存的正式结果已经回填', 'SEALED RESULTS FILLED') : t('服务器跑完后直接填这里', 'FILL THESE SLOTS WHEN EVIDENCE FILES ARRIVE')}</p>
        <h2 id="slots-title">{t('结果槽位', 'Result slots')}</h2>
        <div class="exp-scaffold__table-wrap">
          <table>
            <thead><tr><th>{t('指标 / 问题', 'Metric / question')}</th><th>{t('当前值', 'Current value')}</th><th>{t('解释边界', 'Interpretation boundary')}</th></tr></thead>
            <tbody>
              {individualMetrics.map((row) => <tr><th scope="row">{row.metric}</th><td class:list={{pending:row.value === PENDING}}>{row.value}</td><td>{row.note}</td></tr>)}
            </tbody>
          </table>
        </div>
      </section>

      {mode === '7b-self' && (
        <section class="exp-scaffold__section" aria-labelledby="checkpoint-curve-title">
          <p class="exp-scaffold__section-kicker">{t('GPU checkpoint sweep · COMPLETE', 'GPU CHECKPOINT SWEEP · COMPLETE')}</p>
          <h2 id="checkpoint-curve-title">{t('Stage 1 的 8 次参数更新期间，做题能力不是直线上升', 'Capability did not rise in a straight line across the eight Stage-1 updates')}</h2>
          <p class="exp-scaffold__section-intro">{t('7 个中间训练保存点，加上初始基础模型和最后一个训练保存点，都使用同一套已封存的 128 个 WebShop 任务进行评测；采样温度（temperature）固定为 0、每题最多 15 步，提示词和动作格式规则也完全相同。训练 loss 从 0.479 连续降到 0.055，但平均任务得分中间多次回落；第 8 次更新后的保存点（increment-07）得分 25.66，是 9 个评测点里的最高值。', 'The seven intermediate checkpoints and the existing base/final endpoints use the same sealed 128-task WebShop panel, temperature=0, 15-step limit, and the same prompt/action contracts. Loss falls continuously from 0.479 to 0.055, yet Task Score regresses several times; increment-07 at 25.66 is the best of all nine points.')}</p>
          <OpenEvoCheckpointCurve locale={locale} rows={sevenBSelfCheckpointCurve} />
          <div class="exp-scaffold__table-wrap">
            <table class="checkpoint-table">
              <thead><tr><th>{t('训练保存点', 'Training checkpoint')}</th><th>{t('训练目标误差（loss）', 'Training loss')}</th><th>{t('SD-LoRA 有效 rank（技术参数）', 'SD-LoRA effective rank')}</th><th>{t('任务得分（Task Score ×100）', 'Task Score ×100')}</th><th>{t('完整成功', 'Exact success')}</th><th>{t('技术有效轨迹', 'Valid episodes')}</th><th>{t('动作格式 / 解析失败', 'Parser / action failures')}</th></tr></thead>
              <tbody>{sevenBSelfCheckpointCurve.map((row) => <tr class:list={{best:row.label === 'increment-07'}}><th scope="row">{row.label}</th><td>{row.loss}</td><td>{row.rank}</td><td><strong>{row.score}</strong></td><td>{row.exact}</td><td>{row.valid}</td><td>{row.failures}</td></tr>)}</tbody>
            </table>
          </div>
          <div class="exp-scaffold__checkpoint-reading">
            <article><span>01</span><strong>{t('loss 是训练信号，不是能力仪表盘', 'Loss is a training signal, not a capability gauge')}</strong><p>{t('第 2 次更新后的保存点（increment-01）到第 3 次（increment-02）时，平均任务得分从 18.41 降到 13.67；第 6 次（increment-05）到第 7 次（increment-06）时又从 22.01 降到 20.72。这两段里训练 loss 都继续下降。', 'Task Score falls 18.41 → 13.67 from increment-01 → 02 and 22.01 → 20.72 from increment-05 → 06 even while loss keeps falling.')}</p></article>
            <article><span>02</span><strong>{t('后期训练总体仍然有收益', 'Later training still helps overall')}</strong><p>{t('第 8 次更新后的最后一个保存点（increment-07）达到全程最高 25.66；128 个任务里技术有效轨迹增至 122 个，动作格式或解析失败降到 6 次。', 'Final increment-07 reaches the sweep high of 25.66, with 122/128 valid episodes and only 6 parser/action failures.')}</p></article>
            <article><span>03</span><strong>{t('完整成功仍是薄弱环节', 'Exact completion remains the weak point')}</strong><p>{t('完整成功（Exact Success）从初始基础模型的 3/128 只增加到最后保存点的 4/128，中间各保存点也只在 1–4 个之间波动；因此不能把平均任务得分接近翻倍理解成“完整做成任务的能力也翻倍”。', 'Exact success moves only from 3/128 at base to 4/128 at final and fluctuates between 1 and 4 in between, so the near-doubling of Task Score must not be read as a doubling of full task completion.')}</p></article>
          </div>
          <p class="exp-scaffold__provenance-note">{t('证据状态：训练保存点补测已完成。我们新增评测了 7 个中间保存点，并复用已有的初始基础模型与第 8 次更新后的保存点，共得到 9 个可比点；实际总运行时间为 4,813.6 秒（约 80.2 分钟）。这属于事后诊断（post-hoc diagnostic）：因为同一套 128 个任务已经被用来观察中间保存点，后续若要据此挑选模型，应改用另一套独立诊断任务，或在看结果前先固定选择规则。', 'Evidence status: checkpoint sweep COMPLETE; seven intermediate checkpoints were added while reusing the existing base and increment-07 endpoints. Total wall time was 4,813.6 seconds (~80.2 minutes). This is a post-hoc diagnostic; because the same 128-task panel has now been inspected across intermediate checkpoints, future model selection should use a separate diagnostic panel or freeze selection rules in advance.')}</p>
        </section>
      )}

      <section class="exp-scaffold__section" aria-labelledby="pipeline-title">
        <p class="exp-scaffold__section-kicker">{t('不要把不同阶段混成一个分数', 'KEEP STAGES SEPARATE')}</p>
        <h2 id="pipeline-title">{t('这页最后要解释的机制链', 'Mechanism chain this page must explain')}</h2>
        <ol class="exp-scaffold__pipeline">
          <li><span>01</span><strong>{t('Stage 1 / 启动训练', 'Stage 1 / bootstrap')}</strong><p>{t('有没有形成可训练数据？真正发生了多少次参数更新？', 'Did trainable experience form, and how many parameter updates actually happened?')}</p></li>
          <li><span>02</span><strong>{t('Stage 2 / 模型自主探索', 'Stage 2 / self-exploration')}</strong><p>{t('模型自己探索时，每 256 次尝试里是否出现至少 8 个能够各自重复完整成功的不同任务，从而允许下一次参数更新？', 'During self-exploration, does each 256-attempt block contain at least eight distinct tasks with repeated exact success, allowing the next parameter update?')}</p></li>
          <li><span>03</span><strong>{t('最终评测', 'Final evaluation')}</strong><p>{t('平均任务得分、完整成功数和技术有效轨迹数必须分开看，不能把它们压成一个总分。', 'Mean task score, exact-success count, and technically valid episode count must be interpreted separately rather than collapsed into one headline number.')}</p></li>
          <li><span>04</span><strong>{t('训练保存点分析', 'Checkpoint analysis')}</strong><p>{mode === '7b-self' ? t('已完成：训练 loss 持续下降，但固定 128 任务上的得分会中途回落；最后一个保存点最好。', 'Complete: training loss fell continuously, but score on the fixed 128 tasks regressed between some updates; the final checkpoint is best.') : t('训练 loss 下降是否真的对应固定 WebShop 评测任务上的能力上升？', 'Does lower training loss actually correspond to stronger capability on the fixed WebShop evaluation tasks?')}</p></li>
          <li><span>05</span><strong>{t('最终解释', 'Final interpretation')}</strong><p>{t('只有前四步证据齐全后，才回答“为什么变好 / 为什么没继续学 / 下一步改哪里”。', 'Only after the first four steps are grounded do we answer why it improved, why learning stalled, and what should change next.')}</p></li>
        </ol>
      </section>
    </>
  )}

  {mode === 'cross-arm' && (
    <>
      <section class="exp-scaffold__section" aria-labelledby="matrix-title">
        <p class="exp-scaffold__section-kicker">{t('同一张表，不偷换口径', 'ONE TABLE, ONE MEASUREMENT CONTRACT')}</p>
        <h2 id="matrix-title">{t('四组结果矩阵', 'Four-arm result matrix')}</h2>
        <p class="exp-scaffold__section-intro">{t('现在 3B/self、7B/self、7B/MiniMax 都已有同一套封存 128 任务的真实最终数字；3B/MiniMax 因旧方法在 74.58% 时主动停止而没有 final eval，明确写“未运行”而不是 0。任何后续补测都必须清楚标注是否仍是同一套正式 panel。', '3B/self, 7B/self, and 7B/MiniMax now carry real final numbers from the same sealed 128-task panel. 3B/MiniMax has no final evaluation because the old-method run was explicitly stopped at 74.58%, so it is marked Not run rather than zero. Any later diagnostic must state whether it uses the same formal panel.')}</p>
        <div class="exp-scaffold__table-wrap">
          <table>
            <thead><tr><th>{t('指标', 'Metric')}</th><th>3B / self</th><th>7B / self</th><th>3B / MiniMax</th><th>7B / MiniMax</th></tr></thead>
            <tbody>
              {matrixRows.map((row) => <tr><th scope="row">{row.label}</th>{[row.a,row.b,row.c,row.d].map((v) => <td class:list={{pending:v === PENDING}}>{v}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
      </section>

      <section class="exp-scaffold__section" aria-labelledby="contrast-title">
        <p class="exp-scaffold__section-kicker">{t('组间实验已经预注册成问题', 'CROSS-ARM QUESTIONS ARE PRE-SPECIFIED')}</p>
        <h2 id="contrast-title">{t('六个组间比较槽位', 'Six cross-arm comparison slots')}</h2>
        <div class="exp-scaffold__contrast-grid">
          {contrasts.map((row) => <article>
            <div class="exp-scaffold__contrast-head"><span>{row.id}</span><h3>{row.title}</h3></div>
            <code>{row.formula}</code>
            <dl><div><dt>{t('答案', 'Answer')}</dt><dd class="pending">{row.answer}</dd></div><div><dt>{t('还缺什么', 'Missing evidence')}</dt><dd>{row.need}</dd></div></dl>
          </article>)}
        </div>
      </section>

      <section class="exp-scaffold__section exp-scaffold__guardrail" aria-labelledby="guardrail-title">
        <p class="exp-scaffold__section-kicker">{t('回填规则', 'FILL-IN RULES')}</p>
        <h2 id="guardrail-title">{t('服务器跑完后，也不能直接把四组最终分数做简单减法', 'Even after completion, do not just subtract four headline scores')}</h2>
        <ul>
          <li>{t('同一模型规模内比较 MiniMax 与 self，才回答“MiniMax 的任务后回看监督 + 启动训练这一整套处理是否有帮助”。', 'Compare MiniMax vs self within the same model size to ask whether the external-hindsight bundle helps.')}</li>
          <li>{t('在相同实验处理方式下比较 7B 与 3B，才回答“模型规模是否改变可学习性”。', 'Compare 7B vs 3B within the same treatment to ask whether scale changes learnability.')}</li>
          <li>{t('MiniMax 这一实验处理不只是“老师名字不同”：它改变了启动训练阶段使用的监督内容和样本选择方式，因此不能把最终差值简单解释成“只因为老师换成了 MiniMax”。', 'The MiniMax treatment changes the bootstrap supervision path, not merely a teacher name, so the contrast must not be called a pure teacher causal effect.')}</li>
          <li>{t('优先逐题比较同一个任务在两组里的变化，再看总体均值；平均任务得分、完整成功、技术有效性和 Stage 2 参数更新门槛必须同时报告。', 'Prefer same-task paired decomposition before mean-only summaries; report mean task score, exact success, technical validity, and the Stage-2 parameter-update threshold together.')}</li>
          <li>{t('任何“尚无最终结果”的格子，都只能用已经封存的实验产物或正式收尾记录里的真实结果替换；不得用预计完成时间、训练中快照或估算数字冒充最终结果。', 'A not-yet-final cell may only be replaced by a real result from sealed experiment outputs or formal closeout records; estimated completion times, in-flight snapshots, and estimates must never be presented as final results.')}</li>
        </ul>
      </section>
    </>
  )}

  <footer class="exp-scaffold__footer">
    <a href={p('/research/seed-openevo/study/results/')}>← {t('返回研究结果总页', 'Back to Results')}</a>
    <span>{t('原则：先固定问题与空位，后填真实结果。', 'Rule: freeze the questions and slots first; fill real evidence later.')}</span>
  </footer>
</main>

