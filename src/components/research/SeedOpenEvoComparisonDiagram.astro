---
import type { Locale } from '../../i18n';
import ResearchDiagramLegend from './ResearchDiagramLegend.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="method-comparison" aria-labelledby="method-comparison-title" data-explainer="seed-openevo-compare">
  <header class="diagram-head">
    <span>SEED × OPENEVO · MENTAL MODEL</span>
    <h2 id="method-comparison-title">{t('SEED 与 OpenEvo 的经验载体','SEED and OpenEvo experience carriers')}</h2>
    <p>{t('两者都从真实任务轨迹出发。SEED 主要把任务后复盘得到的改进写回策略参数；OpenEvo 则先把经验整理成可验证、可带到下一任务的状态（carrier），再合并成下一版 agent 状态（successor revision）。','Both begin from real task trajectories. SEED primarily writes improvements from hindsight back into policy parameters; OpenEvo first turns experience into a validated state that can persist into the next task (a carrier), then assembles the next agent state (the successor revision).')}</p>
  </header>

  <div class="shared-start">
    <article><span class="node-role">SHARED EXPERIENCE</span><strong>task + observations + sampled actions + outcome</strong><small>{t('这里还没有决定“怎么进化”','at this point, the evolution mechanism has not yet been chosen')}</small></article>
  </div>

  <figure class="fork-scene" role="img" aria-label={t('同一任务经验向左进入 SEED：hindsight、OPD+GRPO、policy parameter update；向右进入 OpenEvo：sealed evidence、evolution method、memory/artifact/adapter、successor revision','The same task experience forks left into SEED through hindsight, OPD+GRPO, and policy parameter update, and right into OpenEvo through sealed evidence, evolution method, memory/artifact/adapter, and successor revision')}>
    <article class="method-head seed-head"><span>SEED</span><strong>{t('把更好的决策倾向写进 policy 参数','write better decision tendencies into policy parameters')}</strong></article>
    <article class="method-head evo-head"><span>OpenEvo</span><strong>{t('把经验变成可带到下一任务的状态，再合并成下一版 agent','turn experience into state that persists to the next task, then assemble the next agent version')}</strong></article>

    <article class="node seed-hindsight"><span class="node-role">HINDSIGHT</span><strong>hindsight skill</strong><small>{t('同一 policy 回看完整 trajectory','the same policy reviews the completed trajectory')}</small></article>
    <article class="node seed-signal"><span class="node-role">TRAINING SIGNAL</span><strong>OPD + GRPO</strong><small>{t('稠密概率变化 + outcome RL','dense probability shift + outcome RL')}</small></article>
    <article class="node seed-state"><span class="node-role">PERSISTENT CHANGE</span><strong>policy θ<sub>t+1</sub></strong><small>{t('经验主要内化进模型参数','experience is primarily internalized into model parameters')}</small></article>

    <article class="node evo-evidence"><span class="node-role">任务结束后的证据</span><strong>{t('已固定、不会再被改写的任务记录（sealed evidence）','Task record frozen after completion (sealed evidence)')}</strong><small>{t('任务先完整结束，再演化','finish the task first, evolve second')}</small></article>
    <article class="node evo-method"><span class="node-role">EVOLUTION METHOD</span><strong>reflection / extraction / parametric update</strong><small>{t('方法决定经验如何被编码','the method determines how experience is encoded')}</small></article>
    <article class="node evo-carrier"><span class="node-role">PERSISTENT CHANGE</span><strong>memory / artifact / adapter</strong><small>{t('可在模型外，也可以参数化','may be external to the model or parametric')}</small></article>

    <article class="destination seed-destination"><small>{t('下一轮需要什么','What the next round needs')}</small><strong>{t('更新后的 policy checkpoint','the updated policy checkpoint')}</strong><span>{t('推理时不需要 hindsight skill bank','no hindsight skill bank is required at inference')}</span></article>
    <article class="destination evo-destination"><small>{t('下一轮需要什么','What the next round needs')}</small><strong>{t('验证通过的 successor revision','the validated successor revision')}</strong><span>{t('具体依赖取决于 carrier 类型','the exact dependency depends on the carrier type')}</span></article>

    <svg class="fork-wires" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <marker id="cmp-arrow-red" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#dc2626" /></marker>
        <marker id="cmp-arrow-violet" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#7c3aed" /></marker>
        <marker id="cmp-arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#059669" /></marker>
      </defs>
      <path class="wire seed" d="M600 20 C470 70 350 85 285 130" marker-end="url(#cmp-arrow-red)" />
      <path class="wire evo" d="M600 20 C730 70 850 85 915 130" marker-end="url(#cmp-arrow-violet)" />
      <path class="wire seed" d="M285 210 C285 245 285 270 285 300" marker-end="url(#cmp-arrow-red)" />
      <path class="wire seed" d="M285 380 C285 420 285 445 285 472" marker-end="url(#cmp-arrow-red)" />
      <path class="wire evo" d="M915 210 C915 245 915 270 915 300" marker-end="url(#cmp-arrow-violet)" />
      <path class="wire evo" d="M915 380 C915 420 915 445 915 472" marker-end="url(#cmp-arrow-violet)" />
      <path class="wire persist" d="M285 542 C285 565 285 575 285 590" marker-end="url(#cmp-arrow-green)" />
      <path class="wire persist" d="M915 542 C915 565 915 575 915 590" marker-end="url(#cmp-arrow-green)" />
    </svg>
    <div class="center-question"><small>{t('核心分叉问题','Core fork question')}</small><strong>{t('“这次经验最终存到哪里？”','“Where does this experience ultimately live?”')}</strong></div>
  </figure>

  <div class="comparison-grid">
    <article><small>{t('经验载体','Experience carrier')}</small><div><b>SEED</b><span>{t('训练后主要体现在 policy 参数','primarily in policy parameters after training')}</span></div><div><b>OpenEvo</b><span>{t('memory / artifact / adapter 等 successor state','memory / artifact / adapter and other successor state')}</span></div></article>
    <article><small>{t('变化何时生效','When change activates')}</small><div><b>SEED</b><span>{t('optimizer 更新 checkpoint 后进入下一轮 RL','after the optimizer updates the checkpoint for the next RL iteration')}</span></div><div><b>OpenEvo</b><span>{t('任务结束、carrier 验证、revision 发布后进入下一任务','after task completion, carrier validation, and successor-revision publication')}</span></div></article>
    <article><small>{t('项目实验状态入口','Project experiment-state source')}</small><div><b>SEED</b><span>{t('论文方法与后续正式比较目标','paper method and later formal comparison target')}</span></div><div><b>OpenEvo</b><span>{t('WebShop SD-LoRA 是历史验证路径；实时 campaign 回实际实验 branch 解析','WebShop SD-LoRA is a historically validated path; resolve the live campaign from the experiment branch actually in use')}</span></div></article>
  </div>

  <aside class="novice-note"><small>{t('给第一次接触自进化 Agent 的读者','For a first-time self-evolving-agent reader')}</small><p>{t('可以把 SEED 想成“把事后复盘学到的东西写回大脑参数”；把 OpenEvo 想成“先把复盘变成一个可验证、可继承的状态包，再决定这个状态包是在大脑外还是参数里”。这个类比只帮助建立直觉，真正实验仍要看具体 carrier 和训练目标。','A useful first intuition is: SEED writes lessons from hindsight back into the brain-like policy parameters; OpenEvo first turns hindsight into a validated, inheritable state package, which may live outside the model or in parameters. This analogy is only a mental model; the actual experiment still depends on the concrete carrier and training objective.')}</p></aside>

  <ResearchDiagramLegend locale={locale} />

  <details class="technical-details"><summary>{t('技术细节：为什么不能简单说“OpenEvo 是外部记忆，SEED 是参数学习”？','Technical detail: why “OpenEvo = external memory, SEED = parameter learning” is too simple')}</summary><p>{t('因为 OpenEvo 的 carrier 可以是 memory，也可以是参数化 adapter。真正稳定的区别不是“外部 vs 参数”，而是框架边界与经验载体：SEED 的论文机制围绕同一 policy 的 hindsight re-score + OPD/GRPO 参数更新；OpenEvo 则把任务结束后的 evidence 交给 evolution method，并允许不同 carrier 组成 successor revision。','Because an OpenEvo carrier may be external memory or a parametric adapter. The stable distinction is therefore not simply “external versus parameters” but the framework boundary and experience carrier: SEED centers on hindsight re-scoring by the same policy plus OPD/GRPO parameter updates, while OpenEvo hands post-task evidence to an evolution method and allows different carriers to compose a successor revision.')}</p></details>
</section>

<style>
.method-comparison{--env:#2563eb;--experience:#d97706;--signal:#dc2626;--state:#7c3aed;--persist:#059669;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:24px;background:linear-gradient(90deg,color-mix(in srgb,var(--signal) 3%,var(--surface)),var(--surface) 47%,color-mix(in srgb,var(--state) 3%,var(--surface)));box-shadow:0 24px 76px color-mix(in srgb,#000 8%,transparent)}.diagram-head{max-width:930px}.diagram-head>span{color:var(--state);font:850 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.diagram-head h2{margin:.38rem 0 .55rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.68}.shared-start{display:flex;justify-content:center;margin:1rem 0}.shared-start article{width:min(680px,90%);padding:.7rem .9rem;border:1.5px solid color-mix(in srgb,var(--env) 46%,var(--line));border-top:5px solid var(--env);border-radius:13px;background:color-mix(in srgb,var(--env) 5%,var(--surface));text-align:center}.node-role,.shared-start span{display:block;color:var(--muted);font:850 .51rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.shared-start strong,.shared-start small{display:block}.shared-start strong{margin:.28rem 0;font-size:.71rem}.shared-start small{color:var(--muted);font-size:.56rem}.fork-scene{position:relative;isolation:isolate;display:grid;grid-template-columns:1fr 1fr;grid-template-areas:"seed-head evo-head" "seed-hindsight evo-evidence" "seed-signal evo-method" "seed-state evo-carrier" "seed-destination evo-destination";gap:1rem 5.2rem;min-height:600px;padding:1rem;border:1px solid var(--line);border-radius:18px;background:linear-gradient(90deg,color-mix(in srgb,var(--signal) 5%,var(--surface)) 0 48%,color-mix(in srgb,var(--state) 5%,var(--surface)) 52% 100%);overflow:hidden}.fork-scene:after{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:1px dashed color-mix(in srgb,var(--muted) 28%,transparent)}.method-head{z-index:2;padding:.65rem;border:1px solid var(--line);border-radius:11px;background:var(--surface);text-align:center}.method-head span,.method-head strong{display:block}.method-head span{font:900 .72rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.method-head strong{margin-top:.24rem;font-size:.62rem;line-height:1.4}.seed-head{grid-area:seed-head}.seed-head span{color:var(--signal)}.evo-head{grid-area:evo-head}.evo-head span{color:var(--state)}.node{z-index:2;justify-self:center;width:76%;min-height:92px;padding:.65rem;border:1.5px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--surface) 97%,transparent);box-shadow:0 8px 20px color-mix(in srgb,#000 5%,transparent)}.node strong,.node small{display:block}.node strong{margin:.28rem 0;font-size:.66rem}.node small{color:var(--muted);font-size:.54rem;line-height:1.4}.seed-hindsight{grid-area:seed-hindsight;border-top:5px solid var(--experience)}.seed-signal{grid-area:seed-signal;border-top:5px solid var(--signal)}.seed-state{grid-area:seed-state;border-top:5px solid var(--persist)}.evo-evidence{grid-area:evo-evidence;border-top:5px solid var(--experience)}.evo-method{grid-area:evo-method;border-top:5px solid var(--experience)}.evo-carrier{grid-area:evo-carrier;border-top:5px solid var(--state)}.destination{z-index:2;padding:.68rem;border:1.5px solid color-mix(in srgb,var(--persist) 50%,var(--line));border-radius:12px;background:color-mix(in srgb,var(--persist) 5%,var(--surface))}.destination small,.destination strong,.destination span{display:block}.destination small{color:var(--muted);font-size:.52rem}.destination strong{margin:.24rem 0;font-size:.64rem}.destination span{color:var(--muted);font-size:.54rem}.seed-destination{grid-area:seed-destination}.evo-destination{grid-area:evo-destination}.fork-wires{z-index:1;position:absolute;inset:58px 0 0;width:100%;height:calc(100% - 58px);pointer-events:none}.wire{fill:none;stroke-width:4;vector-effect:non-scaling-stroke}.wire.seed{stroke:var(--signal)}.wire.evo{stroke:var(--state)}.wire.persist{stroke:var(--persist)}.center-question{z-index:3;position:absolute;left:50%;top:47%;transform:translate(-50%,-50%);width:170px;padding:.5rem;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);box-shadow:0 12px 26px color-mix(in srgb,#000 8%,transparent);text-align:center}.center-question small,.center-question strong{display:block}.center-question small{color:var(--muted);font-size:.49rem}.center-question strong{margin-top:.2rem;font-size:.58rem;line-height:1.35}.comparison-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin-top:.65rem}.comparison-grid article{padding:.68rem;border:1px solid var(--line);border-radius:10px;background:var(--surface-muted)}.comparison-grid>article>small{display:block;color:var(--muted);font-size:.54rem;margin-bottom:.35rem}.comparison-grid div{display:grid;grid-template-columns:58px 1fr;gap:.35rem;padding:.3rem 0;border-top:1px solid var(--line)}.comparison-grid b{font-size:.56rem;color:var(--state)}.comparison-grid div:first-of-type b{color:var(--signal)}.comparison-grid span{font-size:.55rem;line-height:1.4}.novice-note{margin-top:.65rem;padding:.7rem;border-left:4px solid var(--experience);border-radius:9px;background:color-mix(in srgb,var(--experience) 5%,var(--surface))}.novice-note small{display:block;color:var(--experience);font-size:.55rem;font-weight:850}.novice-note p{margin:.28rem 0 0;color:var(--muted);font-size:.6rem;line-height:1.48}.technical-details{margin-top:.7rem;border:1px solid var(--line);border-radius:11px;background:var(--surface-muted)}.technical-details summary{cursor:pointer;padding:.68rem .75rem;font-size:.63rem;font-weight:800}.technical-details p{margin:0;padding:0 .75rem .75rem;color:var(--muted);font-size:.57rem;line-height:1.48}@media(max-width:900px){.fork-scene{grid-template-columns:1fr;grid-template-areas:"seed-head" "seed-hindsight" "seed-signal" "seed-state" "seed-destination" "evo-head" "evo-evidence" "evo-method" "evo-carrier" "evo-destination";gap:.72rem;min-height:auto;background:var(--surface)}.fork-scene:after,.fork-wires,.center-question{display:none}.node{width:100%}.method-head{margin-top:.4rem}.node:not(.seed-state):not(.evo-carrier):after{content:"";position:absolute;left:50%;bottom:-.72rem;width:3px;height:.72rem;background:color-mix(in srgb,var(--muted) 45%,transparent)}.comparison-grid{grid-template-columns:1fr}}@media(max-width:560px){.method-comparison{width:min(100% - 1rem,1180px);padding:.8rem}}
</style>