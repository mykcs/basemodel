---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="method-comparison" aria-labelledby="method-comparison-title">
  <header><span>{t('并排框架图','Side-by-side architecture')}</span><h2 id="method-comparison-title">SEED vs OpenEvo</h2><p>{t('两者都从任务经验出发，但经验最终“存到哪里”不同：SEED 把变化内化进 policy 参数；OpenEvo 允许经验作为 memory / artifact / adapter 组成后续 revision。','Both start from task experience, but the final carrier differs: SEED internalizes change into policy parameters, while OpenEvo can carry experience through memory, artifacts, or adapters in later revisions.')}</p></header>
  <div class="shared"><strong>{t('共同起点','Shared start')}</strong><span>task → observation → action → trajectory → outcome</span></div>
  <div class="compare-grid">
    <article class="lane seed-lane"><header><b>SEED</b><span>{t('参数内化','Parameter internalization')}</span></header><div class="flow"><div class="node blue"><small>01</small><strong>on-policy rollout</strong></div><i></i><div class="node amber"><small>02</small><strong>hindsight skill</strong></div><i></i><div class="node teal"><small>03</small><strong>dual-context re-score</strong></div><i></i><div class="node red"><small>04</small><strong>GRPO + OPD</strong></div><i></i><div class="node green"><small>05</small><strong>new policy checkpoint</strong></div></div><footer><span>{t('经验最终进入','Experience ends in')}</span><strong>{t('模型参数','model parameters')}</strong></footer></article>
    <article class="lane evo-lane"><header><b>OpenEvo</b><span>{t('跨任务 carrier 演化','Cross-task carrier evolution')}</span></header><div class="flow"><div class="node blue"><small>01</small><strong>completed task</strong></div><i></i><div class="node teal"><small>02</small><strong>sealed evidence</strong></div><i></i><div class="node amber"><small>03</small><strong>evolution method</strong></div><i></i><div class="node violet"><small>04</small><strong>memory / artifact / adapter</strong></div><i></i><div class="node green"><small>05</small><strong>successor revision</strong></div></div><footer><span>{t('经验最终进入','Experience ends in')}</span><strong>{t('可跨任务复用的外部或参数化状态','reusable external or parametric state')}</strong></footer></article>
  </div>
  <div class="comparison-table"><article><small>{t('训练 / 演化边界','Update boundary')}</small><span>SEED</span><strong>{t('同一 RL 训练循环中更新 checkpoint','checkpoint update inside the RL training loop')}</strong><span>OpenEvo</span><strong>{t('任务结束后发布 successor revision','successor revision published after task completion')}</strong></article><article><small>{t('推理时依赖','Inference dependency')}</small><span>SEED</span><strong>{t('更新后的 policy 即可','updated policy only')}</strong><span>OpenEvo</span><strong>{t('取决于 carrier：memory / artifact / adapter','depends on carrier: memory / artifact / adapter')}</strong></article><article><small>{t('当前实验关注','Current experiment focus')}</small><span>SEED</span><strong>{t('后续正式对比目标','later formal comparison target')}</strong><span>OpenEvo</span><strong>{t('当前 WebShop 主线：SD-LoRA + Phase H0','active WebShop line: SD-LoRA + Phase H0')}</strong></article></div>
</section>
<style>
.method-comparison{--blue:#2563eb;--amber:#d97706;--teal:#0f766e;--red:#dc2626;--green:#059669;--violet:#7c3aed;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:0 18px 55px color-mix(in srgb,#000 7%,transparent)}.method-comparison>header{max-width:850px}.method-comparison>header>span{color:var(--violet);font-size:.7rem;font-weight:850}.method-comparison h2{margin:.3rem 0 .45rem}.method-comparison>header p{margin:0;color:var(--muted);line-height:1.6}.shared{display:flex;align-items:center;justify-content:center;gap:.7rem;margin:1rem 0;padding:.65rem;border:1px solid color-mix(in srgb,var(--blue) 38%,var(--line));border-radius:11px;background:color-mix(in srgb,var(--blue) 6%,var(--surface))}.shared strong{font-size:.64rem;color:var(--blue)}.shared span{font:700 .66rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace}.compare-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.lane{padding:.85rem;border:1.5px solid;border-radius:16px}.seed-lane{border-color:color-mix(in srgb,var(--red) 38%,var(--line));background:color-mix(in srgb,var(--red) 4%,var(--surface))}.evo-lane{border-color:color-mix(in srgb,var(--violet) 38%,var(--line));background:color-mix(in srgb,var(--violet) 4%,var(--surface))}.lane>header{display:flex;align-items:center;justify-content:space-between}.lane>header b{font-size:.82rem}.seed-lane>header b{color:var(--red)}.evo-lane>header b{color:var(--violet)}.lane>header span{font-size:.62rem;color:var(--muted)}.flow{display:grid;grid-template-columns:1fr 25px 1fr 25px 1fr 25px 1fr 25px 1fr;align-items:center;margin-top:.7rem}.node{min-height:78px;padding:.55rem;border:1px solid var(--line);border-top:4px solid;border-radius:10px;background:var(--surface)}.node small,.node strong{display:block}.node small{font:.8rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}.node strong{margin-top:.25rem;font-size:.61rem;line-height:1.28}.node.blue{border-top-color:var(--blue)}.node.amber{border-top-color:var(--amber)}.node.teal{border-top-color:var(--teal)}.node.red{border-top-color:var(--red)}.node.green{border-top-color:var(--green)}.node.violet{border-top-color:var(--violet)}.flow>i{position:relative;height:3px;background:var(--muted)}.flow>i:after{content:"";position:absolute;right:-1px;top:-4px;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:7px solid var(--muted)}.lane footer{display:grid;grid-template-columns:auto 1fr;gap:.5rem;margin-top:.65rem;padding:.6rem;border-radius:9px;background:var(--surface-muted)}.lane footer span{font-size:.58rem;color:var(--muted)}.lane footer strong{font-size:.64rem}.comparison-table{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin-top:.7rem}.comparison-table article{display:grid;grid-template-columns:52px 1fr;gap:.25rem .45rem;padding:.7rem;border:1px solid var(--line);border-radius:10px}.comparison-table small{grid-column:1/-1;color:var(--muted);font-size:.58rem}.comparison-table span{font-size:.58rem;font-weight:850;color:var(--violet)}.comparison-table strong{font-size:.6rem;line-height:1.35}@media(max-width:1000px){.flow{grid-template-columns:1fr}.flow>i{width:3px;height:24px;margin:auto}.flow>i:after{right:-4px;top:auto;bottom:-1px;border-left:5px solid transparent;border-right:5px solid transparent;border-top:7px solid var(--muted);border-bottom:0}.comparison-table{grid-template-columns:1fr}}@media(max-width:760px){.compare-grid{grid-template-columns:1fr}.method-comparison{width:min(100% - 1rem,1180px)}.shared{align-items:flex-start;flex-direction:column}}
</style>
