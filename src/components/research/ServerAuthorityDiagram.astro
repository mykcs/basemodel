---
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
---
<section class="authority-diagram" aria-labelledby="authority-diagram-title">
  <header class="diagram-head">
    <span>{t('服务器权限结构','Server authority model')}</span>
    <h2 id="authority-diagram-title">{t('我在 OpenEvo 服务器上的权限边界','My authority boundary on the OpenEvo server')}</h2>
    <p>{t('这里的 root 不是物理宿主机的全局 root。SSH 进入的是分配给我的开发 / 控制平面容器；我在这个容器里是 root，并通过 Docker socket 管理获准的实验容器。','The root shell here is not global root on the physical host. SSH lands in my assigned development/control-plane container; I am root inside that container and can manage approved experiment containers through the Docker socket.')}</p>
  </header>

  <div class="authority-canvas" role="img" aria-label={t('宿主机到控制容器、Docker daemon、实验容器与持久工作区的权限关系图','Authority diagram from physical host to control container, Docker daemon, experiment container, and persistent workspace')}>
    <div class="layer host-layer">
      <div class="layer-label"><b>01</b><span>HOST</span></div>
      <article class="node node-host">
        <small>{t('物理 / 云宿主层','Physical / cloud host')}</small>
        <strong>OpenEvo Server Host</strong>
        <p>{t('平台管理员维护内核、驱动、存储、全局 Docker daemon 与其他用户资源。','Platform administrators own the kernel, drivers, storage, global Docker daemon, and other users’ resources.')}</p>
        <em>{t('我不是这一层的总管理员','I am not the global administrator of this layer')}</em>
      </article>
    </div>

    <div class="vertical-connector" aria-hidden="true"><span></span><i></i></div>

    <div class="layer control-layer">
      <div class="layer-label"><b>02</b><span>CONTROL PLANE</span></div>
      <article class="node node-control">
        <small>{t('我的开发 / 控制容器','My development / control container')}</small>
        <strong>dev-wangr · hostname wangr-dev</strong>
        <div class="chips"><span>root UID 0</span><span>Docker CLI</span><span>/var/run/docker.sock</span></div>
        <p>{t('这里我有 root 权限。sudo 不存在也不是问题；真正的敏感能力是 Docker socket，因为它能让这个容器向宿主 Docker daemon 发出容器生命周期请求。','I have root here. The absence of sudo is irrelevant; the sensitive capability is the Docker socket because it lets this container issue lifecycle requests to the host Docker daemon.')}</p>
      </article>
      <div class="docker-link" aria-hidden="true"><span></span><i></i></div>
      <article class="node node-daemon">
        <small>{t('共享控制面','Shared control plane')}</small>
        <strong>Docker Engine 29.1.3</strong>
        <p>{t('daemon 同时管理我的容器和其他用户容器，所以“能操作”不等于“被授权操作”。','The daemon also manages sibling users’ containers, so technical capability does not equal authorization.')}</p>
      </article>
      <aside class="sibling-zone">
        <strong>{t('其他用户区域','Sibling-user zone')}</strong>
        <span>dev-guozy</span><span>dev-huzh</span>
        <small>{t('不进入、不停止、不清理','Do not exec, stop, or clean')}</small>
      </aside>
    </div>

    <div class="vertical-connector" aria-hidden="true"><span></span><i></i></div>

    <div class="layer runtime-layer">
      <div class="layer-label"><b>03</b><span>EXPERIMENT RUNTIME</span></div>
      <article class="node node-runtime">
        <small>{t('正式科研运行层','Scientific execution layer')}</small>
        <strong>isolated experiment container</strong>
        <div class="chips"><span>non-root</span><span>UID/GID 1001:1001</span><span>explicit GPU</span><span>no Docker socket</span></div>
        <p>{t('模型加载、WebShop rollout、SD-LoRA 训练和评测放在这里运行，而不是直接用控制平面 root 跑科研任务。','Model loading, WebShop rollout, SD-LoRA training, and evaluation run here instead of running scientific jobs directly as control-plane root.')}</p>
      </article>
      <div class="workspace-link" aria-hidden="true"><span></span><i></i></div>
      <article class="node node-workspace">
        <small>{t('持久资产层','Persistent asset layer')}</small>
        <strong>/data/home/wangr/workspace</strong>
        <div class="workspace-grid"><span>repos/</span><span>runtime/</span><span>cache/</span><span>datasets/</span><span>models/</span><span>runs/</span></div>
        <p>{t('实验容器以普通科研用户身份写入；容器删除后，代码、数据身份、adapter、日志和 Run Manifest 仍留在持久工作区。','The experiment container writes as the ordinary research identity; deleting the container does not delete code, dataset identities, adapters, logs, or Run Manifests stored here.')}</p>
      </article>
    </div>
  </div>

  <div class="authority-summary">
    <article><span>{t('我有','I have')}</span><strong>{t('控制容器 root + 创建 / 管理获准 Docker 实验容器的能力','root in my control container + ability to create/manage approved Docker experiment containers')}</strong></article>
    <article><span>{t('我没有','I do not have')}</span><strong>{t('物理宿主机的全局管理员身份，也没有操作其他用户容器的授权','global host-admin status or authorization to operate sibling users’ containers')}</strong></article>
  </div>
</section>

<style>
.authority-diagram{--blue:#2563eb;--cyan:#0891b2;--violet:#7c3aed;--green:#059669;--amber:#d97706;--red:#dc2626;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:22px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface) 96%,var(--blue) 4%),var(--surface));box-shadow:0 22px 70px color-mix(in srgb,#000 9%,transparent)}.diagram-head{max-width:900px}.diagram-head>span{color:var(--blue);font-size:.7rem;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.diagram-head h2{margin:.35rem 0 .55rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.65}.authority-canvas{display:grid;gap:0;margin-top:1.2rem}.layer{position:relative;display:grid;grid-template-columns:120px minmax(0,1fr);gap:.8rem;padding:1rem;border:1px solid var(--line);border-radius:18px}.host-layer{background:color-mix(in srgb,var(--blue) 7%,var(--surface))}.control-layer{grid-template-columns:120px minmax(0,1.3fr) 72px minmax(0,.9fr) minmax(150px,.55fr);background:color-mix(in srgb,var(--violet) 7%,var(--surface))}.runtime-layer{grid-template-columns:120px minmax(0,1.1fr) 72px minmax(0,1fr);background:color-mix(in srgb,var(--green) 7%,var(--surface))}.layer-label{display:flex;flex-direction:column;justify-content:flex-start;gap:.2rem;padding-top:.35rem}.layer-label b{font:850 .72rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}.layer-label span{font:850 .64rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;color:var(--muted)}.node{position:relative;padding:1rem;border:1.5px solid;border-radius:15px;background:var(--surface);box-shadow:0 10px 28px color-mix(in srgb,#000 7%,transparent)}.node small,.node strong,.node em{display:block}.node small{font-size:.64rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.node strong{margin:.32rem 0;font-size:.92rem}.node p{margin:.45rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.52}.node em{margin-top:.7rem;font-size:.68rem;font-style:normal;font-weight:800}.node-host{border-color:color-mix(in srgb,var(--blue) 55%,var(--line))}.node-host em{color:var(--blue)}.node-control{border-color:color-mix(in srgb,var(--violet) 58%,var(--line))}.node-daemon{border-color:color-mix(in srgb,var(--amber) 58%,var(--line))}.node-runtime{border-color:color-mix(in srgb,var(--cyan) 58%,var(--line))}.node-workspace{border-color:color-mix(in srgb,var(--green) 58%,var(--line))}.chips{display:flex;gap:.35rem;flex-wrap:wrap;margin:.55rem 0}.chips span,.workspace-grid span{padding:.28rem .48rem;border-radius:999px;background:var(--surface-muted);font:750 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.workspace-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.32rem;margin:.6rem 0}.workspace-grid span{text-align:center;border-radius:8px}.vertical-connector{height:42px;position:relative;margin-left:calc(120px + .8rem)}.vertical-connector span{position:absolute;left:30px;top:0;bottom:9px;width:3px;border-radius:99px;background:linear-gradient(var(--blue),var(--violet))}.vertical-connector i{position:absolute;left:23px;bottom:0;width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:10px solid var(--violet)}.docker-link,.workspace-link{position:relative;align-self:center;height:32px}.docker-link span,.workspace-link span{position:absolute;left:0;right:10px;top:14px;height:3px;border-radius:99px}.docker-link span{background:var(--amber)}.workspace-link span{background:var(--green)}.docker-link i,.workspace-link i{position:absolute;right:0;top:8px;width:0;height:0;border-top:8px solid transparent;border-bottom:8px solid transparent}.docker-link i{border-left:11px solid var(--amber)}.workspace-link i{border-left:11px solid var(--green)}.sibling-zone{align-self:stretch;padding:.8rem;border:1.5px dashed color-mix(in srgb,var(--red) 55%,var(--line));border-radius:14px;background:color-mix(in srgb,var(--red) 6%,var(--surface))}.sibling-zone strong,.sibling-zone span,.sibling-zone small{display:block}.sibling-zone strong{font-size:.7rem;color:var(--red)}.sibling-zone span{margin-top:.35rem;padding:.25rem .4rem;border-radius:7px;background:var(--surface);font:700 .62rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.sibling-zone small{margin-top:.5rem;color:var(--muted);font-size:.62rem}.authority-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:.8rem}.authority-summary article{padding:.8rem;border-left:4px solid var(--green);border-radius:10px;background:var(--surface-muted)}.authority-summary article+article{border-left-color:var(--red)}.authority-summary span,.authority-summary strong{display:block}.authority-summary span{font-size:.62rem;color:var(--muted)}.authority-summary strong{margin-top:.22rem;font-size:.72rem;line-height:1.45}@media(max-width:900px){.control-layer,.runtime-layer,.host-layer{grid-template-columns:1fr}.layer-label{flex-direction:row;align-items:center}.docker-link,.workspace-link{height:42px}.docker-link span,.workspace-link span{left:50%;right:auto;top:0;bottom:10px;width:3px;height:auto}.docker-link i,.workspace-link i{left:calc(50% - 7px);right:auto;top:auto;bottom:0;border-left:7px solid transparent;border-right:7px solid transparent;border-top:10px solid var(--green);border-bottom:0}.docker-link i{border-top-color:var(--amber)}.vertical-connector{margin-left:50%}.authority-summary{grid-template-columns:1fr}.workspace-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.authority-diagram{width:min(100% - 1rem,1180px);padding:.8rem}.layer{padding:.75rem}.node{padding:.8rem}}
</style>
