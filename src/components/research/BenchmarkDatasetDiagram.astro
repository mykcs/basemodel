---
import type { Locale } from '../../i18n';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const taskTypes = [
  t('拿取并放置','Pick & Place'),
  t('灯下观察','Examine in Light'),
  t('清洗并放置','Clean & Place'),
  t('加热并放置','Heat & Place'),
  t('冷却并放置','Cool & Place'),
  t('拿两个并放置','Pick Two & Place'),
];
---
<section class:list={['benchmark-architecture', compact && 'benchmark-architecture--compact']} aria-labelledby="benchmark-architecture-title">
  <header class="diagram-head">
    <span>{t('Benchmark 任务与数据','Benchmark task & data')}</span>
    <h2 id="benchmark-architecture-title">{t('WebShop 与 ALFWorld 的数据集设定','WebShop and ALFWorld dataset setup')}</h2>
    <p>{t('这里把“原始 benchmark 是什么”“SEED 怎么包装环境”“我们当前 OpenEvo 实验实际冻结了什么”分成三层，避免把同名 benchmark 当成完全相同的实验。','This separates the original benchmark, SEED’s environment wrapper, and the exact contract frozen by our current OpenEvo experiment so that a shared benchmark name is not mistaken for identical experiments.')}</p>
  </header>

  <div class="benchmark-columns">
    <article class="benchmark-card webshop-card">
      <header><div class="benchmark-icon">🛒</div><div><small>WEB INTERACTION</small><h3>WebShop</h3><p>{t('在模拟电商网站中，根据自然语言约束搜索、比较、选择属性并购买商品。','A simulated e-commerce website where the agent searches, compares, selects attributes, and purchases products from a natural-language instruction.')}</p></div></header>
      <div class="pipeline" role="img" aria-label={t('WebShop 从商品和指令到环境任务、动作和奖励的数据流','WebShop data flow from products and instructions to tasks, actions, and rewards')}>
        <div class="pipe-node source"><small>{t('官方数据宇宙','Original corpus')}</small><strong>1.18M {t('商品','products')}</strong><span>12,087 {t('众包指令','crowd-sourced instructions')}</span></div>
        <div class="pipe-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="pipe-node subset"><small>{t('我们当前环境','Current environment')}</small><strong>1,000 {t('商品子集','product subset')}</strong><span>items_shuffle_1000 + attributes + instructions</span></div>
        <div class="pipe-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="pipe-node tasks"><small>{t('任务 / goal','Tasks / goals')}</small><strong>{t('自然语言购物约束','natural-language shopping constraint')}</strong><span>{t('原始 1k demo 加载 6,910 goals','the original 1k demo loads 6,910 goals')}</span></div>
        <div class="pipe-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="pipe-node agent"><small>{t('交互循环','Interaction loop')}</small><strong>search → click → option → buy</strong><span>{t('每一步返回文本页面状态与可用动作','each step returns text page state and available actions')}</span></div>
        <div class="pipe-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="pipe-node reward"><small>{t('评分','Scoring')}</small><strong>task_score ∈ [0,1]</strong><span>{t('精确完成时 won=true；SEED RL reward=10，否则 0','exact completion sets won=true; SEED RL reward=10, otherwise 0')}</span></div>
      </div>
      <div class="split-strip"><article><small>SEED</small><strong>goal 0–499</strong><span>{t('评估','evaluation')}</span></article><article><small>SEED</small><strong>goal 500–end</strong><span>{t('训练','training')}</span></article><article class="active"><small>OpenEvo · Phase G</small><strong>6680 · 2590</strong><span>{t('promotion-dev；env seed 2026','promotion-dev; env seed 2026')}</span></article></div>
      <aside class="benchmark-note"><strong>{t('当前科学状态','Current scientific status')}</strong><p>{t('WebShop 是当前主线。Phase G 已完成 2 goals × 2 generation seeds × 3 arms = 12 episodes；下一步是 Phase H0 natural-success search。','WebShop is the active line. Phase G completed 2 goals × 2 generation seeds × 3 arms = 12 episodes; the next gate is Phase H0 natural-success search.')}</p></aside>
    </article>

    <article class="benchmark-card alfworld-card">
      <header><div class="benchmark-icon">🏠</div><div><small>TEXT / EMBODIED HOUSEHOLD</small><h3>ALFWorld</h3><p>{t('把 ALFRED 家务任务对齐到 TextWorld 文本世界，也能切换到 THOR 具身环境；Agent 需要满足动作前置条件并完成长序列家务目标。','ALFWorld aligns ALFRED household tasks with TextWorld and can also run in THOR; the agent must satisfy action preconditions and complete long-horizon household goals.')}</p></div></header>
      <div class="alf-pipeline" role="img" aria-label={t('ALFWorld 从 ALFRED 任务到 TextWorld、数据 split、任务类型、动作和奖励的结构图','ALFWorld structure from ALFRED tasks to TextWorld, splits, task types, actions, and rewards')}>
        <div class="alf-stage stage-source"><small>{t('来源','Source')}</small><strong>ALFRED</strong><span>{t('家务目标 + PDDL 世界状态','household goals + PDDL world states')}</span></div>
        <div class="branch-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="alf-stage stage-world"><small>{t('对齐环境','Aligned environment')}</small><strong>ALFWorld</strong><div class="world-options"><span>AlfredTWEnv</span><span>AlfredThorEnv</span><span>Hybrid</span></div></div>
        <div class="branch-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="split-stack"><div><small>TRAIN</small><strong>json_2.1.1/train</strong></div><div><small>ID EVAL</small><strong>valid_seen</strong></div><div><small>OOD EVAL</small><strong>valid_unseen</strong></div></div>
        <div class="branch-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="alf-stage stage-action"><small>{t('Agent 输入 / 输出','Agent I/O')}</small><strong>{t('文本 observation → 文本 action','text observation → text action')}</strong><span>goto · pick · put · open · clean · heat · cool · examine …</span></div>
        <div class="branch-arrow" aria-hidden="true"><span></span><i></i></div>
        <div class="alf-stage stage-reward"><small>{t('SEED 奖励','SEED reward')}</small><strong>10 × won</strong><span>{t('文本模式只按最终成功；多模态模式额外加入 goal-condition success rate','text mode uses final success only; multimodal mode additionally includes goal-condition success rate')}</span></div>
      </div>
      <div class="task-type-grid">{taskTypes.map((name,index)=><span><b>{index+1}</b>{name}</span>)}</div>
      <aside class="benchmark-note"><strong>{t('当前科学状态','Current scientific status')}</strong><p>{t('ALFWorld 已属于 SEED/OpenEvo 研究目标和历史迁移资产，但当前 5090 科学主线仍先完成 WebShop 的监督瓶颈诊断；不要把尚未启动的新 ALFWorld campaign 写成当前结果。','ALFWorld is part of the SEED/OpenEvo research target and migrated history, but the current 5090 scientific line still prioritizes the WebShop supervision bottleneck; a new ALFWorld campaign has not yet become a current result.')}</p></aside>
    </article>
  </div>
</section>

<style>
.benchmark-architecture{--web:#2563eb;--shop:#0891b2;--home:#7c3aed;--green:#059669;--amber:#d97706;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:0 20px 65px color-mix(in srgb,#000 7%,transparent)}.benchmark-architecture--compact{margin:1.2rem auto}.diagram-head{max-width:900px}.diagram-head>span{color:var(--web);font-size:.7rem;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.diagram-head h2{margin:.35rem 0 .5rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.65}.benchmark-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem;margin-top:1rem}.benchmark-card{padding:1rem;border:1.5px solid;border-radius:18px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface) 94%,currentColor 6%),var(--surface))}.webshop-card{color:var(--web);border-color:color-mix(in srgb,var(--web) 48%,var(--line))}.alfworld-card{color:var(--home);border-color:color-mix(in srgb,var(--home) 48%,var(--line))}.benchmark-card>header{display:grid;grid-template-columns:52px 1fr;gap:.65rem;align-items:start}.benchmark-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:13px;background:color-mix(in srgb,currentColor 13%,var(--surface));font-size:1.45rem}.benchmark-card header small{font:850 .61rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em}.benchmark-card h3{margin:.2rem 0 .35rem;color:var(--text);font-size:1.15rem}.benchmark-card header p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.5}.pipeline,.alf-pipeline{display:grid;grid-template-columns:1fr 34px 1fr 34px 1fr;gap:.35rem;align-items:center;margin-top:1rem}.pipeline{grid-template-columns:1fr 28px 1fr 28px 1fr 28px 1fr 28px 1fr}.pipe-node,.alf-stage{min-height:112px;padding:.7rem;border:1px solid color-mix(in srgb,currentColor 35%,var(--line));border-radius:12px;background:var(--surface);box-shadow:0 7px 18px color-mix(in srgb,#000 5%,transparent)}.pipe-node small,.pipe-node strong,.pipe-node span,.alf-stage small,.alf-stage strong,.alf-stage>span{display:block}.pipe-node small,.alf-stage small{font-size:.57rem;color:var(--muted);text-transform:uppercase}.pipe-node strong,.alf-stage strong{margin:.3rem 0;color:var(--text);font-size:.7rem;line-height:1.3}.pipe-node span,.alf-stage>span{color:var(--muted);font-size:.6rem;line-height:1.38}.source{border-top:4px solid var(--web)}.subset{border-top:4px solid var(--shop)}.tasks{border-top:4px solid var(--home)}.agent{border-top:4px solid var(--amber)}.reward{border-top:4px solid var(--green)}.pipe-arrow,.branch-arrow{position:relative;height:28px}.pipe-arrow span,.branch-arrow span{position:absolute;left:0;right:8px;top:12px;height:3px;background:currentColor;border-radius:99px}.pipe-arrow i,.branch-arrow i{position:absolute;right:0;top:6px;border-top:8px solid transparent;border-bottom:8px solid transparent;border-left:10px solid currentColor}.split-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.35rem;margin-top:.6rem}.split-strip article{padding:.55rem;border:1px solid var(--line);border-radius:10px;background:var(--surface-muted)}.split-strip article.active{border-color:color-mix(in srgb,var(--green) 50%,var(--line));background:color-mix(in srgb,var(--green) 8%,var(--surface))}.split-strip small,.split-strip strong,.split-strip span{display:block}.split-strip small{font-size:.55rem;color:var(--muted)}.split-strip strong{margin:.2rem 0;color:var(--text);font-size:.66rem}.split-strip span{font-size:.58rem;color:var(--muted)}.alf-pipeline{grid-template-columns:1fr 28px 1fr 28px 1.15fr 28px 1fr 28px 1fr}.stage-source{border-top:4px solid var(--home)}.stage-world{border-top:4px solid var(--web)}.stage-action{border-top:4px solid var(--amber)}.stage-reward{border-top:4px solid var(--green)}.world-options{display:flex;gap:.25rem;flex-wrap:wrap;margin-top:.45rem}.world-options span{padding:.22rem .35rem;border-radius:6px;background:var(--surface-muted);font:700 .55rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.split-stack{display:grid;gap:.25rem}.split-stack>div{padding:.42rem;border:1px solid var(--line);border-radius:8px;background:var(--surface)}.split-stack small,.split-stack strong{display:block}.split-stack small{font-size:.5rem;color:var(--muted)}.split-stack strong{margin-top:.15rem;color:var(--text);font-size:.58rem}.task-type-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.3rem;margin-top:.6rem}.task-type-grid span{display:flex;align-items:center;gap:.35rem;padding:.45rem;border:1px solid color-mix(in srgb,var(--home) 30%,var(--line));border-radius:8px;background:color-mix(in srgb,var(--home) 5%,var(--surface));color:var(--text);font-size:.6rem}.task-type-grid b{display:grid;place-items:center;width:18px;height:18px;border-radius:999px;background:color-mix(in srgb,var(--home) 15%,var(--surface));color:var(--home);font-size:.55rem}.benchmark-note{margin-top:.65rem;padding:.65rem;border-left:4px solid currentColor;border-radius:9px;background:var(--surface-muted)}.benchmark-note strong{display:block;color:var(--text);font-size:.66rem}.benchmark-note p{margin:.25rem 0 0;color:var(--muted);font-size:.62rem;line-height:1.45}@media(max-width:1080px){.pipeline,.alf-pipeline{grid-template-columns:1fr}.pipe-arrow,.branch-arrow{height:30px}.pipe-arrow span,.branch-arrow span{left:50%;right:auto;top:0;bottom:8px;width:3px;height:auto}.pipe-arrow i,.branch-arrow i{left:calc(50% - 7px);right:auto;top:auto;bottom:0;border-left:7px solid transparent;border-right:7px solid transparent;border-top:9px solid currentColor;border-bottom:0}}@media(max-width:760px){.benchmark-columns{grid-template-columns:1fr}.benchmark-architecture{width:min(100% - 1rem,1180px)}.split-strip,.task-type-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.split-strip,.task-type-grid{grid-template-columns:1fr}}
</style>
