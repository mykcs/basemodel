---
import type { Locale } from '../../i18n';
import ResearchDiagramLegend from './ResearchDiagramLegend.astro';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const zh = locale === 'zh';
const t = (cn:string,en:string) => zh ? cn : en;
const taskTypes = [
  t('拿取并放置','Pick & Place'),
  t('灯下观察','Examine in Light'),
  t('清洗并放置','Clean & Place'),
  t('加热并放置','Heat & Place'),
  t('冷却并放置','Cool & Place'),
  t('拿两个并放置','Pick Two & Place'),
];
---
<section class:list={['benchmark-architecture', compact && 'benchmark-architecture--compact']} aria-labelledby="benchmark-architecture-title" data-explainer="benchmark-data">
  <header class="diagram-head">
    <span>BENCHMARK · WORLD MODEL</span>
    <h2 id="benchmark-architecture-title">{t('WebShop 与 ALFWorld 环境模型','WebShop and ALFWorld environment models')}</h2>
    <p>{t('对初学者最重要的不是先记数字，而是先理解一条任务如何变成 observation、action、状态变化和 reward。下面把原始数据、环境包装、Agent 循环和我们当前冻结的实验合同分开画。','For a beginner, the first goal is not memorizing numbers but understanding how a task becomes observations, actions, state transitions, and reward. The diagrams separate the original data, environment wrapper, agent loop, and our currently frozen experiment contract.')}</p>
  </header>

  <div class="principle-strip">
    <article><small>{t('任务是什么','What is a task?')}</small><strong>{t('一个目标 + 一个可交互世界','a goal + an interactive world')}</strong></article>
    <article><small>{t('Agent 看见什么','What does the agent see?')}</small><strong>{t('当前 observation，而不是完整隐藏状态','the current observation, not the full hidden state')}</strong></article>
    <article><small>{t('Agent 学到什么','What is learned?')}</small><strong>{t('如何用动作让世界状态朝成功条件变化','which actions move the world state toward success')}</strong></article>
  </div>

  <article class="benchmark-card webshop-card">
    <header class="benchmark-title"><div><span>WEB INTERACTION</span><h3>WebShop</h3></div><p>{t('自然语言购物要求被变成一个可反复 search / click / option / buy 的网页环境。模型不是“回答商品名”，而是在状态不断变化的网站里做决策。','A natural-language shopping request becomes an interactive website that supports repeated search, click, option, and buy actions. The model is not merely naming a product; it is making decisions in a changing website state.')}</p></header>

    <div class="scene webshop-scene" role="img" aria-label={t('WebShop 从商品语料与用户指令形成 1k 环境、goal，再进入 observation-action-state-transition-reward 循环','WebShop pipeline from product corpus and user instructions into the 1k environment, goals, and the observation-action-state-transition-reward loop')}>
      <article class="scene-node corpus"><span class="node-role">SOURCE DATA</span><strong>1.18M {t('商品','products')}</strong><small>12,087 {t('众包购物指令','crowd-sourced shopping instructions')}</small></article>
      <article class="scene-node snapshot"><span class="node-role">FROZEN WORLD</span><strong>1,000 {t('商品快照','product snapshot')}</strong><small>3 JSON files + resources_1k + Lucene indexes_1k</small></article>
      <article class="scene-node goal"><span class="node-role">TASK</span><strong>{t('自然语言约束','natural-language constraints')}</strong><small>{t('商品属性、预算、类别等共同定义目标','attributes, budget, category, and other constraints define the goal')}</small></article>
      <article class="scene-node observation"><span class="node-role">OBSERVATION</span><strong>{t('当前文本页面','current text page')}</strong><small>{t('搜索结果、商品页、可点击选项','search results, product page, clickable options')}</small></article>
      <article class="scene-node policy"><span class="node-role">POLICY</span><strong>Qwen2.5-3B-Instruct</strong><small>{t('根据 goal + 当前页面决定下一步','chooses the next step from the goal + current page')}</small></article>
      <article class="scene-node action"><span class="node-role">ACTION</span><strong>search / click / option / buy</strong><small>{t('动作改变网页状态','the action changes website state')}</small></article>
      <article class="scene-node verifier"><span class="node-role">ENVIRONMENT / VERIFIER</span><strong>task_score ∈ [0,1]</strong><small>{t('精确完成时 won=true；SEED 的 RL reward 成功为 10，否则 0','exact completion sets won=true; SEED RL reward is 10 on success, otherwise 0')}</small></article>
      <svg class="scene-wires" viewBox="0 0 1200 510" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <marker id="web-arrow-blue" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#2563eb" /></marker>
          <marker id="web-arrow-violet" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#7c3aed" /></marker>
          <marker id="web-arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#059669" /></marker>
        </defs>
        <path class="wire data" d="M260 112 C330 112 390 112 458 112" marker-end="url(#web-arrow-blue)" />
        <path class="wire data" d="M680 112 C755 112 820 112 890 112" marker-end="url(#web-arrow-blue)" />
        <path class="wire data" d="M1000 170 C1000 230 875 235 780 258" marker-end="url(#web-arrow-blue)" />
        <path class="wire state" d="M430 315 C485 315 515 315 556 315" marker-end="url(#web-arrow-violet)" />
        <path class="wire state" d="M735 315 C790 315 820 315 864 315" marker-end="url(#web-arrow-violet)" />
        <path class="wire feedback" d="M965 370 C900 455 455 455 345 375" marker-end="url(#web-arrow-blue)" />
        <path class="wire persist" d="M970 350 C1040 350 1080 350 1112 350" marker-end="url(#web-arrow-green)" />
      </svg>
      <span class="flow-label label-transition">{t('页面状态发生变化','state transition')}</span>
      <span class="flow-label label-feedback">{t('新 observation 进入下一步','new observation feeds the next step')}</span>
    </div>

    <div class="split-model">
      <article><small>SEED · EVAL</small><strong>goal 0–499</strong><span>{t('评估池','evaluation pool')}</span></article>
      <article><small>SEED · TRAIN</small><strong>goal 500–end</strong><span>{t('训练池','training pool')}</span></article>
      <article class="active"><small>OpenEvo · Phase G</small><strong>6680 · 2590</strong><span>{t('已消费 promotion-dev','consumed promotion-dev')}</span></article>
      <article class="next"><small>OpenEvo · Phase H0</small><strong>new train-only tasks</strong><span>{t('搜索自然成功轨迹','natural-success search')}</span></article>
    </div>

    <details class="technical-details"><summary>{t('技术细节：为什么同叫 WebShop，也可能不是同一个实验？','Technical detail: why two “WebShop” experiments may still differ')}</summary><p>{t('商品快照、Lucene index、goal split、environment seed、generation seed、prompt、parser、step budget 与 evaluator 都会改变实际任务合同。因此当前实验把这些身份写入 manifest，而不是只写 benchmark 名称。','Product snapshot, Lucene index, goal split, environment seed, generation seed, prompt, parser, step budget, and evaluator all affect the actual contract. The current experiment therefore records these identities in manifests instead of relying on the benchmark name alone.')}</p></details>
  </article>

  <article class="benchmark-card alfworld-card">
    <header class="benchmark-title"><div><span>TEXT / EMBODIED HOUSEHOLD</span><h3>ALFWorld</h3></div><p>{t('ALFWorld 把 ALFRED 的家务目标对齐到 TextWorld 文本世界，也能映射到 THOR 具身环境。核心难点不是检索商品，而是满足动作前置条件并完成多步物体状态变化。','ALFWorld aligns ALFRED household goals with a TextWorld world and can also map them to THOR. The core challenge is not product retrieval but satisfying action preconditions and completing multi-step object-state changes.')}</p></header>

    <div class="scene alfworld-scene" role="img" aria-label={t('ALFWorld 从 ALFRED、数据 split、六类任务到 observation-action-world-state-goal-progress 循环','ALFWorld pipeline from ALFRED and dataset splits through six task types into the observation-action-world-state-goal-progress loop')}>
      <article class="scene-node alfred"><span class="node-role">SOURCE TASKS</span><strong>ALFRED</strong><small>{t('家务目标 + PDDL 世界定义','household goals + PDDL world definition')}</small></article>
      <article class="scene-node world"><span class="node-role">ALIGNED WORLD</span><strong>ALFWorld</strong><div class="mini-options"><span class="current">AlfredTWEnv</span><span>AlfredThorEnv</span><span>Hybrid</span></div><small>{t('SEED 当前文本实验使用 AlfredTWEnv','SEED’s current text setup uses AlfredTWEnv')}</small></article>
      <article class="scene-node splits"><span class="node-role">DATA SPLITS</span><strong>train / valid_seen / valid_unseen</strong><small>{t('seen 检查同分布泛化，unseen 检查未见场景/组合','seen measures in-distribution generalization; unseen measures unseen scenes/combinations')}</small></article>
      <article class="scene-node alf-observation"><span class="node-role">OBSERVATION</span><strong>{t('房间 / 物体 / 容器文本状态','room / object / receptacle text state')}</strong><small>{t('只看到当前可描述世界','only the currently described world is visible')}</small></article>
      <article class="scene-node alf-policy"><span class="node-role">POLICY</span><strong>{t('规划下一步家务动作','plan the next household action')}</strong><small>goto · pick · put · open · clean · heat · cool · examine …</small></article>
      <article class="scene-node transition"><span class="node-role">WORLD TRANSITION</span><strong>{t('检查前置条件并改变物体状态','check preconditions and mutate object state')}</strong><small>{t('例如先找到杯子，再拿取、清洗、放入目标容器','for example locate a cup, pick it, clean it, then place it')}</small></article>
      <article class="scene-node progress"><span class="node-role">GOAL / REWARD</span><strong>10 × won</strong><small>{t('文本模式按最终成功；多模态模式还可加入 goal-condition success rate','text mode uses final success; multimodal mode can also include goal-condition success rate')}</small></article>
      <svg class="scene-wires" viewBox="0 0 1200 510" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <marker id="alf-arrow-blue" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#2563eb" /></marker>
          <marker id="alf-arrow-violet" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#7c3aed" /></marker>
          <marker id="alf-arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#059669" /></marker>
        </defs>
        <path class="wire data" d="M245 112 C325 112 390 112 455 112" marker-end="url(#alf-arrow-blue)" />
        <path class="wire data" d="M682 112 C755 112 820 112 885 112" marker-end="url(#alf-arrow-blue)" />
        <path class="wire data" d="M1000 172 C1000 230 870 235 785 258" marker-end="url(#alf-arrow-blue)" />
        <path class="wire state" d="M430 315 C485 315 515 315 558 315" marker-end="url(#alf-arrow-violet)" />
        <path class="wire state" d="M735 315 C790 315 820 315 865 315" marker-end="url(#alf-arrow-violet)" />
        <path class="wire feedback" d="M965 370 C900 455 455 455 345 375" marker-end="url(#alf-arrow-blue)" />
        <path class="wire persist" d="M970 350 C1040 350 1080 350 1112 350" marker-end="url(#alf-arrow-green)" />
      </svg>
      <span class="flow-label label-transition">{t('物体 / 容器状态改变','object / receptacle state changes')}</span>
      <span class="flow-label label-feedback">{t('新的世界描述继续进入下一步','new world description continues the loop')}</span>
    </div>

    <div class="task-family" aria-label={t('ALFWorld 六类任务','Six ALFWorld task families')}>
      {taskTypes.map((name,index)=><span><b>{index+1}</b>{name}</span>)}
    </div>

    <details class="technical-details"><summary>{t('技术细节：seen / unseen 到底在测试什么？','Technical detail: what do seen / unseen evaluate?')}</summary><p>{t('ALFWorld 的 train、valid_seen、valid_unseen 是环境数据 split，不等于我们论文实验中任何自定义 train/dev/test 名称。复现实验时必须同时记录 ALFWorld 原始 split 和上层实验如何抽样这些任务。','ALFWorld train, valid_seen, and valid_unseen are environment-level splits; they are not automatically identical to custom train/dev/test names in a paper experiment. Reproduction should record both the original ALFWorld split and the upper-level task sampling policy.')}</p></details>
  </article>

  <ResearchDiagramLegend locale={locale} />
</section>

<style>
.benchmark-architecture{--env:#2563eb;--experience:#d97706;--signal:#dc2626;--state:#7c3aed;--persist:#059669;--cyan:#0891b2;width:min(1180px,calc(100% - 2rem));margin:2rem auto;padding:1.2rem;border:1px solid var(--line);border-radius:24px;background:radial-gradient(circle at 15% 0,color-mix(in srgb,var(--env) 7%,transparent),transparent 30%),var(--surface);box-shadow:0 22px 70px color-mix(in srgb,#000 8%,transparent)}.benchmark-architecture--compact{margin:1.2rem auto}.diagram-head{max-width:930px}.diagram-head>span{color:var(--env);font:850 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.diagram-head h2{margin:.38rem 0 .55rem}.diagram-head p{margin:0;color:var(--muted);line-height:1.68}.principle-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:1rem 0}.principle-strip article{padding:.65rem .72rem;border:1px solid var(--line);border-radius:11px;background:var(--surface-muted)}.principle-strip small,.principle-strip strong{display:block}.principle-strip small{color:var(--muted);font-size:.56rem}.principle-strip strong{margin-top:.2rem;font-size:.67rem;line-height:1.38}.benchmark-card{margin-top:.85rem;padding:1rem;border:1.5px solid;border-radius:19px;background:color-mix(in srgb,var(--surface) 98%,transparent)}.webshop-card{border-color:color-mix(in srgb,var(--env) 40%,var(--line));box-shadow:inset 5px 0 color-mix(in srgb,var(--env) 75%,transparent)}.alfworld-card{border-color:color-mix(in srgb,var(--state) 40%,var(--line));box-shadow:inset 5px 0 color-mix(in srgb,var(--state) 75%,transparent)}.benchmark-title{display:grid;grid-template-columns:minmax(180px,.35fr) 1fr;gap:1rem;align-items:start}.benchmark-title span{color:var(--muted);font:850 .58rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.benchmark-title h3{margin:.2rem 0 0;font-size:1.18rem}.benchmark-title p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.55}.scene{position:relative;isolation:isolate;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:auto auto;gap:1.35rem .75rem;min-height:480px;margin-top:1rem;padding:.85rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface-muted) 65%,transparent),var(--surface));overflow:hidden}.webshop-scene{grid-template-areas:"corpus snapshot goal goal" "observation policy action verifier"}.alfworld-scene{grid-template-areas:"alfred world splits splits" "alf-observation alf-policy transition progress"}.scene:before{content:"";position:absolute;left:0;right:0;top:48%;border-top:1px dashed color-mix(in srgb,var(--muted) 24%,transparent)}.scene-node{z-index:2;align-self:center;min-height:112px;padding:.72rem;border:1.5px solid var(--line);border-radius:13px;background:color-mix(in srgb,var(--surface) 96%,transparent);box-shadow:0 10px 24px color-mix(in srgb,#000 6%,transparent);backdrop-filter:blur(5px)}.scene-node .node-role{display:block;color:var(--muted);font:850 .53rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.scene-node strong,.scene-node small{display:block}.scene-node strong{margin:.3rem 0;font-size:.7rem;line-height:1.3}.scene-node small{color:var(--muted);font-size:.58rem;line-height:1.42}.corpus{grid-area:corpus;border-top:5px solid var(--env)}.snapshot{grid-area:snapshot;border-top:5px solid var(--persist)}.goal{grid-area:goal;justify-self:center;width:70%;border-top:5px solid var(--experience)}.observation{grid-area:observation;border-top:5px solid var(--env)}.policy{grid-area:policy;border-top:5px solid var(--state)}.action{grid-area:action;border-top:5px solid var(--state)}.verifier{grid-area:verifier;border-top:5px solid var(--persist)}.alfred{grid-area:alfred;border-top:5px solid var(--experience)}.world{grid-area:world;border-top:5px solid var(--env)}.splits{grid-area:splits;justify-self:center;width:70%;border-top:5px solid var(--persist)}.alf-observation{grid-area:alf-observation;border-top:5px solid var(--env)}.alf-policy{grid-area:alf-policy;border-top:5px solid var(--state)}.transition{grid-area:transition;border-top:5px solid var(--state)}.progress{grid-area:progress;border-top:5px solid var(--persist)}.mini-options{display:flex;gap:.28rem;flex-wrap:wrap;margin:.42rem 0}.mini-options span{padding:.22rem .34rem;border:1px solid var(--line);border-radius:6px;background:var(--surface-muted);font:720 .5rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace}.mini-options .current{border-color:color-mix(in srgb,var(--env) 48%,var(--line));color:var(--env);background:color-mix(in srgb,var(--env) 7%,var(--surface))}.scene-wires{z-index:1;position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.wire{fill:none;stroke-width:4;vector-effect:non-scaling-stroke}.wire.data,.wire.feedback{stroke:var(--env)}.wire.state{stroke:var(--state)}.wire.persist{stroke:var(--persist)}.wire.feedback{stroke-dasharray:10 8;animation:benchmarkDash 5s linear infinite}.flow-label{z-index:3;position:absolute;padding:.2rem .36rem;border:1px solid var(--line);border-radius:999px;background:var(--surface);font:730 .5rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;box-shadow:0 4px 12px color-mix(in srgb,#000 5%,transparent)}.label-transition{right:15%;top:49%;color:var(--state)}.label-feedback{left:37%;bottom:4%;color:var(--env)}.split-model{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.38rem;margin-top:.55rem}.split-model article{padding:.55rem;border:1px solid var(--line);border-radius:9px;background:var(--surface-muted)}.split-model article.active{border-color:color-mix(in srgb,var(--experience) 45%,var(--line));background:color-mix(in srgb,var(--experience) 6%,var(--surface))}.split-model article.next{border-color:color-mix(in srgb,var(--persist) 45%,var(--line));background:color-mix(in srgb,var(--persist) 6%,var(--surface))}.split-model small,.split-model strong,.split-model span{display:block}.split-model small{color:var(--muted);font-size:.51rem}.split-model strong{margin:.2rem 0;font-size:.6rem}.split-model span{color:var(--muted);font-size:.54rem}.task-family{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.3rem;margin-top:.55rem}.task-family span{display:flex;align-items:center;gap:.28rem;padding:.45rem;border:1px solid color-mix(in srgb,var(--experience) 25%,var(--line));border-radius:8px;background:color-mix(in srgb,var(--experience) 4%,var(--surface));font-size:.55rem}.task-family b{display:grid;place-items:center;width:18px;height:18px;border-radius:999px;background:color-mix(in srgb,var(--experience) 14%,var(--surface));color:var(--experience);font-size:.52rem}.technical-details{margin-top:.55rem;border:1px solid var(--line);border-radius:10px;background:var(--surface-muted)}.technical-details summary{cursor:pointer;padding:.62rem .7rem;font-size:.61rem;font-weight:800}.technical-details p{margin:0;padding:0 .7rem .7rem;color:var(--muted);font-size:.58rem;line-height:1.48}@keyframes benchmarkDash{to{stroke-dashoffset:-36}}@media(prefers-reduced-motion:reduce){.wire.feedback{animation:none}}@media(max-width:900px){.principle-strip{grid-template-columns:1fr}.benchmark-title{grid-template-columns:1fr}.scene{grid-template-columns:1fr;grid-template-rows:auto;grid-template-areas:none!important;min-height:auto}.scene-node{grid-area:auto!important;width:100%!important}.scene-wires,.flow-label,.scene:before{display:none}.scene-node:not(:last-of-type):after{content:"";position:absolute;left:50%;bottom:-1.35rem;width:3px;height:1.35rem;background:color-mix(in srgb,var(--muted) 45%,transparent)}.split-model{grid-template-columns:1fr 1fr}.task-family{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.benchmark-architecture{width:min(100% - 1rem,1180px);padding:.8rem}.split-model,.task-family{grid-template-columns:1fr}}
</style>
