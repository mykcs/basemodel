---
/**
 * Reader-first conceptual displays for the advisor's ten questions.
 * These are teaching diagrams, never substitutes for paper plots or sealed results.
 * No numerical observation is synthesized by this component.
 */
type Variant = 'q02' | 'q03' | 'q05' | 'q06' | 'q07' | 'q10';
interface Props { variant: Variant }
const {variant} = Astro.props;
import MathFormula from '../common/MathFormula.astro';
import ExternalBrandMark from '../common/ExternalBrandMark';
const q07EvidenceHref = 'https://github.com/mykcs/openevo-experiment/blob/a64ca196765671ca14131aa4558a836133c8a6b3/docs/evidence/advisor-q07-task-vector-causal-20261001/Q07_CAUSAL_EFFECTS.csv';
// Bounded OFF R152–R159 reverse-versus-intact Task Score differences, multiplied
// by 100 from the sealed reward-scale CSV. Only R156 passes eight-way Holm.
// https://github.com/mykcs/openevo-experiment/blob/a64ca196765671ca14131aa4558a836133c8a6b3/docs/evidence/advisor-q07-task-vector-causal-20261001/Q07_CAUSAL_EFFECTS.csv
const q07ReverseEffects = [
  {round: 152, decrease: '2.98', holm: false},
  {round: 153, decrease: '8.34', holm: false},
  {round: 154, decrease: '6.23', holm: false},
  {round: 155, decrease: '6.85', holm: false},
  {round: 156, decrease: '10.06', holm: true},
  {round: 157, decrease: '4.48', holm: false},
  {round: 158, decrease: '3.48', holm: false},
  {round: 159, decrease: '3.92', holm: false},
] as const;
---

{variant === 'q02' && (
  <section class="advisor-intel" data-advisor-concept="q02" aria-labelledby="advisor-intel-q02-title">
    <p class="advisor-intel__kicker">Q02 · 初始参数训练机制示意</p>
    <h4 id="advisor-intel-q02-title">SFT 和 OPSD 到底有什么不同？</h4>
    <p class="advisor-intel__lead">SFT <strong>模仿已有答案</strong>，OPSD <strong>蒸馏额外经验</strong>；两条路线最终都更新学生 LoRA。前期 32 题成绩接近，<strong>目前还不能选出赢家</strong>。</p>
    <div class="advisor-intel__q02-mechanism" data-q02-mechanism role="group" aria-label="同一批离线训练记录分别走 SFT 答案监督和 OPSD 冻结教师分布蒸馏，最终都更新学生 LoRA">
      <div class="advisor-intel__seed advisor-intel__q02-common" data-q02-common>
        <span>共同输入</span><strong>同一批 WebShop 离线训练记录</strong>
      </div>
      <svg class="advisor-intel__fork-wires advisor-intel__fork-wires--two" data-q02-fork-wires viewBox="0 0 900 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M450 0V26H225V68M450 26H675V68" />
      </svg>
      <div class="advisor-intel__q02-tracks" data-q02-tracks role="group" aria-label="SFT 与 OPSD 的训练信息流并列对照">
        <div class="advisor-intel__q02-route advisor-intel__q02-route--sft" data-q02-track="sft" role="group" aria-label="SFT：模仿已有答案">
          <div class="advisor-intel__q02-route-head"><span>SFT</span><strong>模仿已有答案</strong></div>
          <div class="advisor-intel__q02-node advisor-intel__q02-node--shared" data-q02-task>同一任务 <var>x</var></div>
          <span class="advisor-intel__q02-arrow" aria-hidden="true">↓</span>
          <div class="advisor-intel__q02-node" data-q02-supervision><strong>历史答案 <var>y</var></strong><small>直接使用已有回答作为监督目标</small></div>
          <span class="advisor-intel__q02-arrow" aria-hidden="true">↓</span>
          <div class="advisor-intel__q02-node" data-q02-objective><strong>逐 token 交叉熵（CE）</strong><small>学习复现参考答案的 token</small></div>
          <span class="advisor-intel__q02-arrow" aria-hidden="true">↓</span>
          <div class="advisor-intel__q02-node advisor-intel__q02-node--update" data-q02-update><strong>更新学生 LoRA</strong></div>
        </div>
        <div class="advisor-intel__q02-route advisor-intel__q02-route--opsd" data-q02-track="opsd" role="group" aria-label="OPSD：蒸馏额外经验">
          <div class="advisor-intel__q02-route-head"><span>OPSD</span><strong>蒸馏额外经验</strong></div>
          <div class="advisor-intel__q02-node advisor-intel__q02-node--shared" data-q02-task>同一任务 <var>x</var></div>
          <span class="advisor-intel__q02-arrow" aria-hidden="true">↓</span>
          <div class="advisor-intel__q02-node" data-q02-supervision><strong>经验摘要（episode-skill）</strong><small>冻结教师 → 目标 token 分布</small></div>
          <span class="advisor-intel__q02-arrow" aria-hidden="true">↓</span>
          <div class="advisor-intel__q02-node" data-q02-objective><strong>广义 JSD / 分布蒸馏</strong><small>学习教师给出的概率分布</small></div>
          <span class="advisor-intel__q02-arrow" aria-hidden="true">↓</span>
          <div class="advisor-intel__q02-node advisor-intel__q02-node--update" data-q02-update><strong>更新学生 LoRA</strong></div>
        </div>
      </div>
    </div>
    <div class="advisor-intel__foot"><strong>进展：15 / 18 个评测位置已有结果。</strong>还差 3 个评测位置，以及完成后在同题条件下比较长期学习表现。</div>
    <p class="advisor-intel__disclaimer">图中两条路线只比较训练信号：OPSD 的教师冻结、不被更新；两者都是更新学生 LoRA。它不是得分优劣图，早期 32 题与未闭合的正式匹配评测不能证明哪种起点更好。</p>
  </section>
)}

{variant === 'q03' && (
  <section class="advisor-intel" data-advisor-concept="q03" aria-labelledby="advisor-intel-q03-title">
    <p class="advisor-intel__kicker">Q03 · 为什么还不能说复现成功</p>
    <h4 id="advisor-intel-q03-title">代码跑通、拿到分数，还不等于复现了论文。</h4>
    <p class="advisor-intel__lead">目前已经有真实开发题成绩。<strong>但测试卷和考试规则还没有与 SEED 论文严格对齐</strong>，分数不能直接相减。</p>
    <table class="advisor-intel__protocol" data-q03-protocol>
      <caption>复现比较要先核对的四项条件</caption>
      <thead><tr><th scope="col">条件</th><th scope="col">目前本地开发验证</th><th scope="col">与 SEED 论文的关系</th></tr></thead>
      <tbody>
        <tr><th scope="row">任务题单</th><td>当前冻结的开发题</td><td>论文报告另一组题；未证明逐题相同</td></tr>
        <tr><th scope="row">模型起点</th><td>本地工程保存点</td><td>尚未完成同一起点核对</td></tr>
        <tr><th scope="row">训练流程</th><td>已有工程评测；正式 SFT 与 Stage2 尚未启动</td><td>缺对应训练后的正式终评</td></tr>
        <tr><th scope="row">提示与评测</th><td>本地开发协议</td><td>提示、环境规则及评分协议仍须逐项对齐</td></tr>
      </tbody>
    </table>
    <div class="advisor-intel__foot"><strong>已测到：</strong>三组工程模型共 1,536 次开发题尝试。<strong>还不能做：</strong>把本地开发分数和论文数字直接相减、排出优劣。</div>
  </section>
)}

{variant === 'q05' && (
  <section class="advisor-intel" data-advisor-concept="q05" aria-labelledby="advisor-intel-q05-title">
    <p class="advisor-intel__kicker">Q05 · 写入幅度 β</p>
    <h4 id="advisor-intel-q05-title">写进多少新经验？三种策略，可以直接比较。</h4>
    <p class="advisor-intel__lead">相同的一次原始参数更新，可以完整写入、写入一半，或让规则自适应选择比例。<strong>这是待比较的设计选择，不是三项已证实的收益。</strong></p>
    <p class="advisor-intel__fork-instruction">一次原始参数更新只能选<strong>一种</strong>写入政策。点击分支，查看向量会走多远。</p>
    <div class="advisor-intel__fork" data-q05-fork>
      <div class="advisor-intel__fork-root" data-q05-fork-root>共同输入：这轮学到的原始更新 <MathFormula latex={String.raw`\Delta_{\mathrm{raw}}`} display={false} /></div>
      <svg class="advisor-intel__fork-wires" data-q05-fork-wires viewBox="0 0 900 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M450 0V26H150V68M450 26V68M450 26H750V68" />
      </svg>
      <fieldset class="advisor-intel__picker advisor-intel__picker--fork" data-q05-policies>
        <legend class="advisor-intel__visually-hidden">三种互斥写入策略</legend>
        <label data-q05-branch="full"><input type="radio" name="advisor-q05-beta" value="full" checked /><span><strong>完整写入</strong><small><MathFormula latex={String.raw`\beta=1`} display={false} /></small><em>输出：整段更新</em></span></label>
        <label data-q05-branch="half"><input type="radio" name="advisor-q05-beta" value="half" /><span><strong>固定一半</strong><small><MathFormula latex={String.raw`\beta=0.5`} display={false} /></small><em>输出：半段更新</em></span></label>
        <label data-q05-branch="adaptive"><input type="radio" name="advisor-q05-beta" value="adaptive" /><span><strong>自适应</strong><small>按训练 NLL 选 β</small><em>输出：四档之一</em></span></label>
      </fieldset>
    </div>
    <div class="advisor-intel__scale" role="group" aria-label="教学数轴：从零写入到完整写入，选择不同 β 会改变向量长度；不对应真实模型性能">
      <div class="advisor-intel__scale-head"><span>写入比例 β</span><span>箭头长度只表示更新幅度</span></div>
      <div class="advisor-intel__scale-rail" aria-hidden="true"><span class="advisor-intel__scale-quarter"></span><span class="advisor-intel__scale-half"></span><span class="advisor-intel__scale-three-quarter"></span><span class="advisor-intel__scale-arrow"></span><span class="advisor-intel__scale-choices"><i></i><i></i><i></i><i></i></span></div>
      <div class="advisor-intel__scale-ticks" aria-hidden="true"><span>0</span><span>0.25</span><span>0.5</span><span>0.75</span><span>1</span></div>
      <div class="advisor-intel__scale-reading" aria-live="polite" aria-atomic="true">
        <p class="advisor-intel__scale-caption" data-q05-panel="full">选中 <MathFormula latex={String.raw`\beta=1`} display={false} />：原始更新完整写入，向量长度为 100%（仅是几何比例）。</p>
        <p class="advisor-intel__scale-caption" data-q05-panel="half">选中 <MathFormula latex={String.raw`\beta=0.5`} display={false} />：同一更新向量的写入长度减半；不代表成绩减半。</p>
        <p class="advisor-intel__scale-caption" data-q05-panel="adaptive">自适应：根据训练 NLL，从 <MathFormula latex={String.raw`\beta\in\{0.25,0.5,0.75,1\}`} display={false} /> 四档中选择；数轴没有唯一固定落点。</p>
      </div>
    </div>
    <div class="advisor-intel__formula"><MathFormula latex={String.raw`\Delta_{\mathrm{write}}=\beta\,\Delta_{\mathrm{raw}}`} label="β 对原始更新向量的缩放" /><p>β 非负时，改变的是这一步的幅度，不是把方向倒过来。</p></div>
    <div class="advisor-intel__foot"><strong>β 决定这一步走多远，不直接决定朝哪走。</strong>这里的三条分支互斥，不是一次训练叠加三次写入。历史复杂 β/GDR 与这些简化政策不是同一试验；压缩之后的方向与长期成绩仍需另测。</div>
  </section>
)}

{variant === 'q06' && (
  <section class="advisor-intel" data-advisor-concept="q06" aria-labelledby="advisor-intel-q06-title">
    <p class="advisor-intel__kicker">Q06 · 候选动作的分叉</p>
    <h4 id="advisor-intel-q06-title">Agent 在“下一步点哪里”之间犹豫，我们能提前发现失误吗？</h4>
    <p class="advisor-intel__lead">重点是同一个页面状态下的<strong>合法候选动作</strong>怎样竞争，而不只是模型最后点中了哪一个。</p>
    <div class="advisor-intel__decision-tree" data-q06-fork role="group" aria-label="同一购物页面的合法动作候选共属一个决策分叉，三个显示动作仅是例子">
      <div class="advisor-intel__fork-root" data-q06-fork-root>同一个购物页面：Agent 要决定下一步操作</div>
      <svg class="advisor-intel__decision-root-link" data-q06-root-link viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M50 0V24" /></svg>
      <div class="advisor-intel__legal-set" data-q06-legal-set>
        <strong>当前页面的全部合法候选动作</strong>
        <span>只在这个完整集合内重新归一化，条件概率总和才是 <b>100%</b>。</span>
      </div>
      <svg class="advisor-intel__fork-wires" data-q06-fork-wires viewBox="0 0 900 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M450 0V26H150V68M450 26V68M450 26H750V68" />
      </svg>
      <ol class="advisor-intel__decision-options" data-q06-illustrative-options>
        <li data-q06-candidate="a"><span>例子 01</span><strong>打开商品 A</strong></li>
        <li data-q06-candidate="b"><span>例子 02</span><strong>打开商品 B</strong></li>
        <li data-q06-candidate="filter"><span>例子 03</span><strong>筛选尺码</strong></li>
      </ol>
      <div class="advisor-intel__decision-remainder" data-q06-remainder><span aria-hidden="true">···</span> 可能还有其他合法操作；上面三项不是完整清单，也不能把它们的概率当作已测得的 100%。</div>
      <p class="advisor-intel__decision-caption">这幅示意解释的是<strong>一次决策的候选集合</strong>，不是一条旧轨迹的真实概率柱状图。</p>
    </div>
    <p class="advisor-intel__disclaimer">非法动作不属于图中合法集合的条件概率分母；原始模型仍可能生成非法动作，需要另行统计。旧 R159 轨迹未保存 logits，不能还原这一时刻的概率或熵。</p>
    <div class="advisor-intel__foot"><strong>现阶段：</strong>已有其他保存点的候选概率与预测分析；“越犹豫越容易失败”还需要新题、独立模型起点来验证。</div>
  </section>
)}

{variant === 'q07' && (
  <section class="advisor-intel" data-advisor-concept="q07" aria-labelledby="advisor-intel-q07-title">
    <p class="advisor-intel__kicker">Q07 · 参数向量的方向</p>
    <h4 id="advisor-intel-q07-title">反转第 156 轮的更新，同一批题平均低了约 10 分。</h4>
    <p class="advisor-intel__lead">在 Bounded OFF 的第 156 轮，把真实更新向量反过来，同一批固定题上的平均 Task Score <strong>下降 10.06 分</strong>。这是一个有边界的局部因果结果。</p>
    <fieldset class="advisor-intel__picker" data-q07-directions>
      <legend>固定用第 156 轮示意：同一条更新向量有三种处理办法</legend>
      <label><input type="radio" name="advisor-q07-vector" value="original" checked /><span>原始方向 <small>+ Δ</small></span></label>
      <label><input type="radio" name="advisor-q07-vector" value="zero" /><span>删除更新 <small>0</small></span></label>
      <label><input type="radio" name="advisor-q07-vector" value="reverse" /><span>方向反转 <small>− Δ</small></span></label>
    </fieldset>
    <div class="advisor-intel__vector" role="group" aria-label="参数更新的概念数轴：原始更新指向正方向、删除停在零点、反转指向负方向，长度为示意">
      <span class="advisor-intel__vector-neg">− 更新方向</span><span class="advisor-intel__vector-pos">+ 更新方向</span>
      <div class="advisor-intel__vector-axis" aria-hidden="true"><i class="advisor-intel__vector-center"></i><i class="advisor-intel__vector-arrow"></i></div>
      <div class="advisor-intel__vector-reading" aria-live="polite" aria-atomic="true">
        <div class="advisor-intel__vector-text" data-q07-panel="original">原始：保留第 156 轮真实写入的更新向量。</div>
        <div class="advisor-intel__vector-text" data-q07-panel="zero">删除：把这轮更新设为零，不等于回到上一个模型保存点。</div>
        <div class="advisor-intel__vector-text" data-q07-panel="reverse">反转：把这轮向量乘以 −1；实测相对原始条件平均低 10.06 分。</div>
      </div>
    </div>
    <div class="advisor-intel__round-evidence" data-q07-round-evidence>
      <fieldset class="advisor-intel__round-picker" data-q07-rounds>
        <legend>独立查看八轮实测：选择另一轮只改变下面的成绩解释，不改变上方第 156 轮数轴示意</legend>
        {q07ReverseEffects.map(({round}) => (
          <label><input type="radio" name="advisor-q07-round" value={round} checked={round===156} /><span>{round}</span></label>
        ))}
      </fieldset>
      <div class="advisor-intel__round-result" aria-label="当前所选轮次的真实反转效果">
        {q07ReverseEffects.map(({round,decrease,holm}) => (
          <p data-q07-effect={round}>第 {round} 轮方向反转后，在同一批 64 道固定开发题上，平均 Task Score <strong>下降 {decrease} 分</strong>。{holm ? <b>八轮 Holm 校正后仍有统计证据。</b> : <span>八轮 Holm 校正后不足以确认这一轮有稳定下降。</span>}</p>
        ))}
      </div>
      <p class="advisor-intel__disclaimer">八轮均以完整的 Bounded OFF 模型为对照；删除更新的八组比较均未通过相同的 Holm 校正。<a href={q07EvidenceHref} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={q07EvidenceHref} />查看封存的逐轮效果与区间</a>。</p>
    </div>
    <p class="advisor-intel__disclaimer">向量长度是示意，不是实测参数范数；10.06 分只属于 Bounded OFF 第 156 轮的反转干预（配对 95% 区间为下降 5.60–15.02 分，且通过八次比较的校正），不能移植到 DirectApply R159。</p>
  </section>
)}

{variant === 'q10' && (
  <section class="advisor-intel advisor-intel--q10" data-advisor-concept="q10" aria-labelledby="advisor-intel-q10-title">
    <p class="advisor-intel__kicker">Q10 · 新任务泛化的证据边界</p>
    <h4 id="advisor-intel-q10-title">模型在新题上有过两次进步，但还不能宣布它学会了长期举一反三。</h4>
    <p class="advisor-intel__lead">好消息是真实的：在另一组 7B 模型条件下，两次<strong>单次参数更新</strong>的新题配对测量都出现正向平均奖励变化。要回答这十问的终极问题，还差一场更严格的长期检验。</p>
    <div class="advisor-intel__duo advisor-intel__duo--boundary" role="group" aria-label="Q10 已经知道和尚未证明的内容">
      <div class="advisor-intel__panel advisor-intel__panel--known"><span class="advisor-intel__tag">已经测到 · 局部证据</span><strong>单次更新能迁移一些效果</strong><p>两次测量相对基础模型的平均奖励变化：<b>+0.124</b> 和 <b>+0.249</b>（奖励标度 0–1），各自的 95% 区间下界大于零。</p><small>这是此前另一组模型上的一次更新，不是 160 轮训练成绩。</small></div>
      <div class="advisor-intel__panel advisor-intel__panel--pending"><span class="advisor-intel__tag">还不知道 · 正式 Q10</span><strong>学满 160 轮后，遇到全新题仍能进步吗？</strong><p>已冻结并排重 <b>128 道全新确认题</b>，但三条独立训练流及匹配对照尚未封存正式新题成绩。</p><small>任务身份冻结 ≠ 模型已经在这些题上通过评测。</small></div>
    </div>
    <div class="advisor-intel__foot"><strong>下一步：</strong>完成存储、恢复与资源门槛 → 同一起点执行独立训练及匹配对照 → 在 128 道新题上做逐题配对比较。ALFWorld 是未来不同环境的研究方向，不是本次已完成的数据。</div>
  </section>
)}

<style>
  .advisor-intel{--ai-ink:var(--paper-ink);--ai-muted:var(--paper-muted);--ai-line:var(--paper-line);--ai-paper:var(--paper);--ai-accent:var(--color-accent,var(--accent-deep));color:var(--ai-ink);min-width:0;margin:1.15rem 0 1.6rem;font-family:var(--font-interface)}
  .advisor-intel :is(p,h4){margin-block:0;line-height:1.6}
  .advisor-intel__kicker{font-size:var(--type-meta);font-weight:760;letter-spacing:.1em;color:var(--ai-accent);text-transform:uppercase}
  .advisor-intel h4{font-family:inherit;font-size:clamp(1.16rem,2.7vw,1.55rem);font-weight:770;letter-spacing:-.025em;line-height:1.38;margin:.32rem 0 .52rem;color:var(--ai-ink)}
