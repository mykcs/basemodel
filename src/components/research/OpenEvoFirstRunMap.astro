<script>
  document.querySelectorAll<HTMLElement>('[data-first-run-map]').forEach((root) => {
    const all = <T extends Element>(selector: string) => [...root.querySelectorAll<T>(selector)];
    const one = <T extends Element>(selector: string) => root.querySelector<T>(selector);
    const armButtons = all<HTMLButtonElement>('[data-first-run-arm]');
    const panels = all<HTMLElement>('[data-first-run-panel]');
    const layer = one<HTMLElement>('[data-first-run-detail-layer]');
    const card = one<HTMLElement>('[data-first-run-detail-card]');
    const title = one<HTMLElement>('[data-first-run-detail-title]');
    const content = one<HTMLElement>('[data-first-run-detail-content]');
    let activeTrigger: HTMLButtonElement | null = null;
    let bodyOverflow = '';

    const isMobile = () => window.matchMedia('(max-width: 720px)').matches;
    const selectArm = (arm: string) => {
      armButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.firstRunArm === arm)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.firstRunPanel !== arm; });
      closeDetail(false);
    };

    const closeDetail = (restoreFocus = true) => {
      if (!layer || layer.hidden) return;
      layer.hidden = true;
      all<HTMLButtonElement>('[data-first-run-detail]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
      if (card) {
        card.style.removeProperty('left');
        card.style.removeProperty('top');
        card.setAttribute('aria-modal', 'false');
      }
      document.body.style.overflow = bodyOverflow;
      const trigger = activeTrigger;
      activeTrigger = null;
      if (restoreFocus) trigger?.focus();
    };

    const positionDetail = (trigger: HTMLButtonElement) => {
      if (!layer || !card) return;
      if (isMobile()) { card.style.removeProperty('left'); card.style.removeProperty('top'); return; }
      const map = trigger.closest<HTMLElement>('.lineage-panel');
      const node = trigger.closest<HTMLElement>('.lineage-node, .patch-node');
      if (!map || !node) return;
      const parent = map.getBoundingClientRect();
      const anchor = node.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const gap = 14;
      let left = anchor.right - parent.left + gap;
      if (left + cardRect.width > parent.width) left = Math.max(0, anchor.left - parent.left - cardRect.width - gap);
      const top = Math.max(0, anchor.top - parent.top + anchor.height / 2 - cardRect.height / 2);
      card.style.left = `${left}px`;
      card.style.top = `${top}px`;
    };

    const openDetail = (trigger: HTMLButtonElement) => {
      if (!layer || !card || !title || !content) return;
      const key = trigger.dataset.firstRunDetail || '';
      const template = one<HTMLTemplateElement>(`[data-first-run-detail-template="${key}"]`);
      if (!template) return;
      if (!layer.hidden && activeTrigger === trigger) { closeDetail(); return; }
      all<HTMLButtonElement>('[data-first-run-detail]').forEach((button) => button.setAttribute('aria-expanded', String(button === trigger)));
      activeTrigger = trigger;
      title.textContent = trigger.closest<HTMLElement>('.lineage-node, .patch-node')?.querySelector('h3, strong')?.textContent?.trim() || '';
      content.replaceChildren(template.content.cloneNode(true));
      layer.hidden = false;
      if (isMobile()) {
        bodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        card.setAttribute('aria-modal', 'true');
      }
      requestAnimationFrame(() => { positionDetail(trigger); card.focus(); });
    };

    armButtons.forEach((button) => button.addEventListener('click', () => selectArm(button.dataset.firstRunArm || '7b')));
    all<HTMLButtonElement>('[data-first-run-detail]').forEach((button) => button.addEventListener('click', () => openDetail(button)));
    all<HTMLButtonElement>('[data-first-run-detail-close]').forEach((button) => button.addEventListener('click', () => closeDetail()));
    window.addEventListener('resize', () => { if (activeTrigger && layer && !layer.hidden) positionDetail(activeTrigger); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && layer && !layer.hidden) closeDetail(); });
  });
</script>

