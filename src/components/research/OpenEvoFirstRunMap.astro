---
import type { Locale } from '../../i18n';
import { localePath } from '../../i18n';
import ResearchOrientation from './ResearchOrientation.astro';
import ResearchJourney from './ResearchJourney.astro';
import ResearchDepth from './ResearchDepth.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const p = (path: string) => localePath(locale, path);

const links = {
  lobby: p('/research/seed-openevo/study/capability-exploration/'),
  oldStage2: p('/research/seed-openevo/study/capability-exploration/stage2-256-window/'),
  ceiling: p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/'),
  redesign: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/'),
  harness: p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/'),
  archive: p('/research/seed-openevo/study/capability-exploration/archive/'),
};
const terms = zh ? [
  { term: 'Stage 1', meaning: '先让模型自己跑 WebShop，形成第一批可学习经验；老师只在任务结束后分析。' },
  { term: 'Stage 2', meaning: '模型继续消费新经验并更新参数的阶段；第一轮 7B 与 3B 在这里走出了很不同的路径。' },
  { term: 'round', meaning: '第一轮 7B Stage2 的基本推进单位：每轮消费一批新的任务结果，再决定是否产生参数更新。' },
  { term: 'SD-LoRA component', meaning: '一次被接受的参数更新留下的 LoRA 组件；component 数量不是 replay buffer，也不是最终科学分数。' },
] : [
  { term: 'Stage 1', meaning: 'The model first acts on WebShop to create an initial experience corpus; the external teacher reviews only after tasks finish.' },
  { term: 'Stage 2', meaning: 'The model keeps consuming new experience and updating parameters. The first 7B and 3B lineages diverged sharply here.' },
  { term: 'round', meaning: 'The basic unit of the first 7B Stage 2: consume one new batch of task outcomes, then decide whether a parameter update is produced.' },
  { term: 'SD-LoRA component', meaning: 'A LoRA component left by one accepted parameter update; component count is not the replay buffer and not the final scientific score.' },
];
const summarySteps = zh ? [
  { id: 'stage1', kicker: '01 · STAGE 1', title: '两条模型线都先自己跑任务，收集第一批经验', summary: '180 个 WebShop 任务 × 8 次 = 1,440 条轨迹；MiniMax 只在轨迹发生以后分析。', detail: '这里先建立“模型原本能做什么”的起跑线，再把证据整理成后续学习输入。', outcome: '初始任务成绩记录模型自己的购物行为；外部分析在这些任务结束后进行。', state: '历史起点' },
  { id: 'stage2', kicker: '02 · STAGE 2', title: '7B 持续产生参数更新，旧 3B 实验暴露了购物接口问题', summary: '7B 持续产生参数更新。旧 3B 在后续完成 3,200 次尝试后停止；其中的接口问题需要单独检查，不能把全部失败归因于模型能力。', detail: '3B 出现动作解析错误和无效动作终止，因此需要区分接口错误与模型能力不足。', outcome: '7B 继续学习并完成测试；3B 重新设计接口，从新采集的经验开始。', state: '路径分叉' },
  { id: 'closeout', kicker: '03 · OUTCOME', title: '第一轮最终留下两种不同证据', summary: '7B 完成 149 轮学习后，在固定的 128 道测试题上得到 49.33 分，58 题完全成功。旧 3B 实验停止，相关发现推动了下一轮共同购物接口的设计。', detail: '这不是“7B 赢、3B 输”的简单排行榜，而是一次能跑深以后才看见的机制差异和测量风险。', outcome: '后续 3B + 1.7B 实验固定共同购物规则，重新收集初始经验。', state: '历史已封存' },
] : [
  { id: 'stage1', kicker: '01 · STAGE 1', title: 'Both lineages first act on their own to create experience', summary: '180 WebShop tasks × 8 rollouts = 1,440 trajectories; MiniMax reviews only after trajectories exist.', detail: 'This establishes what the model can already do before the evidence is turned into later learning inputs.', outcome: 'Initial task scores record the model’s own shopping behavior; external analysis takes place after those attempts end.', state: 'Historical start' },
  { id: 'stage2', kicker: '02 · STAGE 2', title: '7B learning ignited while the old 3B path exposed harness problems', summary: '7B sustained real SD-LoRA updates; the old 3B Stage 2 stopped after 3,200 rollouts instead of being simplified to “the model is too weak.”', detail: '3B action parsing and invalid termination showed that the interface itself could corrupt capability measurement.', outcome: '7B could continue toward a ceiling closeout; 3B had to restart from a fresh Stage-1 redesign.', state: 'Paths diverge' },
  { id: 'closeout', kicker: '03 · OUTCOME', title: 'The first campaign ultimately left two different kinds of evidence', summary: '7B: 49.33 score and 58/128 exact after 149 completed rounds; 3B: the old lineage stops and triggers the shared-harness successor.', detail: 'This is not a simple “7B wins, 3B loses” leaderboard; it is evidence about sustained learning and measurement risk.', outcome: 'The next map restarts the comparison under a shared 3B + 1.7B harness.', state: 'Historical closeout' },
];
---
<main data-copy-review class="first-run" data-first-run-map data-testid="openevo-first-run-map">
  <ResearchOrientation
    locale={locale}
    eyebrow="HISTORICAL MAP · FIRST RUN"
    title={t("第一轮购物学习：7B 与 3B 的分岔", "7B and 3B: first learning study")}
    lede={t("7B 能持续把经验用于参数更新；早期 3B 的失败则暴露了购物接口和动作格式问题。两条路线留下不同的证据。","7B sustained updates from experience. Early 3B failures exposed problems in the shopping interface.")}
    question={t("经验能否带来持续的模型更新？","Can experience produce sustained model updates?")}
    why={t("区分模型能力、接口错误和容量限制，才能设计下一轮。","Distinguish model capability, interface errors and capacity limits before the next design.")}
    start={t("7B 与 3B 各自收集初始购物经验，再进入后续学习。","7B and 3B collect initial shopping experience, then learn separately.")}
    finish={t("7B 完成 149 轮；旧 3B 在 3,200 次后续尝试后停止。","7B completes 149 rounds; old 3B stops after 3,200 later attempts.")}
    state={t("历史记录已封存。7B 已完成最终测试；旧 3B 已停止。","History is sealed. 7B completed final evaluation; old 3B stopped.")}
    stateTone="historical"
    backHref={links.lobby}
    backLabel={t('OpenEvo 能力探索', 'OpenEvo capability exploration')}
    actionHref="#first-run-summary"
    actionLabel={t("查看实验过程", "View the experiment sequence")}
    terms={terms}
  />

  <div id="first-run-summary"><ResearchJourney locale={locale} eyebrow="STAGE 1 → STAGE 2 → OUTCOME" title={t("初始经验、后续学习与最终结果", "Initial experience, later learning, and outcomes")} intro={t("两种模型各自收集经验，再分别进入学习；7B 完成最终测试，旧 3B 因接口问题停止。", "Each model collected experience and learned separately. 7B completed final evaluation; interface problems stopped the old 3B run.")} steps={summarySteps} /></div>

  <div id="first-run-lineages"><ResearchDepth locale={locale} kind="history" summary={t("7B 与 3B 的历史过程和证据", "Historical 7B and 3B runs and evidence")} intro={t("每个节点记录当时的规则、结果和修订。旧 3B 已停止，后来的实验使用新记录。", "Each node records the rules, results, and amendments at that time. The old 3B run stopped; the successor uses new records.")} >
  <aside class="first-run__prelude" aria-label={t('更早的 Stage 2 经验', 'Earlier Stage-2 evidence')}>
    <strong>{t('更早的一条 Stage 2 路线已经提醒过我们：成功轨迹存在，不等于参数真的会更新。', 'An earlier Stage-2 route had already shown that successful trajectories do not automatically become parameter updates.')}</strong>
    <span>{t("旧规则要求每批 256 次尝试中，至少 8 个不同任务各成功 2 次才更新参数；当时最好只有 7 个，成功经验因此未能触发更新。后来的 Ceiling-1.0 改成按轮处理新经验。", "The old rule required at least eight distinct tasks to succeed twice within each 256-attempt batch. The best batch reached seven, so successes did not trigger an update. The later Ceiling-1.0 processed new experience round by round.")}</span>
    <a href={links.oldStage2}>{t('查看旧 Stage 2 的完整证据 →', 'Open the old Stage-2 evidence →')}</a>
  </aside>

  <section class="arm-picker" aria-labelledby="arm-picker-title">
    <div>
      <p>{t("模型", "MODEL")}</p>
      <h2 id="arm-picker-title">{t("两种模型的历史过程", "Historical runs by model")}</h2>
    </div>
    <div class="arm-picker__controls" role="group" aria-label={t('选择 7B 或 3B', 'Choose 7B or 3B')}>
      <button type="button" data-first-run-arm="7b" aria-pressed="true">
        <strong>Qwen2.5-7B</strong>
        <small>{t("7B：持续学习与最终测试", "7B: sustained learning and final evaluation")}</small>
      </button>
      <button type="button" data-first-run-arm="3b" aria-pressed="false">
        <strong>Qwen2.5-3B</strong>
        <small>{t("3B：初始表现与购物接口问题", "3B: initial performance and interface problems")}</small>
      </button>
    </div>
  </section>

  <section class="lineage-map" aria-live="polite">
    <div class="lineage-panel" data-first-run-panel="7b">
      <header class="lineage-panel__head">
        <span>{t("7B · 已完成的历史实验", "7B · CLOSED HISTORICAL RUN")}</span>
        <strong>{t("7B 按固定规则完成 149 轮学习后，才用预定题目做最终测试。参数分析和远端归档在测试之后完成。", "7B completed 149 learning rounds under fixed rules before evaluation on predefined tasks. Parameter analysis and remote archival followed evaluation.")}</strong>
      </header>

      <div class="lineage-spine" aria-label={t('7B 历史实验主线', '7B historical experiment mainline')}>
        <article class="lineage-node lineage-node--mainline" data-node-kind="mainline" data-node-state="historical">
          <span>FLOOR 1 · STAGE 1</span>
          <h3>{t('先收集并整理 7B 的经验', 'Collect and prepare 7B experience')}</h3>
          <p>{t("180 个购物任务各尝试 8 次，留下 1,440 条记录；MiniMax 在购物结束后分析这些记录，再准备参数学习、记忆、技能和智能体的输入。", "Each of 180 shopping tasks was attempted eight times, producing 1,440 records. MiniMax analyzed them after shopping, before inputs for parameter learning, memory, skills, and agents were prepared.")}</p>
          <button type="button" data-first-run-detail="7b-stage1" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--mainline" data-node-kind="mainline" data-node-state="historical">
          <span>FLOOR 2 · STAGE 2</span>
          <h3>{t('每轮用新的 128 次任务继续训练', 'Continue training from each new 128-attempt round')}</h3>
          <p>{t('每轮重新收集一批任务结果，clean exact success 可以触发 SD-LoRA 更新；老师在 Stage 1 结束后退出。', 'Each round collects a fresh batch of task results. Clean exact success can trigger an SD-LoRA update, and the external teacher has already exited after Stage 1.')}</p>
          <button type="button" data-first-run-detail="7b-stage2" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--mainline" data-node-kind="mainline" data-node-state="historical">
          <span>{t('学习真的点燃了', 'LEARNING IGNITED')}</span>
          <h3>{t('7B 开始持续产生真实参数更新', '7B begins producing sustained parameter updates')}</h3>
          <p>{t('这条线证明 Stage 2 不再是“收集很多成功轨迹，但参数一次都不动”。成功可以真正进入 SD-LoRA；单轮分数会波动，但学习链条已经点燃。', 'This lineage shows that Stage 2 is no longer “collect many successes while parameters never move.” Success can become a real SD-LoRA update; individual rounds can fluctuate, but the learning chain is active.')}</p>
          <button type="button" data-first-run-detail="7b-ignition" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--amendment" data-node-kind="scientific-amendment" data-node-state="historical">
          <span>SCIENTIFIC AMENDMENT</span>
          <h3>{t('放宽参数学习容量', 'Allow more parameter-learning capacity')}</h3>
          <p>{t('原实现会在累计 64 个 SD-LoRA component 后停止继续增加 component。7B 还有剩余训练预算，所以这条独立停止线被解除。', 'The original implementation stopped adding SD-LoRA components once the stream reached 64 components. The 7B run still had training budget left, so that independent stop was removed.')}</p>
          <button type="button" data-first-run-detail="capacity" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector" aria-hidden="true"></span>

        <div class="run-with-patch">
          <article class="lineage-node lineage-node--mainline" data-node-kind="mainline" data-node-state="frozen">
            <span>FINAL CLOSEOUT · 2026-09-04</span>
            <h3>{t('149 个完整 round 后封存：49.33 分，58 / 128 完整成功', 'Sealed after 149 completed rounds: 49.33 score and 58 / 128 exact successes')}</h3>
            <p>{t('最终 checkpoint 使用 round 0–148，共 19,072 条 accepted Stage-2 rollout、143 个 SD-LoRA component。partial round149 的 96 条只留 provenance，不进入 checkpoint。final panel 在 checkpoint 冻结后只打开一次。', 'The final checkpoint uses rounds 0–148: 19,072 accepted Stage-2 rollouts and 143 SD-LoRA components. The 96 rollouts from partial round149 remain provenance only and do not enter the checkpoint. The final panel was opened exactly once after checkpoint freeze.')}</p>
            <button type="button" data-first-run-detail="frozen-7b" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
          </article>
          <aside class="patch-node" data-node-kind="engineering-fix" data-node-state="resolved">
            <span>{t('已解决的工程修复', 'RESOLVED ENGINEERING FIX')}</span>
            <strong>{t('修复训练运行问题', 'Fix training-run issues')}</strong>
            <small>{t('恢复、训练代码来源、provenance、冷归档；不改科学问题。', 'Resume, trainer-source, provenance, and cold-archive fixes without changing the scientific question.')}</small>
            <button type="button" data-first-run-detail="runtime-fixes" aria-expanded="false">+ {t('查看', 'Open')}</button>
          </aside>
        </div>
        <span class="lineage-connector lineage-connector--future" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--diagnostic" data-node-kind="evidence" data-node-state="resolved">
          <span>{t('POST-RUN PARAMETER ANALYSIS', 'POST-RUN PARAMETER ANALYSIS')}</span>
          <h3>{t('143 个 component 的最终参数几何已经封口', 'Final parameter geometry is closed through 143 components')}</h3>
          <p>{t('full-W 的 RMS / spectral / stable-rank 里程碑分析覆盖到 132 components；最终 exact Task-Vector geometry 补到 143：update stable rank 16.55，95% energy rank 77，最后 139–143 的 residual-energy 中位数 0.0597。另有 K64/K80/K96 function intervention 检查压缩方向是否改变决策。', 'Full-W RMS / spectral / stable-rank milestone analysis reaches 132 components; exact final Task-Vector geometry extends to 143: update stable rank 16.55, 95% energy rank 77, and median residual energy 0.0597 over components 139–143. K64/K80/K96 function interventions separately test whether reduced task-vector capacity changes decisions.')}</p>
          <button type="button" data-first-run-detail="future-compression" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
      </div>

      <section class="lineage-outcome" aria-labelledby="outcome-7b-title">
        <p>OUTCOME</p>
        <h2 id="outcome-7b-title">{t('7B 这条线留下了什么？', 'What did the 7B lineage teach us?')}</h2>
        <ul>
          <li>{t('Stage 2 可以真的持续学习：149 个完整 round 最终形成 143 个 SD-LoRA component。', 'Stage 2 can sustain real learning: 149 completed rounds ultimately produced 143 SD-LoRA components.')}</li>
          <li>{t('最终 128 题：Task Score ×100 = 49.33，完整成功 58/128 = 45.31%；SEED 89.7 / 78.1 只作为论文报告参考值，不冒充本地 paired reproduction。', 'Final 128 tasks: Task Score ×100 = 49.33 and exact success = 58/128 = 45.31%; SEED 89.7 / 78.1 is shown only as a paper-reported reference, not a local paired reproduction.')}</li>
          <li>{t('工程容量不能偷偷冒充科学终点：64-component guard 必须作为显式 amendment 处理。', 'Engineering capacity cannot silently become the scientific endpoint: the 64-component guard needs an explicit amendment boundary.')}</li>
          <li>{t('长跑修复要与科学修改分层：恢复和归档问题可以修，但不能顺手改实验问题。', 'Long-run repairs must stay separate from scientific changes: resume and archive issues can be fixed without quietly redefining the experiment.')}</li>
        </ul>
        <a href={links.ceiling}>{t('查看 Ceiling-1.0 的完整实验页与证据 →', 'Open the full Ceiling-1.0 experiment and evidence →')}</a>
      </section>
    </div>

    <div class="lineage-panel" data-first-run-panel="3b" hidden>
      <header class="lineage-panel__head">
        <span>{t('3B · STOPPED HISTORICAL LINEAGE', '3B · STOPPED HISTORICAL LINEAGE')}</span>
        <strong>{t('3B 没有被简单归类为“模型太弱”。它让我们发现旧 Harness 本身会改变 action validity，因此这条线停下来做诊断。', '3B was not simply labeled “too weak.” It exposed that the old harness itself could change action validity, so this lineage stopped for diagnosis.')}</strong>
      </header>

      <div class="lineage-spine lineage-spine--3b" aria-label={t('3B 历史实验主线', '3B historical experiment mainline')}>
        <article class="lineage-node lineage-node--mainline" data-node-kind="mainline" data-node-state="historical">
          <span>FLOOR 1 · STAGE 1</span>
          <h3>{t('先完成旧版 3B Stage 1', 'Complete the old 3B Stage 1')}</h3>
          <p>{t('这批 1,440 条轨迹后来证明成功太稀少，而且 action parsing / invalid termination 也会干扰我们判断模型到底会不会做题。', 'These 1,440 trajectories later showed very sparse success, while action parsing and invalid termination also interfered with the question of what the model could actually do.')}</p>
          <button type="button" data-first-run-detail="3b-stage1" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--blocked" data-node-kind="mainline" data-node-state="stopped">
          <span>{t('过早进入 Stage 2', 'PREMATURE STAGE 2')}</span>
          <h3>{t('旧 3B Stage 2 跑了 3,200 条后被封存', 'The old 3B Stage 2 was sealed after 3,200 rollouts')}</h3>
          <p>{t('这 3,200 条保留为 premature-lineage 证据，但不能成为以后新 Harness Stage 2 的合法前缀。', 'Those 3,200 rollouts remain premature-lineage evidence, but they cannot become the legal prefix of a later Stage 2 under the new harness.')}</p>
          <button type="button" data-first-run-detail="3b-premature" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--diagnostic" data-node-kind="evidence" data-node-state="stopped">
          <span>HARNESS DIAGNOSIS</span>
          <h3>{t('把“学习不起来”继续追到行动接口', 'Trace “learning does not ignite” back to the action interface')}</h3>
          <p>{t('Harness201 G3 的 round0 出现 33/128 invalid termination。这个结果没有被拿来临时降低门槛，而是把旧 attempt 封存为 HOLD evidence。', 'Harness201 G3 produced 33/128 invalid terminations in round 0. Instead of lowering the gate after seeing the result, the attempt was sealed as HOLD evidence.')}</p>
          <button type="button" data-first-run-detail="3b-harness" aria-expanded="false">+ {t('关卡说明', 'Stage notes')}</button>
        </article>
        <span class="lineage-connector lineage-connector--unlock" aria-hidden="true"></span>

        <article class="lineage-node lineage-node--unlock" data-node-kind="mainline" data-node-state="stopped">
          <span>{t('这条旧线停在这里', 'THIS OLD LINEAGE STOPS HERE')}</span>
          <h3>{t('新 Harness 必须从新的 Stage 1 重新开始', 'The new harness must restart from a fresh Stage 1')}</h3>
          <p>{t('行动接口改变以后，模型真正走出来的 trajectory 也会改变。因此旧 Stage 1、旧 MiniMax 分析和旧 downstream state 不能冒充 successor。', 'Once the action interface changes, the trajectories the model actually produces change too. The old Stage 1, old MiniMax analysis, and old downstream state therefore cannot be relabeled as the successor.')}</p>
          <a href={links.redesign}>{t('解锁第二张地图：重新设计 OpenEvo →', 'Unlock map two: Redesigning OpenEvo →')}</a>
        </article>
      </div>

      <section class="lineage-outcome" aria-labelledby="outcome-3b-title">
        <p>OUTCOME</p>
        <h2 id="outcome-3b-title">{t('3B 这条线留下了什么？', 'What did the 3B lineage teach us?')}</h2>
        <ul>
          <li>{t('不能把 aggregate score 低直接解释成“模型不会做题”；Harness 可能先破坏 action validity。', 'A low aggregate score cannot be translated directly into “the model cannot solve the task”; the harness may be damaging action validity first.')}</li>
          <li>{t('失败 qualification 是证据，不是事后改 gate 的理由。', 'A failed qualification is evidence, not permission to tune the gate after observing the result.')}</li>
          <li>{t('改变 on-policy action contract 后，必须建立 fresh Stage 1 successor。', 'Changing the on-policy action contract requires a fresh Stage-1 successor.')}</li>
        </ul>
        <div class="lineage-outcome__links">
          <a href={links.harness}>{t('查看 Harness 诊断证据 →', 'Open the harness diagnostic evidence →')}</a>
          <a href={links.redesign}>{t('进入重新设计 OpenEvo →', 'Continue to Redesigning OpenEvo →')}</a>
        </div>
      </section>
    </div>

    <div class="detail-layer" data-first-run-detail-layer hidden>
      <button class="detail-layer__backdrop" type="button" data-first-run-detail-close aria-label={t('关闭关卡说明', 'Close stage notes')}></button>
      <aside class="detail-card" data-first-run-detail-card role="dialog" aria-modal="false" aria-labelledby="first-run-detail-title" tabindex="-1">
        <button class="detail-card__close" type="button" data-first-run-detail-close aria-label={t('关闭', 'Close')}>×</button>
