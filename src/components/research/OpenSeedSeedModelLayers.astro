---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;

const layers = [
  {
    code: 'A',
    name: 'OpenSeed',
    kind: t('Agent / 自治运行层', 'Agent / autonomous runtime layer'),
    verb: t('组织与持续运行', 'orchestrates and keeps running'),
    input: t('purpose、环境、记忆、工具、LLM 连接', 'purpose, environment, memory, tools, LLM connection'),
    output: t('行动、文件/代码变化、记忆与下一轮状态', 'actions, file/code changes, memory, and next-cycle state'),
    changes: t('主要变化在 Agent 外部状态与它可改写的软件/记忆表面', 'change mainly lives in agent-side state and software/memory surfaces it can rewrite'),
  },
  {
    code: 'B',
    name: 'Qwen2.5-3B-Instruct',
    kind: t('基础模型 / 推理引擎层', 'Base model / inference engine layer'),
    verb: t('把上下文变成下一步 token / action', 'turns context into the next tokens / action'),
    input: t('system + prompt + observation + memory', 'system + prompt + observation + memory'),
    output: t('文本、计划、工具调用或环境动作', 'text, plan, tool call, or environment action'),
    changes: t('正常推理时权重不变；它提供“当前会怎么做”的能力', 'weights stay fixed during ordinary inference; it supplies the current policy capability'),
  },
  {
    code: 'C',
    name: 'SEED',
    kind: t('训练 / 参数学习层', 'Training / parameter-learning layer'),
    verb: t('把完成轨迹蒸馏回策略', 'distills completed trajectories back into the policy'),
    input: t('on-policy trajectory、hindsight skill、reward', 'on-policy trajectory, hindsight skill, reward'),
    output: t('更新后的 policy checkpoint', 'an updated policy checkpoint'),
    changes: t('真正更新模型参数；下一轮 rollout 使用新的策略权重', 'actually updates model parameters; the next rollout uses the new policy weights'),
  },
];
---

<section class="osq-section" id="openseed-qwen-seed" aria-labelledby="osq-title">
  <header class="osq-heading">
    <span>06</span>
    <div>
      <small>{t('三个名字，三个层级', 'Three names, three layers')}</small>
      <h2 id="osq-title">{t('OpenSeed、Qwen2.5-3B 和 SEED 到底是什么关系？', 'How do OpenSeed, Qwen2.5-3B, and SEED actually relate?')}</h2>
      <p>{t('把它们放进同一张“机器剖面图”里：OpenSeed 决定 Agent 怎么生活和循环，Qwen 决定此刻怎么思考与行动，SEED 决定训练后模型参数怎么变。', 'Put them in one machine cutaway: OpenSeed defines how the agent lives and loops, Qwen decides how it thinks and acts now, and SEED defines how model parameters change after training.')}</p>
    </div>
  </header>

  <aside class="name-warning">
    <b>{t('先避免一个最常见的混淆', 'First avoid the most common naming confusion')}</b>
    <span>{t('OpenSeed ≠ OpenEvo。OpenSeed 是另一个开源自治 Agent 项目；本网站前面的 OpenEvo 是我们正在比较的跨任务演化框架。名字相近，但不是同一系统。', 'OpenSeed ≠ OpenEvo. OpenSeed is a separate open-source autonomous-agent project; OpenEvo on the pages above is the cross-task evolution framework we are studying. Similar names, different systems.')}</span>
  </aside>

  <figure class="layer-machine" aria-labelledby="layer-machine-caption">
    <figcaption id="layer-machine-caption">
      <small>{t('一条任务进入以后', 'When one task enters')}</small>
      <strong>{t('运行层包住模型层；训练层在任务结束后改写未来的模型', 'The runtime wraps the model; the training layer changes the future model after the task')}</strong>
    </figcaption>

    <div class="machine-flow" aria-hidden="true">
      <span class="flow-label flow-label--in">{t('任务 / observation', 'task / observation')}</span>
      <div class="flow-pipe"><i></i><i></i><i></i></div>
      <span class="flow-label flow-label--out">{t('action / trajectory', 'action / trajectory')}</span>
    </div>

    <div class="runtime-shell">
      <div class="runtime-shell__label">
        <span>OpenSeed</span>
        <small>{t('Agent 生命周期、工具、记忆、文件与循环', 'Agent lifecycle, tools, memory, files, and cycles')}</small>
      </div>

      <div class="model-core">
        <span class="model-core__pulse" aria-hidden="true"></span>
        <small>{t('此刻负责推理', 'Inference right now')}</small>
        <strong>Qwen2.5-3B-Instruct</strong>
        <p>{t('读入当前上下文，产生文本 / tool call / action。没有训练步骤时，它不会因为“跑了一次任务”就自动改权重。', 'Reads current context and emits text / tool calls / actions. Without a training step, simply running a task does not automatically change its weights.')}</p>
      </div>

      <div class="runtime-memory">
        <span>{t('外部可变表面', 'External mutable surfaces')}</span>
        <b>{t('memory · diary · rules · code · files', 'memory · diary · rules · code · files')}</b>
      </div>
    </div>

    <div class="training-bridge" aria-hidden="true">
      <span>{t('完成轨迹', 'completed trajectory')}</span>
      <div><i></i><i></i></div>
      <span>{t('训练信号', 'training signal')}</span>
    </div>

    <div class="seed-trainer">
      <div class="seed-trainer__head">
        <small>{t('任务之后 · 训练阶段', 'After the task · training stage')}</small>
        <strong>SEED</strong>
      </div>
      <div class="seed-stages">
        <span>{t('轨迹', 'trajectory')}</span>
        <span>{t('hindsight skill', 'hindsight skill')}</span>
        <span>{t('re-score + OPD / RL', 're-score + OPD / RL')}</span>
        <span>{t('新 checkpoint', 'new checkpoint')}</span>
      </div>
      <p>{t('SEED 的关键不是“多写一段记忆”，而是把 skill 对动作概率的影响蒸馏回 policy，并与 outcome RL 联合优化，所以变化最终进入模型参数。', 'SEED is not merely “write another memory.” It distills the skill-induced change in action probability back into the policy and jointly optimizes it with outcome RL, so the change ultimately enters model parameters.')}</p>
    </div>

    <div class="next-cycle" aria-hidden="true">
      <span>{t('下一轮', 'next rollout')}</span>
      <div><i></i><i></i><i></i></div>
      <b>{t('更新后的 Qwen policy 回到 Agent 运行层', 'updated Qwen policy returns to the agent runtime')}</b>
    </div>
  </figure>

  <div class="layer-cards" aria-label={t('三个层级的输入输出', 'Inputs and outputs of the three layers')}>
    {layers.map((layer) => (
      <article>
        <div class="layer-card__top"><span>{layer.code}</span><div><small>{layer.kind}</small><h3>{layer.name}</h3></div></div>
        <p class="layer-card__verb">{layer.verb}</p>
        <dl>
          <div><dt>{t('输入', 'Input')}</dt><dd>{layer.input}</dd></div>
          <div><dt>{t('输出', 'Output')}</dt><dd>{layer.output}</dd></div>
          <div><dt>{t('哪里真的发生变化？', 'Where does change actually live?')}</dt><dd>{layer.changes}</dd></div>
        </dl>
      </article>
    ))}
  </div>

  <div class="same-model-two-worlds">
    <header>
      <small>{t('最容易误解的一点', 'The easiest point to misunderstand')}</small>
      <h3>{t('同一个 Qwen2.5-3B，可以被“使用”，也可以被“训练”', 'The same Qwen2.5-3B can be used, or it can be trained')}</h3>
    </header>
    <div class="world-pair">
      <article>
        <span>{t('运行时', 'Runtime')}</span>
        <strong>OpenSeed + Qwen2.5-3B</strong>
        <p>{t('Qwen 像发动机。OpenSeed 给它目的、记忆、工具和可修改的软件环境，让 Agent 连续醒来、行动、写文件、积累经验。', 'Qwen is the engine. OpenSeed gives it purpose, memory, tools, and a modifiable software environment so the agent can wake, act, write files, and accumulate experience.')}</p>
        <b>{t('不要求模型参数一定变化', 'Model parameters do not have to change')}</b>
      </article>
      <div class="world-divider" aria-hidden="true"><i></i><span>≠</span><i></i></div>
      <article>
        <span>{t('训练时', 'Training')}</span>
        <strong>SEED + Qwen2.5-3B</strong>
        <p>{t('Qwen 是被优化的 policy。完成轨迹被分析成 hindsight skill，再把 skill 带来的概率变化蒸馏进参数，得到下一版 checkpoint。', 'Qwen is the policy being optimized. Completed trajectories become hindsight skills, and the probability shift caused by those skills is distilled into parameters to produce the next checkpoint.')}</p>
        <b>{t('目标就是让模型参数发生可验证变化', 'The goal is a verifiable parameter update')}</b>
      </article>
    </div>
  </div>

  <div class="mental-test">
    <b>{t('小白判断口诀', 'Beginner mental test')}</b>
    <div>
      <span><i>1</i>{t('谁负责“活着和循环”？ → OpenSeed / Agent framework', 'Who keeps the agent alive and looping? → OpenSeed / agent framework')}</span>
      <span><i>2</i>{t('谁负责“这一步怎么回答/行动”？ → Qwen2.5-3B / base model', 'Who decides the next answer/action? → Qwen2.5-3B / base model')}</span>
      <span><i>3</i>{t('谁负责“训练后权重怎么变”？ → SEED / learning algorithm', 'Who decides how weights change after training? → SEED / learning algorithm')}</span>
    </div>
  </div>

  <nav class="source-links" aria-label={t('一手资料', 'Primary sources')}>
    <span>{t('一手资料', 'Primary sources')}</span>
    <a href="https://openseed.dev/" target="_blank" rel="noreferrer">OpenSeed<i aria-hidden="true">↗</i></a>
    <a href="https://openseed.dev/docs/genomes/" target="_blank" rel="noreferrer">OpenSeed genomes<i aria-hidden="true">↗</i></a>
    <a href="https://huggingface.co/Qwen/Qwen2.5-3B-Instruct" target="_blank" rel="noreferrer">Qwen2.5-3B-Instruct<i aria-hidden="true">↗</i></a>
    <a href="https://arxiv.org/abs/2607.14777" target="_blank" rel="noreferrer">SEED paper<i aria-hidden="true">↗</i></a>
  </nav>
</section>

<style>
  .osq-section { width: min(1180px, calc(100% - 32px)); margin: 72px auto 0; padding: 34px; border: 1px solid var(--border); border-radius: 28px; background: color-mix(in srgb, var(--surface) 94%, var(--accent) 6%); }
  .osq-heading { display:grid; grid-template-columns:52px 1fr; gap:20px; align-items:start; }
  .osq-heading > span { width:46px; aspect-ratio:1; display:grid; place-items:center; border-radius:14px; background:var(--text); color:var(--background); font-weight:800; }
  .osq-heading small,.layer-card__top small,.seed-trainer__head small,.same-model-two-worlds small,.layer-machine figcaption small { color:var(--muted); font-size:.78rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  .osq-heading h2 { margin:.2rem 0 .65rem; font-size:clamp(1.65rem,3vw,2.65rem); line-height:1.08; max-width:880px; }
  .osq-heading p { margin:0; color:var(--muted); max-width:850px; line-height:1.7; }
  .name-warning { margin:26px 0; display:flex; gap:14px; align-items:flex-start; padding:16px 18px; border-radius:16px; border:1px solid color-mix(in srgb,var(--warning,#d49320) 35%,var(--border)); background:color-mix(in srgb,var(--warning,#d49320) 8%,var(--surface)); }
  .name-warning b { white-space:nowrap; } .name-warning span{color:var(--muted);line-height:1.6;}
  .layer-machine { margin:30px 0 0; padding:26px; border:1px solid var(--border); border-radius:24px; background:var(--background); overflow:hidden; }
  .layer-machine figcaption { display:flex; flex-direction:column; gap:5px; margin-bottom:24px; } .layer-machine figcaption strong{font-size:1.15rem;}
  .machine-flow,.training-bridge,.next-cycle { display:grid; align-items:center; gap:12px; }
  .machine-flow { grid-template-columns:max-content 1fr max-content; margin:0 24px 14px; }
  .flow-label,.training-bridge span,.next-cycle span { font-size:.74rem; color:var(--muted); font-weight:700; }
  .flow-pipe,.training-bridge>div,.next-cycle>div { height:3px; position:relative; background:color-mix(in srgb,var(--accent) 38%,var(--border)); overflow:visible; }
  .flow-pipe i,.training-bridge i,.next-cycle i { position:absolute; top:50%; width:8px; height:8px; margin-top:-4px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 12%,transparent); animation:packet 3.4s linear infinite; }
  .flow-pipe i:nth-child(2),.next-cycle i:nth-child(2){animation-delay:-1.15s}.flow-pipe i:nth-child(3),.next-cycle i:nth-child(3){animation-delay:-2.3s}.training-bridge i:nth-child(2){animation-delay:-1.7s}
  @keyframes packet { from{left:-8px} to{left:calc(100% - 2px)} }
  .runtime-shell { position:relative; border:2px solid color-mix(in srgb,var(--accent) 50%,var(--border)); border-radius:26px; padding:54px 28px 24px; display:grid; grid-template-columns:minmax(0,1.35fr) minmax(220px,.65fr); gap:18px; background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 7%,var(--surface)),var(--surface)); }
  .runtime-shell__label { position:absolute; top:14px; left:20px; right:20px; display:flex; justify-content:space-between; gap:12px; align-items:baseline; }
  .runtime-shell__label span{font-weight:900}.runtime-shell__label small{color:var(--muted)}
  .model-core { position:relative; padding:22px; border-radius:20px; background:var(--background); border:1px solid var(--border); overflow:hidden; }
  .model-core__pulse { position:absolute; width:90px; height:90px; border-radius:50%; right:-22px; top:-30px; border:1px solid color-mix(in srgb,var(--accent) 45%,transparent); animation:pulse 2.8s ease-out infinite; }
  @keyframes pulse{0%{transform:scale(.65);opacity:.85}100%{transform:scale(1.55);opacity:0}}
  .model-core small,.runtime-memory span{display:block;color:var(--muted);font-size:.76rem;font-weight:700}.model-core strong{display:block;margin:.3rem 0;font-size:1.35rem}.model-core p,.seed-trainer p{margin:.4rem 0 0;color:var(--muted);line-height:1.6;}
  .runtime-memory { display:flex; flex-direction:column; justify-content:center; gap:8px; padding:20px; border-radius:20px; border:1px dashed color-mix(in srgb,var(--accent) 55%,var(--border)); }
  .runtime-memory b{line-height:1.6;}
  .training-bridge { grid-template-columns:max-content 1fr max-content; width:72%; margin:15px auto; }
  .seed-trainer { border-radius:22px; padding:22px; border:1px solid var(--border); background:color-mix(in srgb,var(--surface) 87%,var(--accent) 13%); }
  .seed-trainer__head { display:flex; align-items:baseline; justify-content:space-between; gap:16px; }.seed-trainer__head strong{font-size:1.5rem;}
  .seed-stages { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:18px 0; }
  .seed-stages span { position:relative; padding:12px 10px; text-align:center; border-radius:12px; background:var(--background); border:1px solid var(--border); font-size:.82rem; font-weight:700; }
  .seed-stages span:not(:last-child)::after { content:''; position:absolute; width:8px; height:1px; right:-9px; top:50%; background:var(--accent); }
  .next-cycle { grid-template-columns:max-content 1fr minmax(220px,max-content); margin:14px 18px 0; }.next-cycle b{font-size:.8rem;text-align:right;}
  .layer-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:18px; }
  .layer-cards article { padding:20px; border:1px solid var(--border); border-radius:20px; background:var(--surface); }
  .layer-card__top { display:flex; gap:12px; align-items:center; }.layer-card__top>span{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--text);color:var(--background);font-weight:800}.layer-card__top h3{margin:.1rem 0 0;font-size:1.08rem;}
  .layer-card__verb{margin:14px 0;color:var(--muted);min-height:2.8em}.layer-cards dl{margin:0}.layer-cards dl>div{padding:10px 0;border-top:1px solid var(--border)}.layer-cards dt{font-size:.72rem;color:var(--muted);font-weight:700}.layer-cards dd{margin:4px 0 0;line-height:1.45;font-size:.88rem;}
  .same-model-two-worlds,.mental-test { margin-top:18px; padding:22px; border-radius:22px; border:1px solid var(--border); background:var(--background); }
  .same-model-two-worlds h3{margin:.25rem 0 16px;font-size:1.35rem}.world-pair{display:grid;grid-template-columns:1fr 52px 1fr;gap:12px;align-items:stretch}.world-pair article{padding:18px;border-radius:16px;background:var(--surface);border:1px solid var(--border)}.world-pair article>span{font-size:.72rem;color:var(--muted);font-weight:800}.world-pair article>strong{display:block;margin:5px 0 10px}.world-pair article>p{color:var(--muted);line-height:1.6;margin:0 0 12px}.world-pair article>b{font-size:.8rem}.world-divider{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;color:var(--muted)}.world-divider i{width:1px;flex:1;background:var(--border)}
  .mental-test{display:grid;grid-template-columns:180px 1fr;gap:20px;align-items:start}.mental-test>div{display:grid;gap:9px}.mental-test span{display:flex;gap:10px;align-items:flex-start;color:var(--muted);line-height:1.5}.mental-test i{font-style:normal;flex:0 0 24px;height:24px;display:grid;place-items:center;border-radius:50%;background:var(--text);color:var(--background);font-size:.72rem;font-weight:800}
  .source-links{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin-top:18px}.source-links>span{color:var(--muted);font-size:.78rem;font-weight:700}.source-links a{display:inline-flex;gap:5px;align-items:center;padding:7px 10px;border:1px solid var(--border);border-radius:999px;text-decoration:none;font-size:.78rem}.source-links a:hover{border-color:var(--accent)}
  @media(max-width:820px){.osq-section{width:min(100% - 20px,1180px);padding:22px}.osq-heading{grid-template-columns:42px 1fr;gap:12px}.osq-heading>span{width:38px}.name-warning{flex-direction:column}.name-warning b{white-space:normal}.runtime-shell{grid-template-columns:1fr;padding:54px 16px 16px}.runtime-shell__label{align-items:flex-start}.runtime-shell__label small{text-align:right;max-width:55%}.seed-stages{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:4px}.seed-stages span{min-width:150px;scroll-snap-align:start}.layer-cards{grid-template-columns:1fr}.layer-card__verb{min-height:0}.world-pair{grid-template-columns:1fr}.world-divider{flex-direction:row;height:34px}.world-divider i{height:1px;width:auto}.mental-test{grid-template-columns:1fr}.machine-flow,.training-bridge,.next-cycle{width:auto;margin-left:4px;margin-right:4px}.next-cycle{grid-template-columns:max-content 1fr}.next-cycle b{grid-column:1/-1;text-align:left}.flow-label{font-size:.66rem}}
  @media(prefers-reduced-motion:reduce){.flow-pipe i,.training-bridge i,.next-cycle i,.model-core__pulse{animation:none}.flow-pipe i,.training-bridge i,.next-cycle i{left:25%}.flow-pipe i:nth-child(2),.training-bridge i:nth-child(2),.next-cycle i:nth-child(2){left:50%}.flow-pipe i:nth-child(3),.next-cycle i:nth-child(3){left:75%}.model-core__pulse{opacity:.35}}
</style>
