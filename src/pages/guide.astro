---
import AppLayout from '../layouts/AppLayout.astro';
import { getMessages, localePath } from '../i18n';
import { getCollection } from 'astro:content';
import AgentToSeedBridge from '../components/AgentToSeedBridge.astro';
import SeedStudentReproductionGuide from '../components/SeedStudentReproductionGuide.astro';
const m = getMessages('zh');
const guideRecord = (await getCollection('guides'))[0]?.data;
const guideSource = guideRecord ? 'collection' : 'fallback';
const title = '先看懂 Agent，再复现 SEED';
const lede = '面向已经了解 Transformer、微调、推理、API 和 GPU 的读者：先用一屏理解 policy、tool、environment、trajectory、reward、GRPO 和 SEED 的关系，再进入可迁移的 ALFWorld / WebShop 复现主线。';
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="zh">
  <div class="shell editorial-page guide-learning-page" data-guide-source={guideSource}>
    <header class="page-header">
      <p class="guide-eyebrow">Agent 101 → SEED · Qwen2.5-3B-Instruct · ALFWorld + WebShop</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="hardware-note">本页先帮助读者理解<strong>运行时哪里在循环、训练时哪里在更新权重</strong>，再把同一套概念放进真实命令。本项目用 4×RTX 3090 24GB 离线服务器作为具体实例；其他读者可以沿用“联网工作站准备 → 内网 GPU 服务器执行”的方法。工作台里的显存数字是<strong>启发式规划估算</strong>，<strong>不是硬件实测</strong>；真机 profiling 才是运行时间与显存证据。</p>
    </header>

    <section class="tomorrow-plan" aria-labelledby="tomorrow-plan-title">
      <div class="plan-head">
        <p class="guide-eyebrow">可迁移的三阶段路线</p>
        <h2 id="tomorrow-plan-title">先验证最小科学链，再依据真机证据决定是否迁移硬件</h2>
        <p>论文复现分为准备执行环境、逐级放大实验、按证据决定迁移三阶段。首次进入实验室时，先证明离线材料、两个环境和训练链可用；拿到真机的显存与耗时数据后，再决定在现有服务器完成实验，或迁移到论文硬件。本项目实例从 4×3090 开始，论文硬件是 8×A800。</p>
      </div>

      <div class="reality-banner">
        <strong>本项目实例的显存约束</strong>
        <span><b>4×RTX 3090 24GB 仍然受每卡 24GB 显存限制。</b> 模型分片、FSDP、vLLM、optimizer 和通信方式共同决定能否运行。SEED 论文的训练条件是 8×NVIDIA A800 80GB；本项目先在四卡 3090 上跑通并测量，再依据证据决定是否迁移。</span>
      </div>

      <nav class="macro-route" aria-label="SEED 三阶段复现路线">
        <a href="#macro-connect"><b>01</b><strong>准备执行拓扑</strong><span>联网工作站 → SSH / rsync → 内网 GPU 服务器</span></a>
        <a href="#macro-reproduce"><b>02</b><strong>复现与预估</strong><span>smoke → SFT → RL profiling → 时间账</span></a>
        <a href="#macro-migrate"><b>03</b><strong>迁到 8×A800</strong><span>冻结证据 → 重建环境 → 短跑 → 完整训练</span></a>
      </nav>

      <section class="resource-ledger" aria-labelledby="resource-ledger-title">
        <div class="ledger-intro">
          <p class="guide-eyebrow">资源账本</p>
          <h3 id="resource-ledger-title">开始前先把电脑、显卡、磁盘、时间、钱和难度看清楚</h3>
          <p>论文只明确给出了核心实验硬件与训练规模；CPU、内存、磁盘、四卡耗时和租赁价格都按工程规划写，并明确标成估算。完成至少 5 个稳定 update 后，用实测替换估算。</p>
        </div>
        <div class="ledger-grid">
          <article><small>联网准备机</small><strong>不需要 GPU</strong><span>建议 Linux / WSL2，16–32GB RAM，至少 150–300GB 可用磁盘。负责下载代码、模型、wheel/conda 包、ALFWorld、WebShop，并制作离线包。</span><em>难度 2/5 · 工程估算</em></article>
          <article><small>本项目实验机</small><strong>4×RTX 3090 24GB</strong><span>建议 ≥128GB 系统内存、≥32 CPU 线程、300–500GB NVMe。目标是测量 OOM、通信、每个 update 时间和 checkpoint 行为，再判断能否完成计划。</span><em>难度 5/5 · 机器规格需现场实测</em></article>
          <article><small>论文目标机</small><strong>8×A800 80GB</strong><span>论文明确使用的训练硬件。工程上建议准备 ≥256GB RAM 与 ≥500GB 快速磁盘；如果保留很多 optimizer/checkpoint，1TB 更安心。</span><em>难度 3/5 · GPU 条件来自论文</em></article>
          <article><small>代码量</small><strong>从官方 SEED 仓库开始</strong><span>正常复现主要复用官方实现。预计自写 50–300 行配置/脚本；离线打包和 3090 兼容调参可能累计 200–800 行。重写 RL/veRL 核心会把工作量扩大到数千行级，不适合作为首次复现路径。</span><em>工程估算</em></article>
          <article><small>四卡机器费用</small><strong>若实验室服务器免费：GPU 租赁 $0</strong><span>Stage‑1 外部 analyzer 仍可能产生 API 成本。先记录真实请求数和 token，再按供应商账单计算，避免把未知调用量写成确定总价。</span><em>不含人力与 API</em></article>
          <article><small>A800 费用</small><strong>总价 = 8 × 单卡小时价 × 实际小时</strong><span>敏感性示例：若报价是 $2 / GPU·h，整机就是 $16/h；跑 24h≈$384，48h≈$768，72h≈$1,152。这里只是算式示例，不冒充当前市场报价。</span><em>拿到供应商报价后替换</em></article>
        </div>
      </section>

      <section id="macro-connect" class="macro-step">
        <div class="macro-number">01</div>
        <div>
          <p class="guide-eyebrow">准备执行拓扑</p>
          <h3>联网工作站准备材料，内网 GPU 服务器执行实验</h3>
          <p>许多实验室让个人电脑或工作站访问公网，同时让 GPU 服务器留在内网。联网工作站负责下载、缓存并校验代码、模型、数据和离线依赖；GPU 服务器通过 SSH / rsync 接收同一份材料并承担计算。先确认工作站能到达服务器，再执行 60 秒体检。本项目的实例服务器是 4×RTX 3090。</p>

          <h4>A. 通用连接拓扑</h4>
          <div class="math-grid">
            <article><small>联网工作站</small><strong>准备与控制</strong><span>下载、缓存、校验并记录固定版本；通过实验室 LAN 或批准的 VPN 连接内网。</span></article>
            <article><small>可选跳板机</small><strong>Bastion / relay</strong><span>只有网络边界要求中转时才需要；它提供到 GPU 内网的受控 SSH 路径。</span></article>
            <article><small>内网 GPU 服务器</small><strong>执行与产出</strong><span>接收固定材料，运行实验并保存日志、checkpoint 与结果证据。</span></article>
            <article><small>传输与维护</small><strong>SSH / SFTP / rsync</strong><span>命令、文件和结果优先走可审计的加密通道；GUI 远程桌面只用于必要维护。</span></article>
          </div>
          <div class="warning-card"><strong>网络安全边界</strong><span>远程入口需要工作站与实验室内网之间存在获批的可达路径。使用学校/实验室批准的 LAN、VPN 或私有网络方案。不要把 SSH、VNC 或 Screen Sharing 端口直接暴露到公网，因为这会扩大账户和实验资产的攻击面。</span></div>

          <details class="lab-mac-case"><summary>本项目实例：用专用旧 Mac 作为实验室跳板机</summary><div>

          <h4>A1. 让旧 MacBook 合盖、插电、长期不休眠</h4>
          <ol class="tomorrow-checklist">
            <li><b>1</b><div><strong>硬件先接齐</strong><span>接上电源、物理网线、外接显示器、外接键盘和鼠标。Apple 明确支持在外接显示器和配件连接后合盖使用 MacBook；外接显示器黑屏时，Apple 还特别要求合盖笔记本接电并使用外接键盘和鼠标。</span></div></li>
            <li><b>2</b><div><strong>系统设置 → 电池 → 选项</strong><span>打开“显示器关闭时，连接电源适配器时防止自动进入睡眠”（Prevent automatic sleeping on power adapter when the display is off）。把“唤醒以供网络访问”（Wake for network access）设为“仅使用电源适配器时”或“始终”。旧 macOS 可能把同类选项放在“系统偏好设置 → 节能”。</span></div></li>
            <li><b>3</b><div><strong>允许屏幕自己熄灭</strong><span>“锁定屏幕”里可以让外接显示器闲置几分钟后关闭；目标是“屏幕黑掉，但电脑不睡”。不要用“永远亮着显示器”来换取常驻。</span></div></li>
            <li><b>4</b><div><strong>合盖前先确认外设都被识别</strong><span>显示器、键盘、鼠标都正常后再合盖。对于很老的 Intel Mac、老转接器或某些显示器，物理关闭显示器电源可能等价于断开显示器；因此建议让 macOS 负责熄屏，而不是拔掉/切断显示器连接，并实际做一次 30 分钟合盖测试。</span></div></li>
          </ol>
          <div class="pass-card"><strong>合盖常驻验收</strong><span>锁屏、合盖 30 分钟后，从另一台 Mac 仍能 SSH 到旧 Mac；再过一小时仍可连接。不要只测试“刚合盖 30 秒”。</span></div>

          <h4>A2. 锁屏后不让实验室其他人打开</h4>
          <ol class="tomorrow-checklist">
            <li><b>1</b><div><strong>开启 FileVault</strong><span>“系统设置 → 隐私与安全性 → FileVault → 打开”。恢复密钥放在别处，不要贴在实验室 Mac 或旁边。对于非常老、没有 T2 的 Intel Mac，FileVault 尤其重要。</span></div></li>
            <li><b>2</b><div><strong>锁屏后立即要求密码</strong><span>“系统设置 → 锁定屏幕 → 屏幕保护程序启动或显示器关闭后需要密码”设为“立即”。离开实验室前用 <code>Control + Command + Q</code> 主动锁屏。</span></div></li>
            <li><b>3</b><div><strong>关闭自动登录</strong><span>“用户与群组 → 自动登录”设为关闭。Apple 明确提醒：自动登录意味着别人只要重启 Mac 就可能直接进入账户；开启 FileVault 时自动登录也会被禁用。</span></div></li>
            <li><b>4</b><div><strong>单独建一个远程账户</strong><span>建议建一个标准用户，例如 <code>seed-remote</code>。保留另一个管理员账户只做本机维护。后面 Screen Sharing / Remote Login 都只允许 <code>seed-remote</code>，不要选“所有用户”。</span></div></li>
            <li><b>5</b><div><strong>如果它是 Intel Mac，再加固启动</strong><span>在 macOS Recovery 的 Startup Security Utility / Firmware Password Utility 中设置 Firmware Password。Apple 说明它可以阻止不知道密码的人从 Recovery 或其他磁盘启动。若机型带 T2，再保持 Secure Boot 的 Full Security，并禁止从外部/可移动介质启动。</span></div></li>
          </ol>
          <div class="warning-card"><strong>一个无法同时消除的取舍</strong><span>Apple 明确指出“锁定屏幕”本身不能阻止别人关机、重启或到登录窗口；所以这里要靠 FileVault + 强密码 +（Intel 时）Firmware Password 补上物理访问风险。但 FileVault 也意味着真正重启、系统更新重启或彻底断电后，Mac 可能需要先在现场输入密码解锁启动盘，远程服务才会恢复。<strong>不要为了无人值守重启而关闭 FileVault 或开启自动登录。</strong>MacBook 自带电池正好可以当短时 UPS；如果这台旧 Mac 的电池已经坏到断电即关机，优先换电池/加 UPS，或者接受重启后需要可信的人现场解锁一次。</span></div>

          <h4>A3. 开启 Mac 原生远程入口</h4>
          <ol class="tomorrow-checklist">
            <li><b>1</b><div><strong>系统设置 → 通用 → 共享 → 远程登录</strong><span>打开 Remote Login；“允许访问”选“仅这些用户”，只加入 <code>seed-remote</code>。这给你 SSH / SFTP。</span></div></li>
            <li><b>2</b><div><strong>系统设置 → 通用 → 共享 → 屏幕共享</strong><span>打开 Screen Sharing；同样只允许 <code>seed-remote</code>。如果 Remote Management 已经打开，先关掉它，因为 Apple 不允许 Screen Sharing 与 Remote Management 同时开启。</span></div></li>
            <li><b>3</b><div><strong>记下旧 Mac 的网络地址</strong><span>“共享”页面会显示远程登录命令和本机名称；也可以在“系统设置 → 网络 → 以太网”记录实验室内网 IP。更稳定的做法是让实验室 DHCP 给它做地址保留，或者使用实验室 DNS 主机名。</span></div></li>
          </ol>
          <p>在新 Mac 上需要 GUI 时，打开“应用程序 → 实用工具 → 屏幕共享（Screen Sharing）”，新建连接并输入旧 Mac 的主机名/IP。Apple 的 Screen Sharing 也接受 Apple Account 作为连接标识，但对于这台无人值守的实验室跳板机，仍然把“同一 LAN / VPN 可达”当成前提，不要把 Apple Account 当成公网穿透方案。</p>

          <h4>A4. 日常最好用 SSH ProxyJump：新 Mac 直接穿过旧 Mac 登录 3090</h4>
          <p>第一次先给新 Mac 创建 SSH 密钥；私钥只留在新 Mac，不要复制给别人。</p>
          <pre><code># 在新 MacBook 上
ssh-keygen -t ed25519 -C "seed-lab"

# 第一次用旧 Mac 的登录密码，把新 Mac 公钥装到 seed-remote
cat ~/.ssh/id_ed25519.pub | \
  ssh seed-remote@&lt;旧Mac可达地址&gt; \
  'umask 077; mkdir -p ~/.ssh; cat &gt;&gt; ~/.ssh/authorized_keys'</code></pre>
          <p>然后在新 Mac 的 <code>~/.ssh/config</code> 写两个主机。3090 服务器自己的密码/密钥仍然独立；ProxyJump 只负责把网络路径穿过去。</p>
          <pre><code>Host lab-mac
  HostName &lt;旧Mac的实验室内网/VPN可达地址&gt;
  User seed-remote
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host seed3090
  HostName &lt;4×3090服务器内网IP&gt;
  User &lt;3090服务器用户名&gt;
  ProxyJump lab-mac
  ServerAliveInterval 30
  ServerAliveCountMax 3</code></pre>
          <pre><code># 以后最常用的就是这三条
ssh lab-mac
ssh seed3090
rsync -avP ./seed-offline-bundle/ seed3090:/srv/seed/</code></pre>
          <div class="pass-card"><strong>整条链路验收</strong><span>先在旧 Mac 上按 <code>Control + Command + Q</code> 锁屏并合盖；等 30 分钟。然后新 Mac 连上同一实验室网络/VPN，执行 <code>ssh lab-mac 'date; uptime'</code>，再执行 <code>ssh seed3090 'hostname; nvidia-smi -L'</code>。两条都成功，才算“合盖常驻 + 锁屏安全 + 远程跳板”三件事同时成立。</span></div>
          <p class="estimate-note">Apple 官方资料依据：<a href="https://support.apple.com/en-us/102282" target="_blank" rel="noreferrer">合盖与外设 ↗</a> · <a href="https://support.apple.com/guide/mac-help/-mchle41a6ccd/mac" target="_blank" rel="noreferrer">睡眠/网络唤醒 ↗</a> · <a href="https://support.apple.com/guide/mac-help/mchlp1066/mac" target="_blank" rel="noreferrer">Remote Login ↗</a> · <a href="https://support.apple.com/en-euro/guide/mac-help/mh11848/mac" target="_blank" rel="noreferrer">Screen Sharing ↗</a> · <a href="https://support.apple.com/en-ie/guide/mac-help/-mh11785/mac" target="_blank" rel="noreferrer">FileVault ↗</a> · <a href="https://support.apple.com/en-us/102384" target="_blank" rel="noreferrer">Intel Firmware Password ↗</a>。</p>

          </div></details>

          <h4>B. 连接 GPU 服务器：实验室本地可直连；需要中转时使用获批跳板</h4>
          <p>管理员通常会给你四样东西：服务器 IP/域名、用户名、SSH 端口、密码或私钥。不要把密码和私钥粘到网页、GitHub 或实验日志里。</p>
          <pre><code># 如果你就在实验室 LAN，可直接连
ssh &lt;用户名&gt;@&lt;服务器IP&gt; -p &lt;端口&gt;

# 如果管理员给的是私钥
chmod 600 ~/.ssh/&lt;你的私钥文件&gt;
ssh -i ~/.ssh/&lt;你的私钥文件&gt; &lt;用户名&gt;@&lt;服务器IP&gt; -p &lt;端口&gt;

# 如果按 A4 配好了跳板机，从新 Mac 直接
ssh seed3090</code></pre>
          <h4>C. 登录后先做 60 秒体检</h4>
          <pre><code>hostname
whoami
pwd
nvidia-smi -L
nvidia-smi topo -m
free -h
df -h
python3 --version

# 外网不要用 ping 判断，直接测试 HTTPS
curl -I https://github.com --connect-timeout 5</code></pre>
          <div class="pass-card"><strong>通过标准</strong><span><code>nvidia-smi -L</code> 能看到 4 张 RTX 3090；磁盘和内存有足够空间；你知道 HTTPS 外联是“可用”还是“被策略禁止”。把输出保存成第一份机器证据。</span></div>

          <h4>D. 如果服务器不能连接外网</h4>
          <p><strong>不要为了省一步去绕过实验室网络策略。</strong>把联网工作和 GPU 工作拆开：联网电脑准备一个完整离线包，服务器只消费这个包。</p>
          <pre><code># 联网 Linux 机器上建议整理成同一目录
seed-offline-bundle/
  code/               # 固定 Git commit 的 SEED
  models/             # Qwen2.5-3B-Instruct 等
  data/alfworld/
  data/webshop/        # setup 已完成、搜索索引已建好
  env/                 # conda-pack 或 wheelhouse
  tools/               # 本站 preflight / checker
  SHA256SUMS.txt

# 配好 seed3090 后，rsync 会自动走 ProxyJump
rsync -avP seed-offline-bundle/ seed3090:/srv/seed/

# 如果你在实验室本地直接访问服务器，也可以
scp -P &lt;端口&gt; -r seed-offline-bundle/ \
  &lt;用户名&gt;@&lt;服务器IP&gt;:/srv/seed/</code></pre>
          <div class="warning-card"><strong>Stage‑1 的特殊边界</strong><span>官方 Stage‑1 需要一个 OpenAI-compatible 外部 analyzer。若实验室服务器不能访问该 endpoint，优先使用实验室批准的内网 endpoint；否则只能在“允许联网且有足够 GPU”的批准环境完成 Stage‑1 数据生成，再把 SFT 数据/checkpoint 连同 hash 带回。要在实验记录里写清楚：这一阶段不是在 4×3090 服务器上完成的。</span></div>
        </div>
      </section>

      <section id="macro-reproduce" class="macro-step">
        <div class="macro-number">02</div>
        <div>
          <p class="guide-eyebrow">复现与预估</p>
          <h3>先从 1 条轨迹放大到 5 个稳定 update，再估算完整 150 updates</h3>
          <p>官方仓库当前的 Stage‑1 论文规模是每个 benchmark <strong>180 tasks × 8 rollouts = 1,440 条轨迹</strong>，SFT 训练 3 epochs。论文 RL 阶段是 <strong>150 policy updates、batch 16、group size 8</strong>。按算法逐 update 采新轨迹的量级推演，每个 benchmark 大约是 <strong>150×16×8 = 19,200 条 RL 轨迹</strong>；ALFWorld + WebShop 两套约 38,400 条。这个 19,200 是根据论文 batch/group 推导的规划量级，最终以真实日志计数为准。</p>
          <div class="math-grid">
            <article><small>Stage‑1 / benchmark</small><strong>1,440 trajectories</strong><span>180 tasks × 8 rollouts</span></article>
            <article><small>Stage‑1 / 两套</small><strong>2,880 trajectories</strong><span>也意味着外部 analyzer 可能面对同量级的轨迹分析请求</span></article>
            <article><small>RL / benchmark</small><strong>≈19,200 trajectories</strong><span>150 updates × 16 tasks × 8 rollouts，规划推演</span></article>
            <article><small>最长环境交互上界</small><strong>≈864,000 steps</strong><span>ALFWorld 19,200×30 + WebShop 19,200×15；实际成功轨迹通常会更短</span></article>
          </div>

          <h4>按这个顺序逐级放大</h4>
          <ol class="tomorrow-checklist">
            <li><b>1</b><div><strong>Preflight</strong><span>4 张 GPU、CUDA、模型、数据、hash 全部 PASS。</span></div></li>
            <li><b>2</b><div><strong>ALFWorld smoke</strong><span>只做最小 task/rollout，确认 reset → action → observation → skill → SFT record。</span></div></li>
            <li><b>3</b><div><strong>WebShop 1×1</strong><span>先手工 search/click，再跑 1 task × 1 rollout，排除索引和旧依赖问题。</span></div></li>
            <li><b>4</b><div><strong>SFT</strong><span>两个 checkpoint 都能导出、重新加载。</span></div></li>
            <li><b>5</b><div><strong>四卡 RL DRY_RUN</strong><span>先看配置；不要一上来就烧整夜。</span></div></li>
            <li><b>6</b><div><strong>至少 5 个稳定 update</strong><span>没有持续 OOM/NaN/Inf，checkpoint 能 save/resume，并记录每个 update wall-clock。</span></div></li>
          </ol>

          <div class="warning-card"><strong>3090 最可能卡在显存</strong><span>官方公开配置以 8 GPU 为主。若四卡真实 OOM，优先按日志逐项减小 actor/rollout micro-batch、降低 rollout 的 GPU memory utilization，必要时再考虑 FSDP parameter/optimizer offload。每次只改一个变量，并保存“改前/改后”峰值显存和 update 时间；不要同时乱改一串参数。</span></div>

          <h4>用真机速度计算剩余时间</h4>
          <p>取 warm-up 后 5 个 update 的中位数。单 benchmark 的 RL 主循环粗算就是：<code>150 × 中位分钟/update ÷ 60</code>。两套环境再乘 2，然后额外加 SFT、评测、失败重跑和约 15% 首次运行缓冲。</p>
          <div class="time-table" role="table" aria-label="SEED update 时间敏感性">
            <div class="time-row time-head" role="row"><span>实测中位数</span><span>1 个 benchmark / 150 updates</span><span>ALFWorld + WebShop RL 主循环</span></div>
            <div class="time-row" role="row"><strong>5 min/update</strong><span>12.5h</span><span>25h</span></div>
            <div class="time-row" role="row"><strong>10 min/update</strong><span>25h</span><span>50h</span></div>
            <div class="time-row" role="row"><strong>20 min/update</strong><span>50h</span><span>100h</span></div>
            <div class="time-row" role="row"><strong>30 min/update</strong><span>75h</span><span>150h</span></div>
          </div>
          <p class="estimate-note">因此，“完整两套先按 3–6 天排机器”只能算开机前的工程先验，不是 3090 benchmark。五个稳定 update 跑完后，这张表就应该被你的真实数字替代。</p>
        </div>
      </section>

      <section id="macro-migrate" class="macro-step">
        <div class="macro-number">03</div>
        <div>
          <p class="guide-eyebrow">代码迁移到真正的 8×A800</p>
          <h3>冻结同一实验，再在 8×A800 上重新验收后启动完整训练</h3>
          <p>真正想接近论文条件时，最重要的是让“硬件”成为主要变化量。模型、数据、评测、seed、代码 commit 和实验记录格式尽量保持不变。</p>
          <ol class="tomorrow-checklist">
            <li><b>1</b><div><strong>冻结 3090 实验</strong><span>记录 Git SHA、模型 revision、数据 SHA256、环境 lock、关键配置、GPU topology、5 个稳定 update 的时间/显存、最后一个可加载 checkpoint。</span></div></li>
            <li><b>2</b><div><strong>传到 A800</strong><span>优先传固定的 SFT/Hugging Face checkpoint、数据、配置和代码。中途 4 卡 RL 的 optimizer/FSDP checkpoint 是否能跨 world-size 直接恢复要单独验证，不要默认兼容。</span></div></li>
            <li><b>3</b><div><strong>8 卡 Preflight</strong><span>确认 8×A800 80GB、CUDA/NCCL、磁盘、模型和数据 hash 与记录一致。</span></div></li>
            <li><b>4</b><div><strong>DRY_RUN</strong><span>把 <code>N_GPUS_PER_NODE</code> / <code>DATA_PARALLEL_SIZE</code> 恢复到 8，先验证两套 wrapper。</span></div></li>
            <li><b>5</b><div><strong>5-update A800 短跑</strong><span>重新测每 update 时间、峰值显存、保存/恢复。只有短跑通过才开始昂贵完整训练。</span></div></li>
            <li><b>6</b><div><strong>论文可比完整 run</strong><span>如果目标是论文硬件复现，建议从同一冻结的 SFT checkpoint 开始一条完整 A800 RL run，而不是把半截 3090 RL 接着跑完后称为“论文条件复现”。</span></div></li>
          </ol>
          <pre><code>export EXPECTED_GPU_COUNT=8
export N_GPUS_PER_NODE=8
export DATA_PARALLEL_SIZE=8
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# 先验收机器和离线包
SEED_ROOT=/srv/seed EXPECTED_GPU_COUNT=8 \
  bash /srv/seed/tools/seed-4x3090-preflight.sh

# 再只做配置验证
N_GPUS_PER_NODE=8 DRY_RUN=true \
  bash examples/seed_trainer/run_alfworld_sft_glm_self.sh
N_GPUS_PER_NODE=8 DRY_RUN=true \
  bash examples/seed_trainer/run_webshop_sft_glm_self.sh</code></pre>
          <div class="pass-card"><strong>可以开始完整 A800 训练的门槛</strong><span>8 卡 preflight PASS；ALFWorld/WebShop DRY_RUN PASS；至少 5 个真实 update 稳定；save/resume 成功；你已经根据 A800 实测重新计算完时间和费用。</span></div>
        </div>
      </section>

