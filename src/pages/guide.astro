---
import AppLayout from '../layouts/AppLayout.astro';
import { getMessages } from '../i18n';
import { getCollection } from 'astro:content';
import AgentPrimer from '../components/AgentPrimer.astro';
import SeedReproductionPath from '../components/SeedReproductionPath.astro';
import SeedComputeTimeBudget from '../components/SeedComputeTimeBudget.astro';
import SeedOwnedComputePath from '../components/SeedOwnedComputePath.astro';
import SeedOfflineLabWorkflow from '../components/SeedOfflineLabWorkflow.astro';
import GuideContent from '../components/GuideContent.astro';
import GuideDecisionChapters from '../components/GuideDecisionChapters.astro';
const m = getMessages('zh');
const guide = (await getCollection('guides'))[0]?.data;
const steps = guide?.steps_zh ?? m.guide.steps;
const title = '先理解 Agent，再完整复现一篇论文';
const lede = '这一页假设你已经了解 Transformer、微调、推理、API 和 GPU。先补齐 Agent 的运行循环与 Agentic RL，再用 SEED 这一条真实主线，把 checkpoint、ALFWorld / WebShop、算力租赁、无外网 4×3090 实验室复现和论文结果验证串起来。';
const note = '模型记录里的硬件档位仍是粗粒度研究元数据；工作台的显存计算器会结合精度、上下文、batch、LoRA rank 等条件给出启发式规划估算，但它不是硬件实测或可运行保证。';
const concepts = guide?.concepts ?? [];
const glossary = guide?.glossary ?? [];
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="zh">
  <div class="shell editorial-page guide-learning-page">
    <header class="page-header"><h1>{title}</h1><p class="lede">{lede}</p></header>
    <AgentPrimer locale="zh" />
    <SeedReproductionPath locale="zh" />
    <SeedComputeTimeBudget locale="zh" />
    <SeedOwnedComputePath locale="zh" />
    <SeedOfflineLabWorkflow locale="zh" />
    <section class="guide-research-layer" aria-labelledby="guide-research-layer-title">
      <p class="guide-section-label">第三部分</p>
      <h2 id="guide-research-layer-title">完成一次 SEED 实战后，再把同一套方法迁移到其他论文</h2>
      <p class="muted">下面先用四个研究问题重组基础概念，再进入工作台全流程与术语表。顺序不要反过来：先定义研究声明，再固定论文变量，然后才筛模型、看证据和做替代。</p>
    </section>
    <GuideDecisionChapters locale="zh" concepts={concepts} />
    <GuideContent locale="zh" concepts={concepts} glossary={glossary} steps={steps} note={note} />
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .guide-research-layer { margin: 72px 0 24px; padding-top: 34px; border-top: 1px solid var(--line); }
  .guide-research-layer h2 { max-width: 760px; margin: 7px 0 10px; }
  .guide-research-layer p { max-width: 760px; }
  :global(.guide-concept-map) { display: none; }
</style>
