---
import AppLayout from '../layouts/AppLayout.astro';
import { getMessages, localePath } from '../i18n';
import { getCollection } from 'astro:content';
import AgentToSeedBridge from '../components/AgentToSeedBridge.astro';
import SeedStudentReproductionGuide from '../components/SeedStudentReproductionGuide.astro';
const m = getMessages('zh');
const guideRecord = (await getCollection('guides'))[0]?.data;
const guideSource = guideRecord ? 'collection' : 'fallback';
const title = '先看懂 Agent，再复现 SEED';
const lede = '假设你已经了解 Transformer、微调、推理、API 和 GPU。先用一屏把 policy、tool、environment、trajectory、reward、GRPO 和 SEED 对上号，然后立刻进入 4×3090 的 ALFWorld / WebShop 实验主线。';
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="zh">
  <div class="shell editorial-page guide-learning-page" data-guide-source={guideSource}>
    <header class="page-header">
      <p class="guide-eyebrow">Agent 101 → SEED · Qwen2.5-3B-Instruct · ALFWorld + WebShop</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="hardware-note">这里不会先讲完整 RL 数学。目标是先知道<strong>运行时哪里在循环、训练时哪里在更新权重</strong>，再把同一套概念放进真实命令。工作台里的显存数字仍然只是<strong>启发式规划估算</strong>，<strong>不是硬件实测</strong>；真正能不能跑、每个 update 要多久，以四张 3090 上的 profiling 为准。</p>
    </header>

    <AgentToSeedBridge locale="zh" />
    <SeedStudentReproductionGuide locale="zh" />

    <section class="after-reproduction" aria-labelledby="after-reproduction-title">
      <p class="guide-eyebrow">实验跑完之后</p>
      <h2 id="after-reproduction-title">再用网站里的其他页面回答新的问题</h2>
      <p>先把这次复现的 checkpoint、配置、硬件、结果和证据存好。下一步如果要换模型、比较新一代 Qwen，或者把四卡实验迁到云端，网站里的论文页、模型页、对比页和工作台就接着用这份实验记录往下走。</p>
      <div class="next-links">
        <a href={localePath('zh', '/papers/seed/')}><strong>SEED 论文页</strong><span>重新核对论文条件和结果</span></a>
        <a href={localePath('zh', '/models/qwen2-5-3b-instruct/')}><strong>Qwen2.5-3B-Instruct</strong><span>确认 checkpoint、权重和可训练性</span></a>
        <a href={`${localePath('zh', '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1`}><strong>研究工作台</strong><span>记录四卡结果、8 卡迁移和模型替换</span></a>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .page-header { max-width: 920px; padding-bottom: 20px; }
  .page-header h1 { max-width: 880px; }
  .guide-eyebrow { margin: 0 0 7px; color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .hardware-note { max-width: 840px; margin-top: 14px; padding: 12px 14px; border-left: 3px solid var(--line); background: var(--surface-muted); color: var(--muted); font-size: .86rem; line-height: 1.6; }
  .hardware-note strong { color: var(--text); }
  .after-reproduction { margin: 0 0 80px; padding-top: 34px; border-top: 1px solid var(--line); }
  .after-reproduction h2 { max-width: 760px; margin: 6px 0 10px; }
  .after-reproduction > p:not(.guide-eyebrow) { max-width: 800px; color: var(--muted); line-height: 1.7; }
  .next-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 22px; border-top: 1px solid var(--line); }
  .next-links a { padding: 16px 16px 16px 0; color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .next-links a + a { padding-left: 16px; border-left: 1px solid var(--line); }
  .next-links strong, .next-links span { display: block; }
  .next-links span { margin-top: 4px; color: var(--muted); font-size: .86rem; }
  @media (max-width: 700px) { .next-links { grid-template-columns: 1fr; } .next-links a + a { padding-left: 0; border-left: 0; } }
</style>
