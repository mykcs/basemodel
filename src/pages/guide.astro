---
import AppLayout from '../layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { getMessages, localePath } from '../i18n';
import AgentToSeedBridge from '../components/AgentToSeedBridge.astro';
import SeedOwnedComputePath from '../components/SeedOwnedComputePath.astro';
import { openEvoScientificState } from '../lib/openEvoScientificState';
const m = getMessages('zh');
const guideRecord = (await getCollection('guides'))[0]?.data;
---
<AppLayout title={m.guide.pageTitle} description="理解 Agent、SEED 与 OpenEvo 的运行和训练机制，并进入可追溯的 WebShop 实验状态与复现指南。" locale="zh">
  <div class="shell editorial-page guide-learning-page" data-guide-source={guideRecord ? 'collection' : 'fallback'}>
    <header class="page-header">
      <span class="section-kicker">学习指南</span>
      <h1>Agent、SEED 与 OpenEvo</h1>
      <p class="lede">从多步 Agent 运行开始，理解 SEED 的参数学习与 OpenEvo 的跨任务演化，再进入 WebShop 实验的历史证据、默认分支快照和实时状态入口。</p>
    </header>

    <AgentToSeedBridge locale="zh" />

    <section class="section" aria-labelledby="seed-guide-title">
      <div class="section-heading"><div><span class="section-kicker">论文方法</span><h2 id="seed-guide-title">SEED 复现参考</h2></div></div>
      <p>SEED 论文主线使用 Qwen2.5-3B-Instruct、ALFWorld 与 WebShop，并包含 hindsight-skill SFT、on-policy rollout、GRPO 与 OPD。严格复现时应优先固定论文模型、任务协议和训练定义。</p>
      <div class="guide-cards">
        <a href={localePath('zh','/papers/seed/')}><strong>SEED 论文页</strong><span>论文条件、模型角色、训练阶段和复现材料</span></a>
        <a href={localePath('zh','/research/seed-openevo/seed/')}><strong>SEED 方法</strong><span>hindsight skill、OPD、GRPO 与参数更新</span></a>
        <a href={localePath('zh','/research/seed-openevo/benchmarks/')}><strong>ALFWorld / WebShop</strong><span>任务、动作、评分与失败证据</span></a>
      </div>
    </section>

    <SeedOwnedComputePath locale="zh" />

    <section class="section" aria-labelledby="openevo-guide-title">
      <div class="section-heading"><div><span class="section-kicker">实验状态</span><h2 id="openevo-guide-title">OpenEvo × WebShop</h2></div></div>
      <p>正式实验由 <code>openevo-experiment</code> 维护。本站在 <time datetime={openEvoScientificState.checkedAt}>{openEvoScientificState.checkedAt}</time> 核验默认 <code>main</code> 时，<code>current-campaign.json</code> 记录 <strong>{openEvoScientificState.defaultBranchSnapshot.phase}</strong> / <code>{openEvoScientificState.defaultBranchSnapshot.status}</code>。这是带日期的默认分支快照，不等于任何可能更靠前的活跃科学分支。</p>
      <p class="hardware-truth">模型目录里的硬件档位只是粗粒度分类；工作台显存计算器给出的是<strong>启发式规划估算</strong>，<strong>不是硬件实测</strong>。{openEvoScientificState.gpuRule.zh}</p>
      <p>{openEvoScientificState.liveStateRule.zh}</p>
      <div class="guide-cards">
        <a href={localePath('zh','/guide/openevo-webshop-alfworld/')}><strong>复现指南</strong><span>运行拓扑、实验身份、WebShop 合同与状态解析</span></a>
        <a href={localePath('zh','/research/seed-openevo/experiment/')}><strong>实验入口</strong><span>WebShop 数据流、历史里程碑和实时状态来源</span></a>
        <a href={localePath('zh','/research/seed-openevo/results/')}><strong>实验结果</strong><span>Phase D–G 历史证据、默认分支快照与实时 claim 路由</span></a>
      </div>
    </section>

    <section class="section" aria-labelledby="history-guide-title">
      <div class="section-heading"><div><span class="section-kicker">历史</span><h2 id="history-guide-title">RTX6 与旧仓库</h2></div></div>
      <p><code>seed3090</code> 与 <code>openevo-webshop</code> 仍用于追溯 RTX6（4×RTX3090）工程经验、WebShop bring-up、失败轨迹和早期 SD-LoRA 诊断，但不再是当前实验入口。</p>
    </section>
  </div>
</AppLayout>

<style>
  .guide-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.guide-cards a{padding:1rem;border:1px solid var(--line);border-radius:14px;color:inherit;text-decoration:none}.guide-cards strong,.guide-cards span{display:block}.guide-cards span{margin-top:.4rem;color:var(--muted);font-size:.76rem;line-height:1.45}.section>p{max-width:78ch;color:var(--muted);line-height:1.65}.hardware-truth{padding:.75rem .85rem;border-left:2px solid var(--accent-deep);background:var(--surface-muted);font-size:.78rem}@media(max-width:720px){.guide-cards{grid-template-columns:1fr}}
</style>
