---
import AppLayout from '../layouts/AppLayout.astro';
import { getMessages, localePath } from '../i18n';
import SeedStudentReproductionGuide from '../components/SeedStudentReproductionGuide.astro';
const m = getMessages('zh');
const title = '复现 SEED：先在 4×3090 跑通 ALFWorld 和 WebShop';
const lede = '这是一条可以照着执行的实验主线。服务器没有公网，就先在联网端把模型、数据和依赖准备齐，再用 SFTP 送进四卡服务器。每一步都有命令和通过标准；四张 3090 如果能把两套实验完整跑完，就在这里结束。';
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="zh">
  <div class="shell editorial-page guide-learning-page">
    <header class="page-header">
      <p class="guide-eyebrow">SEED · Qwen2.5-3B-Instruct · 4×RTX 3090 24GB</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
    </header>

    <SeedStudentReproductionGuide locale="zh" />

    <section class="after-reproduction" aria-labelledby="after-reproduction-title">
      <p class="guide-eyebrow">复现之后</p>
      <h2 id="after-reproduction-title">先把这次实验记录清楚，再考虑换模型或迁移其他论文</h2>
      <p>SEED 主线跑完以后，网站里的论文页、模型页和研究工作台才开始发挥作用：核对论文条件、记录你的硬件替代、比较新的 backbone，并保留为什么要改的证据。不要在实验没跑通时同时改模型、数据和训练方法。</p>
      <div class="next-links">
        <a href={localePath('zh', '/papers/seed/')}><strong>SEED 论文页</strong><span>核对论文方法、硬件和结果</span></a>
        <a href={localePath('zh', '/models/qwen2-5-3b-instruct/')}><strong>Qwen2.5-3B-Instruct</strong><span>核对 checkpoint、权重和运行条件</span></a>
        <a href={`${localePath('zh', '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1`}><strong>研究工作台</strong><span>记录 3090 / 8 卡迁移和实验决策</span></a>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .page-header { max-width: 900px; padding-bottom: 20px; }
  .page-header h1 { max-width: 850px; }
  .guide-eyebrow { margin: 0 0 7px; color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .after-reproduction { margin: 0 0 80px; padding-top: 34px; border-top: 1px solid var(--line); }
  .after-reproduction h2 { max-width: 760px; margin: 6px 0 10px; }
  .after-reproduction > p:not(.guide-eyebrow) { max-width: 800px; color: var(--muted); line-height: 1.7; }
  .next-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 22px; border-top: 1px solid var(--line); }
  .next-links a { padding: 16px 16px 16px 0; color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .next-links a + a { padding-left: 16px; border-left: 1px solid var(--line); }
  .next-links strong, .next-links span { display: block; }
  .next-links span { margin-top: 4px; color: var(--muted); font-size: .86rem; }
  @media (max-width: 700px) {
    .next-links { grid-template-columns: 1fr; }
    .next-links a + a { padding-left: 0; border-left: 0; }
  }
</style>
