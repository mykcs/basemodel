---
import AppLayout from '../layouts/AppLayout.astro';
import { getMessages } from '../i18n';
import { getCollection } from 'astro:content';
import GuideContent from '../components/GuideContent.astro';
const m = getMessages('zh');
const guide = (await getCollection('guides'))[0]?.data;
const steps = guide?.steps_zh ?? m.guide.steps;
const title = guide?.title_zh ?? m.guide.title;
const lede = guide?.lede_zh ?? m.guide.lede;
const note = guide?.note_zh ?? m.guide.note;
const concepts = guide?.concepts ?? [];
const glossary = guide?.glossary ?? [];
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="zh"><div class="shell editorial-page"><header class="page-header"><span class="section-kicker">{m.nav.guide}</span><h1>{title}</h1><p class="lede">{lede}</p></header><GuideContent locale="zh" concepts={concepts} glossary={glossary} steps={steps} note={note} /></div></AppLayout>
