---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentSelector from '../components/ExperimentSelector';
import ModelCard from '../components/ModelCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { papersForModel } from '../lib/modelRelations';

const modelEntries = await getCollection('models');
const paperEntries = await getCollection('papers');
const models = modelEntries.map((entry) => entry.data);
const papers = paperEntries.map((entry) => entry.data);
const latest = [...models].sort((a, b) => b.release_date.localeCompare(a.release_date)).slice(0, 3);
const vendorCount = new Set(models.map((model) => model.vendor)).size;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="研究者的模型选择入口">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <div class="eyebrow">Agent Foundation Model Atlas</div>
        <h1>把模型选择，变成一条可核验的研究路径。</h1>
        <p class="lede">面向智能体与自进化实验的基础模型地图。先看供应层，再看论文采用层；未知值保留未知，演示数据明确标记。</p>
      </div>
      <aside class="hero-note"><div class="section-kicker">How to read</div><p><strong>模型供应层</strong>回答“现在能选什么”；<strong>研究采用层</strong>回答“论文实际怎么用”。推荐只是规则筛选，不是性能排名。</p><a class="text-link" href={`${base}models/`}>浏览全部模型 →</a></aside>
    </div>
  </section>

  <div class="shell">
    <div class="stats" aria-label="数据统计"><div class="stat"><strong>{models.length}</strong><span>模型 checkpoint</span></div><div class="stat"><strong>{vendorCount}</strong><span>厂商 / 提供方</span></div><div class="stat"><strong>{papers.length}</strong><span>论文记录</span></div></div>
    <section class="section" aria-labelledby="selector-title"><div class="section-heading"><div><div class="section-kicker">Start here</div><h2 id="selector-title">告诉我你的实验条件</h2></div><span class="muted">输出候选，不输出伪排名</span></div><ExperimentSelector client:load models={models} /></section>
    <section class="section" aria-labelledby="latest-title"><div class="section-heading"><div><div class="section-kicker">Supply layer</div><h2 id="latest-title">最近记录的模型</h2></div><a class="text-link" href={`${base}models/`}>查看模型浏览器 →</a></div><div class="model-grid">{latest.map((model) => <ModelCard model={model} paperCount={papersForModel(papers, model.id).length} />)}</div></section>
    <section class="section" aria-labelledby="method-title"><div class="section-heading"><div><div class="section-kicker">Data contract</div><h2 id="method-title">证据状态是产品的一部分</h2></div></div><div class="tag-row"><StatusBadge status="verified" /><StatusBadge status="partial" /><StatusBadge status="demo" /><StatusBadge status="unknown" /></div><p class="muted">每条模型和论文记录都要求来源 URL 与最后核验日期。当前 MVP 使用少量演示记录验证页面结构；批量录入真实资料前，请先替换这些占位来源。</p></section>
  </div>
</BaseLayout>
