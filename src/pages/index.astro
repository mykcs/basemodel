---
import AppLayout from '../layouts/AppLayout.astro';
import Body from './_bodies/home-v2.astro';
import { getMessages, isLocale, type Locale } from '../i18n';
const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh';
const m = getMessages(locale);
---
<AppLayout title={m.v2.home.overviewTitle} description={m.v2.home.heroLede} locale={locale}><Body locale={locale} /></AppLayout>
