---
import AppLayout from '../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../components/research/SeedOpenEvoResearchPage.astro';
import { localePath } from '../../../i18n';
const locale = 'zh' as const;
---
<AppLayout title="ALFWorld 与 WebShop 实验协议" description="比较两个 Agent 基准的动作空间、成功标准、归一化任务分数、宏平均、失败模式与受控比较条件。" locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="benchmarks">
    <nav class="benchmark-route-links" aria-label="独立环境讲解">
      <a href={localePath(locale, '/research/seed-openevo/webshop/')}><strong>WebShop</strong><span>购物网页交互与评分 →</span></a>
      <a href={localePath(locale, '/research/seed-openevo/alfworld/')}><strong>ALFWorld</strong><span>物体状态与动作前置条件 →</span></a>
    </nav>
    <p class="benchmark-route-note">环境总览保留为入口；具体的环境示意图分别放在 WebShop 与 ALFWorld 专页，避免同一张图在多个页面重复出现。</p>
  </SeedOpenEvoResearchPage>
</AppLayout>

<style>
  .benchmark-route-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin-bottom: .7rem; }
  .benchmark-route-links a { padding: .85rem 1rem; border: 1px solid var(--line); border-radius: 10px; color: inherit; text-decoration: none; }
  .benchmark-route-links strong, .benchmark-route-links span { display: block; }
  .benchmark-route-links span { margin-top: .28rem; color: var(--muted); font-size: .72rem; }
  .benchmark-route-links a:hover, .benchmark-route-links a:focus-visible { border-color: var(--accent-deep); background: color-mix(in srgb, var(--accent) 5%, var(--surface)); }
  .benchmark-route-note { max-width: 76ch; margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.65; }
  @media (max-width: 640px) { .benchmark-route-links { grid-template-columns: 1fr; } }
</style>
