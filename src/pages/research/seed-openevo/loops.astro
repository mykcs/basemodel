---
import AppLayout from '../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../components/research/SeedOpenEvoResearchPage.astro';
import SeedOpenEvoCanonicalFigure from '../../../components/research/SeedOpenEvoCanonicalFigure.astro';
const locale = 'zh' as const;
---
<AppLayout title="SEED 与 OpenEvo 循环对比" description="用一张论文式 canonical framework figure 比较 SEED 的 policy 参数更新与 OpenEvo 的跨任务 carrier/revision 演化，避免在同一页重复呈现两套比较图。" locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="loops">
    <SeedOpenEvoCanonicalFigure locale={locale} />
  </SeedOpenEvoResearchPage>
</AppLayout>
