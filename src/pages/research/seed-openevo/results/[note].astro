---
import AppLayout from '../../../../layouts/AppLayout.astro';
import WebShopTrainingNote, { type WebShopTrainingNoteId } from '../../../../components/research/WebShopTrainingNote.astro';

export function getStaticPaths() {
  return [
    { params: { note: 'webshop-training' } },
    { params: { note: 'seed-training' } },
    { params: { note: 'openevo-training' } },
  ];
}

const note = Astro.params.note as WebShopTrainingNoteId;
const meta: Record<WebShopTrainingNoteId, { title: string; description: string }> = {
  'webshop-training': {
    title: 'WebShop 是什么？大家以前怎么训练它？',
    description: '从 WebShop 的交互环境开始，解释原始 imitation learning / reinforcement learning，以及现代 LLM agent 的 on-policy multi-turn RL。',
  },
  'seed-training': {
    title: 'SEED 怎么在 WebShop 上训练？',
    description: '拆解 SEED 的 hindsight-skill SFT、on-policy rollout、OPD 与 RL，并记录论文协议和公开代码默认值之间的复现差异。',
  },
  'openevo-training': {
    title: '我们怎么训练 OpenEvo × WebShop？',
    description: '解释 OpenEvo × WebShop 的成功经验筛选、SD-LoRA 参数写入、fresh-task evaluation、连续更新门与 SEED-aligned benchmark 边界。',
  },
};
---

<AppLayout title={meta[note].title} description={meta[note].description} locale="zh">
  <WebShopTrainingNote note={note} />
</AppLayout>

<style is="global">
  /*
   * The note component was originally authored with a fixed dark palette.
   * Route-level semantic overrides make the reading surface follow the site's
   * tested light/dark tokens instead of forcing dark mode inside a light page.
   */
  .site-main .training-note.training-note {
    --ink: var(--color-text);
    --muted: var(--color-text-muted);
    --line: var(--color-border);
    --panel: var(--color-surface-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    color: var(--color-text);
    color-scheme: inherit;
  }

  .site-main .training-note .note-topline,
  .site-main .training-note .scope,
  .site-main .training-note .dek {
    color: var(--color-text-muted);
  }

  .site-main .training-note .note-topline a,
  .site-main .training-note a {
    color: var(--color-accent);
  }

  .site-main .training-note .series-nav a {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .site-main .training-note .series-nav a:hover,
  .site-main .training-note .series-nav a:focus-visible {
    background: var(--color-surface-muted);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .site-main .training-note .series-nav a span {
    color: var(--color-text-muted);
  }

  .site-main .training-note .series-nav a:hover span,
  .site-main .training-note .series-nav a:focus-visible span,
  .site-main .training-note .series-nav a.active span {
    color: var(--color-text);
  }

  .site-main .training-note .series-nav a.active {
    background: var(--color-surface-muted);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .site-main .training-note .note-body h2,
  .site-main .training-note .note-body p,
  .site-main .training-note .note-body strong,
  .site-main .training-note blockquote,
  .site-main .training-note td,
  .site-main .training-note .references li,
  .site-main .training-note .checklist li,
  .site-main .training-note .note-footer strong {
    color: var(--color-text);
  }

  .site-main .training-note code {
    color: var(--color-accent);
  }

  .site-main .training-note pre {
    background: var(--color-surface-muted);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .site-main .training-note blockquote {
    border-left-color: var(--color-accent);
  }

  .site-main .training-note .comparison-list > div {
    background: var(--color-surface-muted);
    border-color: var(--color-border);
  }

  .site-main .training-note .table-wrap {
    border-color: var(--color-border);
  }

  .site-main .training-note table {
    background: var(--color-surface);
  }

  .site-main .training-note th,
  .site-main .training-note td {
    border-bottom-color: var(--color-border);
  }

  .site-main .training-note th,
  .site-main .training-note .note-footer {
    color: var(--color-text-muted);
  }

  .site-main .training-note .references,
  .site-main .training-note .note-footer {
    border-color: var(--color-border);
  }

  @media (max-width:720px) {
    .site-main .training-note.training-note {
      border-left: 0;
      border-right: 0;
      border-radius: 0;
    }
  }
</style>
