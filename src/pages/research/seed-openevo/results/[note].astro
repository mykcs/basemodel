---
import AppLayout from '../../../../layouts/AppLayout.astro';
import OpenEvoWebShopResultNote, { type OpenEvoWebShopResultNoteId } from '../../../../components/research/OpenEvoWebShopResultNote.astro';
import OpenEvoWebShopBenchmarkNote, { type OpenEvoWebShopBenchmarkNoteId } from '../../../../components/research/OpenEvoWebShopBenchmarkNote.astro';
import ResearchPrimerMoved, { type ResearchPrimerMovedId } from '../../../../components/research/ResearchPrimerMoved.astro';

const primerNotes = new Set<ResearchPrimerMovedId>(['webshop-training', 'seed-training', 'openevo-training']);
const resultNotes = new Set<OpenEvoWebShopResultNoteId>([
  'why-it-kept-failing',
  'first-positive-transfer',
  'independent-replication',
  'second-generation',
  'measurement-boundary',
  'current-conclusion',
]);
const benchmarkNotes = new Set<OpenEvoWebShopBenchmarkNoteId>(['benchmark-first', 'seed-faithful-benchmark', 'openevo-benchmark-design']);

// getStaticPaths runs in an isolated build-time scope and cannot see module-scope constants,
// so the note ids are intentionally inlined here instead of spreading the Sets above.
export function getStaticPaths() {
  return [
    'webshop-training',
    'seed-training',
    'openevo-training',
    'why-it-kept-failing',
    'first-positive-transfer',
    'independent-replication',
    'second-generation',
    'measurement-boundary',
    'current-conclusion',
    'benchmark-first',
    'seed-faithful-benchmark',
    'openevo-benchmark-design',
  ].map((note) => ({ params: { note } }));
}

const note = Astro.params.note!;
const meta: Record<string, { title: string; description: string }> = {
  'webshop-training': {
    title: 'WebShop 的任务与评测规则',
    description: '解释 WebShop 的观察（observation）、动作（action）和奖励（reward），以及小型商品世界（small world）、合成任务目标（synthetic goals）、SEED 任务划分和最终评分。',
  },
  'seed-training': {
    title: 'SEED 在 WebShop 上怎样训练',
    description: '解释 SEED 怎样把事后经验整理成技能（hindsight skill），再通过监督微调（SFT）和 GRPO 更新模型，以及训练与推理阶段的边界。',
  },
  'openevo-training': {
    title: 'OpenEvo 怎样从经验更新自己',
    description: '解释 OpenEvo 的任务边界（task boundary）、经验载体（experience carrier）、验证（validation）和后继版本（successor revision）怎样连接起来。',
  },
  'why-it-kept-failing': {
    title: '为什么早期迁移实验长期没有正向信号？',
    description: '回看 H1.16–H1.29：经验载体（carrier）、交互长度（horizon）、动作过滤（action filtering）、理想动作标签（oracle labels）和任务身份（task identity）分别造成了什么影响。',
  },
  'first-positive-transfer': {
    title: 'H1.38B：第一次可靠的内部新任务迁移',
    description: 'H1.38B 在 goal_idx ≥ 500 的任务 ID 不重叠面板（task-ID-disjoint panel）上得到第一代正向迁移信号；它不是 SEED 官方保留任务结果。',
  },
  'independent-replication': {
    title: 'H1.39：第一代内部迁移的独立复现',
    description: '换一批任务 ID 不重叠的新任务后，再次观察到普通 LoRA（ordinary LoRA）和 SD-LoRA 相对基础模型（BASE）的正向迁移。',
  },
  'second-generation': {
    title: 'H1.40：第二代持续整合为什么没有通过门槛？',
    description: 'E2 的新经验和 G2 适配器（adapter）都真实存在，但新经验获取（acquisition）、旧能力保持（retention）和已有收益保持（preservation）没有同时通过，因此 T2 没有打开。',
  },
  'measurement-boundary': {
    title: 'H1.41–H1.42：测量边界与不能下的结论',
    description: '区分测量无效（measurement-invalid）的结果、没有打开的 T2，以及仍然可以保留的上游机制证据。',
  },
  'current-conclusion': {
    title: '截至 H1.41，OpenEvo × WebShop 能下什么结论？',
    description: '把已经有证据支持、尚未得到支持、测量无效和仍待正式比较的结论分开。',
  },
  'benchmark-first': {
    title: '为什么还需要一场正式的 WebShop 比较？',
    description: '现有实验已经回答一部分机制问题并复现第一代内部迁移；还缺 OpenEvo 与 SEED 在同一套官方保留任务上的正式比较。',
  },
  'seed-faithful-benchmark': {
    title: '怎样才算和 SEED 公平比较？',
    description: '固定 WebShop 小型商品世界（small world）、任务边界、任务目标顺序（goal ordering）、交互规则、评估任务身份和评分方式。',
  },
  'openevo-benchmark-design': {
    title: 'OpenEvo 的不同进化方式应该怎样比较？',
    description: '把经验载体和反馈密度拆成两个实验变量，在公平比较之后再检验原生路径（Native）、参数化路径（Param）、稀疏反馈（Sparse）与密集反馈（Dense）等变体。',
  },
};
const current = meta[note];
if (!current) throw new Error(`Unknown result note: ${note}`);
---
<AppLayout title={current.title} description={current.description} locale="zh">
  {primerNotes.has(note as ResearchPrimerMovedId) && <ResearchPrimerMoved note={note as ResearchPrimerMovedId} />}
  {resultNotes.has(note as OpenEvoWebShopResultNoteId) && <OpenEvoWebShopResultNote note={note as OpenEvoWebShopResultNoteId} />}
  {benchmarkNotes.has(note as OpenEvoWebShopBenchmarkNoteId) && <OpenEvoWebShopBenchmarkNote note={note as OpenEvoWebShopBenchmarkNoteId} />}
</AppLayout>
