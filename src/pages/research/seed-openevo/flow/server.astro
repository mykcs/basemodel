---
import AppLayout from '../../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchNav from '../../../../components/research/SeedOpenEvoResearchNav.astro';
import Lyg2171ServerOverview from '../../../../components/research/Lyg2171ServerOverview.astro';
const locale = 'zh' as const;
---
<AppLayout title="lyg2171 服务器简介" description="lyg2171 实验服务器的硬件与资源快照：CPU、内存、8×RTX 5090，以及 2026-09-02 的主文件系统容量、匿名用户 1–6 与我们的主目录 / Docker 写入层占用和剩余空间。" locale={locale}>
  <div class="server-route">
    <SeedOpenEvoResearchNav locale={locale} page="server" />
    <Lyg2171ServerOverview locale={locale} />
  </div>
</AppLayout>

<style>
  .server-route{width:min(1160px,calc(100% - 2rem));margin:1rem auto 4rem}
  @media(max-width:720px){.server-route{width:min(100% - 1rem,1160px);margin-top:.6rem}}
</style>