---
import AppLayout from '../../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../../components/research/SeedOpenEvoResearchPage.astro';
import InteractiveResearchExplainer from '../../../../components/research/InteractiveResearchExplainer.tsx';
const locale = 'zh' as const;
---
<AppLayout title="ALFWorld 任务与评测" description="ALFWorld 是文本化具身任务 benchmark：Agent 在可执行家务世界中完成长程任务；本页分别解释任务成功、任务家族成功率、macro-average、世界状态、动作前置条件与 data split。" locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="alfworld">
    <InteractiveResearchExplainer locale={locale} kind="alfworld" client:visible />
  </SeedOpenEvoResearchPage>
</AppLayout>
