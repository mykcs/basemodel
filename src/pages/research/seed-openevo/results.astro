---
import AppLayout from '../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../components/research/SeedOpenEvoResearchPage.astro';
import OpenEvoWebShopProgramReport from '../../../components/research/OpenEvoWebShopProgramReport.astro';
import Seed3090ParametricProgress from '../../../components/research/Seed3090ParametricProgress.astro';
const locale = 'zh' as const;
---
<AppLayout title="OpenEvo × WebShop：自进化实验结果" description="OpenEvo 如何在 WebShop 上从经验更新参数、目前数据支持到哪一步，以及下一版自进化方法应该优先修改什么。" locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="results">
    <OpenEvoWebShopProgramReport locale={locale}>
      <Seed3090ParametricProgress slot="historical" locale={locale} />
    </OpenEvoWebShopProgramReport>
  </SeedOpenEvoResearchPage>
</AppLayout>

<style is:global>
  body:has([data-program-report]) .plain-detail__header,
  body:has([data-program-report]) .plain-detail__tabs,
  body:has([data-program-report]) .research-context-bar,
  body:has([data-program-report]) .page-outline,
  body:has([data-program-report]) .compare-tray,
  body:has([data-program-report]) .global-quick-view { display:none!important; }
  body:has([data-program-report]) .plain-detail { width:min(1120px,calc(100% - 2rem));margin:1.4rem auto 4rem; }
  body:has([data-program-report]) .plain-detail__interactive { margin:0; }
  @media(max-width:720px){body:has([data-program-report]) .plain-detail{width:min(100% - 1rem,1120px);margin-top:.75rem}}
</style>
