---
import AppLayout from '../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../components/research/SeedOpenEvoResearchPage.astro';
import OpenEvoWebShopResultIndex from '../../../components/research/OpenEvoWebShopResultIndex.astro';
const locale = 'zh' as const;
---
<AppLayout
  title="OpenEvo × WebShop 实验结果目录"
  description="OpenEvo × WebShop 研究笔记索引：从 WebShop、SEED 与 OpenEvo 的训练方法，到早期负结果、第一次正向迁移、独立复现、第二次连续写入与当前结论边界。"
  locale={locale}
>
  <SeedOpenEvoResearchPage locale={locale} page="results">
    <OpenEvoWebShopResultIndex />
  </SeedOpenEvoResearchPage>
</AppLayout>

<style is:global>
  body:has([data-testid='openevo-webshop-result-index']) .plain-detail__header { display:none; }

  /* Results owns this heading geometry. Generic sitewide `.section-heading`
   * refinement must never collapse the REFERENCE copy into a one-character rail. */
  [data-testid='openevo-webshop-result-index'] .section-heading {
    display:grid !important;
    grid-template-columns:150px minmax(0,720px) !important;
    align-items:start !important;
    gap:28px !important;
    width:100%;
    min-width:0;
  }
  [data-testid='openevo-webshop-result-index'] .section-heading > div {
    width:100%;
    min-width:0;
    max-width:720px;
  }
  [data-testid='openevo-webshop-result-index'] .section-heading h2 {
    width:100%;
    min-width:0;
    max-width:22ch !important;
    overflow-wrap:normal;
    word-break:normal;
  }
  [data-testid='openevo-webshop-result-index'] .section-heading div > p {
    width:100%;
    max-width:62ch;
  }
  @media (max-width:760px) {
    [data-testid='openevo-webshop-result-index'] .section-heading {
      grid-template-columns:1fr !important;
      gap:8px !important;
    }
    [data-testid='openevo-webshop-result-index'] .section-heading h2 {
      max-width:none !important;
    }
  }
</style>
