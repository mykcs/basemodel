---
import AppLayout from '../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../components/research/SeedOpenEvoResearchPage.astro';
import OpenEvoWebShopResultIndex from '../../../components/research/OpenEvoWebShopResultIndex.astro';
import OpenEvoResearchEvidenceMap from '../../../components/research/OpenEvoResearchEvidenceMap.astro';
const locale = 'zh' as const;
---
<AppLayout
  title="OpenEvo × WebShop 研究结果"
  description="从最初研究问题出发，按七个自然科学问题组织 OpenEvo × WebShop 的现有证据、关键结果、结论边界与最后缺失的 SEED-compatible fair comparison（与 SEED 严格兼容的公平比较）。"
  locale={locale}
>
  <SeedOpenEvoResearchPage locale={locale} page="results">
    <OpenEvoWebShopResultIndex />
    <OpenEvoResearchEvidenceMap />
  </SeedOpenEvoResearchPage>
</AppLayout>

<style is:global>
  body:has([data-testid='openevo-webshop-result-index']) .plain-detail__header { display:none; }
  [data-testid='openevo-webshop-result-index'] .reference-index { display:block !important; }
</style>
