---
import AppLayout from '../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../components/research/SeedOpenEvoResearchPage.astro';
import OpenEvoWebShopProgramReport from '../../../components/research/OpenEvoWebShopProgramReport.astro';
import Seed3090ParametricProgress from '../../../components/research/Seed3090ParametricProgress.astro';
const locale = 'zh' as const;
---
<AppLayout title="OpenEvo × WebShop：自进化实验结果" description="OpenEvo 如何在 WebShop 上从经验更新参数、目前数据支持到哪一步，以及下一版自进化方法应该优先修改什么；包含 H1.38A-C 冻结面板与完整证据附录。" locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="results">
    <OpenEvoWebShopProgramReport locale={locale}>
      <Seed3090ParametricProgress slot="historical" locale={locale} />
    </OpenEvoWebShopProgramReport>
  </SeedOpenEvoResearchPage>
</AppLayout>

<style is:global>
  /* Keep the shared global header visible. Paper mode only removes non-navigation chrome. */
  body:has([data-program-report]) .site-footer,
  body:has([data-program-report]) .plain-detail__header,
  body:has([data-program-report]) .plain-detail__tabs,
  body:has([data-program-report]) .research-context-bar,
  body:has([data-program-report]) .page-outline,
  body:has([data-program-report]) .compare-tray,
  body:has([data-program-report]) .global-quick-view,
  body:has([data-program-report]) .actionable-content-status { display:none!important; }

  body:has([data-program-report]) .site-main { padding-top:0!important; }
  body:has([data-program-report]) .plain-detail { width:min(1160px,calc(100% - 3rem));margin:0 auto 6rem; }
  body:has([data-program-report]) .plain-detail__interactive { margin:0; }

  body:has([data-program-report]) .paper-report { width:min(1000px,100%)!important;padding-inline:0!important; }
  body:has([data-program-report]) .paper-header { max-width:800px!important;padding:4.5rem 0 3.25rem!important; }
  body:has([data-program-report]) .paper-header h1 { max-width:780px!important;line-height:1.12!important; }
  body:has([data-program-report]) .abstract { max-width:760px!important;margin-top:1.9rem!important;line-height:1.9!important; }
  body:has([data-program-report]) .thesis { max-width:720px!important;margin-top:1.55rem!important;padding-left:1.2rem!important;line-height:1.85!important; }

  body:has([data-program-report]) .claim-line {
    display:grid!important;
    grid-template-columns:repeat(5,minmax(0,1fr))!important;
    gap:0!important;
    max-width:900px!important;
    margin-top:2.4rem!important;
    padding:1.15rem 0!important;
  }
  body:has([data-program-report]) .claim-line span { white-space:normal!important;padding:0 1rem!important;line-height:1.55!important; }
  body:has([data-program-report]) .claim-line span + span { border-left:1px solid var(--line); }

  body:has([data-program-report]) .paper-nav { margin-bottom:.75rem!important;padding:1rem 0!important;gap:.55rem 1.6rem!important; }
  body:has([data-program-report]) .paper-section { padding:5.75rem 0 6.25rem!important; }
  body:has([data-program-report]) .paper-section h2 { max-width:790px!important;line-height:1.22!important; }
  body:has([data-program-report]) .section-intro { max-width:720px!important;margin:1.35rem 0 3rem!important;font-size:1.01rem!important;line-height:1.85!important; }

  body:has([data-program-report]) .experiment-loop,
  body:has([data-program-report]) .priority-list { max-width:820px!important;margin-top:2.5rem!important; }
  body:has([data-program-report]) .experiment-loop li,
  body:has([data-program-report]) .priority-list li { grid-template-columns:3.5rem minmax(0,1fr)!important;gap:1.5rem!important;padding:1.65rem 0!important; }
  body:has([data-program-report]) .experiment-loop strong,
  body:has([data-program-report]) .priority-list strong { font-size:1.04rem!important;line-height:1.55!important; }
  body:has([data-program-report]) .experiment-loop p,
  body:has([data-program-report]) .priority-list p { max-width:690px!important;margin-top:.55rem!important;line-height:1.78!important; }

  body:has([data-program-report]) .table-region { margin:2.4rem 0 4.75rem!important; }
  body:has([data-program-report]) .table-region th,
  body:has([data-program-report]) .table-region td { padding:1.15rem .85rem!important;line-height:1.65!important; }
  body:has([data-program-report]) .milestone-table td:last-child { min-width:360px!important; }

  body:has([data-program-report]) .evidence-ladder { max-width:880px!important;margin:5rem 0 0!important; }
  body:has([data-program-report]) .evidence-ladder h3 { margin-bottom:1.5rem!important; }
  body:has([data-program-report]) .evidence-ladder li { grid-template-columns:7rem 11rem minmax(0,1fr)!important;gap:1.35rem!important;padding:1.45rem 0!important; }
  body:has([data-program-report]) .evidence-ladder p { line-height:1.72!important; }
  body:has([data-program-report]) .evidence-ladder figcaption { margin-top:1.3rem!important;line-height:1.7!important; }

  body:has([data-program-report]) .subsection-heading { max-width:760px!important;margin:6.25rem 0 2.25rem!important; }
  body:has([data-program-report]) .subsection-heading h3 { font-size:1.35rem!important;line-height:1.45!important; }
  body:has([data-program-report]) .subsection-heading p:last-child { margin-top:1rem!important;line-height:1.8!important; }
  body:has([data-program-report]) .validity-note { margin:-2.7rem 0 3.2rem!important;line-height:1.75!important; }

  body:has([data-program-report]) .figure-heading { max-width:860px!important;margin-top:1rem!important; }
  body:has([data-program-report]) .figure-heading p { line-height:1.65!important; }
  body:has([data-program-report]) .ci-figure figcaption { margin-top:1.2rem!important;line-height:1.75!important; }

  body:has([data-program-report]) .interpretation-list { max-width:850px!important;margin-top:2.5rem!important; }
  body:has([data-program-report]) .interpretation-list>div { grid-template-columns:12.5rem minmax(0,1fr)!important;gap:1.6rem!important;padding:1.65rem 0!important; }
  body:has([data-program-report]) .interpretation-list li,
  body:has([data-program-report]) .interpretation-list p { line-height:1.78!important; }
  body:has([data-program-report]) .inference-block { max-width:760px!important;margin-top:4rem!important;padding:1.8rem 0!important; }
  body:has([data-program-report]) .inference-block p:last-child { line-height:1.85!important; }
  body:has([data-program-report]) .handoff-boundary { max-width:760px!important;margin-top:2.6rem!important;line-height:1.8!important; }

  body:has([data-program-report]) #methods { padding-bottom:4.75rem!important; }
  body:has([data-program-report]) #methods details,
  body:has([data-program-report]) #appendix details { max-width:900px!important;margin-top:2rem!important; }
  body:has([data-program-report]) #methods summary,
  body:has([data-program-report]) #appendix>details>summary { padding:1.35rem 0!important; }
  body:has([data-program-report]) .method-list>div { padding:1rem 0!important; }
  body:has([data-program-report]) .details-body p,
  body:has([data-program-report]) .lineage-body p { line-height:1.78!important; }

  @media(max-width:720px){
    body:has([data-program-report]) .plain-detail { width:min(100% - 1.25rem,1160px);margin-bottom:4rem; }
    body:has([data-program-report]) .paper-header { padding:2.25rem 0 2.5rem!important; }
    body:has([data-program-report]) .paper-header h1 { font-size:2rem!important;line-height:1.16!important; }
    body:has([data-program-report]) .abstract { font-size:1rem!important;line-height:1.82!important; }
    body:has([data-program-report]) .claim-line { grid-template-columns:1fr!important;padding:0!important;margin-top:2rem!important; }
    body:has([data-program-report]) .claim-line span { padding:.85rem .2rem!important; }
    body:has([data-program-report]) .claim-line span + span { border-left:0;border-top:1px solid var(--line); }
    body:has([data-program-report]) .paper-nav { gap:.55rem 1rem!important; }
    body:has([data-program-report]) .paper-section { padding:4rem 0 4.5rem!important; }
    body:has([data-program-report]) .section-intro { margin-bottom:2.3rem!important; }
    body:has([data-program-report]) .experiment-loop li,
    body:has([data-program-report]) .priority-list li { grid-template-columns:2.25rem minmax(0,1fr)!important;gap:.8rem!important;padding:1.4rem 0!important; }
    body:has([data-program-report]) .table-region { margin:2rem 0 3.5rem!important; }
    body:has([data-program-report]) .evidence-ladder { margin-top:4rem!important; }
    body:has([data-program-report]) .evidence-ladder li { grid-template-columns:6.5rem minmax(0,1fr)!important;gap:.55rem 1rem!important;padding:1.3rem 0!important; }
    body:has([data-program-report]) .evidence-ladder li p { grid-column:2!important; }
    body:has([data-program-report]) .subsection-heading { margin-top:4.75rem!important; }
    body:has([data-program-report]) .validity-note { margin:-1.7rem 0 2.6rem!important; }
    body:has([data-program-report]) .interpretation-list>div { grid-template-columns:1fr!important;gap:.65rem!important;padding:1.4rem 0!important; }
    body:has([data-program-report]) .inference-block { margin-top:3rem!important; }
  }
</style>
