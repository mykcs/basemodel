---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import '../../../../../styles/openevo-research-blogs.css';
import '../../../../../styles/research-booktabs.css';
import OpenEvoArticleNavigation from '../../../../../components/research/OpenEvoArticleNavigation.astro';
import AdvisorTenEvidenceVisual from '../../../../../components/research/AdvisorTenEvidenceVisual.astro';
import ExternalBrandMark from '../../../../../components/common/ExternalBrandMark';
import { ADVISOR_QUESTIONS, ADVISOR_RESEARCH_AS_OF } from '../../../../../data/openEvoAdvisorTenQuestions';
import { OPEN_EVO_ADVISOR_MEETING } from '../../../../../data/openEvoAdvisorMeeting';

const readable = (s: string) => s.replaceAll('普通 DirectApply', '普通 OpenEVO').replaceAll('普通 OpenEVO / DirectApply', '普通 OpenEVO');
const status = {
  'bounded-answer':'已有范围明确的结果',
  'partial':'已有部分结果',
  'unrun':'关键实验尚未完成',
} as const;

---
<AppLayout
  title="学长十问：OpenEVO 持续学习的实证回答"
  description="从训练轮数、SFT/OPSD、SEED 对照到参数容量、β、更新方向、熵、遗忘、BUNDLE 文字载体和新任务复现，逐项保留 Q01–Q10 的实际证据与未知边界。"
  locale="zh"
>
  <main class="evo-blog evo-article" data-evo-blog="questions" data-advisor-ten-questions data-reader-page="research-blog" data-copy-review>
    <header>
      <h1>学长十问：OpenEVO 的实验回答</h1>
      <p class="evo-article__lede" data-reader-purpose>OpenEVO 已经在 WebShop 上跑过长期训练。模型什么时候不再进步？文字记忆和参数更新各有多大作用？为什么本地 SEED 成绩与论文差异很大？围绕这些问题，我们逐项核对已完成的实验、实际观察与仍缺的证据。</p>
    </header>
    <div class="evo-article__abstract">
      <h2>摘要</h2>
      <p>2026 年 9 月 22 日，学长提出六个研究方向；会后把它们拆解为九个可测量问题，另外增加 Q10 独立复现。已得到的局部证据包括：三种参数路线不同的训练平台位置、rank32 容量筛选、第 156 轮更新方向干预，以及旧任务保持和 BUNDLE 文字载体的记录。SEED 复现、严格容量因果判断、遗忘和新任务泛化仍有未完成项。以下十问保留各自的实验身份和可查的原始记录。</p>
    </div>
    <OpenEvoArticleNavigation current="questions" />
    <nav class="evo-article__toc" aria-label="学长十问目录">
      <h2>目录 · 直接跳转到问题</h2>
      <ol>
        {ADVISOR_QUESTIONS.map((q) => <li><a href={'#' + q.id}><strong>{q.id.toUpperCase()}</strong>　{q.title}</a></li>)}
        <li><a href="#synthesis">最后的研究判断</a></li>
        <li><a href="#sources">会议与证据来源</a></li>
      </ol>
    </nav>
    <section class="evo-article__section" id="scope">
      <h2>这十个问题从哪里来</h2>
      <p>研究对象是 OpenEVO 框架内持续更新的 Agent；本地实测主要使用 Qwen3-1.7B 模型和 WebShop 购物任务。学长当时的讨论集中在训练、状态容量、参数方向、行为判断与遗忘。我们保留会议的六项原始方向，并在后续研究中形成下面十个可核查的科学问题。</p>
      <p class="evo-article__note">Q10 是会后延伸出来的独立新任务复现问题，不能写成学长当时逐字提出的第十问。这里使用截至 {ADVISOR_RESEARCH_AS_OF} 的研究证据快照，不能冒充今日实时实验进展。</p>
    </section>
    {ADVISOR_QUESTIONS.map((q,index) => (
      <section class="evo-article__question" id={q.id} data-report-question={q.id} aria-labelledby={q.id + '-title'}>
        <h2 id={q.id + '-title'}>{index+1}. {q.title}</h2>
        <p class="evo-article__note">{status[q.evidenceState]}</p>
        <p>{readable(q.opening)}</p>
        <p><strong>怎么检验：</strong>{readable(q.experiment)}</p>
        <p class="evo-article__answer" data-report-finding={q.id}>{readable(q.finding)}</p>
        {q.id === 'q01' && <AdvisorTenEvidenceVisual variant="q01" />}
        {q.id === 'q02' && <AdvisorTenEvidenceVisual variant="q02" />}
        {q.id === 'q03' && <AdvisorTenEvidenceVisual variant="q03" />}
        {q.id === 'q04' && <AdvisorTenEvidenceVisual variant="q04" />}
        {q.id === 'q05' && <AdvisorTenEvidenceVisual variant="q05" />}
        {q.id === 'q07' && <AdvisorTenEvidenceVisual variant="q07" />}
        <p><strong>当前能得出的判断：</strong>{readable(q.interpretation)}</p>
        <p class="evo-article__limit"><strong>还缺什么：</strong>{readable(q.unknown)}</p>
        <p class="evo-article__note">原始记录：{q.evidence.map((e,i) => <><a href={e.href} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={e.href} />{e.label} ↗</a>{i < q.evidence.length-1 && '　'}</>)}</p>
      </section>
    ))}
    <section id="synthesis" class="evo-article__section">
      <h2>最后的研究判断</h2>
      <p>长期参数记忆的大小、更新幅度与方向都值得独立检验。我们已经在明确的模型与任务面板上观察到容量和方向相关的现象，但不能将某一次成功实验扩展成适用于任意模型、任意任务的通用规律。</p>
      <p>下一步优先完成：可比的 SFT/OPSD 与 SEED 验证、同合同下更完整的容量对照、可靠的旧任务保持与 BUNDLE 文字载体实验，以及真正的新任务随机流复现。结果篇汇总可比较的数据，<a href="/research/seed-openevo/study/parameter-memory-results/">按此阅读实验图表</a>；需要推导 LoRA、Bounded 和 β 算法时，<a href="/research/seed-openevo/study/openevo-methods/">阅读方法篇</a>。</p>
    </section>
    <section id="sources" class="evo-article__section evo-article__sources">
      <h2>会议与证据来源</h2>
      <details class="evo-article__disclosure"><summary>展开：2026 年 9 月 22 日会议的六个原始研究方向</summary>
        <div><ol>{OPEN_EVO_ADVISOR_MEETING.points.map((point) => <li><strong>{point.title}：</strong>{point.text}</li>)}</ol></div>
      </details>
      <ol>
        <li><a href={OPEN_EVO_ADVISOR_MEETING.sourceHref} target="_blank" rel="noopener noreferrer"><ExternalBrandMark href={OPEN_EVO_ADVISOR_MEETING.sourceHref} />会议六方向的历史整理及对应记录</a></li>
        <li><a href="https://github.com/mykcs/openevo-experiment" target="_blank" rel="noopener noreferrer"><ExternalBrandMark href="https://github.com/mykcs/openevo-experiment" />OpenEVO Experiment 项目实验仓库</a></li>
        <li><a href="https://github.com/mykcs/basemodel/blob/main/src/data/openEvoAdvisorTenQuestions.ts" target="_blank" rel="noopener noreferrer"><ExternalBrandMark href="https://github.com/mykcs/basemodel/blob/main/src/data/openEvoAdvisorTenQuestions.ts" />十问问答的原始结构化数据</a></li>
      </ol>
      <p class="evo-article__note">所有详细实验编号保留在各问的原始记录内，正文优先说明科学问题与结果。既有问答数据保持不变，不从新闻、博客或演示推断尚未得到的实验成绩。原始运行记录中若出现 DirectApply 或 No-GDR，指本篇的普通 OpenEVO 参数更新路线。</p>
    </section>
  </main>
</AppLayout>