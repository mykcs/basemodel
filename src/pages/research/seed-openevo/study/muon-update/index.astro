.muon-node{min-width:0;min-height:12rem;border:1px solid var(--paper-line);border-top:3px solid var(--muon-accent);background:var(--paper);padding:1.05rem .78rem;display:flex;flex-direction:column;gap:.3rem}
.muon-node--world{--muon-accent:#4e769c}
.muon-node--signal{--muon-accent:#aa685e}
.muon-node--model{--muon-accent:#8b6a9d}
