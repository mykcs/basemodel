// Derived percent for paper Succ. column; the historical source stays n / 128.
const historicalSuccPercent = (exact: string): string => {
  const m = /^([0-9]+)\s*\/\s*128$/.exec(exact);
  if(!m) throw new Error('Historical exact success count must be n / 128');
  const n = Number(m[1]);
  if(n < 0 || n > 128) throw new Error('Invalid historical success count');
  return (100 * n / 128).toFixed(1);
};



