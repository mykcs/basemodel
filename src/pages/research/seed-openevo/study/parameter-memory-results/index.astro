// Dated Q17 diagnostics: these are distinct experiments from the original Q04/Q07/Q08/Q09 studies.
// All values are copied from the already published source-bound Q17 summary in section 9.
const q17Effects = {
  capacity: [
    { id:'first',label:'首次测试',estimate:-0.87,low:-3.91,high:1.65 },
    { id:'seed',label:'更换随机设置',estimate:-0.61,low:-1.48,high:0.05 },
  ],
  direction: [
    { id:'r129',label:'DirectApply R129',estimate:-1.64,low:-6.02,high:1.96 },
    { id:'r159',label:'DirectApply R159',estimate:-0.85,low:-2.17,high:0 },
  ],
  retention: [
    { id:'old',label:'旧队列完整成功率',estimate:-9.38,low:-23.96,high:4.17 },
  ],
