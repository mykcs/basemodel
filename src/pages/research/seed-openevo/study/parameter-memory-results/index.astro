import { OPEN_EVO_ADVISOR_MEETING } from '../../../../../data/openEvoAdvisorMeeting';

// Section 3 is the experiment-response chapter; source IDs intentionally stay q01–q10.
const responseHeadingNumber = (id: string) => '3.Q'+Number(id.slice(1));

// 科研回答状态与后续投入是本页的规划快照；不覆盖实验仓库的运行账本。
// 人日是人工准备/核对的粗略估计，不是测得的训练耗时或资源承诺。
const researchProgress = {
  q01: { tone:'green', label:'已有局部回答', next:'换一批预先冻结的购物题，复核三条路线各自的停止时点。', effort:'人工约 0.5–1 人日；至少三条路线各做一轮新题评测，机器耗时待实测。' },
  q02: { tone:'yellow', label:'已有初步结果', next:'为已完成的六种初始训练设置补齐同题评测，再安排长期续学比较。', effort:'先需六组同题评测及约 1 人日核账；后续训练预算尚未测定。' },
  q03: { tone:'red', label:'正式复现未完成', next:'完成正式数据 SFT、整段 160 轮 Stage2 与论文协议对应的终评。', effort:'至少一条正式训练链和一套终评；需先打通训练与存储，再实测 GPU 小时，不能用工程开发题耗时推算。' },
  q04: { tone:'yellow', label:'容量结论尚不完整', next:'在同一任务与训练预算下继续比较 rank8、rank16、rank64，并检查后续学习能力。', effort:'至少三档容量的同题评测与续学核对，人工约 1–2 人日；GPU 时长待标定。' },
  q05: { tone:'yellow', label:'历史对照已完成', next:'让新的简单 β 和 Bounded 在相同起点、任务与预算下重新比较任务成绩。', effort:'至少一组匹配对照及重复随机设置，人工约 1–2 人日；训练卡时未测。' },
  q06: { tone:'yellow', label:'只有描述性测量', next:'给七个保存点的任务记录划出互不泄漏的训练集与验证集，检验概率指标能否预测失败。', effort:'需整理七组×64 题的记录并做一次独立验证，人工约 1 人日；若需重取概率还要追加推理。' },
  q07: { tone:'green', label:'已有局部因果回答', next:'换保存点、模型与任务继续重复方向反转干预，再评估能否用于在线更新。', effort:'每新增一个保存点，至少再做一组原始/反向的同题评测；人工约半天起，GPU 耗时待测。' },
  q08: { tone:'yellow', label:'遗忘尚未判定', next:'先找回每道旧题刚学会时的可比测量和任务身份，再与长期训练后对照。', effort:'人工约 1–2 人日核对旧账本；若早期锚点缺失，需要重新训练与评测，卡时未知。' },
  q09: { tone:'yellow', label:'文字贡献尚未判定', next:'分别真正关闭三种文字载体的权限，在同一题单上与原条件配对比较。', effort:'至少三种关闭条件加一组原始条件、每组同批 64 题；人工约 0.5–1 人日，推理耗时待测。' },
  q10: { tone:'red', label:'独立复现尚未完成', next:'先冻结新的任务流与排除规则，再完成三条独立随机流的正式训练及新题终评。', effort:'目标包含三条新训练流，每条按既定 160 轮设计；运行稳定前无法可靠估计 GPU 小时，人工准备约 1–2 人日。' },
} as const;
const responseQuestions = ADVISOR_QUESTIONS.map(q=>({...q,progress:researchProgress[q.id as keyof typeof researchProgress]}));


// Immutable source snapshot only. Scientific status is owned by openevo-experiment, not this page.
const checkpointEvidence = {
  ledger: 'https://github.com/mykcs/openevo-experiment/blob/627da5c0fa9001d94b0891c38de6646b8cc796b2/docs/evidence/checkpoint-measurement-20261012/q17-r159/METRIC_STATUS_78.json',
  repeat8: 'https://github.com/mykcs/openevo-experiment/blob/627da5c0fa9001d94b0891c38de6646b8cc796b2/docs/evidence/checkpoint-measurement-20261014/q17-r159/R159_SUCCESS_AT_K_M1_STRICT_REUSE.json',
  compression: 'https://github.com/mykcs/openevo-experiment/blob/627da5c0fa9001d94b0891c38de6646b8cc796b2/docs/evidence/checkpoint-measurement-20261014/q17-r159/R159_D1_FIXED_PREFIX_SAME_MODEL_EVIDENCE_REUSE.json',
  matrix: 'https://github.com/mykcs/openevo-experiment/blob/627da5c0fa9001d94b0891c38de6646b8cc796b2/docs/evidence/checkpoint-measurement-20261014/CHECKPOINT13_CANONICAL_ALL_13_BY_78_METRIC_MATRIX_V1.json',
  q03: 'https://github.com/mykcs/openevo-experiment/blob/627da5c0fa9001d94b0891c38de6646b8cc796b2/docs/evidence/checkpoint-measurement-20261014/q03-native/Q03_SIX_STEP_672_QKVO_PER_MODULE_STRICT_SOURCE_DERIVATION.json',
  directFinal: 'https://github.com/mykcs/openevo-experiment/blob/04d6bd8e422103aa71be2b8f2672c2db97d0e351/docs/evidence/q17-final-closeout-20260912/FINAL_EVAL_VERIFICATION.json',
  boundedFinal: 'https://github.com/mykcs/openevo-experiment/blob/04d6bd8e422103aa71be2b8f2672c2db97d0e351/docs/evidence/bounded-effective-state-final-closeout-20260918/FINAL_COMPARISON.json',
  resourceAnalysis: 'https://github.com/mykcs/openevo-experiment/blob/04d6bd8e422103aa71be2b8f2672c2db97d0e351/docs/evidence/bounded-effective-state-final-closeout-20260918/STAGE2_GPU_RESOURCE_ANALYSIS.json',
  capacity: 'https://github.com/mykcs/openevo-experiment/pull/597',
  direction: 'https://github.com/mykcs/openevo-experiment/pull/634',
