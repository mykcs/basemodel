import AppLayout from '../../../../../layouts/AppLayout.astro';
import '../../../../../styles/openevo-research-blogs.css';
import '../../../../../styles/research-booktabs.css';
import OpenEvoArticleNavigation from '../../../../../components/research/OpenEvoArticleNavigation.astro';
import AdvisorTenEvidenceVisual from '../../../../../components/research/AdvisorTenEvidenceVisual.astro';
import MathFormula from '../../../../../components/common/MathFormula.astro';
import ExternalBrandMark from '../../../../../components/common/ExternalBrandMark';
import { ADVISOR_Q05_FROZEN, ADVISOR_Q09_UPDATES, ADVISOR_RESEARCH_AS_OF } from '../../../../../data/openEvoAdvisorTenQuestions';
---

<AppLayout
  title="OpenEVO 的长期参数记忆：容量、β 与任务能力的实测结果"
  description="报告三条历史长期训练路线的 WebShop 同题终评、Bounded 参数开销、rank32 与 rank128 的后段配对比较、更新方向干预与 BUNDLE 载体计数，并说明可比性限制。"
  locale="zh"
>
  <main class="evo-blog evo-article" data-evo-blog="results" data-reader-page="research-blog" data-copy-review>
    <header>
      <h1>长期参数记忆的实验结果</h1>
      <p class="evo-article__lede" data-reader-purpose>OpenEVO 逐轮保留模型学到的低秩参数更新。我们完成了三条历史长期学习路线，并进一步测量固定容量、β 写入控制和参数方向与 WebShop 任务能力之间的关系。</p>
    </header>
    <div class="evo-article__abstract">
      <h2>摘要</h2>
      <p>在 160 轮历史实验中，Bounded 的参数更新累计耗时从 <strong>31.09 小时降低到 2.02 小时</strong>，但包括 WebShop 任务执行在内的整段实验只加速约 1.33 倍。三个历史终点在同一冻结 128 题的 Task Score 分别为 <strong>60.72、45.98 和 20.77</strong>。此外，第 152–159 轮的匹配容量筛选显示，rank32 把参数文件缩小约 75%，平均得分比 rank128 低 1.79 分；统计证据仍不足以确认类似任务上会稳定下降。历史终点不构成完全受控的三臂随机试验，方法效果需要与任务身份和实验合同一起解释。</p>
    </div>
    <OpenEvoArticleNavigation current="results" />
    <nav class="evo-article__toc" aria-label="实验文章目录">
      <h2>目录</h2>
      <ol>
        <li><a href="#context">1 研究问题与评测</a></li>
        <li><a href="#experiment">2 实验身份</a></li>
        <li><a href="#main-results">3 长期训练结果</a></li>
        <li><a href="#capacity">4 长期容量</a></li>
        <li><a href="#beta">5 β 写入控制</a></li>
        <li><a href="#direction">6 参数方向</a></li>
        <li><a href="#bundle">7 BUNDLE 载体</a></li>
        <li><a href="#discussion">8 讨论与局限</a></li>
        <li><a href="#sources">原始记录</a></li>
      </ol>
    </nav>
    <section id="context" class="evo-article__section">
      <h2>1 研究问题：长期学习的效率与任务能力</h2>
      <p>OpenEVO 把智能体的任务经验保留到后续轮次。在我们的 WebShop 实验中，Qwen3-1.7B 模型需要按照购物要求搜索商品、选择规格、完成购买。我们用 Task Score（满足要求的程度，满分 100）与完整成功数衡量实际任务能力。</p>
      <p>普通 OpenEVO 逐轮保留新的低秩参数组件；Bounded 把历史整合进固定容量；历史 β 机制进一步控制更新写入。三条路线首先回答“保留历史越来越贵时，模型还能学会多少”这个问题。相关的 LoRA、SD-LoRA、Bounded 和 β 数学结构，在第一篇 <a href="/research/seed-openevo/study/openevo-methods/">方法文章</a>中详细介绍。</p>
    </section>
    <section id="experiment" class="evo-article__section">
      <h2>2 实验设置：四种测量不能混成一次对照</h2>
      <div class="evo-article__tablewrap" tabindex="0" aria-label="各实验统计口径">
        <table>
          <caption>表 1｜不同研究证据的任务和用途</caption>
          <thead><tr><th>测量</th><th>样本与时点</th><th>可以回答什么</th></tr></thead>
          <tbody>
            <tr><th>三条路线终评</th><td>三条历史 160 轮路线各自结束以后，在同一冻结 128 题上测试</td><td>历史模型的同题最终表现；不直接识别每一种算法修改的因果影响</td></tr>
            <tr><th>长期容量筛选</th><td>第 152–159 轮，1,024 组相同任务与随机条件的配对尝试</td><td>该后段窗口的文件容量与任务得分变化</td></tr>
            <tr><th>更新方向干预</th><td>指定模型保存点，冻结 64 题，对某轮更新做方向反转</td><td>局部的方向因果效应</td></tr>
            <tr><th>载体更新计数</th><td>历史长期训练收据</td><td>Text Memory、Skill、Agent System 和参数各更新了多少次</td></tr>
          </tbody>
        </table>
      </div>
      <p class="evo-article__note">每项测量必须保留自己的任务身份、模型起点与评估时点。以满分 100 展示得分，只是统一数字尺度，不意味着不同任务面板可以直接比较。</p>
    </section>
    <section id="main-results" class="evo-article__section">
      <h2>3 历史长期训练：计算更省，最终成绩不同</h2>
      <p>三条路线均已完成 160 轮学习。训练结束后的模型在相同冻结 128 道 WebShop 任务上得到下表成绩：</p>
      <div class="evo-article__tablewrap" tabindex="0" aria-label="三条路线冻结最终测试">
        <table>
          <caption>表 2｜同一冻结 128 题的三个历史终点</caption>
          <thead><tr><th>方法</th><th data-numeric>Task Score / 100</th><th data-numeric>完整成功</th></tr></thead>
          <tbody>{ADVISOR_Q05_FROZEN.map((item) => (
            <tr><th>{item.method.replace(' / DirectApply','')}</th><td data-numeric>{item.score}</td><td data-numeric>{item.exact}</td></tr>
          ))}</tbody>
        </table>
      </div>
      <AdvisorTenEvidenceVisual variant="q05" />
      <div class="evo-article__measure">
        <div><strong>31.09 → 2.02 小时</strong><span>历史比较：参数更新累计耗时，约快 15.36 倍</span></div>
        <div><strong>74.78 → 56.25 小时</strong><span>包含 rollout 的整段耗时，约快 1.33 倍</span></div>
      </div>
      <p>参数更新只占整个实验的一部分。WebShop 任务执行（rollout）的时间没有被这一容量改进同等加速，因此两种时间口径可以同时成立。对本研究而言，更值得追问的是<strong>固定容量以后，任务成绩为什么不同</strong>。</p>
      <p>普通 OpenEVO 是更早的历史前序路线，与 Bounded 两组并非从完全相同的起点构成三臂随机实验。60.72 与 45.98 的差不能简单归因于容量压缩；固定容量组和历史 β 组则具有更接近正式匹配的实验安排。</p>
    </section>
    <section id="capacity" class="evo-article__section">
      <h2>4 rank32 将长期参数文件缩小约四分之三</h2>
      <p>第 152–159 轮使用 1,024 组匹配任务比较长期状态 rank128 与 rank32。rank32 的参数文件为 51.4 MB，rank128 为 205.6 MB。</p>
      <AdvisorTenEvidenceVisual variant="q04" />
      <p><strong>在这批任务上，rank32 的平均 Task Score 低 1.79 分。</strong>为了判断抽样波动，我们将同任务、同随机设置下的两个结果相减，对配对差值做多次有放回的重新抽样，并计算平均差。</p>
      <MathFormula latex={String.raw`d_i=\mathrm{Score}_{32,i}-\mathrm{Score}_{128,i}`} label="同题配对差值的定义" />
      <figure class="evo-article__figure evo-article__ci-figure" data-capacity-ci>
        <svg viewBox="0 0 500 145" role="img" aria-label="rank32 减 rank128 平均得分差为负1.79分，95%区间从负3.68到正0.12，跨过0">
          <line x1="34" y1="67" x2="470" y2="67" stroke="currentColor" opacity=".28"/>
          <line x1="345" y1="25" x2="345" y2="98" stroke="currentColor" stroke-dasharray="5 5" opacity=".5"/>
          <line x1="116" y1="67" x2="352" y2="67" stroke="currentColor" stroke-width="4"/>
          <line x1="116" y1="56" x2="116" y2="78" stroke="currentColor" stroke-width="2"/>
          <line x1="352" y1="56" x2="352" y2="78" stroke="currentColor" stroke-width="2"/>
          <circle cx="233" cy="67" r="7" fill="currentColor"/>
          <g fill="currentColor" font-size="15" text-anchor="middle">
            <text x="116" y="48">−3.68</text><text x="233" y="44" font-weight="700">−1.79</text><text x="352" y="48">+0.12</text><text x="345" y="124">0</text>
          </g>
        </svg>
        <figcaption>图 1｜rank32 − rank128 的平均差与配对 95% 置信区间，单位为百分制 Task Score 的分数。零点表示两者均值相同；区间跨过零点。</figcaption>
      </figure>
      <p>这一统计区间为 <strong>[−3.68，+0.12] 分</strong>：目前还没有足够证据确认 rank32 在类似任务上的平均分会稳定下降。同时，区间仍容许几个百分点的能力损失，因而不能证明容量缩小后影响可以忽略。</p>
      <details class="evo-article__disclosure"><summary>按下展开：95% 置信区间怎样计算，有什么意义？</summary><div><p>把 1,024 组同题结果分别相减，再以“每组配对结果”为单位重复抽取、反复计算平均差。重采样均值形成一组统计波动范围，95% 区间是按既定覆盖率方法得到的结果。这里的 95% 指在重复使用同一种统计程序时，它长期覆盖固定真实差值的比例，并不表示这个已经算好的区间有 95% 的概率包含真实差值。</p><p>如果要宣称“减少容量没有造成不可接受的性能损失”，应在看实验结果前确定能够接受的最大损失，然后按照对应的单侧统计检验进行判断；不能看到区间后再选择宽松标准。</p></div></details>
    </section>
    <section id="beta" class="evo-article__section">
      <h2>5 历史 β 写入控制的终评成绩更低</h2>
      <p>同一冻结 128 题上，固定容量的历史 β/GDR 路线平均得分为 <strong>20.77</strong>，没有开启当时复杂 β 处理的 Bounded 路线为 <strong>45.98</strong>。这提示额外控制新经验写入的方法需要独立验证，参数机制更复杂并不自动带来更好的任务能力。</p>
      <p>这次历史 β/GDR 方案，与后续只对更新幅度施加非负 β 倍率的简化方案，并不是同一个实验。也不能把另一个四轮 Gated Delta 资格研究的结果接在 160 轮长跑后当作第四条曲线。有关机制设计和来源见<a href="/research/seed-openevo/study/openevo-methods/#delta">方法篇的 Gated Delta 一节</a>。</p>
    </section>
    <section id="direction" class="evo-article__section">
      <h2>6 第 156 轮的一次方向反转，平均得分下降 10.06 分</h2>
      <p>低秩参数更新有大小，也有方向。为了分析它们各自的重要性，我们对选定轮次的真实 Task Vector 做反向干预，在冻结 64 题上测量同一模型其他条件不变时的结果。</p>
      <AdvisorTenEvidenceVisual variant="q07" />
      <p>第 156 轮的方向反转使 Task Score 下降约 10.06 分，配对 95% 区间为下降 5.60–15.02 分，且在八次反转中通过预先设定的多重比较校正。这支持<strong>该模型状态、该轮更新和这批题目上的局部因果效应</strong>，没有证明所有更新方向都应采用相同的在线控制规则。</p>
    </section>
    <section id="bundle" class="evo-article__section">
      <h2>7 BUNDLE 的文字载体更新次数较少</h2>
      <p>OpenEVO 的经验除了参数，还可以进入 Text Memory、Skill 和 Agent System。长期实验的收据显示，参数更新很频繁，文字状态实际改写得少得多。</p>
      <div class="evo-article__tablewrap" tabindex="0" aria-label="BUNDLE 更新计数">
        <table>
          <caption>表 3｜三条历史路线中不同载体的内容更新次数</caption>
          <thead><tr><th>路线</th><th data-numeric>参数</th><th data-numeric>Text Memory</th><th data-numeric>Skill</th><th data-numeric>Agent System</th></tr></thead>
          <tbody>{ADVISOR_Q09_UPDATES.map((item) => <tr><th>{item.method}</th><td data-numeric>{item.parametric}</td><td data-numeric>{item.textMemory}</td><td data-numeric>{item.skill}</td><td data-numeric>{item.agent}</td></tr>)}</tbody>
        </table>
      </div>
      <p><strong>很少改写文字，不等于文字状态没有作用。</strong>早期生成的文字可能在后续多轮被反复读取。必须单独关闭或替换载体，在其他条件尽量一致的任务上重新评测，才能判断它对能力的贡献。</p>
    </section>
    <section id="discussion" class="evo-article__section">
      <h2>8 讨论：已得到什么证据，还缺什么</h2>
      <p>目前可以确认，固定容量明显减少了长期参数更新所需的计算，并将长期参数文件大小保持在受控范围内。rank32 在后段匹配任务中用约四分之一的文件容量保留了大部分观测得分。历史 β/GDR 终点评测较低，第 156 轮方向干预展示了一次局部因果影响。</p>
      <p>任务成绩差异还需要更严格地分离：普通 OpenEVO 属于历史前序实验；容量筛选与最终冻结 128 题不是同一个测量阶段；文字载体的因果消融尚无可靠正式结果。更小 rank、可靠的 SEED 对照、旧任务保持和新随机任务复现，都是后续研究需要的证据。</p>
      <p>这些具体研究问题及已经完成、尚未完成的状态，由第三篇 <a href="/research/seed-openevo/study/advisor-questions/">学长十问</a>逐项展开。</p>
    </section>
    <section id="sources" class="evo-article__section evo-article__sources">
      <h2>原始记录</h2>
      <p class="evo-article__note">本文当前采用的科研证据快照核对于 <time datetime={ADVISOR_RESEARCH_AS_OF}>{ADVISOR_RESEARCH_AS_OF}</time>；这不是服务器实验的实时状态。</p>
