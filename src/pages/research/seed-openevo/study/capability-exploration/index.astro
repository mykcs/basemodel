---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import OpenEvoStage2StrategyChooser from '../../../../../components/research/OpenEvoStage2StrategyChooser.astro';
import OpenEvoExperimentAnalysisPlanIndex from '../../../../../components/research/OpenEvoExperimentAnalysisPlanIndex.astro';
const locale = 'zh' as const;
---
<AppLayout
  title="OpenEvo 基础能力探索实验"
  description="OpenEvo × WebShop 能力探索：先区分已取代的 256-window Stage 2 方法控制实验与当前 OpenEVO-Ceiling-1.0 主线，再进入对应实验和证据。"
  locale={locale}
>
  <section class="capability-series" data-testid="openevo-capability-exploration-series">
    <header class="capability-series__header">
      <p>OPENEVO × WEBSHOP · CAPABILITY EXPLORATION</p>
      <h1>OpenEvo 基础能力探索实验</h1>
      <div>
        <strong>2026-08-30 最重要的修正：旧 Stage 2 结果要保留，但不能再被读成当前 OpenEVO 的长期学习算法。</strong>
        <span>先选择 Stage 2 的方法版本。旧路线保存 3B/7B × self/MiniMax 四臂的真实历史结果；新路线记录 OpenEVO-Ceiling-1.0 已冻结的能力上限设计与 activation 状态。</span>
      </div>
    </header>
    <OpenEvoStage2StrategyChooser locale={locale} active="index" />
    <OpenEvoExperimentAnalysisPlanIndex locale={locale} />
  </section>
</AppLayout>

<style>
.capability-series{width:min(1180px,calc(100% - 2rem));margin:0 auto 4rem}
.capability-series__header{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:1.5rem;align-items:end;padding:1.4rem 0 1.1rem}
.capability-series__header>p{grid-column:1/-1;margin:0;color:var(--accent-deep);font:800 .68rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}
.capability-series__header h1{margin:0;font-size:clamp(2rem,5vw,4.5rem);line-height:1;letter-spacing:-.05em}
.capability-series__header div{display:flex;flex-direction:column;gap:.45rem;color:var(--muted);line-height:1.65}
.capability-series__header strong{color:var(--ink);font-size:1rem}
.capability-series__header span{font-size:.88rem}
.capability-series :global(.analysis-plan-index){max-width:none;padding-inline:0}
@media(max-width:760px){.capability-series{width:min(100% - 1rem,1180px)}.capability-series__header{grid-template-columns:1fr;gap:.8rem}.capability-series__header>p{grid-column:auto}.capability-series__header div{font-size:.86rem}}
</style>
