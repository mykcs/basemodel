---
import AppLayout from '../../../../../layouts/AppLayout.astro';
const target = '/research/seed-openevo/flow/#training-design';
---
<AppLayout
  title="训练设计"
  description="训练设计已并入流程理解图。"
  locale="zh"
>
  <main class="moved-design">
    <h1>训练设计</h1>
    <p><a href={target}>打开流程理解图中的训练设计 →</a></p>
  </main>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</AppLayout>
<style>
  .moved-design{width:min(760px,calc(100% - 2rem));margin:4rem auto}.moved-design h1{margin:0}.moved-design p{margin-top:1rem}.moved-design a{font-weight:750}
</style>
