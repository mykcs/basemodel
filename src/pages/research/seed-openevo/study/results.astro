---
// Agent contract: before editing this route or any mounted Results component,
// read docs/agents/current/seed-openevo-results-reader-contract.md and
// docs/agents/current/seed-openevo-results-current-state-2026-08-26.md.
import AppLayout from '../../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../../components/research/SeedOpenEvoResearchPage.astro';
import OpenEvoWebShopResultsHero from '../../../../components/research/OpenEvoWebShopResultsHero.astro';
import OpenEvoWebShopResultsProtocol from '../../../../components/research/OpenEvoWebShopResultsProtocol.astro';
import OpenEvoWebShopResultsQuestions from '../../../../components/research/OpenEvoWebShopResultsQuestions.astro';
import OpenEvoWebShopCurrentQ7 from '../../../../components/research/OpenEvoWebShopCurrentQ7.astro';
import OpenEvoActionWrapperAttribution from '../../../../components/research/OpenEvoActionWrapperAttribution.astro';
import OpenEvoWebShopG2Ablation from '../../../../components/research/OpenEvoWebShopG2Ablation.astro';
import OpenEvoWebShopNextSteps from '../../../../components/research/OpenEvoWebShopNextSteps.astro';
import OpenEvoExperimentAnalysisPlanIndex from '../../../../components/research/OpenEvoExperimentAnalysisPlanIndex.astro';
import OpenEvoWebShopResultsAppendix from '../../../../components/research/OpenEvoWebShopResultsAppendix.astro';
import OpenEvoWebShopResultsMobileSafety from '../../../../components/research/OpenEvoWebShopResultsMobileSafety.astro';
const locale = 'zh' as const;
---
<AppLayout
  title="OpenEvo × WebShop 研究结果"
  description="面向第一次阅读这组实验结果的人：说明 OpenEvo 已经证明了什么、同一 128 个 WebShop 任务给两个 7B 模型做完后为什么仍未证明稳定优势，以及下一轮 OpenEvo 与 SEED 的公平比较还缺什么。"
  locale={locale}
>
  <SeedOpenEvoResearchPage locale={locale} page="results">
    <div data-testid="openevo-webshop-result-index">
      <OpenEvoWebShopResultsHero locale={locale} />
      <OpenEvoWebShopResultsProtocol locale={locale} />
      <OpenEvoWebShopResultsQuestions locale={locale} />
      <OpenEvoWebShopCurrentQ7 locale={locale} />
      <OpenEvoActionWrapperAttribution locale={locale} />
      <OpenEvoWebShopG2Ablation locale={locale} />
      <OpenEvoExperimentAnalysisPlanIndex locale={locale} />
      <OpenEvoWebShopNextSteps locale={locale} />
      <OpenEvoWebShopResultsAppendix locale={locale} />
    </div>
    <OpenEvoWebShopResultsMobileSafety />
  </SeedOpenEvoResearchPage>
</AppLayout>
