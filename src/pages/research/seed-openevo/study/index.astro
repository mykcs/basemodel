---
import AppLayout from '../../../../layouts/AppLayout.astro';
import OpenEvoExperimentGateway from '../../../../components/research/OpenEvoExperimentGateway.astro';
import OpenEvoNextExperimentProtocol from '../../../../components/research/OpenEvoNextExperimentProtocol.astro';
import OpenEvoFairComparisonExplainer from '../../../../components/research/OpenEvoFairComparisonExplainer.astro';
const locale = 'zh' as const;
---
<AppLayout
  title="OpenEvo × WebShop 实验与复现"
  description="从 openevo-experiment 的实际工作分支核对当前实验状态、代码、复现材料，以及下一阶段 SEED-compatible fair comparison（与 SEED 严格兼容的公平比较）协议。"
  locale={locale}
>
  <OpenEvoExperimentGateway locale={locale} />
  <section class="comparison-scope" data-fair-comparison-scope aria-label="已完成证据与下一场实验的边界">
    <strong>先把两层证据分开</strong>
    <p><b>已完成：</b>source-faithful Track A 已在固定 128-task manifest 上完成 BASE vs frozen OpenEvo 测量；这组结果和结论保持不变。</p>
    <p><b>下一场：</b>这里定义的是从同一 Qwen 起点开始、完整匹配 SEED 名义 21,920 个 environment rollouts 的 long-horizon fair comparison。它不是重跑 Track A，也不声称已经复现 SEED paper-final checkpoint 或论文报告数字。</p>
  </section>
  <aside class="design-bridge" aria-labelledby="design-bridge-title">
    <div><span>TRAINING DESIGN</span><h2 id="design-bridge-title">先决定要证明什么，再决定 Stage 1 怎么做</h2><p>Harness、temperature、外部 trajectory analyzer、OPSD、bootstrap 与 rollout budget 回答的是不同问题。训练设计实验室把这些分支和失败历史放到同一张可检查的研究地图里。</p></div>
    <a class="button button-secondary" href="/research/seed-openevo/study/design/">打开训练设计实验室 →</a>
  </aside>
  <OpenEvoFairComparisonExplainer locale={locale} />
  <OpenEvoNextExperimentProtocol />
</AppLayout>

<style>
  .comparison-scope{width:min(1120px,calc(100% - 2rem));margin:2rem auto 0;padding:1rem 1.1rem;border:1px solid var(--line);border-radius:14px;background:var(--surface-muted)}
  .comparison-scope strong{display:block;color:var(--accent-deep);font-size:.78rem}
  .comparison-scope p{margin:.45rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.65}
  .comparison-scope b{color:inherit}
  .design-bridge{display:flex;width:min(1120px,calc(100% - 2rem));margin:1rem auto 0;padding:1rem 1.1rem;align-items:center;justify-content:space-between;gap:1rem;border-block:1px solid var(--line)}
  .design-bridge span{color:var(--accent-deep);font:800 .62rem/1.2 var(--font-mono)}
  .design-bridge h2{margin:.2rem 0 .35rem;font-size:1rem}
  .design-bridge p{max-width:72ch;margin:0;color:var(--muted);font-size:.74rem;line-height:1.55}
  .design-bridge>a{flex:0 0 auto}
  @media(max-width:720px){.design-bridge{align-items:flex-start;flex-direction:column}.design-bridge>a{width:100%;text-align:center}}
</style>
