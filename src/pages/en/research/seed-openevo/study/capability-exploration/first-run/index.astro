---
import AppLayout from '../../../../../../../layouts/AppLayout.astro';
import { localePath } from '../../../../../../../i18n';
const locale = 'en' as const;
const p = (path: string) => localePath(locale, path);
---
<AppLayout
  title="First OpenEvo experiment run"
  description="The first OpenEvo run preserves the historical path from Stage 1 into Stage 2: 7B provides sustained-update and capacity-amendment evidence, while 3B exposes bootstrap, action-validity, and harness-design problems that motivated the successor."
  locale={locale}
>
  <main class="first-run-shell" data-testid="openevo-first-run-shell">
    <header>
      <p>HISTORICAL MAP · FIRST RUN</p>
      <h1>First OpenEvo experiment run</h1>
      <strong>This run is not an old branch to erase. The 7B lineage gave us the first complete view of sustained Stage-2 updates, while 3B and long-horizon execution exposed problems in the update rule, action interface, and parameter capacity.</strong>
      <span>The historical Stage 1, old Stage 2, Ceiling-1.0, and harness-diagnostic pages remain available for exact numbers and technical evidence; this map organizes the causal relationship between them.</span>
    </header>
    <nav aria-label="Historical evidence from the first run">
      <a href={p('/research/seed-openevo/study/capability-exploration/stage1-previous/')}>Historical Stage 1</a>
      <a href={p('/research/seed-openevo/study/capability-exploration/stage2-256-window/')}>Old Stage 2</a>
      <a href={p('/research/seed-openevo/study/capability-exploration/stage2-ceiling/')}>Ceiling-1.0</a>
      <a href={p('/research/seed-openevo/study/capability-exploration/openevo-2-0/harness-2-0/')}>Harness diagnostic record</a>
    </nav>
    <footer>
      <a href={p('/research/seed-openevo/study/capability-exploration/')}>← Back to capability exploration</a>
      <a href={p('/research/seed-openevo/study/capability-exploration/openevo-2-0/')}>Redesigning OpenEvo →</a>
    </footer>
  </main>
</AppLayout>
<style>
.first-run-shell{width:min(920px,calc(100% - 2rem));margin:0 auto 4rem;padding-top:1.4rem}.first-run-shell header{display:grid;gap:.7rem;padding-bottom:1.4rem;border-bottom:1px solid var(--line)}.first-run-shell header p{margin:0;color:var(--accent-deep);font:800 .68rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em}.first-run-shell h1{margin:0;font-size:clamp(2.35rem,6vw,4.7rem);line-height:.97;letter-spacing:-.05em}.first-run-shell header strong{max-width:48rem;font-size:1.05rem;line-height:1.55}.first-run-shell header span{max-width:48rem;color:var(--muted);line-height:1.65}.first-run-shell nav{display:flex;flex-wrap:wrap;gap:.55rem 1.1rem;padding:1.2rem 0}.first-run-shell nav a,.first-run-shell footer a{color:var(--accent-deep);text-underline-offset:.2em}.first-run-shell footer{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem;border-top:1px solid var(--line);font-weight:700}@media(max-width:760px){.first-run-shell{width:min(100% - 1rem,920px);padding-top:1rem}.first-run-shell nav{display:grid}.first-run-shell footer{display:grid}.first-run-shell h1{font-size:clamp(2.3rem,12vw,3.5rem)}}
</style>
