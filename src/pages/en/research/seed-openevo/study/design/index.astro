---
import AppLayout from '../../../../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchNav from '../../../../../../components/research/SeedOpenEvoResearchNav.astro';
import SeedOpenEvoTrainingDecisionLab from '../../../../../../components/research/SeedOpenEvoTrainingDecisionLab.astro';
import OpenEvoFairComparisonExplainer from '../../../../../../components/research/OpenEvoFairComparisonExplainer.astro';
const locale = 'en' as const;
---

<AppLayout
  title="WebShop training design · SEED × OpenEvo"
  description="The canonical home for SEED × OpenEvo training-design detail: responsibility boundaries, experiment routes, parameter protocols, teacher roles, fair budgets, and benchmark design."
  locale={locale}
>
  <SeedOpenEvoResearchNav locale={locale} page="design" />
  <SeedOpenEvoTrainingDecisionLab locale={locale} />

  <section class="design-history-note" aria-labelledby="design-history-title">
    <p>HISTORICAL FROZEN DESIGN</p>
    <div>
      <h2 id="design-history-title">Fair budgets and follow-up experiment design</h2>
      <p>The 21,920-rollout campaign and the paper-derived 20,640 environment-trajectory accounting below preserve an earlier frozen comparison design. They are not a claim about live training progress on 2026-09-07. Resolve current scientific state from the <a href="/en/research/seed-openevo/study/">study overview</a> and the actual openevo-experiment branch, release / current-campaign record, and latest reconciliation.</p>
    </div>
  </section>

  <OpenEvoFairComparisonExplainer locale={locale} />
</AppLayout>

<style>
  .design-history-note{width:min(1120px,calc(100% - 2rem));display:grid;grid-template-columns:150px minmax(0,760px);gap:28px;margin:3rem auto 0;padding:1.5rem 0;border-top:2px solid var(--color-text)}
  .design-history-note>p{margin:.35rem 0 0;color:var(--color-accent);font-size:.74rem;font-weight:800;letter-spacing:.08em}.design-history-note h2{margin:0;font-size:clamp(1.45rem,3vw,2.2rem);letter-spacing:-.03em}.design-history-note div>p{margin:.55rem 0 0;color:var(--color-text-muted);font-size:.9rem;line-height:1.7}.design-history-note a{color:var(--color-accent);text-underline-offset:.18em}
  @media(max-width:720px){.design-history-note{grid-template-columns:1fr;gap:.35rem}}
</style>
