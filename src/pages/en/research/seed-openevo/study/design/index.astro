---
import AppLayout from '../../../../../../layouts/AppLayout.astro';
const target = '/en/research/seed-openevo/flow/#training-design';
---
<AppLayout
  title="Training design"
  description="Training design now lives in the flow map."
  locale="en"
>
  <main class="moved-design">
    <h1>Training design</h1>
    <p><a href={target}>Open training design in the flow map →</a></p>
  </main>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</AppLayout>
<style>
  .moved-design{width:min(760px,calc(100% - 2rem));margin:4rem auto}.moved-design h1{margin:0}.moved-design p{margin-top:1rem}.moved-design a{font-weight:750}
</style>
