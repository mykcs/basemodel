import OpenEvoExperimentProgram from '../../../../components/research/OpenEvoExperimentProgram.astro';
import Seed3090ParametricProgress from '../../../../components/research/Seed3090ParametricProgress.astro';
const locale = 'en' as const;
---
<AppLayout title="OpenEvo × SEED experiment results" description="Trace the experiment from the retired seed3090 / openevo-webshop evidence base to the active openevo-experiment RTX 5090 mainline: Phase D–F parameter-update and reload evidence, the W&B host gate, and the still-unconsumed Phase G three-arm base / adapter WebShop comparison." locale={locale}>
