---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../../../components/research/SeedOpenEvoResearchPage.astro';
import InteractiveResearchExplainer from '../../../../../components/research/InteractiveResearchExplainer.tsx';
import WebShopReaderMap from '../../../../../components/research/WebShopReaderMap.astro';
import WebShopDatasetCanonicalFigure from '../../../../../components/research/WebShopDatasetCanonicalFigure.astro';
import WebShopSmallWorldFigure from '../../../../../components/research/WebShopSmallWorldFigure.astro';
import WebShopGoalGenerationFigure from '../../../../../components/research/WebShopGoalGenerationFigure.astro';
import WebShopSeedSplitFigure from '../../../../../components/research/WebShopSeedSplitFigure.astro';
import WebShopEvaluationFigure from '../../../../../components/research/WebShopEvaluationFigure.astro';
import SeedWebShopCanonicalFigure from '../../../../../components/research/SeedWebShopCanonicalFigure.astro';
const locale = 'en' as const;
---
<AppLayout title="WebShop principles, interaction, and evaluation" description="First establish what WebShop is, why it matters, and which setting SEED uses; then step through interaction, the original benchmark, the small product world, goal generation, task splitting, and final evaluation." locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="webshop">
    <WebShopReaderMap locale={locale} />
    <InteractiveResearchExplainer locale={locale} kind="webshop" client:visible />
    <WebShopDatasetCanonicalFigure locale={locale} />
    <WebShopSmallWorldFigure locale={locale} />
    <WebShopGoalGenerationFigure locale={locale} />
    <WebShopSeedSplitFigure locale={locale} />
    <WebShopEvaluationFigure locale={locale} />
    <SeedWebShopCanonicalFigure locale={locale} />
  </SeedOpenEvoResearchPage>
</AppLayout>
