---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Body from '../../_bodies/model-detail.astro';
import { getMessages } from '../../../i18n';

export async function getStaticPaths() {
  const modelEntries = await getCollection('models');
  const paperEntries = await getCollection('papers');
  return modelEntries.map((entry) => ({ params: { id: entry.data.id }, props: { model: entry.data, papers: paperEntries.map((paper) => paper.data).filter((paper) => paper.models.some((use) => use.model_id === entry.data.id)) } }));
}
const { model, papers } = Astro.props;
const m = getMessages('en');
---
<BaseLayout title={model.name} description={`${model.name} ${m.detail.descriptionSuffix}`} locale="en"><Body model={model} papers={papers} locale="en" /></BaseLayout>
