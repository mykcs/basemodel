---
import AppLayout from '../../../layouts/AppLayout.astro';
import { ResearchWorkspace } from '../../../components/workspace/ResearchWorkspace.tsx';
---
<AppLayout title="Experiment workspace" description="Enter the model, GPU, network, weight-access, and training conditions, remove infeasible plans, and keep candidates, sources, and comparisons together." locale="en">
  <section class="shell page-header workspace-primary" data-workspace-static-fallback data-reader-primary>
    <h1>Experiment workspace</h1>
    <p class="lede">Define the research goal, model roles, and resource limits first; then let the workspace remove infeasible plans while keeping candidates, comparisons, and evidence in one task.</p>
    <p><a class="button button-primary" href="?v=2&mode=modern">Start entering experiment conditions</a></p>
  </section>
  <ResearchWorkspace client:load locale="en" />
</AppLayout>

<style>
  .workspace-primary{box-sizing:border-box;min-height:calc(100svh - 110px);display:flex;flex-direction:column;justify-content:center;max-width:860px}.workspace-primary .lede{max-width:58ch}@media(max-width:720px){.workspace-primary{min-height:calc(100svh - 96px)}}
</style>