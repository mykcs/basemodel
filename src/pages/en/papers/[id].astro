---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Body from '../../_bodies/paper-detail.astro';
import { getMessages } from '../../../i18n';

export async function getStaticPaths() {
  const paperEntries = await getCollection('papers');
  const modelEntries = await getCollection('models');
  return paperEntries.map((entry) => ({ params: { id: entry.data.id }, props: { paper: entry.data, models: modelEntries.map((model) => model.data) } }));
}
const { paper, models } = Astro.props;
const m = getMessages('en');
---
<BaseLayout title={paper.title} description={`${paper.title} ${m.paperDetail.descriptionSuffix}`} locale="en"><Body paper={paper} models={models} locale="en" /></BaseLayout>
