---
import AppLayout from '../../layouts/AppLayout.astro';
import { getMessages } from '../../i18n';
const m = getMessages('en');
---
<AppLayout title={m.methodology.pageTitle} description={m.methodology.lede} locale="en"><div class="shell editorial-page"><header class="page-header"><span class="section-kicker">{m.nav.methodology}</span><h1>{m.methodology.title}</h1><p class="lede">{m.methodology.lede}</p></header><div class="methodology-sections">{m.methodology.sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}</div></div></AppLayout>
