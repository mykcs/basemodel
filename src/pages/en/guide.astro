---
import AppLayout from '../../layouts/AppLayout.astro';
import { getMessages, localePath } from '../../i18n';
import { getCollection } from 'astro:content';
import SeedStudentReproductionGuide from '../../components/SeedStudentReproductionGuide.astro';
const m = getMessages('en');
const guide = (await getCollection('guides'))[0]?.data;
const guideSource = guide ? 'guides-collection' : 'fallback';
const title = 'Reproduce SEED: start with ALFWorld and WebShop on 4×3090';
const lede = 'This is an executable experiment mainline. Because the server has no public internet, prepare models, data, and dependencies on the online side, then move them over SFTP. Every stage has commands and a pass condition. If four 3090s complete both full experiments, stop there.';
const hardwareTruth = 'Compute note: Workspace VRAM and resource numbers are a heuristic planning estimate, not a measured hardware result. Decide whether the run is truly feasible from your 4×3090 preflight, short run, and stable update timings.';
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="en">
  <div class="shell editorial-page guide-learning-page" data-guide-source={guideSource}>
    <header class="page-header">
      <p class="guide-eyebrow">SEED · Qwen2.5-3B-Instruct · 4×RTX 3090 24GB</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="hardware-truth">{hardwareTruth}</p>
    </header>

    <SeedStudentReproductionGuide locale="en" />

    <section class="after-reproduction" aria-labelledby="after-reproduction-title">
      <p class="guide-eyebrow">After reproduction</p>
      <h2 id="after-reproduction-title">Record this experiment clearly before changing the backbone or moving to another paper</h2>
      <p>Once the SEED mainline is complete, use the paper page, model page, and Research Workspace to check paper conditions, record hardware substitutions, compare new backbones, and preserve the evidence behind each change. Avoid changing the model, data, and training method at the same time while the original chain is still unstable.</p>
      <div class="next-links">
        <a href={localePath('en', '/papers/seed/')}><strong>SEED paper</strong><span>Check method, hardware, and reported results</span></a>
        <a href={localePath('en', '/models/qwen2-5-3b-instruct/')}><strong>Qwen2.5-3B-Instruct</strong><span>Check checkpoint, weights, and runtime conditions</span></a>
        <a href={`${localePath('en', '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1`}><strong>Research Workspace</strong><span>Record 3090 / eight-GPU migration decisions</span></a>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .page-header { max-width: 900px; padding-bottom: 20px; }
  .page-header h1 { max-width: 850px; }
  .guide-eyebrow { margin: 0 0 7px; color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .hardware-truth { max-width: 820px; margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; line-height: 1.65; }
  .after-reproduction { margin: 0 0 80px; padding-top: 34px; border-top: 1px solid var(--line); }
  .after-reproduction h2 { max-width: 760px; margin: 6px 0 10px; }
  .after-reproduction > p:not(.guide-eyebrow) { max-width: 800px; color: var(--muted); line-height: 1.7; }
  .next-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 22px; border-top: 1px solid var(--line); }
  .next-links a { padding: 16px 16px 16px 0; color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .next-links a + a { padding-left: 16px; border-left: 1px solid var(--line); }
  .next-links strong, .next-links span { display: block; }
  .next-links span { margin-top: 4px; color: var(--muted); font-size: .86rem; }
  @media (max-width: 700px) {
    .next-links { grid-template-columns: 1fr; }
    .next-links a + a { padding-left: 0; border-left: 0; }
  }
</style>
