---
import AppLayout from '../../layouts/AppLayout.astro';
import { getMessages, localePath } from '../../i18n';
import { getCollection } from 'astro:content';
import AgentToSeedBridge from '../../components/AgentToSeedBridge.astro';
import SeedStudentReproductionGuide from '../../components/SeedStudentReproductionGuide.astro';
const m = getMessages('en');
const guideRecord = (await getCollection('guides'))[0]?.data;
const guideSource = guideRecord ? 'collection' : 'fallback';
const title = 'Understand the agent loop, then reproduce SEED';
const lede = 'For readers who already know Transformers, fine-tuning, inference, APIs, and GPUs: first map policy, tools, environments, trajectories, rewards, GRPO, and SEED onto one mental model; then follow a transferable ALFWorld / WebShop reproduction path from an online workstation to an internal GPU server.';
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="en">
  <div class="shell editorial-page guide-learning-page" data-guide-source={guideSource}>
    <header class="page-header">
      <p class="guide-eyebrow">Agent 101 → SEED · Qwen2.5-3B-Instruct · ALFWorld + WebShop</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="hardware-note">First identify <strong>what loops at runtime and where training changes weights</strong>, then see the same concepts in real commands. <strong>This project uses an offline 4×RTX 3090 24GB server as a concrete example</strong>; other readers can reuse the “online workstation prepares → internal GPU server executes” pattern with approved hardware they actually have. The workbench VRAM number remains a <strong>heuristic planning estimate</strong>, <strong>not a measured hardware result</strong>; fit, memory, and update time must come from profiling the reader’s actual server.</p>
    </header>

    <AgentToSeedBridge locale="en" />
    <SeedStudentReproductionGuide locale="en" />

    <section class="after-reproduction" aria-labelledby="after-reproduction-title">
      <p class="guide-eyebrow">After the run</p>
      <h2 id="after-reproduction-title">Use the rest of the site for the next research question</h2>
      <p>Keep the checkpoint, configuration, hardware fingerprint, results, and evidence from this reproduction. If you later replace the model, compare a newer Qwen generation, or move this project's four-GPU example to cloud hardware, the paper, model, compare, and workspace pages continue from this experiment record.</p>
      <div class="next-links">
        <a href={localePath('en', '/papers/seed/')}><strong>SEED paper</strong><span>Re-check paper conditions and results</span></a>
        <a href={localePath('en', '/models/qwen2-5-3b-instruct/')}><strong>Qwen2.5-3B-Instruct</strong><span>Confirm checkpoint, weights, and trainability</span></a>
        <a href={`${localePath('en', '/workspace/')}?v=2&mode=method&paper=seed&model=qwen2-5-3b-instruct&role=actor&roles=actor%2Canalyzer&update=rl&access=local&runtime=verl&open=1`}><strong>Research workspace</strong><span>Record four-GPU results, eight-GPU migration, and model changes</span></a>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .page-header { max-width: 920px; padding-bottom: 20px; }
  .page-header h1 { max-width: 880px; }
  .guide-eyebrow { margin: 0 0 7px; color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .hardware-note { max-width: 840px; margin-top: 14px; padding: 12px 14px; border-left: 3px solid var(--line); background: var(--surface-muted); color: var(--muted); font-size: .86rem; line-height: 1.6; }
  .hardware-note strong { color: var(--text); }
  .after-reproduction { margin: 0 0 80px; padding-top: 34px; border-top: 1px solid var(--line); }
  .after-reproduction h2 { max-width: 760px; margin: 6px 0 10px; }
  .after-reproduction > p:not(.guide-eyebrow) { max-width: 800px; color: var(--muted); line-height: 1.7; }
  .next-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 22px; border-top: 1px solid var(--line); }
  .next-links a { padding: 16px 16px 16px 0; color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .next-links a + a { padding-left: 16px; border-left: 1px solid var(--line); }
  .next-links strong, .next-links span { display: block; }
  .next-links span { margin-top: 4px; color: var(--muted); font-size: .86rem; }
  @media (max-width: 700px) { .next-links { grid-template-columns: 1fr; } .next-links a + a { padding-left: 0; border-left: 0; } }
</style>
