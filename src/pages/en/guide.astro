---
import AppLayout from '../../layouts/AppLayout.astro';
import { getMessages } from '../../i18n';
import { getCollection } from 'astro:content';
import GuideContent from '../../components/GuideContent.astro';
const m = getMessages('en');
const guide = (await getCollection('guides'))[0]?.data;
const steps = guide?.steps_en ?? m.guide.steps;
const title = 'How to use Basemodel: walk the full research path with SEED';
const lede = 'Use SEED: Self-Evolving On-Policy Distillation for Agentic Reinforcement Learning as one end-to-end case, from paper search and model roles through filtering, workspace setup, comparison, evidence review, and decision export.';
const note = 'Hardware tiers in model records remain coarse research metadata. The workbench VRAM calculator combines precision, context length, batch size, LoRA rank, and related assumptions to produce a heuristic planning estimate; it is not a measured hardware result or a guarantee that the configuration will run.';
const concepts = guide?.concepts ?? [];
const glossary = guide?.glossary ?? [];
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="en"><div class="shell editorial-page"><header class="page-header"><span class="section-kicker">{m.nav.guide}</span><h1>{title}</h1><p class="lede">{lede}</p></header><GuideContent locale="en" concepts={concepts} glossary={glossary} steps={steps} note={note} /></div></AppLayout>
