---
import AppLayout from '../../layouts/AppLayout.astro';
import { getMessages } from '../../i18n';
import { getCollection } from 'astro:content';
import AgentPrimer from '../../components/AgentPrimer.astro';
import SeedReproductionPath from '../../components/SeedReproductionPath.astro';
import SeedComputeTimeBudget from '../../components/SeedComputeTimeBudget.astro';
import SeedOwnedComputePath from '../../components/SeedOwnedComputePath.astro';
import SeedOfflineLabWorkflow from '../../components/SeedOfflineLabWorkflow.astro';
import GuideContent from '../../components/GuideContent.astro';
import GuideDecisionChapters from '../../components/GuideDecisionChapters.astro';
const m = getMessages('en');
const guide = (await getCollection('guides'))[0]?.data;
const steps = guide?.steps_en ?? m.guide.steps;
const title = 'Understand agents first, then reproduce one paper end to end';
const lede = 'This guide assumes you already know Transformers, fine-tuning, inference, APIs, and GPUs. Build the agent mental model, then use SEED as one concrete thread from checkpoint and ALFWorld / WebShop setup through compute rental and paper-aligned validation.';
const note = 'Hardware tiers in model records remain coarse research metadata. The workbench VRAM calculator combines precision, context length, batch size, LoRA rank, and related assumptions to produce a heuristic planning estimate; it is not a measured hardware result or a guarantee that the configuration will run.';
const concepts = guide?.concepts ?? [];
const glossary = guide?.glossary ?? [];
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="en">
  <div class="shell editorial-page guide-learning-page">
    <header class="page-header"><h1>{title}</h1><p class="lede">{lede}</p></header>
    <AgentPrimer locale="en" />
    <SeedReproductionPath locale="en" />
    <SeedComputeTimeBudget locale="en" />
    <SeedOwnedComputePath locale="en" />
    <SeedOfflineLabWorkflow locale="en" />
    <section class="guide-research-layer" aria-labelledby="guide-research-layer-title">
      <p class="guide-section-label">Part three</p>
      <h2 id="guide-research-layer-title">After one real SEED reproduction, transfer the workflow to other papers and models</h2>
      <p class="muted">First reorganize the core concepts around four research decisions, then move into the end-to-end workbench flow and glossary. Keep the order: define the research claim, pin paper variables, then filter models, inspect evidence, and justify substitutions.</p>
    </section>
    <GuideDecisionChapters locale="en" concepts={concepts} />
    <GuideContent locale="en" concepts={concepts} glossary={glossary} steps={steps} note={note} />
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .guide-research-layer { margin: 72px 0 24px; padding-top: 34px; border-top: 1px solid var(--line); }
  .guide-research-layer h2 { max-width: 760px; margin: 7px 0 10px; }
  .guide-research-layer p { max-width: 760px; }
  :global(.guide-concept-map) { display: none; }
</style>
