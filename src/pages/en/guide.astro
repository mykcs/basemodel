---
import AppLayout from '../../layouts/AppLayout.astro';
import { getMessages } from '../../i18n';
import { getCollection } from 'astro:content';
import AgentPrimer from '../../components/AgentPrimer.astro';
import GuideContent from '../../components/GuideContent.astro';
const m = getMessages('en');
const guide = (await getCollection('guides'))[0]?.data;
const steps = guide?.steps_en ?? m.guide.steps;
const title = 'Understand agents first, then choose a foundation model';
const lede = 'This guide assumes you already know Transformers, fine-tuning, inference, APIs, and GPUs. First build the runtime and agentic-RL mental model, then use SEED to connect those concepts to real papers, checkpoints, and reproduction decisions.';
const note = 'Hardware tiers in model records remain coarse research metadata. The workbench VRAM calculator combines precision, context length, batch size, LoRA rank, and related assumptions to produce a heuristic planning estimate; it is not a measured hardware result or a guarantee that the configuration will run.';
const concepts = guide?.concepts ?? [];
const glossary = guide?.glossary ?? [];
---
<AppLayout title={m.guide.pageTitle} description={lede} locale="en">
  <div class="shell editorial-page guide-learning-page">
    <header class="page-header">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
    </header>
    <AgentPrimer locale="en" />
    <section class="guide-research-layer" aria-labelledby="guide-research-layer-title">
      <p class="guide-section-label">Part two</p>
      <h2 id="guide-research-layer-title">Apply the agent mental model to papers and foundation-model choice</h2>
      <p class="muted">Continue with SEED through the full research workflow: read model roles in the paper, verify checkpoints and evidence, then narrow candidates with reproduction goals, update methods, and hardware constraints.</p>
    </section>
    <GuideContent locale="en" concepts={concepts} glossary={glossary} steps={steps} note={note} />
  </div>
</AppLayout>

<style>
  .guide-learning-page { max-width: 1080px; }
  .guide-research-layer { margin: 72px 0 24px; padding-top: 34px; border-top: 1px solid var(--line); }
  .guide-research-layer h2 { max-width: 760px; margin: 7px 0 10px; }
  .guide-research-layer p { max-width: 760px; }
</style>
