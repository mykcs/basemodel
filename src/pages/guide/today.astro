<script is:inline>
  const prefix = 'seed-lab-today:';
  document.querySelectorAll('[data-save]').forEach((input) => {
    const key = prefix + input.dataset.save;
    const saved = localStorage.getItem(key);
    if (saved !== null) input.value = saved;
    input.addEventListener('input', () => localStorage.setItem(key, input.value));
  });

  document.querySelectorAll('[data-check]').forEach((box) => {
    const key = prefix + box.dataset.check;
    box.checked = localStorage.getItem(key) === '1';
    box.addEventListener('change', () => localStorage.setItem(key, box.checked ? '1' : '0'));
  });

  document.querySelectorAll('pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-code';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText || '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = '已复制';
        setTimeout(() => { btn.textContent = '复制'; }, 1400);
      } catch {
        btn.textContent = '手动复制';
      }
    });
    pre.appendChild(btn);
  });
</script>

