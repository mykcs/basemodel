---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="页面不存在"><div class="shell empty-state" style="min-height:50vh"><h1>页面不存在</h1><p>返回首页继续探索。</p><a class="text-link" href={base}>回到选择入口 →</a></div></BaseLayout>
