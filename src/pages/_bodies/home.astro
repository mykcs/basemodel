---
import { getCollection } from 'astro:content';
import ExperimentSelector from '../../components/ExperimentSelector';
import ModelCard from '../../components/ModelCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { papersForModel } from '../../lib/modelRelations';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const modelEntries = await getCollection('models');
const paperEntries = await getCollection('papers');
const models = modelEntries.map((entry) => entry.data);
const papers = paperEntries.map((entry) => entry.data);
const latest = [...models].sort((a, b) => b.release_date.localeCompare(a.release_date)).slice(0, 3);
const vendorCount = new Set(models.map((model) => model.vendor)).size;
---
<section class="hero">
  <div class="shell hero-grid">
    <div>
      <div class="eyebrow">{m.home.heroEyebrow}</div>
      <h1>{m.home.heroTitle}</h1>
      <p class="lede">{m.home.heroLede}</p>
    </div>
    <aside class="hero-note"><div class="section-kicker">{m.home.howToRead}</div><p>{m.home.howToReadBody}</p><a class="text-link" href={localePath(locale, '/models/')}>{m.home.browseAll}</a></aside>
  </div>
</section>

<div class="shell">
  <div class="stats" aria-label="statistics"><div class="stat"><strong>{models.length}</strong><span>{m.home.statsModels}</span></div><div class="stat"><strong>{vendorCount}</strong><span>{m.home.statsVendors}</span></div><div class="stat"><strong>{papers.length}</strong><span>{m.home.statsPapers}</span></div></div>
  <section class="section" aria-labelledby="selector-title"><div class="section-heading"><div><div class="section-kicker">{m.home.selectorKicker}</div><h2 id="selector-title">{m.home.selectorTitle}</h2></div><span class="muted">{m.home.selectorNote}</span></div><ExperimentSelector client:load models={models} locale={locale} /></section>
  <section class="section" aria-labelledby="latest-title"><div class="section-heading"><div><div class="section-kicker">{m.home.supplyKicker}</div><h2 id="latest-title">{m.home.latestTitle}</h2></div><a class="text-link" href={localePath(locale, '/models/')}>{m.home.viewExplorer}</a></div><div class="model-grid">{latest.map((model) => <ModelCard model={model} paperCount={papersForModel(papers, model.id).length} locale={locale} />)}</div></section>
  <section class="section" aria-labelledby="method-title"><div class="section-heading"><div><h2 id="method-title">{m.home.contractTitle}</h2></div></div><div class="tag-row"><StatusBadge status="verified" locale={locale} /><StatusBadge status="partial" locale={locale} /></div><p class="muted">{m.home.contractBody}</p></section>
</div>
