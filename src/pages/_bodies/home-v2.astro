---
import { getCollection } from 'astro:content';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import { encodeResearchTask } from '../../lib/researchTaskCodec';
import { scoreModels } from '../../lib/researchEngine';
import { emptyTask, type ResearchTask } from '../../stores/researchTask';
import familiesData from '../../content/coverage/families.json';
import SeedUseCaseStrip from '../../components/SeedUseCaseStrip.astro';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;
const models = (await getCollection('models')).map((entry) => entry.data);
const papers = (await getCollection('papers')).map((entry) => entry.data);
const changeEventEntries = await getCollection('changeEvents');
const totalModels = models.length;
const familyCount = familiesData.families.length;
const openWeightCount = models.filter((model) => model.openness.weights_available === true).length;

function workspaceHref(task: Partial<ResearchTask>): string {
  const params = encodeResearchTask({ ...emptyTask, ...task });
  return `${localePath(locale, '/workspace/')}?${params.toString()}`;
}

const decisionSteps = [
  { title: t('明确问题', 'Define the question'), body: t('先说清楚你在复现论文、验证方法，还是设计新实验。不要从“哪个模型最强”开始。', 'Start by deciding whether you are reproducing a paper, validating a method, or designing a new experiment. Do not begin with “which model is strongest?”') },
  { title: t('收紧约束', 'Narrow constraints'), body: t('固定 checkpoint 语义、开放性、训练方式、显存与运行时，把不可行选项尽早排除。', 'Fix checkpoint semantics, openness, update method, VRAM, and runtime so infeasible options disappear early.') },
  { title: t('形成候选', 'Form candidates'), body: t('候选不是排行榜前三名，而是 baseline、当前代和资源友好等不同研究角色。', 'Candidates are not the top three on a leaderboard; they serve roles such as baseline, current-generation, and resource-efficient options.') },
  { title: t('核验证据', 'Verify evidence'), body: t('查看来源、revision、许可证与未知项。没有证据的字段保持未知，不替它猜答案。', 'Inspect sources, revisions, licenses, and unknowns. Unsupported fields stay unknown instead of being guessed.') },
  { title: t('做出决策', 'Make the decision'), body: t('把替换模型会改变什么、为什么仍可比较，以及仍有哪些风险写进可复现的决策记录。', 'Record what a model swap changes, why the result remains comparable, and which risks remain in a reproducible decision record.') },
];

const primaryIntents = [
  { label: locale === 'zh' ? '复现一篇论文' : 'Reproduce a paper', lede: locale === 'zh' ? '从论文案例进入，再决定严格复现、方法复现还是现代化重跑。' : 'Start from a paper case, then choose strict reproduction, method reproduction, or a modern rerun.', href: localePath(locale, '/papers/') },
  { label: locale === 'zh' ? '设计一个新实验' : 'Design a new experiment', lede: locale === 'zh' ? '按训练方式、资源、开放性和可复现性形成候选。' : 'Form candidates from training method, resources, access, and reproducibility.', href: localePath(locale, '/workspace/') },
  { label: locale === 'zh' ? '替换一个旧模型' : 'Replace an older model', lede: locale === 'zh' ? '比较论文原模型与当前候选，显式暴露代际与可比性风险。' : 'Compare the original paper model with current candidates and expose generation and comparability risks.', href: workspaceHref({ mode: 'modern', update: 'none', priorities: ['current'] }) },
];
const researchPaths = [
  { title: m.v2.home.pathStrict, body: m.v2.home.pathStrictBody, tag: m.v2.home.pathStrictTag },
  { title: m.v2.home.pathMethod, body: m.v2.home.pathMethodBody, tag: m.v2.home.pathMethodTag },
  { title: m.v2.home.pathModern, body: m.v2.home.pathModernBody, tag: m.v2.home.pathModernTag },
];
const scenarioCards = [
  { label: m.v2.home.scenarioLora, lede: m.v2.home.scenarioLoraLede, href: workspaceHref({ mode: 'new', update: 'lora', gpuVramGb: 24, openWeight: true }) },
  { label: m.v2.home.scenarioRl, lede: m.v2.home.scenarioRlLede, href: workspaceHref({ mode: 'modern', update: 'rl', gpuCount: 4, openWeight: true }) },
  { label: m.v2.home.scenarioOpenWeight, lede: m.v2.home.scenarioOpenWeightLede, href: workspaceHref({ mode: 'new', update: 'none', openWeight: true }) },
  { label: m.v2.home.scenarioQwen, lede: m.v2.home.scenarioQwenLede, href: workspaceHref({ mode: 'strict', update: 'none', priorities: ['chinese'] }) },
  { label: m.v2.home.scenarioReplace, lede: m.v2.home.scenarioReplaceLede, href: workspaceHref({ mode: 'modern', update: 'none', priorities: ['current'] }) },
  { label: m.v2.home.scenarioApi, lede: m.v2.home.scenarioApiLede, href: workspaceHref({ mode: 'new', update: 'none', priorities: ['low_cost'] }) },
];
const sampleTask: ResearchTask = { ...emptyTask, mode: 'new', update: 'lora', gpuVramGb: 24, gpuCount: 1, openWeight: true };
const sampleScored = scoreModels(models, papers, sampleTask);
const sampleFeasible = sampleScored.filter((entry) => entry.candidateState !== 'blocked').length;
const sampleEvidenceReady = sampleScored.filter((entry) => entry.candidateState === 'candidate').length;
const highlightedFamilies = ['kimi', 'qwen', 'llama', 'deepseek'];
const familyChanges = familiesData.families.filter((family) => highlightedFamilies.includes(family.id)).map((family) => ({ name: family.name, generation: family.current_generation, api: family.current_api_model_ids?.[0] ?? family.current_flagship_model_id, openWeight: family.current_open_weight_model_id }));
const recentModelEvents = [...models].filter((model) => typeof model.release_date === 'string').sort((left, right) => right.release_date.localeCompare(left.release_date)).slice(0, 6);
const recentEvents = [
  ...changeEventEntries.map((entry) => entry.data).map((event) => ({ kind: 'event' as const, date: event.occurredAt, title: event.entityId, note: event.note ?? event.eventType })),
  ...recentModelEvents.map((model) => ({ kind: 'release' as const, date: model.release_date, title: model.name, note: `${model.vendor} · ${model.family}` })),
].sort((left, right) => right.date.localeCompare(left.date)).slice(0, 8);
---
<section class="hero">
  <div class="shell hero-grid">
    <div>
      <div class="eyebrow">{m.v2.home.heroEyebrow}</div>
      <h1>{m.v2.home.heroTitle}</h1>
      <p class="lede">{m.v2.home.heroLede}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={localePath(locale, '/guide/')}>{t('从 SEED 实战开始', 'Start with the SEED walkthrough')}</a>
        <a class="button button-secondary" href={localePath(locale, '/workspace/')}>{t('我已有研究任务', 'I already have a research task')}</a>
      </div>
      <p class="novice-entry">{t('第一次来？用一条完整路线理解“Agent 概念 → 论文条件 → 模型候选 → 算力 → 证据 → 决策”，再回来看模型目录。', 'First visit? Follow one complete route from agent concepts → paper conditions → candidates → compute → evidence → decision before browsing the catalog.')}</p>
    </div>
    <aside class="hero-note example-card">
      <div class="section-kicker">{locale === 'zh' ? '实时示例' : 'Live example'}</div>
      <h2 class="example-card-title">{locale === 'zh' ? '24GB · LoRA · 必须开放权重' : '24GB · LoRA · open weights required'}</h2>
      <p>{locale === 'zh' ? '数字由当前模型目录和推荐规则实时计算，不是演示占位符。' : 'These counts are computed from the current catalog and recommendation rules, not placeholder demo values.'}</p>
      <div class="example-stats"><div class="example-stat"><strong>{totalModels}</strong><span>{m.v2.home.exampleModels}</span></div><div class="example-stat"><strong>{sampleFeasible}</strong><span>{m.v2.home.exampleCandidates}</span></div><div class="example-stat"><strong>{sampleEvidenceReady}</strong><span>{m.v2.home.exampleEvidence}</span></div></div>
      <a class="text-link" href={workspaceHref(sampleTask)}>{locale === 'zh' ? '打开这个任务 →' : 'Open this task →'}</a>
    </aside>
  </div>
</section>

<div class="shell">
  <section class="section section-first home-compass" aria-labelledby="home-compass-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{t('先学会判断，再记模型名字', 'Learn the decision process before model names')}</div>
        <h2 id="home-compass-title">{t('研究员只需要守住这一条主线', 'One mainline is enough to stay oriented')}</h2>
      </div>
      <a class="text-link" href={localePath(locale, '/guide/')}>{t('用 SEED 完整走一遍 →', 'Walk it end to end with SEED →')}</a>
    </div>
    <ol class="home-compass-list">
      {decisionSteps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><h3>{step.title}</h3><p>{step.body}</p></div>
        </li>
      ))}
    </ol>
    <p class="home-compass-rule">{t('视觉规则也遵循这条主线：结论与下一步在前，原始事实与证据在后；“最新”“最强”只作为背景信息，不允许把你的研究问题带偏。', 'The visual hierarchy follows the same rule: conclusion and next action first, raw facts and evidence after. “Newest” and “strongest” stay contextual and never replace the research question.')}</p>
  </section>

  <section class="section" aria-labelledby="intent-title">
    <div class="section-heading"><div><div class="section-kicker">{locale === 'zh' ? '从问题开始' : 'Start from the question'}</div><h2 id="intent-title">{locale === 'zh' ? '你现在正在做什么？' : 'What are you trying to do?'}</h2></div></div>
    <div class="intent-grid">{primaryIntents.map((intent) => <a class="intent-row" href={intent.href}><div><h3>{intent.label}</h3><p>{intent.lede}</p></div><span aria-hidden="true">→</span></a>)}</div>
  </section>

  <SeedUseCaseStrip locale={locale} area="home" />

  <section class="section" aria-labelledby="paths-title">
    <div class="section-heading"><div><div class="section-kicker">{m.v2.home.pathsKicker}</div><h2 id="paths-title">{m.v2.home.pathsTitle}</h2></div></div>
    <div class="research-path-list">{researchPaths.map((path) => <div class="research-path-row"><span class="path-tag">{path.tag}</span><div><h3>{path.title}</h3><p>{path.body}</p></div></div>)}</div>
  </section>

  <section class="section" aria-labelledby="recent-changes-title">
    <div class="section-heading"><div><div class="section-kicker">{m.v2.home.recentChangesKicker}</div><h2 id="recent-changes-title">{m.v2.home.recentChangesTitle}</h2></div><span class="muted">{m.v2.home.recentChangesNote}</span></div>
    <ol class="model-timeline">{recentEvents.map((event) => <li><time datetime={event.date}>{event.date}</time><div><strong>{event.title}</strong><span>{event.note}</span><small>{event.kind === 'event' ? (locale === 'zh' ? '数据事件' : 'Data event') : m.v2.home.recentRelease}</small></div></li>)}</ol>
  </section>

  <section class="section" aria-labelledby="families-title">
    <div class="section-heading"><div><div class="section-kicker">{m.v2.home.familiesKicker}</div><h2 id="families-title">{m.v2.home.familiesTitle}</h2></div><a class="text-link" href={localePath(locale, '/families/')}>{m.v2.home.familiesCta}</a></div>
    <div class="family-current-list">{familyChanges.map((family) => <div class="family-current-row"><div><h3>{family.name}</h3><p>{locale === 'zh' ? `当前代：${family.generation}。API/托管与开放权重分开发现和维护。` : `Current generation: ${family.generation}. Hosted/API and open-weight surfaces are tracked separately.`}</p></div><dl><div><dt>API</dt><dd>{family.api ?? '—'}</dd></div><div><dt>{locale === 'zh' ? '开放权重' : 'Open weight'}</dt><dd>{family.openWeight ?? (locale === 'zh' ? '未记录当前开放权重旗舰' : 'No current open-weight flagship recorded')}</dd></div></dl></div>)}</div>
  </section>

  <details class="home-scenarios-advanced">
    <summary>{locale === 'zh' ? '更多预设研究场景' : 'More preset research scenarios'}</summary>
    <p class="muted">{m.v2.home.scenariosNote}</p>
    <div class="scenario-grid">{scenarioCards.map((card) => <a class="scenario-card" href={card.href}><h3>{card.label}</h3><p>{card.lede}</p><span class="scenario-action">{m.v2.home.scenarioAction} →</span></a>)}</div>
  </details>

  <section class="section landscape-overview" aria-labelledby="overview-title">
    <div class="section-heading"><div><div class="section-kicker">{m.v2.home.overviewKicker}</div><h2 id="overview-title">{m.v2.home.overviewTitle}</h2></div><a class="text-link" href={localePath(locale, '/landscape/')}>{m.v2.home.overviewCta}</a></div>
    <div class="overview-stats"><div class="stat"><strong>{totalModels}</strong><span>{m.v2.home.statModels}</span></div><div class="stat"><strong>{familyCount}</strong><span>{m.v2.home.statFamilies}</span></div><div class="stat"><strong>{openWeightCount}</strong><span>{m.v2.home.statOpenWeights}</span></div></div>
    <p class="muted">{m.v2.home.overviewBody}</p>
  </section>
</div>

<style>
  .home-compass {
    position: relative;
  }
  .home-compass-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .home-compass-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    min-width: 0;
    padding: 15px 14px;
  }
  .home-compass-list li + li {
    border-left: 1px solid var(--line);
  }
  .home-compass-list li > span {
    color: var(--accent-deep);
    font-size: .7rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .home-compass-list h3 {
    margin: 0 0 6px;
    font-size: .9rem;
    line-height: 1.25;
  }
  .home-compass-list p {
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.55;
  }
  .home-compass-rule {
    max-width: 900px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.6;
  }
  @media (max-width: 980px) {
    .home-compass-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-bottom: 0;
    }
    .home-compass-list li {
      border-bottom: 1px solid var(--line);
    }
    .home-compass-list li:nth-child(odd) {
      border-left: 0;
    }
  }
  @media (max-width: 620px) {
    .home-compass-list {
      grid-template-columns: 1fr;
    }
    .home-compass-list li,
    .home-compass-list li + li {
      border-left: 0;
    }
  }
</style>
