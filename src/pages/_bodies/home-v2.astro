---
import { getCollection } from 'astro:content';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import { encodeResearchTask } from '../../lib/researchTaskCodec';
import { emptyTask, type ResearchTask } from '../../stores/researchTask';
import familiesData from '../../content/coverage/families.json';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const isZh = locale === 'zh';
const t = (zh: string, en: string) => isZh ? zh : en;

const modelEntries = await getCollection('models');
const models = modelEntries.map((entry) => entry.data);
const changeEventEntries = await getCollection('changeEvents');

const totalModels = models.length;
const familyCount = familiesData.families.length;
const openWeightCount = models.filter((model) => model.openness.weights_available === true).length;

function workspaceHref(task: Partial<ResearchTask>): string {
  const params = encodeResearchTask({ ...emptyTask, ...task });
  return `${localePath(locale, '/workspace/') }?${params.toString()}`;
}

const scenarioCards = [
  {
    label: m.v2.home.scenarioLora,
    lede: m.v2.home.scenarioLoraLede,
    href: workspaceHref({ mode: 'new', update: 'lora', gpuVramGb: 24, openWeight: true }),
  },
  {
    label: m.v2.home.scenarioRl,
    lede: m.v2.home.scenarioRlLede,
    href: workspaceHref({ mode: 'modern', update: 'rl', gpuCount: 4, openWeight: true }),
  },
  {
    label: m.v2.home.scenarioOpenWeight,
    lede: m.v2.home.scenarioOpenWeightLede,
    href: workspaceHref({ mode: 'new', update: 'none', openWeight: true }),
  },
  {
    label: m.v2.home.scenarioQwen,
    lede: m.v2.home.scenarioQwenLede,
    href: workspaceHref({ mode: 'strict', update: 'none', priorities: ['chinese'] }),
  },
  {
    label: m.v2.home.scenarioReplace,
    lede: m.v2.home.scenarioReplaceLede,
    href: workspaceHref({ mode: 'modern', update: 'none', priorities: ['current'] }),
  },
  {
    label: m.v2.home.scenarioApi,
    lede: m.v2.home.scenarioApiLede,
    href: workspaceHref({ mode: 'new', update: 'none', priorities: ['low_cost'] }),
  },
];

const researchPaths = [
  { title: m.v2.home.pathStrict, body: m.v2.home.pathStrictBody, tag: m.v2.home.pathStrictTag },
  { title: m.v2.home.pathMethod, body: m.v2.home.pathMethodBody, tag: m.v2.home.pathMethodTag },
  { title: m.v2.home.pathModern, body: m.v2.home.pathModernBody, tag: m.v2.home.pathModernTag },
];

const highlightedFamilies = ['kimi', 'qwen', 'llama', 'deepseek'];
const familyChanges = familiesData.families
  .filter((family) => highlightedFamilies.includes(family.id))
  .map((family) => ({
    name: family.name,
    generation: family.current_generation,
    flagship: family.current_flagship_model_id,
    openWeight: family.current_open_weight_model_id,
    claim: family.current_claim?.text,
  }));
const recentModelEvents = [...models]
  .filter((model) => typeof model.release_date === 'string')
  .sort((left, right) => right.release_date.localeCompare(left.release_date))
  .slice(0, 6);
const recentEvents = [...changeEventEntries.map((entry) => entry.data).map((event) => ({ kind: 'event' as const, date: event.occurredAt, title: event.entityId, note: event.note ?? event.eventType })), ...recentModelEvents.map((model) => ({ kind: 'release' as const, date: model.release_date, title: model.name, note: `${model.vendor} · ${model.family}` }))]
  .sort((left, right) => right.date.localeCompare(left.date))
  .slice(0, 8);

const secondaryEntries = [
  { label: m.v2.home.entryReproduce, href: localePath(locale, '/papers/') },
  { label: m.v2.home.entryChoose, href: localePath(locale, '/workspace/') },
  { label: m.v2.home.entryReplace, href: localePath(locale, '/models/') },
  { label: m.v2.home.entryLearn, href: localePath(locale, '/guide/') },
];
---

<section class="hero">
  <div class="shell hero-grid">
    <div>
      <div class="eyebrow">{m.v2.home.heroEyebrow}</div>
      <h1>{m.v2.home.heroTitle}</h1>
      <p class="lede">{m.v2.home.heroLede}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={localePath(locale, '/workspace/')}>{m.v2.home.heroCta}</a>
      </div>
      <div class="entry-grid">
        {secondaryEntries.map((entry) => (
          <a class="entry-card" href={entry.href}>
            <span class="entry-label">{entry.label}</span>
            <span class="entry-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
    <aside class="hero-note example-card">
      <div class="section-kicker">{m.v2.home.exampleKicker}</div>
      <h2 class="example-card-title">{m.v2.home.exampleTitle}</h2>
      <p>{m.v2.home.exampleBody}</p>
      <div class="example-stats">
        <div class="example-stat">
          <strong>18</strong>
          <span>{m.v2.home.exampleModels}</span>
        </div>
        <div class="example-stat">
          <strong>5</strong>
          <span>{m.v2.home.exampleCandidates}</span>
        </div>
        <div class="example-stat">
          <strong>3</strong>
          <span>{m.v2.home.exampleEvidence}</span>
        </div>
      </div>
    </aside>
  </div>
</section>

<div class="shell">
  <section class="section section-first" aria-labelledby="philosophy-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{t('设计哲学', 'Design philosophy')}</div>
        <h2 id="philosophy-title">{t('一条主线，每页三问', 'One mainline, three questions per page')}</h2>
      </div>
      <span class="muted">{t('先明白为什么，再动手做', 'Understand why before acting')}</span>
    </div>
    <div class="path-grid">
      <div class="path-card">
        <span class="path-tag">{t('主线', 'Mainline')}</span>
        <h3>{t('从研究问题到模型决策，只走一条线', 'One line from research question to decision')}</h3>
        <p>{t('全站页面挂在同一条主线上：明确问题 → 收紧约束 → 形成候选 → 核验证据 → 做出决策。“最新模型”“最强跑分”只是背景信息，不会在半路替换掉你的研究问题。', 'Every page sits on the same mainline: define the question → narrow constraints → form candidates → verify evidence → decide. The “latest model” or “top score” is background information; it never replaces your research question midway.')}</p>
      </div>
      <div class="path-card">
        <span class="path-tag">{t('每页三问', 'Three questions')}</span>
        <h3>{t('现在做什么 · 为什么 · 怎么做', 'What · Why · How')}</h3>
        <p>{t('每个页面顶部固定回答三件事：这一步在做什么，为什么重要，具体怎么往下走。先看为什么，再看怎么做——细节再多，也不会忘记自己要干什么。', 'The top of every page answers three fixed questions: what this step does, why it matters, and how to proceed. Read the why before the how — details never make you lose the goal.')}</p>
      </div>
      <div class="path-card">
        <span class="path-tag">{t('证据先行', 'Evidence first')}</span>
        <h3>{t('未知保持未知，结论可以悬置', 'Unknown stays unknown; conclusions may wait')}</h3>
        <p>{t('不把“没查到”填成“没有”，不把估算写成事实。每个推荐都附来源、风险和待核验项；暂时下不了结论时，页面会明说，而不是编一个。', '“Not found” is never filled in as “no”, and estimates are never shown as facts. Every recommendation ships with sources, risks, and pending checks; when no conclusion can be drawn yet, the page says so instead of inventing one.')}</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="paths-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{m.v2.home.pathsKicker}</div>
        <h2 id="paths-title">{m.v2.home.pathsTitle}</h2>
      </div>
    </div>
    <div class="path-grid">
      {researchPaths.map((path) => (
        <div class="path-card">
          <span class="path-tag">{path.tag}</span>
          <h3>{path.title}</h3>
          <p>{path.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="scenarios-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{m.v2.home.scenariosKicker}</div>
        <h2 id="scenarios-title">{m.v2.home.scenariosTitle}</h2>
      </div>
      <span class="muted">{m.v2.home.scenariosNote}</span>
    </div>
    <div class="scenario-grid">
      {scenarioCards.map((card) => (
        <a class="scenario-card" href={card.href}>
          <h3>{card.label}</h3>
          <p>{card.lede}</p>
          <span class="scenario-action">{m.v2.home.scenarioAction} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="recent-changes-title">
    <div class="recent-layout">
      <div class="section-heading recent-heading">
        <div>
          <div class="section-kicker">{m.v2.home.recentChangesKicker}</div>
          <h2 id="recent-changes-title">{m.v2.home.recentChangesTitle}</h2>
        </div>
        <span class="muted">{m.v2.home.recentChangesNote}</span>
      </div>
      <ol class="model-timeline">
        {recentEvents.map((event) => <li><time datetime={event.date}>{event.date}</time><div><strong>{event.title}</strong><span>{event.note}</span><small>{event.kind === 'event' ? (locale === 'zh' ? '数据事件' : 'Data event') : m.v2.home.recentRelease}</small></div></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="families-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{m.v2.home.familiesKicker}</div>
        <h2 id="families-title">{m.v2.home.familiesTitle}</h2>
      </div>
      <a class="text-link" href={localePath(locale, '/families/')}>{m.v2.home.familiesCta}</a>
    </div>
    <div class="family-grid">
      {familyChanges.map((family) => (
        <div class="family-card">
          <div class="family-head">
            <h3>{family.name}</h3>
            <span class="family-generation">{family.generation}</span>
          </div>
          <p>{family.claim}</p>
          <div class="family-meta">
            <span>{m.v2.home.familyFlagship}: {family.flagship}</span>
            {family.openWeight && <span class="tag tag-open">{m.v2.home.familyOpenWeight}</span>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section landscape-overview" aria-labelledby="overview-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{m.v2.home.overviewKicker}</div>
        <h2 id="overview-title">{m.v2.home.overviewTitle}</h2>
      </div>
      <a class="text-link" href={localePath(locale, '/landscape/')}>{m.v2.home.overviewCta}</a>
    </div>
    <div class="overview-stats">
      <div class="stat">
        <strong>{totalModels}</strong>
        <span>{m.v2.home.statModels}</span>
      </div>
      <div class="stat">
        <strong>{familyCount}</strong>
        <span>{m.v2.home.statFamilies}</span>
      </div>
      <div class="stat">
        <strong>{openWeightCount}</strong>
        <span>{m.v2.home.statOpenWeights}</span>
      </div>
    </div>
    <p class="muted">{m.v2.home.overviewBody}</p>
  </section>
</div>

<style>
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 32px;
  }
  .entry-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
  }
  .entry-card:hover {
    border-color: var(--accent);
  }
  .entry-label {
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--ink);
  }
  .entry-arrow {
    color: var(--accent-deep);
    font-weight: 700;
  }
  .example-card h3 {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }
  .example-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .example-stat strong {
    display: block;
    font-size: 1.6rem;
    color: var(--accent-deep);
  }
  .example-stat span {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .path-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .path-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px;
  }
  .path-tag {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 750;
    background: var(--surface-muted);
    color: var(--muted);
    margin-bottom: 12px;
  }
  .path-card h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .path-card p {
    color: var(--muted);
    font-size: 0.88rem;
    margin-bottom: 0;
  }
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .scenario-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    text-decoration: none;
  }
  .scenario-card:hover {
    border-color: var(--accent);
  }
  .scenario-card h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }
  .scenario-card p {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 14px;
    flex: 1;
  }
  .scenario-action {
    color: var(--accent-deep);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .recent-layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.85fr) 1.6fr;
    gap: 56px;
    align-items: start;
  }
  .recent-heading {
    display: block;
    position: sticky;
    top: 96px;
    margin-bottom: 0;
  }
  .recent-heading .muted {
    display: block;
    margin-top: 10px;
    font-size: 0.84rem;
  }
  .recent-layout .model-timeline {
    max-width: 600px;
  }
  .family-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .family-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
  }
  .family-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .family-head h3 {
    font-size: 1.15rem;
    margin-bottom: 0;
  }
  .family-generation {
    color: var(--accent-deep);
    font-weight: 750;
    font-size: 0.85rem;
  }
  .family-card p {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 14px;
  }
  .family-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .tag-open {
    color: var(--blue);
    border-color: color-mix(in srgb, var(--blue) 45%, var(--line));
  }
  .landscape-overview {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px;
  }
  .overview-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 24px 0 18px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .overview-stats .stat {
    padding: 0;
  }
  .overview-stats .stat + .stat {
    border-left: 1px solid var(--line);
    padding-left: 24px;
  }
  @media (max-width: 820px) {
    .entry-grid { grid-template-columns: 1fr; }
    .path-grid { grid-template-columns: 1fr; }
    .scenario-grid { grid-template-columns: 1fr; }
    .recent-layout { grid-template-columns: 1fr; gap: 20px; }
    .recent-heading { position: static; }
    .family-grid { grid-template-columns: 1fr; }
    .overview-stats { grid-template-columns: 1fr; }
    .overview-stats .stat + .stat { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .example-stats { grid-template-columns: 1fr; }
  }
</style>
