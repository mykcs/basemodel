---
import { getCollection } from 'astro:content';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import { encodeResearchTask } from '../../lib/researchTaskCodec';
import { scoreModels } from '../../lib/researchEngine';
import { currentSurfaceSummary, familyCoverageRecords, localizedFamilyClaim } from '../../lib/familyCoverage';
import { emptyTask, type ResearchTask } from '../../stores/researchTask';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const models = (await getCollection('models')).map((entry) => entry.data);
const papers = (await getCollection('papers')).map((entry) => entry.data);
const changeEventEntries = await getCollection('changeEvents');
const totalModels = models.length;
const familyCount = familyCoverageRecords.length;
const openWeightCount = models.filter((model) => model.openness.weights_available === true).length;

function workspaceHref(task: Partial<ResearchTask>): string {
  const params = encodeResearchTask({ ...emptyTask, ...task });
  return `${localePath(locale, '/workspace/') }?${params.toString()}`;
}

const primaryIntents = [
  { label: locale === 'zh' ? '复现一篇论文' : 'Reproduce a paper', lede: locale === 'zh' ? '先从论文案例进入，再决定严格复现、方法复现或现代化重跑。' : 'Start from a paper case, then choose strict reproduction, method reproduction, or a modern rerun.', href: localePath(locale, '/papers/') },
  { label: locale === 'zh' ? '设计一个新实验' : 'Design a new experiment', lede: locale === 'zh' ? '按训练方式、资源、开放性和可复现性形成候选。' : 'Form candidates from training method, resources, access, and reproducibility.', href: localePath(locale, '/workspace/') },
  { label: locale === 'zh' ? '替换一个旧模型' : 'Replace an older model', lede: locale === 'zh' ? '比较论文原模型与当前候选，显式暴露可比性风险。' : 'Compare the original paper model with current candidates and expose comparability risks.', href: workspaceHref({ mode: 'modern', update: 'none', priorities: ['current'] }) },
];
const scenarioCards = [
  { label: m.v2.home.scenarioLora, lede: m.v2.home.scenarioLoraLede, href: workspaceHref({ mode: 'new', update: 'lora', gpuVramGb: 24, openWeight: true }) },
  { label: m.v2.home.scenarioRl, lede: m.v2.home.scenarioRlLede, href: workspaceHref({ mode: 'modern', update: 'rl', gpuCount: 4, openWeight: true }) },
  { label: m.v2.home.scenarioOpenWeight, lede: m.v2.home.scenarioOpenWeightLede, href: workspaceHref({ mode: 'new', update: 'none', openWeight: true }) },
  { label: m.v2.home.scenarioQwen, lede: m.v2.home.scenarioQwenLede, href: workspaceHref({ mode: 'strict', update: 'none', priorities: ['chinese'] }) },
  { label: m.v2.home.scenarioReplace, lede: m.v2.home.scenarioReplaceLede, href: workspaceHref({ mode: 'modern', update: 'none', priorities: ['current'] }) },
  { label: m.v2.home.scenarioApi, lede: m.v2.home.scenarioApiLede, href: workspaceHref({ mode: 'new', update: 'none', priorities: ['low_cost'] }) },
];
const researchPaths = [
  { title: m.v2.home.pathStrict, body: m.v2.home.pathStrictBody, tag: m.v2.home.pathStrictTag },
  { title: m.v2.home.pathMethod, body: m.v2.home.pathMethodBody, tag: m.v2.home.pathMethodTag },
  { title: m.v2.home.pathModern, body: m.v2.home.pathModernBody, tag: m.v2.home.pathModernTag },
];
const sampleTask: ResearchTask = { ...emptyTask, mode: 'new', update: 'lora', gpuVramGb: 24, gpuCount: 1, openWeight: true };
const sampleScored = scoreModels(models, papers, sampleTask);
const sampleFeasible = sampleScored.filter((entry) => entry.candidateState !== 'blocked').length;
const sampleEvidenceReady = sampleScored.filter((entry) => entry.candidateState === 'candidate').length;
const highlightedFamilies = ['kimi', 'qwen', 'llama', 'deepseek'];
const familyChanges = familyCoverageRecords.filter((family) => highlightedFamilies.includes(family.id)).map((family) => ({ name: family.name, generation: family.current_generation, surfaces: currentSurfaceSummary(family), claim: localizedFamilyClaim(family, locale) }));
const recentModelEvents = [...models].filter((model) => typeof model.release_date === 'string').sort((left, right) => right.release_date.localeCompare(left.release_date)).slice(0, 6);
const recentEvents = [...changeEventEntries.map((entry) => entry.data).map((event) => ({ kind: 'event' as const, date: event.occurredAt, title: event.entityId, note: event.note ?? event.eventType })), ...recentModelEvents.map((model) => ({ kind: 'release' as const, date: model.release_date, title: model.name, note: `${model.vendor} · ${model.family}` }))].sort((left, right) => right.date.localeCompare(left.date)).slice(0, 8);
---
<section class="hero"><div class="shell hero-grid"><div><div class="eyebrow">{m.v2.home.heroEyebrow}</div><h1>{m.v2.home.heroTitle}</h1><p class="lede">{m.v2.home.heroLede}</p><div class="hero-actions"><a class="button button-primary" href={localePath(locale, '/workspace/')}>{m.v2.home.heroCta}</a></div><p class="novice-entry">{locale === 'zh' ? '第一次接触 Agent 模型？' : 'New to agent model research?'} <a class="text-link" href={localePath(locale, '/guide/')}>{locale === 'zh' ? '先学习基础知识 →' : 'Start with the guide →'}</a></p></div><aside class="hero-note example-card"><div class="section-kicker">{locale === 'zh' ? '实时示例' : 'Live example'}</div><h2 class="example-card-title">{locale === 'zh' ? '24GB · LoRA · 必须开放权重' : '24GB · LoRA · open weights required'}</h2><p>{locale === 'zh' ? '这些数字由当前目录和研究规则实时计算，不是演示占位符。' : 'These counts are computed from the current catalog and research rules, not placeholder demo values.'}</p><div class="example-stats"><div class="example-stat"><strong>{totalModels}</strong><span>{m.v2.home.exampleModels}</span></div><div class="example-stat"><strong>{sampleFeasible}</strong><span>{m.v2.home.exampleCandidates}</span></div><div class="example-stat"><strong>{sampleEvidenceReady}</strong><span>{m.v2.home.exampleEvidence}</span></div></div><a class="text-link" href={workspaceHref(sampleTask)}>{locale === 'zh' ? '打开这个任务 →' : 'Open this task →'}</a></aside></div></section>
<div class="shell">
<section class="section section-first" aria-labelledby="intent-title"><div class="section-heading"><div><div class="section-kicker">{locale === 'zh' ? '从你的问题开始' : 'Start from your question'}</div><h2 id="intent-title">{locale === 'zh' ? '你现在正在做什么？' : 'What are you trying to do?'}</h2></div></div><div class="intent-grid">{primaryIntents.map((intent) => <a class="intent-row" href={intent.href}><div><h3>{intent.label}</h3><p>{intent.lede}</p></div><span aria-hidden="true">→</span></a>)}</div></section>
<section class="section" aria-labelledby="paths-title"><div class="section-heading"><div><div class="section-kicker">{m.v2.home.pathsKicker}</div><h2 id="paths-title">{m.v2.home.pathsTitle}</h2></div></div><div class="research-path-list">{researchPaths.map((path) => <div class="research-path-row"><span class="path-tag">{path.tag}</span><div><h3>{path.title}</h3><p>{path.body}</p></div></div>)}</div></section>
<section class="section" aria-labelledby="recent-changes-title"><div class="section-heading"><div><div class="section-kicker">{m.v2.home.recentChangesKicker}</div><h2 id="recent-changes-title">{m.v2.home.recentChangesTitle}</h2></div><span class="muted">{m.v2.home.recentChangesNote}</span></div><ol class="model-timeline">{recentEvents.map((event) => <li><time datetime={event.date}>{event.date}</time><div><strong>{event.title}</strong><span>{event.note}</span><small>{event.kind === 'event' ? (locale === 'zh' ? '数据事件' : 'Data event') : m.v2.home.recentRelease}</small></div></li>)}</ol></section>
<section class="section" aria-labelledby="families-title"><div class="section-heading"><div><div class="section-kicker">{m.v2.home.familiesKicker}</div><h2 id="families-title">{m.v2.home.familiesTitle}</h2></div><a class="text-link" href={localePath(locale, '/families/')}>{m.v2.home.familiesCta}</a></div><div class="family-current-list">{familyChanges.map((family) => <div class="family-current-row"><div><h3>{family.name}</h3><p>{family.claim}</p></div><dl><div><dt>{locale === 'zh' ? '当前代' : 'Generation'}</dt><dd>{family.generation}</dd></div><div><dt>API</dt><dd>{family.surfaces.api ?? '—'}</dd></div><div><dt>{locale === 'zh' ? '开放权重' : 'Open weight'}</dt><dd>{family.surfaces.openWeight ?? '—'}</dd></div></dl></div>)}</div></section>
<details class="home-scenarios-advanced"><summary>{locale === 'zh' ? '更多预设研究场景' : 'More preset research scenarios'}</summary><p class="muted">{m.v2.home.scenariosNote}</p><div class="scenario-grid">{scenarioCards.map((card) => <a class="scenario-card" href={card.href}><h3>{card.label}</h3><p>{card.lede}</p><span class="scenario-action">{m.v2.home.scenarioAction} →</span></a>)}</div></details>
<section class="section landscape-overview" aria-labelledby="overview-title"><div class="section-heading"><div><div class="section-kicker">{m.v2.home.overviewKicker}</div><h2 id="overview-title">{m.v2.home.overviewTitle}</h2></div><a class="text-link" href={localePath(locale, '/landscape/')}>{m.v2.home.overviewCta}</a></div><div class="overview-stats"><div class="stat"><strong>{totalModels}</strong><span>{m.v2.home.statModels}</span></div><div class="stat"><strong>{familyCount}</strong><span>{m.v2.home.statFamilies}</span></div><div class="stat"><strong>{openWeightCount}</strong><span>{m.v2.home.statOpenWeights}</span></div></div><p class="muted">{m.v2.home.overviewBody}</p></section>
</div>
