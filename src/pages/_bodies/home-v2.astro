---
import { getCollection } from 'astro:content';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import { encodeResearchTask } from '../../lib/researchTaskCodec';
import { localizedChangeEventNote } from '../../lib/localizedChangeEvent';
import { emptyTask, type ResearchTask } from '../../stores/researchTask';
import familiesData from '../../content/coverage/families.json';
import SeedUseCaseStrip from '../../components/SeedUseCaseStrip.astro';
import SeedOpenEvoMissionHero from '../../components/research/SeedOpenEvoMissionHero.astro';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const models = (await getCollection('models')).map((entry) => entry.data);
const changeEventEntries = await getCollection('changeEvents');
const totalModels = models.length;
const familyCount = familiesData.families.length;
const openWeightCount = models.filter((model) => model.openness.weights_available === true).length;

function workspaceHref(task: Partial<ResearchTask>): string {
  const params = encodeResearchTask({ ...emptyTask, ...task });
  return `${localePath(locale, '/workspace/')}?${params.toString()}`;
}

const primaryIntents = [
  {
    label: locale === 'zh' ? '查看 SEED 原实验' : 'Review the original SEED experiment',
    lede: locale === 'zh' ? '确认 Qwen2.5-3B-Instruct、ALFWorld、WebShop、训练步骤和论文结果。' : 'Confirm Qwen2.5-3B-Instruct, ALFWorld, WebShop, the training steps, and the paper results.',
    href: localePath(locale, '/research/seed-openevo/'),
  },
  {
    label: locale === 'zh' ? '用 OpenEvo 复现 ALFWorld 与 WebShop' : 'Reproduce ALFWorld and WebShop with OpenEvo',
    lede: locale === 'zh' ? '准备环境和代码，运行两个任务，并保存动作、分数、失败原因和更新文件。' : 'Prepare the environment and code, run both tasks, and save actions, scores, failure reasons, and update files.',
    href: localePath(locale, '/guide/openevo-webshop-alfworld/'),
  },
  {
    label: locale === 'zh' ? '比较 SEED 与 OpenEvo' : 'Compare SEED with OpenEvo',
    lede: locale === 'zh' ? '固定模型、提示词、随机种子和预算，再比较结果并决定 OpenEvo 要改什么。' : 'Hold the model, prompts, random seeds, and budget fixed, then compare results and decide what to change in OpenEvo.',
    href: localePath(locale, '/research/seed-openevo/loops/'),
  },
];
const researchPaths = [
  { title: m.v2.home.pathStrict, body: m.v2.home.pathStrictBody, tag: m.v2.home.pathStrictTag },
  { title: m.v2.home.pathMethod, body: m.v2.home.pathMethodBody, tag: m.v2.home.pathMethodTag },
  { title: m.v2.home.pathModern, body: m.v2.home.pathModernBody, tag: m.v2.home.pathModernTag },
];
const scenarioCards = [
  { label: m.v2.home.scenarioLora, lede: m.v2.home.scenarioLoraLede, href: workspaceHref({ mode: 'new', update: 'lora', gpuVramGb: 24, openWeight: true }) },
  { label: m.v2.home.scenarioRl, lede: m.v2.home.scenarioRlLede, href: workspaceHref({ mode: 'modern', update: 'rl', gpuCount: 4, openWeight: true }) },
  { label: m.v2.home.scenarioOpenWeight, lede: m.v2.home.scenarioOpenWeightLede, href: workspaceHref({ mode: 'new', update: 'none', openWeight: true }) },
  { label: m.v2.home.scenarioQwen, lede: m.v2.home.scenarioQwenLede, href: workspaceHref({ mode: 'strict', update: 'none', priorities: ['chinese'] }) },
  { label: m.v2.home.scenarioReplace, lede: m.v2.home.scenarioReplaceLede, href: workspaceHref({ mode: 'modern', update: 'none', priorities: ['current'] }) },
  { label: m.v2.home.scenarioApi, lede: m.v2.home.scenarioApiLede, href: workspaceHref({ mode: 'new', update: 'none', priorities: ['low_cost'] }) },
];
const highlightedFamilies = ['kimi', 'qwen', 'llama', 'deepseek'];
const familyChanges = familiesData.families.filter((family) => highlightedFamilies.includes(family.id)).map((family) => ({ name: family.name, generation: family.current_generation, api: family.current_api_model_ids?.[0] ?? family.current_flagship_model_id, openWeight: family.current_open_weight_model_id }));
const recentModelEvents = [...models].filter((model) => typeof model.release_date === 'string').sort((left, right) => right.release_date.localeCompare(left.release_date)).slice(0, 6);
const recentEvents = [
  ...changeEventEntries.map((entry) => entry.data).map((event) => ({ kind: 'event' as const, date: event.occurredAt, title: event.entityId, note: localizedChangeEventNote(event, locale) })),
  ...recentModelEvents.map((model) => ({ kind: 'release' as const, date: model.release_date, title: model.name, note: `${model.vendor} · ${model.family}` })),
].sort((left, right) => right.date.localeCompare(left.date)).slice(0, 8);
---

<SeedOpenEvoMissionHero locale={locale} />

<div class="shell">
  <section class="section section-first" aria-labelledby="intent-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{locale === 'zh' ? '从这里开始' : 'Start here'}</div>
        <h2 id="intent-title">{locale === 'zh' ? '先看 SEED 原实验，再运行 OpenEvo，最后比较结果' : 'Review the SEED experiment, run OpenEvo, then compare the results'}</h2>
      </div>
    </div>
    <div class="intent-grid">{primaryIntents.map((intent) => <a class="intent-row" href={intent.href}><div><h3>{intent.label}</h3><p>{intent.lede}</p></div><span aria-hidden="true">→</span></a>)}</div>
  </section>

  <SeedUseCaseStrip locale={locale} area="home" />

  <section class="section" aria-labelledby="paths-title">
    <div class="section-heading"><div><div class="section-kicker">{locale === 'zh' ? '选择复现范围' : 'Choose the reproduction scope'}</div><h2 id="paths-title">{locale === 'zh' ? '按论文原条件复现、只验证方法，或更换新模型重跑' : 'Match the paper, test the method, or rerun with a newer model'}</h2></div></div>
    <div class="research-path-list">{researchPaths.map((path) => <div class="research-path-row"><span class="path-tag">{path.tag}</span><div><h3>{path.title}</h3><p>{path.body}</p></div></div>)}</div>
  </section>

  <section class="section" aria-labelledby="recent-changes-title">
    <div class="section-heading"><div><div class="section-kicker">{locale === 'zh' ? '最近更新' : 'Recent updates'}</div><h2 id="recent-changes-title">{locale === 'zh' ? '查看模型和数据记录最近发生了什么变化' : 'See what changed in the model and data records'}</h2></div><span class="muted">{m.v2.home.recentChangesNote}</span></div>
    <ol class="model-timeline">{recentEvents.map((event) => <li><time datetime={event.date}>{event.date}</time><div><strong>{event.title}</strong><span>{event.note}</span><small>{event.kind === 'event' ? (locale === 'zh' ? '数据记录更新' : 'Data record update') : m.v2.home.recentRelease}</small></div></li>)}</ol>
  </section>

  <section class="section" aria-labelledby="families-title">
    <div class="section-heading"><div><div class="section-kicker">{locale === 'zh' ? '模型家族' : 'Model families'}</div><h2 id="families-title">{locale === 'zh' ? '需要替换模型时，查看各家族目前有哪些可用版本' : 'When replacing a model, see which versions each family currently offers'}</h2></div><a class="text-link" href={localePath(locale, '/families/')}>{m.v2.home.familiesCta}</a></div>
    <div class="family-current-list">{familyChanges.map((family) => <div class="family-current-row"><div><h3>{family.name}</h3><p>{locale === 'zh' ? `核验日期下的代际：${family.generation}。API / 托管模型与开放权重模型分开记录。` : `Generation at the recorded check date: ${family.generation}. API/hosted models and open-weight models are tracked separately.`}</p></div><dl><div><dt>API</dt><dd>{family.api ?? '—'}</dd></div><div><dt>{locale === 'zh' ? '开放权重' : 'Open weight'}</dt><dd>{family.openWeight ?? (locale === 'zh' ? '未记录开放权重旗舰' : 'No open-weight flagship recorded')}</dd></div></dl></div>)}</div>
  </section>

  <details class="home-scenarios-advanced">
    <summary>{locale === 'zh' ? '完成这两个实验后，再查看其他模型和训练场景' : 'After these experiments, explore other model and training scenarios'}</summary>
    <p class="muted">{m.v2.home.scenariosNote}</p>
    <div class="scenario-grid">{scenarioCards.map((card) => <a class="scenario-card" href={card.href}><h3>{card.label}</h3><p>{card.lede}</p><span class="scenario-action">{m.v2.home.scenarioAction} →</span></a>)}</div>
  </details>

  <section class="section landscape-overview" aria-labelledby="overview-title">
    <div class="section-heading"><div><div class="section-kicker">{locale === 'zh' ? '模型目录' : 'Model catalog'}</div><h2 id="overview-title">{locale === 'zh' ? '查看本站记录了多少模型、家族和开放权重版本' : 'See how many models, families, and open-weight versions are recorded'}</h2></div><a class="text-link" href={localePath(locale, '/landscape/')}>{m.v2.home.overviewCta}</a></div>
    <div class="overview-stats"><div class="stat"><strong>{totalModels}</strong><span>{m.v2.home.statModels}</span></div><div class="stat"><strong>{familyCount}</strong><span>{m.v2.home.statFamilies}</span></div><div class="stat"><strong>{openWeightCount}</strong><span>{m.v2.home.statOpenWeights}</span></div></div>
    <p class="muted">{m.v2.home.overviewBody}</p>
  </section>
</div>
