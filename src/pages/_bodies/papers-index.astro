---
import { getCollection } from 'astro:content';
import PaperModelMatrix from '../../components/PaperModelMatrix';
import PaperExplorer from '../../components/papers/PaperExplorer';
import { getMessages, isLocale, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const paperEntries = await getCollection('papers');
const modelEntries = await getCollection('models');
const papers = paperEntries.map((entry) => entry.data);
const models = modelEntries.map((entry) => entry.data);
const matrixPapers = papers.map((paper) => ({ ...paper, models: paper.models.map(({ notes, ...use }) => use) }));
---
<div class="shell">
  <header class="page-header"><h1>{m.papersIndex.title}</h1><p class="lede">{m.papersIndex.lede}</p></header>
  <section class="section"><PaperExplorer client:load papers={papers} models={models} locale={locale} /></section>
  <details class="paper-matrix-advanced">
    <summary>{locale === 'zh' ? '高级视图：展开论文—模型关系矩阵' : 'Advanced view: open the paper–model relation matrix'}</summary>
    <p class="muted">{locale === 'zh' ? '矩阵适合查关系，不是论文案例库的默认阅读顺序。先从上面的研究问题和复现条件选择论文，再用矩阵交叉检查模型角色。' : 'The matrix is useful for relation lookup, not as the default paper-reading flow. Start from research questions and reproduction conditions above, then use the matrix to cross-check model roles.'}</p>
    <div class="section-heading"><div><h2>{m.papersIndex.matrixTitle}</h2></div></div>
    <PaperModelMatrix papers={matrixPapers} models={models} locale={locale} />
  </details>
</div>
