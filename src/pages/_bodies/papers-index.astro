---
import { getCollection } from 'astro:content';
import PaperModelMatrix from '../../components/PaperModelMatrix';
import PaperExplorer from '../../components/papers/PaperExplorer';
import { getMessages, isLocale, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const paperEntries = await getCollection('papers');
const modelEntries = await getCollection('models');
const papers = paperEntries.map((entry) => entry.data);
const models = modelEntries.map((entry) => entry.data);
// The matrix only needs relation IDs and roles. Do not serialize the source
// notes into the client island, where English prose would leak into zh HTML.
const matrixPapers = papers.map((paper) => ({
  ...paper,
  models: paper.models.map(({ notes, ...use }) => use),
}));
---
<div class="shell"><header class="page-header"><h1>{m.papersIndex.title}</h1><p class="lede">{m.papersIndex.lede}</p></header><section class="section"><PaperExplorer client:load papers={papers} models={models} locale={locale} /></section><section class="section"><div class="section-heading"><div><h2>{m.papersIndex.matrixTitle}</h2></div></div><PaperModelMatrix client:load papers={matrixPapers} models={models} locale={locale} /></section></div>
