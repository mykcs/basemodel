---
import { getCollection } from 'astro:content';
import PaperModelMatrix from '../../components/PaperModelMatrix';
import PaperExplorer from '../../components/papers/PaperExplorer';
import { getMessages, isLocale, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const paperEntries = await getCollection('papers');
const modelEntries = await getCollection('models');
const papers = paperEntries.map((entry) => entry.data);
const models = modelEntries.map((entry) => entry.data);
const matrixPapers = papers.map((paper) => ({ ...paper, models: paper.models.map(({ notes, ...use }) => use) }));
---
<div class="shell"><header class="page-header"><h1>{m.papersIndex.title}</h1><p class="lede">{m.papersIndex.lede}</p></header><section class="section"><PaperExplorer client:load papers={papers} models={models} locale={locale} /></section><details class="paper-matrix-advanced"><summary>{locale === 'zh' ? '高级视图：论文—模型关系矩阵' : 'Advanced view: paper–model relationship matrix'}</summary><p class="muted">{locale === 'zh' ? '案例卡优先用于研究决策；只有需要跨论文检查模型角色关系时，再展开矩阵。' : 'Paper cases are the primary research view. Expand the matrix only when you need cross-paper model-role relationships.'}</p><PaperModelMatrix papers={matrixPapers} models={models} locale={locale} /></details></div>
