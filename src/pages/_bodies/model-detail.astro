---
import ClaimEvidencePanel from '../../components/evidence/ClaimEvidencePanel.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ModelResearchSummary from '../../components/models/detail/ModelResearchSummary.astro';
import AccessLadder from '../../components/models/detail/AccessLadder.astro';
import { ModelTaskFit } from '../../components/models/detail/ModelTaskFit';
import { architectureLabel, checkpointLabel, displayBoolean, displayUnknown, isSameCanonicalName, licenseLabel, modelIdentityTrail, modalityLabel, parameterSummary, roleLabel, semanticStatusLabel, specializationLabel, tierLabel } from '../../lib/format';
import { paperUsesModel } from '../../lib/modelRelations';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import type { AtlasModel, AtlasPaper } from '../../lib/types';
import ModelDetailTools from '../../components/models/detail/ModelDetailTools';
import ModelAlternatives from '../../components/models/detail/ModelAlternatives.astro';
import SemanticStatusLegend from '../../components/common/SemanticStatusLegend.astro';

interface Props { model: AtlasModel; models?: AtlasModel[]; papers: AtlasPaper[]; locale?: Locale }
const { model, models = [model], papers } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const joiner = locale === 'zh' ? '、' : ', ';
const relationJoiner = locale === 'zh' ? '；' : '; ';
const alternateName = model.official_name && !isSameCanonicalName(model.name, model.official_name) ? model.official_name : undefined;
const identityTrail = modelIdentityTrail(model);
const statusText = (value: string | undefined) => {
  if (!value) return m.format.unknown;
  if (value in m.format.semanticStatus) return semanticStatusLabel(value, locale);
  const labels: Record<string, string> = locale === 'zh'
    ? { released: '已发布', announced: '已宣布', unavailable: '不可用', withdrawn: '已撤回', available: '可用', preview: '预览', deprecated: '已弃用', unknown: '待核验' }
    : { released: 'Released', announced: 'Announced', unavailable: 'Unavailable', withdrawn: 'Withdrawn', available: 'Available', preview: 'Preview', deprecated: 'Deprecated', unknown: 'Pending verification' };
  return labels[value] ?? m.format.unknown;
};
const enumText = (value: string | undefined) => {
  if (!value) return m.format.unknown;
  if (value in m.format.semanticStatus) return semanticStatusLabel(value, locale);
  const labels: Record<string, string> = locale === 'zh'
    ? { open_source: '开放源代码', open_weight: '开放权重', source_available: '源代码可用', proprietary: '专有', unknown: '待核验', allowed: '允许', conditional: '有条件', prohibited: '禁止' }
    : { open_source: 'Open source', open_weight: 'Open weight', source_available: 'Source available', proprietary: 'Proprietary', unknown: 'Pending verification', allowed: 'Allowed', conditional: 'Conditional', prohibited: 'Prohibited' };
  return labels[value] ?? m.format.unknown;
};
const evidenceText = (value: string) => {
  const labels: Record<string, string> = locale === 'zh'
    ? { redistribution_and_commercial_conditions: '再分发与商业部署受 Kimi K3 License 条件约束。', not_legal_advice: '本页信息不构成法律意见。', preserve_reasoning_and_tool_call_history: '多轮工具调用需保留完整推理与工具调用历史。', k26_preserved_thinking_optional: '跨轮保留思考可选，默认关闭。', k25_preserved_thinking_not_supported: 'Kimi K2.5 不支持跨轮保留式思考；单轮多步调用仍需按 API 要求传递上下文。' }
    : { redistribution_and_commercial_conditions: 'Redistribution and commercial deployment are subject to the Kimi K3 License.', not_legal_advice: 'This summary is not legal advice.', preserve_reasoning_and_tool_call_history: 'Preserve complete reasoning and tool-call history across multi-turn tool use.', k26_preserved_thinking_optional: 'Cross-turn preserved thinking is optional and disabled by default.', k25_preserved_thinking_not_supported: 'Kimi K2.5 does not support cross-turn preserved thinking; pass context as required for a single multi-step API call.' };
  return labels[value] ?? value;
};
const semanticValues = new Set(['not_disclosed', 'not_applicable', 'not_reported', 'not_verified', 'conflicting_evidence', 'not_published', 'unavailable', 'unknown']);
const unresolvedFields: string[] = [];
const collectUnresolved = (value: unknown, path: string) => {
  if (typeof value === 'string' && semanticValues.has(value)) unresolvedFields.push(path);
  else if (Array.isArray(value)) value.forEach((item, index) => collectUnresolved(item, `${path}[${index}]`));
  else if (value && typeof value === 'object') Object.entries(value).forEach(([key, item]) => collectUnresolved(item, path ? `${path}.${key}` : key));
};
collectUnresolved(model, 'model');
const positioning = model.checkpoint.specializations.length ? model.checkpoint.specializations.map((item) => specializationLabel(item, locale)).join(joiner) : m.format.unknown;
---
<div class="shell detail-layout"><article>{identityTrail.length > 0 && <div class="eyebrow">{identityTrail.join(' / ')}</div>}<h1 class="detail-title">{model.name}</h1>{alternateName && <p class="detail-alias muted">{alternateName}</p>}<p class="detail-subtitle">{checkpointLabel(model.checkpoint.type, locale)} · {model.release_date} · <StatusBadge status={model.data_status} locale={locale} /></p><ModelDetailTools client:load model={model} locale={locale} />
  <ModelResearchSummary model={model} papers={papers} locale={locale} />
  <AccessLadder model={model} locale={locale} />
  <ModelTaskFit client:load model={model} papers={papers} m={m} locale={locale} />
  <section class="detail-section"><h2>{m.detail.overview}</h2><div class="fact-grid"><div class="fact"><dt>{m.detail.positioning}</dt><dd>{positioning}</dd></div><div class="fact"><dt>{m.detail.architecture}</dt><dd>{architectureLabel(model.architecture.type, locale)}</dd></div><div class="fact"><dt>{m.detail.parameters}</dt><dd>{parameterSummary(model.architecture.total_parameters_b, model.architecture.active_parameters_b, model.architecture.type, locale)}</dd></div><div class="fact"><dt>{m.detail.activeParams}</dt><dd>{displayUnknown(model.architecture.active_parameters_b, 'B', locale)}</dd></div><div class="fact"><dt>{m.detail.expertCount}</dt><dd>{displayUnknown(model.architecture.expert_count, '', locale)}</dd></div><div class="fact"><dt>{m.detail.expertsPerToken}</dt><dd>{displayUnknown(model.architecture.active_experts_per_token, '', locale)}</dd></div><div class="fact"><dt>{m.detail.context}</dt><dd>{displayUnknown(model.architecture.context_length, m.detail.tokensSuffix, locale)}</dd></div><div class="fact"><dt>{m.detail.modalities}</dt><dd>{model.checkpoint.modalities.map((value) => modalityLabel(value, locale)).join(joiner)}</dd></div>{!model.openness.classification && <div class="fact"><dt>{m.detail.openWeights}</dt><dd>{displayBoolean(model.openness.weights_available, locale)}</dd></div>}<div class="fact"><dt>{m.detail.baseCheckpoint}</dt><dd>{displayBoolean(model.openness.base_checkpoint_available, locale)}</dd></div><div class="fact"><dt>{m.detail.finetuningAllowed}</dt><dd>{displayBoolean(model.openness.finetuning_allowed, locale)}</dd></div>{!model.openness.derivative_distribution && <div class="fact"><dt>{m.detail.derivativeAllowed}</dt><dd>{displayBoolean(model.openness.derivative_release_allowed, locale)}</dd></div>}{!model.openness.commercial_use && <div class="fact"><dt>{m.detail.commercialAllowed}</dt><dd>{displayBoolean(model.openness.commercial_use_allowed, locale)}</dd></div>}<div class="fact"><dt>{m.detail.license}</dt><dd>{licenseLabel(model.openness.license_name, locale)}</dd></div></div></section>
  <section class="detail-section"><h2>{m.detail.unresolvedTitle}</h2>{unresolvedFields.length ? <><p class="muted">{m.detail.unresolvedBody}</p><p class="unresolved-count">{m.detail.unresolvedCount.replace('{count}', String(unresolvedFields.length))}</p></> : <p class="muted">{m.detail.noUnresolved}</p>}</section>
  <SemanticStatusLegend locale={locale} compact />
  {(model.access || model.openness.classification || model.reproducibility) && <section class="detail-section"><h2>{m.detail.accessTitle}</h2><div class="fact-grid">{model.access && <><div class="fact"><dt>{m.detail.weightsStatus}</dt><dd>{statusText(model.access.weights_status)}</dd></div>{model.access.weights_released_at && <div class="fact"><dt>{m.detail.weightsReleasedAt}</dt><dd>{model.access.weights_released_at}</dd></div>}<div class="fact"><dt>{m.detail.apiStatus}</dt><dd>{statusText(model.access.api_status)}</dd></div>{model.access.api_model_ids?.length && <div class="fact"><dt>{m.detail.apiModelIds}</dt><dd>{model.access.api_model_ids.join(joiner)}</dd></div>}<div class="fact"><dt>{m.detail.productStatus}</dt><dd>{statusText(model.access.product_status)}</dd></div>{model.access.product_names?.length && <div class="fact"><dt>{m.detail.productNames}</dt><dd>{model.access.product_names.join(joiner)}</dd></div>}</>}{model.openness.classification && <div class="fact"><dt>{m.detail.opennessClass}</dt><dd>{enumText(model.openness.classification)}</dd></div>}{model.openness.custom_license !== undefined && <div class="fact"><dt>{m.detail.customLicense}</dt><dd>{displayBoolean(model.openness.custom_license, locale)}</dd></div>}{model.openness.derivative_distribution && <div class="fact"><dt>{m.detail.derivativeDistribution}</dt><dd>{enumText(model.openness.derivative_distribution)}</dd></div>}{model.openness.commercial_use && <div class="fact"><dt>{m.detail.commercialUse}</dt><dd>{enumText(model.openness.commercial_use)}</dd></div>}{model.openness.conditions?.length && <div class="fact"><dt>{m.detail.conditions}</dt><dd>{model.openness.conditions.map(evidenceText).join(locale === 'zh' ? '；' : '; ')}</dd></div>}</div>{model.reproducibility && <div class="fact-grid" style="margin-top:16px"><div class="fact"><dt>{m.detail.modelRevision}</dt><dd>{model.reproducibility.model_revision_required === true ? (locale === 'zh' ? '需固定模型版本号' : 'Pin the model revision') : m.format.unknown}</dd></div><div class="fact"><dt>{m.detail.preservedReasoning}</dt><dd>{displayBoolean(model.reproducibility.preserved_reasoning_history_required ?? 'not_verified', locale)}</dd></div>{model.reproducibility.known_nondeterminism_notes && <div class="fact"><dt>{m.detail.reproducibilityNotes}</dt><dd>{evidenceText(model.reproducibility.known_nondeterminism_notes)}</dd></div>}</div>}</section>}
  <section class="detail-section"><h2>{m.detail.strengthsTitle}</h2><div class="pill-list">{model.checkpoint.specializations.map((item) => <span class="pill">{specializationLabel(item, locale)}</span>)}</div><div class="fact-grid" style="margin-top:16px"><div class="fact"><dt>{m.detail.research.inference}</dt><dd>{displayBoolean(model.research.suitable_for_inference, locale)}</dd></div><div class="fact"><dt>{m.detail.research.lora}</dt><dd>{displayBoolean(model.research.suitable_for_lora, locale)}</dd></div><div class="fact"><dt>{m.detail.research.sft}</dt><dd>{displayBoolean(model.research.suitable_for_sft, locale)}</dd></div><div class="fact"><dt>{m.detail.research.rl}</dt><dd>{displayBoolean(model.research.suitable_for_rl, locale)}</dd></div><div class="fact"><dt>{m.detail.research.transformers}</dt><dd>{displayBoolean(model.research.transformers_support, locale)}</dd></div><div class="fact"><dt>{m.detail.research.vllm}</dt><dd>{displayBoolean(model.research.vllm_support, locale)}</dd></div><div class="fact"><dt>{m.detail.research.sglang}</dt><dd>{displayBoolean(model.research.sglang_support, locale)}</dd></div><div class="fact"><dt>{m.detail.research.verl}</dt><dd>{displayBoolean(model.research.verl_recipe_available, locale)}</dd></div></div></section>
  <section class="detail-section"><h2>{m.detail.hardwareTitle}</h2><div class="fact-grid"><div class="fact"><dt>{m.detail.inference}</dt><dd>{tierLabel(model.hardware.inference_tier, locale)}</dd></div><div class="fact"><dt>{m.detail.research.lora}</dt><dd>{tierLabel(model.hardware.lora_tier, locale)}</dd></div><div class="fact"><dt>{m.detail.fullSft}</dt><dd>{tierLabel(model.hardware.full_sft_tier, locale)}</dd></div><div class="fact"><dt>{m.detail.research.rl}</dt><dd>{tierLabel(model.hardware.rl_tier, locale)}</dd></div></div></section>
  <section class="detail-section"><h2>{m.detail.adoptionTitle}</h2>{papers.length ? <div class="paper-list">{papers.map((paper) => <a class="paper-row" href={localePath(locale, `/papers/${paper.id}/`)}><div><h3>{paper.title}</h3><p>{paperUsesModel(paper, model.id).map((use) => `${roleLabel(use.role, locale)}${use.weight_updated === true ? m.detail.weightUpdatedSuffix : ''}`).join(relationJoiner)}</p></div><div class="paper-meta">{paper.published_at}</div></a>)}</div> : <p class="muted">{m.detail.noAdoption}</p>}</section>
  <ModelAlternatives model={model} models={models} locale={locale} />
</article><aside class="detail-aside"><ClaimEvidencePanel item={model} locale={locale} /></aside></div>
