---
import EvidenceList from '../../components/EvidenceList.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { displayBoolean, displayUnknown, tierLabel } from '../../lib/format';
import { paperUsesModel } from '../../lib/modelRelations';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import type { AtlasModel, AtlasPaper } from '../../lib/types';

interface Props { model: AtlasModel; papers: AtlasPaper[]; locale?: Locale }
const { model, papers } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const joiner = locale === 'zh' ? '、' : ', ';
---
<div class="shell detail-layout"><article><div class="eyebrow">{model.vendor} / {model.family} / {model.generation}</div><h1 class="detail-title">{model.name}</h1><p class="detail-subtitle">{model.official_name ?? model.name} · {model.checkpoint.type} checkpoint · {model.release_date} · <StatusBadge status={model.data_status} locale={locale} /></p>
  <section class="detail-section"><h2>{m.detail.overview}</h2><div class="fact-grid"><div class="fact"><dt>{m.detail.architecture}</dt><dd>{model.architecture.type === 'moe' ? 'MoE' : model.architecture.type === 'dense' ? 'Dense' : m.detail.other}</dd></div><div class="fact"><dt>{m.detail.parameters}</dt><dd>{model.architecture.type === 'moe' ? `${displayUnknown(model.architecture.total_parameters_b, 'B', locale)} total / ${displayUnknown(model.architecture.active_parameters_b, 'B', locale)} active` : displayUnknown(model.architecture.total_parameters_b, 'B', locale)}</dd></div><div class="fact"><dt>{m.detail.activeParams}</dt><dd>{displayUnknown(model.architecture.active_parameters_b, 'B', locale)}</dd></div><div class="fact"><dt>{m.detail.expertCount}</dt><dd>{displayUnknown(model.architecture.expert_count, '', locale)}</dd></div><div class="fact"><dt>{m.detail.expertsPerToken}</dt><dd>{displayUnknown(model.architecture.active_experts_per_token, '', locale)}</dd></div><div class="fact"><dt>{m.detail.context}</dt><dd>{displayUnknown(model.architecture.context_length, m.detail.tokensSuffix, locale)}</dd></div><div class="fact"><dt>{m.detail.modalities}</dt><dd>{model.checkpoint.modalities.join(joiner)}</dd></div><div class="fact"><dt>{m.detail.openWeights}</dt><dd>{displayBoolean(model.openness.weights_available, locale)}</dd></div><div class="fact"><dt>{m.detail.baseCheckpoint}</dt><dd>{displayBoolean(model.openness.base_checkpoint_available, locale)}</dd></div><div class="fact"><dt>{m.detail.finetuningAllowed}</dt><dd>{displayBoolean(model.openness.finetuning_allowed, locale)}</dd></div><div class="fact"><dt>{m.detail.derivativeAllowed}</dt><dd>{displayBoolean(model.openness.derivative_release_allowed, locale)}</dd></div><div class="fact"><dt>{m.detail.commercialAllowed}</dt><dd>{displayBoolean(model.openness.commercial_use_allowed, locale)}</dd></div><div class="fact"><dt>{m.detail.license}</dt><dd>{model.openness.license_name}</dd></div></div></section>
  <section class="detail-section"><h2>{m.detail.strengthsTitle}</h2><div class="pill-list">{model.checkpoint.specializations.map((item) => <span class="pill">{item}</span>)}</div><div class="fact-grid" style="margin-top:16px"><div class="fact"><dt>{m.detail.research.inference}</dt><dd>{displayBoolean(model.research.suitable_for_inference, locale)}</dd></div><div class="fact"><dt>{m.detail.research.lora}</dt><dd>{displayBoolean(model.research.suitable_for_lora, locale)}</dd></div><div class="fact"><dt>{m.detail.research.sft}</dt><dd>{displayBoolean(model.research.suitable_for_sft, locale)}</dd></div><div class="fact"><dt>{m.detail.research.rl}</dt><dd>{displayBoolean(model.research.suitable_for_rl, locale)}</dd></div><div class="fact"><dt>{m.detail.research.transformers}</dt><dd>{displayBoolean(model.research.transformers_support, locale)}</dd></div><div class="fact"><dt>{m.detail.research.vllm}</dt><dd>{displayBoolean(model.research.vllm_support, locale)}</dd></div><div class="fact"><dt>{m.detail.research.sglang}</dt><dd>{displayBoolean(model.research.sglang_support, locale)}</dd></div><div class="fact"><dt>{m.detail.research.verl}</dt><dd>{displayBoolean(model.research.verl_recipe_available, locale)}</dd></div></div></section>
  <section class="detail-section"><h2>{m.detail.hardwareTitle}</h2><div class="fact-grid"><div class="fact"><dt>{m.detail.inference}</dt><dd>{tierLabel(model.hardware.inference_tier, locale)}</dd></div><div class="fact"><dt>{m.detail.research.lora}</dt><dd>{tierLabel(model.hardware.lora_tier, locale)}</dd></div><div class="fact"><dt>{m.detail.fullSft}</dt><dd>{tierLabel(model.hardware.full_sft_tier, locale)}</dd></div><div class="fact"><dt>{m.detail.research.rl}</dt><dd>{tierLabel(model.hardware.rl_tier, locale)}</dd></div></div></section>
  <section class="detail-section"><h2>{m.detail.adoptionTitle}</h2>{papers.length ? <div class="paper-list">{papers.map((paper) => <a class="paper-row" href={localePath(locale, `/papers/${paper.id}/`)}><div><h3>{paper.title}</h3><p>{paperUsesModel(paper, model.id).map((use) => `${use.role}${use.weight_updated === true ? m.detail.weightUpdatedSuffix : ''}`).join('；')}</p></div><div class="paper-meta">{paper.published_at}</div></a>)}</div> : <p class="muted">{m.detail.noAdoption}</p>}</section>
</article><aside class="detail-aside"><div class="section-kicker">{m.detail.checkpointIdentity}</div><h2>{model.family}</h2><p class="muted">{model.generation} · {model.status}</p><EvidenceList item={model} locale={locale} /></aside></div>
