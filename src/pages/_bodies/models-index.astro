---
import { getCollection } from 'astro:content';
import ModelExplorer from '../../components/ModelExplorer';
import CatalogFreshnessNotice from '../../components/catalog/CatalogFreshnessNotice.astro';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const modelEntries = await getCollection('models');
const models = modelEntries.map((entry) => entry.data);
const baseCheckpointHref = `${Astro.url.pathname}?baseCheckpoint=true`;
const seedExperimentModelHref = localePath(locale, '/models/qwen2-5-3b-instruct/#experiment-setup');
---
<div class="shell">
  <header class="page-header models-entry" data-reader-primary>
    <h1>{m.modelsIndex.pageTitle}</h1>
    <p class="lede">{m.modelsIndex.lede}</p>
    <p><a class="button button-primary" href="#model-browser">{locale === 'zh' ? '开始筛选模型 ↓' : 'Start filtering models ↓'}</a></p>
    <dl class="models-reading-lenses" aria-label={locale === 'zh' ? '筛选模型的五个判断维度' : 'Five lenses for filtering models'}>
      <div><dt>{locale === 'zh' ? '身份' : 'Identity'}</dt><dd>{locale === 'zh' ? '具体 checkpoint 与版本' : 'Exact checkpoint and version'}</dd></div>
      <div><dt>{locale === 'zh' ? '获取' : 'Access'}</dt><dd>{locale === 'zh' ? '权重、API、基础模型' : 'Weights, API, base checkpoint'}</dd></div>
      <div><dt>{locale === 'zh' ? '适配' : 'Adaptation'}</dt><dd>LoRA · SFT · RL</dd></div>
      <div><dt>{locale === 'zh' ? '硬件' : 'Hardware'}</dt><dd>{locale === 'zh' ? '目录资源档位，不是实测保证' : 'Catalog resource tier, not a measured guarantee'}</dd></div>
      <div><dt>{locale === 'zh' ? '证据' : 'Evidence'}</dt><dd>{locale === 'zh' ? '来源、论文采用、待核验项' : 'Sources, paper use, unknowns'}</dd></div>
    </dl>
    <details class="models-entry-more">
      <summary>{locale === 'zh' ? '展开其他浏览方式 ↓' : 'Show other ways to browse ↓'}</summary>
      <div class="models-page-quick-entry" aria-label={locale === 'zh' ? '模型区域入口' : 'Model area entry points'}>
        <span>{locale === 'zh' ? '模型浏览器可以按基础模型参数版本（Base checkpoint）、论文使用情况等条件筛选；“模型家族”把同一家族的代际放在一起，“Landscape”看整个目录的分布。' : 'The model browser filters by base-model checkpoint, paper usage, and other research fields. Families group generations from the same line; Landscape shows the catalog as a whole.'}</span>
        <a class="button button-secondary" href={baseCheckpointHref}>{locale === 'zh' ? '只看基础模型（Base checkpoint）' : 'Base model checkpoints only'}</a>
        <a class="text-link" href={localePath(locale, '/families/')}>{locale === 'zh' ? '按模型家族浏览' : 'Browse model families'} →</a>
        <a class="text-link" href={localePath(locale, '/landscape/')}>Landscape →</a>
      </div>
    </details>
  </header>
  <CatalogFreshnessNotice locale={locale} compact={true} />
  <section class="models-research-model" aria-labelledby="models-research-model-title">
    <h2 id="models-research-model-title">{locale === 'zh' ? '本研究使用的实验模型' : 'Experiment model used in this study'}</h2>
    <p>{locale === 'zh' ? 'Qwen2.5-3B-Instruct 用于本研究的 SEED 基准复现与 OpenEVO 演化实验；模型记录同时列出复现实验字段和公平比较时需要固定的变量。' : 'Qwen2.5-3B-Instruct is used for this study’s SEED benchmark reproduction and OpenEVO evolution experiments; its model record also lists the reproduction fields and variables that must be held fixed for fair comparison.'}</p>
    <a class="text-link" href={seedExperimentModelHref}>{locale === 'zh' ? '查看 Qwen2.5-3B-Instruct 与实验设置' : 'Open Qwen2.5-3B-Instruct and experiment setup'} →</a>
  </section>
  <p class="models-catalog-evidence-link"><a class="text-link" href={localePath(locale, '/data-status/')}>{locale === 'zh' ? '查看目录更新记录与完整核验依据' : 'See catalog update history and full verification evidence'} →</a></p>
  <section class="static-model-catalog" aria-labelledby="static-model-catalog-title" data-model-static-fallback>
    <h2 id="static-model-catalog-title">{locale === 'zh' ? '模型目录' : 'Model catalog'}</h2>
    <p>{locale === 'zh' ? '以下目录可在没有 JavaScript 时阅读；启用 JavaScript 后可使用完整筛选、搜索和任务匹配。' : 'This catalog remains readable without JavaScript; enable JavaScript for full filtering, search, and task matching.'}</p>
    <div class="model-grid">
      {models.map((model) => <article class="model-card"><h3><a href={localePath(locale, `/models/${model.id}/`)}>{model.name}</a></h3><p>{model.vendor} · {model.family} · {model.release_date}</p></article>)}
    </div>
  </section>
  <div id="model-browser"><ModelExplorer client:load locale={locale} /></div>
</div>

<style>
  .models-research-model{max-width:880px;margin:0 0 2rem;padding:1rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.models-research-model h2{margin:0;font-size:1.1rem}.models-research-model p{max-width:68ch;margin:.45rem 0;color:var(--muted);font-size:.82rem;line-height:1.6}.models-research-model a{font-size:.82rem;font-weight:750}
  .models-entry{box-sizing:border-box;max-width:880px;padding:clamp(2.2rem,6vw,4.5rem) 0 1.4rem}.models-entry .lede{max-width:58ch}.models-reading-lenses{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin:1rem 0 0;border-block:1px solid var(--line)}.models-reading-lenses>div{min-width:0;padding:.75rem .7rem .75rem 0}.models-reading-lenses>div+div{padding-left:.7rem;border-left:1px solid var(--line)}.models-reading-lenses dt{font-size:.76rem;font-weight:800}.models-reading-lenses dd{margin:.2rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.45}.models-catalog-evidence-link{max-width:880px;margin:-1.1rem 0 1.5rem;font-size:.8rem}.models-entry-more{max-width:720px;margin-top:.8rem;border-top:1px solid var(--line)}.models-entry-more>summary{width:max-content;max-width:100%;padding:.7rem 0;color:var(--muted);font-size:.84rem;font-weight:700;cursor:pointer;list-style:none}.models-entry-more>summary::-webkit-details-marker{display:none}.models-entry-more[open]>summary{color:var(--ink)}@media(max-width:720px){.models-reading-lenses{grid-template-columns:1fr 1fr}.models-reading-lenses>div+div{padding-left:0;border-left:0}.models-reading-lenses>div:nth-child(even){padding-left:.7rem;border-left:1px solid var(--line)}.models-reading-lenses>div:nth-child(n+3){border-top:1px solid var(--line)}}
</style>
