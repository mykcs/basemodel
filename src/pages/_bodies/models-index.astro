---
import { getCollection } from 'astro:content';
import ModelExplorer from '../../components/ModelExplorer';
import CatalogFreshnessNotice from '../../components/catalog/CatalogFreshnessNotice.astro';
import { modelIdsUsedByPapers } from '../../lib/modelRelations';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const modelEntries = await getCollection('models');
const paperEntries = await getCollection('papers');
const models = modelEntries.map((entry) => entry.data);
const papers = paperEntries.map((entry) => entry.data);
const paperModelIds = [...modelIdsUsedByPapers(papers)];
const baseCheckpointHref = `${Astro.url.pathname}?baseCheckpoint=true`;
---
<div class="shell">
  <header class="page-header">
    <h1>{m.modelsIndex.pageTitle}</h1>
    <p class="lede">{m.modelsIndex.lede}</p>
    <div class="models-page-quick-entry" aria-label={locale === 'zh' ? '模型区域入口' : 'Model area entry points'}>
      <span>{locale === 'zh' ? '模型浏览器可以按基础模型参数版本（Base checkpoint）、论文使用情况等条件筛选；“模型家族”把同一家族的代际放在一起，“Landscape”看整个目录的分布。' : 'The model browser filters by base-model checkpoint, paper usage, and other research fields. Families group generations from the same line; Landscape shows the catalog as a whole.'}</span>
      <a class="button button-secondary" href={baseCheckpointHref}>{locale === 'zh' ? '只看基础模型（Base checkpoint）' : 'Base model checkpoints only'}</a>
      <a class="text-link" href={localePath(locale, '/families/')}>{locale === 'zh' ? '按模型家族浏览' : 'Browse model families'} →</a>
      <a class="text-link" href={localePath(locale, '/landscape/')}>Landscape →</a>
    </div>
  </header>
  <CatalogFreshnessNotice locale={locale} showSignals={true} />
  <ModelExplorer client:load models={models} papers={papers} paperModelIds={paperModelIds} locale={locale} />
</div>
