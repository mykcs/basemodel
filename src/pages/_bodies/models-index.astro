---
import { getCollection } from 'astro:content';
import ModelExplorer from '../../components/ModelExplorer';
import { modelIdsUsedByPapers } from '../../lib/modelRelations';
import { getMessages, isLocale, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const modelEntries = await getCollection('models');
const paperEntries = await getCollection('papers');
const models = modelEntries.map((entry) => entry.data);
const paperModelIds = [...modelIdsUsedByPapers(paperEntries.map((entry) => entry.data))];
---
<div class="shell"><header class="page-header"><div class="eyebrow">{m.modelsIndex.eyebrow}</div><h1>{m.modelsIndex.pageTitle}</h1><p class="lede">{m.modelsIndex.lede}</p></header><ModelExplorer client:load models={models} paperModelIds={paperModelIds} locale={locale} /></div>
