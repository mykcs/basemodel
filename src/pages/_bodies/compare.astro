---
import { getCollection } from 'astro:content';
import ModelComparison from '../../components/ModelComparison';
import CatalogFreshnessNotice from '../../components/catalog/CatalogFreshnessNotice.astro';
import { getMessages, isLocale, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const models = (await getCollection('models')).map((entry) => entry.data);
---
<div class="shell">
  <header class="page-header"><h1>{m.compare.title}</h1><p class="lede">{m.compare.lede}</p></header>
  <CatalogFreshnessNotice locale={locale} compact={true} />
  <ModelComparison client:load locale={locale} />
  <section class="compare-static-picker" data-compare-static-fallback aria-labelledby="compare-static-picker-title">
    <h2 id="compare-static-picker-title">{locale === 'zh' ? '模型名单' : 'Model list'}</h2>
    <p class="muted">{locale === 'zh' ? '交互对比正在加载。没有 JavaScript 时仍可浏览模型；勾选框仅表示可选项，不会在静态模式计算比较结果。' : 'The interactive comparison is loading. Without JavaScript you can still browse the models; the disabled checkboxes only show which models are available.'}</p>
    <div class="compare-static-options">{models.map((model) => <label><input type="checkbox" disabled /><a href={`/models/${model.id}/`}>{model.name}</a></label>)}</div>
  </section>
</div>

<style>
  .compare-static-picker{margin:1rem 0 2rem;padding-top:1rem;border-top:1px solid var(--line)}
  .compare-static-options{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:.35rem .8rem;margin-top:.75rem}
  .compare-static-options label{display:flex;gap:.45rem;align-items:baseline;min-width:0;font-size:.82rem}
  .compare-static-options input{flex:0 0 auto}
</style>
