---
import EvidenceList from '../../components/EvidenceList.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getMessages, isLocale, type Locale } from '../../i18n';
import type { AtlasModel, AtlasPaper } from '../../lib/types';

interface Props { paper: AtlasPaper; models: AtlasModel[]; locale?: Locale }
const { paper, models } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const joiner = locale === 'zh' ? '、' : ', ';
const modelMap = new Map(models.map((model) => [model.id, model]));
---
<div class="shell detail-layout"><article><div class="eyebrow">{m.papersIndex.eyebrow}</div><h1 class="detail-title">{paper.title}</h1><p class="detail-subtitle">{paper.published_at} · <StatusBadge status={paper.data_status} locale={locale} /></p><section class="detail-section"><h2>{m.paperDetail.infoTitle}</h2><div class="fact-grid"><div class="fact"><dt>{m.paperDetail.evolutionTargets}</dt><dd>{paper.evolution_targets.join(joiner)}</dd></div><div class="fact"><dt>{m.paperDetail.benchmarks}</dt><dd>{paper.benchmarks.join(joiner)}</dd></div><div class="fact"><dt>{m.paperDetail.category}</dt><dd>{paper.category.join(joiner)}</dd></div><div class="fact"><dt>{m.paperDetail.modelRelations}</dt><dd>{paper.models.length}{m.paperDetail.relationsUnit ? ` ${m.paperDetail.relationsUnit}` : ''}</dd></div></div><div class="tag-row"><a class="button button-secondary" href={paper.paper_url === 'unknown' ? undefined : paper.paper_url} aria-disabled={paper.paper_url === 'unknown'}>{m.paperDetail.paperLink}</a><a class="button button-secondary" href={paper.code_url === 'unknown' ? undefined : paper.code_url} aria-disabled={paper.code_url === 'unknown'}>{m.paperDetail.codeLink}</a></div></section><section class="detail-section"><h2>{m.paperDetail.rolesTitle}</h2><div class="paper-list">{paper.models.map((use) => { const model = modelMap.get(use.model_id); return <div class="paper-row"><div><h3>{model?.name ?? use.model_id}</h3><p>{use.role} · {use.weight_updated === 'unknown' ? m.paperDetail.weightUnknown : use.weight_updated ? m.paperDetail.weightUpdated : m.paperDetail.weightNotUpdated}{use.notes ? ` · ${use.notes}` : ''}</p></div><div class="paper-meta"><span class="tag">{model?.family ?? m.paperDetail.relationError}</span></div></div>; })}</div></section></article><aside class="detail-aside"><EvidenceList item={paper} locale={locale} /></aside></div></div>
