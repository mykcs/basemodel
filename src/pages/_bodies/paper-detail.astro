---
import EvidenceList from '../../components/EvidenceList.astro';
import { PaperRoleDiagram } from '../../components/papers/PaperRoleDiagram';
import ReproductionSummary from '../../components/papers/ReproductionSummary.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { categoryLabel, evolutionTargetLabel, modelContextLabels, noteLabel, roleLabel } from '../../lib/format';
import { getMessages, isLocale, localePath, type Locale } from '../../i18n';
import type { AtlasModel, AtlasPaper } from '../../lib/types';
import PaperSelectionRationale from '../../components/papers/PaperSelectionRationale.astro';
import PaperLearningGuide from '../../components/papers/PaperLearningGuide.astro';
import ExternalBrandMark from '../../components/common/ExternalBrandMark';

interface Props { paper: AtlasPaper; models: AtlasModel[]; locale?: Locale }
const { paper, models } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const joiner = locale === 'zh' ? '、' : ', ';
const modelMap = new Map(models.map((model) => [model.id, model]));
const paperRoleModelIds = new Set([
  ...paper.models.map((use) => use.model_id),
  ...(paper.workflow?.nodes.flatMap((node) => node.model_id ? [node.model_id] : []) ?? []),
]);
const paperRoleModels = models.filter((model) => paperRoleModelIds.has(model.id));
const contextLabel = (model: AtlasModel | undefined) => model ? modelContextLabels(model)[0] : undefined;
const methodSummary = paper.learning_guide?.key_idea?.[locale] ?? null;
const hasPaperLink = typeof paper.paper_url === 'string' && paper.paper_url.startsWith('http');
const hasCodeLink = typeof paper.code_url === 'string' && paper.code_url.startsWith('http');
const hasCheckpointLink = typeof paper.checkpoint_url === 'string' && paper.checkpoint_url.startsWith('http');
---
<div class="shell detail-layout">
  <article>
    <h1 class="detail-title">{paper.title}</h1>
    <p class="detail-subtitle">{paper.published_at} · <StatusBadge status={paper.data_status} locale={locale} /></p>

    <section class="detail-section paper-method-summary" aria-labelledby="paper-method-summary-title">
      <div class="section-kicker">{locale === 'zh' ? '方法' : 'Method'}</div>
      <h2 id="paper-method-summary-title">{locale === 'zh' ? '方法摘要' : 'Method summary'}</h2>
      {methodSummary
        ? <p class="lede">{methodSummary}</p>
        : <p class="muted">{locale === 'zh' ? '这条记录还没有经过来源核对的方法摘要。下面只展示已经记录的论文类别、模型、训练更新对象和复现材料，不用其他字段猜测方法。' : 'This record does not yet contain a source-checked method summary. The page therefore shows only recorded categories, models, update targets, and reproduction material instead of guessing the method from other fields.'}</p>}
    </section>

    <PaperLearningGuide paper={paper} locale={locale} />

    <section class="detail-section" id="paper-overview">
      <h2>{m.paperDetail.infoTitle}</h2>
      <div class="fact-grid">
        <div class="fact"><dt>{m.paperDetail.evolutionTargets}</dt><dd>{paper.evolution_targets.map((value) => evolutionTargetLabel(value, locale)).join(joiner)}</dd></div>
        <div class="fact"><dt>{m.paperDetail.benchmarks}</dt><dd>{paper.benchmarks.join(joiner)}</dd></div>
        <div class="fact"><dt>{m.paperDetail.category}</dt><dd>{paper.category.map((value) => categoryLabel(value, locale)).join(joiner)}</dd></div>
        <div class="fact"><dt>{locale === 'zh' ? '论文中使用的模型' : 'Models used in the paper'}</dt><dd>{paper.models.length}{m.paperDetail.relationsUnit ? ` ${m.paperDetail.relationsUnit}` : ''}</dd></div>
      </div>
      <div class="tag-row">
        <a class="button button-secondary" href={hasPaperLink ? paper.paper_url : undefined} aria-disabled={!hasPaperLink}><ExternalBrandMark href={hasPaperLink ? paper.paper_url : undefined} />{m.paperDetail.paperLink}</a>
        <a class="button button-secondary" href={hasCodeLink ? paper.code_url : undefined} aria-disabled={!hasCodeLink}><ExternalBrandMark href={hasCodeLink ? paper.code_url : undefined} />{m.paperDetail.codeLink}</a>
        {hasCheckpointLink && <a class="button button-secondary" href={paper.checkpoint_url} target="_blank" rel="noreferrer"><ExternalBrandMark href={paper.checkpoint_url} />{locale === 'zh' ? '打开 Checkpoint ↗' : 'Open checkpoint ↗'}</a>}
      </div>
    </section>

    <section class="detail-section" id="paper-reproduce">
      <h2>{locale === 'zh' ? '复现方式' : 'Reproduction modes'}</h2>
      <p class="muted">{locale === 'zh' ? '严格复现尽量保持论文原模型和环境；方法复现保留核心机制但允许可比替代；现代化重跑明确换用更新模型或运行栈。' : 'Strict reproduction keeps the paper model and environment as closely as possible; method reproduction preserves the mechanism while allowing comparable substitutes; a modern rerun explicitly uses newer models or runtime components.'}</p>
      <div class="tag-row">
        <a class="button button-primary" href={localePath(locale, `/workspace/?v=2&mode=strict&paper=${paper.id}`)}>{m.paperDetail.strictReproduction}</a>
        <a class="button button-secondary" href={localePath(locale, `/workspace/?v=2&mode=method&paper=${paper.id}`)}>{m.paperDetail.methodReproduction}</a>
        <a class="button button-secondary" href={localePath(locale, `/workspace/?v=2&mode=modern&paper=${paper.id}`)}>{m.paperDetail.modernRerun}</a>
      </div>
    </section>

    <ReproductionSummary paper={paper} locale={locale} m={m} />
    <PaperRoleDiagram client:visible paper={paper} models={paperRoleModels} locale={locale} m={m} />
    <PaperSelectionRationale paper={paper} models={models} locale={locale} />

    <section class="detail-section" id="paper-models">
      <h2>{locale === 'zh' ? '模型角色' : 'Model roles'}</h2>
      <div class="paper-list">
        {paper.models.map((use) => {
          const model = modelMap.get(use.model_id);
          const context = contextLabel(model);
          return <div class="paper-row">
            <div>
              <h3>{model ? <a href={localePath(locale, `/models/${model.id}/`)}>{model.name}</a> : use.model_id}</h3>
              <p>{roleLabel(use.role, locale)} · {use.weight_updated === 'not_reported' ? m.paperDetail.weightUnknown : use.weight_updated ? m.paperDetail.weightUpdated : m.paperDetail.weightNotUpdated}{use.notes ? ` · ${noteLabel(use.notes, locale)}` : ''}</p>
            </div>
            {context && <div class="paper-meta"><span class="tag">{context}</span></div>}
          </div>;
        })}
      </div>
    </section>
  </article>
  <aside class="detail-aside"><EvidenceList item={paper} locale={locale} /></aside>
</div>
