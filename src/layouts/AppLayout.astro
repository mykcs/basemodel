---
import Header from '../components/Header.astro';
import SeedOpenEvoResearchNav from '../components/research/SeedOpenEvoResearchNav.astro';
import LegacyTodayRunbookNotice from '../components/LegacyTodayRunbookNotice.astro';
import ActionableContentLayer from '../components/common/ActionableContentLayer.astro';
import PageOutline from '../components/navigation/PageOutline.astro';
import QuickViewBridge from '../components/models/QuickViewBridge.astro';
import ResearchContextBar from '../components/workspace/ResearchContextBar.astro';
import CompareTray from '../components/workspace/CompareTray.astro';
import { GlobalModelQuickView } from '../components/models/GlobalModelQuickView.tsx';
import '../styles/app.css';
import { getMessages, isLocale, locales, baseUrl, type Locale } from '../i18n';
import { availableLocalesForRoute, localizedRoute } from '../lib/sitemapRoutes';
import { readerContractForRoute } from '../data/siteReaderContracts';

interface Props { title: string; description?: string; locale?: Locale }
type ResearchBridgePage = 'experiment' | 'run' | 'capability';

const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const { title, description = m.site.defaultDescription } = Astro.props;
const base = baseUrl();
const fullTitle = `${title} · ${m.site.titleSuffix}`;
const siteOrigin = Astro.site ?? new URL('https://basemodel-preview.vercel.app');
const isVercelProduction = process.env.VERCEL_ENV === 'production';
const isVercelPreview = process.env.VERCEL_ENV === 'preview';
const isCloudflarePreview = process.env.CF_PAGES === '1' && Boolean(process.env.CF_PAGES_BRANCH) && process.env.CF_PAGES_BRANCH !== 'main';
const explicitNoIndex = process.env.PUBLIC_SEARCH_INDEXING === 'disabled' && !isVercelProduction;
const shouldNoIndex = explicitNoIndex || isVercelPreview || isCloudflarePreview;
const pathNoBase = Astro.url.pathname.startsWith(base) ? `/${Astro.url.pathname.slice(base.length)}` : Astro.url.pathname;
const localeNeutralPath = pathNoBase.replace(/^\/en(\/|$)/, '/');
const readerContract = readerContractForRoute(localeNeutralPath);
if (!readerContract) throw new Error(`Public page is missing a reader-attention contract: ${localeNeutralPath}`);
const exactRoute = (target: string) => localeNeutralPath === target || localeNeutralPath === `${target}/`;
const isTodayRunbook = exactRoute('/guide/today');
const globalQuickViewMounted = exactRoute('/families') || /^\/papers\/[^/]+\/?$/.test(localeNeutralPath);
const isCapabilityExplorationPage = /^\/research\/seed-openevo\/study\/capability-exploration(?:\/|$)/.test(localeNeutralPath)
  || /^\/research\/seed-openevo\/study\/results\/(?:3b-self-analysis|7b-self-analysis|3b-minimax-analysis|7b-minimax-analysis|four-arm-analysis)\/?$/.test(localeNeutralPath);
const researchBridgePage: ResearchBridgePage | null = exactRoute('/research/seed-openevo/study') ? 'experiment'
  : exactRoute('/research/seed-openevo/study/run') ? 'run'
  : isCapabilityExplorationPage ? 'capability'
  : null;
const currentRoute = localizedRoute(localeNeutralPath, locale) ?? pathNoBase;
const canonicalUrl = new URL(currentRoute, siteOrigin).href;
const availableLocales = availableLocalesForRoute(localeNeutralPath);
const alternateUrls = locales.flatMap((loc) => {
  const path = localizedRoute(localeNeutralPath, loc);
  return path ? [{ loc, href: new URL(path, siteOrigin).href }] : [];
});
const canonicalRoot = new URL('/', siteOrigin).href;
const ogImage = new URL('/og-cover.png', siteOrigin).href;
const ogLocaleMap: Record<Locale, string> = { zh: 'zh_CN', en: 'en_US' };
const websiteJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: m.site.fullName, url: canonicalRoot, description: m.site.defaultDescription, inLanguage: ['zh-CN', 'en'] });

// Global islands previously received the entire locale message tree, which
// duplicated a large serialized payload several times on every static page.
// Each island now receives only the labels it actually renders.
const researchContextLabels = {
  currentTask: m.workspace.currentTask,
  openWeightLabel: m.workspace.openWeightLabel,
  candidates: m.workspace.candidates,
  compare: m.workspace.compare,
  editConstraints: m.workspace.editConstraints,
  clearTask: m.workspace.clearTask,
  role: m.format.role,
  mode: m.research.modes,
  update: m.research.updates,
  access: m.research.accessModes,
};
const quickViewLabels = {
  closeQuickView: m.workspace.closeQuickView,
  openWeights: m.detail.openWeights,
  finetuningAllowed: m.detail.finetuningAllowed,
  license: m.detail.license,
  inference: m.detail.inference,
  context: m.detail.context,
  apiStatus: m.detail.apiStatus,
  tokensSuffix: m.detail.tokensSuffix,
};
const compareTrayLabels = {
  compareTray: m.workspace.compareTray,
  compare: m.workspace.compare,
  openCompare: m.workspace.openCompare,
  clearCompare: m.workspace.clearCompare,
};
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('atlas-theme');
        document.documentElement.dataset.theme = storedTheme === 'dark' ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <meta name="description" content={description} />
    {shouldNoIndex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16130e" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    {!shouldNoIndex && <link rel="sitemap" href={`${base}sitemap.xml`} />}
    {alternateUrls.map((alt) => <link rel="alternate" hreflang={alt.loc === 'zh' ? 'zh-CN' : 'en'} href={alt.href} />)}
    {availableLocales.includes('zh') && <link rel="alternate" hreflang="x-default" href={new URL(localizedRoute(localeNeutralPath, 'zh')!, siteOrigin).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {alternateUrls.filter((alt) => alt.loc !== locale).map((alt) => <meta property="og:locale:alternate" content={ogLocaleMap[alt.loc]} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
  </head>
  <body data-reader-contract-id={readerContract.id} data-reader-attention-mode={readerContract.attentionMode}>
    <a class="skip-link" href="#main-content">{m.site.skipLink}</a>
    <Header locale={locale} />
    <ResearchContextBar labels={researchContextLabels} locale={locale} />
    {globalQuickViewMounted && <GlobalModelQuickView client:idle labels={quickViewLabels} locale={locale} />}
    {globalQuickViewMounted && <QuickViewBridge />}
    <main id="main-content" class="site-main">
      {researchBridgePage && (
        <div class="research-module-nav-shell">
          <SeedOpenEvoResearchNav locale={locale} page={researchBridgePage} />
        </div>
      )}
      {isTodayRunbook && <LegacyTodayRunbookNotice locale={locale} />}
      <slot />
    </main>
    <PageOutline locale={locale} />
    <CompareTray labels={compareTrayLabels} locale={locale} />
    <footer class="site-footer"><div class="shell footer-inner"><span>{m.footer.identity}</span></div></footer>
    <ActionableContentLayer locale={locale} />
  </body>
</html>

<style>
  .research-module-nav-shell{
    width:min(1160px,calc(100% - 2rem));
    margin-inline:auto;
  }
  @media(max-width:720px){
    .research-module-nav-shell{width:min(100% - 1rem,1160px)}
  }
</style>
