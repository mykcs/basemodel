---
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { ResearchContextBar } from '../components/workspace/ResearchContextBar.tsx';
import { CompareTray } from '../components/workspace/CompareTray.tsx';
import { CommandMenu } from '../components/navigation/CommandMenu.tsx';
import '../styles/global.css';
import '../styles/workspace.css';
import { getMessages, isLocale, locales, baseUrl, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'zh');
const m = getMessages(locale);
const modelNames = Object.fromEntries((await getCollection('models')).map((entry) => [entry.data.id, entry.data.name]));
const { title, description = m.site.defaultDescription } = Astro.props;
const base = baseUrl();
const fullTitle = `${title} · ${m.site.titleSuffix}`;
const siteOrigin = Astro.site ?? new URL('https://basemodel.pages.dev');
const isCloudflarePreview =
  process.env.CF_PAGES === '1' &&
  Boolean(process.env.CF_PAGES_BRANCH) &&
  process.env.CF_PAGES_BRANCH !== 'main';
const shouldNoIndex =
  process.env.PUBLIC_SEARCH_INDEXING === 'disabled' || isCloudflarePreview;

const pathNoBase = Astro.url.pathname.startsWith(base) ? `/${Astro.url.pathname.slice(base.length)}` : Astro.url.pathname;
const localeNeutralPath = pathNoBase.replace(/^\/en(\/|$)/, '/');
const localePath = (target: Locale) => {
  const clean = localeNeutralPath.replace(/^\//, '');
  return target === 'en' ? `/en/${clean}` : `/${clean}`;
};
const canonicalUrl = new URL(localePath(locale), siteOrigin).href;
const alternateUrls = locales.map((loc) => ({
  loc,
  href: new URL(localePath(loc), siteOrigin).href,
}));
const canonicalRoot = new URL('/', siteOrigin).href;
const ogImage = new URL('/og-cover.png', siteOrigin).href;
const ogLocaleMap: Record<Locale, string> = { zh: 'zh_CN', en: 'en_US' };
const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: m.site.fullName,
  url: canonicalRoot,
  description: m.site.defaultDescription,
  inLanguage: ['zh-CN', 'en'],
});
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('atlas-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = storedTheme ?? (prefersDark ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <meta name="description" content={description} />
    {shouldNoIndex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16130e" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    {!shouldNoIndex && <link rel="sitemap" href={`${base}sitemap.xml`} />}
    {alternateUrls.map((alt) => <link rel="alternate" hreflang={alt.loc === 'zh' ? 'zh-CN' : 'en'} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('zh'), siteOrigin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {alternateUrls.filter((alt) => alt.loc !== locale).map((alt) => <meta property="og:locale:alternate" content={ogLocaleMap[alt.loc]} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={websiteJsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{m.site.skipLink}</a>
    <Header locale={locale} />
    <CommandMenu client:load locale={locale} m={m} />
    <ResearchContextBar client:load m={m} locale={locale} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <CompareTray client:load m={m} locale={locale} modelNames={modelNames} />
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>{m.footer.identity}</span>
        <span>{m.footer.motto}</span>
      </div>
    </footer>
</body>
</html>
