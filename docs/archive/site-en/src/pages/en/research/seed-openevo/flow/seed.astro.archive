---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import SeedOpenEvoResearchPage from '../../../../../components/research/SeedOpenEvoResearchPage.astro';
import InteractiveResearchExplainer from '../../../../../components/research/InteractiveResearchExplainer.tsx';
const locale = 'en' as const;
---
<AppLayout title="SEED learning flow and parameter updates" description="SEED trains an agent policy from its own completed task trajectories; this page explains Stage-1 hindsight-skill SFT, Stage-2 self-reflection, and how OPD and GRPO enter parameter updates in the WebShop reproduction." locale={locale}>
  <SeedOpenEvoResearchPage locale={locale} page="seed">
    <InteractiveResearchExplainer locale={locale} kind="seed" client:visible />
  </SeedOpenEvoResearchPage>
</AppLayout>
