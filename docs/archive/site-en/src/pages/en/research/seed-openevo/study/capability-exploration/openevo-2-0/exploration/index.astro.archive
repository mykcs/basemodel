---
import AppLayout from '../../../../../../../../layouts/AppLayout.astro';
import OpenEvoSuccessorExplorationMap from '../../../../../../../../components/research/OpenEvoSuccessorExplorationMap.astro';
import ResearchRouteContext from '../../../../../../../../components/research/ResearchRouteContext.astro';
const locale = 'en' as const;
---
<AppLayout
  title="OpenEvo 3B + 1.7B — Exploration"
  description="Follow the real research chronology for the Qwen2.5-3B and Qwen3-1.7B successor: horizon, sampling, history, self-deliberation and action-channel diagnostics, the shared-harness freeze, canonical Stage 1, MiniMax, and the Text-Memory 4096→bounded 10+10 backtrack."
