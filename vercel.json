{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:deploy && npm run build",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "agent/semantic-release-*": true
    }
  },
  "github": {
    "autoJobCancelation": true
  }
}
