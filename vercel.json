{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:deploy && npm run build && node scripts/vercel-ui-gate.mjs && node scripts/vercel-lab-browser-gate.mjs",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**/*": false,
      "main": true,
      "agent/semantic-release-*": true,
      "research/**": true
    }
  },
  "github": {
    "autoJobCancelation": true
  },
  "redirects": [
    {
      "source": "/research/seed-openevo",
      "destination": "/research/seed-openevo/flow/",
      "permanent": true
    },
    {
